constructor TDeadCodeAnalyzer.Create(AGlobalEnv: TSymbolTable);
begin
  FScopes := TScopeList.Create(True);
  FGlobalEnv := AGlobalEnv;
  FFuncScopeStack := TIntList.Create;   // ✅ FIX
  PushScope;
end;

destructor TDeadCodeAnalyzer.Destroy;
begin
  FScopes.Free;
  FFuncScopeStack.Free;                  // ✅ FIX
  inherited;
end;

procedure TDeadCodeAnalyzer.PushScope;
begin
  FScopes.Add(TStringNodeMap.Create);
end;

procedure TDeadCodeAnalyzer.PopScope;
begin
  if FScopes.Count > 1 then
  begin
    // --- Peringatan di terminal merusak output stdout jika skrip dipanggil via eval().
    // Proses marking sudah ditangani saat kompilasi di DeclareSymbol. 
    // Kita cukup melepas tumpukan scope dari array map dengan bersih. ---
    FScopes.Delete(FScopes.Count - 1);
  end;
end;

procedure TDeadCodeAnalyzer.PushFuncScope;
begin
  // Catat FScopes.Count SEBELUM push, agar MarkUsed bisa bandingkan:
  //   variable_found_at_scope_index < FFuncScopeStack.Last
  // berarti variable berada di LUAR function boundary saat ini = captured.
  FFuncScopeStack.Add(FScopes.Count);
  PushScope;
end;

procedure TDeadCodeAnalyzer.PopFuncScope;
begin
  PopScope;
  if FFuncScopeStack.Count > 0 then
    FFuncScopeStack.Delete(FFuncScopeStack.Count - 1);
end;

procedure TDeadCodeAnalyzer.DeclareSymbol(const Name: string; Node: TNode);
var
  idx: Integer;
  ExistingNode: TNode;
  Line, Col: Integer;
begin
  if (Name <> '') and (FScopes.Count > 0) then
  begin
    idx := FScopes.Last.IndexOf(Name);
    
    if idx <> -1 then
    begin
      ExistingNode := FScopes.Last.Data[idx];
      
      // PERBAIKAN KRUSIAL: Jika ini deklarasi variabel di scope yang sama
      if Assigned(Node) and (Node is TVarDeclNode) then
      begin
        if Assigned(ExistingNode) and (ExistingNode is TVarDeclNode) then
        begin
          // Gunakan posisi dari Node yang baru (variabel kedua)
          Line := Node.Line;
          Col := Node.Col;
          errMSG.callerror(9, 'Identifier "' + Name + '" sudah dideklarasikan sebelumnya', Line, Col);
        end;
      end;
      
      // Update referensi jika tidak error
      FScopes.Last.Data[idx] := Node;
    end
    else
      FScopes.Last.Add(Name, Node);

    // KUNCI AMAN: Eksekusi DCE eksklusif HANYA untuk scope lokal.
    if FScopes.Count > 1 then
    begin
      if Node is TVarDeclNode then TVarDeclNode(Node).IsReferenced := False
      else if Node is TFunctionNode then TFunctionNode(Node).IsReferenced := False
      else if Node is TClassDeclNode then TClassDeclNode(Node).IsReferenced := False;
    end;
  end;
end;

procedure TDeadCodeAnalyzer.MarkUsed(const Name: string; ErrNode: TNode);
var
  i, idx: Integer;
  Node: TNode;
  CapturedBoundary: Integer;   // ✅ FIX
begin
  if FFuncScopeStack.Count > 0 then
    CapturedBoundary := FFuncScopeStack.Last
  else
    CapturedBoundary := 0;

  for i := FScopes.Count - 1 downto 0 do
  begin
    idx := FScopes[i].IndexOf(Name);

    if idx <> -1 then
    begin
      Node := FScopes[i].Data[idx];

      if Node <> nil then
      begin
        if Node is TVarDeclNode then
        begin
          TVarDeclNode(Node).IsReferenced := True;

          if i < CapturedBoundary then
            TVarDeclNode(Node).IsCaptured := True;
        end
        else if Node is TFunctionNode then
          TFunctionNode(Node).IsReferenced := True
        else if Node is TClassDeclNode then
          TClassDeclNode(Node).IsReferenced := True;
      end;

      Exit;
    end;
  end;

  if Assigned(FGlobalEnv) and FGlobalEnv.HasVar(Name) then
    Exit;

  if Assigned(ErrNode) and (ErrNode.Line > 0) then
    errMSG.callerror(
      11,
      'Semantic Error: Variabel atau Fungsi "' + Name +
      '" belum dideklarasikan!',
      ErrNode.Line,
      ErrNode.Col
    )
  else
    errMSG.callerror(
      11,
      'Semantic Error: Variabel atau Fungsi "' + Name +
      '" belum dideklarasikan!',
      errMSG.xrow,
      errMSG.xcol
    );
end;


procedure TDeadCodeAnalyzer.Analyze(Node: TNode);
var i: Integer;
begin
  if Node = nil then Exit;

  // 1. PENANGANAN NODE DEKLARASI (Hanya jika belum di-hoist oleh TBlockNode)
  if Node is TVarDeclNode then
  begin
    Analyze(TVarDeclNode(Node).Expr);
  end else 
  if Node is TFunctionNode then
  begin
    PushFuncScope;   // ✅ FIX: function boundary
    try
      for i := 0 to High(TFunctionNode(Node).Params) do
      begin
        DeclareSymbol(TFunctionNode(Node).Params[i].Name, nil);
        if TFunctionNode(Node).Params[i].DefaultExpr <> nil then 
          Analyze(TFunctionNode(Node).Params[i].DefaultExpr);
      end;
      Analyze(TFunctionNode(Node).Body);
    finally
      PopFuncScope;  // ✅ FIX
    end;
  end else 
  if Node is TClassDeclNode then
  begin
    DeclareSymbol(TClassDeclNode(Node).sClassName, Node);
    for i := 0 to TClassDeclNode(Node).Parents.Count - 1 do MarkUsed(TClassDeclNode(Node).Parents[i], Node);
    
    PushScope; // Buka Scope Class
    try
      DeclareSymbol('self', nil); // Injeksi otomatis keyword 'self'
      
      for i := 0 to TClassDeclNode(Node).Methods.Count - 1 do
      begin
        TFunctionNode(TClassDeclNode(Node).Methods[i]).IsReferenced := True;
        Analyze(TNode(TClassDeclNode(Node).Methods[i]));
      end;
    finally
      PopScope;
    end;
  end

  // 2. TANDAI PENGGUNAAN DENGAN PRESISI (Validasi Scope)
  else if Node is TVariableNode then MarkUsed(TVariableNode(Node).VarName, Node)
  else if Node is TNewNode then
  begin
    MarkUsed(TNewNode(Node).sClassName, Node);
    for i := 0 to TNewNode(Node).Args.Count - 1 do Analyze(TNode(TNewNode(Node).Args[i]));
  end else 
  if Node is TAssignmentNode then
  begin
    MarkUsed(TAssignmentNode(Node).TargetName, Node); // <-- Tangkap error mm := 200 di sini!
    Analyze(TAssignmentNode(Node).Expr);
  end else 
  if Node is TMultiAssignNode then
  begin
    for i := 0 to TMultiAssignNode(Node).Targets.Count - 1 do MarkUsed(TMultiAssignNode(Node).Targets[i], Node);
    Analyze(TMultiAssignNode(Node).Expr);
  end else

  // 3. PENELUSURAN AST (Traversal Mendalam)
  if Node is TBlockNode then
  begin
    if TBlockNode(Node).IsScope then PushScope;
    
    // HOISTING: Daftarkan deklarasi di awal agar fungsi/variabel bisa saling dipanggil
    for i := 0 to TBlockNode(Node).Statements.Count - 1 do
    begin
      if TNode(TBlockNode(Node).Statements[i]) is TVarDeclNode then
        DeclareSymbol(TVarDeclNode(TBlockNode(Node).Statements[i]).VarName, TNode(TBlockNode(Node).Statements[i]))
      else if TNode(TBlockNode(Node).Statements[i]) is TFunctionNode then
      begin
        if TFunctionNode(TBlockNode(Node).Statements[i]).Name <> '' then 
          DeclareSymbol(TFunctionNode(TBlockNode(Node).Statements[i]).Name, TNode(TBlockNode(Node).Statements[i]));
      end
      else if TNode(TBlockNode(Node).Statements[i]) is TClassDeclNode then
        DeclareSymbol(TClassDeclNode(TBlockNode(Node).Statements[i]).sClassName, TNode(TBlockNode(Node).Statements[i]));
    end;
    
    // Traversal blok sesungguhnya
    for i := 0 to TBlockNode(Node).Statements.Count - 1 do Analyze(TNode(TBlockNode(Node).Statements[i]));
    if TBlockNode(Node).IsScope then PopScope;
  end else 
  if Node is TFunctionCallNode then
  begin
    Analyze(TFunctionCallNode(Node).FuncExpr);
    for i := 0 to TFunctionCallNode(Node).Args.Count - 1 do Analyze(TNode(TFunctionCallNode(Node).Args[i]));
  end else 
  if Node is TMethodCallNode then
  begin
    Analyze(TMethodCallNode(Node).Target);
    for i := 0 to TMethodCallNode(Node).Args.Count - 1 do Analyze(TNode(TMethodCallNode(Node).Args[i]));
  end
  else if Node is TArrayLiteralNode then begin for i := 0 to TArrayLiteralNode(Node).FElements.Count - 1 do Analyze(TNode(TArrayLiteralNode(Node).FElements[i])); end
  else if Node is TDictLiteralNode then begin for i := 0 to TDictLiteralNode(Node).FValues.Count - 1 do Analyze(TNode(TDictLiteralNode(Node).FValues[i])); end
  else if Node is TArrayAccessNode then begin Analyze(TArrayAccessNode(Node).FTarget); Analyze(TArrayAccessNode(Node).FIndexExpr); end
  else if Node is TArrayAssignNode then begin Analyze(TArrayAssignNode(Node).FTarget); Analyze(TArrayAssignNode(Node).FIndexExpr); Analyze(TArrayAssignNode(Node).FValueExpr); end
  else if Node is TArraySliceNode then begin Analyze(TArraySliceNode(Node).Target); Analyze(TArraySliceNode(Node).StartExpr); Analyze(TArraySliceNode(Node).EndExpr); Analyze(TArraySliceNode(Node).StepExpr); end
  else if Node is TMemberAccessNode then Analyze(TMemberAccessNode(Node).Target)
  else if Node is TMemberAssignNode then begin Analyze(TMemberAssignNode(Node).Target); Analyze(TMemberAssignNode(Node).Expr); end
  else if Node is TIfNode then 
  begin 
    Analyze(TIfNode(Node).Condition); 
    PushScope; Analyze(TIfNode(Node).ThenBranch); PopScope;
    if TIfNode(Node).ElseBranch <> nil then
    begin
      PushScope; Analyze(TIfNode(Node).ElseBranch); PopScope;
    end;
  end else 
  if Node is TWhileNode then 
  begin 
    Analyze(TWhileNode(Node).Condition); 
    PushScope; Analyze(TWhileNode(Node).Body); PopScope;
  end else 
  if Node is TRepeatNode then 
  begin 
    PushScope; 
    Analyze(TRepeatNode(Node).Body); 
    Analyze(TRepeatNode(Node).Condition); // <-- PERBAIKAN LOGIKA: Condition harus dianalisa sebelum PopScope (Karena Repeat-Until membaca variabel dari blok sebelumnya)
    PopScope;
  end else 
  if Node is TForNode then 
  begin 
    Analyze(TForNode(Node).StartExpr); 
    Analyze(TForNode(Node).EndExpr); 
  
    // ══════════════════════════════════════════════════════════════════
    // FIX KRITIS: MarkUsed WAJIB dipanggil SEBELUM PushScope.
    //
    // Alasan: MarkUsed memakai rumus `i < FScopes.Count - 1` untuk
    // memutuskan apakah suatu variabel harus ditangkap closure.
    //
    // Kalau PushScope dilakukan lebih dulu, FScopes.Count naik 1
    // sehingga variabel loop `i` (yang sebenarnya satu scope dengan
    // `var i;`) terlihat seolah-olah berasal dari scope luar.
    //
    // Akibatnya `i` keliru ditandai IsCaptured := True →
    // `var i;` dikompilasi jadi opcDefineGlobal, dan slot stack `i`
    // yang dipakai opcForLoopCond menjadi tidak sinkron (nil).
    // ══════════════════════════════════════════════════════════════════
    MarkUsed(TForNode(Node).VarName, Node);
  
    PushScope; 
    DeclareSymbol(TForNode(Node).VarName, Node);
    Analyze(TForNode(Node).Body); 
    PopScope; 
  end else 
  if Node is TForEachNode then 
  begin 
    Analyze(TForEachNode(Node).CollectionExpr); 
  
    // FIX KRITIS: sama seperti TForNode.
    MarkUsed(TForEachNode(Node).VarName, Node);
  
    PushScope; 
    DeclareSymbol(TForEachNode(Node).VarName, Node);
    Analyze(TForEachNode(Node).Body); 
    PopScope; 
  end else 
  if Node is TListComprehensionNode then 
  begin 
    Analyze(TListComprehensionNode(Node).CollectionExpr); 
    PushScope; 
    DeclareSymbol(TListComprehensionNode(Node).VarName, nil); 
    Analyze(TListComprehensionNode(Node).ConditionExpr); 
    Analyze(TListComprehensionNode(Node).OutputExpr); 
    PopScope; 
  end else 
  if Node is TCaseNode then 
  begin 
    Analyze(TCaseNode(Node).TargetExpr); 
    for i := 0 to High(TCaseNode(Node).Branches) do 
    begin 
      Analyze(TCaseNode(Node).Branches[i].MatchExpr); 
      PushScope; Analyze(TCaseNode(Node).Branches[i].Body); PopScope; 
    end; 
    if TCaseNode(Node).ElseBranch <> nil then 
    begin 
      PushScope; Analyze(TCaseNode(Node).ElseBranch); PopScope; 
    end; 
  end else 
  if Node is TTryCatchNode then 
  begin 
    PushScope; 
    Analyze(TTryCatchNode(Node).TryBlock); 
    PopScope; 
    
    PushScope; 
    if TTryCatchNode(Node).CatchVar <> '' then
    begin
      DeclareSymbol(TTryCatchNode(Node).CatchVar, nil); 
      MarkUsed(TTryCatchNode(Node).CatchVar, Node); 
    end;
    
    if TTryCatchNode(Node).CatchBlock <> nil then
      Analyze(TTryCatchNode(Node).CatchBlock); 
    PopScope; 
    
    if TTryCatchNode(Node).FinallyBlock <> nil then 
    begin 
      PushScope; 
      Analyze(TTryCatchNode(Node).FinallyBlock); 
      PopScope; 
    end; 
  end else 
  
  if Node is TUnaryOpNode  then Analyze(TUnaryOpNode(Node).Expr) else 
  if Node is TBinaryOpNode then 
  begin 
    Analyze(TBinaryOpNode(Node).Left); 
    Analyze(TBinaryOpNode(Node).Right); 
  end else 
  if Node is TTernaryNode then 
  begin 
    Analyze(TTernaryNode(Node).Condition); 
    Analyze(TTernaryNode(Node).TrueBranch); 
    Analyze(TTernaryNode(Node).FalseBranch); 
  end else 
  if Node is TReturnNode then Analyze(TReturnNode(Node).Expr) else 
  if Node is TYieldNode  then Analyze(TYieldNode(Node).Expr)  else 
  if Node is TLockNode   then Analyze(TLockNode(Node).Body)   else 
  if Node is TDeferNode  then Analyze(TDeferNode(Node).Body); 
end;

constructor TCachedModule.Create(const APath: string; ADict: TDictValue);
begin
  FilePath := APath;
  ExportedData := ADict;
  if Assigned(ExportedData) then ExportedData.Retain; // Amankan dari GC
end;

destructor TCachedModule.Destroy;
begin
  if Assigned(ExportedData) then ExportedData.Release;
  inherited;
end;

constructor TModuleManager.Create;
begin
  FCache := TModuleMap.Create; // HAPUS parameter True, TFPGMap tidak memiliki fitur OwnsObjects
  FCache.Sorted := True;       // Binary Search O(log N) untuk Instan Load
  FLock := TCriticalSection.Create;
end;

destructor TModuleManager.Destroy;
var
  i: Integer;
begin
  if Assigned(FLock) then
    FLock.Acquire;
  try
    if Assigned(FCache) then
    begin
      for i := 0 to FCache.Count - 1 do
        if Assigned(FCache.Data[i]) then
          FCache.Data[i].Free;
      FCache.Free;
    end;
  finally
    if Assigned(FLock) then
      FLock.Release;
  end;
  if Assigned(FLock) then FLock.Free;
  inherited;
end;

function TModuleManager.TryGetModule(const APath: string; out OutDict: TDictValue): Boolean;
var
  Idx: Integer;
begin
  Result := False;
  OutDict := nil;
  FLock.Acquire;
  try
    Idx := FCache.IndexOf(APath);
    if Idx <> -1 then
    begin
      OutDict := FCache.Data[Idx].ExportedData;
      // Amankan referensi objek sebelum Lock dilepas
      if Assigned(OutDict) then OutDict.Retain; 
      Result := True;
    end;
  finally
    FLock.Release;
  end;
end;

procedure TModuleManager.AddModule(const APath: string; ADict: TDictValue);
begin
  FLock.Acquire;
  try
    if FCache.IndexOf(APath) = -1 then
      FCache.Add(APath, TCachedModule.Create(APath, ADict));
  finally
    FLock.Release;
  end;
end;

procedure TModuleManager.MarkCacheRoots;
var i: Integer;
begin
  FLock.Acquire;
  try
    for i := 0 to FCache.Count - 1 do
      if Assigned(FCache.Data[i].ExportedData) then 
        FCache.Data[i].ExportedData.Mark;
  finally
    FLock.Release;
  end;
end;

constructor TPascakEngine.Create;
begin
  inherited Create;
  FIsRunning := False;
  FIsShuttingDown := False;
  FMemQuota := 256 * 1024 * 1024;
  FMaxExecTimeMs := 0;
  FMaxInstructions := 0;
  FObfuscateCache := False;   // ✨ PHASE 6
  
  InitializeRuntime;
end;

destructor TPascakEngine.Destroy;
begin
  if not FIsShuttingDown then
    Shutdown;
  TeardownRuntime;
  inherited;
end;

procedure TPascakEngine.InitializeRuntime;
begin
  // ✅ Auto-configure SQLite library path
  ConfigureSQLiteLibrary;
  
  // ✨ FIX: Reset GCurrentContext ke nil dulu
  GCurrentContext := nil;
  
  // 1. Thread-local error handler
  if not Assigned(errMSG) then
    errMSG := Terror.Create;
  
  // 2. Engine context PERTAMA
  FContext := TEngineContext.Create;
  
  if not Assigned(FContext) then
    raise EScriptFatalError.Create('Gagal membuat engine context');
  
  FContext.OwnerEngine := Self;
  FContext.MemQuota := FMemQuota;
  FContext.ObfuscationKey := BytecodeObfuscationKey;
  
  // ⚠️ JANGAN SET GCurrentContext DI SINI!
  // Set setelah semua sub-object siap
  
  try
    // 3. Global native environment (fallback register ke GLOBAL karena context belum di-set)
    FGlobalEnv := TSymbolTable.Create(nil);
    FGlobalEnv.Retain;
    FGlobalEnv.Context := FContext;
    FContext.GlobalEnv := FGlobalEnv;
    
    // 4. Built-in registries
    if ArrayMethodsRegistry = nil then
      InitBuiltInRegistries;
    
    // 5. Native functions
    initNativeCode(FGlobalEnv);
    
    // 6. Module manager
    FModuleManager := TModuleManager.Create;
    FContext.ModuleManager := FModuleManager;
    
    // 7. Event emitter
    FEventEmitter := TNativeEventEmitter.Create;
    FContext.EventEmitter := FEventEmitter;
    
    // 8. Event loop
    FEventLoop := TEventLoop.Create;
    FContext.EventLoop := FEventLoop;
    
    // 9. Worker pool
    FWorkerPool := TWorkerPool.Create(8, FContext);
    FContext.WorkerPool := FWorkerPool;

    // 10. Profiler & AllocTracker
    FProfiler := TProfiler.Create;
    FContext.Profiler := FProfiler;
    
    FAllocTracker := TAllocationTracker.Create;
    FContext.AllocTracker := FAllocTracker;
    
    // ✅ TAHAP D-1: Debug server (stub — di-Start hanya jika enabled)
    FDebugServer := TDebugServer.Create;
    FContext.DebugServer := FDebugServer;   
    
    // 11. SQLite connections
    FContext.SQLiteConnections := TObjectList.Create(True);
    
    // 12. Loaded DLLs
    FContext.LoadedDLLs := TList.Create;
    
    // 13. DMA pointers
    FContext.DMAPointers := TList.Create;
    
    // ✨ FIX: SET CONTEXT PALING AKHIR setelah semua siap
    GCurrentContext := FContext;
    
    FIsRunning := True;
  except
    // Rollback jika ada error
    if GCurrentContext = FContext then
      GCurrentContext := nil;
    if Assigned(FContext) then
    begin
      FContext.Free;
      FContext := nil;
    end;
    raise;
  end;
end;

procedure TPascakEngine.SetObfuscateCache(Enabled: Boolean);
begin
  FObfuscateCache := Enabled;
end;

procedure TPascakEngine.SetExecPolicy(const Config: TValue);
var
  Policy: TExecPolicy;
begin
  Policy := TExecPolicy.Create;
  try
    ApplyExecPolicyDict(Policy, Config);
    // No qualification needed — ProcSetExecPolicy unik
    ProcSetExecPolicy(Policy);
  finally
    Policy.Free;
  end;

  if Assigned(FContext) then
    FContext.ExecScriptPolicyLocked := True;
end;

procedure TPascakEngine.SetExecPolicyFromJson(const JsonStr: string);
var
  Data: TJSONData;
  Val: TValue;
begin
  Data := nil;
  try
    Data := GetJSON(JsonStr);
  except
    raise EScriptRuntimeError.Create(
      'SetExecPolicyFromJson: JSON tidak valid');
  end;

  try
    Val := ConvertJSONToTValue(Data, 0);
    try
      SetExecPolicy(Val);
    finally
      Val.Free;
    end;
  finally
    Data.Free;
  end;
end;

procedure TPascakEngine.LockExecPolicy;
begin
  if Assigned(FContext) then
    FContext.ExecScriptPolicyLocked := True;
end;

procedure TPascakEngine.TeardownRuntime;
var
  i: Integer;
begin

  FIsShuttingDown := True;
  if Assigned(FContext) then
    FContext.FShuttingDown := True;

  // 1. Worker pool
  if Assigned(FWorkerPool) then 
  begin 
    FWorkerPool.Free; 
    if GlobalWorkerPool = FWorkerPool then GlobalWorkerPool := nil;
    FWorkerPool := nil;
  end;
  
  // 2. Event loop
  if Assigned(FEventLoop) then 
  begin 
    FEventLoop.Free; 
    if GlobalEventLoop = FEventLoop then GlobalEventLoop := nil;
    FEventLoop := nil;
  end;
  
  // 3. Event emitter
  if Assigned(FEventEmitter) then 
  begin 
    FEventEmitter.Free; 
    if GlobalEventEmitter = FEventEmitter then GlobalEventEmitter := nil;
    FEventEmitter := nil;
  end;
  
  // 4. Module manager
  if Assigned(FModuleManager) then 
  begin 
    FModuleManager.Free; 
    if GlobalModuleManager = FModuleManager then GlobalModuleManager := nil;
    FModuleManager := nil;
  end;
  
  // 5. Profiler & AllocTracker
  if Assigned(FProfiler) then begin FProfiler.Free; FProfiler := nil; end;
  if Assigned(FAllocTracker) then begin FAllocTracker.Free; FAllocTracker := nil; end;
  
  // ✅ TAHAP D-1: Debug server
  if Assigned(FDebugServer) then 
  begin 
    FDebugServer.Free; 
    if Assigned(FContext) then FContext.DebugServer := nil;
    FDebugServer := nil; 
  end;  
  
  // 6. SQLite cleanup
  if Assigned(FContext) and Assigned(FContext.SQLiteConnections) then
  begin
    for i := 0 to FContext.SQLiteConnections.Count - 1 do
    begin
      if Assigned(FContext.SQLiteConnections[i]) then
      begin
        if TSQLite3Connection(FContext.SQLiteConnections[i]).Connected then
        begin
          if Assigned(TSQLite3Connection(FContext.SQLiteConnections[i]).Transaction) and 
             TSQLite3Connection(FContext.SQLiteConnections[i]).Transaction.Active then
            TSQLite3Connection(FContext.SQLiteConnections[i]).Transaction.Rollback;
          TSQLite3Connection(FContext.SQLiteConnections[i]).Close;
        end;
      end;
    end;
    FContext.SQLiteConnections.Free;
    FContext.SQLiteConnections := nil;
  end;
  
  // 7. DLLs
  if Assigned(FContext) and Assigned(FContext.LoadedDLLs) then
  begin
    for i := 0 to FContext.LoadedDLLs.Count - 1 do
    begin
      try UnloadLibrary(TLibHandle(FContext.LoadedDLLs[i])); except end;
    end;
    FContext.LoadedDLLs.Free;
    FContext.LoadedDLLs := nil;
  end;
  
  // 8. DMA pointers
  if Assigned(FContext) and Assigned(FContext.DMAPointers) then
  begin
    for i := 0 to FContext.DMAPointers.Count - 1 do
      FreeMem(FContext.DMAPointers[i]);
    FContext.DMAPointers.Free;
    FContext.DMAPointers := nil;
  end;
  
  // 9. Global env
  if Assigned(FGlobalEnv) then 
  begin 
    FGlobalEnv.Release; 
    FGlobalEnv := nil;
  end;
  
  // 10. Context (yang akan cleanup GC lists & arena)
  if Assigned(FContext) then
  begin
    FContext.Release;  
    FContext := nil;
  end;
  
  // 10b. ✅ FASE 1.1: Sekarang aman clear GCurrentContext.
  // Semua TValue yang di-alloc pada context ini sudah di-free (atau
  // akan di-free via global fallback setelah ini, tapi counter mereka
  // sudah di-decrement dengan benar sebelum context mati).
  if GCurrentContext <> nil then
    GCurrentContext := nil;
  
  // 11. errMSG
  if Assigned(errMSG) then 
  begin 
    errMSG.Free; 
    errMSG := nil; 
  end;
end;

procedure TPascakEngine.SetMemoryQuota(Bytes: Int64);
begin
  // ✨ FIX A3 (Phase 7.5): Cek FIsShuttingDown, bukan FIsRunning
  if FIsShuttingDown then
    raise EScriptRuntimeError.Create('Engine sudah dalam proses shutdown');
  
  FMemQuota := Bytes;
  GlobalMemQuota := Bytes;
  
  if Assigned(FContext) then
    FContext.MemQuota := Bytes;
end;

procedure TPascakEngine.SetMaxExecutionTime(Ms: QWord);
begin
  FMaxExecTimeMs := Ms;
end;

procedure TPascakEngine.SetMaxInstructions(Count: Int64);
begin
  FMaxInstructions := Count;
end;

procedure TPascakEngine.RegisterNative(const Name: string; Func: TNativeRoutine);
begin
  if not Assigned(FGlobalEnv) then Exit;
  FGlobalEnv.DefineVar(Name, TValue.CreateNative(Func), False);
end;

procedure TPascakEngine.RegisterValue(const Name: string; Val: TValue);
begin
  if not Assigned(FGlobalEnv) then Exit;
  FGlobalEnv.DefineVar(Name, Val, False);
end;

procedure TPascakEngine.RegisterModule(const Path, Source: string);
var
  SubLex: TLexer;
  SubPars: TParser;
  SubRoot: TBlockNode;
  SubComp: TCompiler;
  SubVM: TVM;
  TempScope: TSymbolTable;
  ExportedDict: TDictValue;
begin
  SubLex := TLexer.Create(Source);
  SubPars := TParser.Create(SubLex);
  TempScope := TSymbolTable.Create(FGlobalEnv);
  SubVM := nil;
  SubRoot := nil;
  SubComp := nil;
  try
    SubRoot := SubPars.ParseMainProgram;
    SubComp := TCompiler.Create;
    SubVM := TVM.Create(TempScope);
    
    SubComp.Compile(SubRoot, True);
    SubComp.Chunk.OptimizeBytecode;
    
    SubVM.Run(SubComp.Chunk).Free;
    
    ExportedDict := TempScope.GetExportedDict;
    try
      FModuleManager.AddModule(Path, ExportedDict);
    finally
      // AddModule sudah Retain, kita lepas ref lokal
      ExportedDict.Release;
    end;
  finally
    if Assigned(SubVM) then SubVM.Free;
    if Assigned(SubComp) then SubComp.Free;
    if Assigned(SubRoot) then SubRoot.Free;
    TempScope.Release;
    SubPars.Free;
    SubLex.Free;
  end;
end;

function TPascakEngine.CompileSource(const Source, SourceName: string): TChunk;
var
  LocalLex: TLexer;
  LocalPars: TParser;
  LocalRoot: TBlockNode;
  LocalComp: TCompiler;
  LocalOpt: TCSEOptimizer;
  LocalDCE: TDeadCodeAnalyzer;
begin
  LocalLex := TLexer.Create(Source);
  LocalPars := TParser.Create(LocalLex);
  LocalRoot := nil;
  LocalComp := nil;
  Result := nil;
  try
    LocalRoot := LocalPars.ParseMainProgram;
    if not Assigned(LocalRoot) then
      raise EScriptFatalError.Create('Parser mengembalikan AST kosong untuk ' + SourceName);
    
    // Phase 1: Dead code analysis
    LocalDCE := TDeadCodeAnalyzer.Create(FGlobalEnv);
    try
      LocalDCE.Analyze(LocalRoot);
    finally
      LocalDCE.Free;
    end;
    
    // Phase 2: Peephole & CSE
    LocalOpt := TCSEOptimizer.Create;
    try
      LocalOpt.OptimizeBlock(LocalRoot);
    finally
      LocalOpt.Free;
    end;
    
    // Phase 3: Compile to bytecode
    LocalComp := TCompiler.Create;
    LocalComp.Compile(LocalRoot, True);
    LocalComp.Chunk.OptimizeBytecode;
    //OptimizeLoopBytecode(LocalComp.Chunk);
    LocalComp.Chunk.SourceFile := SourceName;
    
    // Transfer ownership
    Result := LocalComp.Chunk;
    LocalComp.FChunk := nil;
  finally
    if Assigned(LocalComp) then LocalComp.Free;
    if Assigned(LocalRoot) then LocalRoot.Free;
    LocalPars.Free;
    LocalLex.Free;
  end;
end;

function TPascakEngine.LoadOrCompile(const SourcePath: string; 
  out CacheHit: Boolean): TChunk;
var
  SourceCode: string;
  CachePath: string;
  CacheFile: TFileStream;
  Magic: array[0..3] of AnsiChar;
  Vers: Integer;
  Flags: Cardinal;
  Timestamp: QWord;
  StoredHash: Cardinal;
  CurrentHash: Cardinal;
  i: Integer;
begin
  CacheHit := False;
  SourceCode := LoadScriptFromFile(SourcePath);
  if SourceCode = '' then
    raise EScriptRuntimeError.Create('File kosong: ' + SourcePath);
  
  // Hitung hash source saat ini
  CurrentHash := 0;
  for i := 1 to Length(SourceCode) do
    CurrentHash := (CurrentHash xor Cardinal(Ord(SourceCode[i]))) * Cardinal(16777619);
  
  CachePath := SourcePath + '.pbc';
  
  // Coba load cache
  if SysUtils.FileExists(CachePath) then
  begin
    try
      CacheFile := TFileStream.Create(CachePath, fmOpenRead or fmShareDenyNone);
      try
        CacheFile.ReadBuffer(Magic, 4);
        if string(Magic) = 'PSCK' then
        begin
          CacheFile.ReadBuffer(Vers, SizeOf(Integer));
          CacheFile.ReadBuffer(Flags, SizeOf(Cardinal));
          CacheFile.ReadBuffer(Timestamp, SizeOf(QWord));
          CacheFile.ReadBuffer(StoredHash, SizeOf(Cardinal));
          
          if (Vers >= PSCK_VERSION_MIN_SUPPORTED) and 
             (Vers <= PSCK_VERSION_CURRENT) and
             (StoredHash = CurrentHash) then
          begin
            // Cache valid — load
            Result := TChunk.Create;
            Result.SourceFile := SourcePath;
            CacheFile.Position := 4 + SizeOf(Integer) + SizeOf(Cardinal) + 
                                   SizeOf(QWord) + SizeOf(Cardinal);
            Result.LoadFromStream(CacheFile);
            CacheHit := True;
            Exit;
          end;
        end;
      finally
        CacheFile.Free;
      end;
    except
      // Cache corrupt — abaikan, compile ulang
    end;
  end;
  
  // Cache miss — compile
  Result := CompileSource(SourceCode, SourcePath);
  
  // Save cache
  try
    Result.SaveToFile(CachePath, FObfuscateCache);  
  except
    // Gagal save cache bukan fatal
  end;
end;

function TPascakEngine.ExecuteChunk(Chunk: TChunk; OutVM: TVM): TValue;
var
  LocalVM: TVM;
begin
  LocalVM := TVM.Create(FGlobalEnv);
  try
    // Apply watchdog config
    LocalVM.MaxExecutionTimeMs := FMaxExecTimeMs;
    LocalVM.MaxInstructions := FMaxInstructions;
    
    Result := LocalVM.Run(Chunk);
  finally
    if Assigned(OutVM) then
      OutVM := LocalVM
    else
      LocalVM.Free;
  end;
end;

procedure TPascakEngine.SetDebugEnabled(Enabled: Boolean);
begin
  if Enabled then
  begin
    if Assigned(FDebugServer) then
      FDebugServer.Start;    // blocking handshake
  end
  else
  begin
    if Assigned(FDebugServer) then
      FDebugServer.Stop;
  end;
end;

function TPascakEngine.ExecuteString(const Source: string; 
  const SourceName: string): TValue;
var
  BytecodeChunk: TChunk;
  LocalVM: TVM;
  SavedQuota: Int64;
  SavedUsage: Int64;
begin
  if FIsShuttingDown then
    raise EScriptRuntimeError.Create('Engine sudah shutdown');

  // ✨ PHASE 7: Save/restore global quota untuk isolation
  SavedQuota := GlobalMemQuota;
  SavedUsage := GlobalMemUsage;
  GlobalMemQuota := FMemQuota;
  GlobalMemUsage := FContext.MemUsage;
  
  FIsRunning := True;
  try
    BytecodeChunk := CompileSource(Source, SourceName);
    try
      LocalVM := TVM.Create(FGlobalEnv);
      try
        LocalVM.MaxExecutionTimeMs := FMaxExecTimeMs;
        LocalVM.MaxInstructions := FMaxInstructions;
        Result := LocalVM.Run(BytecodeChunk);
      finally
        LocalVM.Free;
      end;
    finally
      BytecodeChunk.Free;
    end;
  finally
    // Simpan usage kembali ke context
    FContext.MemUsage := GlobalMemUsage;
    GlobalMemQuota := SavedQuota;
    GlobalMemUsage := SavedUsage;
    
    FIsRunning := False;
  end;
end;

function TPascakEngine.ExecuteFile(const Path: string): TValue;
var
  SafePath: string;
  BytecodeChunk: TChunk;
  LocalVM: TVM;
  CacheHit: Boolean;
begin
  SafePath := GetSafeSandboxedPath(Path);
  
  // ✨ PHASE 4: Gunakan LoadOrCompile untuk caching
  BytecodeChunk := LoadOrCompile(SafePath, CacheHit);
  try
    LocalVM := TVM.Create(FGlobalEnv);
    try
      LocalVM.MaxExecutionTimeMs := FMaxExecTimeMs;
      LocalVM.MaxInstructions := FMaxInstructions;
      Result := LocalVM.Run(BytecodeChunk);
    finally
      LocalVM.Free;
    end;
  finally
    BytecodeChunk.Free;
  end;
end;

function TPascakEngine.CallFunction(const Name: string; 
  const Args: array of TValue): TValue;
var
  TargetFunc: TValue;
  TempChunk: TChunk;
  LocalVM: TVM;
  i: Integer;
begin
  // Resolve function dari global env
  TargetFunc := FGlobalEnv.GetVar(Name);
  try
    if TargetFunc.DataType <> dtFunction then
      raise EScriptRuntimeError.CreateFmt(
        'CallFunction: "%s" bukan fungsi (tipe: %d)', [Name, Ord(TargetFunc.DataType)]);
    
    // Build temporary chunk yang call fungsi ini
    TempChunk := TChunk.Create;
    try
      TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(TargetFunc.Clone));
      for i := 0 to High(Args) do
        TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(Args[i].Clone));
      TempChunk.AddInstruction(opcCall, Length(Args));
      TempChunk.AddInstruction(opcHalt);
      
      LocalVM := TVM.Create(FGlobalEnv);
      try
        LocalVM.MaxExecutionTimeMs := FMaxExecTimeMs;
        LocalVM.MaxInstructions := FMaxInstructions;
        Result := LocalVM.Run(TempChunk);
      finally
        LocalVM.Free;
      end;
    finally
      TempChunk.Free;
    end;
  finally
    TargetFunc.Free;
  end;
end;

procedure TPascakEngine.RunEventLoop;
begin
  if Assigned(FEventLoop) then
    FEventLoop.RunLoop(FGlobalEnv);
end;

procedure TPascakEngine.Shutdown;
begin
  if FIsShuttingDown then Exit;
  InterlockedExchange(IsShuttingDown, 1);
  FIsShuttingDown := True;
end;

function TPascakEngine.GetMemoryUsage: Int64;
begin
  Result := GlobalMemUsage;
end;

function TPascakEngine.GetActiveVMs: Integer;
begin
  Result := 0;
  if Assigned(ActiveVMs) then
  begin
    GCRootLock.Acquire;
    try
      Result := ActiveVMs.Count;
    finally
      GCRootLock.Release;
    end;
  end;
end;

function TPascakEngine.GetGCStats: string;
var
  Gen0Count, Gen1Count, ZombieCount: Integer;
begin
  MemLock.Acquire;
  try
    if Assigned(Gen0Objects) then Gen0Count := Gen0Objects.Count else Gen0Count := 0;
    if Assigned(Gen1Objects) then Gen1Count := Gen1Objects.Count else Gen1Count := 0;
  finally
    MemLock.Release;
  end;
  
  ZombieLock.Acquire;
  try
    if Assigned(ZombieQueue) then ZombieCount := ZombieQueue.Count else ZombieCount := 0;
  finally
    ZombieLock.Release;
  end;
  
  Result := Format('GC: Gen0=%d Gen1=%d Zombie=%d Mem=%d/%d bytes (%.1f%%)',
    [Gen0Count, Gen1Count, ZombieCount, GlobalMemUsage, GlobalMemQuota,
     100.0 * GlobalMemUsage / GlobalMemQuota]);
end;

constructor TEngineContext.Create;
begin
  inherited Create;
  FEngineMagic := ENGINE_MAGIC_CONST;   
  FRefCount := 1;  
  OwnerEngine := nil;
  GlobalEnv := nil;
  ModuleManager := nil;
  EventLoop := nil;
  WorkerPool := nil;
  EventEmitter := nil;
  Workers := nil;
  DebugServer := nil;
  Profiler := nil;
  AllocTracker := nil;
  SQLiteConnections := nil;
  LoadedDLLs := nil;
  DMAPointers := nil;
  ModuleCache := nil;
  MemQuota := 256 * 1024 * 1024;
  MemUsage := 0;
  FShuttingDown := False;
  ObfuscationKey := 'Pascak-Default-Key-Change-Me';
  ExecScriptPolicyLocked := False;   // default: script boleh set policy
  
  // ✨ PHASE 8: Inisialisasi per-engine GC & Arena
  Gen0Objects := TList.Create;
  Gen1Objects := TList.Create;
  ZombieQueue := TList.Create;
  ArenaBlocks := nil;
  GCLock := TCriticalSection.Create;
  MemLock := TCriticalSection.Create;
  ZombieLock := TCriticalSection.Create;
  ArenaLock := TCriticalSection.Create;
  IsGCRunning := 0;
  
  // ✨ FIX P1: Init arena bump state — WAJIB nil!
  CurrentArenaBlock := nil;
  CurrentArenaBumpPtr := nil;
  CurrentArenaBumpEnd := nil;
  
  AllocationCounter := 0;
  GCTickThreshold := 65536;   // Mulai dengan 64K alokasi
  LastGCTime := 0;  
end;

destructor TEngineContext.Destroy;
var
  i: Integer;
  Block, NextBlock: PArenaBlock;
begin
  FEngineMagic := 0;
  FIsTearingDown := True;
  
  // B.2.5 NOTE: GlobalEnv cleanup di-skip saat shutdown.
  // Leak 16 KB per exit by design — hindari cascade AV.
  // Heaptrace akan report "239 unfreed" tapi production OK.
  // Cleanup sebenarnya: OS reclaim saat process exit.
  // Kalau mau di-verify: cek `IsShuttingDown` guard di TSymbolTable.ClearMap.
  
  if Assigned(Gen0Objects) then
  begin
    // Freeze semua refcount agar tidak ada cascade saat Free di tempat lain
    for i := 0 to Gen0Objects.Count - 1 do
    begin
      if Assigned(Gen0Objects[i]) then
        TGCManagedObject(Gen0Objects[i]).FRefCount := 9999999;
    end;
    Gen0Objects.Clear;
    Gen0Objects.Free;
    Gen0Objects := nil;
  end;
  
  if Assigned(Gen1Objects) then
  begin
    for i := 0 to Gen1Objects.Count - 1 do
    begin
      if Assigned(Gen1Objects[i]) then
        TGCManagedObject(Gen1Objects[i]).FRefCount := 9999999;
    end;
    Gen1Objects.Clear;
    Gen1Objects.Free;
    Gen1Objects := nil;
  end;
  
  if Assigned(ZombieQueue) then
  begin
    for i := 0 to ZombieQueue.Count - 1 do
    begin
      if Assigned(ZombieQueue[i]) then
        TGCManagedObject(ZombieQueue[i]).FRefCount := 9999999;
    end;
    ZombieQueue.Clear;
    ZombieQueue.Free;
    ZombieQueue := nil;
  end;
  
  // Cleanup arena blocks
  if Assigned(ArenaLock) then
  begin
    ArenaLock.Acquire;
    try
      Block := ArenaBlocks;
      while Block <> nil do
      begin
        NextBlock := Block^.Next;
        if Assigned(Block^.Data) then FreeMem(Block^.Data);
        Dispose(Block);
        Block := NextBlock;
      end;
      ArenaBlocks := nil;
    finally
      ArenaLock.Release;
    end;
  end;
  
  if Assigned(Workers) then
  begin
    Workers.Free;
    Workers := nil;
  end;
  
  if Assigned(ModuleCache) then
  begin
    ModuleCache.Free;
    ModuleCache := nil;
  end;
  
  if Assigned(GCLock) then begin GCLock.Free; GCLock := nil; end;
  if Assigned(MemLock) then begin MemLock.Free; MemLock := nil; end;
  if Assigned(ZombieLock) then begin ZombieLock.Free; ZombieLock := nil; end;
  if Assigned(ArenaLock) then begin ArenaLock.Free; ArenaLock := nil; end;
  
  inherited;
end;

function TEngineContext.AllocateQuota(Size: Int64): Boolean;
var
  NewUsage: Int64;
begin
  // Thread-safe atomic add
  NewUsage := InterlockedExchangeAdd64(MemUsage, Size) + Size;
  if (MemQuota > 0) and (NewUsage > MemQuota) then
  begin
    InterlockedExchangeAdd64(MemUsage, -Size);   // rollback
    Exit(False);
  end;
  Result := True;
end;

procedure TEngineContext.FreeQuota(Size: Int64);
begin
  InterlockedExchangeAdd64(MemUsage, -Size);
end;

function TEngineContext.AllocateFromArena(Size: Integer): Pointer;
var
  NewBlock: PArenaBlock;
  LocalAlign: Integer;
  BlockSize: Integer;
begin
  Result := nil;

  // ✅ FIX: Guard terhadap Size <= 0 dari caller yang belum di-init.
  if Size <= 0 then
    Size := (TValue.InstanceSize + 15) and not 15;

  LocalAlign := (Size + 15) and not 15;
  if LocalAlign < 16 then LocalAlign := 16;   // safety net tambahan

  BlockSize := ARENA_BLOCK_CAPACITY * LocalAlign;
  
  // ✨ FIX: Guard ArenaLock sebelum Acquire
  if not Assigned(ArenaLock) then
  begin
    // Fallback: alokasi dari OS langsung
    GetMem(Result, LocalAlign);
    Exit;
  end;
  
  ArenaLock.Acquire;
  try
    // Fast path: bump pointer masih punya ruang
    if (CurrentArenaBumpPtr <> nil) and 
       (CurrentArenaBumpEnd <> nil) and
       (CurrentArenaBumpEnd > CurrentArenaBumpPtr) and
       (CurrentArenaBumpPtr + LocalAlign <= CurrentArenaBumpEnd) then
    begin
      Result := CurrentArenaBumpPtr;
      Inc(CurrentArenaBumpPtr, LocalAlign);
      Exit;
    end;
    
    // Slow path: alokasi blok baru
    New(NewBlock);
    GetMem(NewBlock^.Data, BlockSize);
    
    // Insert di head
    NewBlock^.Next := ArenaBlocks;
    ArenaBlocks := NewBlock;
    
    // Update bump state
    CurrentArenaBlock := NewBlock;
    CurrentArenaBumpPtr := NewBlock^.Data + LocalAlign;
    CurrentArenaBumpEnd := NewBlock^.Data + BlockSize;
    
    Result := NewBlock^.Data;
  finally
    ArenaLock.Release;
  end;
end;

procedure TEngineContext.RegisterGCObject(Obj: TObject);
begin
  // Delegate ke global function yang sudah context-aware
  // (RegisterGC membaca GCurrentContext dan pakai Ctx.Gen0Objects)
  RegisterGC(Obj);
end;

procedure TEngineContext.UnregisterGCObject(Obj: TObject);
begin
  // Delegate ke global function yang sudah context-aware
  // (UnregisterGC membaca GCurrentContext dan pakai Ctx.Gen0Objects/Gen1Objects/ZombieQueue)
  UnregisterGC(Obj);
end;

procedure TEngineContext.Retain;
begin
  InterlockedIncrement(FRefCount);
end;

procedure TEngineContext.Release;
begin
  if InterlockedDecrement(FRefCount) = 0 then
    Self.Free;
end;

{ ====================================================================
  TDebugServer Implementation
  ==================================================================== }
constructor TDebugServer.Create;
begin
  inherited Create;
  FInput := nil;
  FOutput := nil;
  FSequence := 0;
  FBreakpointCount := 0;
  SetLength(FBreakpoints, 0);
  FStepMode := dsmNone;
  FIsStopped := False;
  FIsPaused := False;
  FEnabled := False;
  FLock := TCriticalSection.Create;
end;

destructor TDebugServer.Destroy;
begin
  Stop;
  FLock.Free;
  inherited;
end;

{$IFDEF WINDOWS}
function GetStdInputHandle: THandle;
begin
  Result := GetStdHandle(STD_INPUT_HANDLE);
end;

function GetStdOutputHandle: THandle;
begin
  Result := GetStdHandle(STD_OUTPUT_HANDLE);
end;
{$ENDIF}

procedure TDebugServer.Start;
var
  InHandle, OutHandle: THandle;
  IsInvalidIn, IsInvalidOut: Boolean;
  Seq: Integer;
  Method: string;
  Params: TJSONObject;
  HandshakeDone: Boolean;
begin
  FLock.Acquire;
  try
    if FEnabled then Exit;
    
    {$IFDEF WINDOWS}
      InHandle  := GetStdHandle(STD_INPUT_HANDLE);
      OutHandle := GetStdHandle(STD_OUTPUT_HANDLE);
      IsInvalidIn  := (InHandle = INVALID_HANDLE_VALUE) or (InHandle = 0);
      IsInvalidOut := (OutHandle = INVALID_HANDLE_VALUE) or (OutHandle = 0);
    {$ELSE}
      InHandle  := 0;
      OutHandle := 1;
      IsInvalidIn  := False;
      IsInvalidOut := False;
    {$ENDIF}
    
    try
      if not IsInvalidIn then
        FInput := THandleStream.Create(InHandle);
      if not IsInvalidOut then
        FOutput := THandleStream.Create(OutHandle);
    except
      if Assigned(FInput) then begin FInput.Free; FInput := nil; end;
      if Assigned(FOutput) then begin FOutput.Free; FOutput := nil; end;
    end;
    
    FEnabled := Assigned(FInput) and Assigned(FOutput);
  finally
    FLock.Release;
  end;
  
  // ✅ D-1: handshake — baca request sampai configurationDone.
  // Client akan mengirim: initialize, launch, setBreakpoints, configurationDone.
  if FEnabled then
  begin
    FIsDraining := True;
    HandshakeDone := False;
    while FEnabled and not HandshakeDone do
    begin
      if ReadMessage(Seq, Method, Params) then
      begin
        try
          HandleRequest(Method, Params, Seq);
        finally
          if Assigned(Params) then Params.Free;
        end;
        if Method = 'configurationDone' then
          HandshakeDone := True;
      end
      else
        Sleep(5);
    end;
    FIsDraining := False;
  end;
end;

procedure TDebugServer.Stop;
begin
  FLock.Acquire;
  try
    FEnabled := False;
    if Assigned(FInput) then begin FInput.Free; FInput := nil; end;
    if Assigned(FOutput) then begin FOutput.Free; FOutput := nil; end;
  finally
    FLock.Release;
  end;
end;

function TDebugServer.ReadMessage(out Seq: Integer; out Method: string; 
  out Params: TJSONObject): Boolean;
var
  Header: string;
  ContentLen: Integer;
  Content: string;
  C: AnsiChar;
  JSONData: TJSONData;
  Root: TJSONObject;
  PObj: TJSONData;
  P, LineEnd: Integer;
begin
  Seq := 0;
  Method := '';
  Params := nil;
  Result := False;
  
  if not Assigned(FInput) then Exit;
  
  // Baca header (content-length)
  ContentLen := 0;
  Header := '';
  try
    while FInput.Read(C, 1) = 1 do
    begin
      Header := Header + Char(C);
      if (Length(Header) >= 4) and 
         (Copy(Header, Length(Header) - 3, 4) = #13#10#13#10) then
        Break;
      if Length(Header) > 1024 then Exit;
    end;
  except
    Exit;
  end;
  
  P := Pos('Content-Length:', Header);
  if P = 0 then Exit;
  LineEnd := PosEx(#13#10, Header, P + 15);
  if LineEnd = 0 then Exit;
  ContentLen := StrToIntDef(Trim(Copy(Header, P + 15, LineEnd - P - 15)), 0);
  if ContentLen <= 0 then Exit;
  
  SetLength(Content, ContentLen);
  if FInput.Read(Content[1], ContentLen) <> ContentLen then Exit;
  
  JSONData := nil;
  try
    try
      JSONData := GetJSON(Content);
    except
      Exit;
    end;
    
    if not Assigned(JSONData) then Exit;
    
    if JSONData.JSONType = jtObject then
    begin
      Root := TJSONObject(JSONData);
      
      // ✅ D-1: extract seq
      Seq := Root.Get('seq', 0);
      FLastSeq := Seq;
      
      Method := Root.Get('command', '');
      
      PObj := Root.Find('arguments');
      if Assigned(PObj) and (PObj.JSONType = jtObject) then
        Params := TJSONObject(PObj.Clone)
      else
        Params := TJSONObject.Create;
        
      Result := Method <> '';
    end;
  finally
    JSONData.Free;
  end;
end;

procedure TDebugServer.WriteMessage(const JSONStr: string);
var
  Header: string;
begin
  if not Assigned(FOutput) then Exit;
  Header := Format('Content-Length: %d'#13#10#13#10, [Length(JSONStr)]);
  FOutput.WriteBuffer(Header[1], Length(Header));
  if JSONStr <> '' then
    FOutput.WriteBuffer(JSONStr[1], Length(JSONStr));
  // ✨ Tidak ada Flush — THandleStream tidak mendukung, stdio umumnya unbuffered
end;

procedure TDebugServer.SendEvent(const EventName: string; Body: TJSONObject);
var
  Root: TJSONObject;
  JSONStr: string;
begin
  FLock.Acquire;
  try
    Inc(FSequence);
    Root := TJSONObject.Create;
    try
      Root.Add('seq', FSequence);
      Root.Add('type', 'event');
      Root.Add('event', EventName);
      if Assigned(Body) then
        Root.Add('body', Body)   // ← Body di-adopsi oleh Root
      else
        Root.Add('body', TJSONObject.Create);
      JSONStr := Root.AsJSON;
    finally
      Root.Free;   // ← Root.Free akan Free Body juga (karena diadopsi)
    end;
    WriteMessage(JSONStr);
  finally
    FLock.Release;
  end;
end;

procedure TDebugServer.SendResponse(const RequestSeq: Integer; const Command: string; 
                                     Success: Boolean; Body: TJSONObject; 
                                     const ErrMsg: string);
var
  Root, BodyObj: TJSONObject;
  JSONStr: string;
begin
  FLock.Acquire;
  try
    Inc(FSequence);
    Root := TJSONObject.Create;
    try
      Root.Add('seq', FSequence);
      Root.Add('type', 'response');
      Root.Add('request_seq', RequestSeq);
      Root.Add('success', Success);
      Root.Add('command', Command);
      
      if Success and Assigned(Body) then
        Root.Add('body', Body)
      else
      begin
        BodyObj := TJSONObject.Create;
        BodyObj.Add('error', TJSONObject.Create(['id', 1, 'format', ErrMsg]));
        Root.Add('body', BodyObj);
      end;
      
      JSONStr := Root.AsJSON;
    finally
      Root.Free;
    end;
    WriteMessage(JSONStr);
  finally
    FLock.Release;
  end;
end;

function TDebugServer.BreakpointAt(const FileName: string; Line: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to FBreakpointCount - 1 do
  begin
    if (FBreakpoints[i].Line = Line) and 
       ((FBreakpoints[i].FileName = FileName) or (FBreakpoints[i].FileName = '')) then
      Exit(i);
  end;
end;

procedure TDebugServer.HandleRequest(const Cmd: string; Params: TJSONObject; 
 RequestSeq: Integer);
var
  Body: TJSONObject;
  BPsArray: TJSONArray;
  BPItem, SrcObj : TJSONData;
  i, Line, WriteIdx: Integer;
  FileName: string;
  NewBP: TDebugBreakpoint;
  ResultArr: TJSONArray;
  BPObj: TJSONObject;
begin
  if Cmd = 'initialize' then
  begin
    Body := TJSONObject.Create;
    Body.Add('supportsConfigurationDoneRequest', True);
    Body.Add('supportsFunctionBreakpoints', False);
    Body.Add('supportsConditionalBreakpoints', False);
    Body.Add('supportsHitConditionalBreakpoints', False);
    Body.Add('supportsEvaluateForHovers', False);
    Body.Add('supportsStepBack', False);
    SendResponse(RequestSeq, Cmd, True, Body);
    SendEvent('initialized', nil);
  end
  else if Cmd = 'launch' then
  begin
    FEnabled := True;
    SendResponse(RequestSeq, Cmd, True, nil);
    SendEvent('initialized', nil);
  end
  else if Cmd = 'setBreakpoints' then
  begin
    if Assigned(Params) then
    begin
      FileName := Params.Get('source', '');
      SrcObj := Params.Find('source');
      if Assigned(SrcObj) and (SrcObj.JSONType = jtObject) then
        FileName := TJSONObject(SrcObj).Get('path', '');
      
      BPsArray := TJSONArray(Params.Find('breakpoints'));
      if Assigned(BPsArray) then
      begin
        WriteIdx := 0;
        for i := 0 to FBreakpointCount - 1 do
        begin
          if FBreakpoints[i].FileName <> FileName then
          begin
            FBreakpoints[WriteIdx] := FBreakpoints[i];
            Inc(WriteIdx);
          end;
        end;
        FBreakpointCount := WriteIdx;
        
        Body := TJSONObject.Create;
        ResultArr := TJSONArray.Create;
        for i := 0 to BPsArray.Count - 1 do
        begin
          BPItem := BPsArray.Items[i];
          if BPItem.JSONType = jtObject then
          begin
            Line := TJSONObject(BPItem).Get('line', 0);
            NewBP.FileName := FileName;
            NewBP.Line := Line;
            NewBP.Verified := True;
            
            if FBreakpointCount >= Length(FBreakpoints) then
              SetLength(FBreakpoints, FBreakpointCount + 8);
            FBreakpoints[FBreakpointCount] := NewBP;
            Inc(FBreakpointCount);
            
            BPObj := TJSONObject.Create;
            BPObj.Add('verified', True);
            BPObj.Add('line', Line);
            ResultArr.Add(BPObj);
          end;
        end;
        Body.Add('breakpoints', ResultArr);
        SendResponse(RequestSeq, Cmd, True, Body);
      end
      else
        SendResponse(RequestSeq, Cmd, True, nil);
    end
    else
      SendResponse(RequestSeq, Cmd, True, nil);
  end
  else if Cmd = 'configurationDone' then
    SendResponse(RequestSeq, Cmd, True, nil)
  else if Cmd = 'continue' then
  begin
    FIsPaused := False;
    FIsStopped := False;
    FStepMode := dsmNone;
    SendResponse(RequestSeq, Cmd, True, nil);
    SendEvent('continued', nil);
  end
  else if Cmd = 'next' then
  begin
    FIsPaused := False;
    FIsStopped := False;
    FStepMode := dsmStepOver;
    if Assigned(FActiveVM) then
      FStepOverFrameDepth := FActiveVM.FFrameCount;
    SendResponse(RequestSeq, Cmd, True, nil);
    SendEvent('continued', nil);
  end
  else if Cmd = 'stepIn' then
  begin
    FIsPaused := False;
    FIsStopped := False;
    FStepMode := dsmStepIn;
    SendResponse(RequestSeq, Cmd, True, nil);
    SendEvent('continued', nil);
  end
  else if Cmd = 'stepOut' then
  begin
    FIsPaused := False;
    FIsStopped := False;
    FStepMode := dsmStepOut;
    if Assigned(FActiveVM) then
      FStepOverFrameDepth := FActiveVM.FFrameCount;
    SendResponse(RequestSeq, Cmd, True, nil);
    SendEvent('continued', nil);
  end
  else if Cmd = 'stackTrace' then
    HandleStackTrace(Params, RequestSeq)
  else if Cmd = 'scopes' then
    HandleScopes(Params, RequestSeq)
  else if Cmd = 'variables' then
    HandleVariables(Params, RequestSeq)
  else if Cmd = 'evaluate' then
    HandleEvaluate(Params, RequestSeq)
  else if Cmd = 'threads' then
    HandleThreads(Params, RequestSeq)
  else if Cmd = 'disconnect' then
  begin
    FEnabled := False;
    SendResponse(RequestSeq, Cmd, True, nil);
    SendEvent('terminated', nil);
  end
  else
    SendResponse(RequestSeq, Cmd, False, nil, 'Unsupported command: ' + Cmd);
end;

function TDebugServer.GetFrameByDapId(DapFrameId: Integer): Integer;
begin
  if not Assigned(FActiveVM) then Exit(-1);
  Result := (FActiveVM.FFrameCount - 1) - DapFrameId;
  if (Result < 0) or (Result >= FActiveVM.FFrameCount) then
    Result := -1;
end;

function TDebugServer.FormatFrameName(FrameIdx: Integer): string;
var
  FV: TValue;
begin
  Result := '<main>';
  if (FrameIdx < 0) or (FrameIdx >= FActiveVM.FFrameCount) then Exit;
  
  FV := FActiveVM.FFrames[FrameIdx].FuncValue;
  if Assigned(FV) and (FV.DataType = dtFunction) and Assigned(FV.FuncVal) then
  begin
    if FV.FuncVal.Name <> '' then
      Result := FV.FuncVal.Name
    else
      Result := '<lambda>';
  end;
end;

function TDebugServer.TValueToDAPVariable(const Name: string; Val: TValue): TJSONObject;
var
  TypeStr, ValueStr: string;
begin
  Result := TJSONObject.Create;
  Result.Add('name', Name);
  
  if not Assigned(Val) then
  begin
    Result.Add('value', 'nil');
    Result.Add('type', 'null');
    Result.Add('variablesReference', 0);
    Exit;
  end;
  
  case Val.DataType of
    dtNumeric:
      begin
        TypeStr := 'number';
        if Frac(Val.NumVal) = 0 then
          ValueStr := IntToStr(Trunc(Val.NumVal))
        else
          ValueStr := FloatToStr(Val.NumVal, FS);
      end;
    dtString:
      begin
        TypeStr := 'string';
        ValueStr := '"' + Val.StrVal + '"';
      end;
    dtBoolean:
      begin
        TypeStr := 'boolean';
        if Val.BoolVal then ValueStr := 'true' else ValueStr := 'false';
      end;
    dtNull:
      begin
        TypeStr := 'null';
        ValueStr := 'null';
      end;
    dtArray:
      begin
        TypeStr := 'array';
        ValueStr := '[Array, count=' + 
          IntToStr(Val.ArrayVal.Count) + ']';
      end;
    dtDict:
      begin
        TypeStr := 'dict';
        ValueStr := '{Dict, count=' + 
          IntToStr(Val.DictVal.Count) + '}';
      end;
    dtObject:
      begin
        TypeStr := 'object';
        if Assigned(Val.ObjVal) and Assigned(Val.ObjVal.Definition) then
          ValueStr := '[' + Val.ObjVal.Definition.Name + ']'
        else
          ValueStr := '[Object]';
      end;
    dtFunction:
      begin
        TypeStr := 'function';
        ValueStr := '[Function]';
      end;
    dtNative:
      begin
        TypeStr := 'native_function';
        ValueStr := '[Native]';
      end;
    dtClassDef:
      begin
        TypeStr := 'class';
        if Assigned(Val.ClassDefVal) then
          ValueStr := '[Class ' + Val.ClassDefVal.Name + ']'
        else
          ValueStr := '[Class]';
      end;
    dtPointer:
      begin
        TypeStr := 'pointer';
        ValueStr := Format('$%p', [Val.PtrVal]);
      end;
  else
    TypeStr := 'unknown';
    ValueStr := '[Unknown]';
  end;
  
  Result.Add('value', ValueStr);
  Result.Add('type', TypeStr);
  Result.Add('variablesReference', 0);   // D-1: tidak support expand
end;

procedure TDebugServer.HandleStackTrace(Params: TJSONObject; RequestSeq: Integer);
var
  Body, FrameObj: TJSONObject;
  ResultArr: TJSONArray;
  i, FrameIdx, LineNo, StartFrame, Levels: Integer;
  FuncName, SrcFile: string;
  F: PCallFrame;
begin
  Body := TJSONObject.Create;
  ResultArr := TJSONArray.Create;
  
  if not Assigned(FActiveVM) then
  begin
    Body.Add('totalFrames', 0);
    Body.Add('stackFrames', ResultArr);
    SendResponse(RequestSeq, 'stackTrace', True, Body);
    Exit;
  end;
  
  StartFrame := 0;
  Levels := FActiveVM.FFrameCount;
  if Assigned(Params) then
  begin
    StartFrame := Params.Get('startFrame', 0);
    Levels := Params.Get('levels', FActiveVM.FFrameCount);
    if Levels <= 0 then Levels := FActiveVM.FFrameCount;
  end;
  
  for i := StartFrame to StartFrame + Levels - 1 do
  begin
    if i >= FActiveVM.FFrameCount then Break;
    
    // DAP id dari internal index
    FrameIdx := (FActiveVM.FFrameCount - 1) - i;
    if FrameIdx < 0 then Continue;
    
    F := @FActiveVM.FFrames[FrameIdx];
    
    // Baris saat ini dari chunk
    LineNo := 0;
    SrcFile := '<unknown>';
    if Assigned(F^.Chunk) then
    begin
      if (F^.IP > 0) and (F^.IP - 1 < Length(F^.Chunk.Lines)) then
        LineNo := F^.Chunk.Lines[F^.IP - 1];
      if F^.Chunk.SourceFile <> '' then
        SrcFile := F^.Chunk.SourceFile;
    end;
    
    FuncName := FormatFrameName(FrameIdx);
    
    FrameObj := TJSONObject.Create;
    FrameObj.Add('id', i);   // DAP id (0 = topmost)
    FrameObj.Add('name', FuncName);
    FrameObj.Add('line', LineNo);
    FrameObj.Add('column', 1);
    
    // Source object
    if SrcFile <> '<unknown>' then
    begin
      FrameObj.Add('source', TJSONObject.Create([
        'name', ExtractFileName(SrcFile),
        'path', SrcFile
      ]));
    end;
    
    ResultArr.Add(FrameObj);
  end;
  
  Body.Add('totalFrames', FActiveVM.FFrameCount);
  Body.Add('stackFrames', ResultArr);
  SendResponse(RequestSeq, 'stackTrace', True, Body);
end;

procedure TDebugServer.HandleScopes(Params: TJSONObject; RequestSeq: Integer);
var
  Body, ScopeObj: TJSONObject;
  ResultArr: TJSONArray;
  DapFrameId, LocalsRef, GlobalsRef: Integer;
begin
  Body := TJSONObject.Create;
  ResultArr := TJSONArray.Create;
  
  DapFrameId := 0;
  if Assigned(Params) then
    DapFrameId := Params.Get('frameId', 0);
  
  LocalsRef := 1000 + (DapFrameId * 2) + 0;
  GlobalsRef := 1000 + (DapFrameId * 2) + 1;
  
  ScopeObj := TJSONObject.Create;
  ScopeObj.Add('name', 'Locals');
  ScopeObj.Add('presentationHint', 'locals');
  ScopeObj.Add('variablesReference', LocalsRef);
  ScopeObj.Add('expensive', False);
  ResultArr.Add(ScopeObj);
  
  ScopeObj := TJSONObject.Create;
  ScopeObj.Add('name', 'Globals');
  ScopeObj.Add('presentationHint', 'globals');
  ScopeObj.Add('variablesReference', GlobalsRef);
  ScopeObj.Add('expensive', False);
  ResultArr.Add(ScopeObj);
  
  Body.Add('scopes', ResultArr);
  SendResponse(RequestSeq, 'scopes', True, Body);
end;

procedure TDebugServer.HandleVariables(Params: TJSONObject; RequestSeq: Integer);
var
  Body, VarObj: TJSONObject;
  ResultArr: TJSONArray;
  VarsRef, DapFrameId, ScopeType, InternalIdx, i, LIdx: Integer;
  Env: TSymbolTable;
  VarNames: TStringArray;
  Val: TValue;
  Frame: PCallFrame;
  LocalNames: TStringList;
begin
  Body := TJSONObject.Create;
  ResultArr := TJSONArray.Create;
  
  VarsRef := 0;
  if Assigned(Params) then
    VarsRef := Params.Get('variablesReference', 0);
  
  if VarsRef < 1000 then
  begin
    // Bukan scope reference — tidak didukung di D-1
    Body.Add('variables', ResultArr);
    SendResponse(RequestSeq, 'variables', True, Body);
    Exit;
  end;
  
  Dec(VarsRef, 1000);
  DapFrameId := VarsRef div 2;
  ScopeType := VarsRef mod 2;
  
  if not Assigned(FActiveVM) then
  begin
    Body.Add('variables', ResultArr);
    SendResponse(RequestSeq, 'variables', True, Body);
    Exit;
  end;
  
  InternalIdx := GetFrameByDapId(DapFrameId);
  if InternalIdx < 0 then
  begin
    Body.Add('variables', ResultArr);
    SendResponse(RequestSeq, 'variables', True, Body);
    Exit;
  end;
  
  Frame := @FActiveVM.FFrames[InternalIdx];
  
  try
    if ScopeType = 1 then
    begin
      // ─── Globals ───
      Env := Frame^.Env.GetGlobal;
      VarNames := Env.GetVariableNames(False);
      for i := 0 to High(VarNames) do
      begin
        if VarNames[i] = 'self' then Continue;
        Val := Env.GetVar(VarNames[i]);
        try
          VarObj := TValueToDAPVariable(VarNames[i], Val);
          ResultArr.Add(VarObj);
        finally
          Val.Free;
        end;
      end;
    end
    else
    begin
      // ─── Locals ───
      // 1) Frame env variables (captured vars dari closure)
      Env := Frame^.Env;
      VarNames := Env.GetVariableNames(False);
      for i := 0 to High(VarNames) do
      begin
        Val := Env.GetVar(VarNames[i]);
        try
          VarObj := TValueToDAPVariable(VarNames[i], Val);
          ResultArr.Add(VarObj);
        finally
          Val.Free;
        end;
      end;
      
      // 2) Stack locals (dari chunk LocalNames)
      if Assigned(Frame^.Chunk) and Assigned(Frame^.Chunk.LocalNames) then
      begin
        LocalNames := Frame^.Chunk.LocalNames;
        for LIdx := 0 to LocalNames.Count - 1 do
        begin
          if (Frame^.BaseSlot + LIdx) < FActiveVM.FTop then
          begin
            Val := FActiveVM.FStack[Frame^.BaseSlot + LIdx];
            if Assigned(Val) then
            begin
              // Jangan duplikat dengan yang sudah ada di env
              VarObj := TValueToDAPVariable(LocalNames[LIdx], Val);
              ResultArr.Add(VarObj);
            end;
          end;
        end;
      end;
    end;
  except
    on E: Exception do
    begin
      // Fail-silent: return empty
    end;
  end;
  
  Body.Add('variables', ResultArr);
  SendResponse(RequestSeq, 'variables', True, Body);
end;

procedure TDebugServer.HandleEvaluate(Params: TJSONObject; RequestSeq: Integer);
var
  Body: TJSONObject;
  Expr: string;
  DapFrameId, InternalIdx: Integer;
  Lex: TLexer;
  Pars: TParser;
  Root: TBlockNode;
  Comp: TCompiler;
  VM: TVM;
  Res: TValue;
  ValVar: TJSONObject;
begin
  Body := TJSONObject.Create;
  ValVar := TJSONObject.Create;
  ValVar.Add('variablesReference', 0);
  
  if not Assigned(Params) then
  begin
    ValVar.Add('value', '');
    ValVar.Add('type', 'unknown');
    Body.Add('result', ValVar);
    SendResponse(RequestSeq, 'evaluate', True, Body);
    Exit;
  end;
  
  Expr := Params.Get('expression', '');
  DapFrameId := Params.Get('frameId', 0);
  
  if Expr = '' then
  begin
    ValVar.Add('value', '');
    ValVar.Add('type', 'unknown');
    Body.Add('result', ValVar);
    SendResponse(RequestSeq, 'evaluate', True, Body);
    Exit;
  end;
  
  InternalIdx := GetFrameByDapId(DapFrameId);
  
  // Wrap expression dalam `begin return <expr>; end.`
  // dan jalankan di env frame
  Root := nil;
  Pars := nil;
  Lex := nil;
  Comp := nil;
  VM := nil;
  Res := nil;
  try
    try
      Lex := TLexer.Create('begin return ' + Expr + '; end.');
      Pars := TParser.Create(Lex);
      Root := Pars.ParseMainProgram;
      
      if Root <> nil then
      begin
        Comp := TCompiler.Create;
        if (InternalIdx >= 0) and Assigned(FActiveVM) then
          VM := TVM.Create(FActiveVM.FFrames[InternalIdx].Env)
        else if Assigned(FActiveVM) then
          VM := TVM.Create(FActiveVM.FFrames[FActiveVM.FFrameCount-1].Env)
        else
          VM := TVM.Create(nil);
        
        Comp.Compile(Root, True);
        Comp.Chunk.OptimizeBytecode;
        
        Res := VM.Run(Comp.Chunk);
        
        ValVar.Add('value', TValueToString(Res, False));
        ValVar.Add('type', Native_TypeOf(nil, nil).StrVal);  // placeholder
      end;
    except
      on E: Exception do
      begin
        ValVar.Add('value', '<error: ' + E.Message + '>');
        ValVar.Add('type', 'error');
      end;
    end;
  finally
    if Assigned(Res) then Res.Free;
    if Assigned(VM) then VM.Free;
    if Assigned(Comp) then Comp.Free;
    if Assigned(Root) then Root.Free;
    if Assigned(Pars) then Pars.Free;
    if Assigned(Lex) then Lex.Free;
    
    Body.Add('result', ValVar);
    SendResponse(RequestSeq, 'evaluate', True, Body);
  end;
end;

procedure TDebugServer.HandleThreads(Params: TJSONObject; RequestSeq: Integer);
var
  Body, ThreadObj: TJSONObject;
  ResultArr: TJSONArray;
begin
  Body := TJSONObject.Create;
  ResultArr := TJSONArray.Create;
  
  ThreadObj := TJSONObject.Create;
  ThreadObj.Add('id', 1);
  ThreadObj.Add('name', 'main');
  ResultArr.Add(ThreadObj);
  
  Body.Add('threads', ResultArr);
  SendResponse(RequestSeq, 'threads', True, Body);
end;

procedure TDebugServer.ReportStackFrame(VM: TVM);
var
  Body: TJSONObject;
  FramesJSON: TJSONArray;
  FrameObj, StopBody: TJSONObject;
  i, FrameCount: Integer;
  FuncName: string;
begin
  if not FEnabled then Exit;
  
  FramesJSON := TJSONArray.Create;
  FrameCount := VM.FFrameCount;
  
  for i := FrameCount - 1 downto 0 do
  begin
    if Assigned(VM.FFrames[i].FuncValue) and 
       (VM.FFrames[i].FuncValue.DataType = dtFunction) then
      FuncName := VM.FFrames[i].FuncValue.FuncVal.Name
    else
      FuncName := '<main>';
    if FuncName = '' then FuncName := '<lambda>';
    
    FrameObj := TJSONObject.Create;
    FrameObj.Add('id', i);
    FrameObj.Add('name', FuncName);
    FrameObj.Add('line', 0);
    FrameObj.Add('column', 1);
    FramesJSON.Add(FrameObj);
  end;
  
  Body := TJSONObject.Create;
  Body.Add('totalFrames', FrameCount);
  Body.Add('stackFrames', FramesJSON);
  
  StopBody := TJSONObject.Create;
  StopBody.Add('reason', FStopReason);
  StopBody.Add('threadId', 1);
  StopBody.Add('allThreadsStopped', True);
  
  SendEvent('stopped', StopBody);
  SendEvent('stackTrace', Body);   // ← Body di-adopsi oleh event
end;

procedure TDebugServer.PollDebugger(VM: TVM; Line: Integer);
var
  ShouldBreak: Boolean;
  Seq: Integer;
  Method: string;
  Params: TJSONObject;
  SrcFile: string;
begin
  if not FEnabled then Exit;
  
  // ✅ D-1: set FActiveVM setiap instruksi supaya stackTrace selalu valid
  // untuk VM yang aktif.
  if FActiveVM <> VM then
    FActiveVM := VM;
  
  ShouldBreak := False;
  FStopReason := 'breakpoint';
  
  // ─── Breakpoint check ───
  SrcFile := '';
  if Assigned(VM.FFrames[VM.FFrameCount - 1].Chunk) then
    SrcFile := VM.FFrames[VM.FFrameCount - 1].Chunk.SourceFile;
  
  if BreakpointAt(SrcFile, Line) <> -1 then
    ShouldBreak := True;
  
  // ─── Step check ───
  if not ShouldBreak then
  begin
    if FStepMode = dsmStepIn then
    begin
      ShouldBreak := True;
      FStopReason := 'step';
    end
    else if FStepMode = dsmStepOver then
    begin
      if VM.FFrameCount <= FStepOverFrameDepth then
      begin
        ShouldBreak := True;
        FStopReason := 'step';
      end;
    end
    else if FStepMode = dsmStepOut then
    begin
      if VM.FFrameCount < FStepOverFrameDepth then
      begin
        ShouldBreak := True;
        FStopReason := 'step';
      end;
    end;
  end;
  
  if not ShouldBreak then Exit;
  
  // ─── STOP ───
  FIsStopped := True;
  FIsPaused := True;
  FStepMode := dsmNone;
  
  ReportStackFrame(VM);
  
  // ─── Interactive loop ───
  while FIsPaused and FEnabled do
  begin
    if ReadMessage(Seq, Method, Params) then
    begin
      try
        HandleRequest(Method, Params, Seq);
      finally
        if Assigned(Params) then Params.Free;
      end;
    end
    else
      Sleep(10);
  end;
  
  FIsStopped := False;
end;

constructor TProfiler.Create;
begin
  inherited Create;
  FEntries := TStringList.Create;
  FEntries.Sorted := True;
  FEntryMap := TStringList.Create;
  FActiveStack := TList.Create;
  FLock := TCriticalSection.Create;
  FEnabled := False;
  FAutoDumpMs := 0;
end;

destructor TProfiler.Destroy;
var
  i: Integer;
begin
  for i := 0 to FEntries.Count - 1 do
    if Assigned(FEntries.Objects[i]) then FEntries.Objects[i].Free;
  FEntries.Free;
  FEntryMap.Free;
  FActiveStack.Free;
  FLock.Free;
  inherited;
end;

procedure TProfiler.Enable;
begin
  FLock.Acquire;
  try
    FEnabled := True;
    FStartTick := GetTickCount64;
    FLastDumpTick := FStartTick;
  finally
    FLock.Release;
  end;
end;

procedure TProfiler.Disable;
begin
  // ✅ FIX P1.1: Lock untuk thread safety
  FLock.Acquire;
  try
    FEnabled := False;
  finally
    FLock.Release;
  end;
end;

procedure TProfiler.Reset;
var
  i: Integer;
begin
  FLock.Acquire;
  try
    for i := 0 to FEntries.Count - 1 do
      if Assigned(FEntries.Objects[i]) then
        FEntries.Objects[i].Free;
    FEntries.Clear;
    FEntryMap.Clear;
    FActiveStack.Clear;
    FStartTick := GetTickCount64;
    FLastDumpTick := FStartTick;
  finally
    FLock.Release;
  end;
end;

procedure TProfiler.EnterFunction(const Name: string);
var
  Entry: TProfilerEntry;
  Idx: Integer;
begin
  FLock.Acquire;
  try
    if not FEnabled then Exit;
    
    Idx := FEntries.IndexOf(Name);
    if Idx = -1 then
    begin
      Entry := TProfilerEntry.Create;
      Entry.FuncName := Name;
      Entry.CallCount := 0;
      Entry.TotalTicks := 0;
      Entry.SelfTicks := 0;
      Entry.ChildTicks := 0;
      FEntries.AddObject(Name, Entry);
    end
    else
      Entry := TProfilerEntry(FEntries.Objects[Idx]);
    
    Inc(Entry.CallCount);
    Entry.LastEnterTick := GetTickCount64;
    
    FActiveStack.Add(Entry);
  finally
    FLock.Release;
  end;
end;

procedure TProfiler.ExitFunction;
var
  Entry, Parent: TProfilerEntry;
  Now, Delta: QWord;
begin
  FLock.Acquire;
  try
    if not FEnabled then Exit;
    
    if FActiveStack.Count = 0 then Exit;
    Entry := TProfilerEntry(FActiveStack.Last);
    FActiveStack.Delete(FActiveStack.Count - 1);
    
    Now := GetTickCount64;
    Delta := Now - Entry.LastEnterTick;
    Entry.SelfTicks := Entry.SelfTicks + Delta;
    Entry.TotalTicks := Entry.TotalTicks + Delta;
    
    // Add to parent's child time
    if FActiveStack.Count > 0 then
    begin
      Parent := TProfilerEntry(FActiveStack.Last);
      Parent.ChildTicks := Parent.ChildTicks + Delta;
    end;
  finally
    FLock.Release;
  end;
end;

function TProfiler.GetReport: string;
var
  i: Integer;
  Entry: TProfilerEntry;
  SelfPercent: Double;
  TotalTickSum: QWord;
  SL: TStringList;
begin
  Result := '';
  if not FEnabled then Exit('Profiler tidak aktif');
  
  // ✅ FIX P1.1: Acquire lock untuk seluruh operasi baca
  FLock.Acquire;
  try
    TotalTickSum := GetTickCount64 - FStartTick;
    if TotalTickSum = 0 then TotalTickSum := 1;
    
    SL := TStringList.Create;
    try
      for i := 0 to FEntries.Count - 1 do
      begin
        Entry := TProfilerEntry(FEntries.Objects[i]);
        if Assigned(Entry) then
          SL.AddObject(Format('%020d', [Entry.SelfTicks]), Entry);
      end;
      SL.Sort;
      
      Result := '=== PROFILER REPORT ===' + #10;
      Result := Result + Format('Total runtime: %d ms' + #10, [TotalTickSum]);
      Result := Result + Format('%-40s %10s %10s %10s' + #10, 
        ['Function', 'Calls', 'Self (ms)', 'Total (ms)']);
      Result := Result + StringOfChar('-', 72) + #10;
      
      for i := SL.Count - 1 downto 0 do
      begin
        Entry := TProfilerEntry(SL.Objects[i]);
        SelfPercent := 100.0 * Entry.SelfTicks / TotalTickSum;
        Result := Result + Format('%-40s %10d %10d %10d (%.1f%%)' + #10,
          [Entry.FuncName, Entry.CallCount, Entry.SelfTicks, 
           Entry.TotalTicks, SelfPercent]);
      end;
    finally
      SL.Free;
    end;
  finally
    FLock.Release;
  end;
end;

procedure TProfiler.DumpReport(const FileName: string);
var
  Report: string;
  SL: TStringList;   // ✨ FIX
begin
  Report := GetReport;
  IOLock.Acquire;
  try
    if FileName = '' then
      Writeln(Report)
    else
    begin
      SL := TStringList.Create;
      try
        SL.Text := Report;
        SL.SaveToFile(FileName);
      finally
        SL.Free;
      end;
    end;
  finally
    IOLock.Release;
  end;
end;

constructor TDictValue.Create;
begin
  FCapacity := 16;
  SetLength(FBuckets, FCapacity);
  FCount := 0;
  FRefCount := 0;
  
  // PERBAIKAN MUTLAK: Lindungi objek dari sapuan GC asinkron yang sedang berjalan!
  FGCState := gcBlack; 
  
  RegisterGC(Self);
  FLock := TCriticalSection.Create; 
end;

destructor TDictValue.Destroy;
begin
  UnregisterGC(Self);
  Clear;
  SetLength(FBuckets, 0);
  FLock.Free;
  inherited;
end;

procedure TDictValue.Retain;
begin
  // Operasi atomik tingkat CPU: Sangat cepat dan thread-safe
  InterlockedIncrement(FRefCount);
end;

procedure TDictValue.Release;
begin
  // Kurangi referensi, jika sudah 0 atau kurang, musnahkan instance ini
  if InterlockedDecrement(FRefCount) = 0 then
    Self.Free;
end;

procedure TDictValue.Resize;
var
  OldBuckets, NewBuckets: array of PDictItem;
  i: Integer;
  Item, NextItem: PDictItem;
  Idx: Cardinal;
  NewCapacity: Integer;
begin
  OldBuckets := FBuckets;
  NewCapacity := FCapacity * 2; // <-- PERBAIKAN: Gunakan variabel sementara
  
  // Jika SetLength gagal (OOM), objek Dictionary tidak korup (State Rollback Aman)
  SetLength(NewBuckets, NewCapacity);
  
  for i := 0 to High(OldBuckets) do
  begin
    Item := OldBuckets[i];
    while Item <> nil do
    begin
      NextItem := Item^.Next;
      Idx := Item^.Hash and (NewCapacity - 1); 
      
      Item^.Next := NewBuckets[Idx];
      NewBuckets[Idx] := Item;
      
      Item := NextItem;
    end;
  end;
  
  FBuckets := NewBuckets; 
  FCapacity := NewCapacity; // <-- PERBAIKAN: Update kapasitas HANYA setelah alokasi mutlak berhasil
end;

procedure TDictValue.Clear;
var
  OrphanedValues: array of TValue;
  OrphanCount, i: Integer;
  Item, NextItem: PDictItem;
begin
  OrphanCount := 0;
  
  FLock.Acquire;
  try
    // ✅ Pre-allocate ukuran maksimum
    SetLength(OrphanedValues, FCount);
    
    for i := 0 to High(FBuckets) do
    begin
      Item := FBuckets[i];
      FBuckets[i] := nil;
      
      while Item <> nil do
      begin
        NextItem := Item^.Next;
        
        if Assigned(Item^.Value) then
        begin
          OrphanedValues[OrphanCount] := Item^.Value;
          Inc(OrphanCount);
          Item^.Value := nil;
        end;
        
        Dispose(Item);
        Item := NextItem;
      end;
    end;
    FCount := 0;
  finally
    FLock.Release;
  end;
  
  // ✅ Shrink ke ukuran aktual
  SetLength(OrphanedValues, OrphanCount);
  for i := 0 to OrphanCount - 1 do
    OrphanedValues[i].Free;
  SetLength(OrphanedValues, 0);
end;

procedure TDictValue.SetValue(const AKey: string; AVal: TValue);
var
  Idx: Integer;
  LHash: Cardinal;
  Item: PDictItem;
  ValueToFree: TValue;
  IsUpdated: Boolean; // <-- PERBAIKAN: Flag deteksi update
begin
  ValueToFree := nil;
  IsUpdated := False; // Inisialisasi
  FLock.Acquire; 
  try
    LHash := GlobalHashString(AKey);
    Idx := LHash and (FCapacity - 1);

    Item := FBuckets[Idx];
    while Item <> nil do
    begin
      if (Item^.Hash = LHash) and (Item^.Key = AKey) then
      begin
        if Item^.Value <> AVal then 
        begin
          ValueToFree := Item^.Value; // Pindahkan untuk di-free di luar lock
          Item^.Value := AVal; 
        end;
        IsUpdated := True;
        Break; // <-- PERBAIKAN (Logika Salah & Memory Leak): Ganti Exit dengan Break
      end;
      Item := Item^.Next;
    end;

    // Jika key belum ada, tambahkan item baru
    if not IsUpdated then 
    begin
      New(Item);
      Item^.Key := AKey;
      Item^.Hash := LHash;  
      Item^.Value := AVal;
      
      Item^.Next := FBuckets[Idx];
      FBuckets[Idx] := Item;
      Inc(FCount);

      if FCount > (FCapacity * 3) div 4 then 
        Resize; 
    end;
  finally
    FLock.Release;
  end;
  
  // Bebaskan tanpa menahan Lock (Thread-Safe)
  // Eksekusi ini sekarang aman dan tidak lagi dilewati oleh Exit
  if Assigned(ValueToFree) then ValueToFree.Free;
end;

function TDictValue.CompoundAssign(const AKey: string; const Op: string; 
    NewVal: TValue; out OldVal: TValue): TValue;
var
  Idx: Integer;
  LHash: Cardinal;
  Item: PDictItem;
  //CurrentVal: TValue;
  ResultVal: TValue;
  NeedsOuterLock: Boolean;
begin
  ResultVal := nil;
  OldVal := nil;
  
  // ✅ FIX P1.6: Deteksi operasi yang berpotensi deadlock
  //    Compound `+` dengan array bisa memanggil Helper_MergeArrays
  //    yang akan acquire lock array — berisiko deadlock.
  NeedsOuterLock := (Op = '+');   // Hanya `+` yang bisa trigger array merge
  
  if NeedsOuterLock then
  begin
    // ============================================================
    // STRATEGI A: Optimistic concurrency — baca, evaluasi, tulis
    // ============================================================
    
    // Step 1: Baca nilai lama (dengan lock)
    FLock.Acquire;
    try
      LHash := GlobalHashString(AKey);
      Idx := LHash and (FCapacity - 1);
      Item := FBuckets[Idx];
      while Item <> nil do
      begin
        if (Item^.Hash = LHash) and (Item^.Key = AKey) then Break;
        Item := Item^.Next;
      end;

      if Item <> nil then
      begin
        if Assigned(Item^.Value) then
          OldVal := Item^.Value.Clone
        else
          OldVal := TValue.CreateNull;
      end else
        OldVal := TValue.CreateNull;
    finally
      FLock.Release;
    end;

    // Step 2: Evaluasi compound DI LUAR lock
    //         → aman dari deadlock karena tidak pegang lock apapun
    ResultVal := VM_CompoundOp(Op, OldVal, NewVal);

    // Step 3: Tulis kembali (dengan lock)
    FLock.Acquire;
    try
      LHash := GlobalHashString(AKey);
      Idx := LHash and (FCapacity - 1);
      Item := FBuckets[Idx];
      while Item <> nil do
      begin
        if (Item^.Hash = LHash) and (Item^.Key = AKey) then Break;
        Item := Item^.Next;
      end;

      if Item <> nil then
      begin
        if Assigned(Item^.Value) then
          Item^.Value.Free;
        Item^.Value := ResultVal.Clone;
      end else
      begin
        New(Item);
        Item^.Key := AKey;
        Item^.Hash := LHash;
        Item^.Value := ResultVal.Clone;
        Item^.Next := FBuckets[Idx];
        FBuckets[Idx] := Item;
        Inc(FCount);

        if FCount > (FCapacity * 3) div 4 then 
          Resize;
      end;
    finally
      FLock.Release;
    end;
  end
  else
  begin
    // ============================================================
    // STRATEGI B: Atomic lock (untuk operasi non-array-merge)
    // ============================================================
    FLock.Acquire;
    try
      LHash := GlobalHashString(AKey);
      Idx := LHash and (FCapacity - 1);
      Item := FBuckets[Idx];
      while Item <> nil do
      begin
        if (Item^.Hash = LHash) and (Item^.Key = AKey) then Break;
        Item := Item^.Next;
      end;

      if Item <> nil then
      begin
        if Assigned(Item^.Value) then
          OldVal := Item^.Value.Clone
        else
          OldVal := TValue.CreateNull;
      end else
        OldVal := TValue.CreateNull;

      ResultVal := VM_CompoundOp(Op, OldVal, NewVal);
      
      if Item <> nil then
      begin
        if Assigned(Item^.Value) then
          Item^.Value.Free;
        Item^.Value := ResultVal.Clone;
      end else
      begin
        New(Item);
        Item^.Key := AKey;
        Item^.Hash := LHash;
        Item^.Value := ResultVal.Clone;
        Item^.Next := FBuckets[Idx];
        FBuckets[Idx] := Item;
        Inc(FCount);

        if FCount > (FCapacity * 3) div 4 then 
          Resize;
      end;
    finally
      FLock.Release;
    end;
  end;
  Result := ResultVal;
end;

function TDictValue.GetValues: TValueList;
var
  i: Integer;
  Item: PDictItem;
  LocalList: TValueList;
begin
  LocalList := TValueList.Create(True);
  try
    FLock.Acquire; 
    try
      for i := 0 to High(FBuckets) do
      begin
        Item := FBuckets[i];
        while Item <> nil do
        begin
          if Assigned(Item^.Value) then
            LocalList.Add(Item^.Value.Clone);
          Item := Item^.Next;
        end;
      end;
    finally
      FLock.Release;
    end;
  except
    LocalList.Free;
    raise;
  end;
  
  Result := LocalList;
end;

function TDictValue.GetValueClone(const AKey: string): TValue;
var
  Idx: Integer;
  LHash: Cardinal;
  Item: PDictItem;
begin
  Result := nil;
  FLock.Acquire;
  try
    LHash := GlobalHashString(AKey);
    Idx := LHash and (FCapacity - 1);

    Item := FBuckets[Idx];
    while Item <> nil do
    begin
      if (Item^.Hash = LHash) and (Item^.Key = AKey) then
      begin
        // ✅ AMAN: Clone sebelum Lock dilepas
        if Assigned(Item^.Value) then
          Result := Item^.Value.Clone
        else
          Result := TValue.CreateNull;
        Exit;
      end;
      Item := Item^.Next;
    end;
  finally
    FLock.Release;
  end;
end;

function TDictValue.GetValue(const AKey: string): TValue;
var
  Idx: Integer;
  LHash: Cardinal;
  Item: PDictItem;
begin
  Result := nil;
  FLock.Acquire; // <-- PERBAIKAN
  try
    LHash := GlobalHashString(AKey);
    Idx := LHash and (FCapacity - 1);

    Item := FBuckets[Idx];
    while Item <> nil do
    begin
      if (Item^.Hash = LHash) and (Item^.Key = AKey) then
        Exit(Item^.Value);
      Item := Item^.Next;
    end;
  finally
    FLock.Release;
  end;
end;

function TDictValue.HasKey(const AKey: string): Boolean;
var
  Idx: Integer;
  LHash: Cardinal;
  Item: PDictItem;
begin
  Result := False;
  FLock.Acquire; // <-- PERBAIKAN
  try
    LHash := GlobalHashString(AKey);
    Idx := LHash and (FCapacity - 1);

    Item := FBuckets[Idx];
    while Item <> nil do
    begin
      if (Item^.Hash = LHash) and (Item^.Key = AKey) then
        Exit(True);
      Item := Item^.Next;
    end;
  finally
    FLock.Release;
  end;
end;

procedure TDictValue.Remove(const AKey: string);
var
  Idx: Integer;
  LHash: Cardinal;
  Item, PrevItem: PDictItem;
begin
  FLock.Acquire; // <-- PERBAIKAN
  try
    LHash := GlobalHashString(AKey);
    Idx := LHash and (FCapacity - 1);

    PrevItem := nil;
    Item := FBuckets[Idx];
    while Item <> nil do
    begin
      if (Item^.Hash = LHash) and (Item^.Key = AKey) then
      begin
        if PrevItem = nil then
          FBuckets[Idx] := Item^.Next
        else
          PrevItem^.Next := Item^.Next;
          
        if Assigned(Item^.Value) then 
          Item^.Value.Free;
          
        Dispose(Item);
        Dec(FCount);
        Exit;
      end;
      PrevItem := Item;
      Item := Item^.Next;
    end;
  finally
    FLock.Release;
  end;
end;

procedure TDictValue.Mark;
var 
  i: Integer;
  Item: PDictItem;
  Snapshot: array of TValue;
  SnapCount: Integer;
begin
  Snapshot := nil;
  SnapCount := 0;
  
  FLock.Acquire;
  try
    if FGCState = gcBlack then Exit;
    FGCState := gcBlack;
    
    // ✅ FIX P1.3: Baca FCount SETELAH acquire lock
    SetLength(Snapshot, FCount);
    
    for i := 0 to High(FBuckets) do
    begin
      Item := FBuckets[i];
      while Item <> nil do
      begin
        if Assigned(Item^.Value) then 
        begin
          Snapshot[SnapCount] := Item^.Value;
          Inc(SnapCount);
        end;
        Item := Item^.Next;
      end;
    end;
  finally
    FLock.Release;
  end;
  
  for i := 0 to SnapCount - 1 do Snapshot[i].Mark;
  SetLength(Snapshot, 0);
end;

function TDictValue.GetKeys: TStringArray;
var
  i, WriteIdx: Integer;
  Item: PDictItem;
begin
  Result := nil;
  FLock.Acquire;
  try
    SetLength(Result, FCount);
    WriteIdx := 0;
    for i := 0 to High(FBuckets) do
    begin
      Item := FBuckets[i];
      while Item <> nil do
      begin
        Result[WriteIdx] := Item^.Key;
        Inc(WriteIdx);
        Item := Item^.Next;
      end;
    end;
  finally
    FLock.Release;
  end;
end;

procedure TDictValue.ClearReferences;
begin
  Clear; // <-- Tidak perlu Lock ganda, Clear sudah thread-safe
end;

