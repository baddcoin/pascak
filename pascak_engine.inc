// sys.threadErrors() → array of strings
function Native_Sys_ThreadErrors(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Arr: TValueList;
  i: Integer;
  Snapshot: TStringArray;
  Count: Integer;
begin
  InitThreadErrors;
  Snapshot := nil;
  Count := 0;

  GThreadErrorsLock.Acquire;
  try
    Count := GThreadErrors.Count;
    SetLength(Snapshot, Count);
    for i := 0 to Count - 1 do
      Snapshot[i] := GThreadErrors[i];
  finally
    GThreadErrorsLock.Release;
  end;

  Arr := TValueList.Create(True);
  try
    for i := 0 to Count - 1 do
      Arr.Add(TValue.CreateStr(Snapshot[i]));
    Result := TValue.CreateArray(Arr);
  except
    Arr.Free;
    raise;
  end;
end;

// sys.clearThreadErrors() → void
function Native_Sys_ClearThreadErrors(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  InitThreadErrors;
  GThreadErrorsLock.Acquire;
  try
    GThreadErrors.Clear;
  finally
    GThreadErrorsLock.Release;
  end;
  Result := TValue.CreateNull;
end;

