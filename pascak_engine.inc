function Native_ConfigGet(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Key, DefaultVal: string;
  EnvVal: string;
  R: TValue;
  HasDefault: Boolean;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'config.get("KEY", [default])', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  Key := TValue(Args[0]).StrVal;
  HasDefault := Args.Count = 2;
  if HasDefault then
    DefaultVal := TValueToString(TValue(Args[1]), False)
  else
    DefaultVal := '';

  // 1. Runtime store
  if Assigned(GConfigLock) and Assigned(GConfigStore) then
  begin
    GConfigLock.Acquire;
    try
      R := GConfigStore.GetValueClone(Key);
    finally
      GConfigLock.Release;
    end;
    if Assigned(R) and (R.DataType <> dtNull) then Exit(R);
    if Assigned(R) then R.Free;
  end;

  // 2. Environment
  EnvVal := GetEnvironmentVariable(Key);
  if EnvVal <> '' then Exit(TValue.CreateStr(EnvVal));

  // 3. Default
  if HasDefault then
    Result := TValue.CreateStr(DefaultVal)
  else
    Result := TValue.CreateNull;
end;

function Native_ConfigSet(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'config.set("KEY", value)', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  if not Assigned(GConfigLock) or not Assigned(GConfigStore) then
    Exit(TValue.CreateNull);
  GConfigLock.Acquire;
  try
    GConfigStore.SetValue(TValue(Args[0]).StrVal,
      TValue.CreateStr(TValueToString(TValue(Args[1]), False)));
  finally
    GConfigLock.Release;
  end;
  Result := TValue.CreateNull;
end;

function Native_ConfigHas(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var Key: string; R: TValue;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'config.has("KEY")', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  Key := TValue(Args[0]).StrVal;

  if Assigned(GConfigLock) and Assigned(GConfigStore) then
  begin
    GConfigLock.Acquire;
    try
      if GConfigStore.HasKey(Key) then Exit(TValue.CreateBool(True));
    finally
      GConfigLock.Release;
    end;
  end;

  if GetEnvironmentVariable(Key) <> '' then
    Exit(TValue.CreateBool(True));

  Result := TValue.CreateBool(False);
end;

function Native_ConfigAll(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var Keys: TStringArray; i: Integer;
    NewDict: TDictValue;
    R: TValue;
begin
  NewDict := TDictValue.Create;
  try
    if Assigned(GConfigLock) and Assigned(GConfigStore) then
    begin
      GConfigLock.Acquire;
      try
        Keys := GConfigStore.GetKeys;
        for i := 0 to High(Keys) do
        begin
          R := GConfigStore.GetValueClone(Keys[i]);
          if Assigned(R) then
          begin
            NewDict.SetValue(Keys[i], R);
          end;
        end;
      finally
        GConfigLock.Release;
      end;
    end;
    Result := TValue.CreateDict(NewDict);
  except
    NewDict.Free;
    raise;
  end;
end;//end Config Management

//B.2 — Signal Handling══════════════════════════════════════════
//═══════════════════════════════════════════════════════════════ }

procedure HandleSigIntCdecl(sig: cint); cdecl;
begin
  // async-signal-safe: hanya atomic write
  InterlockedExchange(GSignalPendingINT, 1);
end;

procedure HandleSigTermCdecl(sig: cint); cdecl;
begin
  InterlockedExchange(GSignalPendingTERM, 1);
end;

procedure InstallSignalHandlers;
begin
  if GSignalInstalled then Exit;
  {$IFDEF UNIX}
  fpSignal(SIGINT, @HandleSigIntCdecl);
  fpSignal(SIGTERM, @HandleSigTermCdecl);
  {$ENDIF}
  GSignalInstalled := True;
end;

function InvokeSignalCallbacks(Cbs: TValueList; const SigName: string;
  CallEnv: TSymbolTable): Boolean;
var
  i: Integer;
  Snapshot: TValueList;
  Cb: TValue;
  MiniVM: TVM;
  TmpChunk: TChunk;
  Res: TValue;
begin
  Result := False;
  if (not Assigned(Cbs)) or (Cbs.Count = 0) then Exit;

  Snapshot := TValueList.Create(True);
  try
    GSignalLock.Acquire;
    try
      for i := 0 to Cbs.Count - 1 do
        Snapshot.Add(Cbs[i].Clone);
    finally
      GSignalLock.Release;
    end;

    for i := 0 to Snapshot.Count - 1 do
    begin
      Cb := Snapshot[i];
      MiniVM := nil;
      TmpChunk := nil;
      Res := nil;
      try
        if Assigned(Cb.ClosureEnv) then
          MiniVM := TVM.Create(Cb.ClosureEnv)
        else if Assigned(CallEnv) then
          MiniVM := TVM.Create(CallEnv.GetGlobal)
        else
          MiniVM := TVM.Create(nil);
        TmpChunk := TChunk.Create;
        TmpChunk.AddInstruction(opcConstant, TmpChunk.AddConstant(Cb.Clone));
        TmpChunk.AddInstruction(opcCall, 0);
        TmpChunk.AddInstruction(opcReturn);
        Res := MiniVM.Run(TmpChunk);
        if Assigned(Res) then Res.Free;
      except
        on E: Exception do
        begin
          if Assigned(IOLock) then
          begin
            IOLock.Acquire;
            try Writeln(ErrOutput, '[signal] handler error: ', E.Message);
            finally IOLock.Release; end;
          end;
        end;
      end;
      if Assigned(TmpChunk) then TmpChunk.Free;
      if Assigned(MiniVM) then MiniVM.Free;
    end;
  finally
    Snapshot.Free;
  end;
  Result := True;
end;

procedure CheckPendingSignals(CallEnv: TSymbolTable);
var E: EScriptFatalError;
begin
  if InterlockedExchange(GSignalPendingINT, 0) = 1 then
  begin
    if not InvokeSignalCallbacks(GSignalCallbackINT, 'SIGINT', CallEnv) then
    begin
      E := EScriptFatalError.Create('Interrupted by SIGINT');
      E.ExitCode := 130;
      raise E;
    end;
  end;

  if InterlockedExchange(GSignalPendingTERM, 0) = 1 then
  begin
    if not InvokeSignalCallbacks(GSignalCallbackTERM, 'SIGTERM', CallEnv) then
    begin
      E := EScriptFatalError.Create('Terminated by SIGTERM');
      E.ExitCode := 143;
      raise E;
    end;
  end;
end;//end Signal Handling

//A.1 — HTTP Connection Pool══════════════════════════════════════
//═══════════════════════════════════════════════════════════════ }

procedure HTTPPooledClose(c: PHTTPPooledConn);
begin
  if not Assigned(c) then Exit;
  if Assigned(c^.TLSConn) then
  begin
    try TLSClose(c^.TLSConn); except end;
    try c^.TLSConn.Release; except end;
    c^.TLSConn := nil;
  end;
  if Assigned(c^.TLSContextRef) then
  begin
    try c^.TLSContextRef.Release; except end;
    c^.TLSContextRef := nil;
  end;
  if c^.Sock >= 0 then
  begin
    try NetClose(c^.Sock); except end;
    c^.Sock := -1;
  end;
  Dispose(c);
end;

function HTTPPoolGet(const Key: string): PHTTPPooledConn;
var
  i: Integer;
  c: PHTTPPooledConn;
  NowTick: QWord;
begin
  Result := nil;
  if not Assigned(GHTTPPoolLock) or not Assigned(GHTTPPool) then Exit;
  NowTick := GetTickCount64;
  GHTTPPoolLock.Acquire;
  try
    i := GHTTPPool.Count - 1;
    while i >= 0 do
    begin
      c := PHTTPPooledConn(GHTTPPool[i]);
      if not Assigned(c) then
      begin
        GHTTPPool.Delete(i);
        Dec(i); Continue;
      end;
      // Expired?
      if (NowTick - c^.LastUsedTick) > QWord(GHTTPPoolIdleMs) then
      begin
        GHTTPPool.Delete(i);
        HTTPPooledClose(c);
        Dec(i); Continue;
      end;
      if c^.Key = Key then
      begin
        Result := c;
        GHTTPPool.Delete(i);
        Exit;
      end;
      Dec(i);
    end;
  finally
    GHTTPPoolLock.Release;
  end;
end;

function HTTPPoolPut(const Key, Host: string; Port, Sock: Integer;
  TLSConn: TTLSConnection; TLSContextRef: TTLSContext): Boolean;
var
  c: PHTTPPooledConn;
  CountSameHost, i: Integer;
begin
  Result := False;
  if Sock < 0 then Exit;
  if not Assigned(GHTTPPoolLock) or not Assigned(GHTTPPool) then Exit;

  GHTTPPoolLock.Acquire;
  try
    // Count existing conns for this key
    CountSameHost := 0;
    for i := 0 to GHTTPPool.Count - 1 do
    begin
      c := PHTTPPooledConn(GHTTPPool[i]);
      if Assigned(c) and (c^.Key = Key) then Inc(CountSameHost);
    end;

    if CountSameHost >= GHTTPPoolMaxPerHost then
    begin
      // Pool full for this host — reject
      Exit(False);
    end;

    New(c);
    c^.Key := Key;
    c^.Host := Host;
    c^.Port := Port;
    c^.Sock := Sock;
    c^.TLSConn := TLSConn;
    c^.TLSContextRef := TLSContextRef;
    c^.LastUsedTick := GetTickCount64;
    GHTTPPool.Add(c);
    Result := True;
  finally
    GHTTPPoolLock.Release;
  end;
end;

procedure HTTPPoolCleanupExpired;
var
  i: Integer;
  c: PHTTPPooledConn;
  NowTick: QWord;
begin
  if not Assigned(GHTTPPoolLock) or not Assigned(GHTTPPool) then Exit;
  NowTick := GetTickCount64;
  GHTTPPoolLock.Acquire;
  try
    i := GHTTPPool.Count - 1;
    while i >= 0 do
    begin
      c := PHTTPPooledConn(GHTTPPool[i]);
      if (not Assigned(c)) or
         ((NowTick - c^.LastUsedTick) > QWord(GHTTPPoolIdleMs)) then
      begin
        GHTTPPool.Delete(i);
        if Assigned(c) then HTTPPooledClose(c);
      end;
      Dec(i);
    end;
  finally
    GHTTPPoolLock.Release;
  end;
end;

procedure HTTPPoolClearAll;
var
  i: Integer;
  c: PHTTPPooledConn;
begin
  if not Assigned(GHTTPPoolLock) or not Assigned(GHTTPPool) then Exit;
  GHTTPPoolLock.Acquire;
  try
    for i := 0 to GHTTPPool.Count - 1 do
    begin
      c := PHTTPPooledConn(GHTTPPool[i]);
      if Assigned(c) then HTTPPooledClose(c);
    end;
    GHTTPPool.Clear;
  finally
    GHTTPPoolLock.Release;
  end;
end;

//A.8 — Request ID Tracking══════════════════════════════════════
//═══════════════════════════════════════════════════════════════ }

function GenerateRequestID: string;
var
  RandBytes: RawByteString;
  RandHex: string;
  Counter: LongInt;
begin
  RandBytes := SecureRandomBytes(4);
  RandHex := BytesToHex(RandBytes);
  Counter := InterlockedIncrement(GHTTPTraceCounter);
  Result := GHTTPTracePrefix + RandHex +
            '-' + IntToHex(Counter, 6);
end;

function Native_HTTP_TraceRequests(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Config, V: TValue;
  Enabled: Boolean;
begin
  // No arg = disable
  if Args.Count = 0 then
  begin
    GHTTPTraceEnabled := False;
    Exit(TValue.CreateBool(False));
  end;

  if TValue(Args[0]).DataType <> dtDict then
  begin
    errMSG.callerror(140, 'http.traceRequests([config])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;

  Config := TValue(Args[0]);
  Enabled := True;

  V := Config.DictVal.GetValueClone('enabled');
  if Assigned(V) then
  begin
    Enabled := V.IsTrue;
    V.Free;
  end;

  V := Config.DictVal.GetValueClone('header');
  if Assigned(V) and (V.DataType = dtString) and (V.StrVal <> '') then
    GHTTPTraceHeader := V.StrVal
  else
    GHTTPTraceHeader := 'X-Request-ID';
  if Assigned(V) then V.Free;

  V := Config.DictVal.GetValueClone('responseHeader');
  if Assigned(V) then
  begin
    GHTTPTraceResponseHeader := V.IsTrue;
    V.Free;
  end;

  V := Config.DictVal.GetValueClone('prefix');
  if Assigned(V) and (V.DataType = dtString) then
    GHTTPTracePrefix := V.StrVal
  else
    GHTTPTracePrefix := 'req-';
  if Assigned(V) then V.Free;

  GHTTPTraceEnabled := Enabled;

  Result := TValue.CreateBool(True);
end;//end A.8 — Request ID Tracking

