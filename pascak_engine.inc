constructor TClassDeclNode.Create(AName: string; AIsRecord: Boolean = False);
begin
  sClassName := AName;
  IsRecordType := AIsRecord; // Simpan pembeda
  Parents := TStringList.Create; 
  Fields := TStringList.Create;
  Methods := TObjectList.Create(true); 
  IsReferenced := True;
end;

destructor TClassDeclNode.Destroy; 
begin 
  Parents.Free; 
  Fields.Free; 
  Methods.Free; 
  inherited; 
end;

constructor TNewNode.Create(AName: string); 
begin 
    sClassName := AName; 
    Args := TObjectList.Create(True); // Kepemilikan (True) agar otomatis Free
end;

destructor TNewNode.Destroy;
begin
    Args.Free; 
    inherited;
end;

constructor TMemberAccessNode.Create(ATarget: TNode; AMem: string); 
begin 
    Target := ATarget; 
    MemberName := AMem; 
end;

destructor TMemberAccessNode.Destroy; 
begin 
    Target.Free;       // Pembersihan
    inherited; 
end;

constructor TMemberAssignNode.Create(ATarget: TNode; AMem: string; AExpr: TNode); 
begin 
    Target := ATarget; 
    MemberName := AMem; 
    Expr := AExpr; 
end;

destructor TMemberAssignNode.Destroy; 
begin 
  if Assigned(Target) then Target.Free;
  if Assigned(Expr) then Expr.Free; 
  inherited; 
end;

constructor TForEachNode.Create(AVarName: string; ACollection, ABody: TNode);
begin
  VarName := AVarName;
  CollectionExpr := ACollection;
  Body := ABody;
end;

destructor TForEachNode.Destroy;
begin
  CollectionExpr.Free;
  Body.Free;
  inherited;
end;

constructor TForNode.Create(AVarName: string; AStart, AEnd, AStep, ABody: TNode;
  AIsDownto: Boolean);
begin
  VarName := AVarName;
  StartExpr := AStart;
  EndExpr := AEnd;
  StepExpr := AStep;
  Body := ABody;
  IsDownto := AIsDownto;
end;

destructor TForNode.Destroy;
begin
  if Assigned(StartExpr) then StartExpr.Free;
  if Assigned(EndExpr) then EndExpr.Free;
  if Assigned(StepExpr) then StepExpr.Free;
  if Assigned(Body) then Body.Free;
  inherited;
end;

constructor TWhileNode.Create(ACond, ABody: TNode); 
begin 
    Condition := ACond; 
    Body := ABody; 
end;

destructor TWhileNode.Destroy; 
begin 
    Condition.Free; 
    Body.Free; inherited; 
end;

constructor TLockNode.Create(ABody: TNode);
begin
  Body := ABody;
end;

destructor TLockNode.Destroy;
begin
  if Assigned(Body) then Body.Free; // Bersihkan node anak untuk mencegah memory leak
  inherited;
end;

constructor TRepeatNode.Create(ABody: TBlockNode; ACond: TNode);
begin
  Body := ABody;
  Condition := ACond;
end;

destructor TRepeatNode.Destroy;
begin
  Body.Free;
  Condition.Free;
  inherited;
end;

constructor TCaseNode.Create(ATarget: TNode);
begin
  TargetExpr := ATarget;
  ElseBranch := nil;
end;

destructor TCaseNode.Destroy;
var i: Integer;
begin
  TargetExpr.Free;
  for i := 0 to High(Branches) do
  begin
    Branches[i].MatchExpr.Free;
    if Assigned(Branches[i].Body) then Branches[i].Body.Free;
  end;
  if Assigned(ElseBranch) then ElseBranch.Free;
  inherited;
end;

constructor TIfNode.Create(ACond, AThen, AElse: TNode); 
begin 
    Condition := ACond; 
    ThenBranch := AThen; 
    ElseBranch := AElse; 
end;

destructor TIfNode.Destroy; 
begin 
    Condition.Free; 
    ThenBranch.Free; 
    if Assigned(ElseBranch) then 
    ElseBranch.Free; inherited; 
end;

constructor TLexer.Create(const AText: string); 
begin 
    FText := AText; 
    FLen := Length(AText); 
    FPos := 1; 
    FLine := 1; 
    FCol := 1;  

    if Length(FText) > 0 then 
        FChar := FText[1] 
    else FChar := #0; 
end;

procedure TLexer.Advance; 
begin
  if FChar = #10 then 
  begin 
    Inc(FLine);
    FCol := 1; 
  end else if FChar <> #13 then Inc(FCol);

  Inc(FPos);
  if FPos <= FLen then FChar := FText[FPos] else FChar := #0; // <-- GUNAKAN FLen
end;

function TLexer.Peek: Char; 
begin 
    if FPos < FLen then Result := FText[FPos+1] else Result := #0; // <-- GUNAKAN FLen
end;

function TLexer.ParseIdOrKeyword: TToken;
var 
  s: string;
  StartPos: Integer;
begin
  if ((FChar = 'f') or (FChar = 'F')) and ((Peek = '"') or (Peek = '''')) then
  begin
    Advance; 
    Result := ParseString; 
    Result.Typ := ttFString; 
    Exit;
  end;
  
  StartPos := FPos;
  
  while FChar in ['a'..'z', 'A'..'Z', '0'..'9', '_'] do 
    Advance; 
  
  s := Copy(FText, StartPos, FPos - StartPos);
  Result.Str := s; 
  
  case s of
    'if':       Result.Typ := ttIf;
    'then':     Result.Typ := ttThen;
    'else':     Result.Typ := ttElse;
    'case':     Result.Typ := ttCase;
    'of':       Result.Typ := ttOf;
    'while':    Result.Typ := ttWhile;
    'do':       Result.Typ := ttDo;
    'begin':    Result.Typ := ttBegin;
    'end':      Result.Typ := ttEnd;
    'var':      Result.Typ := ttVar;
    'const':    Result.Typ := ttConst;
    'function', 'method': Result.Typ := ttFunction;
    'class':    Result.Typ := ttClass;
    'record':   Result.Typ := ttRecord;
    'new':      Result.Typ := ttNew;
    'and':      Result.Typ := ttAnd;
    'or':       Result.Typ := ttOr;
    'for':      Result.Typ := ttFor;
    'to':       Result.Typ := ttTo;
    'in':       Result.Typ := ttIn;
    'return':   Result.Typ := ttReturn;
    'break':    Result.Typ := ttBreak;
    'continue': Result.Typ := ttContinue;
    'not':      Result.Typ := ttNot;
    'mod':      Result.Typ := ttMod;
    'try':      Result.Typ := ttTry;
    'catch':    Result.Typ := ttCatch;
    'finally':  Result.Typ := ttFinally;
    'true':     Result.Typ := ttTrue;
    'false':    Result.Typ := ttFalse;
    'null', 'nil': Result.Typ := ttNull; 
    'import':   Result.Typ := ttImport;
    'repeat':   Result.Typ := ttRepeat;
    'until':    Result.Typ := ttUntil;
    'lambda':   Result.Typ := ttLambda;
    'lock':     Result.Typ := ttLock;
    'yield':    Result.Typ := ttYield; 
    'defer':    Result.Typ := ttDefer; 
    'downto':   Result.Typ := ttDownto;
    'step':     Result.Typ := ttStep;
    'throw':    Result.Typ := ttThrow;  
  else
    Result.Typ := ttId;
  end;
end;

function TLexer.ParseNumber: TToken;
var 
  Combined: string;
  HasDot, HasExponent: Boolean;
begin 
  Combined := ''; 
  HasDot := False;
  HasExponent := False;

  while True do 
  begin 
    if Length(Combined) > (maxDigit * 2) then
    begin
      errMSG.callerror(32, 'TLexer.ParseNumber: Ukuran angka melebih batas memori', FLine, FCol);
      Break;
    end;

    if FChar in ['0'..'9'] then
    begin
      Combined := Combined + FChar;
      Advance;
    end else 
    if (FChar = '.') and not HasDot and not HasExponent then 
    begin
      if Peek in ['0'..'9'] then
      begin
        HasDot := True;
        Combined := Combined + FChar;
        Advance;
      end else Break; 
    end else 
    if (FChar in ['e', 'E']) and not HasExponent and (Length(Combined) > 0) then
    begin
      HasExponent := True;
      Combined := Combined + FChar;
      Advance;
      if FChar in ['+', '-'] then
      begin
        Combined := Combined + FChar;
        Advance;
      end;
    end else Break; 
  end; 

  if (Length(Combined) > 0) and (Combined[1] = '.') then
    Combined := '0' + Combined;

  // PERBAIKAN LOGIKA: Pengecekan eksistensi string mencegah error TryStrToFloat pada string kosong.
  if (Combined <> '') and TryStrToFloat(Combined, Result.Num, FS) then
  begin
    Result.Typ := ttNum;
    Result.Str := Combined;
  end else
  begin
    errMSG.callerror(33, 'TLexer.ParseNumber: Format angka tidak valid', FLine, FCol); 
    Result.Typ := ttNull; 
    Result.Num := 0;
    Result.Str := '0';
  end;
end;

function TLexer.ParseString: TToken;
var 
  S: string; 
  QuoteChar, C: Char;
begin 
  QuoteChar := FChar; 
  S := ''; // Serahkan alokasi memori ke FPC Internal Heap Manager
  
  Advance;   
  
  while (FChar <> #0) do 
  begin 
    if Length(S) >= strMax then 
    begin
      errMSG.callerror(40, 'Buffer string internal melampaui batas', FLine, FCol);
      Break;
    end;

    if FChar = '\' then 
    begin
      Advance;
      if FChar = #0 then Break; 

      case FChar of
        'n': C := #10;
        'r': C := #13;
        't': C := #9;
        '"': C := '"';
        '''': C := '''';
        '\': C := '\';
        else C := FChar;
      end;
      
      S := S + C; // Reallocation ditangani aman oleh engine secara logaritmik
      Advance;
      Continue;    
    end;

    if FChar = QuoteChar then
    begin
      if Peek = QuoteChar then 
      begin
        S := S + QuoteChar; 
        Advance; Advance; 
        Continue;
      end else 
        Break; 
    end;
    
    S := S + FChar; 
    Advance; 
  end; 
  
  if FChar = QuoteChar then 
    Advance
  else 
    errMSG.callerror(20, 'TLexer.ParseString', FLine, FCol); 

  Result.Typ := ttStr; 
  Result.Str := S; 
end;

function TLexer.GetNextToken: TToken;
var 
  SkipLoop: Boolean;
  StartLine, StartCol: Integer; 
begin
  SkipLoop := True;
  while SkipLoop do
  begin
    while FChar in [' ', #9, #10, #13] do Advance;

    if (FChar = '/') and (Peek = '/') then
    begin
      while (FChar <> #10) and (FChar <> #0) do Advance; 
      Continue; 
    end else
    
    if (FChar = '/') and (Peek = '*') then 
    begin
      Advance; Advance; 
      while (FChar <> #0) and not ((FChar = '*') and (Peek = '/')) do Advance;
      
      if FChar = #0 then 
      begin
        errMSG.callerror(28,'GetNextToken (Unclosed Block Comment)',FLine, FCol);
        SkipLoop := False; 
        Break; 
      end else
      begin
        Advance; Advance; 
        Continue; 
      end;
    end else
    begin
      SkipLoop := False; 
    end;
  end;

  StartLine := FLine;   
  StartCol  := FCol;  

  if FChar = #0 then 
  begin 
    Result.Typ := ttEOF; Result.Str := ''; Result.Line := StartLine; Result.Col := StartCol; Exit;
  end;

  if (FChar in ['0'..'9']) or ((FChar = '.') and (Peek in ['0'..'9'])) then 
  begin
    Result := ParseNumber;
    Result.Line := StartLine;
    Result.Col := StartCol;
    Exit;
  end;

  if FChar in ['a'..'z', 'A'..'Z', '_'] then 
  begin
    Result := ParseIdOrKeyword;
    Result.Line := StartLine;
    Result.Col := StartCol;
    Exit;
  end;

  if (FChar = '''') or (FChar = '"') then 
  begin
    Result := ParseString;
    Result.Line := StartLine;
    Result.Col := StartCol;
    Exit;
  end;

  Result.Str := FChar;
  Result.Line := StartLine;
  Result.Col := StartCol;

  case FChar of
    '+': if Peek = '=' then begin Advance; Result.Typ := ttPlusAssign; Result.Str := '+='; end else Result.Typ := ttPlus;
    '-': if Peek = '=' then begin Advance; Result.Typ := ttMinusAssign; Result.Str := '-='; end else Result.Typ := ttMinus;
    '*': if Peek = '=' then begin Advance; Result.Typ := ttMulAssign; Result.Str := '*='; end else Result.Typ := ttMul;
    '/': if Peek = '=' then begin Advance; Result.Typ := ttDivAssign; Result.Str := '/='; end else Result.Typ := ttDiv;
    '%': if Peek = '=' then begin Advance; Result.Typ := ttModAssign; Result.Str := '%='; end else Result.Typ := ttMod;
    '(': Result.Typ := ttLParen; 
    ')': Result.Typ := ttRParen; 
    '[': Result.Typ := ttLBracket; 
    ']': Result.Typ := ttRBracket; 
    '.': 
      begin
        // PERBAIKAN: Kembalikan ke FPos + 2.
        // FChar = Titik 1 (FPos)
        // Peek = Titik 2 (FPos + 1)
        // Titik 3 harus berada di FPos + 2
        if (Peek = '.') and (FPos + 2 <= Length(FText)) and (FText[FPos + 2] = '.') then
        begin
          Advance; Advance; 
          Result.Typ := ttSpread; 
          Result.Str := '...';
        end else 
        begin
          Result.Typ := ttDot; 
        end;
      end;
    ';': Result.Typ := ttSemiColon; 
    ',': Result.Typ := ttComma;
    '{': Result.Typ := ttLBrace;
    '}': Result.Typ := ttRBrace;
    '?': begin Result.Typ := ttQuestion; Result.Str := '?'; end;
    ':': if Peek = '=' then 
         begin 
            Advance; 
            Result.Typ := ttAssign; 
            Result.Str := ':='; 
         end else 
         begin
            Result.Typ := ttColon; 
            Result.Str := ':';
         end;   
    '=': if Peek = '=' then 
         begin 
            Advance; 
            Result.Typ := ttEqual; 
            Result.Str := '=='; 
         end else 
         begin
            Result.Typ := ttAssign; 
            Result.Str := '='; 
         end;
    '<': if Peek = '=' then begin Advance; Result.Typ := ttLessEqual; Result.Str := '<='; end 
         else if Peek = '>' then begin Advance; Result.Typ := ttNotEqual; Result.Str := '<>'; end // <-- FITUR BARU: <>
         else Result.Typ := ttLess;
    '>': if Peek = '=' then begin Advance; Result.Typ := ttGreaterEqual; Result.Str := '>='; end 
         else Result.Typ := ttGreater;
    '!': if Peek = '=' then begin Advance; Result.Typ := ttNotEqual; Result.Str := '!='; end
         else begin Result.Typ := ttNot; Result.Str := '!'; end;
    else begin 
        errMSG.callerror(21,'TLexer.GetNextToken',FLine, FCol); 
    end;
  end;
  
  Advance;
end;

constructor TParser.Create(ALexer: TLexer); 
begin 
    FLexer := ALexer; 
    FParseDepth := 0; // Inisialisasi awal
    FCurrToken := FLexer.GetNextToken; 
end;

function TParser.OptimizeBinaryOp(L: TNode; Op: TOpKind; R: TNode): TNode;
var
  LVal, RVal, ResVal: TValue;
  TotalLen: Int64;
begin
  if (L is TLiteralNode) and (R is TLiteralNode) then
  begin
    LVal := TLiteralNode(L).Val;
    RVal := TLiteralNode(R).Val;
    ResVal := nil;

    if (LVal.DataType = dtNumeric) and (RVal.DataType = dtNumeric) then
    begin
      try
        case Op of
          opAdd:      ResVal := TValue.CreateNum(SafeNumericMath('+', LVal.NumVal, RVal.NumVal));
          opSub:      ResVal := TValue.CreateNum(SafeNumericMath('-', LVal.NumVal, RVal.NumVal));
          opMul:      ResVal := TValue.CreateNum(SafeNumericMath('*', LVal.NumVal, RVal.NumVal));
          opDiv:      ResVal := TValue.CreateNum(SafeNumericMath('/', LVal.NumVal, RVal.NumVal));
          opMod:      ResVal := TValue.CreateNum(SafeNumericMath('%', LVal.NumVal, RVal.NumVal));
          opEq:       ResVal := TValue.CreateBool(SameValue(LVal.NumVal, RVal.NumVal, 1E-12));
          opNotEq:    ResVal := TValue.CreateBool(not SameValue(LVal.NumVal, RVal.NumVal, 1E-12));
          opLess:     ResVal := TValue.CreateBool(LVal.NumVal < RVal.NumVal);
          opGreater:  ResVal := TValue.CreateBool(LVal.NumVal > RVal.NumVal);
          opLessEq:   ResVal := TValue.CreateBool(LVal.NumVal <= RVal.NumVal);
          opGreaterEq:ResVal := TValue.CreateBool(LVal.NumVal >= RVal.NumVal);
        end;
      except
        // Jika pembagian nol memicu callerror, tangkap agar Node tidak dioptimasi dan dieksekusi VM
        ResVal := nil; 
      end;
    end else 
    if (LVal.DataType = dtString) and (RVal.DataType = dtString) then
    begin
      if Op = opAdd then
      begin
        TotalLen := Int64(Length(LVal.StrVal)) + Int64(Length(RVal.StrVal));
        if TotalLen > strMax then
          errMSG.callerror(40, 'TParser.OptimizeBinaryOp: Overflow Penggabungan Konstanta', L.Line, L.Col)
        else
          ResVal := TValue.CreateStr(LVal.StrVal + RVal.StrVal);
      end
      else if Op = opEq then
        ResVal := TValue.CreateBool(LVal.StrVal = RVal.StrVal)
      else if Op = opNotEq then
        ResVal := TValue.CreateBool(LVal.StrVal <> RVal.StrVal);
    end;

    if Assigned(ResVal) then
    begin
      Result := TLiteralNode.Create(ResVal);
      Result.Line := L.Line;
      Result.Col := L.Col;
      L.Free; 
      R.Free;
      Exit;
    end;
  end;

  Result := TBinaryOpNode.Create(L, Op, R);
  if Assigned(L) then 
  begin
    Result.Line := L.Line;
    Result.Col := L.Col;
  end;  
end;

function TParser.OptimizeUnaryOp(AOp: string; AExpr: TNode): TNode;
var
  ExprVal, ResVal: TValue;
begin
  if AExpr is TLiteralNode then
  begin
    ExprVal := TLiteralNode(AExpr).Val;
    ResVal := nil;
    
    try
      if (AOp = 'not') or (AOp = '!') then
        ResVal := TValue.CreateBool(not ExprVal.IsTrue)
      else if (AOp = '-') and (ExprVal.DataType = dtNumeric) then
        ResVal := TValue.CreateNum(-ExprVal.NumVal)
      else if (AOp = '+') and (ExprVal.DataType = dtNumeric) then
        ResVal := TValue.CreateNum(ExprVal.NumVal);
    except
      ResVal := nil;
    end;
    
    if Assigned(ResVal) then
    begin
      Result := TLiteralNode.Create(ResVal);
      Result.Line := AExpr.Line;
      Result.Col := AExpr.Col;
      AExpr.Free;
      Exit;
    end;
  end;
  
  Result := TUnaryOpNode.Create(AOp, AExpr);
  if Assigned(AExpr) then
  begin
    Result.Line := AExpr.Line;
    Result.Col := AExpr.Col;
  end;  
end;

function TParser.ParseCase: TNode;
var
  Node: TCaseNode;
  Branch: TCaseBranch;
  TargetNode: TNode;
  BranchCount, BranchCap, i: Integer;
begin
  Eat(ttCase);
  TargetNode := ParseExpression;
  
  try
    Eat(ttOf);
    Node := TCaseNode.Create(TargetNode);
  except
    TargetNode.Free;
    raise;
  end;
  
  BranchCount := 0;
  try 
    BranchCap := 4; 
    SetLength(Node.Branches, BranchCap);
    for i := 0 to BranchCap - 1 do 
    begin
      Node.Branches[i].MatchExpr := nil;
      Node.Branches[i].Body := nil;
    end;

    while (FCurrToken.Typ <> ttEnd) and (FCurrToken.Typ <> ttElse) and (FCurrToken.Typ <> ttEOF) do
    begin
      if BranchCount >= BranchCap then
      begin
        BranchCap := BranchCap * 2;
        SetLength(Node.Branches, BranchCap);
        for i := BranchCount to BranchCap - 1 do 
        begin
          Node.Branches[i].MatchExpr := nil;
          Node.Branches[i].Body := nil;
        end;
      end;

      Branch.MatchExpr := ParseExpression;
      try
        Eat(ttColon); 
        Branch.Body := ParseStatement; 
      except
        Branch.MatchExpr.Free;
        raise; 
      end;
      
      Node.Branches[BranchCount] := Branch;
      Inc(BranchCount);
    end;
    
    // Parsing Else opsional
    if FCurrToken.Typ = ttElse then
    begin
      Eat(ttElse);
      Eat(ttColon);
      Node.ElseBranch := ParseStatement;
    end;
    
    Eat(ttEnd);
    SetLength(Node.Branches, BranchCount); // Menyesuaikan batas akhir memori dinamis
    Result := Node;
    
  except
    // Bersihkan Tree yang mengambang jika Parser Crash
    Node.Free; 
    raise;
  end;
end;

procedure TParser.Eat(ATyp: TTokenType);
var
  Hint: string;
begin
  errMSG.xcol := FCurrToken.Col;
  errMSG.xrow := FCurrToken.line;
  
  if FCurrToken.Typ = ATyp then
    FCurrToken := FLexer.GetNextToken
  else 
  begin
    // ✅ Hint kontekstual: deteksi compound-assignment yang muncul
    // di dalam konteks ekspresi (biasanya karena user menulis
    // `lambda : x += 1` yang tidak valid sebagai ekspresi).
    Hint := '';
    case FCurrToken.Typ of
      ttPlusAssign, ttMinusAssign, ttMulAssign, 
      ttDivAssign, ttModAssign:
        Hint := '  Hint: operator `' + FCurrToken.Str + 
                '` hanya valid sebagai statement, bukan ekspresi. ' +
                'Gunakan `lambda : begin x += 1; end` atau ' +
                'deklarasikan fungsi bernama dengan `function ... begin ... end`.';
      ttAssign:
        Hint := '  Hint: `=` adalah assignment, bukan operator ekspresi. ' +
                'Gunakan `==` untuk perbandingan.';
      ttSemiColon:
        Hint := '  Hint: statement tidak lengkap sebelum `;`.';
    end;
    
    errMSG.callerror(25, 
      'Expected token tapi mendapat [' + FCurrToken.Str + ']' + Hint, 
      FCurrToken.Line, FCurrToken.Col);
    raise Exception.Create('Syntax Error pada baris ' + IntToStr(FCurrToken.Line)); 
  end;
end;

function TParser.ParseFactor: TNode;
var 
  LHS: TNode; 
  Obj, Mem: string; 
  Arr: TArrayLiteralNode;
  CallNode: TFunctionCallNode;
  UnaryOpStr: string;
  MethodCall: TMethodCallNode;
  DictNode: TDictLiteralNode;
  KeyStr: string;
  FuncNode: TFunctionNode;
  BlockNode: TBlockNode;
  NStart, NEnd, NStep: TNode;
  FirstExpr, ColExpr, CondExpr: TNode; 
  IterVar: string;
  StartLine, StartCol: Integer;
begin
  LHS := nil; Arr := nil; CallNode := nil; MethodCall := nil;
  DictNode := nil; FuncNode := nil; BlockNode := nil;
  NStart := nil; NEnd := nil; NStep := nil;
  FirstExpr := nil; ColExpr := nil; CondExpr := nil;

  StartLine := FCurrToken.Line; // <-- TAMBAHAN 2: Kunci koordinat awal
  StartCol  := FCurrToken.Col;  // <-- TAMBAHAN 3: Kunci koordinat awal
  
  try
    // --- FASE 1: EVALUASI BASE LHS (Left-Hand Side) ---
    if FCurrToken.Typ in [ttMinus, ttPlus, ttNot, ttSpread] then 
    begin
      UnaryOpStr := FCurrToken.Str;
      Eat(FCurrToken.Typ); 
      LHS := OptimizeUnaryOp(UnaryOpStr, Self.ParseFactor()); 
    end else
    
    if FCurrToken.Typ = ttImport then 
    begin
      Eat(ttImport);
      Eat(ttLParen);
      LHS := TImportExprNode.Create(ParseExpression); // Parsing path string di dalamnya
      Eat(ttRParen);
    end else
    
    if FCurrToken.Typ = ttLParen then 
    begin
      Eat(ttLParen); 
      LHS := ParseExpression; 
      Eat(ttRParen); 
    end else
    
    if FCurrToken.Typ = ttLBrace then 
    begin
      Eat(ttLBrace);
      DictNode := TDictLiteralNode.Create;
      try 
        if FCurrToken.Typ <> ttRBrace then 
        begin
          if not (FCurrToken.Typ in [ttStr, ttId]) then 
          begin
            errMSG.callerror(25, 'TParser.ParseFactor: Kunci Dictionary tidak valid', FCurrToken.Line, FCurrToken.Col);
            raise Exception.Create('Invalid Dictionary Key'); // <-- FIX: Putuskan eksekusi agar AST tidak korup
          end;
          
          KeyStr := FCurrToken.Str;
          Eat(FCurrToken.Typ);
          Eat(ttColon);
          DictNode.AddPair(KeyStr, ParseExpression); 
          
          while FCurrToken.Typ = ttComma do 
          begin
            Eat(ttComma);
            if FCurrToken.Typ = ttRBrace then Break; 

            if not (FCurrToken.Typ in [ttStr, ttId]) then 
            begin
              errMSG.callerror(25, 'TParser.ParseFactor: Kunci Dictionary tidak valid', FCurrToken.Line, FCurrToken.Col);
              raise Exception.Create('Invalid Dictionary Key'); // <-- FIX: Proteksi yang sama pada iterasi lanjutan
            end;
            
            KeyStr := FCurrToken.Str;
            Eat(FCurrToken.Typ);
            Eat(ttColon);
            DictNode.AddPair(KeyStr, ParseExpression);
          end;
        end;
        Eat(ttRBrace);
        LHS := DictNode;
      except
        DictNode.Free; 
        raise;
      end;
    end else  
    
    if FCurrToken.Typ = ttLBracket then 
    begin
      Eat(ttLBracket); 
      if FCurrToken.Typ = ttRBracket then 
      begin 
        LHS := TArrayLiteralNode.Create;
        Eat(ttRBracket);
      end else 
      begin
        FirstExpr := ParseExpression;
        
        if FCurrToken.Typ = ttFor then
        begin
          Eat(ttFor);
          ColExpr := nil;
          CondExpr := nil;
          
          try
            IterVar := FCurrToken.Str;
            Eat(ttId);
            Eat(ttIn);
            
            ColExpr := ParseExpression;
            if FCurrToken.Typ = ttIf then
            begin
              Eat(ttIf);
              CondExpr := ParseExpression;
            end;
            Eat(ttRBracket);
            LHS := TListComprehensionNode.Create(FirstExpr, IterVar, ColExpr, CondExpr);
          except
            // Bebaskan seluruh node yang menggantung jika gagal di titik manapun
            FirstExpr.Free;
            if Assigned(ColExpr) then ColExpr.Free;
            if Assigned(CondExpr) then CondExpr.Free;
            raise;
          end;
        end else 
        begin
          Arr := TArrayLiteralNode.Create;
          try 
            Arr.AddElement(FirstExpr); 
    
            while FCurrToken.Typ = ttComma do 
            begin 
               Eat(ttComma); 
               if FCurrToken.Typ = ttRBracket then Break; 
               Arr.AddElement(ParseExpression); // Parser akan otomatis mengurus ttSpread!
            end; 
            Eat(ttRBracket); 
            LHS := Arr;
          except
            Arr.Free; 
            raise;
          end;
        end;
      end;
    end else
    
    if FCurrToken.Typ = ttYield then 
    begin
      Eat(ttYield);
      LHS := TYieldNode.Create(ParseExpression); // Tangkap ekspresi untuk di-yield
    end else
    
    if FCurrToken.Typ = ttNum then 
    begin 
      LHS := TLiteralNode.Create(TValue.CreateNum(FCurrToken.Num)); 
      Eat(ttNum); 
    end else
    if FCurrToken.Typ = ttStr then 
    begin 
      LHS := TLiteralNode.Create(TValue.CreateStr(FCurrToken.Str)); 
      Eat(ttStr);
    end else
    if FCurrToken.Typ = ttFString then 
    begin 
      LHS := ParseFStringContent(FCurrToken.Str); 
      Eat(ttFString);
    end else  
    if FCurrToken.Typ = ttTrue then 
    begin
      LHS := TLiteralNode.Create(TValue.CreateBool(True));
      Eat(ttTrue);
    end else
    if FCurrToken.Typ = ttFalse then 
    begin
      LHS := TLiteralNode.Create(TValue.CreateBool(False));
      Eat(ttFalse);
    end else
    if FCurrToken.Typ = ttNull then 
    begin
      LHS := TLiteralNode.Create(TValue.CreateNull);
      Eat(ttNull);
    end else
    
    if FCurrToken.Typ = ttLambda then 
    begin
      Eat(ttLambda);
      FuncNode := TFunctionNode.Create;
      try
        FuncNode.Name := ''; 
      
        // ── Parse parameter list (opsional) ──
        if FCurrToken.Typ <> ttColon then 
        begin
          SetLength(FuncNode.Params, 1);
          FuncNode.Params[0].Name := FCurrToken.Str;
          FuncNode.Params[0].DefaultExpr := nil;
          Eat(ttId);
          
          while FCurrToken.Typ = ttComma do 
          begin
            Eat(ttComma);
            SetLength(FuncNode.Params, Length(FuncNode.Params) + 1);
            FuncNode.Params[High(FuncNode.Params)].Name := FCurrToken.Str;
            FuncNode.Params[High(FuncNode.Params)].DefaultExpr := nil;
            Eat(ttId);
          end;
        end;
      
        Eat(ttColon);
        
        // ✅ TAHAP B — B-3: Deteksi body block vs body ekspresi
        if FCurrToken.Typ = ttBegin then
        begin
          // Lambda dengan block body: `lambda : begin stmt; stmt; end`
          FuncNode.Body := Self.ParseStatement;
          if not (FuncNode.Body is TBlockNode) then
            errMSG.callerror(27, 
              'TParser.ParseFactor: body lambda begin..end harus blok',
              FCurrToken.Line, FCurrToken.Col);
        end
        else
        begin
          // Lambda ekspresi: `lambda : expr` (otomatis di-wrap Return)
          BlockNode := TBlockNode.Create;
          try 
            BlockNode.Statements.Add(TReturnNode.Create(ParseExpression));
            FuncNode.Body := BlockNode;
          except
            BlockNode.Free;
            raise;
          end;
        end;
        
        LHS := FuncNode;
      except
        FuncNode.Free;
        raise;
      end;
    end else

    if FCurrToken.Typ = ttId then 
    begin
      Obj := FCurrToken.Str; 
      Eat(ttId);
      LHS := TVariableNode.Create(Obj); // Jadikan node baca variabel biasa dahulu
    end else
    
    if FCurrToken.Typ = ttNew then 
    begin
      Eat(ttNew);
      Obj := FCurrToken.Str; 
      Eat(ttId);
      
      // Pindahkan pembuatan objek ke atas agar bisa menerima argumen
      LHS := TNewNode.Create(Obj); 
    
      if FCurrToken.Typ = ttLParen then 
      begin
        Eat(ttLParen); 
        if FCurrToken.Typ <> ttRParen then 
        begin
          TNewNode(LHS).Args.Add(ParseExpression);
          while FCurrToken.Typ = ttComma do 
          begin
            Eat(ttComma);
            TNewNode(LHS).Args.Add(ParseExpression);
          end;
        end;
        Eat(ttRParen);
      end;  
    end else
      errMSG.callerror(68,'TParser.ParseFactor;'+FCurrToken.Str,FCurrToken.Line, FCurrToken.Col); 
  
    // --- FASE 2: POSTFIX CHAINING (Berlaku untuk semua tipe LHS) ---
    while FCurrToken.Typ in [ttDot, ttLBracket, ttLParen] do
    begin
      if FCurrToken.Typ = ttLParen then 
      begin
        Eat(ttLParen);
        CallNode := TFunctionCallNode.Create(LHS); 
        LHS := nil; // : Serahkan kepemilikan untuk mencegah Double-Free
        try
          if FCurrToken.Typ <> ttRParen then 
          begin
            CallNode.Args.Add(ParseExpression);
            while FCurrToken.Typ = ttComma do 
            begin 
              Eat(ttComma); 
              CallNode.Args.Add(ParseExpression); 
            end;
          end;
          Eat(ttRParen);
          LHS := CallNode; // Tarik kembali jika sukses
        except
          CallNode.Free;
          raise;
        end;
      end else
     
      if FCurrToken.Typ = ttDot then 
      begin
        Eat(ttDot); 
        Mem := FCurrToken.Str; 
        Eat(ttId); 
        
        if FCurrToken.Typ = ttLParen then 
        begin
          Eat(ttLParen);
          MethodCall := TMethodCallNode.Create(LHS, Mem);
          LHS := nil; // PERBAIKAN 4: Putuskan LHS SEKARANG secara konsisten, sama seperti TFunctionCallNode
          try 
            if FCurrToken.Typ <> ttRParen then 
            begin
              MethodCall.Args.Add(ParseExpression);
              while FCurrToken.Typ = ttComma do 
              begin 
                Eat(ttComma); 
                MethodCall.Args.Add(ParseExpression); 
              end;
            end;
            Eat(ttRParen);
            LHS := MethodCall; 
          except
            MethodCall.Free; // Karena LHS sudah menjadi milik MethodCall, ini aman 100%
            raise;
          end;
        end else 
        begin
          LHS := TMemberAccessNode.Create(LHS, Mem); 
        end;
      end else

      if FCurrToken.Typ = ttLBracket then 
      begin 
        Eat(ttLBracket); 
        NStart := nil; NEnd := nil; NStep := nil;
        try
          if FCurrToken.Typ <> ttColon then
            NStart := ParseExpression;
            
          if FCurrToken.Typ = ttColon then
          begin
            Eat(ttColon);
            if (FCurrToken.Typ <> ttRBracket) and (FCurrToken.Typ <> ttColon) then
              NEnd := ParseExpression;
              
            if FCurrToken.Typ = ttColon then
            begin
              Eat(ttColon);
              if FCurrToken.Typ <> ttRBracket then
                NStep := ParseExpression;
            end;
            
            LHS := TArraySliceNode.Create(LHS, NStart, NEnd, NStep);
            // FIX: Putuskan pointer referensi setelah kepemilikan pindah ke LHS
            NStart := nil; 
            NEnd := nil; 
            NStep := nil;
          end else 
          begin
            LHS := TArrayAccessNode.Create(LHS, NStart);
            // FIX: Putuskan pointer
            NStart := nil;
          end;
          Eat(ttRBracket);
        except
          // Aman dari Double-Free karena pointer sudah di-nil jika sukses terpasang
          if Assigned(NStart) then NStart.Free;
          if Assigned(NEnd) then NEnd.Free;
          if Assigned(NStep) then NStep.Free;
          raise;
        end;
      end;
    end;
   
  except
    // Benteng Terakhir: Hancurkan LHS jika ada exception yang tidak tertangkap oleh wrapper
    if Assigned(LHS) then LHS.Free;
    raise;
  end;
  
  if Assigned(LHS) and (LHS.Line = 0) then
  begin
    LHS.Line := StartLine;
    LHS.Col  := StartCol;
  end;  
  Result := LHS;
end;

function TParser.ParseTerm: TNode; 
var 
  N, RightNode: TNode; 
  OpK: TOpKind; 
begin 
  N := ParseFactor; 
  try
    while FCurrToken.Typ in [ttMul, ttDiv, ttMod] do 
    begin 
      if FCurrToken.Typ = ttMul then OpK := opMul else
      if FCurrToken.Typ = ttDiv then OpK := opDiv else
      OpK := opMod;
      
      Eat(FCurrToken.Typ); 
      RightNode := ParseFactor;
      try
        N := OptimizeBinaryOp(N, OpK, RightNode);
      except
        RightNode.Free; // <-- CEGAH LEAK JIKA OPTIMASI GAGAL
        raise;
      end;
    end; 
    Result := N; 
  except
    if Assigned(N) then N.Free;
    raise;
  end;
end;

function TParser.ParseMathExpr: TNode; 
var 
  N, RightNode: TNode; 
  OpK: TOpKind; 
begin 
  N := ParseTerm; 
  try
    while FCurrToken.Typ in [ttPlus, ttMinus] do 
    begin 
      if FCurrToken.Typ = ttPlus then OpK := opAdd else OpK := opSub;
      Eat(FCurrToken.Typ); 
      
      RightNode := ParseTerm; 
      try
        N := OptimizeBinaryOp(N, OpK, RightNode);
      except
        RightNode.Free; // <-- CEGAH LEAK
        raise;
      end;
    end; 
    Result := N; 
  except
    if Assigned(N) then N.Free; 
    raise;
  end;
end;

function TParser.ParseComparison: TNode; 
var N, RightNode: TNode; OpK: TOpKind;
begin 
  N := ParseMathExpr; 
  try
    if FCurrToken.Typ in [ttEqual, ttLess, ttGreater, ttLessEqual, ttGreaterEqual, ttNotEqual, ttIn] then 
    begin 
      case FCurrToken.Typ of
        ttEqual:        OpK := opEq;
        ttNotEqual:     OpK := opNotEq;
        ttLess:         OpK := opLess;
        ttGreater:      OpK := opGreater;
        ttLessEqual:    OpK := opLessEq;
        ttGreaterEqual: OpK := opGreaterEq;
        ttIn:           OpK := opIn;
      end;

      Eat(FCurrToken.Typ); 
      RightNode := ParseMathExpr;
      try
        N := OptimizeBinaryOp(N, OpK, RightNode); 
      except
        RightNode.Free;
        raise;
      end;
    end; 
    Result := N; 
  except
    if Assigned(N) then N.Free; 
    raise;
  end;
end;

// Prioritas AND dipisah dari OR (AND dievaluasi lebih dulu)
function TParser.ParseLogicalAnd: TNode; 
var N, RightNode: TNode; 
begin
  N := ParseComparison; 
  try
    while FCurrToken.Typ = ttAnd do
    begin
      Eat(ttAnd);
      RightNode := ParseComparison;
      try
        N := OptimizeBinaryOp(N, opAnd, RightNode); 
      except
        RightNode.Free;
        raise;
      end;
    end;
    Result := N;
  except
    if Assigned(N) then N.Free;
    raise;
  end;
end;

function TParser.ParseLogicalOr: TNode;
var N, RightNode: TNode; 
begin
  N := ParseLogicalAnd; 
  try
    while FCurrToken.Typ = ttOr do
    begin
      Eat(ttOr);
      RightNode := ParseLogicalAnd;
      try
        N := OptimizeBinaryOp(N, opOr, RightNode); 
      except
        RightNode.Free;
        raise;
      end;
    end;
    Result := N;
  except
    if Assigned(N) then N.Free;
    raise;
  end;
end;

function TParser.ParseExpression: TNode; 
begin 
    Inc(FParseDepth);
    try
      if FParseDepth > 500 then 
      begin
          errMSG.callerror(41, 'Stack Overflow: Ekspresi terlalu dalam', FCurrToken.Line, FCurrToken.Col);
          // KEMBALIKAN NO-OP UNTUK MENCEGAH ACCESS VIOLATION DI NODE PARENT
          Result := TNoOpNode.Create;
          Exit;
      end;
      
      Result := ParseTernary; 
    finally
      Dec(FParseDepth); 
    end;
end;

function TParser.ParseIf: TNode; 
var 
  Cond, ThenBr, ElseBr: TNode; 
  CondVal: TValue;
  IsTruthy: Boolean; // <-- PERBAIKAN: Variabel evaluasi Truthy
begin 
  Eat(ttIf); 
  Cond := ParseExpression; 
  ThenBr := nil; // Inisialisasi wajib untuk keamanan pointer
  ElseBr := nil;
  
  try
    Eat(ttThen); 
    ThenBr := ParseStatement; 
    
    // Mengizinkan titik koma secara opsional sebelum blok Else 
    if FCurrToken.Typ = ttSemiColon then Eat(ttSemiColon);

    if FCurrToken.Typ = ttElse then 
    begin 
      Eat(ttElse); 
      ElseBr := ParseStatement; 
    end; 
  except
    // Bersihkan seluruh cabang yang sudah telanjur terbuat sebelum error
    Cond.Free;
    if Assigned(ThenBr) then ThenBr.Free;
    if Assigned(ElseBr) then ElseBr.Free;
    raise;
  end;

  // --- PERBAIKAN LOGIKA: DEAD CODE ELIMINATION DENGAN TRUTHY EVAL ---
  if Cond is TLiteralNode then
  begin
    CondVal := TLiteralNode(Cond).Val;
    IsTruthy := False;
    
    // Evaluasi Dinamis Universal
    case CondVal.DataType of
      dtBoolean: IsTruthy := CondVal.BoolVal;
      dtNumeric: IsTruthy := not SameValue(CondVal.NumVal, 0.0, 1E-12);
      dtString:  IsTruthy := (Length(CondVal.StrVal) > 0);
      dtNull:    IsTruthy := False;
    end;

    if IsTruthy then
    begin
      if Assigned(ElseBr) then ElseBr.Free;
      Cond.Free;
      
      if Assigned(ThenBr) then Result := ThenBr 
      else Result := TNoOpNode.Create; 
      Exit;
    end else
    begin
      if Assigned(ThenBr) then ThenBr.Free;
      Cond.Free;
      
      if Assigned(ElseBr) then Result := ElseBr 
      else Result := TNoOpNode.Create;
      Exit;
    end;
  end;

  Result := TIfNode.Create(Cond, ThenBr, ElseBr); 
end;

function TParser.ParseWhile: TNode; 
var 
  Cond, Body: TNode; 
  CondVal: TValue;
  IsTruthy: Boolean; // <-- PERBAIKAN: Variabel evaluasi Truthy
begin 
  Eat(ttWhile); 
  Cond := ParseExpression; 
  
  try
    Eat(ttDo); 
    Body := ParseStatement; 
  except
    Cond.Free; // Node kondisi harus dibebaskan jika parser tersedak di token Body.
    raise;
  end;
  
  // --- PERBAIKAN LOGIKA: DEAD CODE ELIMINATION DENGAN TRUTHY EVAL ---
  if Cond is TLiteralNode then
  begin
    CondVal := TLiteralNode(Cond).Val;
    IsTruthy := False;
    
    // Evaluasi Dinamis Universal
    case CondVal.DataType of
      dtBoolean: IsTruthy := CondVal.BoolVal;
      dtNumeric: IsTruthy := not SameValue(CondVal.NumVal, 0.0, 1E-12);
      dtString:  IsTruthy := (Length(CondVal.StrVal) > 0);
      dtNull:    IsTruthy := False;
    end;
    
    if not IsTruthy then
    begin
      Cond.Free;
      Body.Free;
      Result := TNoOpNode.Create; 
      Exit;
    end;
  end;

  Result := TWhileNode.Create(Cond, Body); 
end;

function TParser.ParseFunctionDecl(IsStructMethod: Boolean = False): TFunctionNode; 
var 
  Func: TFunctionNode;
  FuncBodyBlock: TBlockNode;
  ParamCount, ParamCap: Integer;
  
  procedure AddParam;
  begin
    if ParamCount >= ParamCap then
    begin
      ParamCap := ParamCap * 2;
      SetLength(Func.Params, ParamCap);
    end;
    
    Func.Params[ParamCount].Name := FCurrToken.Str;
    Eat(ttId);
    
    if (FCurrToken.Typ = ttAssign) or (FCurrToken.Typ = ttEqual) then
    begin
      Eat(FCurrToken.Typ);
      Func.Params[ParamCount].DefaultExpr := ParseExpression;
    end else 
      Func.Params[ParamCount].DefaultExpr := nil;
      
    Inc(ParamCount);
  end;
        
begin
  Func := TFunctionNode.Create;
  FuncBodyBlock := nil;
  try
    Func.Name := FCurrToken.Str;

    if (LowerCase(Func.Name) = 'create') and (not IsStructMethod) then
      errMSG.callerror(42, 'TParser.ParseFunctionDecl', FCurrToken.Line, FCurrToken.Col);

    Eat(ttId);

    if FCurrToken.Typ = ttLParen then 
    begin
      Eat(ttLParen);
      if FCurrToken.Typ <> ttRParen then 
      begin
        ParamCount := 0;
        ParamCap := 4; // Kapasitas awal untuk alokasi memori
        SetLength(Func.Params, ParamCap);
        
        AddParam; // Parameter pertama
        
        while FCurrToken.Typ = ttComma do 
        begin
          Eat(ttComma);
          AddParam;
        end;
        
        SetLength(Func.Params, ParamCount); // Pangkas sisa memori dinamis
      end;
      Eat(ttRParen);
    end;

    FuncBodyBlock := TBlockNode.Create;
    Eat(ttBegin);
    
    while (FCurrToken.Typ <> ttEnd) and (FCurrToken.Typ <> ttEOF) do 
    begin
      FuncBodyBlock.Statements.Add(ParseStatement); 
      if FCurrToken.Typ = ttSemiColon then Eat(ttSemiColon);
    end;
    
    Eat(ttEnd);

    Func.Body := FuncBodyBlock; 
    Result := Func;
    
  except
    if Assigned(FuncBodyBlock) then FuncBodyBlock.Free;
    Func.Free; 
    raise;
  end;
end;

function TParser.ParseStatement: TNode;
var DeclNode,node1, node2, node3: TNode;
    Obj, ObjType, Mem, OpStr : string;     
    Idx: TNode; 
    CallNode: TFunctionCallNode;
    MethodCall: TMethodCallNode;
    IsConst, IsDownto: Boolean;
    DeclBlock: TBlockNode; 
    StartLine, StartCol: Integer; // FIX: Tambahkan StartCol
begin
  node1 := nil; node2 := nil; node3 := nil; Idx := nil;
  CallNode := nil; MethodCall := nil; DeclBlock := nil;

  // Tangkap posisi baris DAN kolom saat ini dari Lexer
  StartLine := FCurrToken.Line; 
  StartCol  := FCurrToken.Col; 
  Result    := nil;   

  if FCurrToken.Typ = ttSemiColon then
  begin
    Eat(ttSemiColon);
    Result := TNoOpNode.Create;
    Result.Line := StartLine;
    Result.Col := StartCol;
    Exit(Result);
  end;
  
  if FCurrToken.Typ = ttBegin then 
  begin 
    Eat(ttBegin); 
    Result := ParseBlock(ttEnd); 
  end else 

  if FCurrToken.Typ = ttTry then 
  begin
    Eat(ttTry);
    node1 := TBlockNode.Create(True); 
    
    try
      while not (FCurrToken.Typ in [ttCatch, ttFinally, ttEnd, ttEOF]) do
      begin
        TBlockNode(node1).Statements.Add(self.ParseStatement());
        if FCurrToken.Typ = ttSemiColon then Eat(ttSemiColon);
      end;
      
      Obj := ''; node2 := nil; node3 := nil;
      ObjType := '';   
      
      if FCurrToken.Typ = ttCatch then
      begin
        Eat(ttCatch);
        
        if FCurrToken.Typ = ttLParen then 
        begin
          Eat(ttLParen);
          Obj := FCurrToken.Str;   
          Eat(ttId);
          Eat(ttRParen);
        end
        else if FCurrToken.Typ = ttId then
        begin
          Obj := FCurrToken.Str;
          Eat(ttId);
          
          if FCurrToken.Typ = ttColon then
          begin
            Eat(ttColon);
            ObjType := FCurrToken.Str;
            Eat(ttId);
          end;
        end;
        
        // Optional `do`
        if FCurrToken.Typ = ttDo then Eat(ttDo);
        
        node2 := TBlockNode.Create(True); 
        while not (FCurrToken.Typ in [ttFinally, ttEnd, ttEOF]) do
        begin
          TBlockNode(node2).Statements.Add(self.ParseStatement());
          if FCurrToken.Typ = ttSemiColon then Eat(ttSemiColon);
        end;
      end;
      
      if FCurrToken.Typ = ttFinally then
      begin
        Eat(ttFinally);
        node3 := TBlockNode.Create(True); // <-- Menampung blok finally
        while not (FCurrToken.Typ in [ttEnd, ttEOF]) do
        begin
          TBlockNode(node3).Statements.Add(self.ParseStatement());
          if FCurrToken.Typ = ttSemiColon then Eat(ttSemiColon);
        end;
      end;

      if (node2 = nil) and (node3 = nil) then
      begin
        errMSG.callerror(34, 'ParseStatement (Try butuh Catch atau Finally)', FCurrToken.Line, FCurrToken.Col); 
        raise Exception.Create('Try requires Catch or Finally block'); // <-- FIX: Mencegah VM mengeksekusi node Try yang korup
      end;

      if FCurrToken.Typ = ttEnd then Eat(ttEnd);
      Result := TTryCatchNode.Create(node1, Obj, ObjType, node2, node3);
      
    except
      if Assigned(node1) then node1.Free;
      if Assigned(node2) then node2.Free;
      if Assigned(node3) then node3.Free;
      raise;
    end;
  end else

  if (FCurrToken.Typ = ttVar) or (FCurrToken.Typ = ttConst) then 
  begin
    IsConst := (FCurrToken.Typ = ttConst);
    Eat(FCurrToken.Typ);
    DeclBlock := TBlockNode.Create(False);
  
    try
      repeat
        // PERBAIKAN: Capture posisi identifier SEKARANG, sebelum Eat
        Obj := FCurrToken.Str;
        StartLine := FCurrToken.Line;
        StartCol := FCurrToken.Col;  // <-- PENTING: Capture kolom identifier
        
        Eat(ttId);
        
        if (FCurrToken.Typ = ttAssign) or (FCurrToken.Typ = ttEqual) then 
        begin
          Eat(FCurrToken.Typ);
          DeclNode := TVarDeclNode.Create(Obj, ParseExpression, IsConst);
          // Set posisi ke identifier, bukan ke operator :=
          DeclNode.Line := StartLine;
          DeclNode.Col := StartCol;
          DeclBlock.Statements.Add(DeclNode);
        end else 
        begin 
          if IsConst then 
            errMSG.callerror(26,'ParseStatement',FCurrToken.Line, FCurrToken.Col);
          DeclNode := TVarDeclNode.Create(Obj, TLiteralNode.Create(TValue.CreateNull), IsConst);
          DeclNode.Line := StartLine;
          DeclNode.Col := StartCol;
          DeclBlock.Statements.Add(DeclNode);
        end;  
        
        if FCurrToken.Typ = ttComma then Eat(ttComma)
        else Break;
      until False;
  
      Result := DeclBlock;
    except
      DeclBlock.Free;
      raise;
    end;
  end else

  if FCurrToken.Typ = ttFor then 
  begin
    Eat(ttFor);
    Obj := FCurrToken.Str; 
    Eat(ttId); 
    
    if FCurrToken.Typ = ttIn then
    begin
      // --- forEach (unchanged) ---
      Eat(ttIn);
      Node1 := ParseExpression; 
      try
        Eat(ttDo);
        Result := TForEachNode.Create(Obj, Node1, Self.ParseStatement());
      except
        Node1.Free;
        raise;
      end;
    end else
    begin
      // --- numeric for (extended with downto + step) ---
      Eat(ttAssign);
      Node1 := ParseExpression;                 // start
      try
        // ✅ TAHAP C — C-1: detect to | downto
        case FCurrToken.Typ of
          ttTo:     IsDownto := False;
          ttDownto: IsDownto := True;
        else
          errMSG.callerror(25,
            'TParser.ParseStatement: "for" butuh "to" atau "downto"',
            FCurrToken.Line, FCurrToken.Col);
          IsDownto := False;
        end;
        Eat(FCurrToken.Typ);
  
        Node2 := ParseExpression;               // end
        try
          // ✅ TAHAP C — C-1: optional step
          Node3 := nil;
          if FCurrToken.Typ = ttStep then
          begin
            Eat(ttStep);
            Node3 := ParseExpression;
          end;
  
          Eat(ttDo);
          Result := TForNode.Create(Obj, Node1, Node2, Node3,
                                     Self.ParseStatement(), IsDownto);
        except
          if Assigned(Node3) then Node3.Free;
          raise;
        end;
      except
        Node1.Free;
        raise;
      end;
    end;
  end else
  
  if FCurrToken.Typ = ttThrow then
  begin
    Eat(ttThrow);
    Result := TThrowNode.Create(ParseExpression);
    if Assigned(Result) and (Result.Line = 0) then
    begin
      Result.Line := StartLine;
      Result.Col := StartCol;
    end;
    Exit(Result);
  end else
  
  if FCurrToken.Typ = ttReturn then
  begin
      Eat(ttReturn);
      if FCurrToken.Typ <> ttSemiColon then
        Result := TReturnNode.Create(ParseExpression)
      else Result := TReturnNode.Create(nil);
  end else
  
  if FCurrToken.Typ = ttLock then
  begin
      Eat(ttLock);
      Result := TLockNode.Create(Self.ParseStatement()); 
  end else
  
  if FCurrToken.Typ = ttBreak then
  begin
      Eat(ttBreak);
      Result := TBreakNode.Create;
  end else
  
  if FCurrToken.Typ = ttContinue then
  begin
      Eat(ttContinue);
      Result := TContinueNode.Create;
  end else
  
  if FCurrToken.Typ = ttYield then
  begin
      Eat(ttYield);
      // Cek apakah ada ekspresi setelah yield (misal: yield i;) 
      // atau hanya yield kosong (misal: yield;)
      if (FCurrToken.Typ <> ttSemiColon) and (FCurrToken.Typ <> ttEnd) then
        Result := TYieldNode.Create(ParseExpression)
      else 
        Result := TYieldNode.Create(nil);
  end else
  
  if FCurrToken.Typ = ttDefer then
  begin
      Eat(ttDefer);
      Result := TDeferNode.Create(Self.ParseStatement());
  end else
  
  if FCurrToken.Typ = ttCase then 
  begin
      Result := ParseCase 
  end else 

  if FCurrToken.Typ = ttFunction then 
  begin 
      Eat(ttFunction); 
      Result := ParseFunctionDecl; 
  end else 
  
  if FCurrToken.Typ = ttIf      then Result := ParseIf else 
  if FCurrToken.Typ = ttWhile   then Result := ParseWhile else 

  if FCurrToken.Typ = ttRepeat  then 
  begin
    Eat(ttRepeat);
    DeclBlock := ParseBlock(ttUntil); 
    try
      Node1 := ParseExpression;         
    except
      DeclBlock.Free;
      raise;
    end;
    Result := TRepeatNode.Create(DeclBlock, Node1);
  end else

  if FCurrToken.Typ = ttId then 
  begin
    Obj := FCurrToken.Str; Eat(ttId);
    
    if FCurrToken.Typ = ttComma then
    begin
      node1 := TMultiAssignNode.Create(nil); 
      try 
        TMultiAssignNode(node1).Targets.Add(Obj); 
        
        while FCurrToken.Typ = ttComma do 
        begin
          Eat(ttComma);
          TMultiAssignNode(node1).Targets.Add(FCurrToken.Str);
          Eat(ttId);
        end;
        
        if (FCurrToken.Typ = ttAssign) or (FCurrToken.Typ = ttEqual) then
        begin
          Eat(FCurrToken.Typ);
          TMultiAssignNode(node1).Expr := ParseExpression; 
          Result := node1;
          
          if Assigned(Result) and (Result.Line = 0) then 
          begin
             Result.Line := StartLine;
             Result.Col := StartCol; // <-- PERBAIKAN: Koordinat akurat
          end;
          Exit(Result); 
        end else
        begin
          errMSG.callerror(35, 'ParseStatement', FCurrToken.Line, FCurrToken.Col);
          node1.Free;
          Result := TNoOpNode.Create;
          Result.Line := StartLine;
          Result.Col := StartCol; // <-- PERBAIKAN: Koordinat akurat
          Exit(Result); 
        end;
      except
        node1.Free; 
        raise;
      end;
    end;
    
    Result := TVariableNode.Create(Obj);

    try
      while FCurrToken.Typ in [
          ttLBracket, ttDot, ttAssign, ttLParen, ttPlusAssign, 
          ttMinusAssign, ttMulAssign, ttDivAssign, ttModAssign] do
      begin
        if FCurrToken.Typ = ttLParen then
        begin
          Eat(ttLParen);
          CallNode := TFunctionCallNode.Create(Result); 
          Result := nil; // Mencegah Double-Free
          try 
            if FCurrToken.Typ <> ttRParen then
            begin
              CallNode.Args.Add(ParseExpression);
              while FCurrToken.Typ = ttComma do begin Eat(ttComma); CallNode.Args.Add(ParseExpression); end;
            end;
            Eat(ttRParen);
            Result := CallNode; 
          except
            CallNode.Free;
            raise;
          end;
        end else    
        
        if FCurrToken.Typ in [ttAssign, ttPlusAssign, ttMinusAssign, ttMulAssign, ttDivAssign, ttModAssign] then
        begin
          case FCurrToken.Typ of
            ttPlusAssign : OpStr := '+';
            ttMinusAssign: OpStr := '-';
            ttMulAssign  : OpStr := '*';
            ttDivAssign  : OpStr := '/';
            ttModAssign  : OpStr := '%';
            else OpStr := '='; 
          end;          
          
          Eat(FCurrToken.Typ);
          
          try
            node3 := ParseExpression; 
          except
            raise;
          end;
          
          if Result is TVariableNode then
          begin
            Obj := TVariableNode(Result).VarName;
            Result.Free; 
            Result := nil; 
            
            try 
              Result := TAssignmentNode.Create(Obj, node3);
              TAssignmentNode(Result).OpAssign := OpStr;
            except
              node3.Free;
              raise;
            end;
          end else           
          if Result is TMemberAccessNode then
          begin
            Mem := TMemberAccessNode(Result).MemberName;
            node2 := TMemberAccessNode(Result).Target;
            
            TMemberAccessNode(Result).Target := nil; 
            Result.Free;
            Result := nil; // <-- PERBAIKAN FATAL: Cegah Double-Free di handler except terluar

            try
              Result := TMemberAssignNode.Create(node2, Mem, node3);
              TMemberAssignNode(Result).OpAssign := OpStr;
            except
              node2.Free; 
              node3.Free; 
              raise;
            end;          
          end else 
          if Result is TArrayAccessNode then
          begin
            node1 := TArrayAccessNode(Result).fIndexExpr;
            node2 := TArrayAccessNode(Result).fTarget;
            
            TArrayAccessNode(Result).fIndexExpr := nil; 
            TArrayAccessNode(Result).fTarget := nil; 
            Result.Free;
            Result := nil; // <-- PERBAIKAN FATAL
            
            try
              Result := TArrayAssignNode.Create(node2, node1, node3);
              TArrayAssignNode(Result).FAssignOp := OpStr;
            except
              node1.Free; 
              node2.Free;
              node3.Free; 
              raise;
            end;          
          end else 
          begin
            node3.Free; 
            errMSG.callerror(29, 'ParseStatement',FCurrToken.Line, FCurrToken.Col); 
            Result.Free; 
            Result := TNoOpNode.Create; 
          end;
          
          if Assigned(Result) and (Result.Line = 0) then 
          begin
            Result.Line := StartLine;
            Result.Col := StartCol; // <-- PERBAIKAN: Koordinat akurat
          end;
          Exit(Result);
        end else  
  
        if FCurrToken.Typ = ttDot then
        begin
          Eat(ttDot);
          Mem := FCurrToken.Str; Eat(ttId);
          
          if FCurrToken.Typ = ttLParen then
          begin
            Eat(ttLParen);
            MethodCall := TMethodCallNode.Create(Result, Mem);
            Result := nil; // <-- PERBAIKAN FATAL: Putuskan referensi LHS
            try 
              if FCurrToken.Typ <> ttRParen then
              begin
                MethodCall.Args.Add(ParseExpression);
                while FCurrToken.Typ = ttComma do begin Eat(ttComma); MethodCall.Args.Add(ParseExpression); end;
              end;
              Eat(ttRParen);
              Result := MethodCall;
            except
              //MethodCall.Target := nil; 
              MethodCall.Free;
              // Result.Free; <-- PERBAIKAN: Hapus pemicu Double-Free ini
              raise;
            end;
          end else
          begin
            Result := TMemberAccessNode.Create(Result, Mem);
          end;
        end else 
        
        if FCurrToken.Typ = ttLBracket then
        begin
          Eat(ttLBracket);
          Idx := ParseExpression;
          // PERBAIKAN 2: Lindungi Idx agar tidak bocor jika Eat(ttRBracket) gagal
          try
            Eat(ttRBracket);
            Result := TArrayAccessNode.Create(Result, Idx);
          except
            Idx.Free;
            raise;
          end;
        end;
      end;
  
      if not ((Result is TAssignmentNode) or (Result is TArrayAssignNode) or 
              (Result is TMemberAssignNode) or (Result is TMethodCallNode) or 
              (Result is TFunctionCallNode)) then
      begin
        Result.Free;
        Result := nil;              // ← cegah double-free di except
        errMSG.callerror(25, 'Statement tidak valid atau identifier menggantung (Periksa kemungkinan typo seperti "retun" alih-alih "return")', FCurrToken.Line, FCurrToken.Col); 
        Result := TNoOpNode.Create; 
      end;
      
    except
      if Assigned(Result) then Result.Free;
      raise;
    end; 
  end;

  if not Assigned(Result) then 
  begin 
    errMSG.callerror(25, 'ParseStatement', FCurrToken.Line, FCurrToken.Col); 
    Result := TNoOpNode.Create; 
  end;

  if Assigned(Result) and (Result.Line = 0) then 
  begin
    Result.Line := StartLine;
    Result.Col := StartCol;
  end;
end;

function TParser.ParseBlock(EndToken: TTokenType): TBlockNode;
var B: TBlockNode; S: TNode;
begin
  B := TBlockNode.Create;
  try
    while (FCurrToken.Typ <> EndToken) and (FCurrToken.Typ <> ttEOF) do 
    begin
      S := ParseStatement; 
      if Assigned(S) then B.Statements.Add(S);
    end;
    if EndToken <> ttEOF then Eat(EndToken);
    Result := B;
  except
    B.Free;
    raise;
  end;
end;

function TParser.ParseMainProgram: TBlockNode;
var 
  B: TBlockNode;
  IsConst: Boolean;
  ObjName: string;
  DeclNode,s: TNode;
  StartLine: Integer;
begin
  B := TBlockNode.Create(False); 
  try
    while FCurrToken.Typ in [ttVar, ttConst, ttClass, ttRecord, ttFunction] do
    begin
      StartLine := FCurrToken.Line;

      if (FCurrToken.Typ = ttVar) or (FCurrToken.Typ = ttConst) then
      begin
        IsConst := (FCurrToken.Typ = ttConst);
        Eat(FCurrToken.Typ);
        
        // : Jangan gunakan while ttId, gunakan deteksi koma agar fungsi tidak tertelan
        repeat
          ObjName := FCurrToken.Str;
          Eat(ttId);
          
          if (FCurrToken.Typ = ttAssign) or (FCurrToken.Typ = ttEqual) then
          begin
            Eat(FCurrToken.Typ);
            DeclNode := TVarDeclNode.Create(ObjName, ParseExpression, IsConst);
            DeclNode.Line := StartLine;
          end else
          begin
            if IsConst then 
              errMSG.callerror(26, 'TParser.ParseMainProgram', FCurrToken.Line, FCurrToken.Col); 
            DeclNode := TVarDeclNode.Create(ObjName, TLiteralNode.Create(TValue.CreateNull), IsConst);
            DeclNode.Line := StartLine;
          end;
          
          B.Statements.Add(DeclNode);
          
          if FCurrToken.Typ = ttComma then Eat(ttComma) else Break;
        until False;
        
        Eat(ttSemiColon);
      end else

      if FCurrToken.Typ = ttFunction then
      begin
        Eat(ttFunction);
        DeclNode := ParseFunctionDecl;
        DeclNode.Line := StartLine;
        B.Statements.Add(DeclNode);
        if FCurrToken.Typ = ttSemiColon then Eat(ttSemiColon);
      end else
      
      if (FCurrToken.Typ = ttClass) or (FCurrToken.Typ = ttRecord) then
      begin
        DeclNode := ParseStructDecl(FCurrToken.Typ = ttRecord);
        DeclNode.Line := StartLine;
        B.Statements.Add(DeclNode);
      end;
    end;

    Eat(ttBegin);
    
    while (FCurrToken.Typ <> ttEnd) and (FCurrToken.Typ <> ttEOF) do 
    begin
      S := ParseStatement; 
      if Assigned(S) then B.Statements.Add(S);
    end;
    
    Eat(ttEnd);
    if FCurrToken.Typ = ttDot then Eat(ttDot); 
    
    Result := B;
  except
    B.Free;
    raise;
  end;
end;

function TParser.ParseTernary: TNode;
var
  ConditionNode, TrueBranch, FalseBranch: TNode;
  CondVal: TValue;
begin
  ConditionNode := ParseLogicalOr; 

  if FCurrToken.Typ = ttQuestion then
  begin
    Eat(ttQuestion); 
    TrueBranch := nil; FalseBranch := nil; // Mencegah pembebasan pointer acak
    
    try 
      TrueBranch := ParseExpression; 
      Eat(ttColon); 
      FalseBranch := ParseExpression;
    except
      ConditionNode.Free;
      if Assigned(TrueBranch) then TrueBranch.Free;
      if Assigned(FalseBranch) then FalseBranch.Free;
      raise;
    end;
    
    // --- DEAD CODE ELIMINATION ---
    if ConditionNode is TLiteralNode then
    begin
      CondVal := TLiteralNode(ConditionNode).Val;
      if CondVal.DataType = dtBoolean then
      begin
        if CondVal.BoolVal then
        begin
          ConditionNode.Free;
          FalseBranch.Free;
          Result := TrueBranch;
        end else
        begin
          ConditionNode.Free;
          TrueBranch.Free;
          Result := FalseBranch;
        end;
        Exit; // KELUAR AMAN
      end;
    end;
    
    Result := TTernaryNode.Create(ConditionNode, TrueBranch, FalseBranch);
  end else
  begin
    Result := ConditionNode; // Pass-through secara utuh
  end;
end;

function TParser.ParseStructDecl(IsRecord: Boolean): TClassDeclNode;
var 
  CNode: TClassDeclNode; 
  Func: TFunctionNode;
begin
  if IsRecord then Eat(ttRecord) else Eat(ttClass);
  CNode := TClassDeclNode.Create(FCurrToken.Str, IsRecord); 
  
  try // <-- TAMBAHAN PROTEKSI
    Eat(ttId);
    
    if (not IsRecord) and (FCurrToken.Typ = ttLParen) then 
    begin
      Eat(ttLParen);
      if FCurrToken.Typ <> ttRParen then 
      begin
        CNode.Parents.Add(FCurrToken.Str);
        Eat(ttId);
        while FCurrToken.Typ = ttComma do 
        begin
          Eat(ttComma);
          CNode.Parents.Add(FCurrToken.Str);
          Eat(ttId);
        end;
      end;
      Eat(ttRParen);
    end;

    while (FCurrToken.Typ <> ttEnd) and (FCurrToken.Typ <> ttEOF) do 
    begin
      if (FCurrToken.Typ = ttVar) or (IsRecord and (FCurrToken.Typ = ttId)) then 
      begin
        if FCurrToken.Typ = ttVar then Eat(ttVar);
        
        while FCurrToken.Typ = ttId do
        begin
          repeat
            CNode.Fields.Add(FCurrToken.Str);
            Eat(ttId);
            if FCurrToken.Typ = ttComma then Eat(ttComma) else Break;
          until False;
          Eat(ttSemiColon);
        end;
      end else 
      if FCurrToken.Typ = ttFunction then 
      begin
        if IsRecord then 
          errMSG.callerror(43, 'TParser.ParseStructDecl',FCurrToken.Line, FCurrToken.Col);
          
        Eat(ttFunction);
        Func := ParseFunctionDecl(True); 
        CNode.Methods.Add(Func);
        if FCurrToken.Typ = ttSemiColon then Eat(ttSemiColon);
      end else 
      begin
        errMSG.callerror(25, 'TParser.ParseStructDecl',FCurrToken.Line, FCurrToken.Col); 
        Break;
      end;
    end;

    Eat(ttEnd); 
    if FCurrToken.Typ = ttSemiColon then Eat(ttSemiColon);
    Result := CNode;
  except
    CNode.Free; // <-- PEMBERSIHAN NODE JIKA TERJADI SYNTAX ERROR
    raise;
  end;
end;

function TParser.ParseFStringContent(const AStr: string): TNode;
var
  i: Integer;
  TextPart, ExprPart: string;
  BaseNode, ExprNode: TNode;
  SubLex: TLexer;
  SubPars: TParser;
  BraceCount: Integer; 
  InString: Boolean; 
  QuoteChar: Char;   
   
  procedure AppendNode(ANode: TNode);
  begin
    if BaseNode = nil then BaseNode := ANode
    else BaseNode := TBinaryOpNode.Create(BaseNode,opAdd, ANode);
  end;
  
begin
  BaseNode := nil;
  TextPart := '';
  i := 1;

  try
      while i <= Length(AStr) do
      begin
        if AStr[i] = '{' then
        begin
          if (i < Length(AStr)) and (AStr[i+1] = '{') then
          begin
            TextPart := TextPart + '{';
            Inc(i, 2); 
            Continue;
          end;

          if TextPart <> '' then
          begin
            AppendNode(TLiteralNode.Create(TValue.CreateStr(TextPart)));
            TextPart := '';
          end;
          
          Inc(i);
          ExprPart := ''; 
          BraceCount := 1; 
          InString := False;
          QuoteChar := #0;
           
          while (i <= Length(AStr)) and (BraceCount > 0) do
          begin
            if not InString and ((AStr[i] = '''') or (AStr[i] = '"')) then
            begin
              InString := True;
              QuoteChar := AStr[i];
            end else 
            if InString and (AStr[i] = QuoteChar) and (AStr[i-1] <> '\') then
            begin
              InString := False;
            end;

            if not InString then
            begin
              if AStr[i] = '{' then Inc(BraceCount)
              else if AStr[i] = '}' then Dec(BraceCount);
            end;

            if BraceCount > 0 then
            begin
              ExprPart := ExprPart + AStr[i];
            end;
            
            Inc(i); 
          end;
    
          // PERBAIKAN: Validasi kebocoran penutupan F-String
          if BraceCount > 0 then
          begin
             errMSG.callerror(28, 'ParseFString: Kehilangan penutup kurung kurawal "}"', 0, 0);
             Break;
          end;
    
          if ExprPart <> '' then
          begin
            SubLex := TLexer.Create(ExprPart);
            try
              SubPars := TParser.Create(SubLex);
              try
                ExprNode := SubPars.ParseExpression;
                try 
                  if SubPars.FCurrToken.Typ <> ttEOF then
                  begin
                    errMSG.callerror(25, 'Syntax Error: Ekspresi di dalam F-String mengandung karakter tidak valid', SubPars.FCurrToken.Line, SubPars.FCurrToken.Col);
                    // FIX: Jangan merangkai node cacat ke dalam BaseNode. Buang ekspresi.
                    if Assigned(ExprNode) then ExprNode.Free;
                    Continue; 
                  end;
                  
                  if Assigned(ExprNode) then AppendNode(ExprNode);
                except
                  if Assigned(ExprNode) then ExprNode.Free; 
                  raise;
                end;
              finally
                SubPars.Free;
              end;
            finally
              SubLex.Free;
            end;
          end;

          // ---  KRUSIAL: Lanjutkan iterasi loop utama tanpa mengeksekusi Inc(i)
          // yang ada di bawah blok else, karena nilai 'i' saat ini sudah
          // berada tepat pada karakter SETELAH kurung tutup '}'.
          Continue; 
          // --------------------------------------------------------------------------
        end else
        begin
          TextPart := TextPart + AStr[i];
        end;
        Inc(i);
      end;
    
      if TextPart <> '' then AppendNode(TLiteralNode.Create(TValue.CreateStr(TextPart)));
      if BaseNode = nil then BaseNode := TLiteralNode.Create(TValue.CreateStr(''));
    
      Result := BaseNode;
  except
    on E: Exception do 
    begin
      if Assigned(BaseNode) then BaseNode.Free; 
      raise; 
    end;
  end;  
end;

///////VIRTUAL MECHINE/////
//=======================//
constructor TChunk.Create;
begin
  CodeCount := 0;
  SetLength(Code, 0);
  SetLength(Lines, 0); 
  SetLength(Cols, 0);  
  SetLength(FInlineCaches, 0); // <-- PERBAIKAN: Mutlak diperlukan untuk mencegah AV
  CurrentLine := 1; 
  CurrentCol := 1;
  Constants := TValueListBase.Create(True); 
  VarNames := TStringList.Create;
  LocalNames := TStringList.Create; 

  FConstLookup := TConstLookupMap.Create;
  FConstLookup.Sorted := True;
 end;

destructor TChunk.Destroy;
begin
  // ✅ FIX P1.8: Tunggu hingga tidak ada user aktif (dengan timeout)
  if InterlockedCompareExchange(FActiveUses, 0, 0) > 0 then
  begin
    // Chunk masih di-share — tunggu atau tandai untuk GC
    // (dalam produksi, ini seharusnya tidak terjadi)
  end;
  
  Constants.Free;
  VarNames.Free;
  LocalNames.Free;
  FConstLookup.Free;
  inherited;
end;

function TChunk.AddInstruction(Op: TVMOpCode; Operand: Integer = 0; Operand2: Integer = 0): Integer;
var
  CurrentLen, NewCapacity: Integer;
begin
  CurrentLen := Length(Code);
  if CodeCount >= CurrentLen then 
  begin
    if CurrentLen = 0 then NewCapacity := 64
    else NewCapacity := CurrentLen * 2;
      
    SetLength(Code, NewCapacity);
    SetLength(Lines, NewCapacity); 
    SetLength(Cols, NewCapacity); 
    SetLength(FInlineCaches, NewCapacity); // <-- PERBAIKAN: Sinkronisasi ukuran memori IC
  end;
  
  Code[CodeCount].OpCode      := Op;
  Code[CodeCount].Operand     := Operand;
  Code[CodeCount].Operand2    := Operand2; 
  Code[CodeCount].Operand3    := 0;      // ✨ PATCH D: reset Operand
  Code[CodeCount].CacheIdx    := -1; 
  Code[CodeCount].CacheTypeDef:= nil;
  Code[CodeCount].GlobalCache := nil;   // ✨ PHASE 2
  Code[CodeCount].TypeFeedback:= 0;   // ✨ PHASE 5
  Code[CodeCount].HitCount    := 0;        // ✨ PHASE 5  
  Lines[CodeCount] := CurrentLine; 
  Cols[CodeCount]  := CurrentCol;  

  Result := CodeCount; 
  Inc(CodeCount);
end;

function TChunk.GetIC(IP: Integer): PInlineCache;
begin
  if (IP < 0) or (IP >= Length(FInlineCaches)) then
    Exit(nil);
  Result := @FInlineCaches[IP];
end;

function TChunk.AddConstant(Val: TValue): Integer;
var 
  LookupKey: string;
  FoundIndex: Integer;
begin
  // ✅ FIX P0.5: Type-safe lookup — tidak pakai TObject(PtrInt) trick
  if Val.DataType in [dtString, dtNumeric, dtBoolean] then
  begin
    case Val.DataType of
      dtString:  LookupKey := 'S:' + Val.StrVal;
      dtNumeric: LookupKey := 'N:' + FloatToStr(Val.NumVal);
      dtBoolean: if Val.BoolVal then LookupKey := 'B:T' else LookupKey := 'B:F';
    end;

    // TFPGMap.IndexOf via binary search — returns -1 jika tidak ada
    FoundIndex := FConstLookup.IndexOf(LookupKey);
    if FoundIndex >= 0 then
    begin
      Val.Free;
      Exit(FConstLookup.Data[FoundIndex]);   // ← Return Integer langsung
    end;

    Result := Constants.Add(Val);
    FConstLookup.Add(LookupKey, Result);
    Exit;
  end;
  
  Result := Constants.Add(Val); 
end;

function TChunk.AddVarName(const Name: string): Integer;
begin
  // Hindari duplikasi nama variabel di memori (Optimasi ukuran Chunk)
  Result := VarNames.IndexOf(Name);
  if Result = -1 then
    Result := VarNames.Add(Name);
end;

procedure TChunk.SaveToStream(S: TStream; Obfuscate: Boolean = False);
var 
  i, j, m: Integer; 
  Val: TValue; 
  B: Byte; 
  Func: TVMFunction;
  CleanInstr: TInstruction;
  EncStr: string;   // ✨ PHASE 5: untuk string encryption
begin
  S.WriteBuffer(CodeCount, SizeOf(Integer));
  if CodeCount > 0 then
  begin
    for i := 0 to CodeCount - 1 do
    begin
      CleanInstr := Code[i];
      CleanInstr.CacheIdx     := -1;
      CleanInstr.CacheTypeDef := nil; 
      CleanInstr.GlobalCache  := nil;
      // ✨ PHASE 5: reset JIT feedback saat save
      CleanInstr.TypeFeedback := 0;
      CleanInstr.HitCount     := 0;
      S.WriteBuffer(CleanInstr, SizeOf(TInstruction));
    end;
    
    S.WriteBuffer(Lines[0], CodeCount * SizeOf(Integer)); 
    S.WriteBuffer(Cols[0], CodeCount * SizeOf(Integer)); 
  end;

  i := VarNames.Count;
  S.WriteBuffer(i, SizeOf(Integer));
  for i := 0 to VarNames.Count - 1 do WriteBinaryString(S, VarNames[i]);

  i := LocalNames.Count;
  S.WriteBuffer(i, SizeOf(Integer));
  for i := 0 to LocalNames.Count - 1 do WriteBinaryString(S, LocalNames[i]);

  i := Constants.Count;
  S.WriteBuffer(i, SizeOf(Integer));
  
  for i := 0 to Constants.Count - 1 do
  begin
    Val := Constants[i];
    
    if not (Val.DataType in [dtNumeric, dtString, dtBoolean, dtNull, dtFunction, dtClassDef]) then
       raise Exception.Create('Fatal: Terdapat konstanta objek dinamis yang tak dapat diserialisasi ke Bytecode!');

    B := Byte(Val.DataType);
    S.WriteBuffer(B, SizeOf(Byte)); 

    case Val.DataType of
      dtNumeric: S.WriteBuffer(Val.NumVal, SizeOf(Double));
      dtString:
        begin
          if Obfuscate then
          begin
            // ✅ FASE 0.4: rename dari AES_EncryptString
            EncStr := ObfuscateString(Val.StrVal, BytecodeObfuscationKey);          
            WriteBinaryString(S, EncStr);
          end
          else
            WriteBinaryString(S, Val.StrVal);
        end;
      dtBoolean: S.WriteBuffer(Val.BoolVal, SizeOf(Boolean));
      dtNull:    ; 
      dtFunction:
        begin
          Func := Val.FuncVal;
          WriteBinaryString(S, Func.Name);
          j := Length(Func.Params);
          S.WriteBuffer(j, SizeOf(Integer));
          for j := 0 to High(Func.Params) do 
          begin
            WriteBinaryString(S, Func.Params[j].Name);
            B := Byte(Assigned(Func.Params[j].DefaultChunk));
            S.WriteBuffer(B, SizeOf(Byte));
            if B = 1 then Func.Params[j].DefaultChunk.SaveToStream(S, Obfuscate);
          end;
          Func.Chunk.SaveToStream(S, Obfuscate); 
        end;
      dtClassDef:
        begin
          WriteBinaryString(S, Val.ClassDefVal.Name);
          B := Byte(Val.ClassDefVal.Kind);
          S.WriteBuffer(B, SizeOf(Byte));
          j := Val.ClassDefVal.Fields.Count;
          S.WriteBuffer(j, SizeOf(Integer));
          for j := 0 to Val.ClassDefVal.Fields.Count - 1 do WriteBinaryString(S, Val.ClassDefVal.Fields[j]);
          
          j := Val.ClassDefVal.Methods.Count;
          S.WriteBuffer(j, SizeOf(Integer));
          for j := 0 to Val.ClassDefVal.Methods.Count - 1 do
          begin
            WriteBinaryString(S, Val.ClassDefVal.Methods.Keys[j]);
            Func := Val.ClassDefVal.Methods.Data[j];
            WriteBinaryString(S, Func.Name);
            m := Length(Func.Params);
            S.WriteBuffer(m, SizeOf(Integer));
            for m := 0 to High(Func.Params) do 
            begin
              WriteBinaryString(S, Func.Params[m].Name);
              B := Byte(Assigned(Func.Params[m].DefaultChunk));
              S.WriteBuffer(B, SizeOf(Byte));
              if B = 1 then Func.Params[m].DefaultChunk.SaveToStream(S, Obfuscate);
            end;
            Func.Chunk.SaveToStream(S, Obfuscate); 
          end;
        end;
    end;
  end;
end;

procedure TChunk.LoadFromStream(S: TStream; IsObfuscated: Boolean = False);
var
  i, j, m, Count: Integer;
  B: Byte; Val: TValue; 
  Num: Double; Str, MethName: string; 
  Bool: Boolean;
  Func: TVMFunction; 
  Def: TTypeDefinition;
  EncStr: string;   // ✨ PHASE 5: untuk decrypt
  
  procedure LoadFunctionParams(AFunc: TVMFunction);
  var 
    PIdx, PCount: Integer; 
    B: Byte;
  begin
    S.ReadBuffer(PCount, SizeOf(Integer));
    
    if (PCount < 0) or (PCount > 100000) then 
    begin
      errMSG.callerror(72, 'LoadFromStream (Korupsi Jumlah Parameter)', errMSG.xrow, errMSG.xcol); 
      raise Exception.Create('Fatal: Stream Corrupted');
    end;

    if Int64(PCount) > (S.Size - S.Position) then
    begin
      errMSG.callerror(119, 'LoadFromStream (Bytecode EOF prematur)', errMSG.xrow, errMSG.xcol);
      raise Exception.Create('Fatal: Stream EOF');
    end;
 
    SetLength(AFunc.Params, PCount);
    for PIdx := 0 to PCount - 1 do 
    begin
      AFunc.Params[PIdx].Name := ReadBinaryString(S);
      S.ReadBuffer(B, SizeOf(Byte));
      
      if B = 1 then
      begin
        AFunc.Params[PIdx].DefaultChunk := TChunk.Create;
        AFunc.Params[PIdx].DefaultChunk.LoadFromStream(S, IsObfuscated);   // ✨ propagate
      end else 
        AFunc.Params[PIdx].DefaultChunk := nil;
    end;
  end;
    
begin
  CodeCount := 0; 
  SetLength(Code, 0); 
  SetLength(Lines, 0);
  SetLength(Cols, 0);
  SetLength(FInlineCaches, 0); 

  Constants.Clear; VarNames.Clear; LocalNames.Clear; 
  
  S.ReadBuffer(CodeCount, SizeOf(Integer));
  if (CodeCount < 0) or (CodeCount > 10000000) then 
  begin
    errMSG.callerror(69,'TChunk.LoadFromStream',errMSG.xrow,errMSG.xcol); 
    raise Exception.Create('Fatal: Stream Corrupted');
  end;
 
  if Int64(CodeCount) * SizeOf(TInstruction) > (S.Size - S.Position) then
  begin
    errMSG.callerror(119,'TChunk.LoadFromStream',errMSG.xrow,errMSG.xcol); 
    raise Exception.Create('Fatal: Stream EOF');
  end;

  if CodeCount > 0 then
  begin
    SetLength(Code, CodeCount);
    SetLength(Lines, CodeCount); 
    SetLength(Cols, CodeCount); 
    SetLength(FInlineCaches, CodeCount); 
    
    S.ReadBuffer(Code[0], CodeCount * SizeOf(TInstruction));
    S.ReadBuffer(Lines[0], CodeCount * SizeOf(Integer)); 
    S.ReadBuffer(Cols[0], CodeCount * SizeOf(Integer));

    for i := 0 to CodeCount - 1 do
    begin
      Code[i].CacheIdx     := -1;
      Code[i].CacheTypeDef := nil;
      Code[i].GlobalCache  := nil;   // ✨ PHASE 2
      Code[i].TypeFeedback := 0;     // ✨ PHASE 5
      Code[i].HitCount     := 0;     // ✨ PHASE 5
    end;
  end;

  S.ReadBuffer(Count, SizeOf(Integer)); 
  if (Count < 0) or (Count > 5000000) then 
  begin
    errMSG.callerror(70, 'TChunk.LoadFromStream (Korupsi Jumlah Variabel)', errMSG.xrow, errMSG.xcol); 
    raise Exception.Create('Fatal: Stream Corrupted');
  end;

  if Count > 0 then
    for i := 0 to Count - 1 do VarNames.Add(ReadBinaryString(S)); 

  S.ReadBuffer(Count, SizeOf(Integer));
  if (Count < 0) or (Count > 5000000) then
  begin
    errMSG.callerror(71, 'TChunk.LoadFromStream (Korupsi Jumlah LocalNames)', errMSG.xrow, errMSG.xcol);
    raise Exception.Create('Fatal: Stream Corrupted');
  end;

  if Count > 0 then
    for i := 0 to Count - 1 do LocalNames.Add(ReadBinaryString(S));

  S.ReadBuffer(Count, SizeOf(Integer));
  if (Count < 0) or (Count > 5000000) then 
  begin
    errMSG.callerror(70,'TChunk.LoadFromStream',errMSG.xrow,errMSG.xcol); 
    raise Exception.Create('Fatal: Stream Corrupted');
  end;
    
  if Int64(Count) > (S.Size - S.Position) then
  begin
    errMSG.callerror(119,'TChunk.LoadFromStream',errMSG.xrow,errMSG.xcol); 
    raise Exception.Create('Fatal: Stream Corrupted');
  end;

  for i := 0 to Count - 1 do
  begin
    S.ReadBuffer(B, SizeOf(Byte));
    case TDataType(B) of
      dtNumeric: begin S.ReadBuffer(Num, SizeOf(Double)); Val := TValue.CreateNum(Num); end;
      dtString:
        begin
          if IsObfuscated then
          begin
            EncStr := ReadBinaryString(S);
            // ✅ FASE 0.4: rename dari AES_DecryptString
            Val := TValue.CreateStr(DeobfuscateString(EncStr, BytecodeObfuscationKey));          
          end
          else
          begin
            Str := ReadBinaryString(S);
            Val := TValue.CreateStr(Str);
          end;
        end;
      dtBoolean: begin S.ReadBuffer(Bool, SizeOf(Boolean)); Val := TValue.CreateBool(Bool); end;
      dtNull:    Val := TValue.CreateNull;
      dtFunction:
        begin
          Func := TVMFunction.Create; 
          try
            Func.Name := ReadBinaryString(S);
            LoadFunctionParams(Func);
            Func.Chunk := TChunk.Create; 
            Func.Chunk.LoadFromStream(S, IsObfuscated);   // ✨ propagate
            Val := TValue.CreateFunc(Func);
          finally
            Func.Release; 
          end;
        end;
      dtClassDef:
        begin
          Str := ReadBinaryString(S);
          S.ReadBuffer(B, SizeOf(Byte));
          Def := TTypeDefinition.Create(Str, TTypeKind(B));

          try
            S.ReadBuffer(j, SizeOf(Integer));
            if (j < 0) or (j > 100000) then 
            begin 
              errMSG.callerror(73,'TChunk.LoadFromStream',errMSG.xrow,errMSG.xcol); 
              raise Exception.Create('Fatal: Stream Corrupted');
            end;
            if Int64(j) * 4 > (S.Size - S.Position) then 
            begin 
              errMSG.callerror(119,'TChunk.LoadFromStream',errMSG.xrow,errMSG.xcol);
              raise Exception.Create('Fatal: Stream Corrupted');
            end;
               
            for m := 0 to j - 1 do Def.Fields.Add(ReadBinaryString(S));

            S.ReadBuffer(j, SizeOf(Integer));
            if (j < 0) or (j > 100000) then 
            begin
              errMSG.callerror(74,'TChunk.LoadFromStream',errMSG.xrow,errMSG.xcol); 
              raise Exception.Create('Fatal: Stream Corrupted');
            end;
            
            for m := 0 to j - 1 do
            begin
              MethName := ReadBinaryString(S);
              Func := TVMFunction.Create; 
              try
                Func.Name := ReadBinaryString(S);
                LoadFunctionParams(Func);
                Func.Chunk := TChunk.Create; 
                Func.Chunk.LoadFromStream(S, IsObfuscated);   // ✨ propagate
                
                Def.Methods.Add(MethName, Func);
                Func.Retain; 
              finally
                Func.Release; 
              end;
            end;
            Val := TValue.CreateClassDef(Def);
          finally
            Def.Release; 
          end;
        end;
      else
      begin
        errMSG.callerror(76,'TChunk.LoadFromStream',errMSG.xrow,errMSG.xcol); 
        raise Exception.Create('Fatal: Stream Corrupted');
      end;
    end;
    Constants.Add(Val);
  end;
end;

procedure TChunk.SaveToFile(const FileName: string; Obfuscate: Boolean = False);
var 
  FS: TFileStream;
  Header: record
    Magic: array[0..3] of AnsiChar;
    Version: Integer;
    Flags: Cardinal;
    Timestamp: QWord;
    SourceHash: Cardinal;
  end;
  SourceHashVal: Cardinal;
  i: Integer;
begin
  SourceHashVal := 2166136261;
  if SourceFile <> '' then
    for i := 1 to Length(SourceFile) do
      SourceHashVal := (SourceHashVal xor Cardinal(Ord(SourceFile[i]))) * Cardinal(16777619);
  
  FS := TFileStream.Create(FileName, fmCreate);
  try
    Move(PSCK_MAGIC, Header.Magic, SizeOf(PSCK_MAGIC));
    Header.Version := PSCK_VERSION_CURRENT;
    
    // ✨ PHASE 5: set flag obfuscate
    if Obfuscate then
      Header.Flags := PSCK_FLAG_OBFUSCATED
    else
      Header.Flags := 0;
      
    Header.Timestamp := GetTickCount64;
    Header.SourceHash := SourceHashVal;
    
    FS.WriteBuffer(Header, SizeOf(Header));
    SaveToStream(FS, Obfuscate);   // ✨ pass parameter
  finally 
    FS.Free; 
  end;
end;

procedure TChunk.LoadFromFile(const FileName: string);
var
  FS: TFileStream; 
  First4: array[0..3] of AnsiChar;
  Vers: Integer;
  Flags: Cardinal;
  Timestamp: QWord;
  SourceHash: Cardinal;
  OldMagicLen, OldVers: Integer;
  IsLegacy: Boolean;
  IsObfuscated: Boolean;   // ✨ PHASE 5
begin
  FS := TFileStream.Create(FileName, fmOpenRead or fmShareDenyWrite);
  try
    FS.ReadBuffer(First4, 4);
    
    IsLegacy := False;
    IsObfuscated := False;
    OldMagicLen := PLongInt(@First4)^;
    
    if OldMagicLen = 4 then
    begin
      // Legacy v1: length-prefixed "PSCK"
      FS.Position := 0;
      if ReadBinaryString(FS) = 'PSCK' then
      begin
        FS.ReadBuffer(OldVers, SizeOf(Integer));
        if OldVers = 1 then
          IsLegacy := True
        else
          raise EScriptFatalError.CreateFmt('Bytecode version %d tidak didukung', [OldVers]);
      end;
    end;
    
    if not IsLegacy then
    begin
      // v2/v3: raw magic
      FS.Position := 0;
      FS.ReadBuffer(First4, 4);
      if string(First4) <> 'PSCK' then
        raise EScriptFatalError.Create('Fatal: Invalid Magic Header (bukan file PSCK)');
      
      FS.ReadBuffer(Vers, SizeOf(Integer));
      if (Vers < PSCK_VERSION_MIN_SUPPORTED) or (Vers > PSCK_VERSION_CURRENT) then
        raise EScriptFatalError.CreateFmt(
          'Bytecode version %d tidak didukung (support: %d..%d)',
          [Vers, PSCK_VERSION_MIN_SUPPORTED, PSCK_VERSION_CURRENT]);
      
      FS.ReadBuffer(Flags, SizeOf(Cardinal));
      FS.ReadBuffer(Timestamp, SizeOf(QWord));
      FS.ReadBuffer(SourceHash, SizeOf(Cardinal));
      
      // ✨ PHASE 5: baca flag obfuscate
      IsObfuscated := (Flags and PSCK_FLAG_OBFUSCATED) <> 0;
    end
    else
    begin
      // Legacy: skip header (length + "PSCK" + version)
      FS.Position := 4 + 4 + SizeOf(Integer);
    end;
    
    LoadFromStream(FS, IsObfuscated);   // ✨ pass parameter
  finally 
    FS.Free; 
  end;
end;

procedure TChunk.OptimizeBytecode;
var
  i, TargetIP, NextIP, JumpDepth, WriteIdx: Integer;
  OldToNew: array of Integer;
  NewCode: array of TInstruction;
  NewLines, NewCols: array of Integer;
  NewCaches: array of TInlineCache;
  IsDead, IsJumpTarget: array of Boolean;
  ValA, ValB, ResVal: TValue;
  MathOp, RelOp, Changed: Boolean;
  j: Integer;
begin
  if CodeCount = 0 then Exit;

  SetLength(OldToNew, CodeCount + 1);
  SetLength(IsDead, CodeCount);
  SetLength(IsJumpTarget, CodeCount);
  
  try
    repeat
      Changed := False;
      
      // ==========================================
      // 1: Operasi Memori Super-Cepat (Pembersihan Menganggur)
      // ==========================================
      if CodeCount > 0 then
      begin
        FillChar(IsDead[0], CodeCount * SizeOf(Boolean), 0);
        FillChar(IsJumpTarget[0], CodeCount * SizeOf(Boolean), 0);
      end;

      // 2. Pre-calculate Jump Targets (PERBAIKAN: Abaikan instruksi yang sudah dead)
      for i := 0 to CodeCount - 1 do
      begin
        if not IsDead[i] then
        begin
          if Code[i].OpCode in [opcJump, opcJumpIfFalse, opcTryBegin] then
          begin
            TargetIP := i + 1 + Code[i].Operand;
            if (TargetIP >= 0) and (TargetIP <= CodeCount) then
            begin
              if TargetIP < CodeCount then
                IsJumpTarget[TargetIP] := True;
            end;
          end
          else if (Code[i].OpCode = opcForLoopCond) or 
                  (Code[i].OpCode = opcForLoopCondDown) then
          begin
            // ✅ FIX BUG-A + TAHAP C: keduanya pakai Operand3 sebagai jump offset
            TargetIP := i + 1 + Code[i].Operand3;
            if (TargetIP >= 0) and (TargetIP <= CodeCount) then
            begin
              if TargetIP < CodeCount then
                IsJumpTarget[TargetIP] := True;
            end;
          end;
        end;
      end;

      // ==========================================
      // 3: Batas Iterasi Mencakup Seluruh Baris Bytecode
      // ==========================================
      i := 0;
      while i < CodeCount do 
      begin
        if IsDead[i] then 
        begin
          Inc(i); Continue;
        end;

        // Trik 1: Useless Jump
        if (Code[i].OpCode = opcJump) and (Code[i].Operand = 0) then
        begin
           IsDead[i] := True;
           Changed := True;
           Inc(i); Continue;
        end;

        // Trik 2: Jump to Return/Halt 
        if Code[i].OpCode = opcJump then
        begin
           TargetIP := i + 1 + Code[i].Operand;
           if (TargetIP >= 0) and (TargetIP < CodeCount) and not IsDead[TargetIP] then
           begin
             if Code[TargetIP].OpCode = opcReturn then
             begin
               Code[i].OpCode := opcReturn;
               Code[i].Operand := 0;
               Changed := True;
             end else 
             if Code[TargetIP].OpCode = opcHalt then
             begin
               Code[i].OpCode := opcHalt;
               Code[i].Operand := 0;
               Changed := True;
             end;
           end;
        end;

        // Trik 3: Load -> Pop
        if ((Code[i].OpCode = opcGetLocal)  or (Code[i].OpCode = opcGetGlobal) or
            (Code[i].OpCode = opcConstant) or (Code[i].OpCode = opcNull) or
            (Code[i].OpCode = opcTrue)     or (Code[i].OpCode = opcFalse)) and
           (i + 1 < CodeCount) and (Code[i+1].OpCode = opcPop) then
        begin
          if not IsJumpTarget[i+1] then
          begin
            IsDead[i] := True;
            IsDead[i+1] := True;
            Changed := True;
            Inc(i, 2); Continue;
          end;
        end;

        // Trik 4: Unary Constant Folding
        if (Code[i].OpCode = opcConstant) and (i + 1 < CodeCount) and 
           (Code[i+1].OpCode in [opcNot, opcNegate]) then
        begin
           if not IsJumpTarget[i+1] then
           begin
              ValA := Constants[Code[i].Operand];
              ResVal := nil;
              try
                if (Code[i+1].OpCode = opcNot) then
                  ResVal := TValue.CreateBool(not ValA.IsTrue)
                else if (Code[i+1].OpCode = opcNegate) and (ValA.DataType = dtNumeric) then
                  ResVal := TValue.CreateNum(-ValA.NumVal);
                  
                if Assigned(ResVal) then
                begin
                   IsDead[i] := True;
                   Code[i+1].OpCode := opcConstant;
                   Code[i+1].Operand := AddConstant(ResVal);
                   Changed := True;
                   Inc(i, 2); Continue;
                end;
              except
              end;
           end;
        end;

        // Trik 5: Dup -> Set -> Pop
        if (Code[i].OpCode = opcDup) and (i + 2 < CodeCount) and
           ((Code[i+1].OpCode = opcSetLocal) or (Code[i+1].OpCode = opcSetGlobal)) and
           (Code[i+2].OpCode = opcPop) then
        begin
          if not IsJumpTarget[i+1] and not IsJumpTarget[i+2] then 
          begin
            IsDead[i] := True;   
            IsDead[i+2] := True; 
            Changed := True;
            Inc(i, 3); Continue;
          end;
        end;

        if (Code[i].OpCode = opcGetLocal) and (i + 3 < CodeCount) then
        begin
          if not IsJumpTarget[i+1] and not IsJumpTarget[i+2] and not IsJumpTarget[i+3] then
          begin
            // Pastikan GetLocal/SetLocal sama index
            if (Code[i+1].OpCode = opcConstant) and 
               (Code[i+2].OpCode in [opcAdd, opcSub]) and
               (Code[i+3].OpCode = opcSetLocal) and
               (Code[i+3].Operand = Code[i].Operand) then
            begin
              // Cek constant == 1
              ValA := Constants[Code[i+1].Operand];
              if (ValA.DataType = dtNumeric) and 
                 (Abs(ValA.NumVal - 1.0) < 1E-12) then
              begin
                // Kolaps 4 instruksi → 1
                IsDead[i]   := True;
                IsDead[i+1] := True;
                IsDead[i+2] := True;
                
                if Code[i+2].OpCode = opcAdd then
                  Code[i+3].OpCode := opcIncrLocal
                else
                  Code[i+3].OpCode := opcDecrLocal;
                
                Code[i+3].Operand  := Code[i].Operand;
                Code[i+3].Operand2 := 0;
                
                Changed := True;
                Inc(i, 4);
                Continue;
              end;
            end;
          end;
        end;
        
        // Trik 6: Binary Constant Folding
        if (Code[i].OpCode = opcConstant) and (i + 2 < CodeCount) and 
           (Code[i+1].OpCode = opcConstant) then
        begin
          if not IsJumpTarget[i+1] and not IsJumpTarget[i+2] then 
          begin
            MathOp := Code[i+2].OpCode in [opcAdd, opcSub, opcMul, opcDiv, opcMod];
            RelOp  := Code[i+2].OpCode in [opcEqual, opcNotEqual, opcLess, opcGreater, opcLessEq, opcGreaterEq];
            
            if MathOp or RelOp then
            begin
              ValA := Constants[Code[i].Operand];
              ValB := Constants[Code[i+1].Operand];
              ResVal := nil;
              
              try
                if MathOp and (ValA.DataType = dtNumeric) and (ValB.DataType = dtNumeric) then
                begin
                  case Code[i+2].OpCode of
                    opcAdd: ResVal := TValue.CreateNum(ValA.NumVal + ValB.NumVal);
                    opcSub: ResVal := TValue.CreateNum(ValA.NumVal - ValB.NumVal);
                    opcMul: ResVal := TValue.CreateNum(ValA.NumVal * ValB.NumVal);
                    opcDiv: if ValB.NumVal <> 0 then ResVal := TValue.CreateNum(ValA.NumVal / ValB.NumVal);
                    opcMod: if ValB.NumVal <> 0 then ResVal := TValue.CreateNum(ValA.NumVal - (ValB.NumVal * math.Floor(ValA.NumVal / ValB.NumVal)));
                  end;
                end else 
                if (Code[i+2].OpCode = opcAdd) and (ValA.DataType = dtString) and (ValB.DataType = dtString) then
                  ResVal := TValue.CreateStr(ValA.StrVal + ValB.StrVal)
                else if RelOp then
                begin
                  if (ValA.DataType = dtNumeric) and (ValB.DataType = dtNumeric) then
                  begin
                    case Code[i+2].OpCode of
                      opcEqual:     ResVal := TValue.CreateBool(ValA.NumVal = ValB.NumVal);
                      opcNotEqual:  ResVal := TValue.CreateBool(ValA.NumVal <> ValB.NumVal);
                      opcLess:      ResVal := TValue.CreateBool(ValA.NumVal < ValB.NumVal);
                      opcGreater:   ResVal := TValue.CreateBool(ValA.NumVal > ValB.NumVal);
                      opcLessEq:    ResVal := TValue.CreateBool(ValA.NumVal <= ValB.NumVal);
                      opcGreaterEq: ResVal := TValue.CreateBool(ValA.NumVal >= ValB.NumVal);
                    end;
                  end else 
                  if (ValA.DataType = dtString) and (ValB.DataType = dtString) then
                  begin
                    case Code[i+2].OpCode of
                      opcEqual:     ResVal := TValue.CreateBool(ValA.StrVal = ValB.StrVal);
                      opcNotEqual:  ResVal := TValue.CreateBool(ValA.StrVal <> ValB.StrVal);
                      opcLess:      ResVal := TValue.CreateBool(ValA.StrVal < ValB.StrVal);
                      opcGreater:   ResVal := TValue.CreateBool(ValA.StrVal > ValB.StrVal);
                      opcLessEq:    ResVal := TValue.CreateBool(ValA.StrVal <= ValB.StrVal);
                      opcGreaterEq: ResVal := TValue.CreateBool(ValA.StrVal >= ValB.StrVal);
                    end;
                  end;
                end;
                
                if Assigned(ResVal) then
                begin
                  IsDead[i] := True;
                  IsDead[i+1] := True;
                  Code[i+2].OpCode := opcConstant;
                  Code[i+2].Operand := AddConstant(ResVal); 
                  Changed := True;
                  Inc(i, 3); Continue;
                end;
              except
              end;
            end;
          end;
        end;
        Inc(i);
      end;
      
      // 4. Unreachable Code Elimination
      for i := 0 to CodeCount - 2 do
      begin
        if (not IsDead[i]) and ((Code[i].OpCode = opcReturn) or (Code[i].OpCode = opcHalt) or (Code[i].OpCode = opcJump)) then
        begin
          j := i + 1;
          while (j < CodeCount) and (not IsJumpTarget[j]) do 
          begin
            if not IsDead[j] then Changed := True;
            IsDead[j] := True;
            Inc(j);
          end;
        end;
      end;

      if Changed then
      begin
        // PERBAIKAN: Alokasikan array penampung hanya jika ada perubahan
        SetLength(OldToNew, CodeCount + 1);  // ✅ Alokasi hanya saat perlu
        
        SetLength(NewCode, CodeCount);
        SetLength(NewLines, CodeCount);
        SetLength(NewCols, CodeCount);
        SetLength(NewCaches, CodeCount); // <-- PERBAIKAN: Alokasi memori sinkron dengan instruksi

        WriteIdx := 0;
        for i := 0 to CodeCount - 1 do
        begin
          OldToNew[i] := WriteIdx; 
          if not IsDead[i] then
          begin
            NewCode[WriteIdx] := Code[i];
            NewLines[WriteIdx] := Lines[i];
            NewCols[WriteIdx] := Cols[i]; 
            NewCaches[WriteIdx] := FInlineCaches[i]; // <-- PERBAIKAN: Sinkronisasi pemindahan data cache
            Inc(WriteIdx);
          end;
        end;
        OldToNew[CodeCount] := WriteIdx;

        // 5. JUMP THREADING DENGAN OFFSET BARU
        for i := 0 to CodeCount - 1 do
        begin
          if not IsDead[i] then
          begin
            if Code[i].OpCode in [opcJump, opcJumpIfFalse, opcTryBegin] then
            begin
              // ... (biarkan logika lama, tetap remap Operand) ...
              TargetIP := i + 1 + Code[i].Operand;
              JumpDepth := 0;
        
              while (TargetIP >= 0) and (TargetIP < CodeCount) and
                    (Code[TargetIP].OpCode = opcJump) and (not IsDead[TargetIP]) do
              begin
                if TargetIP = i then Break;
                Inc(JumpDepth);
                if JumpDepth > 10 then Break;
                NextIP := TargetIP + 1 + Code[TargetIP].Operand;
                if NextIP = TargetIP then Break;
                TargetIP := NextIP;
              end;
        
              if TargetIP > CodeCount then TargetIP := CodeCount;
              if TargetIP < 0 then TargetIP := 0;
        
              NewCode[OldToNew[i]].Operand := OldToNew[TargetIP] - OldToNew[i] - 1;
            end
            else if (Code[i].OpCode = opcForLoopCond) or
                    (Code[i].OpCode = opcForLoopCondDown) then
            begin
              // ✅ TAHAP C: remap Operand3 (offset exit loop)
              TargetIP := i + 1 + Code[i].Operand3;
            
              if TargetIP > CodeCount then TargetIP := CodeCount;
              if TargetIP < 0 then TargetIP := 0;
            
              NewCode[OldToNew[i]].Operand3 := OldToNew[TargetIP] - OldToNew[i] - 1;
            end;
          end;
        end;

        // ==========================================
        // 6. Lanjutan: Bulk-Memory Salin Array (0-Overhead)
        // PERBAIKAN: Proteksi batas WriteIdx > 0
        // ==========================================
        CodeCount := WriteIdx;
        if CodeCount > 0 then
        begin
          Move(NewCode[0], Code[0], CodeCount * SizeOf(TInstruction));
          Move(NewLines[0], Lines[0], CodeCount * SizeOf(Integer));
          Move(NewCols[0], Cols[0], CodeCount * SizeOf(Integer));
          Move(NewCaches[0], FInlineCaches[0], CodeCount * SizeOf(TInlineCache)); // <-- PERBAIKAN: Timpa data fisik memori cache
        end;      
      end;
      
    until not Changed; 

  finally
  end;
end;

procedure TChunk.AcquireUse;
begin
  InterlockedIncrement(FActiveUses);
end;

procedure TChunk.ReleaseUse;
begin
  InterlockedDecrement(FActiveUses);
end;

function TChunk.IsInUse: Boolean;
begin
  Result := InterlockedCompareExchange(FActiveUses, 0, 0) > 0;
end;

constructor TCompiler.Create;
begin
  FChunk := TChunk.Create;
  FBreakJumps := TObjectList.Create(True); 
  FContinueJumps := TObjectList.Create(True);
  FLoopLocalCounts := TIntList.Create; 
  
  FLocalCount := 0;
  FScopeDepth := 0;
  
  FLoopLockDepths := TIntList.Create;
  FCompLockDepth := 0;
  
  FLoopTryDepths := TIntList.Create; 
  FTryDepth := 0;
  FCompileDepth := 0;
  
  FDeferredNodes := TObjectList.Create(True);
  FLoopScopeDepths := TIntList.Create;
  
  // LOGIKA DIPERBAIKI: Back-up compiler aktif sebelumnya agar tidak korup oleh sub-kompilasi
  FPrevCompiler := ActiveCompiler; 
  ActiveCompiler := Self; 
end;

destructor TCompiler.Destroy; 
begin
  // LOGIKA DIPERBAIKI: Pulihkan state ke compiler induk (bukan di-set ke nil secara membabi buta)
  if ActiveCompiler = Self then ActiveCompiler := FPrevCompiler;

  FLoopLocalCounts.Free; 
  FBreakJumps.Free;     
  FContinueJumps.Free;  
  if Assigned(FChunk) then FChunk.Free; 
  
  FLoopTryDepths.Free;
  FLoopLockDepths.Free;
  
  FDeferredNodes.Free;
  FLoopScopeDepths.Free;
  
  inherited;
end;

procedure TCompiler.CompileError(Code: Integer; const Msg: string; Node: TNode; IsStatement: Boolean);
begin
  errMSG.callerror(Code, Msg, Node.Line, Node.Col);
  
  // Penyeimbang Stack VM Otomatis saat Error
  if not IsStatement then
    FChunk.AddInstruction(opcNull); // Beri nilai ke parent expression agar tidak underflow
    
  raise ECompilerAbort.Create('Compile aborted'); // Keluar paksa dari seluruh rekursi kompilasi
end;

procedure TCompiler.BeginLoopTracking;
begin
  FLoopLocalCounts.Add(FLocalCount); 
  FLoopTryDepths.Add(FTryDepth);
  FLoopLockDepths.Add(FCompLockDepth); 
  FLoopScopeDepths.Add(FScopeDepth);
end;

procedure TCompiler.EndLoopTracking;
begin
  FLoopLocalCounts.Delete(FLoopLocalCounts.Count - 1); 
  FLoopTryDepths.Delete(FLoopTryDepths.Count - 1);
  FLoopLockDepths.Delete(FLoopLockDepths.Count - 1); 
  FLoopScopeDepths.Delete(FLoopScopeDepths.Count - 1);
end;

procedure TCompiler.BeginScope;
begin
  Inc(FScopeDepth);
  // Tambahkan layer stack untuk menampung statemen defer pada scope kedalaman ini (Tidak otomatis free Node AST)
  FDeferredNodes.Add(TObjectList.Create(False)); 
end;

procedure TCompiler.EndScope(KeepResult: Boolean = False);
var 
  PopCount, j: Integer;
  DefList: TObjectList;
begin
  // --- 1. EKSEKUSI DEFER (LIFO) SEBELUM SCOPE DIHANCURKAN ---
  if FDeferredNodes.Count > 0 then
  begin
    DefList := TObjectList(FDeferredNodes.Last);
    // Eksekusi dari yang terakhir dimasukkan (Last In First Out)
    for j := DefList.Count - 1 downto 0 do
    begin
      Compile(TNode(DefList[j]), True);
    end;
    FDeferredNodes.Delete(FDeferredNodes.Count - 1);
  end;

  // --- 2. PEMBERSIHAN LOKAL STACK (Kode Asli VM Anda) ---
  PopCount := 0;
  while (FLocalCount > 0) and (FLocals[FLocalCount - 1].Depth = FScopeDepth) do
  begin
    Dec(FLocalCount);
    Inc(PopCount);
  end;
  
  Dec(FScopeDepth);

  if PopCount > 0 then
  begin
    if KeepResult then
      FChunk.AddInstruction(opcPopLocalsKeepTop, PopCount)
    else
      FChunk.AddInstruction(opcPopLocals, PopCount); 
  end;
end;

procedure TCompiler.AddLocal(const Name: string; AIsConst: Boolean = False);
var
  i: Integer;
  Line, Col: Integer;
begin
  // PERBAIKAN: Gunakan posisi dari FChunk yang sudah di-set sebelum kompilasi
  Line := FChunk.CurrentLine;
  Col := FChunk.CurrentCol;
  
  // Cek double declaration di scope yang sama
  for i := FLocalCount - 1 downto 0 do
  begin
    if (FLocals[i].Name = Name) and (FLocals[i].Depth = FScopeDepth) then
    begin
      // Gunakan posisi yang sudah di-capture
      errMSG.callerror(9, 'Identifier "' + Name + '" sudah dideklarasikan sebelumnya', Line, Col);
      Exit;
    end;
  end;
  
  if FLocalCount >= STACK_MAX then
  begin
    errMSG.callerror(79,'TCompiler.AddLocal',FChunk.CurrentLine, FChunk.CurrentCol);
    Exit;
  end;
    
  FLocals[FLocalCount].Name := Name;
  FLocals[FLocalCount].Depth := FScopeDepth;
  FLocals[FLocalCount].IsConst := AIsConst;
  
  while FChunk.LocalNames.Count <= FLocalCount do
    FChunk.LocalNames.Add('');
    
  FChunk.LocalNames[FLocalCount] := Name;
  
  Inc(FLocalCount);
end;

function TCompiler.ResolveLocal(const Name: string): Integer;
var 
  i: Integer;
begin
  // Cari dari yang paling baru dimasukkan (Shadowing support)
  for i := FLocalCount - 1 downto 0 do
  begin
    if FLocals[i].Name = Name then Exit(i); // Kembalikan indeks array-nya
  end;
  Result := -1; // -1 Berarti ini bukan lokal, melainkan Variabel Global
end;

procedure TCompiler.PatchLoopJumps(ContinueTarget: Integer);
var
  i, idx: Integer;
  CurrentBreaks, CurrentContinues: TIntList;
begin
  CurrentBreaks := TIntList(FBreakJumps.Last);
  for i := 0 to CurrentBreaks.Count - 1 do
  begin
    idx := CurrentBreaks[i];
    FChunk.Code[idx].Operand := FChunk.CodeCount - idx - 1;
  end;

  CurrentContinues := TIntList(FContinueJumps.Last);
  for i := 0 to CurrentContinues.Count - 1 do
  begin
    idx := CurrentContinues[i];
    FChunk.Code[idx].Operand := ContinueTarget - idx - 1;
  end;

  FBreakJumps.Delete(FBreakJumps.Count - 1);
  FContinueJumps.Delete(FContinueJumps.Count - 1);
end;

function TCompiler.HasActiveDefers: Boolean;
var i: Integer;
begin
  Result := False;
  for i := 0 to FDeferredNodes.Count - 1 do
    if TObjectList(FDeferredNodes[i]).Count > 0 then Exit(True);
end;

function TCompiler.GenerateCompileTrace: string;
var
  i, StartIdx: Integer;
  N: TNode;
  Desc: string;
begin
  Result := '=== Compile-Time Stack Trace ===' + #10;
  if FCompileDepth <= 0 then Exit(Result + '  (Trace Kosong)' + #10);

  StartIdx := 0;
  // Proteksi Memori: Batasi maksimal 15 frame terakhir jika rekursi terlalu dalam
  if FCompileDepth > 15 then 
  begin
    StartIdx := FCompileDepth - 15;
    Result := Result + '  ... (' + IntToStr(StartIdx) + ' frame AST sebelumnya disembunyikan)' + #10;
  end;

  for i := FCompileDepth - 1 downto StartIdx do
  begin
    N := FNodeStack[i];
    Desc := 'Ekspresi / Node Umum';
    
    if N is TFunctionNode then Desc := 'Deklarasi Fungsi "' + TFunctionNode(N).Name + '"'
    else if N is TClassDeclNode then Desc := 'Deklarasi Class/Record "' + TClassDeclNode(N).sClassName + '"'
    else if N is TWhileNode then Desc := 'Blok While Loop'
    else if N is TForNode then Desc := 'Blok For Loop'
    else if N is TForEachNode then Desc := 'Blok For-In Loop'
    else if N is TIfNode then Desc := 'Blok If-Then-Else'
    else if N is TFunctionCallNode then Desc := 'Pemanggilan Fungsi'
    else if N is TMethodCallNode then Desc := 'Pemanggilan Method "' + TMethodCallNode(N).sMethodName + '"'
    else if N is TAssignmentNode then Desc := 'Assignment Variabel "' + TAssignmentNode(N).TargetName + '"'
    else if N is TBinaryOpNode then Desc := 'Operasi Matematika/Logika'
    else if N is TBlockNode then Desc := 'Blok Scope (Begin..End)'
    else if N is TReturnNode then Desc := 'Statement Return'
    else if N is TTryCatchNode then Desc := 'Blok Try-Catch-Finally'
    else if N is TDeferNode then Desc := 'Statement Defer'
    else if N is TYieldNode then Desc := 'Coroutine Yield'
    else if N is TLockNode then Desc := 'Blok Sinkronisasi (Lock)'
    else if N is TImportExprNode then Desc := 'Fase Impor Modul'
    else if N is TListComprehensionNode then Desc := 'Evaluasi List Comprehension';
    
    Result := Result + ' -> Memproses ' + Desc + ' (Baris ' + IntToStr(N.Line) + ')' + #10;
  end;
end;

function TCompiler.TryEmitSumArrayIndex(AssignNode: TAssignmentNode; 
  SumLocalIdx: Integer; out Emitted: Boolean): Boolean;
var
  BinOp: TBinaryOpNode;
  ArrAccess: TArrayAccessNode;
  LeftVar, ArrVar, IVar: TVariableNode;
  IdxArr, IdxI, InstIdx: Integer;
begin
  Emitted := False;
  Result := False;
  
  if SumLocalIdx = -1 then Exit;
  if not (AssignNode.Expr is TBinaryOpNode) then Exit;
  
  BinOp := TBinaryOpNode(AssignNode.Expr);
  if BinOp.Op <> opAdd then Exit;
  if not (BinOp.Left is TVariableNode) then Exit;
  
  LeftVar := TVariableNode(BinOp.Left);
  if LeftVar.VarName <> AssignNode.TargetName then Exit;
  if not (BinOp.Right is TArrayAccessNode) then Exit;
  
  ArrAccess := TArrayAccessNode(BinOp.Right);
  if not (ArrAccess.FTarget is TVariableNode) then Exit;
  if not (ArrAccess.FIndexExpr is TVariableNode) then Exit;
  
  ArrVar := TVariableNode(ArrAccess.FTarget);
  IVar := TVariableNode(ArrAccess.FIndexExpr);
  
  IdxArr := ResolveLocal(ArrVar.VarName);
  IdxI := ResolveLocal(IVar.VarName);
  
  if (IdxArr = -1) or (IdxI = -1) then Exit;
  
  // ✅ Emit superinstruction
  InstIdx := FChunk.AddInstruction(opcSumArrayIndex, SumLocalIdx, IdxArr);
  FChunk.Code[InstIdx].Operand3 := IdxI;
  
  Emitted := True;
  Result := True;
end;

function TCompiler.TryEmitAddLocalLocal(AssignNode: TAssignmentNode;
    TargetLocalIdx: Integer;out Emitted: Boolean): Boolean;
var
  BinOp: TBinaryOpNode;
  LeftVar, RightVar: TVariableNode;
  SrcLocalIdx, InstIdx, SubOp: Integer;
  OpMatch: Boolean;
  RightVarName: string;
begin
  Emitted := False;
  Result := False;
  
  if TargetLocalIdx = -1 then Exit;
  
  // ✅ Dua pattern yang didukung:
  //   Pattern 1: `x := x + y`  → Expr = TBinaryOpNode(x, opAdd, y)
  //   Pattern 2: `x += y`      → Expr = TVariableNode(y), OpAssign = '+'
  
  if AssignNode.Expr is TBinaryOpNode then
  begin
    BinOp := TBinaryOpNode(AssignNode.Expr);
    
    OpMatch := True;
    case BinOp.Op of
      opAdd: SubOp := 0;
      opSub: SubOp := 1;
      opMul: SubOp := 2;
      opDiv: SubOp := 3;
      opMod: SubOp := 4;
    else
      OpMatch := False;
      SubOp := 0;
    end;
    if not OpMatch then Exit;
    
    if not (BinOp.Left is TVariableNode) then Exit;
    LeftVar := TVariableNode(BinOp.Left);
    if LeftVar.VarName <> AssignNode.TargetName then Exit;
    
    if not (BinOp.Right is TVariableNode) then Exit;
    RightVar := TVariableNode(BinOp.Right);
    RightVarName := RightVar.VarName;
  end
  else if AssignNode.Expr is TVariableNode then
  begin
    // ✅ Pattern 2 (BARU): compound assignment `x += y` dengan y = variabel
    case AssignNode.OpAssign of
      '+': SubOp := 0;
      '-': SubOp := 1;
      '*': SubOp := 2;
      '/': SubOp := 3;
      '%': SubOp := 4;
    else
      Exit;
    end;
    
    RightVar := TVariableNode(AssignNode.Expr);
    RightVarName := RightVar.VarName;
  end
  else
    Exit;
  
  SrcLocalIdx := ResolveLocal(RightVarName);
  if SrcLocalIdx = -1 then Exit;
  
  InstIdx := FChunk.AddInstruction(opcAddLocalLocal, TargetLocalIdx, SrcLocalIdx);
  FChunk.Code[InstIdx].Operand3 := SubOp;
  
  Emitted := True;
  Result := True;
end;

function TCompiler.TryEmitIncrGlobal(AssignNode: TAssignmentNode;
    TargetLocalIdx: Integer; out Emitted: Boolean): Boolean;
var
  Lit: TLiteralNode;
  NegVal: TValue;
  ConstIdx: Integer;
begin
  Emitted := False;
  Result := False;
  
  // Hanya global — local sudah punya opcIncrLocal
  if TargetLocalIdx <> -1 then Exit;
  
  // OpAssign harus '+' atau '-'
  if (AssignNode.OpAssign <> '+') and (AssignNode.OpAssign <> '-') then Exit;
  
  // RHS harus literal numeric
  if not (AssignNode.Expr is TLiteralNode) then Exit;
  Lit := TLiteralNode(AssignNode.Expr);
  if Lit.Val.DataType <> dtNumeric then Exit;
  
  // Special case: +1 / -1
  if SameValue(Lit.Val.NumVal, 1.0, 1E-15) then
  begin
    if AssignNode.OpAssign = '+' then
      FChunk.AddInstruction(opcIncrGlobal, 
        FChunk.AddVarName(AssignNode.TargetName))
    else
      FChunk.AddInstruction(opcDecrGlobal, 
        FChunk.AddVarName(AssignNode.TargetName));
    Emitted := True;
    Result := True;
    Exit;
  end;
  
  // General case: += N / -= N
  if AssignNode.OpAssign = '+' then
  begin
    ConstIdx := FChunk.AddConstant(Lit.Val.Clone);
    FChunk.AddInstruction(opcAddGlobalConst,
      FChunk.AddVarName(AssignNode.TargetName), ConstIdx);
    Emitted := True;
    Result := True;
  end
  else if AssignNode.OpAssign = '-' then
  begin
    NegVal := TValue.CreateNum(-Lit.Val.NumVal);
    try
      ConstIdx := FChunk.AddConstant(NegVal);   // takes ownership
    except
      NegVal.Free;
      raise;
    end;
    FChunk.AddInstruction(opcAddGlobalConst,
      FChunk.AddVarName(AssignNode.TargetName), ConstIdx);
    Emitted := True;
    Result := True;
  end;
end;

// Satu instruksi menggantikan 4 (GetLocal + Constant + Add + SetLocal).
function TCompiler.TryEmitAddLocalConst(AssignNode: TAssignmentNode;
    TargetLocalIdx: Integer; out Emitted: Boolean): Boolean;
var
  Lit: TLiteralNode;
  Delta: Integer;//ConstIdx
begin
  Emitted := False;
  Result := False;
  
  // Hanya local
  if TargetLocalIdx = -1 then Exit;
  
  // OpAssign harus '+' atau '-'
  if (AssignNode.OpAssign <> '+') and (AssignNode.OpAssign <> '-') then Exit;
  
  // RHS harus literal numeric
  if not (AssignNode.Expr is TLiteralNode) then Exit;
  Lit := TLiteralNode(AssignNode.Expr);
  if Lit.Val.DataType <> dtNumeric then Exit;
  
  // Delta: +N untuk '+', -N untuk '-'
  if AssignNode.OpAssign = '+' then
    Delta := FChunk.AddConstant(TValue.CreateNum(Lit.Val.NumVal))
  else
    Delta := FChunk.AddConstant(TValue.CreateNum(-Lit.Val.NumVal));
  
  FChunk.AddInstruction(opcAddLocalConst, TargetLocalIdx, Delta);
  Emitted := True;
  Result := True;
end;

procedure TCompiler.Compile(Node: TNode; IsStatement: Boolean = False);
var 
  JumpIfFalseIdx, JumpEndIdx, LoopStartIdx, i: Integer;
  ContinueTarget, idx, JumpToNext: Integer; 
  JumpCatchIdx : integer;
  WasEmitted: Boolean; 
  Def: TTypeDefinition;         
  PushedValue: Boolean;
  CaseEndJumps: TIntList; 
  UniqueStr: string;
  SubComp: TCompiler;  
  VMFunc: TVMFunction; 
  ASTMethod: TFunctionNode; 
  HasSpread: Boolean;
  k: Integer; 
  HasStep: Boolean;
  StepInstIdx: Integer;
  ForIsDownto: Boolean;
  
  BodyHasTrailingReturn: Boolean;
  BodyBlock: TBlockNode;
  LastStmt: TNode;
  TypeConstIdx : integer;
  
  ExistingLoopVarIdx: Integer;
  LoopVarGlobalIdx: Integer;     // ← baru
  EndValueSlot: Integer;         // ← baru

  ExitGuardIdx: Integer;    // ← baru
  ExitLoopIdx: Integer;     // ← baru

  function CheckSpreadOperator(List: TObjectList): Boolean;
  var k: Integer;
  begin
    Result := False;
    if not Assigned(List) then Exit;
    for k := 0 to List.Count - 1 do
    begin
      if (TNode(List[k]) is TUnaryOpNode) and (TUnaryOpNode(List[k]).Op = '...') then
        Exit(True);
    end;
  end;
  
  procedure CompileSpreadElements(List: TObjectList);
  var k: Integer;
  begin
    FChunk.AddInstruction(opcBuildArray, 0); // Buat array akumulator argumen
    for k := 0 to List.Count - 1 do
    begin
      if (TNode(List[k]) is TUnaryOpNode) and (TUnaryOpNode(List[k]).Op = '...') then
      begin
        Compile(TUnaryOpNode(List[k]).Expr, False);
        FChunk.AddInstruction(opcAdd); // Gabungkan array spread ke akumulator
      end else
      begin
        Compile(TNode(List[k]), False);
        FChunk.AddInstruction(opcBuildArray, 1);
        FChunk.AddInstruction(opcAdd); // Push sebagai elemen tunggal
      end;
    end;
  end;

  procedure EmitLoopUnwind;
  var idxUnwind, iUnwind: Integer;
  begin
    // 1. UNWIND DEFER
    if FLoopScopeDepths.Count > 0 then
    begin
      for iUnwind := FDeferredNodes.Count - 1 downto FLoopScopeDepths.Last do
      begin
        for idxUnwind := TObjectList(FDeferredNodes[iUnwind]).Count - 1 downto 0 do
          Compile(TNode(TObjectList(FDeferredNodes[iUnwind])[idxUnwind]), True);
      end;
    end;
    // 2. UNWIND LOCALS
    if FLoopLocalCounts.Count > 0 then idxUnwind := FLocalCount - FLoopLocalCounts.Last else idxUnwind := 0;
    if idxUnwind > 0 then FChunk.AddInstruction(opcPopLocals, idxUnwind);
    // 3. UNWIND EXCEPTIONS
    if FLoopTryDepths.Count > 0 then
      for iUnwind := 1 to (FTryDepth - FLoopTryDepths.Last) do FChunk.AddInstruction(opcTryEnd);
    // 4. UNWIND LOCKS
    if FLoopLockDepths.Count > 0 then
      for iUnwind := 1 to (FCompLockDepth - FLoopLockDepths.Last) do FChunk.AddInstruction(opcUnlock);
  end;

  procedure CompileDefaultParams(FuncNode: TFunctionNode; VMFunc: TVMFunction);
  var
    idx: Integer;
    SubComp: TCompiler;
  begin
    for idx := 0 to High(FuncNode.Params) do
    begin
      if Assigned(FuncNode.Params[idx].DefaultExpr) then
      begin
        SubComp := TCompiler.Create;
        try
          SubComp.Compile(FuncNode.Params[idx].DefaultExpr, False);
          SubComp.Chunk.AddInstruction(opcReturn);
          VMFunc.Params[idx].DefaultChunk := SubComp.Chunk;
          SubComp.FChunk := nil;
        finally
          SubComp.Free;
        end;
      end else
        VMFunc.Params[idx].DefaultChunk := nil;
    end;
  end;

begin
  if Node = nil then Exit;
  if FCompileDepth >= MAX_CALL_STACK then
  begin
    CompileError(80, 'Max call stack exceeded', Node, IsStatement);
  end;
  
  FNodeStack[FCompileDepth] := Node; // Tulis ke array hanya setelah divalidasi aman
  Inc(FCompileDepth);
  
  try
      if Node.Line > 0 then
      begin
        FChunk.CurrentLine := Node.Line;
        FChunk.CurrentCol  := Node.Col; 
      end;
      
      PushedValue := True; 
    
      // --- COMPILASI LITERAL ---
      if Node is TLiteralNode then
        FChunk.AddInstruction(opcConstant, FChunk.AddConstant(TLiteralNode(Node).Val.Clone))
      
      // --- COMPILASI VARIABEL (READ) ---
      else if Node is TVariableNode then
      begin
        idx := ResolveLocal(TVariableNode(Node).VarName);
        if idx <> -1 then
          FChunk.AddInstruction(opcGetLocal, idx) // Super cepat!
        else
          FChunk.AddInstruction(opcGetGlobal, FChunk.AddVarName(TVariableNode(Node).VarName));
      end
      
      // --- COMPILASI DEKLARASI VARIABEL (VAR/CONST) ---
      else if Node is TVarDeclNode then
      begin
        // PERBAIKAN: Cek double declaration di scope yang sama SEBELUM kompilasi
        if FScopeDepth > 0 then
        begin
          for i := FLocalCount - 1 downto 0 do
          begin
            if (FLocals[i].Name = TVarDeclNode(Node).VarName) and (FLocals[i].Depth = FScopeDepth) then
            begin
              // Gunakan posisi dari Node
              CompileError(9, 'Identifier "' + TVarDeclNode(Node).VarName + '" sudah dideklarasikan sebelumnya', Node, IsStatement);
            end;
          end;
        end;
        
        if not TVarDeclNode(Node).IsReferenced then 
        begin
          if TVarDeclNode(Node).Expr <> nil then 
            Compile(TVarDeclNode(Node).Expr, True);
          PushedValue := False;   // ✅
          Exit;
        end;
      
        if TVarDeclNode(Node).Expr <> nil then Compile(TVarDeclNode(Node).Expr, False)
        else FChunk.AddInstruction(opcNull);

        if FScopeDepth > 0 then
        begin
          if TVarDeclNode(Node).IsCaptured then
          begin
            // ✅ S-6: gunakan DefineOrReplace — captured var di loop body
            // harus fresh setiap iterasi, bukan error duplicate.
            if TVarDeclNode(Node).IsConst then
              FChunk.AddInstruction(
                opcDefineOrReplaceGlobal,
                FChunk.AddVarName(TVarDeclNode(Node).VarName), 1)
            else
              FChunk.AddInstruction(
                opcDefineOrReplaceGlobal,
                FChunk.AddVarName(TVarDeclNode(Node).VarName), 0);
          end else
          begin
            AddLocal(
              TVarDeclNode(Node).VarName,
              TVarDeclNode(Node).IsConst
            );
          end;
        
          PushedValue := False;
        end else
        begin
          // Top-level: tetap pakai DefineGlobal (executed once)
          if TVarDeclNode(Node).IsConst then
            FChunk.AddInstruction(
              opcDefineConstGlobal,
              FChunk.AddVarName(TVarDeclNode(Node).VarName)
            )
          else
            FChunk.AddInstruction(
              opcDefineGlobal,
              FChunk.AddVarName(TVarDeclNode(Node).VarName)
            );
        
          PushedValue := False;
        end;
      end
    
      // --- COMPILASI ASSIGNMENT ---
      else if Node is TAssignmentNode then
      begin
        idx := ResolveLocal(TAssignmentNode(Node).TargetName);
        
        if (idx <> -1) and FLocals[idx].IsConst then
        begin
          CompileError(10, 'Compile Error: Tidak dapat mengubah nilai konstanta lokal "' + TAssignmentNode(Node).TargetName + '"', Node, IsStatement);
        end;
      
        // ✨ PATCH D: Coba superinstruction dulu
        WasEmitted := False;
        if TryEmitSumArrayIndex(TAssignmentNode(Node), idx, WasEmitted) then
        begin
          PushedValue := False;
        end else 
        if TryEmitAddLocalLocal(TAssignmentNode(Node), idx, WasEmitted) then
        begin
          PushedValue := False;
        end else
        if TryEmitIncrGlobal(TAssignmentNode(Node), idx, WasEmitted) then
        begin
          PushedValue := False;
        end else
        if TryEmitAddLocalConst(TAssignmentNode(Node), idx, WasEmitted) then
        begin
          PushedValue := False;
        end else      
        
        begin
          // Fallback: kompilasi normal (logika asli)
          if (TAssignmentNode(Node).OpAssign <> '') and (TAssignmentNode(Node).OpAssign <> '=') then
          begin
            if idx <> -1 then
              FChunk.AddInstruction(opcGetLocal, idx)
            else
              FChunk.AddInstruction(opcGetGlobal, FChunk.AddVarName(TAssignmentNode(Node).TargetName));
      
            Compile(TAssignmentNode(Node).Expr, False); 
      
            case TAssignmentNode(Node).OpAssign of
              '+': FChunk.AddInstruction(opcAdd);
              '-': FChunk.AddInstruction(opcSub);
              '*': FChunk.AddInstruction(opcMul);
              '/': FChunk.AddInstruction(opcDiv);
              '%': FChunk.AddInstruction(opcMod);
            end;
          end else
          begin
            Compile(TAssignmentNode(Node).Expr, False); 
          end;
          
          FChunk.AddInstruction(opcDup); 
          
          if idx <> -1 then
            FChunk.AddInstruction(opcSetLocal, idx) 
          else
            FChunk.AddInstruction(opcSetGlobal, FChunk.AddVarName(TAssignmentNode(Node).TargetName)); 
            
          PushedValue := True;
        end;
      end
    
      // --- COMPILASI UNPACKING MULTI-ASSIGNMENT (a, b = [1, 2]) ---
      else if Node is TMultiAssignNode then
      begin
        Compile(TMultiAssignNode(Node).Expr, False); // Push RHS ke puncak stack
        
        FChunk.AddInstruction(opcToIterArray); 
        for i := 0 to TMultiAssignNode(Node).Targets.Count - 1 do
        begin
          FChunk.AddInstruction(opcDup); // Duplikasi Array Iterasi RHS
          FChunk.AddInstruction(opcConstant, FChunk.AddConstant(TValue.CreateNum(i))); // Push index
          FChunk.AddInstruction(opcGetIndex); // Ambil elemen ke-i 
    
          idx := ResolveLocal(TMultiAssignNode(Node).Targets[i]);
          if idx <> -1 then
            FChunk.AddInstruction(opcSetLocal, idx) 
          else
            FChunk.AddInstruction(opcSetGlobal, FChunk.AddVarName(TMultiAssignNode(Node).Targets[i]));
        end;
        
        FChunk.AddInstruction(opcPop); // Buang Array Iterator Utama yang tersisa di stack
        PushedValue := False;
      end
    
      // --- COMPILASI TERNARY OPERATOR ( ? : ) ---
      else if Node is TTernaryNode then
      begin
        Compile(TTernaryNode(Node).Condition, False);
        JumpIfFalseIdx := FChunk.AddInstruction(opcJumpIfFalse, 0);
        
        Compile(TTernaryNode(Node).TrueBranch, False);
        JumpEndIdx := FChunk.AddInstruction(opcJump, 0);
        
        FChunk.Code[JumpIfFalseIdx].Operand := FChunk.CodeCount - JumpIfFalseIdx - 1;
        
        Compile(TTernaryNode(Node).FalseBranch, False);
        FChunk.Code[JumpEndIdx].Operand := FChunk.CodeCount - JumpEndIdx - 1;
      end
    
      // --- COMPILASI OPERATOR UNARY (-x, not x) ---
      else if Node is TUnaryOpNode then
      begin
        if TUnaryOpNode(Node).Op = '...' then
        begin
          CompileError(144, 'Spread operator (...) hanya dapat digunakan di dalam Array Literal atau Argumen Fungsi!', Node, IsStatement);
          FChunk.AddInstruction(opcNull); // <-- Cegah Stack Underflow karena kompilasi di-skip
        end else
        begin
          Compile(TUnaryOpNode(Node).Expr, False); 
          
          if (TUnaryOpNode(Node).Op = 'not') or (TUnaryOpNode(Node).Op = '!') then
            FChunk.AddInstruction(opcNot)
          else if TUnaryOpNode(Node).Op = '-' then
            FChunk.AddInstruction(opcNegate)
          else if TUnaryOpNode(Node).Op = '+' then
            ; 
        end;
      end
    
      // --- COMPILASI BINARY OPERATION & SHORT-CIRCUIT ---
      else if Node is TBinaryOpNode then
      begin
        if TBinaryOpNode(Node).Op = opAnd then
        begin
          Compile(TBinaryOpNode(Node).Left, False);
          FChunk.AddInstruction(opcDup); 
          JumpIfFalseIdx := FChunk.AddInstruction(opcJumpIfFalse, 0);
          
          FChunk.AddInstruction(opcPop); 
          Compile(TBinaryOpNode(Node).Right, False); 
          
          FChunk.Code[JumpIfFalseIdx].Operand := FChunk.CodeCount - JumpIfFalseIdx - 1;
        end else 
        if TBinaryOpNode(Node).Op = opOr then
        begin
          Compile(TBinaryOpNode(Node).Left, False);
          FChunk.AddInstruction(opcDup); 
          JumpIfFalseIdx := FChunk.AddInstruction(opcJumpIfFalse, 0);
          
          JumpEndIdx := FChunk.AddInstruction(opcJump, 0); 
          
          FChunk.Code[JumpIfFalseIdx].Operand := FChunk.CodeCount - JumpIfFalseIdx - 1;
          FChunk.AddInstruction(opcPop); 
          Compile(TBinaryOpNode(Node).Right, False);
          
          FChunk.Code[JumpEndIdx].Operand := FChunk.CodeCount - JumpEndIdx - 1;
        end else
        begin
          Compile(TBinaryOpNode(Node).Left, False);  
          Compile(TBinaryOpNode(Node).Right, False); 
          
          case TBinaryOpNode(Node).Op of
            opAdd: FChunk.AddInstruction(opcAdd);
            opSub: FChunk.AddInstruction(opcSub);
            opMul: FChunk.AddInstruction(opcMul);
            opDiv: FChunk.AddInstruction(opcDiv);
            opMod: FChunk.AddInstruction(opcMod);
            opEq:  FChunk.AddInstruction(opcEqual);
            opNotEq: FChunk.AddInstruction(opcNotEqual);
            opLess: FChunk.AddInstruction(opcLess);
            opGreater: FChunk.AddInstruction(opcGreater);
            opLessEq: FChunk.AddInstruction(opcLessEq);
            opGreaterEq: FChunk.AddInstruction(opcGreaterEq);
            opIn: FChunk.AddInstruction(opcIn);
          end;
        end;
      end
    
      // --- COMPILASI DEKLARASI FUNGSI ---
      else if Node is TFunctionNode then
      begin
        if (TFunctionNode(Node).Name <> '') and (not TFunctionNode(Node).IsReferenced) then Exit; 
      
        VMFunc := TVMFunction.Create;
        try
          VMFunc.Name := TFunctionNode(Node).Name;
          SetLength(VMFunc.Params, Length(TFunctionNode(Node).Params));
    
          SubComp := TCompiler.Create;
          try
            for i := 0 to High(TFunctionNode(Node).Params) do
            begin
              VMFunc.Params[i].Name := TFunctionNode(Node).Params[i].Name;
              SubComp.AddLocal(VMFunc.Params[i].Name);
            end;
            // FIX (closure param capture): copy each param from stack slot
            // to env. Nested lambdas reference captured vars via
            // opcGetGlobal (walks env chain), so param must exist in env
            // to survive outer frame teardown.
            for i := 0 to High(TFunctionNode(Node).Params) do
            begin
              SubComp.FChunk.AddInstruction(opcGetLocal, i);
              SubComp.FChunk.AddInstruction(opcDefineOrReplaceGlobal,
                SubComp.FChunk.AddVarName(TFunctionNode(Node).Params[i].Name), 0);
            end;
          
            SubComp.Compile(TFunctionNode(Node).Body, True);
            
            // ✅ TAHAP C — C-2: skip fallback jika body diakhiri `return`
            // (fallback akan jadi dead-code setelah explicit return)
            BodyHasTrailingReturn := False;
            if TFunctionNode(Node).Body is TBlockNode then
            begin
              BodyBlock := TBlockNode(TFunctionNode(Node).Body);
              if BodyBlock.Statements.Count > 0 then
              begin
                LastStmt := TNode(BodyBlock.Statements[BodyBlock.Statements.Count - 1]);
                if LastStmt is TReturnNode then
                  BodyHasTrailingReturn := True;
              end;
            end;
            
            if not BodyHasTrailingReturn then
              SubComp.Chunk.AddInstruction(opcReturnNull);
          
            VMFunc.Chunk := SubComp.Chunk;
            SubComp.FChunk := nil; 
          finally
            SubComp.Free;
          end;
        
          CompileDefaultParams(TFunctionNode(Node), VMFunc);

          FChunk.AddInstruction(opcConstant, FChunk.AddConstant(TValue.CreateFunc(VMFunc)));
          FChunk.AddInstruction(opcBindClosure, 0);
          
          if VMFunc.Name <> '' then
          begin
            if FScopeDepth > 0 then
            begin
              AddLocal(VMFunc.Name);
              PushedValue := False; 
            end else
            begin
              FChunk.AddInstruction(opcDefineGlobal, FChunk.AddVarName(VMFunc.Name));
              PushedValue := False; 
            end;
          end;
        finally
          VMFunc.Release; 
        end;
      end

      // --- COMPILASI PEMANGGILAN FUNGSI ---
      else if Node is TFunctionCallNode then
      begin
        // D.1 — coSleep special-case: emit dict + yield
        if (TFunctionCallNode(Node).FuncExpr is TVariableNode) and
           (TVariableNode(TFunctionCallNode(Node).FuncExpr).VarName = 'coSleep') and
           (TFunctionCallNode(Node).Args.Count = 1) then
        begin
          FChunk.AddInstruction(opcConstant,
            FChunk.AddConstant(TValue.CreateStr('__co_sleep')));
          Compile(TNode(TFunctionCallNode(Node).Args[0]), False);
          FChunk.AddInstruction(opcBuildDict, 1);
          FChunk.AddInstruction(opcYield);
        end
        else
        begin
          Compile(TFunctionCallNode(Node).FuncExpr, False); 
      
          if CheckSpreadOperator(TFunctionCallNode(Node).Args) then
          begin
            CompileSpreadElements(TFunctionCallNode(Node).Args);
            FChunk.AddInstruction(opcCallSpread); 
          end else
          begin
            for i := 0 to TFunctionCallNode(Node).Args.Count - 1 do
              Compile(TNode(TFunctionCallNode(Node).Args[i]), False); 
            FChunk.AddInstruction(opcCall, TFunctionCallNode(Node).Args.Count); 
          end;
        end;
      end
    
      // --- COMPILASI METHOD CALL ---
      else if Node is TMethodCallNode then
      begin
        Compile(TMethodCallNode(Node).Target, False); 

        if CheckSpreadOperator(TMethodCallNode(Node).Args) then
        begin
          CompileSpreadElements(TMethodCallNode(Node).Args);
          FChunk.AddInstruction(opcMethodCallSpread, FChunk.AddConstant(TValue.CreateStr(TMethodCallNode(Node).sMethodName)));
        end else
        begin
          for i := 0 to TMethodCallNode(Node).Args.Count - 1 do
            Compile(TNode(TMethodCallNode(Node).Args[i]), False);
          FChunk.AddInstruction(opcMethodCall, FChunk.AddConstant(TValue.CreateStr(TMethodCallNode(Node).sMethodName)), TMethodCallNode(Node).Args.Count);
        end;
      end
      
      // --- COMPILASI STATEMENT RETURN ---
      else if Node is TReturnNode then
      begin
        HasSpread := False;
        if (TReturnNode(Node).Expr <> nil) and (TReturnNode(Node).Expr is TFunctionCallNode) then
        begin
          for i := 0 to TFunctionCallNode(TReturnNode(Node).Expr).Args.Count - 1 do
            if (TNode(TFunctionCallNode(TReturnNode(Node).Expr).Args[i]) is TUnaryOpNode) and 
               (TUnaryOpNode(TFunctionCallNode(TReturnNode(Node).Expr).Args[i]).Op = '...') then
              HasSpread := True;
        end;
        
        if (TReturnNode(Node).Expr <> nil) and (TReturnNode(Node).Expr is TFunctionCallNode) and
           (FTryDepth = 0) and (FCompLockDepth = 0) and not HasActiveDefers() and not HasSpread then
        begin
          Compile(TFunctionCallNode(TReturnNode(Node).Expr).FuncExpr, False); 
          for i := 0 to TFunctionCallNode(TReturnNode(Node).Expr).Args.Count - 1 do
            Compile(TNode(TFunctionCallNode(TReturnNode(Node).Expr).Args[i]), False); 
            
          FChunk.AddInstruction(opcTailCall, TFunctionCallNode(TReturnNode(Node).Expr).Args.Count); 
        end else
        begin
          if TReturnNode(Node).Expr <> nil then
            Compile(TReturnNode(Node).Expr, False)
          else
            FChunk.AddInstruction(opcNull); 

          for i := FDeferredNodes.Count - 1 downto 0 do
          begin
            for idx := TObjectList(FDeferredNodes[i]).Count - 1 downto 0 do
               Compile(TNode(TObjectList(FDeferredNodes[i])[idx]), True);
          end;
          
          for i := 1 to FTryDepth do 
            FChunk.AddInstruction(opcTryEnd);
            
          for i := 1 to FCompLockDepth do 
            FChunk.AddInstruction(opcUnlock);
            
          FChunk.AddInstruction(opcReturn);
        end;
        PushedValue := False; 
      end

      // ✅ TAHAP C-4: throw statement
      else if Node is TThrowNode then
      begin
        Compile(TThrowNode(Node).Expr, False);
        FChunk.AddInstruction(opcThrow);
        PushedValue := False;
      end
      
      // --- COMPILASI IF-THEN-ELSE ---
      else if Node is TIfNode then
      begin
        Compile(TIfNode(Node).Condition, False);
        JumpIfFalseIdx := FChunk.AddInstruction(opcJumpIfFalse, 0); 
        
        BeginScope; 
        Compile(TIfNode(Node).ThenBranch, True); 
        EndScope;   
        
        if TIfNode(Node).ElseBranch <> nil then
        begin
          JumpEndIdx := FChunk.AddInstruction(opcJump, 0);
          FChunk.Code[JumpIfFalseIdx].Operand := FChunk.CodeCount - JumpIfFalseIdx - 1;
          
          BeginScope; 
          Compile(TIfNode(Node).ElseBranch, True);
          EndScope;   
          
          FChunk.Code[JumpEndIdx].Operand := FChunk.CodeCount - JumpEndIdx - 1;
        end
        else
          FChunk.Code[JumpIfFalseIdx].Operand := FChunk.CodeCount - JumpIfFalseIdx - 1;
          
        PushedValue := False; 
      end
    
      // --- COMPILASI CASE .. OF ---
      else if Node is TCaseNode then
      begin
        Compile(TCaseNode(Node).TargetExpr, False); 
        CaseEndJumps := TIntList.Create; 
    
        try
          for i := 0 to High(TCaseNode(Node).Branches) do
          begin
            FChunk.AddInstruction(opcDup); 
            Compile(TCaseNode(Node).Branches[i].MatchExpr, False); 
            FChunk.AddInstruction(opcEqual);                       
            JumpToNext := FChunk.AddInstruction(opcJumpIfFalse, 0);
      
            FChunk.AddInstruction(opcPop); 
            
            if TCaseNode(Node).Branches[i].Body <> nil then
            begin
              BeginScope; 
              Compile(TCaseNode(Node).Branches[i].Body, True); 
              EndScope;   
            end;
      
            idx := FChunk.AddInstruction(opcJump, 0);
            CaseEndJumps.Add(idx);
            FChunk.Code[JumpToNext].Operand := FChunk.CodeCount - JumpToNext - 1;
          end;
      
          FChunk.AddInstruction(opcPop);
      
          if TCaseNode(Node).ElseBranch <> nil then
          begin
            BeginScope; 
            Compile(TCaseNode(Node).ElseBranch, True);
            EndScope;   
          end;
      
          for i := 0 to CaseEndJumps.Count - 1 do
          begin
            idx := CaseEndJumps[i];
            FChunk.Code[idx].Operand := FChunk.CodeCount - idx - 1;
          end;
        finally
          CaseEndJumps.Free; 
        end;
        
        PushedValue := False;
      end
    
      // --- COMPILASI WHILE LOOP ---
      else if Node is TWhileNode then
      begin
        FBreakJumps.Add(TIntList.Create);
        FContinueJumps.Add(TIntList.Create);
    
        BeginScope;
        BeginLoopTracking; 

        try
          LoopStartIdx := FChunk.CodeCount;
          ContinueTarget := LoopStartIdx; 
        
          Compile(TWhileNode(Node).Condition, False);
          JumpIfFalseIdx := FChunk.AddInstruction(opcJumpIfFalse, 0);
        
          BeginScope; 
          Compile(TWhileNode(Node).Body, True);
          EndScope;   
        
          FChunk.AddInstruction(opcJump, LoopStartIdx - FChunk.CodeCount - 1);
          
          FChunk.Code[JumpIfFalseIdx].Operand := FChunk.CodeCount - JumpIfFalseIdx - 1;
          PatchLoopJumps(ContinueTarget);    
        finally
          EndLoopTracking; 
        end;
    
        EndScope;
        PushedValue := False;
      end
    
      // --- COMPILASI REPEAT .. UNTIL ---
      else if Node is TRepeatNode then
      begin
        FBreakJumps.Add(TIntList.Create);
        FContinueJumps.Add(TIntList.Create);
    
        BeginScope;
        BeginLoopTracking;         
        try
          LoopStartIdx := FChunk.CodeCount; 
        
          BeginScope; 
          Compile(TRepeatNode(Node).Body, True);
          EndScope;   
        
          ContinueTarget := FChunk.CodeCount; 
          Compile(TRepeatNode(Node).Condition, False);
          FChunk.AddInstruction(opcJumpIfFalse, LoopStartIdx - FChunk.CodeCount - 1);
        finally
          EndLoopTracking;        
        end;
        
        PatchLoopJumps(ContinueTarget);    
        EndScope;
        PushedValue := False;
      end
   
      // --- COMPILASI FOR LOOP ---
      else if Node is TForNode then
      begin
        FBreakJumps.Add(TIntList.Create);
        FContinueJumps.Add(TIntList.Create);
      
        // ✅ FIX: deteksi jenis loop variable
        ExistingLoopVarIdx := ResolveLocal(TForNode(Node).VarName);
        LoopVarGlobalIdx := -1;
        if ExistingLoopVarIdx = -1 then
          LoopVarGlobalIdx := FChunk.VarNames.IndexOf(TForNode(Node).VarName);
      
        if LoopVarGlobalIdx <> -1 then
        begin
          // ═══════════════════════════════════════════════════════════════
          // FOR LOOP — GLOBAL VARIABLE PATH
          // Pakai generic instructions (opcGetGlobal, opcSetGlobal,
          // opcIncrGlobal). Tidak bikin local shadow.
          // ═══════════════════════════════════════════════════════════════
          BeginScope;
      
          Compile(TForNode(Node).StartExpr, False);
          FChunk.AddInstruction(opcSetGlobal, LoopVarGlobalIdx);
      
          Compile(TForNode(Node).EndExpr, False);
          AddLocal('#end_' + TForNode(Node).VarName);
          EndValueSlot := ResolveLocal('#end_' + TForNode(Node).VarName);
      
          HasStep := TForNode(Node).StepExpr <> nil;
          if HasStep then
          begin
            Compile(TForNode(Node).StepExpr, False);
            AddLocal('#step_' + TForNode(Node).VarName);
          end;
      
          ForIsDownto := TForNode(Node).IsDownto;
      
          BeginLoopTracking;
          try
            LoopStartIdx := FChunk.CodeCount;
      
            // Kondisi: a <= end (asc) / a >= end (desc)
            FChunk.AddInstruction(opcGetGlobal, LoopVarGlobalIdx);
            FChunk.AddInstruction(opcGetLocal, EndValueSlot);
            if ForIsDownto then
              FChunk.AddInstruction(opcGreaterEq)
            else
              FChunk.AddInstruction(opcLessEq);
      
            JumpIfFalseIdx := FChunk.AddInstruction(opcJumpIfFalse, 0);
      
            BeginScope;
            Compile(TForNode(Node).Body, True);
            EndScope;
     
            ContinueTarget := FChunk.CodeCount;
          
            // ✅ FIX: exit-before-increment untuk match semantik Pascal/FPC.
            // Cek: a == end? Kalau ya, keluar tanpa increment.
            FChunk.AddInstruction(opcGetGlobal, LoopVarGlobalIdx);
            FChunk.AddInstruction(opcGetLocal, EndValueSlot);
            FChunk.AddInstruction(opcEqual);
            ExitGuardIdx := FChunk.AddInstruction(opcJumpIfFalse, 0);
            // 'a' sudah == end: keluar loop
            ExitLoopIdx := FChunk.AddInstruction(opcJump, 0);
            
            // Path increment (a != end)
            FChunk.Code[ExitGuardIdx].Operand := 
              FChunk.CodeCount - ExitGuardIdx - 1;
            
            if HasStep then
            begin
              FChunk.AddInstruction(opcGetGlobal, LoopVarGlobalIdx);
              FChunk.AddInstruction(opcGetLocal,
                ResolveLocal('#step_' + TForNode(Node).VarName));
              if ForIsDownto then
                FChunk.AddInstruction(opcSub)
              else
                FChunk.AddInstruction(opcAdd);
              FChunk.AddInstruction(opcSetGlobal, LoopVarGlobalIdx);
            end
            else
            begin
              if ForIsDownto then
                FChunk.AddInstruction(opcDecrGlobal, LoopVarGlobalIdx)
              else
                FChunk.AddInstruction(opcIncrGlobal, LoopVarGlobalIdx);
            end;
          
            FChunk.AddInstruction(opcJump, LoopStartIdx - FChunk.CodeCount - 1);
            
            // Target exit loop setelah increment di-skip
            FChunk.Code[ExitLoopIdx].Operand := 
              FChunk.CodeCount - ExitLoopIdx - 1;
          finally
            EndLoopTracking;
          end;
          
          FChunk.Code[JumpIfFalseIdx].Operand := FChunk.CodeCount - JumpIfFalseIdx - 1;
          PatchLoopJumps(ContinueTarget);
          EndScope;
          PushedValue := False;          
        end
        else
        begin
          // ═══════════════════════════════════════════════════════════════
          // FOR LOOP — LOCAL VARIABLE PATH (existing + reuse)
          // ═══════════════════════════════════════════════════════════════
          BeginScope;
          Compile(TForNode(Node).StartExpr, False);
      
          if ExistingLoopVarIdx <> -1 then
            FChunk.AddInstruction(opcSetLocal, ExistingLoopVarIdx)
          else
            AddLocal(TForNode(Node).VarName);
      
          Compile(TForNode(Node).EndExpr, False);
          AddLocal('#end_' + TForNode(Node).VarName);
      
          HasStep := TForNode(Node).StepExpr <> nil;
          if HasStep then
          begin
            Compile(TForNode(Node).StepExpr, False);
            AddLocal('#step_' + TForNode(Node).VarName);
          end;
      
          ForIsDownto := TForNode(Node).IsDownto;
      
          if (ResolveLocal(TForNode(Node).VarName) < 0) or
             (ResolveLocal('#end_' + TForNode(Node).VarName) < 0) or
             (HasStep and (ResolveLocal('#step_' + TForNode(Node).VarName) < 0)) then
            CompileError(105,
              'TCompiler.Compile: variabel loop "' + TForNode(Node).VarName +
              '" gagal di-resolve sebagai lokal', Node, IsStatement);
      
          BeginLoopTracking;
          try
            LoopStartIdx := FChunk.CodeCount;
      
            if ForIsDownto then
              JumpIfFalseIdx := FChunk.AddInstruction(
                opcForLoopCondDown,
                ResolveLocal(TForNode(Node).VarName),
                ResolveLocal('#end_' + TForNode(Node).VarName))
            else
              JumpIfFalseIdx := FChunk.AddInstruction(
                opcForLoopCond,
                ResolveLocal(TForNode(Node).VarName),
                ResolveLocal('#end_' + TForNode(Node).VarName));
      
            BeginScope;
            Compile(TForNode(Node).Body, True);
            EndScope;
    
            ContinueTarget := FChunk.CodeCount;
            
            // ✅ FIX: exit-before-increment (sama seperti global path)
            FChunk.AddInstruction(opcGetLocal, ResolveLocal(TForNode(Node).VarName));
            FChunk.AddInstruction(opcGetLocal, ResolveLocal('#end_' + TForNode(Node).VarName));
            FChunk.AddInstruction(opcEqual);
            ExitGuardIdx := FChunk.AddInstruction(opcJumpIfFalse, 0);
            ExitLoopIdx := FChunk.AddInstruction(opcJump, 0);
            
            FChunk.Code[ExitGuardIdx].Operand := 
              FChunk.CodeCount - ExitGuardIdx - 1;
            
            if HasStep then
            begin
              StepInstIdx := FChunk.AddInstruction(
                opcAddLocalLocal,
                ResolveLocal(TForNode(Node).VarName),
                ResolveLocal('#step_' + TForNode(Node).VarName));
              if ForIsDownto then
                FChunk.Code[StepInstIdx].Operand3 := 1
              else
                FChunk.Code[StepInstIdx].Operand3 := 0;
            end
            else
            begin
              if ForIsDownto then
                FChunk.AddInstruction(opcDecrLocal, ResolveLocal(TForNode(Node).VarName))
              else
                FChunk.AddInstruction(opcIncrLocal, ResolveLocal(TForNode(Node).VarName));
            end;
            
            FChunk.AddInstruction(opcJump, LoopStartIdx - FChunk.CodeCount - 1);
            
            FChunk.Code[ExitLoopIdx].Operand := 
              FChunk.CodeCount - ExitLoopIdx - 1;            
        
          finally
            EndLoopTracking;
          end;
      
          FChunk.Code[JumpIfFalseIdx].Operand3 := FChunk.CodeCount - JumpIfFalseIdx - 1;
          if FChunk.Code[JumpIfFalseIdx].Operand3 < 0 then
            CompileError(105,
              'TCompiler.Compile: kondisi for-loop menghasilkan offset negatif',
              Node, IsStatement);
      
          PatchLoopJumps(ContinueTarget);
          EndScope;
          PushedValue := False;
        end;
      end
    
      // --- COMPILASI FOR..IN LOOP ---
      else if Node is TForEachNode then
      begin 
        FBreakJumps.Add(TIntList.Create);
        FContinueJumps.Add(TIntList.Create);
    
        BeginScope;
        UniqueStr := IntToStr(FChunk.CodeCount); 
        Compile(TForEachNode(Node).CollectionExpr, False);
        FChunk.AddInstruction(opcToIterArray);
        AddLocal('#iter_' + UniqueStr);
        FChunk.AddInstruction(opcConstant, FChunk.AddConstant(TValue.CreateNum(0)));
        AddLocal('#i_' + UniqueStr);
        FChunk.AddInstruction(opcNull);
        AddLocal(TForEachNode(Node).VarName);
    
        BeginLoopTracking; 
        
        try
          LoopStartIdx := FChunk.CodeCount;
          FChunk.AddInstruction(opcGetLocal, ResolveLocal('#i_' + UniqueStr));
          FChunk.AddInstruction(opcGetLocal, ResolveLocal('#iter_' + UniqueStr));
          FChunk.AddInstruction(opcGetProp, FChunk.AddConstant(TValue.CreateStr('length')));
          FChunk.AddInstruction(opcLess);
          JumpIfFalseIdx := FChunk.AddInstruction(opcJumpIfFalse, 0);
        
          FChunk.AddInstruction(opcGetLocal, ResolveLocal('#iter_' + UniqueStr));
          FChunk.AddInstruction(opcGetLocal, ResolveLocal('#i_' + UniqueStr));
          FChunk.AddInstruction(opcGetIndex); 
          FChunk.AddInstruction(opcSetLocal, ResolveLocal(TForEachNode(Node).VarName));
        
          BeginScope; 
          Compile(TForEachNode(Node).Body, True);
          EndScope;   
        
          ContinueTarget := FChunk.CodeCount; 
          FChunk.AddInstruction(opcGetLocal, ResolveLocal('#i_' + UniqueStr));
          FChunk.AddInstruction(opcConstant, FChunk.AddConstant(TValue.CreateNum(1)));
          FChunk.AddInstruction(opcAdd);
          FChunk.AddInstruction(opcSetLocal, ResolveLocal('#i_' + UniqueStr));
          FChunk.AddInstruction(opcJump, LoopStartIdx - FChunk.CodeCount - 1);
        finally
          EndLoopTracking; 
        end;
        
        FChunk.Code[JumpIfFalseIdx].Operand := FChunk.CodeCount - JumpIfFalseIdx - 1;
        PatchLoopJumps(ContinueTarget);    
        EndScope;
        PushedValue := False;
      end
    
      // --- COMPILASI BLOCK/MULTIPLE STATEMENTS ---
      else if Node is TBlockNode then
      begin
        if TBlockNode(Node).IsScope then 
          BeginScope; 
          
        try  
          for i := 0 to TBlockNode(Node).Statements.Count - 1 do
            Compile(TNode(TBlockNode(Node).Statements[i]), True);
        finally  
          if TBlockNode(Node).IsScope then 
            EndScope;   
        end;
        PushedValue := False;
      end
    
      // --- COMPILASI DICT LITERAL ---
      else if Node is TDictLiteralNode then
      begin
        for i := 0 to TDictLiteralNode(Node).FKeys.Count - 1 do
        begin
          FChunk.AddInstruction(opcConstant, FChunk.AddConstant(TValue.CreateStr(TDictLiteralNode(Node).FKeys[i])));
          Compile(TNode(TDictLiteralNode(Node).FValues[i]), False);
        end;
        FChunk.AddInstruction(opcBuildDict, TDictLiteralNode(Node).FKeys.Count);
      end
      
      // --- COMPILASI ARRAY LITERAL ---
      else if Node is TArrayLiteralNode then
      begin
        HasSpread := False;
        for i := 0 to TArrayLiteralNode(Node).FElements.Count - 1 do
        begin
          if (TArrayLiteralNode(Node).FElements[i] is TUnaryOpNode) and 
             (TUnaryOpNode(TArrayLiteralNode(Node).FElements[i]).Op = '...') then
            HasSpread := True;
        end;

        if HasSpread then
        begin
          FChunk.AddInstruction(opcBuildArray, 0); 
          for i := 0 to TArrayLiteralNode(Node).FElements.Count - 1 do
          begin
            if (TArrayLiteralNode(Node).FElements[i] is TUnaryOpNode) and 
               (TUnaryOpNode(TArrayLiteralNode(Node).FElements[i]).Op = '...') then
            begin
              Compile(TUnaryOpNode(TArrayLiteralNode(Node).FElements[i]).Expr, False);
              FChunk.AddInstruction(opcAdd);
            end else
            begin
              Compile(TNode(TArrayLiteralNode(Node).FElements[i]), False);
              FChunk.AddInstruction(opcBuildArray, 1);
              FChunk.AddInstruction(opcAdd);
            end;
          end;
        end else
        begin
          for i := 0 to TArrayLiteralNode(Node).FElements.Count - 1 do
            Compile(TNode(TArrayLiteralNode(Node).FElements[i]), False);
            
          FChunk.AddInstruction(opcBuildArray, TArrayLiteralNode(Node).FElements.Count);
        end;
      end
    
      // --- COMPILASI ARRAY INDEX ---
      else if Node is TArrayAccessNode then
      begin
        Compile(TArrayAccessNode(Node).FTarget, False);    
        Compile(TArrayAccessNode(Node).FIndexExpr, False); 
        FChunk.AddInstruction(opcGetIndex);
      end
    
      // --- COMPILASI ARRAY ASSIGNMENT ---
      else if Node is TArrayAssignNode then
      begin
        Compile(TArrayAssignNode(Node).FTarget, False);     
        Compile(TArrayAssignNode(Node).FIndexExpr, False);  
        Compile(TArrayAssignNode(Node).FValueExpr, False);  
        
        FChunk.AddInstruction(opcSetIndex, FChunk.AddConstant(TValue.CreateStr(TArrayAssignNode(Node).FAssignOp)));
        PushedValue := True; 
      end
    
      // --- COMPILASI ARRAY SLICING ---
      else if Node is TArraySliceNode then
      begin
        Compile(TArraySliceNode(Node).Target, False);
        
        if TArraySliceNode(Node).StartExpr <> nil then Compile(TArraySliceNode(Node).StartExpr, False)
        else FChunk.AddInstruction(opcNull);
        
        if TArraySliceNode(Node).EndExpr <> nil then Compile(TArraySliceNode(Node).EndExpr, False)
        else FChunk.AddInstruction(opcNull);
        
        if TArraySliceNode(Node).StepExpr <> nil then Compile(TArraySliceNode(Node).StepExpr, False)
        else FChunk.AddInstruction(opcNull);
        
        FChunk.AddInstruction(opcSlice);
      end
    
      // --- COMPILASI LIST COMPREHENSION ---
      else if Node is TListComprehensionNode then
      begin
        UniqueStr := IntToStr(FChunk.CodeCount); 
        BeginScope; 
    
        FChunk.AddInstruction(opcBuildArray, 0); 
        AddLocal('#res_' + UniqueStr);           
    
        Compile(TListComprehensionNode(Node).CollectionExpr, False);
        FChunk.AddInstruction(opcToIterArray);   
        AddLocal('#iter_' + UniqueStr);          
    
        FChunk.AddInstruction(opcConstant, FChunk.AddConstant(TValue.CreateNum(0)));
        AddLocal('#i_' + UniqueStr);
    
        FChunk.AddInstruction(opcNull); 
        AddLocal(TListComprehensionNode(Node).VarName);
    
        LoopStartIdx := FChunk.CodeCount; 
    
        FChunk.AddInstruction(opcGetLocal, ResolveLocal('#i_' + UniqueStr));
        FChunk.AddInstruction(opcGetLocal, ResolveLocal('#iter_' + UniqueStr));
        FChunk.AddInstruction(opcGetProp, FChunk.AddConstant(TValue.CreateStr('length')));
        FChunk.AddInstruction(opcLess);
        JumpIfFalseIdx := FChunk.AddInstruction(opcJumpIfFalse, 0);
    
        FChunk.AddInstruction(opcGetLocal, ResolveLocal('#iter_' + UniqueStr));
        FChunk.AddInstruction(opcGetLocal, ResolveLocal('#i_' + UniqueStr));
        FChunk.AddInstruction(opcGetIndex); 
        
        FChunk.AddInstruction(opcSetLocal, ResolveLocal(TListComprehensionNode(Node).VarName)); 
    
        JumpEndIdx := -1;
        if TListComprehensionNode(Node).ConditionExpr <> nil then
        begin
          Compile(TListComprehensionNode(Node).ConditionExpr, False);
          JumpEndIdx := FChunk.AddInstruction(opcJumpIfFalse, 0); 
        end;
    
        FChunk.AddInstruction(opcGetLocal, ResolveLocal('#res_' + UniqueStr));
        Compile(TListComprehensionNode(Node).OutputExpr, False); 
        FChunk.AddInstruction(opcMethodCall, FChunk.AddConstant(TValue.CreateStr('push')), 1);
        FChunk.AddInstruction(opcPop); 
    
        if JumpEndIdx <> -1 then
          FChunk.Code[JumpEndIdx].Operand := FChunk.CodeCount - JumpEndIdx - 1;
    
        FChunk.AddInstruction(opcGetLocal, ResolveLocal('#i_' + UniqueStr));
        FChunk.AddInstruction(opcConstant, FChunk.AddConstant(TValue.CreateNum(1)));
        FChunk.AddInstruction(opcAdd);
        FChunk.AddInstruction(opcSetLocal, ResolveLocal('#i_' + UniqueStr));
    
        FChunk.AddInstruction(opcJump, LoopStartIdx - FChunk.CodeCount - 1);
    
        FChunk.Code[JumpIfFalseIdx].Operand := FChunk.CodeCount - JumpIfFalseIdx - 1;
    
        FChunk.AddInstruction(opcGetLocal, ResolveLocal('#res_' + UniqueStr));
    
        EndScope(True); 
        
        PushedValue := True; 
      end
    
      // --- COMPILASI PROPERTY ACCESS ---
      else if Node is TMemberAccessNode then
      begin
        Compile(TMemberAccessNode(Node).Target, False); 
        FChunk.AddInstruction(opcGetProp, FChunk.AddConstant(TValue.CreateStr(TMemberAccessNode(Node).MemberName)));
      end
    
      // --- COMPILASI PROPERTY ASSIGNMENT ---
      else if Node is TMemberAssignNode then
      begin
        Compile(TMemberAssignNode(Node).Target, False); 
        Compile(TMemberAssignNode(Node).Expr, False);   
    
        FChunk.AddInstruction(opcSetProp, 
          FChunk.AddConstant(TValue.CreateStr(TMemberAssignNode(Node).MemberName)), 
          FChunk.AddConstant(TValue.CreateStr(TMemberAssignNode(Node).OpAssign)));
          
        PushedValue := True;
      end
      
      // --- COMPILASI DEKLARASI CLASS ---
      else if Node is TClassDeclNode then
      begin
        if not TClassDeclNode(Node).IsReferenced then Exit; 
      
        if TClassDeclNode(Node).IsRecordType then
          Def := TTypeDefinition.Create(TClassDeclNode(Node).sClassName, tkRecord)
        else
          Def := TTypeDefinition.Create(TClassDeclNode(Node).sClassName, tkClass);
    
        try
            for i := 0 to TClassDeclNode(Node).Fields.Count - 1 do
              Def.Fields.Add(TClassDeclNode(Node).Fields[i]);
    
            for i := 0 to TClassDeclNode(Node).Methods.Count - 1 do
            begin
              ASTMethod := TFunctionNode(TClassDeclNode(Node).Methods[i]);
              
              VMFunc := TVMFunction.Create; 
              try
                VMFunc.Name := ASTMethod.Name;
                SetLength(VMFunc.Params, Length(ASTMethod.Params));
      
                SubComp := TCompiler.Create;
                try
                  for k := 0 to High(ASTMethod.Params) do
                  begin
                    VMFunc.Params[k].Name := ASTMethod.Params[k].Name;
                    SubComp.AddLocal(VMFunc.Params[k].Name);
                  end;
          
                  SubComp.Compile(ASTMethod.Body, True);
          
                  if ASTMethod.Name = 'create' then
                  begin
                    SubComp.Chunk.AddInstruction(opcGetVar, SubComp.Chunk.AddVarName('self'));
                    SubComp.Chunk.AddInstruction(opcReturn);
                  end
                  else
                    SubComp.Chunk.AddInstruction(opcReturnNull);  
                    
                  VMFunc.Chunk := SubComp.Chunk;
                  SubComp.FChunk := nil; 
                finally
                  SubComp.Free;
                end;
                
                CompileDefaultParams(ASTMethod, VMFunc);

                Def.Methods.Add(VMFunc.Name, VMFunc);
                VMFunc.Retain; 
              finally
                VMFunc.Release;
              end;
            end;
    
            FChunk.AddInstruction(opcConstant, FChunk.AddConstant(TValue.CreateClassDef(Def)));
        except
          Def.Release; 
          raise;
        end;
          
        if TClassDeclNode(Node).IsRecordType then
        begin
          FChunk.AddInstruction(opcBuildRecord);
        end else
        begin
          for i := 0 to TClassDeclNode(Node).Parents.Count - 1 do
          begin
            FChunk.AddInstruction(opcGetVar, FChunk.AddVarName(TClassDeclNode(Node).Parents[i]));
            FChunk.AddInstruction(opcInheritClass);
          end;    
        end;
          
        FChunk.AddInstruction(opcDefineVar, FChunk.AddVarName(TClassDeclNode(Node).sClassName));
        PushedValue := False;       
      end    
      
      // --- COMPILASI INSTANSIASI OBJEK ---
      else if Node is TNewNode then
      begin
        if CheckSpreadOperator(TNewNode(Node).Args) then
        begin
          CompileSpreadElements(TNewNode(Node).Args);
          FChunk.AddInstruction(opcNewObjectSpread, FChunk.AddConstant(TValue.CreateStr(TNewNode(Node).sClassName)));
        end else 
        begin
          for i := 0 to TNewNode(Node).Args.Count - 1 do
            Compile(TNode(TNewNode(Node).Args[i]), False);
          FChunk.AddInstruction(opcNewObject, FChunk.AddConstant(TValue.CreateStr(TNewNode(Node).sClassName)), TNewNode(Node).Args.Count);
        end;
      end
      
      // --- COMPILASI BREAK ---
      else if Node is TBreakNode then 
      begin
        if FBreakJumps.Count = 0 then 
        begin
          CompileError(81,'TCompiler.Compile',Node, IsStatement);
          Exit; // <-- PERBAIKAN LOGIKA: Wajib dihentikan agar tidak memanggil .Last pada List kosong
        end;
           
        EmitLoopUnwind; 
           
        idx := FChunk.AddInstruction(opcJump, 0);
        TIntList(FBreakJumps.Last).Add(idx); 
        PushedValue := False;
      end
    
      // --- COMPILASI CONTINUE ---
      else if Node is TContinueNode then
      begin
        if FContinueJumps.Count = 0 then 
        begin
          CompileError(82,'TCompiler.Compile',Node, IsStatement);
          Exit; // <-- PERBAIKAN LOGIKA: Wajib dihentikan agar tidak memanggil .Last pada List kosong
        end;
          
        EmitLoopUnwind; 
           
        idx := FChunk.AddInstruction(opcJump, 0);
        TIntList(FContinueJumps.Last).Add(idx);
        PushedValue := False;
      end 
      
      // --- COMPILASI NODE LAINNYA ---
      else if Node is TNoOpNode then
      begin
        PushedValue := False; 
      end
      
      else if Node is TLockNode then
      begin
        Inc(FCompLockDepth); 
        FChunk.AddInstruction(opcLock);
        
        Compile(TLockNode(Node).Body, True);
        
        FChunk.AddInstruction(opcUnlock);
        Dec(FCompLockDepth); 
        PushedValue := False;
      end
      
      else if Node is TTryCatchNode then
      begin
        Inc(FTryDepth); 
        
        // ✅ C-4: emit type filter untuk opcTryBegin (Operand2)
        if TTryCatchNode(Node).CatchTypeName <> '' then
          TypeConstIdx := FChunk.AddConstant(
            TValue.CreateStr(TTryCatchNode(Node).CatchTypeName))
        else
          TypeConstIdx := -1;   // wildcard
        
        JumpCatchIdx := FChunk.AddInstruction(opcTryBegin, 0, TypeConstIdx);
      
        BeginScope; 
        
        if TTryCatchNode(Node).FinallyBlock <> nil then
          TObjectList(FDeferredNodes.Last).Add(TTryCatchNode(Node).FinallyBlock);
      
        Compile(TTryCatchNode(Node).TryBlock, True);
      
        if TTryCatchNode(Node).FinallyBlock <> nil then
          TObjectList(FDeferredNodes.Last).Remove(TTryCatchNode(Node).FinallyBlock);
          
        EndScope;   
      
        FChunk.AddInstruction(opcTryEnd);
        Dec(FTryDepth); 
      
        JumpEndIdx := FChunk.AddInstruction(opcJump, 0);
        FChunk.Code[JumpCatchIdx].Operand := FChunk.CodeCount - JumpCatchIdx - 1;
      
        BeginScope;
        AddLocal(TTryCatchNode(Node).CatchVar); 
     
        PushedValue := False; 
        
        if TTryCatchNode(Node).FinallyBlock <> nil then
          TObjectList(FDeferredNodes.Last).Add(TTryCatchNode(Node).FinallyBlock);

        Compile(TTryCatchNode(Node).CatchBlock, True);

        if TTryCatchNode(Node).FinallyBlock <> nil then
          TObjectList(FDeferredNodes.Last).Remove(TTryCatchNode(Node).FinallyBlock);

        EndScope;
    
        FChunk.Code[JumpEndIdx].Operand := FChunk.CodeCount - JumpEndIdx - 1;
        
        if TTryCatchNode(Node).FinallyBlock <> nil then
        begin
          Compile(TTryCatchNode(Node).FinallyBlock, True);
        end;
        
        PushedValue := False; 
      end

      // --- COMPILASI IMPORT ---
      else if Node is TImportExprNode then
      begin
        Compile(TImportExprNode(Node).PathExpr, False); 
        FChunk.AddInstruction(opcImport);
        PushedValue := True; 
      end

      else if Node is TYieldNode then
      begin
        if FCompLockDepth > 0 then
        begin
          CompileError(134, 'Compile Error: Tidak dapat menggunakan "yield" di dalam blok "lock" (Beresiko Deadlock OS)!', Node, IsStatement);
          FChunk.AddInstruction(opcNull); // Keseimbangan Stack VM
          FChunk.AddInstruction(opcYield); 
          PushedValue := True;
          Exit; // <-- PERBAIKAN LOGIKA: Cegah kompilasi Expr di bawahnya agar tidak terjadi double-push di Stack
        end;
            
        if TYieldNode(Node).Expr <> nil then 
          Compile(TYieldNode(Node).Expr, False)
        else 
          FChunk.AddInstruction(opcNull); 
          
        FChunk.AddInstruction(opcYield);
        PushedValue := True; 
      end
     
      else if Node is TDeferNode then
      begin
        if FDeferredNodes.Count > 0 then
          TObjectList(FDeferredNodes.Last).Add(TDeferNode(Node).Body);
        PushedValue := False; 
      end;
      
      // --- AUTO STACK CLEANUP ---
      if IsStatement and PushedValue then
        FChunk.AddInstruction(opcPop);
  finally
    Dec(FCompileDepth); 
  end;
end;

constructor TVM.Create(Env: TSymbolTable);
begin
  FEnv := Env;
  if Assigned(FEnv) then 
  begin
    FEnv.Retain;
    FContext := GetContextFromEnv(Env);
  end;
    
  FTop := 0; 
  FLockDepth := 0; 
  FStackLock := TCriticalSection.Create; 
  
  // ✅ TAHAP A: eksplisit init field baru
  FActiveChunks := nil;
  FHasResult    := False;
  
  GCRootLock.Acquire;
  try
    if ActiveVMs = nil then ActiveVMs := TList.Create;
    ActiveVMs.Add(Self);
  finally
    GCRootLock.Release;
  end;
end;

destructor TVM.Destroy;
var
  i: Integer;
begin
  if IsShuttingDown = 0 then
  begin
    if Assigned(GCRootLock) then
    begin
      GCRootLock.Acquire;
      try
        if Assigned(ActiveVMs) then
        begin
          ActiveVMs.Remove(Self);
          if ActiveVMs.Count = 0 then
          begin
            ActiveVMs.Free;
            ActiveVMs := nil;
          end;
        end;
      finally
        GCRootLock.Release;
      end;
    end;
  end;

  // Lepas semua lock yang masih dipegang
  while FLockDepth > 0 do
  begin
    if Assigned(ScriptLock) then ScriptLock.Release;
    Dec(FLockDepth);
  end;

  // Bersihkan stack (jangan Free — TValue dipinjam)
  for i := 0 to FTop - 1 do
    FStack[i] := nil;
  FTop := 0;

  // Lepas frame env
  for i := 0 to FFrameCount - 1 do
  begin
    if Assigned(FFrames[i].Env) then
    begin
      FFrames[i].Env.Release;
      FFrames[i].Env := nil;
    end;
    FFrames[i].FuncValue := nil;   // pinjam, jangan free
  end;
  FFrameCount := 0;

  // ✅ PENTING: flush thread-local TValue freelist ke global
  FlushThreadTLAB;
  
  // ✅ TAHAP A — BUG-1: Lepaskan semua chunk yang masih di-AcquireUse.
  //    Ini mengembalikan FActiveUses ke nilai semula, sehingga
  //    JIT-lite feedback bekerja benar untuk eksekusi berikutnya.
  if Assigned(FActiveChunks) then
  begin
    for i := 0 to FActiveChunks.Count - 1 do
    begin
      if Assigned(FActiveChunks[i]) then
        TChunk(FActiveChunks[i]).ReleaseUse;
    end;
    FActiveChunks.Free;
    FActiveChunks := nil;
  end;

  ClearInlineCache;
  SetLength(FGlobalCache, 0);

  if Assigned(FEnv) then FEnv.Release;
  FStackLock.Free;
  inherited;
end;

procedure TVM.Push(Val: TValue);
begin
  FStackLock.Acquire;
  try
    if FTop >= STACK_MAX then
    begin
      // PERBAIKAN LOGIKA: Val.Free dihapus. 
      // Karena Val adalah referensi (managed by GC), memanggil Free di sini menyebabkan Double-Free.
      raise EScriptFatalError.CreateFmt('VM PANIC (Error 83): Stack Overflow pada Baris %d, Kolom %d', [errMSG.xrow, errMSG.xcol]); 
    end;
     
    FStack[FTop] := Val;
    Inc(FTop);
  finally
    FStackLock.Release;
  end;
end;

function TVM.Pop: TValue;
begin
  FStackLock.Acquire;
  try
    if FTop <= 0 then
      raise EScriptFatalError.CreateFmt(
        'VM PANIC (Error 84): Stack Underflow pada Baris %d, Kolom %d',
        [errMSG.xrow, errMSG.xcol]);

    Dec(FTop);
    Result := FStack[FTop];
    FStack[FTop] := nil;
    
  finally
    FStackLock.Release;
  end;
end;

function TVM.GenerateStackTrace: string;
var
  i, j, TargetIP, LineNo: Integer;
  FuncName, SourceFile: string;
  Frame: PCallFrame;
  TraceLimit, StartFrame: Integer;
  LocalVars: string;
  VarCount: Integer;
  Item: PHashItem;
begin
  Result := '=== VM Stack Trace ===' + #10;
  
  TraceLimit := 15;
  if FFrameCount > TraceLimit then
  begin
    StartFrame := FFrameCount - TraceLimit;
    Result := Result + '  ... (' + IntToStr(FFrameCount - TraceLimit) + 
              ' frame sebelumnya disembunyikan)' + #10;
  end else
    StartFrame := 0;

  for i := FFrameCount - 1 downto StartFrame do
  begin
    Frame := @FFrames[i];
    TargetIP := Frame^.IP - 1; 
    if TargetIP < 0 then TargetIP := 0;

    LineNo := 0;
    SourceFile := '<unknown>';
    if Assigned(Frame^.Chunk) then
    begin
      if TargetIP < Length(Frame^.Chunk.Lines) then
        LineNo := Frame^.Chunk.Lines[TargetIP];
      if Frame^.Chunk.SourceFile <> '' then
        SourceFile := Frame^.Chunk.SourceFile;
    end;

    if Assigned(Frame^.FuncValue) and (Frame^.FuncValue.DataType = dtFunction) then
      FuncName := Frame^.FuncValue.FuncVal.Name
    else
      FuncName := '<Program Utama / Global>';

    if FuncName = '' then FuncName := '<Fungsi Lambda>';

    Result := Result + Format('  #%d  %s  at %s:%d', 
      [FFrameCount - 1 - i, FuncName, SourceFile, LineNo]) + #10;
    
    // ✨ PHASE 4: Local variables snapshot (jika frame bukan root)
    if (i > 0) and Assigned(Frame^.Env) and (Frame^.Env.FCount > 0) then
    begin
      LocalVars := '';
      VarCount := 0;
      Frame^.Env.FLock.Acquire;
      try
        for j := 0 to High(Frame^.Env.FBuckets) do
        begin
          Item := Frame^.Env.FBuckets[j];
          while Item <> nil do
          begin
            if (Item^.Key <> 'self') and (Pos('#', Item^.Key) <> 1) and 
               (VarCount < 5) then
            begin
              if LocalVars <> '' then LocalVars := LocalVars + ', ';
              if Assigned(Item^.Value) then
                LocalVars := LocalVars + Item^.Key + '=' + TValueToString(Item^.Value, False)
              else
                LocalVars := LocalVars + Item^.Key + '=nil';
              Inc(VarCount);
            end;
            Item := Item^.Next;
          end;
        end;
      finally
        Frame^.Env.FLock.Release;
      end;
      
      if LocalVars <> '' then
        Result := Result + '       locals: ' + LocalVars + #10;
    end;
  end;
end;

function TVM.CallMagicMethod(TargetObj: TValue; const zMethodName: string; Args: array of TValue): TValue;
var
  MethodFunc, RawResult: TValue;
  MiniVM: TVM;
  TempScope: TSymbolTable;
  TempChunk: TChunk;
  i, Idx: Integer;
  IsTempFunc: Boolean; // <-- PERBAIKAN: Penanda memori sementara
begin
  Result := nil; 
  IsTempFunc := False;

  if TargetObj.ObjVal.Members.HasVar(zMethodName) then
    MethodFunc := TargetObj.ObjVal.Members.GetVar(zMethodName) // Ini hanya referensi, DILARANG di-free
  else 
  begin
    Idx := TargetObj.ObjVal.Definition.Methods.IndexOf(zMethodName);
    if Idx <> -1 then
    begin
      MethodFunc := TValue.CreateFunc(TargetObj.ObjVal.Definition.Methods.Data[Idx], nil, TargetObj.Clone);
      IsTempFunc := True; // <-- PERBAIKAN: Tandai sebagai instansi baru yang butuh di-free
    end else
    begin
      Exit(TValue.CreateNull); 
    end;
  end;

  try
    if MethodFunc.DataType = dtFunction then
    begin
      if Assigned(MethodFunc.ClosureEnv) then 
        TempScope := TSymbolTable.Create(MethodFunc.ClosureEnv)
      else 
        TempScope := TSymbolTable.Create(FEnv.GetGlobal);

      if Assigned(MethodFunc.BoundSelf) then 
        TempScope.DefineVar('self', MethodFunc.BoundSelf.Clone)
      else 
        TempScope.DefineVar('self', TargetObj.Clone);

      MiniVM := TVM.Create(TempScope);
      TempChunk := TChunk.Create;
      try
        TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(MethodFunc.Clone));
        for i := 0 to High(Args) do
          TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(Args[i].Clone));

        TempChunk.AddInstruction(opcCall, Length(Args));
        TempChunk.AddInstruction(opcReturn);

        RawResult := MiniVM.Run(TempChunk);
        Result := RawResult.Clone;
        RawResult.Free; 
      finally
        TempChunk.Free;
        MiniVM.Free;
        TempScope.Release;
      end;
    end;
  finally
    // <-- PERBAIKAN LOGIKA: Hanya bebaskan jika method ini adalah instansi sementara (IsTempFunc = True)
    if IsTempFunc and Assigned(MethodFunc) then 
      MethodFunc.Free;
  end;
  
  if Result = nil then
    Result := TValue.CreateNull;
end;

procedure TVM.MarkStack;
var 
  i, SafeTop, SafeFrameTop: Integer;
begin
  FStackLock.Acquire; 
  try
    SafeTop := FTop; 
    for i := 0 to SafeTop - 1 do
      if Assigned(FStack[i]) then FStack[i].Mark;

    SafeFrameTop := FFrameCount;
    for i := 0 to SafeFrameTop - 1 do
    begin
      if Assigned(FFrames[i].Env) then FFrames[i].Env.Mark;
      if Assigned(FFrames[i].FuncValue) then FFrames[i].FuncValue.Mark;
    end;
  finally
    FStackLock.Release; 
  end;
end;

procedure TVM.EnsureInlineCache(MinSize: Integer);
var
  OldLen, NewLen, i: Integer;
begin
  if MinSize <= 0 then Exit;
  
  OldLen := Length(FGlobalCache);
  if OldLen >= MinSize then Exit;
  
  // Grow dengan pola doubling untuk mengurangi jumlah realokasi
  NewLen := OldLen;
  if NewLen < 64 then NewLen := 64;
  while NewLen < MinSize do
    NewLen := NewLen * 2;
  
  SetLength(FGlobalCache, NewLen);
  
  for i := OldLen to NewLen - 1 do
  begin
    FGlobalCache[i].VarName := '';
    FGlobalCache[i].CachedItem := nil;
    FGlobalCache[i].TypeDef := nil;
    FGlobalCache[i].PropIndex := -1;
    FGlobalCache[i].Valid := False;
    
    // ✅ C-3
    FGlobalCache[i].GVarName := '';
    FGlobalCache[i].GItem := nil;
    FGlobalCache[i].GRoot := nil;
    FGlobalCache[i].GGen := 0;
    FGlobalCache[i].GValid := False;
  end;
end;

procedure TVM.InitInlineCache(CodeCount: Integer);
var
  i: Integer;
begin
  EnsureInlineCache(CodeCount);
  
  for i := 0 to CodeCount - 1 do
  begin
    // Field method-call cache
    FGlobalCache[i].VarName := '';
    FGlobalCache[i].CachedItem := nil;
    FGlobalCache[i].TypeDef := nil;
    FGlobalCache[i].PropIndex := -1;
    FGlobalCache[i].Valid := False;
    
    // ✅ C-3: field global cache
    FGlobalCache[i].GVarName := '';
    FGlobalCache[i].GItem := nil;
    FGlobalCache[i].GRoot := nil;
    FGlobalCache[i].GGen := 0;
    FGlobalCache[i].GValid := False;
  end;
end;

procedure TVM.ClearInlineCache;
var
  i: Integer;
begin
  for i := 0 to High(FGlobalCache) do
  begin
    FGlobalCache[i].VarName := '';
    FGlobalCache[i].CachedItem := nil;
    FGlobalCache[i].TypeDef := nil;
    FGlobalCache[i].PropIndex := -1;
    FGlobalCache[i].Valid := False;
    
    // ✅ C-3
    FGlobalCache[i].GVarName := '';
    FGlobalCache[i].GItem := nil;
    FGlobalCache[i].GRoot := nil;
    FGlobalCache[i].GGen := 0;
    FGlobalCache[i].GValid := False;
  end;
end;

function TVM.Run(Chunk: TChunk; IsResume: Boolean = False): TValue;
var
  CurrentFrame: PCallFrame; 
  ResultVal: TValue;
  TempScope: TSymbolTable;
  Inst: TInstruction;
  a, b, c, TmpC, TempVal, TargetObj: TValue;
  VarName, StrKey: string;
  EvalArgs: TObjectList;
  ArgArr: array of TValue;
  i, idx,ArgCount, MethodIdx: Integer;
  FoundItem: Boolean;
  STrace: string;
  TempKeys: TStringArray;
  ParamVM: TVM; 
  TempChunk: TChunk;
  ErrDict: TDictValue;
  
  VStart, VEnd, VStep: TValue;
  IterArr: TValueList;  
  
  CurrentTime: QWord;
  CurrentLine, CurrentCol: Integer;
  NewDef: TTypeDefinition;
  PInst: PInstruction;
  LoopActive: Boolean;
  scan : integer;
  
  CacheSlot: PPerThreadCacheSlot;
  LookupRoot: TSymbolTable;
  LookupItem: PHashItem;

  ThrownVal : TValue; Handled : Boolean;
  
  function VM_SafeDivide(A, B: Double): Double; inline;
  begin
    if IsZero(B) or SameValue(B, 0.0, 1E-15) then 
      errMSG.callerror(12, 'Division by zero', errMSG.xrow, errMSG.xcol); 
    Result := A / B;
  end;
  
  function VM_SafeMod(A, B: Double): Double; inline;
  begin
    if IsZero(B) or SameValue(B, 0.0, 1E-15) then 
      errMSG.callerror(12, 'Modulo by zero', errMSG.xrow, errMSG.xcol); 
    Result := A - (B * math.Floor(A / B));
  end;

  function ExceptionMatchesType(Thrown: TValue; const TypeName: string): Boolean;
  var
    ClassVal: TValue;
  begin
    Result := False;
    if TypeName = '' then Exit(True);   // wildcard
    if not Assigned(Thrown) then Exit(False);
    
    case Thrown.DataType of
      dtObject:
        begin
          if Assigned(Thrown.ObjVal) and Assigned(Thrown.ObjVal.Definition) then
            Result := Thrown.ObjVal.Definition.Name = TypeName;
        end;
      dtDict:
        begin
          ClassVal := Thrown.DictVal.GetValueClone('__class');
          if Assigned(ClassVal) then
          begin
            try
              Result := (ClassVal.DataType = dtString) and (ClassVal.StrVal = TypeName);
            finally
              ClassVal.Free;   // ✅ aman — ini clone milik kita
            end;
          end;
        end;
      dtString:
        Result := Thrown.StrVal = TypeName;
    end;
  end;
  
  procedure PushSpreadArray(TargetArray: TValue); inline;
  var
    SpreadIdx, SpreadCount: Integer;
  begin
    if TargetArray.DataType <> dtArray then
      errMSG.callerror(109, 'TVM.Run (Spread Argument harus berupa Array)', errMSG.xrow, errMSG.xcol);

    SpreadCount := TargetArray.ArrayVal.Count;
    TargetArray.ArrayVal.FLock.Acquire;
    try
      for SpreadIdx := 0 to SpreadCount - 1 do
        Push(TargetArray.ArrayVal[SpreadIdx].Clone); 
    finally
      TargetArray.ArrayVal.FLock.Release;
    end;
  end;
  
  procedure CleanStackTo(TargetIndex: Integer); inline;
  begin
    if TargetIndex < 0 then TargetIndex := 0;
    
    FStackLock.Acquire; 
    try
      while FTop > TargetIndex do 
      begin
        Dec(FTop);
        if Assigned(FStack[FTop]) then 
        begin
          FStack[FTop].Free;
          FStack[FTop] := nil; 
        end;
      end;
    finally
      FStackLock.Release;
    end;
  end;
  
  procedure SetupFrame(FuncTarget: TValue; AArgCount, BaseSlotIndex: Integer);
  var
    NewFrame: PCallFrame;
    Idx: Integer;
    ParamVM: TVM;
  begin
    if FFrameCount >= MAX_CALL_STACK then
      errMSG.callerror(88, 'SetupFrame', errMSG.xrow, errMSG.xcol);
  
    NewFrame := @FFrames[FFrameCount];
    NewFrame^.FuncValue := FuncTarget;
    NewFrame^.Chunk := FuncTarget.FuncVal.Chunk;
    
    NewFrame := @FFrames[FFrameCount];
    NewFrame^.FuncValue := FuncTarget;
    NewFrame^.Chunk := FuncTarget.FuncVal.Chunk;
    NewFrame^.IP := 0;
    NewFrame^.BaseSlot := BaseSlotIndex;
    NewFrame^.BaseLockDepth := FLockDepth;
    
    if Assigned(NewFrame^.Chunk) then
    begin
      NewFrame^.Chunk.AcquireUse;
      if not Assigned(FActiveChunks) then
        FActiveChunks := TList.Create;
      FActiveChunks.Add(NewFrame^.Chunk);
      EnsureInlineCache(NewFrame^.Chunk.CodeCount);
    end;    
    
    NewFrame^.IP := 0;
    NewFrame^.BaseSlot := BaseSlotIndex;
    NewFrame^.BaseLockDepth := FLockDepth;
    
    // ✅ TAHAP A — BUG-2: Pastikan inline cache cukup besar untuk chunk ini.
    //    Tanpa ini, nested function dengan CodeCount > root.CodeCount akan
    //    mengakses FGlobalCache[IP-1] di luar batas → AV.
    if Assigned(NewFrame^.Chunk) then
      EnsureInlineCache(NewFrame^.Chunk.CodeCount);
  
    // Setiap call memiliki environment frame sendiri.
    // ClosureEnv hanya menjadi parent.
    if Assigned(FuncTarget.ClosureEnv) then
      NewFrame^.Env := TSymbolTable.Create(FuncTarget.ClosureEnv)
    else if Assigned(FEnv) then
      NewFrame^.Env := TSymbolTable.Create(FEnv.GetGlobal)
    else
      NewFrame^.Env := TSymbolTable.Create(nil);
  
    if Assigned(FuncTarget.BoundSelf) then
      NewFrame^.Env.DefineVar('self', FuncTarget.BoundSelf.Clone);
  
    for Idx := AArgCount to Length(FuncTarget.FuncVal.Params) - 1 do
    begin
    
      if Assigned(FuncTarget.FuncVal.Params[Idx].DefaultChunk) then
      begin
        ParamVM := TVM.Create(NewFrame^.Env);
        try
          Push(ParamVM.Run(FuncTarget.FuncVal.Params[Idx].DefaultChunk));
        finally
          ParamVM.Free;
        end;
      end
      else
        Push(TValue.CreateNull);
    end;
  
    Inc(FFrameCount);
    CurrentFrame := @FFrames[FFrameCount - 1];
  
    if Assigned(FContext) and Assigned(FContext.Profiler)
       and FContext.Profiler.Enabled then
      FContext.Profiler.EnterFunction(FuncTarget.FuncVal.Name);
  end;

  function FetchLocal(IndexOffset: Integer): TValue; inline;
  var 
    AbsIdx: Integer;
  begin
    AbsIdx := CurrentFrame^.BaseSlot + IndexOffset;
    if (AbsIdx < 0) or (AbsIdx >= STACK_MAX) then
      errMSG.callerror(105,'TVM.Run',CurrentLine, CurrentCol);
    
    if Assigned(FStack[AbsIdx]) then Result := FStack[AbsIdx].Clone
    else Result := TValue.CreateNull;
  end;

  procedure StoreLocal(IndexOffset: Integer; ValToStore: TValue); inline;
  var
    AbsIdx: Integer;
    OldVal: TValue;
  begin
    AbsIdx := CurrentFrame^.BaseSlot + IndexOffset;
    if (AbsIdx < 0) or (AbsIdx >= STACK_MAX) then
      errMSG.callerror(106,'TVM.Run',CurrentLine, CurrentCol);
      
    OldVal := FStack[AbsIdx];
    FStack[AbsIdx] := ValToStore;
    
    if Assigned(OldVal) and (Pointer(OldVal) <> Pointer(ValToStore)) then 
      OldVal.Free;
  end;

  procedure TeardownCurrentFrame;
  var
    SavedEnv: TSymbolTable;
    Scan: Integer;
  begin
    // 1. Unlock semua lock yang di-hold di frame ini
    while FLockDepth > CurrentFrame^.BaseLockDepth do
    begin
      ScriptLock.Release;
      Dec(FLockDepth);
    end;
  
    // 2. Drop exception handlers
    while (FExceptionCount > 0) and 
          (FExceptions[FExceptionCount - 1].FrameIdx = FFrameCount - 1) do
      Dec(FExceptionCount);
  
    // 3. Bersihkan stack slot frame ini
    CleanStackTo(CurrentFrame^.BaseSlot);
  
    // 4. Buang slot return-address
    if CurrentFrame^.BaseSlot > 0 then 
    begin
      FStackLock.Acquire;
      try
        if FTop > 0 then
        begin
          Dec(FTop);
          if Assigned(FStack[FTop]) then 
          begin
             FStack[FTop].Free;
             FStack[FTop] := nil; 
          end;
        end;
      finally
        FStackLock.Release;
      end;
    end;
  
    // 5. Release Env
    SavedEnv := CurrentFrame^.Env;
    CurrentFrame^.Env := nil;
    if Assigned(SavedEnv) then 
      SavedEnv.Release;
  
    // ✅ TAHAP A FIX: ReleaseUse chunk frame ini jika bukan root.
    //    Root chunk sudah di-track di TVM.Run dan di-release di Destroy.
    //    Nested chunks di-track saat SetupFrame.
    if (FFrameCount > 1) and Assigned(CurrentFrame^.Chunk) then
    begin
      // Hapus dari FActiveChunks (cari dari belakang).
      if Assigned(FActiveChunks) then
      begin
        for Scan := FActiveChunks.Count - 1 downto 0 do
        begin
          if Pointer(FActiveChunks[Scan]) = Pointer(CurrentFrame^.Chunk) then
          begin
            FActiveChunks.Delete(Scan);
            CurrentFrame^.Chunk.ReleaseUse;
            Break;
          end;
        end;
      end;
    end;
  
    // profiler exit
    if Assigned(FContext) and Assigned(FContext.Profiler) 
       and FContext.Profiler.Enabled then
      FContext.Profiler.ExitFunction;
  
    Dec(FFrameCount);
  end;

  procedure HandleMethodCall(IsSpread: Boolean; ArgCountFromInst: Integer; const MethodName: string); inline;
  var
    CallTarget, FuncRef: TValue;
    TargetBaseIdx, IdxMethod: Integer;
    //LocalCacheDef: Pointer;
    //LocalCacheIdx: Integer;
    CallCacheSlot: PPerThreadCacheSlot;
  begin
    TargetBaseIdx := FTop - ArgCountFromInst - 1;
    CallTarget := FStack[TargetBaseIdx];
  
    if CallTarget.DataType in [dtArray, dtString, dtDict, dtDLLHandle] then
    begin
      SetLength(ArgArr, ArgCountFromInst);
      for IdxMethod := 0 to ArgCountFromInst - 1 do
        ArgArr[IdxMethod] := FStack[TargetBaseIdx + 1 + IdxMethod];
        
      try 
        ResultVal := ExecuteNativeTypeMethod(CallTarget, MethodName, ArgArr);
      finally 
        CleanStackTo(TargetBaseIdx); 
      end;
      Push(ResultVal);
    end else 
    if CallTarget.DataType = dtObject then
    begin
      if CallTarget.ObjVal.Members.HasVar(MethodName) then
      begin
        FuncRef := CallTarget.ObjVal.Members.GetVar(MethodName);
        if FuncRef.DataType = dtNative then
        begin
          EvalArgs := TObjectList.Create(False); 
          try
            for IdxMethod := TargetBaseIdx + 1 to FTop - 1 do 
                EvalArgs.Add(FStack[IdxMethod]); 
            ResultVal := FuncRef.NativeFunc(EvalArgs, CurrentFrame^.Env); 
          finally 
            EvalArgs.Free; 
          end;
          CleanStackTo(TargetBaseIdx);
          Push(ResultVal); 
        end
        else if FuncRef.DataType = dtFunction then SetupFrame(FuncRef, ArgCountFromInst, TargetBaseIdx + 1)
        else errMSG.callerror(126,'TVM.Run',CurrentLine, CurrentCol); 
        // PERBAIKAN: Jangan memanggil FuncRef.Free karena FuncRef adalah referensi dari TSymbolTable/Members
      end else
      begin
        PInst := @CurrentFrame^.Chunk.Code[CurrentFrame^.IP - 1];
        //LocalCacheDef := PInst^.CacheTypeDef;
        //LocalCacheIdx := PInst^.CacheIdx;
  
        CallCacheSlot := @FGlobalCache[CurrentFrame^.IP - 1];
        
        if CallCacheSlot^.Valid and 
           (CallCacheSlot^.VarName = MethodName) and
           (CallCacheSlot^.TypeDef = Pointer(CallTarget.ObjVal.Definition)) and
           (CallCacheSlot^.PropIndex >= 0) and
           (CallCacheSlot^.PropIndex < CallTarget.ObjVal.Definition.Methods.Count) and
           (CallTarget.ObjVal.Definition.Methods.Keys[CallCacheSlot^.PropIndex] = MethodName) then
        begin
          MethodIdx := CallCacheSlot^.PropIndex; 
        end else
        begin
          MethodIdx := CallTarget.ObjVal.Definition.Methods.IndexOf(MethodName);
          if MethodIdx = -1 then 
            errMSG.callerror(17, 'TVM.Run (Method tidak ditemukan)', CurrentLine, CurrentCol); 
      
          // Update per-thread cache
          CallCacheSlot^.VarName := MethodName;
          CallCacheSlot^.TypeDef := Pointer(CallTarget.ObjVal.Definition);
          CallCacheSlot^.PropIndex := MethodIdx;
          CallCacheSlot^.Valid := True;
        end;
        
        a := TValue.CreateFunc(CallTarget.ObjVal.Definition.Methods.Data[MethodIdx], nil, CallTarget.Clone);
        try SetupFrame(a, ArgCountFromInst, TargetBaseIdx + 1); finally a.Free; end;
      end;
    end
    else errMSG.callerror(127, 'TVM.Run', CurrentLine, CurrentCol);
  end;

  
begin
  if not IsResume then
  begin
    // ✅ TAHAP A — BUG-1: Acquire chunk use dan catat untuk release nanti.
    Chunk.AcquireUse;
    if not Assigned(FActiveChunks) then
      FActiveChunks := TList.Create;
    FActiveChunks.Add(Chunk);
  
    // ✅ TAHAP A — BUG-5: Reset flag HasResult untuk eksekusi baru
    FHasResult := False;
  
    FState := vmRunning;
    FStartTime := GetTickCount64; 
    FInstructionCount := 0;

    FTop := 0;
    FExceptionCount := 0; 

    FFrameCount := 1;
    FFrames[0].FuncValue := nil;
    FFrames[0].Chunk := Chunk;
    FFrames[0].IP := 0;
    FFrames[0].BaseSlot := 0;
    FFrames[0].Env := FEnv;
    FEnv.Retain;
    CurrentFrame := @FFrames[0];
    
    // ✅ FIX P1.8: Init per-thread inline cache (root chunk).
    //    Nested chunks akan di-grow on demand via EnsureInlineCache di SetupFrame.
    InitInlineCache(Chunk.CodeCount);
  end else
  begin
    CurrentFrame := @FFrames[FFrameCount - 1];
    FState := vmRunning;
  end;
  
  LoopActive := True;
  while LoopActive do
  begin
    try
      while CurrentFrame^.IP < CurrentFrame^.Chunk.CodeCount do
      begin
        CurrentLine := CurrentFrame^.Chunk.Lines[CurrentFrame^.IP];
        CurrentCol := CurrentFrame^.Chunk.Cols[CurrentFrame^.IP];
    
        errMSG.xrow := CurrentLine;
        errMSG.xcol := CurrentCol;
      
        Inst := CurrentFrame^.Chunk.Code[CurrentFrame^.IP];
      
        Inc(CurrentFrame^.IP);
      
        if GDebugEnabled then
          Inc(GDebugOpcodeCounts[Inst.OpCode]);

        Inc(FInstructionCount);
        if (FInstructionCount and (WATCHDOG_CHECK_INTERVAL - 1)) = 0 then
        begin
          if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 1 then
            errMSG.callerror(91, 'TVM.Run (Dihentikan Paksa oleh Sistem)', CurrentLine, CurrentCol);
        
          if (FMaxInstructions > 0) and (FInstructionCount > FMaxInstructions) then errMSG.callerror(89,'TVM.Run',CurrentLine, CurrentCol); 
          if (FMaxExecTimeMs > 0) then begin
            CurrentTime := GetTickCount64;
            if (CurrentTime - FStartTime) > FMaxExecTimeMs then errMSG.callerror(90,'TVM.Run',CurrentLine, CurrentCol); 
          end;
          if Assigned(FOnExecutionHook) then begin
            if not FOnExecutionHook(Self, FInstructionCount, GetTickCount64 - FStartTime) then errMSG.callerror(91,'TVM.Run',CurrentLine, CurrentCol); 
          end;
        
          idx := 0; 
          if Assigned(FContext) then
          begin
            // Per-engine GC trigger
            // Major GC jika memori > 70% quota ATAU Gen0 sangat besar
            if (GlobalMemQuota > 0) and 
               (GlobalMemUsage > (GlobalMemQuota * 7) div 10) then
              idx := 2
            else if Assigned(FContext.MemLock) and 
                    Assigned(FContext.Gen0Objects) then
            begin
              FContext.MemLock.Acquire;
              try
                // ✨ PATCH C: Threshold dinaikkan dari 4096 → 65536
                if FContext.Gen0Objects.Count > 65536 then idx := 1;
              finally 
                FContext.MemLock.Release; 
              end;
            end;
          end
          else
          begin
            // Fallback: single-instance mode (logika lama dengan threshold baru)
            if (InterlockedIncrement(TotalAllocations) and $FFFF) = 0 then 
              idx := 2
            else 
            begin
              if Assigned(MemLock) then 
              begin
                MemLock.Acquire;
                try
                  // ✨ PATCH C: Threshold dinaikkan 4096 → 65536
                  if Assigned(Gen0Objects) and (Gen0Objects.Count > 65536) then idx := 1; 
                finally 
                  MemLock.Release; 
                end;
              end;
            end;
          end;
          
          if idx > 0 then
            RunGarbageCollection(FEnv, idx = 2);        
        end;
 
        // debugger hook via context
        if Assigned(FContext) and Assigned(FContext.DebugServer) 
           and FContext.DebugServer.Enabled then
          FContext.DebugServer.PollDebugger(Self, CurrentLine);
          
        case Inst.OpCode of
          opcTryBegin:
            begin
                if FExceptionCount >= 32 then 
                  raise EScriptFatalError.CreateFmt(
                    'VM PANIC (Error 92): Max Try-Catch Depth Exceeded di Baris %d', 
                    [CurrentLine]); 
                
                FExceptions[FExceptionCount].CatchIP := CurrentFrame^.IP + Inst.Operand;
                FExceptions[FExceptionCount].FrameIdx := FFrameCount - 1;
                FExceptions[FExceptionCount].BaseTop := FTop;
                FExceptions[FExceptionCount].BaseLockDepth := FLockDepth;
                
                // ✅ C-4: simpan type filter ('' = wildcard)
                if Inst.Operand2 < 0 then
                  FExceptions[FExceptionCount].TypeName := ''
                else if (Inst.Operand2 < CurrentFrame^.Chunk.Constants.Count) 
                        and (CurrentFrame^.Chunk.Constants[Inst.Operand2].DataType = dtString) then
                  FExceptions[FExceptionCount].TypeName := 
                    CurrentFrame^.Chunk.Constants[Inst.Operand2].StrVal
                else
                  FExceptions[FExceptionCount].TypeName := '';
                
                Inc(FExceptionCount);
            end;
          opcTryEnd:
            begin
                if FExceptionCount > 0 then Dec(FExceptionCount);
            end;

          opcLock: 
            begin
                ScriptLock.Acquire;
                Inc(FLockDepth);
            end;
            
          opcUnlock: 
            begin 
                if FLockDepth > 0 then 
                begin
                  Dec(FLockDepth);
                  ScriptLock.Release; 
                end;
            end;
            
          opcConstant: 
            begin
                if (Inst.Operand < 0) or (Inst.Operand >= CurrentFrame^.Chunk.Constants.Count) then
                  errMSG.callerror(93,'TVM.Run',CurrentLine, CurrentCol); 
                Push(CurrentFrame^.Chunk.Constants[Inst.Operand].Clone);
            end;
            
          opcNull:     Push(TValue.CreateNull);
          opcTrue:     Push(TValue.CreateBool(True));
          opcFalse:    Push(TValue.CreateBool(False));
          
          opcPop:        Pop.Free;
          opcDup:
            begin
                if FTop < 1 then 
                  errMSG.callerror(94,'TVM.Run',CurrentLine, CurrentCol); 
                Push(FStack[FTop - 1].Clone);
            end;
            
          opcAdd: 
            begin 
                if (FTop >= 2) and (FStack[FTop-2].DataType = dtNumeric) and (FStack[FTop-1].DataType = dtNumeric) then
                begin
                  FStackLock.Acquire; 
                  try
                    TmpC := FStack[FTop-2];
                    a := FStack[FTop-1];
                    
                    // Alokasikan objek numerik baru untuk menggantikan slot stack tanpa mutasi langsung
                    FStack[FTop-2] := TValue.CreateNum(TmpC.FNumVal + a.FNumVal);
                    
                    Dec(FTop);
                    FStack[FTop] := nil;
                  finally
                    FStackLock.Release;
                  end;
                  
                  if Assigned(TmpC) then TmpC.Free; 
                  if Assigned(a) then a.Free; 
                end else 
                begin
                  b := Pop; 
                  try
                    a := Pop; 
                    try 
                        if (a.DataType = dtString) or (b.DataType = dtString) then
                          Push(Helper_MergeStrings(a, b)) 
                        else if (a.DataType = dtArray) and (b.DataType = dtArray) then
                          Push(Helper_MergeArrays(a, b))
                        else if (a.DataType = dtObject) then
                        begin
                          if a.ObjVal.Members.HasVar('__add__') or (a.ObjVal.Definition.Methods.IndexOf('__add__') <> -1) then
                            Push(CallMagicMethod(a, '__add__', [b]))
                          else
                            errMSG.callerror(95,'TVM.Run',CurrentLine, CurrentCol); 
                        end
                        else
                          errMSG.callerror(96,'TVM.Run',CurrentLine, CurrentCol); 
                    finally a.Free; end; 
                  finally b.Free; end;
                end;
            end;

          opcSub, opcMul, opcDiv, opcMod:
            begin 
                if (FTop >= 2) and (FStack[FTop-2].DataType = dtNumeric) and (FStack[FTop-1].DataType = dtNumeric) then
                begin
                  FStackLock.Acquire; // KUNCI MUTLAK: Amankan dari GC Marking dan Mutasi
                  try
                    case Inst.OpCode of
                      opcSub: FStack[FTop-2].FNumVal := FStack[FTop-2].FNumVal - FStack[FTop-1].FNumVal;
                      opcMul: FStack[FTop-2].FNumVal := FStack[FTop-2].FNumVal * FStack[FTop-1].FNumVal;
                      opcDiv: FStack[FTop-2].FNumVal := VM_SafeDivide(FStack[FTop-2].FNumVal, FStack[FTop-1].FNumVal);
                      opcMod: FStack[FTop-2].FNumVal := VM_SafeMod(FStack[FTop-2].FNumVal, FStack[FTop-1].FNumVal);
                    end;
                    
                    // PERBAIKAN: Pergeseran pointer dan pengambilan referensi harus di dalam Lock!
                    Dec(FTop);
                    TmpC := FStack[FTop]; 
                    FStack[FTop] := nil;
                  finally
                    FStackLock.Release;
                  end;
                  
                  // Pembebasan memori (Destructor) dilakukan dengan aman di luar Lock untuk menghindari Deadlock
                  if Assigned(TmpC) then TmpC.Free; 
                end else
                
                begin
                  // Penyatuan Fallback untuk optimasi cache CPU
                  b := Pop;  
                  try 
                    a := Pop;
                    try
                        if (Inst.OpCode = opcMul) and (a.DataType = dtString) and (b.DataType = dtNumeric) then
                          Push(Helper_StringMultiply(a.StrVal, Trunc(b.NumVal)))
                        else if (Inst.OpCode = opcMul) and (a.DataType = dtNumeric) and (b.DataType = dtString) then
                          Push(Helper_StringMultiply(b.StrVal, Trunc(a.NumVal)))
                        else if (a.DataType = dtObject) then
                        begin
                           case Inst.OpCode of
                             opcSub: StrKey := '__sub__';
                             opcMul: StrKey := '__mul__';
                             opcDiv: StrKey := '__div__';
                             opcMod: StrKey := '__mod__';
                           end;
                           if a.ObjVal.Members.HasVar(StrKey) or (a.ObjVal.Definition.Methods.IndexOf(StrKey) <> -1) then
                             Push(CallMagicMethod(a, StrKey, [b]))
                           else 
                             errMSG.callerror(97,'TVM.Run (Math Op tidak dikenali Object)',CurrentLine, CurrentCol);
                        end
                        else 
                          errMSG.callerror(97,'TVM.Run (Math Op)',CurrentLine, CurrentCol); 
                    finally a.Free; end;
                  finally b.Free; end; 
                end;
            end;

          opcEqual:    
            begin 
                b := Pop; 
                try 
                  a := Pop; 
                  try
                    // : Gunakan Helper Universal yang sudah ada
                    Push(TValue.CreateBool(ValuesAreEqual(a, b)));
                  finally
                    a.Free;
                  end;
                finally  
                  b.Free; 
                end; 
            end;
           
          opcLess, opcGreater, opcLessEq, opcGreaterEq:
            begin 
                b := Pop; 
                try 
                  a := Pop; 
                  try
                    if (a.DataType = dtNumeric) and (b.DataType = dtNumeric) then 
                    begin
                        case Inst.OpCode of
                          opcLess:        Push(TValue.CreateBool(a.NumVal < b.NumVal));
                          opcGreater:   Push(TValue.CreateBool(a.NumVal > b.NumVal));
                          opcLessEq:    Push(TValue.CreateBool(a.NumVal <= b.NumVal));
                          opcGreaterEq: Push(TValue.CreateBool(a.NumVal >= b.NumVal));
                        end;
                    end else 
                    if (a.DataType = dtString) and (b.DataType = dtString) then 
                    begin
                        case Inst.OpCode of
                          opcLess:        Push(TValue.CreateBool(a.StrVal < b.StrVal));
                          opcGreater:   Push(TValue.CreateBool(a.StrVal > b.StrVal));
                          opcLessEq:    Push(TValue.CreateBool(a.StrVal <= b.StrVal));
                          opcGreaterEq: Push(TValue.CreateBool(a.StrVal >= b.StrVal));
                        end;
                    end else 
                        errMSG.callerror(101,'TVM.Run',CurrentLine, CurrentCol); 
                  finally
                    a.Free; 
                  end;
                finally 
                  b.Free; 
                end; 
            end;

          opcNotEqual: 
            begin 
                b := Pop; 
                try 
                  a := Pop; 
                  try
                    // : Gunakan Helper Universal yang sudah ada dengan negasi
                    Push(TValue.CreateBool(not ValuesAreEqual(a, b)));
                  finally
                    a.Free;
                  end;
                finally  
                  b.Free; 
                end; 
            end; 
            
          opcIn:
            begin
                b := Pop; 
                a := Pop; 
                FoundItem := False;
                try
                  if b.DataType = dtArray then
                  begin
                    b.ArrayVal.FLock.Acquire;
                    try
                        for i := 0 to b.ArrayVal.Count - 1 do
                        begin
                          // --- : Gunakan Helper Universal ---
                          if ValuesAreEqual(a, b.ArrayVal[i]) then
                          begin
                            FoundItem := True;
                            Break;
                          end;
                        end;
                        Push(TValue.CreateBool(FoundItem));
                    finally b.ArrayVal.FLock.Release; end;
                  end
                  else if b.DataType = dtDict then
                  begin
                    if a.DataType <> dtString then 
                        errMSG.callerror(57,'TVM.Run',CurrentLine, CurrentCol); 
                   
                    Push(TValue.CreateBool(b.DictVal.HasKey(a.StrVal)));
                  end
                  else if b.DataType = dtString then
                  begin
                    if a.DataType <> dtString then 
                        errMSG.callerror(58,'TVM.Run',CurrentLine, CurrentCol); 
                    Push(TValue.CreateBool(Pos(a.StrVal, b.StrVal) > 0));
                  end
                  else 
                    errMSG.callerror(39,'TVM.Run',CurrentLine, CurrentCol); 
                finally
                  a.Free; b.Free;
                end;
            end;

          opcNegate:
            begin
                a := Pop;
                try
                  if a.DataType <> dtNumeric then 
                    errMSG.callerror(2,'TVM.Run',CurrentLine, CurrentCol); 
                  Push(TValue.CreateNum(-a.NumVal));
                finally a.Free; end;
            end;
            
          opcNot:
            begin
                a := Pop;
                try Push(TValue.CreateBool(not a.IsTrue)); finally a.Free; end;
            end;

          opcGetVar, opcGetGlobal:
            begin
              if (Inst.Operand < 0) or (Inst.Operand >= CurrentFrame^.Chunk.VarNames.Count) then
                errMSG.callerror(102, 'TVM.Run', CurrentLine, CurrentCol);
          
              VarName := CurrentFrame^.Chunk.VarNames[Inst.Operand];
              
              CacheSlot := @FGlobalCache[CurrentFrame^.IP - 1];
              
              if CacheSlot^.GValid
                 and (CacheSlot^.GVarName = VarName)
                 and (CacheSlot^.GItem <> nil)
                 and (CacheSlot^.GRoot = Pointer(CurrentFrame^.Env.GetGlobal))
                 and Assigned(CacheSlot^.GItem^.Value)
                 and (TSymbolTable(CacheSlot^.GRoot).Generation = CacheSlot^.GGen) then
              begin
                // ─── FAST PATH ───
                Push(CacheSlot^.GItem^.Value.Clone);
              end
              else
              begin
                // ─── SLOW PATH ───
                Push(CurrentFrame^.Env.GetVar(VarName));
                
                // Refresh cache: hanya cache jika entry ada di ROOT env
                LookupRoot := CurrentFrame^.Env.GetGlobal;
                LookupItem := LookupRoot.FindLocalEntry(VarName);
                
                if (LookupItem <> nil) and Assigned(LookupItem^.Value) then
                begin
                  CacheSlot^.GVarName := VarName;
                  CacheSlot^.GItem := LookupItem;
                  CacheSlot^.GRoot := Pointer(LookupRoot);
                  CacheSlot^.GGen := LookupRoot.Generation;
                  CacheSlot^.GValid := True;
                end
                else
                begin
                  // Bukan global — biarkan, next read akan retry
                  CacheSlot^.GValid := False;
                  CacheSlot^.GItem := nil;
                end;
              end;
            end;
            
          opcDefineVar, opcDefineGlobal, opcDefineConstGlobal:
            begin
              if (Inst.Operand < 0) or (Inst.Operand >= CurrentFrame^.Chunk.VarNames.Count) then
                errMSG.callerror(103, 'TVM.Run', CurrentLine, CurrentCol);
          
              VarName := CurrentFrame^.Chunk.VarNames[Inst.Operand];
              a := Pop;
              try
                CurrentFrame^.Env.DefineVar(VarName, a,
                  Inst.OpCode = opcDefineConstGlobal);
              except
                // DefineVar SUDAH Free(a) pada error path
                raise;
              end;
            end;

          opcDefineOrReplaceGlobal:
            begin
              if (Inst.Operand < 0) or (Inst.Operand >= CurrentFrame^.Chunk.VarNames.Count) then
                errMSG.callerror(103, 'TVM.Run', CurrentLine, CurrentCol);
              
              VarName := CurrentFrame^.Chunk.VarNames[Inst.Operand];
              a := Pop;
              try
                CurrentFrame^.Env.DefineOrReplaceVar(VarName, a, Inst.Operand2 = 1);
              except
                raise;
              end;
            end;
            
          opcSetVar, opcSetGlobal:
            begin
              if (Inst.Operand < 0) or (Inst.Operand >= CurrentFrame^.Chunk.VarNames.Count) then
                errMSG.callerror(104, 'TVM.Run', CurrentLine, CurrentCol);
          
              VarName := CurrentFrame^.Chunk.VarNames[Inst.Operand];
              a := Pop;
              try
                CurrentFrame^.Env.AssignVar(VarName, a);
              except
                // AssignVar SUDAH Free(a) pada error path — JANGAN Free lagi di sini
                raise;
              end;
            end;

          opcGetLocal: Push(FetchLocal(Inst.Operand));
          opcSetLocal: StoreLocal(Inst.Operand, Pop);

          opcPopLocals:
            begin
                for i := 1 to Inst.Operand do 
                begin
                  // PROTEKSI MEMORI: Hentikan pemotongan jika menyentuh batas aman frame saat ini
                  if FTop <= CurrentFrame^.BaseSlot then Break; 
                  
                  Dec(FTop);
                  if Assigned(FStack[FTop]) then 
                  begin
                    FStack[FTop].Free;
                    FStack[FTop] := nil;
                  end;
                end;
            end;
            
          opcPopLocalsKeepTop:
            begin
              FStackLock.Acquire; 
              try
                if FTop <= CurrentFrame^.BaseSlot then
                  errMSG.callerror(107,'TVM.Run',CurrentLine, CurrentCol); 
                 
                Dec(FTop);
                ResultVal := FStack[FTop]; // Amankan Return Value
                FStack[FTop] := nil;
                
                i := FTop - Inst.Operand;
                if i < CurrentFrame^.BaseSlot then 
                  i := CurrentFrame^.BaseSlot;
                  
                while FTop > i do 
                begin
                  Dec(FTop);
                  if Assigned(FStack[FTop]) then 
                  begin
                    FStack[FTop].Free; // Bebaskan instan! Tanpa Array sementara.
                    FStack[FTop] := nil;
                  end;
                end;
                
                FStack[FTop] := ResultVal; // Kembalikan Return Value ke puncak stack
                Inc(FTop);
              finally
                FStackLock.Release;
              end;
            end;

          opcJump: 
            begin
                if (CurrentFrame^.IP + Inst.Operand < 0) or (CurrentFrame^.IP + Inst.Operand > CurrentFrame^.Chunk.CodeCount) then
                  errMSG.callerror(108,'TVM.Run',CurrentLine, CurrentCol); 
                
                Inc(CurrentFrame^.IP, Inst.Operand);
            end;
            
          opcJumpIfFalse:
            begin
                a := Pop;
                if not a.IsTrue then 
                begin
                  if (CurrentFrame^.IP + Inst.Operand < 0) or (CurrentFrame^.IP + Inst.Operand > CurrentFrame^.Chunk.CodeCount) then
                  begin
                    a.Free;
                    errMSG.callerror(108,'TVM.Run',CurrentLine, CurrentCol); 
                  end;
                  Inc(CurrentFrame^.IP, Inst.Operand);
                end;
                a.Free;
            end;

          opcCall:
            begin
                ArgCount := Inst.Operand;
                
                if (FTop < ArgCount + 1) or (FTop < 1) then 
                  errMSG.callerror(109, 'TVM.Run (Stack Underflow pada pemanggilan fungsi)', errMSG.xrow, errMSG.xcol); 
                  
                i := FTop - ArgCount - 1; 
                if (i < 0) or (i >= STACK_MAX) then
                  errMSG.callerror(109, 'TVM.Run (Pointer Stack Korup)', errMSG.xrow, errMSG.xcol);

                a := FStack[i]; 

                if a.DataType = dtNative then
                begin
                  EvalArgs := TObjectList.Create(False); 
                  try
                    for MethodIdx := i + 1 to FTop - 1 do 
                        EvalArgs.Add(FStack[MethodIdx]); 
                        
                    ResultVal := nil;
                    try
                        ResultVal := a.NativeFunc(EvalArgs, CurrentFrame^.Env); 
                    finally
                        CleanStackTo(i); 
                    end;
                    
                    Push(ResultVal);
                  finally 
                    EvalArgs.Free; 
                  end;
                end
                else if a.DataType = dtFunction then
                begin
                  SetupFrame(a, ArgCount, i + 1);
                end
                else if (a.DataType = dtDict) and 
                        a.DictVal.HasKey('__ffi_raw') and
                        a.DictVal.HasKey('__ffi_sig') then
                begin
                  // ✨ PHASE 5: FFI call
                  SetLength(ArgArr, ArgCount);
                  for MethodIdx := 0 to ArgCount - 1 do
                    ArgArr[MethodIdx] := FStack[i + 1 + MethodIdx];
                  
                  try
                    ResultVal := CallFFIWrapped(a.DictVal, ArgArr);
                  finally
                    CleanStackTo(i);
                  end;
                  
                  Push(ResultVal);
                end
                else 
                  errMSG.callerror(110, 'TVM.Run (Target bukan fungsi)', errMSG.xrow, errMSG.xcol);             
            
            end;

          opcTailCall:
            begin
                ArgCount := Inst.Operand;
                if (FTop < ArgCount + 1) or (FTop < 1) then 
                  errMSG.callerror(109, 'TVM.Run (Stack Underflow pada pemanggilan fungsi)', errMSG.xrow, errMSG.xcol); 
                  
                i := FTop - ArgCount - 1; 
                if (i < 0) or (i >= STACK_MAX) then
                  errMSG.callerror(109, 'TVM.Run (Pointer Stack Korup)', errMSG.xrow, errMSG.xcol);

                a := FStack[i]; 
                
                if a.DataType = dtNative then
                begin
                  EvalArgs := TObjectList.Create(False); 
                  try
                    for MethodIdx := i + 1 to FTop - 1 do EvalArgs.Add(FStack[MethodIdx]); 
                    
                    try
                      ResultVal := a.NativeFunc(EvalArgs, CurrentFrame^.Env); 
                    finally
                      CleanStackTo(i);
                    end;
                    
                    if Assigned(ResultVal) then
                    begin
                      TargetObj := ResultVal.DeepClone; 
                      ResultVal.Free; 
                    end else TargetObj := TValue.CreateNull;

                    TeardownCurrentFrame; 
                    if FFrameCount = 0 then begin Result := TargetObj; Exit; end;
                    
                    Push(TargetObj); 
                    CurrentFrame := @FFrames[FFrameCount - 1]; 
                  finally EvalArgs.Free; end;
                end else 
                if a.DataType = dtFunction then
                begin
                  SetLength(ArgArr, math.Max(ArgCount, Length(a.FuncVal.Params))); 
                  TargetObj := a.Clone; 
                  TempScope := nil; // Inisialisasi untuk proteksi
                  
                  try
                    for MethodIdx := 0 to ArgCount - 1 do
                        ArgArr[MethodIdx] := FStack[i + 1 + MethodIdx].Clone; 
                  
                    if Assigned(TargetObj.BoundSelf) then
                    begin
                      if Assigned(TargetObj.ClosureEnv) then TempScope := TSymbolTable.Create(TargetObj.ClosureEnv)
                      else TempScope := TSymbolTable.Create(FEnv.GetGlobal);
                      TempScope.DefineVar('self', TargetObj.BoundSelf.Clone);
                      TempScope.Retain; 
                    end else
                    begin
                      if Assigned(TargetObj.ClosureEnv) then TempScope := TargetObj.ClosureEnv
                      else TempScope := FEnv.GetGlobal;
                      TempScope.Retain; 
                    end;    
   
                    for MethodIdx := ArgCount to Length(TargetObj.FuncVal.Params) - 1 do
                    begin
                      if Assigned(TargetObj.FuncVal.Params[MethodIdx].DefaultChunk) then
                      begin
                        ParamVM := TVM.Create(TempScope);
                        try 
                          ArgArr[MethodIdx] := ParamVM.Run(TargetObj.FuncVal.Params[MethodIdx].DefaultChunk);
                        finally 
                          ParamVM.Free; 
                        end;
                      end
                      else ArgArr[MethodIdx] := TValue.CreateNull;
                    end;
                    
                    CleanStackTo(CurrentFrame^.BaseSlot - 1);
                    
                    Push(TargetObj); 
                    for MethodIdx := 0 to High(ArgArr) do 
                    begin
                      Push(ArgArr[MethodIdx]); 
                      ArgArr[MethodIdx] := nil; 
                    end;
                    
                  except
                    // PERBAIKAN 2: Tangkap dan bersihkan SEMUA alokasi jika default params gagal
                    if Assigned(TempScope) then TempScope.Release;
                    TargetObj.Free;
                    for MethodIdx := 0 to High(ArgArr) do if Assigned(ArgArr[MethodIdx]) then ArgArr[MethodIdx].Free;
                    SetLength(ArgArr, 0);
                    raise; 
                  end;
                  
                  CurrentFrame^.Env.Release; 
                  CurrentFrame^.Env := TempScope;
                  
                  CurrentFrame^.FuncValue := TargetObj.Clone; 
                  
                  if Assigned(FActiveChunks) 
                     and Assigned(CurrentFrame^.Chunk) 
                     and (FFrameCount > 1) then
                  begin
                    for Scan := FActiveChunks.Count - 1 downto 0 do
                    begin
                      if Pointer(FActiveChunks[Scan]) = Pointer(CurrentFrame^.Chunk) then
                      begin
                        FActiveChunks.Delete(Scan);
                        CurrentFrame^.Chunk.ReleaseUse;
                        Break;
                      end;
                    end;
                  end;
                  
                  CurrentFrame^.Chunk := TargetObj.FuncVal.Chunk;
                  CurrentFrame^.IP := 0; 
                  
                  // AcquireUse chunk baru untuk tracking
                  if Assigned(CurrentFrame^.Chunk) then
                  begin
                    CurrentFrame^.Chunk.AcquireUse;
                    if not Assigned(FActiveChunks) then
                      FActiveChunks := TList.Create;
                    FActiveChunks.Add(CurrentFrame^.Chunk);
                    EnsureInlineCache(CurrentFrame^.Chunk.CodeCount);
                  end;    
                  
                  SetLength(ArgArr, 0);
                end

                else errMSG.callerror(110, 'TVM.Run (TailCall)', errMSG.xrow, errMSG.xcol); 
            end;

          opcHalt:
            begin
                // FIX KRITIS: Teardown semua frame sampai root sebelum keluar.
                // Tanpa ini, Env dan FuncValue pada frame non-root akan bocor
                // ketika opcHalt dipanggil dari dalam fungsi (mis. sys.exit()).
                while FFrameCount > 1 do
                begin
                  CurrentFrame := @FFrames[FFrameCount - 1];
                  TeardownCurrentFrame;
                end;
                
                // ✅ TAHAP A — BUG-5: Ambil nilai teratas stack sebagai Result.
                //    Sebelumnya nilai ini dibuang dan selalu di-set ke Null,
                //    sehingga return value dari TempChunk wrapper (mis. di
                //    TScriptThread.Execute) hilang.
                if FTop > 0 then
                begin
                  Dec(FTop);
                  Result := FStack[FTop];
                  FStack[FTop] := nil;
                  if not Assigned(Result) then
                    Result := TValue.CreateNull;
                end
                else
                  Result := TValue.CreateNull;
                
                FHasResult := True;
                Break;
            end;
            
          opcBuildArray:
            begin
                ArgCount := Inst.Operand; 
                if FTop < ArgCount then errMSG.callerror(111,'TVM.Run',CurrentLine, CurrentCol); 
                if ArgCount > arrMax then errMSG.callerror(112,'TVM.Run',CurrentLine, CurrentCol); 

                SetLength(ArgArr, ArgCount); 
                FStackLock.Acquire; 
                try
                  for i := 0 to ArgCount - 1 do 
                  begin
                    ArgArr[i] := FStack[FTop - ArgCount + i];
                    FStack[FTop - ArgCount + i] := nil; 
                  end;
                  Dec(FTop, ArgCount); 
                finally
                  FStackLock.Release;
                end;

                a := TValue.CreateArray(TValueList.Create(True));
                try 
                  a.ArrayVal.Capacity := Max(a.ArrayVal.Capacity, ArgCount); 
                  for i := 0 to ArgCount - 1 do
                  begin
                    if Assigned(ArgArr[i]) then 
                    begin
                      a.ArrayVal.Add(ArgArr[i]);
                      // PERBAIKAN 1: Putuskan referensi lokal agar aman jika terjadi eksepsi
                      ArgArr[i] := nil; 
                    end
                    else a.ArrayVal.Add(TValue.CreateNull);
                  end;
                  SetLength(ArgArr, 0);
                except
                  for i := 0 to ArgCount - 1 do if Assigned(ArgArr[i]) then ArgArr[i].Free;
                  a.Free; 
                  raise;
                end;
                Push(a); 
            end;

          opcBuildDict:
            begin
                ArgCount := Inst.Operand * 2;
                if FTop < ArgCount then errMSG.callerror(120,'TVM.Run',CurrentLine, CurrentCol); 
                if Inst.Operand > arrMax then errMSG.callerror(121,'TVM.Run',CurrentLine, CurrentCol); 
          
                SetLength(ArgArr, ArgCount);
                FStackLock.Acquire;
                try
                  i := FTop - ArgCount;
                  for MethodIdx := 0 to ArgCount - 1 do
                  begin
                    ArgArr[MethodIdx] := FStack[i + MethodIdx];
                    FStack[i + MethodIdx] := nil;
                  end;
                  Dec(FTop, ArgCount);
                finally
                  FStackLock.Release;
                end;
                
                a := TValue.CreateDict(TDictValue.Create);
                try 
                  i := 0;
                  while i < ArgCount do
                  begin
                    if ArgArr[i].DataType <> dtString then errMSG.callerror(122,'TVM.Run',CurrentLine, CurrentCol); 
                    a.DictVal.SetValue(ArgArr[i].StrVal, ArgArr[i+1].Clone);
          
                    ArgArr[i].Free;     
                    ArgArr[i] := nil;   // <-- PERBAIKAN: Menghapus pointer agar aman di blok except
                    ArgArr[i+1].Free;   
                    ArgArr[i+1] := nil; // <-- PERBAIKAN: Menghapus pointer
                    Inc(i, 2);
                  end;
                  SetLength(ArgArr, 0);
                except
                  for MethodIdx := 0 to ArgCount - 1 do 
                    if Assigned(ArgArr[MethodIdx]) then ArgArr[MethodIdx].Free;
                  a.Free;
                  raise;
                end;
                Push(a); 
            end;

          opcGetIndex:
            begin
                b := Pop; 
                a := Pop; 
                try
                  if a.DataType = dtArray then
                  begin
                    if b.DataType <> dtNumeric then errMSG.callerror(6,'TVM.Run',CurrentLine, CurrentCol); 
                    
                    i := Trunc(b.NumVal);
                    TempVal := nil; 
                    
                    a.ArrayVal.FLock.Acquire;
                    try
                        if i < 0 then i := a.ArrayVal.Count + i; 
                        
                        if (i >= 0) and (i < a.ArrayVal.Count) and Assigned(a.ArrayVal[i]) then 
                          TempVal := a.ArrayVal[i].Clone
                        else TempVal := TValue.CreateNull;
                    finally a.ArrayVal.FLock.Release; end;
                    
                    Push(TempVal); 
                  end else 
                  if a.DataType = dtDict then
                  begin
                    if b.DataType <> dtString then errMSG.callerror(50,'TVM.Run',CurrentLine, CurrentCol); 
                    
                    TempVal := a.DictVal.GetValue(b.StrVal);
                    // PERBAIKAN LOGIKA: Harus di Clone untuk menjaga independensi objek di stack!
                    if Assigned(TempVal) then Push(TempVal.Clone) else Push(TValue.CreateNull);
                  end else 
                  if a.DataType = dtString then
                  begin
                    i := Trunc(b.NumVal);
                    if i < 0 then i := Length(a.StrVal) + i;
                    
                    if (i < 0) or (i >= Length(a.StrVal)) then errMSG.callerror(49,'TVM.Run',CurrentLine, CurrentCol); 
                    Push(TValue.CreateStr(a.StrVal[i + 1]));
                  end else 
                  if (a.DataType = dtObject) and (a.ObjVal.Members.HasVar('__getitem__') or (a.ObjVal.Definition.Methods.IndexOf('__getitem__') <> -1)) then
                    Push(CallMagicMethod(a, '__getitem__', [b]))
                  else errMSG.callerror(4,'TVM.Run',CurrentLine, CurrentCol); 

                finally a.Free; b.Free; end;
            end;

          opcSetIndex:
            begin
                c := nil; b := nil; a := nil; TargetObj := nil; 
                try
                  FStackLock.Acquire;
                  try
                    if FTop < 3 then 
                      raise EScriptFatalError.CreateFmt('VM PANIC (Error 84): Stack Underflow di SetIndex pada Baris %d', [CurrentLine]);
                    
                    Dec(FTop); c := FStack[FTop]; FStack[FTop] := nil;
                    Dec(FTop); b := FStack[FTop]; FStack[FTop] := nil;
                    Dec(FTop); a := FStack[FTop]; FStack[FTop] := nil;
                  finally FStackLock.Release; end;
                  
                  StrKey := CurrentFrame^.Chunk.Constants[Inst.Operand].StrVal; 
                  
                  if a.DataType = dtArray then
                  begin
                    if b.DataType <> dtNumeric then errMSG.callerror(6, 'TVM.Run', CurrentLine, CurrentCol); 
                        
                    i := Trunc(b.NumVal);
                    a.ArrayVal.FLock.Acquire;
                    try
                        if i < 0 then i := a.ArrayVal.Count + i;
                        if (i < 0) or (i >= arrMax) then errMSG.callerror(7, 'TVM.Run', CurrentLine, CurrentCol); 

                        if a.ArrayVal.Count <= i then a.ArrayVal.Capacity := Max(a.ArrayVal.Capacity, i + 1);
                        while a.ArrayVal.Count <= i do a.ArrayVal.Add(TValue.CreateNull);
                        
                        if (StrKey <> '') and (StrKey <> '=') then
                        begin
                           if Assigned(a.ArrayVal.Items[i]) then TargetObj := a.ArrayVal.Items[i].Clone
                           else TargetObj := TValue.CreateNull;
                           
                           try
                              try 
                                TmpC := VM_CompoundOp(StrKey, TargetObj, c); 
                              except 
                                c.Free; c := nil; 
                                raise; 
                              end;
                              c.Free; c := TmpC;
                           finally 
                              if Assigned(TargetObj) then TargetObj.Free; TargetObj := nil; 
                           end;
                        end;
                        
                        a.ArrayVal.Items[i] := c.Clone;
                        if a.ArrayVal.FGCState = gcBlack then a.ArrayVal.Items[i].Mark;
                    finally a.ArrayVal.FLock.Release; end;
                  end else 

                  if a.DataType = dtDict then
                  begin
                    if b.DataType <> dtString then 
                      errMSG.callerror(50, 'TVM.Run', CurrentLine, CurrentCol); 
                  
                    if (StrKey <> '') and (StrKey <> '=') then
                    begin
                      TargetObj := nil;
                      TempVal := a.DictVal.CompoundAssign(b.StrVal, StrKey, c, TargetObj);
                      
                      // Free OldVal
                      if Assigned(TargetObj) then
                      begin
                        TargetObj.Free;
                        TargetObj := nil;
                      end;
                      
                      // c dikonsumsi oleh CompoundAssign di caller — free di sini
                      c.Free;
                      c := TempVal;
                      TempVal := nil;
                    end else
                    begin
                      a.DictVal.SetValue(b.StrVal, c.Clone);
                    end;
                  end
                  
                  else errMSG.callerror(123, 'TVM.Run', CurrentLine, CurrentCol); 
                  
                  Push(c.Clone);
                finally
                  if Assigned(a) then a.Free; 
                  if Assigned(b) then b.Free; 
                  if Assigned(c) then c.Free;
                end;
            end;

          opcToIterArray:
            begin
                a := Pop;
                try
                  IterArr := TValueList.Create(True);
                  try
                    if a.DataType = dtArray then
                    begin
                        a.ArrayVal.FLock.Acquire;
                        try
                          for i := 0 to a.ArrayVal.Count - 1 do IterArr.Add(a.ArrayVal[i].Clone);
                        finally a.ArrayVal.FLock.Release; end;
                    end else 
                    if a.DataType = dtDict then
                    begin
                        TempKeys := a.DictVal.GetKeys;
                        for i := 0 to High(TempKeys) do IterArr.Add(TValue.CreateStr(TempKeys[i]));
                    end else 
                    if a.DataType = dtString then
                    begin
                        i := 1;
                        while i <= Length(a.StrVal) do 
                        begin
                          idx := GetUTF8CharLen(a.StrVal, i);
                          // FIX: Failsafe jika karakter string malformed/corrupted
                          if idx <= 0 then idx := 1; 
                          
                          IterArr.Add(TValue.CreateStr(Copy(a.StrVal, i, idx)));
                          Inc(i, idx);
                        end;
                    end

                    else errMSG.callerror(124,'TVM.Run (Tipe data tidak bisa diiterasi)',CurrentLine, CurrentCol); 
                    
                    b := TValue.CreateArray(IterArr);
                  except IterArr.Free; raise; end;
                finally a.Free; end;
                Push(b); 
            end;

          opcSlice:
            begin
                VStep := nil; VEnd := nil; VStart := nil; a := nil;
                try
                  VStep := Pop; VEnd := Pop; VStart := Pop; a := Pop; 
                  Push(Helper_SliceData(a, VStart, VEnd, VStep));
                finally
                  if Assigned(VStep) then VStep.Free; 
                  if Assigned(VEnd) then VEnd.Free; 
                  if Assigned(VStart) then VStart.Free; 
                  if Assigned(a) then a.Free;
                end;
            end;

          opcGetProp:
            begin
              a := Pop;
              StrKey := CurrentFrame^.Chunk.Constants[Inst.Operand].StrVal;
              try
                if (a.DataType = dtObject) and Assigned(a.ObjVal) then
                begin
                  // ✅ ALWAYS SAFE PATH — hapus cache branch
                  if a.ObjVal.Members.HasVar(StrKey) then
                    Push(a.ObjVal.Members.GetVar(StrKey))
                  else
                  begin
                    MethodIdx := a.ObjVal.Definition.Methods.IndexOf(StrKey);
                    if MethodIdx <> -1 then
                      Push(TValue.CreateFunc(a.ObjVal.Definition.Methods.Data[MethodIdx],
                                              nil, a.Clone))
                    else
                      Push(Helper_GetNativeProperty(a, StrKey));
                  end;
                end
                else
                  Push(Helper_GetNativeProperty(a, StrKey));
              finally
                a.Free;
              end;
            end;

          opcSetProp: 
            begin
                c := Pop; a := Pop;
                StrKey := CurrentFrame^.Chunk.Constants[Inst.Operand].StrVal;
                VarName := CurrentFrame^.Chunk.Constants[Inst.Operand2].StrVal;
                try
                  if (a.DataType = dtObject) and Assigned(a.ObjVal) then begin
                    if (VarName <> '') and (VarName <> '=') then begin
                        if a.ObjVal.Members.HasVar(StrKey) then TargetObj := a.ObjVal.Members.GetVar(StrKey) else TargetObj := TValue.CreateNull;
                        try
                          TempVal := VM_CompoundOp(VarName, TargetObj, c);
                          c.Free; c := TempVal;
                        finally TargetObj.Free; end;
                    end;
                    a.ObjVal.Members.AssignVar(StrKey, c.Clone);
                    Push(c.Clone);
                  end else if a.DataType = dtDict then begin
                    if (VarName <> '') and (VarName <> '=') then 
                    begin
                      // ✅ FIX P1.5: Gunakan CompoundAssign untuk atomicity
                      TargetObj := nil;
                      TempVal := a.DictVal.CompoundAssign(StrKey, VarName, c, TargetObj);
                      
                      // Free OldVal
                      if Assigned(TargetObj) then
                      begin
                        TargetObj.Free;
                        TargetObj := nil;
                      end;
                      
                      // c dikonsumsi di dalam — free di sini
                      c.Free;
                      c := TempVal;
                      TempVal := nil;
                      
                      Push(c.Clone);
                    end else
                    begin
                      a.DictVal.SetValue(StrKey, c.Clone);
                      Push(c.Clone);
                    end;
                  end else errMSG.callerror(125,'TVM.Run',CurrentLine, CurrentCol); 
                finally a.Free; c.Free; end;
            end;

          opcMethodCall:
            begin
                StrKey := CurrentFrame^.Chunk.Constants[Inst.Operand].StrVal; 
                ArgCount := Inst.Operand2; 
                if FTop < ArgCount + 1 then errMSG.callerror(109,'TVM.Run',CurrentLine, CurrentCol); 
                HandleMethodCall(False, ArgCount, StrKey);
            end;

          opcBindClosure:
            begin
              a := Pop;
              try
                if a.DataType = dtFunction then
                begin
                  ResultVal := TValue.CreateFunc(
                    a.FuncVal,
                    CurrentFrame^.Env,
                    a.BoundSelf
                  );
          
                  // FIX C-03: Jangan self-register function ke env-nya sendiri.
                  // Ini menciptakan reference cycle dan merusak GC.
                  // Recursive function di dalam closure TIDAK butuh self-register
                  // karena nama fungsi sudah di-resolve via opcGetLocal pada slot
                  // tempat ia dibuat — ini sudah di-emit compiler via `AddLocal`.
                  //
                  // Jika compiler memerlukan akses rekursif lewat nama, itu
                  // ditangani oleh parent scope / global env, bukan env ini.
          
                  Push(ResultVal);
                  ResultVal := nil;
                end
                else
                  Push(a.Clone);
              finally
                if Assigned(ResultVal) then
                begin
                  ResultVal.Free;
                  ResultVal := nil;
                end;
                a.Free;
              end;
            end;

          opcNewObject:
            begin
                StrKey := CurrentFrame^.chunk.Constants[Inst.Operand].StrVal; 
                ArgCount := Inst.Operand2;

                SetLength(ArgArr, ArgCount);
                for i := ArgCount - 1 downto 0 do ArgArr[i] := Pop;

                TargetObj := CurrentFrame^.Env.GetVar(StrKey); 
                try
                  if (not Assigned(TargetObj)) or (TargetObj.DataType <> dtClassDef) then
                    errMSG.callerror(128, 'TVM.Run (Class tidak ditemukan atau tidak valid: ' + StrKey + ')', CurrentLine, CurrentCol); 

                  a := TValue.CreateObj(TInstanceValue.Create(TargetObj.ClassDefVal));
                  try 
                    for i := 0 to TargetObj.ClassDefVal.Fields.Count - 1 do
                        a.ObjVal.Members.DefineVar(TargetObj.ClassDefVal.Fields[i], TValue.CreateNull);

                    i := TargetObj.ClassDefVal.Methods.IndexOf('create');
                    if i <> -1 then
                    begin
                        b := TValue.CreateFunc(TargetObj.ClassDefVal.Methods.Data[i], nil, a.Clone);
                        try
                          TempScope := TSymbolTable.Create(FEnv.GetGlobal);
                          TempScope.DefineVar('self', a.Clone);
                          
                          ParamVM := TVM.Create(TempScope);
                          TempChunk := TChunk.Create;
                          try
                            TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(b.Clone));
                            for MethodIdx := 0 to ArgCount - 1 do TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(ArgArr[MethodIdx].Clone));
                            TempChunk.AddInstruction(opcCall, ArgCount);
                            TempChunk.AddInstruction(opcHalt);
                            ParamVM.Run(TempChunk).Free; 
                          finally TempChunk.Free; ParamVM.Free; TempScope.Release; end;
                        finally b.Free; end;
                    end else 
                    begin
                        if ArgCount > 0 then errMSG.callerror(129,'TVM.Run',CurrentLine, CurrentCol); 
                    end;
                    Push(a); 
                  except a.Free; raise; end;
                finally
                  if Assigned(TargetObj) then TargetObj.Free; 
                  for i := 0 to ArgCount - 1 do ArgArr[i].Free;
                end;
            end;
            
          opcInheritClass:
            begin
                if FTop < 2 then errMSG.callerror(130,'TVM.Run',CurrentLine, CurrentCol); 
                b := Pop; 
                a := Pop; // PERBAIKAN: Pop 'a' agar stack seimbang
                
                try
                  if (a.DataType = dtClassDef) and (b.DataType = dtClassDef) then
                  begin
                    NewDef := TTypeDefinition.Create(a.ClassDefVal.Name, a.ClassDefVal.Kind);
                    for i := 0 to a.ClassDefVal.Fields.Count - 1 do NewDef.Fields.Add(a.ClassDefVal.Fields[i]);
                        
                    for i := 0 to a.ClassDefVal.Methods.Count - 1 do
                    begin
                        NewDef.Methods.Add(a.ClassDefVal.Methods.Keys[i], a.ClassDefVal.Methods.Data[i]);
                        a.ClassDefVal.Methods.Data[i].Retain; 
                    end;

                    for i := 0 to b.ClassDefVal.Fields.Count - 1 do
                        if NewDef.Fields.IndexOf(b.ClassDefVal.Fields[i]) = -1 then NewDef.Fields.Add(b.ClassDefVal.Fields[i]);

                    for i := 0 to b.ClassDefVal.Methods.Count - 1 do
                    begin
                        StrKey := b.ClassDefVal.Methods.Keys[i];
                        if NewDef.Methods.IndexOf(StrKey) = -1 then
                        begin
                          NewDef.Methods.Add(StrKey, b.ClassDefVal.Methods.Data[i]);
                          b.ClassDefVal.Methods.Data[i].Retain;
                        end;
                    end;
                    
                    a.ClassDefVal.Release;
                    NewDef.Retain; 
                    a.FClassDefVal := NewDef; 
                    
                    Push(a.Clone); // Kembalikan definisi kelas yang telah diperbarui ke Stack
                  end else errMSG.callerror(131,'TVM.Run',CurrentLine, CurrentCol); 
                finally 
                  a.Free;
                  b.Free; 
                end;
            end;

          opcBuildRecord:
            begin
                a := Pop; 
                try
                  if a.DataType <> dtClassDef then errMSG.callerror(132,'TVM.Run',CurrentLine, CurrentCol); 
                   
                  TargetObj := TValue.CreateObj(TInstanceValue.Create(a.ClassDefVal));
                  try
                    for i := 0 to a.ClassDefVal.Fields.Count - 1 do TargetObj.ObjVal.Members.DefineVar(a.ClassDefVal.Fields[i], TValue.CreateNull);
                    Push(TargetObj);
                  except
                    if Assigned(TargetObj) then TargetObj.Free;
                    raise;
                  end;
                finally a.Free; end;
            end;
            
          opcReturn:
            begin
                ResultVal := Pop; 
                
                try
                  TeardownCurrentFrame;
                except
                  if Assigned(ResultVal) then
                  begin
                    ResultVal.Free;
                    ResultVal := nil;
                  end;
                  raise;
                end;
                
                if FFrameCount = 0 then
                begin
                  Result := ResultVal;
                  // D.1 fix: Break (bukan Exit) → FState := vmDead execute.
                  // FHasResult := True → bottom tidak overwrite Result dgn Null.
                  FHasResult := True;
                  Break;
                end;
                
                Push(ResultVal); 
                CurrentFrame := @FFrames[FFrameCount - 1];             
            end;

          opcReturnNull:
            begin
              ResultVal := TValue.CreateNull;
              try
                TeardownCurrentFrame;
              except
                if Assigned(ResultVal) then
                begin
                  ResultVal.Free;
                  ResultVal := nil;
                end;
                raise;
              end;
              
              if FFrameCount = 0 then
              begin
                Result := ResultVal;
                Exit;
              end;
              
              Push(ResultVal);
              CurrentFrame := @FFrames[FFrameCount - 1];
            end;
            
          opcThrow:
            begin
              a := Pop;
              try
                raise EScriptUserThrow.Create(a);
              except
                // Ownership sudah pindah ke exception object — jangan Free a
                raise;
              end;
            end;
  
          opcYield:
            begin
                ResultVal := Pop; 
                FState := vmYielded;
                Result := ResultVal; 
                Exit; 
            end;
           
          opcImport:
            begin
                a := Pop; 
                try
                  if a.DataType <> dtString then errMSG.callerror(31,'TVM.Run',CurrentLine, CurrentCol); 
            
                  // ✅ Fase D: resolusi package import
                  if IsPackageImport(a.StrVal) then
                  begin
                    StrKey := ResolvePackageImport(a.StrVal, CurrentFrame^.Chunk.SourceFile);
                    if StrKey = '' then
                      errMSG.callerror(36,
                        'import: package "' + a.StrVal + '" tidak ditemukan. ' +
                        'Jalankan `pkg.install` dulu, atau pastikan folder ' +
                        '`packages/` ada di project root (dekat pascak.json).',
                        CurrentLine, CurrentCol);
                  end
                  else
                    StrKey := GetSafeSandboxedPath(a.StrVal, CurrentFrame^.Chunk.SourceFile);
                  
                  // akses ModuleManager via context
                  if Assigned(FContext) and Assigned(FContext.ModuleManager) then
                  
                  VarName := LoadScriptFromFile(StrKey); 
                  if VarName = '' then 
                    errMSG.callerror(133,'TVM.Run',CurrentLine, CurrentCol); 
                  
                  TempScope := TSymbolTable.Create(FEnv.GetGlobal); 
                  ParamVM := TVM.Create(TempScope); 
                  TempChunk := nil;
                  try
                      with TParser.Create(TLexer.Create(VarName)) do
                      try
                        with TCompiler.Create do
                        try
                          Compile(ParseMainProgram, True);
                          Chunk.OptimizeBytecode; 
                          
                          Chunk.SourceFile := StrKey; 
                          TempChunk := Chunk; 
                          ParamVM.Run(TempChunk).Free;
                          
                          // FIX: Kosongkan referensi TempChunk agar blok finally di bawah tidak 
                          // menghancurkan bytecode yang sekarang sedang dipakai oleh modul ter-ekspor
                          TempChunk := nil; 
                          
                        finally Free; end;
                      finally FLexer.Free; Free; end;

                      ErrDict := TempScope.GetExportedDict; 
                      TargetObj := TValue.CreateDict(ErrDict); 
                      Push(TargetObj);
                      
                      if Assigned(FContext) and Assigned(FContext.ModuleManager) then
                        FContext.ModuleManager.AddModule(StrKey, ErrDict);
                  
                  finally
                    ParamVM.Free;
                    TempScope.Release; 
                    // Jika terjadi error saat eksekusi modul, blok di bawah tetap aman membuang sampah
                    if Assigned(TempChunk) then TempChunk.Free; 
                  end;
               finally a.Free; end;
            end;

          opcSpread:
            begin
                errMSG.callerror(144, 'Instruksi opcSpread telah dihentikan, harusnya dibungkus oleh opcCallSpread di fase Compile', CurrentLine, CurrentCol);
            end;

          opcCallSpread:
            begin
                b := Pop;
                try
                  PushSpreadArray(b);
                  ArgCount := Inst.Operand + b.ArrayVal.Count; 
                finally b.Free; end;

                if (FTop < ArgCount + 1) or (FTop < 1) then errMSG.callerror(109, 'TVM.Run (Stack Underflow pada pemanggilan fungsi)', CurrentLine, CurrentCol); 
                  
                i := FTop - ArgCount - 1; 
                if (i < 0) or (i >= STACK_MAX) then errMSG.callerror(109, 'TVM.Run (Pointer Stack Korup)', CurrentLine, CurrentCol);

                a := FStack[i]; 
  
                if a.DataType = dtNative then
                begin
                  EvalArgs := TObjectList.Create(False); 
                  try
                    for MethodIdx := i + 1 to FTop - 1 do EvalArgs.Add(FStack[MethodIdx]); 
                    ResultVal := nil;
                    try ResultVal := a.NativeFunc(EvalArgs, CurrentFrame^.Env); 
                    finally CleanStackTo(i); end;
                    Push(ResultVal);
                  finally EvalArgs.Free; end;
                end
                else if a.DataType = dtFunction then SetupFrame(a, ArgCount, i + 1)
                else errMSG.callerror(110, 'TVM.Run (Target bukan fungsi)', CurrentLine, CurrentCol); 
            end;

          opcMethodCallSpread:
            begin
                StrKey := CurrentFrame^.Chunk.Constants[Inst.Operand].StrVal; 
                b := Pop; 
                try
                  PushSpreadArray(b); 
                  ArgCount := Inst.Operand2 + b.ArrayVal.Count; 
                finally b.Free; end;
                if FTop < ArgCount + 1 then errMSG.callerror(109,'TVM.Run',CurrentLine, CurrentCol);
                HandleMethodCall(True, ArgCount, StrKey);
            end;  
            
          opcIncrLocal:
            begin
              if (Inst.Operand < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand >= STACK_MAX) then                 
                errMSG.callerror(105,'TVM.Run (opcIncrLocal: operand out of bounds)',CurrentLine,CurrentCol);
                
              TmpC := FStack[CurrentFrame^.BaseSlot + Inst.Operand];
              if (TmpC <> nil) and (TmpC.DataType = dtNumeric) then
              begin
                // FAST PATH: langsung mutasi Double
                TmpC.FNumVal := TmpC.FNumVal + 1.0;
              end
              else
              begin
                // SLOW PATH: null atau non-numeric → coerce ke 0 lalu +1
                if TmpC <> nil then TmpC.Free;
                FStack[CurrentFrame^.BaseSlot + Inst.Operand] := TValue.CreateNum(1.0);
              end;
            end;
          
          opcDecrLocal:
            begin
              if (Inst.Operand < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand >= STACK_MAX) then                
                errMSG.callerror(105,'TVM.Run (opcDecrLocal: operand out of bounds)',CurrentLine,CurrentCol);
              
              TmpC := FStack[CurrentFrame^.BaseSlot + Inst.Operand];
              if (TmpC <> nil) and (TmpC.DataType = dtNumeric) then
              begin
                TmpC.FNumVal := TmpC.FNumVal - 1.0;
              end
              else
              begin
                if TmpC <> nil then TmpC.Free;
                FStack[CurrentFrame^.BaseSlot + Inst.Operand] := TValue.CreateNum(-1.0);
              end;
            end;      
            
          opcAddNum:
            begin
              // Fast path: asumsi kedua operand numeric (dijamin oleh JIT)
              if (FTop >= 2) and 
                 (FStack[FTop-2].DataType = dtNumeric) and 
                 (FStack[FTop-1].DataType = dtNumeric) then
              begin
                FStackLock.Acquire;
                try
                  FStack[FTop-2].FNumVal := FStack[FTop-2].FNumVal + FStack[FTop-1].FNumVal;
                  Dec(FTop);
                  TmpC := FStack[FTop];
                  FStack[FTop] := nil;
                finally
                  FStackLock.Release;
                end;
                if Assigned(TmpC) then TmpC.Free;
              end
              else
                errMSG.callerror(96, 'TVM.Run (opcAddNum: tipe berubah di runtime — JIT deopt)',                                 CurrentLine, CurrentCol);
            end;
          
          opcSubNum:
            begin
              if (FTop >= 2) and 
                 (FStack[FTop-2].DataType = dtNumeric) and 
                 (FStack[FTop-1].DataType = dtNumeric) then
              begin
                FStackLock.Acquire;
                try
                  FStack[FTop-2].FNumVal := FStack[FTop-2].FNumVal - FStack[FTop-1].FNumVal;
                  Dec(FTop);
                  TmpC := FStack[FTop];
                  FStack[FTop] := nil;
                finally
                  FStackLock.Release;
                end;
                if Assigned(TmpC) then TmpC.Free;
              end
              else
                errMSG.callerror(97, 'TVM.Run (opcSubNum: JIT deopt)', CurrentLine, CurrentCol);
            end;
          
          opcMulNum:
            begin
              if (FTop >= 2) and 
                 (FStack[FTop-2].DataType = dtNumeric) and 
                 (FStack[FTop-1].DataType = dtNumeric) then
              begin
                FStackLock.Acquire;
                try
                  FStack[FTop-2].FNumVal := FStack[FTop-2].FNumVal * FStack[FTop-1].FNumVal;
                  Dec(FTop);
                  TmpC := FStack[FTop];
                  FStack[FTop] := nil;
                finally
                  FStackLock.Release;
                end;
                if Assigned(TmpC) then TmpC.Free;
              end
              else
                errMSG.callerror(98, 'TVM.Run (opcMulNum: JIT deopt)', CurrentLine, CurrentCol);
            end;
          
          opcDivNum:
            begin
              if (FTop >= 2) and 
                 (FStack[FTop-2].DataType = dtNumeric) and 
                 (FStack[FTop-1].DataType = dtNumeric) then
              begin
                if SameValue(FStack[FTop-1].FNumVal, 0.0, 1E-15) then
                  errMSG.callerror(12, 'Division by zero', CurrentLine, CurrentCol);
                  
                FStackLock.Acquire;
                try
                  FStack[FTop-2].FNumVal := FStack[FTop-2].FNumVal / FStack[FTop-1].FNumVal;
                  Dec(FTop);
                  TmpC := FStack[FTop];
                  FStack[FTop] := nil;
                finally
                  FStackLock.Release;
                end;
                if Assigned(TmpC) then TmpC.Free;
              end
              else
                errMSG.callerror(99, 'TVM.Run (opcDivNum: JIT deopt)', CurrentLine, CurrentCol);
            end;
          
          opcGetIndexArrayInt:
            begin
              b := Pop;
              a := Pop;
              try
                if (a.DataType <> dtArray) or (b.DataType <> dtNumeric) then
                begin
                  Push(a);   // Kembalikan ke stack untuk fallback
                  Push(b);
                  errMSG.callerror(6, 'TVM.Run (opcGetIndexArrayInt: JIT deopt)', CurrentLine, CurrentCol);
                end;
                
                i := Trunc(b.NumVal);
                if i < 0 then i := a.ArrayVal.Count + i;
                
                a.ArrayVal.FLock.Acquire;
                try
                  if (i >= 0) and (i < a.ArrayVal.Count) and Assigned(a.ArrayVal[i]) then
                    Push(a.ArrayVal[i].Clone)
                  else
                    Push(TValue.CreateNull);
                finally
                  a.ArrayVal.FLock.Release;
                end;
              finally
                a.Free;
                b.Free;
              end;
            end;        
            
          opcSumArrayIndex:
            begin
              // Bounds check base slot
              if (Inst.Operand < 0) or (Inst.Operand2 < 0) or (Inst.Operand3 < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand >= STACK_MAX) or
                 (CurrentFrame^.BaseSlot + Inst.Operand2 >= STACK_MAX) or
                 (CurrentFrame^.BaseSlot + Inst.Operand3 >= STACK_MAX) then
                errMSG.callerror(105, 'TVM.Run (opcSumArrayIndex: operand out of bounds)', CurrentLine, CurrentCol);
          
              // Ambil pointer langsung ke slot lokal (tanpa Clone)
              TmpC := FStack[CurrentFrame^.BaseSlot + Inst.Operand2];  // arr
              TempVal := FStack[CurrentFrame^.BaseSlot + Inst.Operand3]; // i
          
              // Validasi arr
              if (TmpC = nil) or (TmpC.DataType <> dtArray) then
                errMSG.callerror(6, 'TVM.Run (opcSumArrayIndex: target bukan array)', CurrentLine, CurrentCol);
          
              // Validasi i
              if (TempVal = nil) or (TempVal.DataType <> dtNumeric) then
                errMSG.callerror(6, 'TVM.Run (opcSumArrayIndex: index bukan numerik)', CurrentLine, CurrentCol);
          
              Idx := Trunc(TempVal.NumVal);
              if Idx < 0 then Idx := TmpC.ArrayVal.Count + Idx;
          
              // Akses elemen array (dengan lock)
              TmpC.ArrayVal.FLock.Acquire;
              try
                if (Idx >= 0) and (Idx < TmpC.ArrayVal.Count) and 
                   Assigned(TmpC.ArrayVal[Idx]) and 
                   (TmpC.ArrayVal[Idx].DataType = dtNumeric) then
                begin
                  // ✅ FAST PATH: Langsung tambah Double akumulator
                  a := FStack[CurrentFrame^.BaseSlot + Inst.Operand]; // sum
                  
                  if (a <> nil) and (a.DataType = dtNumeric) then
                  begin
                    // Mutasi langsung field Double — tidak ada alokasi!
                    a.FNumVal := a.FNumVal + TmpC.ArrayVal[Idx].NumVal;
                  end else
                  begin
                    // SLOW PATH: sum bukan numeric (diinisialisasi null/string)
                    if a <> nil then a.Free;
                    FStack[CurrentFrame^.BaseSlot + Inst.Operand] := 
                      TValue.CreateNum(TmpC.ArrayVal[Idx].NumVal);
                  end;
                end else
                begin
                  // Fallback ke slow path: elemen bukan numeric atau OOB
                  errMSG.callerror(6, 'TVM.Run (opcSumArrayIndex: elemen invalid/OOB)', CurrentLine, CurrentCol);
                end;
              finally
                TmpC.ArrayVal.FLock.Release;
              end;
            end;
            
          opcAddLocalLocal:
            begin
              if (Inst.Operand < 0) or (Inst.Operand2 < 0) or (Inst.Operand3 < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand >= STACK_MAX) or
                 (CurrentFrame^.BaseSlot + Inst.Operand2 >= STACK_MAX) or
                 (CurrentFrame^.BaseSlot + Inst.Operand3 >= STACK_MAX) then
                errMSG.callerror(105, 'TVM.Run (opcAddLocalLocal: operand out of bounds)', CurrentLine, CurrentCol);
              
              a := FStack[CurrentFrame^.BaseSlot + Inst.Operand];
              b := FStack[CurrentFrame^.BaseSlot + Inst.Operand2];
              
              // ─── FAST PATH ───
              if (a <> nil) and (a.DataType = dtNumeric) and 
                 (b <> nil) and (b.DataType = dtNumeric) then
              begin
                case Inst.Operand3 of
                  0: a.FNumVal := a.FNumVal + b.FNumVal;
                  1: a.FNumVal := a.FNumVal - b.FNumVal;
                  2: a.FNumVal := a.FNumVal * b.FNumVal;
                  3: begin
                       if SameValue(b.FNumVal, 0.0, 1E-15) then
                         errMSG.callerror(12, 'Division by zero', CurrentLine, CurrentCol);
                       a.FNumVal := a.FNumVal / b.FNumVal;
                     end;
                  4: begin
                       if SameValue(b.FNumVal, 0.0, 1E-15) then
                         errMSG.callerror(12, 'Modulo by zero', CurrentLine, CurrentCol);
                       a.FNumVal := a.FNumVal - (b.FNumVal * math.Floor(a.FNumVal / b.FNumVal));
                     end;
                else
                  errMSG.callerror(45, 'TVM.Run (opcAddLocalLocal: subop tidak valid)', CurrentLine, CurrentCol);
                end;
              end
              // ─── SLOW PATH: null + numeric ───
              else if (a <> nil) and (a.DataType = dtNull) and 
                      (b <> nil) and (b.DataType = dtNumeric) then
              begin
                // Coerce null → 0, lalu simpan hasil
                a.Free;
                FStack[CurrentFrame^.BaseSlot + Inst.Operand] := 
                  TValue.CreateNum(b.NumVal);
              end
              // ─── ERROR PATH ───
              else
              begin
                // Konversi subop ke operator string untuk VM_CompoundOp
                case Inst.Operand3 of
                  0: StrKey := '+';
                  1: StrKey := '-';
                  2: StrKey := '*';
                  3: StrKey := '/';
                  4: StrKey := '%';
                else
                  StrKey := '+';
                end;
                
                // VM_CompoundOp tidak mengambil ownership a/b; hanya membaca.
                TargetObj := VM_CompoundOp(StrKey, a, b);
                if Assigned(TargetObj) then
                begin
                  // Replace slot dengan nilai baru
                  FStack[CurrentFrame^.BaseSlot + Inst.Operand] := TargetObj;
                  // Free nilai lama (a) — bukan TargetObj
                  if Assigned(a) and (Pointer(a) <> Pointer(TargetObj)) then
                    a.Free;
                  TargetObj := nil;   // ownership pindah ke stack
                end;
              end;              
            end;        
            
          opcForLoopCond:
            begin
              if (Inst.Operand < 0) or
                 (Inst.Operand2 < 0) or
                 (Inst.Operand3 < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand >= STACK_MAX) or
                 (CurrentFrame^.BaseSlot + Inst.Operand2 < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand2 >= STACK_MAX) then
                errMSG.callerror(105,'TVM.Run (opcForLoopCond: operand out of bounds)',
                                 CurrentLine, CurrentCol);
          
              a := FStack[CurrentFrame^.BaseSlot + Inst.Operand];   // i
              b := FStack[CurrentFrame^.BaseSlot + Inst.Operand2];  // #end_i
          
              if (a = nil) or (a.DataType <> dtNumeric) then
                errMSG.callerror(19, 'TVM.Run (opcForLoopCond: i bukan numerik)',
                  CurrentLine, CurrentCol);
              if (b = nil) or (b.DataType <> dtNumeric) then
                errMSG.callerror(19, 'TVM.Run (opcForLoopCond: #end_i bukan numerik)',
                  CurrentLine, CurrentCol);
          
              if not (a.FNumVal <= b.FNumVal) then
              begin
                // ✨ FIX BUG-C: validasi tujuan lompatan SEBELUM loncat.
                if (Inst.Operand3 < 0) or
                   (CurrentFrame^.IP + Inst.Operand3 > CurrentFrame^.Chunk.CodeCount) then
                  errMSG.callerror(108,
                    'TVM.Run (opcForLoopCond: jump out of bounds)',
                    CurrentLine, CurrentCol);
          
                Inc(CurrentFrame^.IP, Inst.Operand3);
              end;
              // Condition TRUE → lanjut ke body (IP sudah di-increment sebelumnya)
            end;
            
          opcForLoopCondDown:
            begin
              if (Inst.Operand < 0) or
                 (Inst.Operand2 < 0) or
                 (Inst.Operand3 < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand >= STACK_MAX) or
                 (CurrentFrame^.BaseSlot + Inst.Operand2 < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand2 >= STACK_MAX) then
                errMSG.callerror(105,
                  'TVM.Run (opcForLoopCondDown: operand OOB)',
                  CurrentLine, CurrentCol);
          
              a := FStack[CurrentFrame^.BaseSlot + Inst.Operand];   // i
              b := FStack[CurrentFrame^.BaseSlot + Inst.Operand2];  // #end_i
          
              if (a = nil) or (a.DataType <> dtNumeric) then
                errMSG.callerror(19,
                  'TVM.Run (opcForLoopCondDown: i bukan numerik)',
                  CurrentLine, CurrentCol);
              if (b = nil) or (b.DataType <> dtNumeric) then
                errMSG.callerror(19,
                  'TVM.Run (opcForLoopCondDown: end bukan numerik)',
                  CurrentLine, CurrentCol);
          
              // Lanjut loop selama i >= end; keluar saat i < end
              if not (a.FNumVal >= b.FNumVal) then
              begin
                if (Inst.Operand3 < 0) or
                   (CurrentFrame^.IP + Inst.Operand3 > CurrentFrame^.Chunk.CodeCount) then
                  errMSG.callerror(108,
                    'TVM.Run (opcForLoopCondDown: jump OOB)',
                    CurrentLine, CurrentCol);
          
                Inc(CurrentFrame^.IP, Inst.Operand3);
              end;
            end;            

          opcIncrGlobal:
            begin
              if (Inst.Operand < 0) or 
                 (Inst.Operand >= CurrentFrame^.Chunk.VarNames.Count) then
                errMSG.callerror(103, 'TVM.Run (opcIncrGlobal)', CurrentLine, CurrentCol);
              
              VarName := CurrentFrame^.Chunk.VarNames[Inst.Operand];
              
              // Fast path: atomic numeric increment
              if not CurrentFrame^.Env.AtomicAddNumeric(VarName, 1.0) then
              begin
                // Fallback: string concat atau error
                a := CurrentFrame^.Env.GetVar(VarName);
                try
                  b := TValue.CreateNum(1.0);
                  try
                    if a.DataType = dtString then
                      ResultVal := Helper_MergeStrings(a, b)
                    else
                      errMSG.callerror(96, 
                        'TVM.Run (opcIncrGlobal: cannot increment non-numeric)', 
                        CurrentLine, CurrentCol);
                    try
                      CurrentFrame^.Env.AssignVar(VarName, ResultVal.Clone);
                    finally
                      ResultVal.Free;
                    end;
                  finally
                    b.Free;
                  end;
                finally
                  a.Free;
                end;
              end;
            end;
          
          opcDecrGlobal:
            begin
              if (Inst.Operand < 0) or 
                 (Inst.Operand >= CurrentFrame^.Chunk.VarNames.Count) then
                errMSG.callerror(103, 'TVM.Run (opcDecrGlobal)', CurrentLine, CurrentCol);
              
              VarName := CurrentFrame^.Chunk.VarNames[Inst.Operand];
              
              if not CurrentFrame^.Env.AtomicAddNumeric(VarName, -1.0) then
              begin
                a := CurrentFrame^.Env.GetVar(VarName);
                try
                  b := TValue.CreateNum(-1.0);
                  try
                    if a.DataType = dtString then
                      ResultVal := Helper_MergeStrings(a, b)
                    else
                      errMSG.callerror(97, 
                        'TVM.Run (opcDecrGlobal: cannot decrement non-numeric)', 
                        CurrentLine, CurrentCol);
                    try
                      CurrentFrame^.Env.AssignVar(VarName, ResultVal.Clone);
                    finally
                      ResultVal.Free;
                    end;
                  finally
                    b.Free;
                  end;
                finally
                  a.Free;
                end;
              end;
            end;
          
          opcAddGlobalConst:
            begin
              if (Inst.Operand < 0) or 
                 (Inst.Operand >= CurrentFrame^.Chunk.VarNames.Count) then
                errMSG.callerror(103, 'TVM.Run (opcAddGlobalConst)', CurrentLine, CurrentCol);
              if (Inst.Operand2 < 0) or 
                 (Inst.Operand2 >= CurrentFrame^.Chunk.Constants.Count) then
                errMSG.callerror(93, 'TVM.Run (opcAddGlobalConst)', CurrentLine, CurrentCol);
              
              VarName := CurrentFrame^.Chunk.VarNames[Inst.Operand];
              TempVal := CurrentFrame^.Chunk.Constants[Inst.Operand2];
              
              if TempVal.DataType <> dtNumeric then
                errMSG.callerror(45, 
                  'TVM.Run (opcAddGlobalConst: constant not numeric)', 
                  CurrentLine, CurrentCol);
              
              if not CurrentFrame^.Env.AtomicAddNumeric(VarName, TempVal.NumVal) then
              begin
                a := CurrentFrame^.Env.GetVar(VarName);
                try
                  if a.DataType = dtString then
                  begin
                    ResultVal := Helper_MergeStrings(a, TempVal);
                    try
                      CurrentFrame^.Env.AssignVar(VarName, ResultVal.Clone);
                    finally
                      ResultVal.Free;
                    end;
                  end
                  else
                    errMSG.callerror(96, 
                      'TVM.Run (opcAddGlobalConst: type mismatch)', 
                      CurrentLine, CurrentCol);
                finally
                  a.Free;
                end;
              end;
            end;            
            
          opcAddLocalConst:
            begin
              if (Inst.Operand < 0) or (Inst.Operand2 < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand < 0) or
                 (CurrentFrame^.BaseSlot + Inst.Operand >= STACK_MAX) or
                 (Inst.Operand2 >= CurrentFrame^.Chunk.Constants.Count) then
                errMSG.callerror(105, 'TVM.Run (opcAddLocalConst: operand OOB)',
                  CurrentLine, CurrentCol);
              
              a := FStack[CurrentFrame^.BaseSlot + Inst.Operand];
              b := CurrentFrame^.Chunk.Constants[Inst.Operand2];
              
              if (b = nil) or (b.DataType <> dtNumeric) then
                errMSG.callerror(45,
                  'TVM.Run (opcAddLocalConst: const bukan numeric)',
                  CurrentLine, CurrentCol);
              
              if (a <> nil) and (a.DataType = dtNumeric) then
                // FAST PATH: mutasi Double langsung
                a.FNumVal := a.FNumVal + b.NumVal
              else if (a = nil) or (a.DataType = dtNull) then
              begin
                // Coerce null → delta
                if a <> nil then a.Free;
                FStack[CurrentFrame^.BaseSlot + Inst.Operand] :=
                  TValue.CreateNum(b.NumVal);
              end
              else
                errMSG.callerror(96,
                  'TVM.Run (opcAddLocalConst: tipe tidak kompatibel)',
                  CurrentLine, CurrentCol);
            end;
            
          else //TVM.Run
            errMSG.callerror(47,'TVM.Run',CurrentLine, CurrentCol); 
        end; //case Inst.OpCode of
        
        // JIT-lite feedback collection
        if (Inst.OpCode in [opcAdd, opcSub, opcMul, opcDiv]) and
           (InterlockedCompareExchange(
              CurrentFrame^.Chunk.FActiveUses, 0, 0) = 1) then
        begin
          PInst := @CurrentFrame^.Chunk.Code[CurrentFrame^.IP - 1];
          
          // ✅ Validasi: chunk ini masih hidup dan valid.
          if (PInst <> nil) and (CurrentFrame^.IP - 1 < CurrentFrame^.Chunk.CodeCount) then
          begin
            // Gunakan InterlockedIncrement + atomic OR untuk menghindari race.
            // Word dan Byte selalu atomic pada x86/x64, tapi tetap kita
            // jaga dengan saturasi nilai.
            if PInst^.HitCount < 32000 then
              Inc(PInst^.HitCount);
            
            if (FTop >= 2) and 
               (FStack[FTop-2].DataType = dtNumeric) and 
               (FStack[FTop-1].DataType = dtNumeric) then
              PInst^.TypeFeedback := PInst^.TypeFeedback or 1
            else
              PInst^.TypeFeedback := PInst^.TypeFeedback or 2;
            
            if (PInst^.HitCount >= 100) and 
               (PInst^.HitCount < 200) and
               (PInst^.TypeFeedback = 1) then
            begin
              case PInst^.OpCode of
                opcAdd: PInst^.OpCode := opcAddNum;
                opcSub: PInst^.OpCode := opcSubNum;
                opcMul: PInst^.OpCode := opcMulNum;
                opcDiv: PInst^.OpCode := opcDivNum;
              end;
            end;
          end;
        end;
      end; // END INNER LOOP      
      LoopActive := False; // Jika mencapai titik ini, eksekusi VM selesai normal

    except
      on E: EScriptFatalError do raise;
      on E: Exception do
      begin
        STrace := GenerateStackTrace(); 
        
        // ✅ C-4: extract thrown value — kalau user throw, ambil ThrownValue,
        // kalau runtime error, bungkus jadi dict {message, trace}.
        ThrownVal := nil;
        if E is EScriptUserThrow then
        begin
          ThrownVal := EScriptUserThrow(E).ThrownValue;
          // Ambil ownership — jangan biarkan destructor EScriptUserThrow membebaskan
          EScriptUserThrow(E).ThrownValue := nil;
        end
        else
        begin
          ErrDict := TDictValue.Create;
          ErrDict.SetValue('message', TValue.CreateStr(E.Message));
          ErrDict.SetValue('trace', TValue.CreateStr(STrace));
          ThrownVal := TValue.CreateDict(ErrDict);
        end;
        
        // ✅ C-4: walk handler stack sampai ketemu type match
        Handled := False;
        while FExceptionCount > 0 do
        begin
          Dec(FExceptionCount);
          
          if ExceptionMatchesType(ThrownVal, FExceptions[FExceptionCount].TypeName) then
          begin
            // Match — dispatch ke handler ini
            while FLockDepth > FExceptions[FExceptionCount].BaseLockDepth do 
            begin ScriptLock.Release; Dec(FLockDepth); end;
            
            while (FFrameCount - 1) > FExceptions[FExceptionCount].FrameIdx do 
            begin
              if Assigned(FFrames[FFrameCount - 1].Env) then 
              begin 
                FFrames[FFrameCount - 1].Env.Release; 
                FFrames[FFrameCount - 1].Env := nil; 
              end;
              SafeClearFuncValue(FFrames[FFrameCount - 1].FuncValue);
              Dec(FFrameCount);
            end;
            
            CurrentFrame := @FFrames[FFrameCount - 1];
    
            FStackLock.Acquire;
            try
              while FTop > FExceptions[FExceptionCount].BaseTop do 
              begin
                Dec(FTop);
                if Assigned(FStack[FTop]) then 
                begin 
                  FStack[FTop].Free; 
                  FStack[FTop] := nil; 
                end;
              end;
            finally 
              FStackLock.Release; 
            end;
            
            Push(ThrownVal);
            ThrownVal := nil;   // ownership transferred to stack
            
            CurrentFrame^.IP := FExceptions[FExceptionCount].CatchIP;
            FState := vmRunning;
            Handled := True;
            Break;
          end;
          // else: type mismatch — coba handler berikutnya (outer)
        end;
     
        if not Handled then
        begin
          // Tidak ada handler yang cocok — propagate ke host
          if Assigned(ThrownVal) then
          begin
            ThrownVal.Free;
            ThrownVal := nil;
          end;
          
          if TThread.CurrentThread = nil then
          begin
            IOLock.Acquire;
            try
              if (E is EScriptRuntimeError) 
                 and (EScriptRuntimeError(E).FormattedBanner <> '') then
              begin
                Writeln(EScriptRuntimeError(E).FormattedBanner);
                Writeln; Writeln(STrace);
              end
              else if Pos('Interpreter Halted:', E.Message) = 0 then
              begin
                Writeln(#10'=== RUNTIME EXCEPTION ==='#10, E.Message);
                Writeln; Writeln(STrace); 
              end
              else
              begin
                Writeln; Writeln(STrace);
              end;
            finally 
              IOLock.Release; 
            end;
          end;
          
          while FLockDepth > 0 do 
          begin 
            ScriptLock.Release; 
            Dec(FLockDepth); 
          end;
          
          for i := 0 to FFrameCount - 1 do
          begin
            if Assigned(FFrames[i].Env) then
            begin
              ZombieLock.Acquire;
              try
                if Assigned(ZombieQueue) then
                  ZombieQueue.Add(FFrames[i].Env);
              finally
                ZombieLock.Release;
              end;
              FFrames[i].Env := nil;
            end;
            SafeClearFuncValue(FFrames[i].FuncValue);
          end;
          
          while FTop > 0 do 
          begin 
            Dec(FTop); 
            if Assigned(FStack[FTop]) then 
            begin 
              FStack[FTop].Free; 
              FStack[FTop] := nil; 
            end; 
          end;
          
          FState := vmDead; 
          LoopActive := False;
          
          if Pos('Interpreter Halted:', E.Message) > 0 then
            raise EScriptRuntimeError.Create(E.Message)
          else
            raise EScriptRuntimeError.Create('Interpreter Halted: ' + E.Message);
        
        end;
      end;
    end;

  end; // END OUTER LOOP
  
  FState := vmDead;
  
  // ✅ FIX P2.1: Hapus redundant loop — CleanStackTo sudah bersihkan
  //    Tambahkan assertion untuk verifikasi di debug build
  {$IFDEF DEBUG}
  Assert(FTop = 0, 'Stack tidak bersih setelah eksekusi VM!');
  {$ENDIF}
  
  if Assigned(FFrames[0].Env) then 
  begin
    FFrames[0].Env.Release;
    FFrames[0].Env := nil; 
  end;
  
  // ✅ FIX P0.1: JANGAN free FuncValue — hanya nil-kan
  SafeClearFuncValue(FFrames[0].FuncValue);
  
  // ✅ TAHAP A — BUG-5: Hanya isi Result jika belum di-set oleh opcHalt
  if not FHasResult then
    Result := TValue.CreateNull;
end;

function TVM.Resume(Arg: TValue): TValue;
begin
  Result := nil;

  // 1. Cek jika coroutine sudah selesai/mati
  if FState = vmDead then 
    errMSG.callerror(135,'TVM.Resume',errMSG.xrow,errMSG.xcol); 
  
  // 2. Pastikan coroutine memang dalam kondisi terjeda (yielded) atau siap jalan (ready/running)
  if (FState <> vmYielded) and (FState <> vmReady) then 
    errMSG.callerror(136,'TVM.Resume',errMSG.xrow,errMSG.xcol); 

  // 3. Masukkan nilai argumen dari resume ke dalam stack sebagai hasil dari ekspresi 'yield' di dalam script
  if FState = vmYielded then
  begin
    if Assigned(Arg) then 
      Push(Arg.Clone) 
    else 
      Push(TValue.CreateNull);
  end;
    
  // 4. Lanjutkan eksekusi VM dari IP terakhir
  Result := Run(nil, True);
end;

//yield===================
//Coroutine (Yield/Resume)
//========================
constructor TYieldNode.Create(AExpr: TNode);
begin
  Expr := AExpr;
end;

destructor TYieldNode.Destroy;
begin
  if Assigned(Expr) then Expr.Free;
  inherited;
end;

constructor TVMFunction.Create;
begin
  FRefCount := 1;
  Chunk := nil;
end;

destructor TVMFunction.Destroy;
var
  i: Integer;
begin
  if Assigned(Chunk) then Chunk.Free;
  for i := 0 to High(Params) do
  begin
    if Assigned(Params[i].DefaultChunk) then
      Params[i].DefaultChunk.Free;
  end;

  inherited;
end;

procedure TVMFunction.Retain;
begin
  InterlockedIncrement(FRefCount);
end;

procedure TVMFunction.Release;
begin
  if InterlockedDecrement(FRefCount) = 0 then
    Self.Free;
end;

//event===================
//event loop
//========================
procedure ProcessGCZombies;
var
  ProcessedCount, DynamicLimit: Integer;
  Obj: TObject;
begin
  if not Assigned(ZombieQueue) then Exit;
  
  ZombieLock.Acquire;
  try
    if ZombieQueue.Count = 0 then Exit;
    // Dinamis: Bersihkan 20% dari total antrean atau minimal 50 objek
    DynamicLimit := ZombieQueue.Count div 5;
    if DynamicLimit < 50 then DynamicLimit := 50;
  finally
    ZombieLock.Release;
  end;

  ProcessedCount := 0;
  while ProcessedCount < DynamicLimit do
  begin
    Obj := nil;
    ZombieLock.Acquire;
    try
      if ZombieQueue.Count > 0 then
      begin
        Obj := TObject(ZombieQueue[ZombieQueue.Count - 1]);
        ZombieQueue.Delete(ZombieQueue.Count - 1);
      end;
    finally
      ZombieLock.Release; 
    end;

    if Obj = nil then Break; 
    Inc(ProcessedCount);

    // KEAJAIBAN POLIMORFISME: Tahap 1, 2, dan 3 tereksekusi tanpa RTTI
    TGCManagedObject(Obj).Retain;
    try
      TGCManagedObject(Obj).ClearReferences;
    finally
      TGCManagedObject(Obj).Release; 
    end;
  end;
end;

constructor TEventLoop.Create;
begin
  FTasks := TList.Create;
  FLock := TCriticalSection.Create;
  FWakeEvent := RTLEventCreate;
end;

destructor TEventLoop.Destroy;
var
  i: Integer;
  Task: PEventTask;
begin
  FLock.Acquire;
  try
    for i := 0 to FTasks.Count - 1 do
    begin
      Task := PEventTask(FTasks[i]);
      if Assigned(Task^.CallbackFunc) then Task^.CallbackFunc.Free;
      if Assigned(Task^.Payloads) then Task^.Payloads.Free;
      Dispose(Task);
    end;
    FTasks.Clear;
  finally
    FLock.Release;
  end;
  FTasks.Free;
  FLock.Free;
  RTLEventDestroy(FWakeEvent);
  inherited;
end;

function TEventLoop.SetTimer(Callback: TValue; DelayMs: QWord; IsInterval: Boolean): Integer;
var NewTask: PEventTask;
begin
  if Callback.DataType <> dtFunction then errMSG.callerror(137, 'TEventLoop.SetTimer', errMSG.xrow, errMSG.xcol);
  NewTask := New(PEventTask);
  if IsInterval then NewTask^.TaskType := etInterval else NewTask^.TaskType := etTimer;
  NewTask^.CallbackFunc := Callback.Clone; 
  NewTask^.Payloads := TValueList.Create(True);
  NewTask^.IntervalMs := DelayMs;
  NewTask^.TriggerTime := GetTickCount64 + DelayMs;
  NewTask^.IsActive := True;

  NewTask^.TimerID := InterlockedIncrement64(GTimerCounter);
  Result := Integer(NewTask^.TimerID);

  FLock.Acquire;
  try
    FTasks.Add(NewTask);
  finally
    FLock.Release;
  end;
  RTLEventSetEvent(FWakeEvent);
end;

function TEventLoop.ClearTimer(TimerID: Int64): Boolean;
var
  i: Integer;
  Task: PEventTask;
begin
  Result := False;
  FLock.Acquire;
  try
    for i := 0 to FTasks.Count - 1 do
    begin
      Task := PEventTask(FTasks[i]);
      if Assigned(Task) and (Task^.TimerID = TimerID) and Task^.IsActive then
      begin
        Task^.IsActive := False;
        Result := True;
        Break;
      end;
    end;
  finally
    FLock.Release;
  end;
end;

procedure TEventLoop.PushIOPayload(Callback: TValue; Payload: TValue);
var NewTask: PEventTask;
begin
  NewTask := New(PEventTask);
  NewTask^.TaskType := etIOWait;
  NewTask^.CallbackFunc := Callback.Clone;
  NewTask^.Payloads := TValueList.Create(True);
  NewTask^.Payloads.Add(Payload.Clone); // <-- PERBAIKAN: Wajib dikloning untuk mencegah Dangling Pointer dari Thread asal
  NewTask^.TriggerTime := 0; 
  NewTask^.IsActive := True;

  FLock.Acquire;
  try
    FTasks.Add(NewTask);
  finally
    FLock.Release;
  end;
  RTLEventSetEvent(FWakeEvent); 
end;

procedure TEventLoop.RunLoop(CallEnv: TSymbolTable);
var
  i, ActiveCount, ReadyCount: Integer;
  Task: PEventTask;
  CurrentTime, NextWakeTime, SleepDelta: QWord;
  SafeWaitTime: Integer;
  MiniVM: TVM; 
  TempChunk: TChunk; 
  PayloadItem: TValue;
  ResultVal: TValue;
  ReadyTasks: array of PEventTask; 
  DeadTasks: array of PEventTask;
  DeadCount: Integer;
  SavedContext: TEngineContext;   // ✨ PHASE 7.5
  Ctx: TEngineContext;      // ✅ T-2b
  HasWorker: Boolean;       // ✅ T-2b
  StuckCount: Integer; 
begin
  // ✨ FIX LANGKAH 8: Set context untuk thread ini dari CallEnv
  // Ini memastikan semua TValue yang dibuat dari dalam event loop callbacks
  // akan menggunakan TEngineContext yang benar (bukan global fallback).
  SavedContext := GCurrentContext;
  if Assigned(CallEnv) then
  begin
    try
      GCurrentContext := CallEnv.GetGlobal.Context;
    except
      // Fallback: keep existing context (mis. saat GetGlobal throw)
    end;
  end;
  
  StuckCount:= 0; 
  try
    repeat
      CheckPendingSignals(CallEnv);
      if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 1 then Break;
    
      // B.1.4: tick WS event loop (non-blocking, 20ms timeout)
      if Assigned(GWSEventLoop) then
      begin
        try GWSEventLoop.Tick(20);
        except
          // fail-silent — error WS tidak boleh matikan script event loop
        end;
      end;
      
      // B.1.7: process done exec tasks
      try ProcessExecCallbacks; except end;
      // ✅ FASE 1.3: process done fs async tasks
      try ProcessFSAsyncCallbacks; except end;    
      
      ActiveCount := 0; ReadyCount  := 0; DeadCount := 0;      
      CurrentTime := GetTickCount64; 
      NextWakeTime := High(QWord); 

      // === FASE 1: Snapshot task yang siap eksekusi ===
      FLock.Acquire;
      try
        SetLength(ReadyTasks, FTasks.Count);
        SetLength(DeadTasks, FTasks.Count);
        
        for i := FTasks.Count - 1 downto 0 do
        begin
          Task := PEventTask(FTasks[i]);
          if not Task^.IsActive then
          begin
            DeadTasks[DeadCount] := Task;
            Inc(DeadCount);
            FTasks.Delete(i); 
            Continue;
          end;
          
          Inc(ActiveCount);
          if CurrentTime >= Task^.TriggerTime then
          begin
            ReadyTasks[ReadyCount] := Task;
            Inc(ReadyCount);
          end else
          begin
            if Task^.TriggerTime < NextWakeTime then 
              NextWakeTime := Task^.TriggerTime;
          end;
        end;
      finally
        FLock.Release;
      end;

      // === FASE 2: Bersihkan task mati ===
      for i := 0 to DeadCount - 1 do
      begin
        Task := DeadTasks[i];
        if Assigned(Task^.CallbackFunc) then Task^.CallbackFunc.Free;
        if Assigned(Task^.Payloads) then Task^.Payloads.Free;
        Dispose(Task);
      end;
      SetLength(DeadTasks, 0);
      
      // === FASE 3: Eksekusi task yang siap ===
      for i := 0 to ReadyCount - 1 do
      begin
        Task := ReadyTasks[i];
        
        // Inisialisasi nil SEBELUM try agar finally aman
        MiniVM := nil;
        TempChunk := nil;
        PayloadItem := nil;
        ResultVal := nil;
        
        // Inisialisasi threadvar lokal
        if not Assigned(errMSG) then errMSG := Terror.Create; 
        
        try
          try
            MiniVM := TVM.Create(CallEnv);
            TempChunk := TChunk.Create;
            
            // Push callback
            TempChunk.AddInstruction(opcConstant, 
              TempChunk.AddConstant(Task^.CallbackFunc.Clone));
            
            // Push payload (jika ada)
            if Task^.Payloads.Count > 0 then
            begin
              PayloadItem := Task^.Payloads[0];
              TempChunk.AddInstruction(opcConstant, 
                TempChunk.AddConstant(PayloadItem.Clone));
              TempChunk.AddInstruction(opcCall, 1);
              
              // Task non-interval: clear payload setelah eksekusi
              if Task^.TaskType <> etInterval then 
                Task^.Payloads.Clear; 
            end else 
              TempChunk.AddInstruction(opcCall, 0);
           
            TempChunk.AddInstruction(opcReturn);
            
            // Eksekusi dan simpan hasil
            ResultVal := MiniVM.Run(TempChunk);
            try
              if Assigned(ResultVal) then ResultVal.Free;
            finally
              ResultVal := nil;
            end;
            
          except
            on E: Exception do
            begin
              IOLock.Acquire;
              try 
                Writeln(#10'=== Unhandled Exception di Event Loop ==='#10, E.Message); 
              finally 
                IOLock.Release; 
              end;
            end;
          end;
        finally
          // Bersihkan resource lokal
          if Assigned(TempChunk) then 
          begin
            TempChunk.Free; 
            TempChunk := nil;
          end;
          if Assigned(MiniVM) then 
          begin
            MiniVM.Free;
            MiniVM := nil;
          end;
        end;    
        
        // === FASE 3b: Update scheduling ===
        FLock.Acquire; 
        try
          if Task^.TaskType = etInterval then
          begin
            // Reschedule untuk interval berikutnya
            Task^.TriggerTime := GetTickCount64 + Task^.IntervalMs;
            if Task^.TriggerTime < NextWakeTime then 
              NextWakeTime := Task^.TriggerTime;
          end else 
            Task^.IsActive := False; 
        finally 
          FLock.Release; 
        end;    
      end;

      // === FASE 4: Pemrosesan GC zombies ===
      ProcessGCZombies();

      // === FASE 5: Sleep jika tidak ada task siap ===
      if (ActiveCount > 0) and (ReadyCount = 0) then 
      begin
        CurrentTime := GetTickCount64;
        if NextWakeTime > CurrentTime then
        begin
          SleepDelta := NextWakeTime - CurrentTime;
          if SleepDelta > $7FFFFFFF then 
            SafeWaitTime := $7FFFFFFF
          else 
            SafeWaitTime := Integer(SleepDelta);
          
          RTLEventWaitFor(FWakeEvent, SafeWaitTime);
        end else 
        begin
          RTLEventWaitFor(FWakeEvent, 0); 
        end;
      end;
      RTLEventResetEvent(FWakeEvent);
      
      // ✅ T-2b: cek worker pool. Kalau masih ada task pending,
      // tunggu wake event singkat untuk memberi worker kesempatan
      // memposting hasil ke event loop.
      if ActiveCount = 0 then
      begin
        Ctx := GCurrentContext;
        HasWorker := Assigned(Ctx) and Assigned(Ctx.WorkerPool) 
                     and Ctx.WorkerPool.HasActiveTasks;
        
        if HasWorker then
        begin
          Inc(StuckCount);
          // ✅ T-2b: watchdog — max 5 detik stuck
          if StuckCount > 250 then   // 250 × 20ms = 5 detik
          begin
            WriteLn(ErrOutput, 
              '[loop] watchdog: worker pool stuck selama 5s, forcing exit');
            Flush(ErrOutput);
            Break;
          end;
          Sleep(20);
          Continue;
        end;
        Break;
      end
      else
        StuckCount := 0;   // reset setiap ada progress
      
    until False;
    
    // Final cleanup zombie setelah loop berakhir
    ProcessGCZombies();
    
  finally
    // ✨ FIX: Restore context ke state sebelumnya
    GCurrentContext := SavedContext;
  end;
end;

{ ✅ Non-blocking single iteration. Dipakai oleh Native_Sleep supaya
  worker pool / http async / timer callback dapat diproses selama
  script masih running, bukan hanya setelah script selesai. }
function TEventLoop.TickOnce(CallEnv: TSymbolTable): Integer;
var
  i, ReadyCount, DeadCount: Integer;
  Task: PEventTask;
  CurrentTime: QWord;
  ReadyTasks: array of PEventTask;
  DeadTasks: array of PEventTask;
  MiniVM: TVM;
  TempChunk: TChunk;
  PayloadItem, ResultVal: TValue;
  SavedContext: TEngineContext;
begin
  Result := 0;
  CheckPendingSignals(CallEnv);
  TickCoTasks;
  SavedContext := GCurrentContext;
  if Assigned(CallEnv) then
    try GCurrentContext := CallEnv.GetGlobal.Context;
    except end;
  
  try
    if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 1 then Exit;
    
    ReadyCount := 0; DeadCount := 0;
    CurrentTime := GetTickCount64;
    
    FLock.Acquire;
    try
      SetLength(ReadyTasks, FTasks.Count);
      SetLength(DeadTasks, FTasks.Count);
      
      for i := FTasks.Count - 1 downto 0 do
      begin
        Task := PEventTask(FTasks[i]);
        if not Task^.IsActive then
        begin
          DeadTasks[DeadCount] := Task;
          Inc(DeadCount);
          FTasks.Delete(i);
          Continue;
        end;
        
        if CurrentTime >= Task^.TriggerTime then
        begin
          ReadyTasks[ReadyCount] := Task;
          Inc(ReadyCount);
        end;
      end;
    finally
      FLock.Release;
    end;
    
    for i := 0 to DeadCount - 1 do
    begin
      Task := DeadTasks[i];
      if Assigned(Task^.CallbackFunc) then Task^.CallbackFunc.Free;
      if Assigned(Task^.Payloads) then Task^.Payloads.Free;
      Dispose(Task);
    end;
    
    for i := 0 to ReadyCount - 1 do
    begin
      Task := ReadyTasks[i];
      MiniVM := nil;
      TempChunk := nil;
      PayloadItem := nil;
      ResultVal := nil;
      
      if not Assigned(errMSG) then errMSG := Terror.Create;
      
      try
        try
          MiniVM := TVM.Create(CallEnv);
          TempChunk := TChunk.Create;
          TempChunk.AddInstruction(opcConstant, 
            TempChunk.AddConstant(Task^.CallbackFunc.Clone));
          
          if Task^.Payloads.Count > 0 then
          begin
            PayloadItem := Task^.Payloads[0];
            TempChunk.AddInstruction(opcConstant, 
              TempChunk.AddConstant(PayloadItem.Clone));
            TempChunk.AddInstruction(opcCall, 1);
            
            if Task^.TaskType <> etInterval then 
              Task^.Payloads.Clear; 
          end else 
            TempChunk.AddInstruction(opcCall, 0);
          
          TempChunk.AddInstruction(opcReturn);
          
          ResultVal := MiniVM.Run(TempChunk);
          if Assigned(ResultVal) then ResultVal.Free;
        except
          on E: Exception do
          begin
            IOLock.Acquire;
            try 
              Writeln(#10'=== Uncaught in TickOnce ==='#10, E.Message); 
            finally 
              IOLock.Release; 
            end;
          end;
        end;
      finally
        if Assigned(TempChunk) then TempChunk.Free;
        if Assigned(MiniVM) then MiniVM.Free;
      end;
      
      FLock.Acquire;
      try
        if Task^.TaskType = etInterval then
          Task^.TriggerTime := GetTickCount64 + Task^.IntervalMs
        else 
          Task^.IsActive := False; 
      finally 
        FLock.Release; 
      end;
      
      Inc(Result);
    end;
  finally
    GCurrentContext := SavedContext;
  end;
end;

constructor TNativeEventEmitter.Create;
begin
  FListeners := TEventBusMap.Create;
  FLock := TCriticalSection.Create;
end;

destructor TNativeEventEmitter.Destroy;
var
  i: Integer;
begin
  for i := 0 to FListeners.Count - 1 do
    FListeners.Data[i].Free; // Otomatis menghancurkan memori list internalnya
  FListeners.Free;
  FLock.Free;
  inherited;
end;

procedure TNativeEventEmitter.Subscribe(const EventName: string; Callback: TValue);
var
  List: TValueList;
  Idx: Integer;
begin
  if Callback.DataType <> dtFunction then
    raise EScriptRuntimeError.Create('Fatal: Subscribe membutuhkan argumen callback berupa fungsi!'); 

  FLock.Acquire;
  try
    Idx := FListeners.IndexOf(EventName);
    if Idx = -1 then
    begin
      List := TValueList.Create(True);
      FListeners.Add(EventName, List);
    end else
    begin
      List := FListeners.Data[Idx];
    end;
    List.Add(Callback.Clone); // Isolasi memory function
  finally
    FLock.Release;
  end;
end;

procedure TNativeEventEmitter.EmitEvent(const EventName: string; Args: TObjectList; CallEnv: TSymbolTable);
var
  Idx, i, argIdx: Integer;
  List, Snapshot: TValueList;
  TargetCallback, PayloadItem: TValue;
  MiniVM: TVM;
  TempChunk: TChunk;
begin
  Snapshot := TValueList.Create(True); // Penampung aman
  
  FLock.Acquire;
  try
    Idx := FListeners.IndexOf(EventName);
    if Idx <> -1 then
    begin
      List := FListeners.Data[Idx];
      // Salin referensi callback secepat mungkin
      for i := 0 to List.Count - 1 do
        Snapshot.Add(List[i].Clone); 
    end;
  finally
    // MUTLAK: Lepaskan kunci SEBELUM eksekusi VM agar thread lain tidak Hang!
    FLock.Release; 
  end;

  if Snapshot.Count = 0 then
  begin
    Snapshot.Free;
    Exit;
  end;

  try
    // Eksekusi callback dengan aman di luar Critical Section
    for i := 0 to Snapshot.Count - 1 do
    begin
      TargetCallback := Snapshot[i];
      MiniVM := TVM.Create(CallEnv.GetGlobal);
      TempChunk := TChunk.Create;
      try
        TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(TargetCallback.Clone));
        
        for argIdx := 1 to Args.Count - 1 do 
        begin
          PayloadItem := TValue(Args[argIdx]);
          TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(PayloadItem.Clone));
        end;
        
        TempChunk.AddInstruction(opcCall, Args.Count - 1);
        TempChunk.AddInstruction(opcReturn);
        
        MiniVM.Run(TempChunk).Free; 
      except
        on E: Exception do
        begin
          IOLock.Acquire;
          try Writeln('=== Event Emitter Exception pada [', EventName, '] ==='#10, E.Message); finally IOLock.Release; end;
        end;
      end;
      
      TempChunk.Free;
      MiniVM.Free;
    end;
  finally
    Snapshot.Free; // Bersihkan snapshot
  end;
end;

procedure TNativeEventEmitter.Mark;
var
  i: Integer;
  List: TValueList;
begin
  FLock.Acquire;
  try
    if Assigned(FListeners) then
    begin
      for i := 0 to FListeners.Count - 1 do
      begin
        List := FListeners.Data[i];
        if Assigned(List) then
        begin
          List.Mark; // TValueList sudah memiliki prosedur Mark Anda sendiri
        end;
      end;
    end;
  finally
    FLock.Release;
  end;
end;

