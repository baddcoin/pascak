function Native_CryptoAESEncrypt(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Plaintext, Key, IV, ModeStr: string;
  CipherRaw: RawByteString;
  Mode: TAESMode;
begin
  if (Args.Count < 2) or (Args.Count > 4) then
    raise EScriptRuntimeError.Create(
      'crypto.aesEncrypt(data, key, [iv], [mode]) butuh 2-4 argumen');
  if (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtString) then
    raise EScriptRuntimeError.Create(
      'crypto.aesEncrypt: data dan key harus string');

  Plaintext := TValue(Args[0]).StrVal;
  Key := TValue(Args[1]).StrVal;
  IV := '';
  Mode := amCBC;

  if Args.Count >= 3 then
  begin
    if TValue(Args[2]).DataType <> dtString then
      raise EScriptRuntimeError.Create('crypto.aesEncrypt: iv harus string');
    IV := TValue(Args[2]).StrVal;
  end;

  if Args.Count >= 4 then
  begin
    if TValue(Args[3]).DataType <> dtString then
      raise EScriptRuntimeError.Create('crypto.aesEncrypt: mode harus string');
    ModeStr := LowerCase(TValue(Args[3]).StrVal);
    if ModeStr = 'ecb' then Mode := amECB
    else if ModeStr = 'cbc' then Mode := amCBC
    else raise EScriptRuntimeError.Create('crypto.aesEncrypt: mode harus "cbc" atau "ecb"');
  end;

  try
    CipherRaw := AESEncrypt(RawByteString(Plaintext), RawByteString(Key),
                            RawByteString(IV), Mode);
  except
    on E: Exception do
      raise EScriptRuntimeError.Create('crypto.aesEncrypt: ' + E.Message);
  end;
  Result := TValue.CreateStr(string(CipherRaw));
end;

