// replace(source, oldStr, newStr) -> Ganti substring
function Native_Replace(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Source, OldStr, NewStr, ResStr: string;
  EstLength, DiffLen, MatchCount: Int64;
  ScanIdx: Integer;
begin
  if (Args.Count <> 3) or (TValue(Args[0]).DataType <> dtString) or 
       (TValue(Args[1]).DataType <> dtString) or (TValue(Args[2]).DataType <> dtString) then
      raise Exception.Create('Error: "replace" membutuhkan 3 argumen (Source, Old, New).');
  
  Source := TValue(Args[0]).StrVal;
  OldStr := TValue(Args[1]).StrVal;
  NewStr := TValue(Args[2]).StrVal;
  
  if Length(OldStr) = 0 then Exit(TValue.CreateStr(Source));

  if Length(NewStr) > Length(OldStr) then
  begin
    MatchCount := 0;
    ScanIdx := Pos(OldStr, Source);
    while ScanIdx > 0 do
    begin
      Inc(MatchCount);
      ScanIdx := PosEx(OldStr, Source, ScanIdx + Length(OldStr));
    end;

    DiffLen := Int64(Length(NewStr)) - Int64(Length(OldStr));
    EstLength := Int64(Length(Source)) + (MatchCount * DiffLen);
                 
    if EstLength > strMax then
    begin
      errMSG.callerror(40, 'Security Halt: Operasi replace melampaui batas string maksimal!', errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull); // DIPERBAIKI: Cegah eksekusi lanjut
    end;
  end;

  ResStr := StringReplace(Source, OldStr, NewStr, [rfReplaceAll]);
  Result := TValue.CreateStr(ResStr);
end;

function Native_Len(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var Target: TValue;
begin
  if Args.Count <> 1 then 
  begin
    errMSG.callerror(22,'Native_Len',errMSG.xrow,errMSG.xcol); 
    Exit(TValue.CreateNull); // DIPERBAIKI: Wajib Exit agar tidak crash (Access Violation)
  end;

  Target := TValue(Args[0]);
  if Target.DataType = dtString then
    Result := TValue.CreateNum(Helper_GetUTF8Length(Target.StrVal))
  else if Target.DataType = dtArray then
  begin
    Target.ArrayVal.FLock.Acquire; 
    try Result := TValue.CreateNum(Target.ArrayVal.Count);
    finally Target.ArrayVal.FLock.Release; end;
  end else 
  begin
    errMSG.callerror(23,'Native_Len',errMSG.xrow,errMSG.xcol); 
    Result := TValue.CreateNull;
  end;
end;

