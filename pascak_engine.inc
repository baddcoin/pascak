constructor TValue.CreateDict(ADict: TDictValue); // Constructor baru
begin
  inherited Create;           // Memanggil constructor dasar TObject
  FDataType := dtDict;        // Menetapkan tipe data sebagai Dictionary
  FDictVal := ADict;          // Menyimpan referensi ke objek TDictValue
  
  if Assigned(FDictVal) then
    FDictVal.Retain;          // Menaikkan RefCount agar tidak di-sweep saat masih digunakan
end;

constructor TValue.CreateDLL(ACtx: TDLLContext);
begin
  inherited Create;
  FDataType := dtDLLHandle;
  FDLLVal := ACtx;
  if Assigned(FDLLVal) then
    FDLLVal.Retain;
end;

destructor TValue.Destroy;
begin
  if FDataType = dtString then
  begin
    FreeQuotaCtx(Length(FStrVal) * SizeOf(Char));   // ✅ FASE 1.1
  end;

  if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 0 then
  begin
    case FDataType of

      dtArray:
        begin
          if Assigned(FArrayVal) then
          begin
            FArrayVal.Release;
            FArrayVal := nil;      // ← nil agar tidak dibaca lagi
          end;
        end;

      dtObject:
        begin
          if Assigned(FObjVal) then
          begin
            FObjVal.Release;
            FObjVal := nil;
          end;
        end;

      dtClassDef:
        begin
          if Assigned(FClassDefVal) then
          begin
            FClassDefVal.Release;
            FClassDefVal := nil;
          end;
        end;

      dtDict:
        begin
          if Assigned(FDictVal) then
          begin
            FDictVal.Release;
            FDictVal := nil;
          end;
        end;

      dtDLLHandle:
        begin
          if Assigned(FDLLVal) then
          begin
            FDLLVal.Release;
            FDLLVal := nil;
          end;
        end;
  
      dtFunction:
        begin
          if Assigned(FBoundSelf) then
          begin
            FBoundSelf.Free;
            FBoundSelf := nil;
          end;

          if Assigned(FClosureEnv) then
          begin
            FClosureEnv.Release;
            FClosureEnv := nil;
          end;

          if Assigned(FFuncVal) then
          begin
            FFuncVal.Release;
            FFuncVal := nil;
          end;
        end;

    end;
  end
  else
  begin
    // Saat shutdown, hindari dereference cascade — cukup nil-kan.
    FArrayVal     := nil;
    FObjVal       := nil;
    FClassDefVal  := nil;
    FDictVal      := nil;
    FBoundSelf    := nil;
    FClosureEnv   := nil;
    FFuncVal      := nil;
    FDLLVal       := nil;
  end;

  inherited Destroy;
end;

constructor EScriptUserThrow.Create(AValue: TValue);
begin
  inherited Create('Script exception');
  ThrownValue := AValue;
end;

destructor EScriptUserThrow.Destroy;
begin
  if Assigned(ThrownValue) then
  begin
    ThrownValue.Free;
    ThrownValue := nil;
  end;
  inherited;
end;

function TValue.Clone: TValue;
begin
  case FDataType of
    dtNumeric:    Result := TValue.CreateNum(FNumVal);
    dtString:     Result := TValue.CreateStr(FStrVal);
    dtBoolean:    Result := TValue.CreateBool(FBoolVal);
    dtPointer:    Result := TValue.CreatePtr(FPtrVal); 
    dtArray:      Result := TValue.CreateArray(FArrayVal);
    dtObject:     Result := TValue.CreateObj(FObjVal);
    dtFunction:   Result := TValue.CreateFunc(FFuncVal, FClosureEnv, FBoundSelf); 
    dtClassDef:   Result := TValue.CreateClassDef(FClassDefVal);
    dtNative:     Result := TValue.CreateNative(FNativeFunc); 
    dtNull:       Result := TValue.CreateNull;
    dtDict:       Result := TValue.CreateDict(FDictVal); 
    dtDLLHandle:  Result := TValue.CreateDLL(FDLLVal);

    else begin 
        Result := nil; // LOGIKA DIPERBAIKI: Cegah memori sampah (garbage result)
        if Assigned(errMSG) then // <-- PERBAIKAN: Cek keberadaan instance
          errMSG.callerror(4,'tvalue.clone',errMSG.xrow,errMSG.xcol); 
    end;
  end;
end;

function TValue.DeepClone(Visited: TCloneMap = nil; Depth: Integer = 0): TValue;
var
  NewArr: TValueList;
  NewDict: TDictValue;
  NewObj: TInstanceValue; 
  i, MapIdx: Integer;
  Key: string; 
  Val: TValue;
  OwnsMap: Boolean;
  Item: PDictItem;
  TempKeys: TStringArray; 
  ExpDict: TDictValue;
begin
  if Depth > MAX_CALL_STACK then 
    raise EScriptRuntimeError.Create('Fatal Error: Struktur objek bersarang terlalu dalam!');

  OwnsMap := False;
  if Visited = nil then 
  begin
    Visited := TCloneMap.Create;
    OwnsMap := True;
  end;

  try
    case FDataType of
      dtArray:
        begin
          MapIdx := Visited.IndexOf(Pointer(FArrayVal));
          if MapIdx <> -1 then Exit(Visited.Data[MapIdx].Clone); 
          
          NewArr := TValueList.Create(True);
          Result := TValue.CreateArray(NewArr); 
          
          Visited.Add(Pointer(FArrayVal), Result); 
          
          FArrayVal.FLock.Acquire;
          try              
            try
              NewArr.Capacity := FArrayVal.Count; 
              for i := 0 to FArrayVal.Count - 1 do
              begin
                if Assigned(FArrayVal[i]) then
                  NewArr.Add(FArrayVal[i].DeepClone(Visited, Depth + 1))
                else
                  NewArr.Add(TValue.CreateNull);
              end;
            except
              Result.Free;
              raise;        
            end;
          finally
            FArrayVal.FLock.Release;
          end;
        end;

      dtDict:
        begin
          MapIdx := Visited.IndexOf(Pointer(FDictVal));
          if MapIdx <> -1 then Exit(Visited.Data[MapIdx].Clone); 
    
          NewDict := TDictValue.Create;
          Result := TValue.CreateDict(NewDict); 
          Visited.Add(Pointer(FDictVal), Result);

          try
            FDictVal.FLock.Acquire;
            try
              for i := 0 to High(FDictVal.FBuckets) do
              begin
                Item := FDictVal.FBuckets[i];
                while Item <> nil do
                begin
                  if Assigned(Item^.Value) then
                    NewDict.SetValue(Item^.Key, Item^.Value.DeepClone(Visited, Depth + 1));
                  Item := Item^.Next;
                end;
              end;
            finally
              FDictVal.FLock.Release;
            end;
          except
            Result.Free;
            raise;
          end;
        end;
        
      dtObject:
        begin
          MapIdx := Visited.IndexOf(Pointer(FObjVal));
          if MapIdx <> -1 then Exit(Visited.Data[MapIdx].Clone);
          
          NewObj := TInstanceValue.Create(FObjVal.Definition);
          Result := TValue.CreateObj(NewObj);
          Visited.Add(Pointer(FObjVal), Result);
          
          try
            // KOREKSI MUTLAK: FLock.Acquire dihapus dari sini! 
            // Fungsi GetExportedDict SUDAH melakukan Locking. 
            // Memanggil Acquire 2 kali = Deadlock Permanen.
            ExpDict := FObjVal.Members.GetExportedDict; 
            try
              TempKeys := ExpDict.GetKeys; 
              for i := 0 to High(TempKeys) do
              begin
                Key := TempKeys[i];
                
                // ✅ FIX P1.5: GetValueClone + Free
                Val := ExpDict.GetValueClone(Key);
                try
                  if Assigned(Val) then
                    NewObj.Members.DefineVar(Key, Val.DeepClone(Visited, Depth + 1))
                  else
                    NewObj.Members.DefineVar(Key, TValue.CreateNull);
                finally
                  Val.Free;
                end;
              end;
            finally
              ExpDict.Free; 
            end;
          except
            Result.Free;
            raise;
          end;
        end;
        
      dtFunction:
        begin
          Result := TValue.CreateFunc(FFuncVal, FClosureEnv, nil); 
          if Assigned(FBoundSelf) then
             Result.FBoundSelf := FBoundSelf.DeepClone(Visited);
        end;

      dtPointer: 
        begin
          Result := TValue.CreatePtr(FPtrVal);
        end;      
      else Result := Self.Clone; 
    end;
  finally
    if OwnsMap then Visited.Free;
  end;
end;

function TValue.IsTrue: Boolean;
begin
  if FDataType = dtBoolean then Result := FBoolVal
  else if FDataType = dtNumeric then Result := FNumVal <> 0
  else if FDataType = dtDLLHandle then Result := Assigned(FDLLVal) and (FDLLVal.Handle <> NilHandle)
  else Result := False;
end;

procedure TValue.Mark;
var
  LocalType: TDataType;
  LocalArr: TValueList;
  LocalObj: TInstanceValue;
  LocalDict: TDictValue;
  LocalClosure: TSymbolTable;
  LocalBound: TValue;
begin
  // Snapshot atomic
  LocalType := FDataType;
  LocalArr := nil; LocalObj := nil; LocalDict := nil;
  LocalClosure := nil; LocalBound := nil;

  case LocalType of
    dtArray:  LocalArr := FArrayVal;
    dtObject: LocalObj := FObjVal;
    dtDict:   LocalDict := FDictVal;
    dtFunction:
      begin
        LocalClosure := FClosureEnv;
        LocalBound := FBoundSelf;
      end;
  end;

  // Traverse dengan referensi yang sudah stabil
  if Assigned(LocalArr) then LocalArr.Mark;
  if Assigned(LocalObj) then LocalObj.Mark;
  if Assigned(LocalDict) then LocalDict.Mark;
  if Assigned(LocalClosure) then LocalClosure.Mark;
  if Assigned(LocalBound) then LocalBound.Mark;
end;

class function TValue.NewInstance: TObject;
var
  P: Pointer;
  Ctx: TEngineContext;
  UseCtx: Boolean;
begin
  // ✅ FIX: Jamin AlignedValueSize selalu >= 16 sebelum dipakai.
  if AlignedValueSize < 16 then
    InterlockedCompareExchange(
      AlignedValueSize,
      (TValue.InstanceSize + 15) and not 15,
      0);

  Ctx := GCurrentContext;
  UseCtx := False;
  
  // ✅ Cek magic value + range check, TANPA exception
  if Assigned(Ctx) then
  begin
    UseCtx := Assigned(Ctx) and 
             (Ctx.FEngineMagic = ENGINE_MAGIC_CONST) and 
             Assigned(Ctx.MemLock);

  end;
  
  // 1. Alokasi quota (per-engine via context, fallback global)
  if UseCtx then
    InterlockedIncrement64(Ctx.AllocationCounter)
  else
    InterlockedIncrement(TotalAllocations);  // Fallback single-instance

  // 2. Ambil dari thread-local freelist
  if ThreadFreeValueList <> nil then
  begin
    P := ThreadFreeValueList;
    ThreadFreeValueList := PPointer(P)^;
  end else
  begin
    P := nil;
    if Assigned(GlobalFreeValueLock) then
    begin
      GlobalFreeValueLock.Acquire;
      try
        if GlobalFreeValueList <> nil then
        begin
          P := GlobalFreeValueList;
          GlobalFreeValueList := PPointer(P)^;
          PPointer(P)^ := nil;   // putuskan reference ke next
        end;
      finally
        GlobalFreeValueLock.Release;
      end;
    end;
  
    // Alokasi dari arena jika freelist kosong
    if P = nil then
    begin
      if UseCtx and Assigned(Ctx.ArenaLock) then
        P := Ctx.AllocateFromArena(AlignedValueSize)
      else
      begin
        if (ThreadBumpPtr = nil) or (ThreadBumpPtr + AlignedValueSize > ThreadBumpEnd) then
          AllocateNewArena;
        P := ThreadBumpPtr;
        Inc(ThreadBumpPtr, AlignedValueSize);
      end;
    end;
  
    Result := TObject(P);
    InitInstance(Result);
    
    // 5. Tracking
    if UseCtx and Assigned(Ctx.AllocTracker) and Ctx.AllocTracker.FEnabled then
      Ctx.AllocTracker.Track(P, AlignedValueSize, 'TValue', 
        IfThen(Assigned(errMSG), errMSG.xrow, 0));
  end;
end;

procedure TValue.FreeInstance;
var
  RawMem: Pointer;
  Ctx: TEngineContext;
  UseCtx: Boolean;
begin
  RawMem := Pointer(Self);

  // 1. Finalize managed fields (FStrVal, dll).
  Self.CleanupInstance;

  // 2. Zero ALL reference fields manually — mencegah stale data
  //    ketika blok memori ini di-reuse.
  Self.FObjVal       := nil;
  Self.FArrayVal     := nil;
  Self.FFuncVal      := nil;
  Self.FClosureEnv   := nil;
  Self.FClassDefVal  := nil;
  Self.FNativeFunc   := nil;
  Self.FDictVal      := nil;
  Self.FBoundSelf    := nil;
  Self.FDLLVal       := nil;   // ✅ F-1
  Self.FPtrVal       := nil;
  Self.FNumVal       := 0.0;
  Self.FBoolVal      := False;
  Self.FDataType     := dtNull;

  // 3. Probe context dengan aman.
  Ctx := GCurrentContext;
  UseCtx := False;

  if Assigned(Ctx) then
  begin
    UseCtx := Assigned(Ctx) and
             (Ctx.FEngineMagic = ENGINE_MAGIC_CONST) and
             Assigned(Ctx.MemLock);
  end;

  // 4. Return ke GLOBAL freelist (thread-safe untuk cross-thread free).
  if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 0 then
  begin
    if Assigned(GlobalFreeValueLock) then
    begin
      GlobalFreeValueLock.Acquire;
      try
        PPointer(RawMem)^ := GlobalFreeValueList;
        GlobalFreeValueList := RawMem;
      finally
        GlobalFreeValueLock.Release;
      end;
    end;
  end;

  // 5. Untrack + FreeQuota (dengan guard).
  if UseCtx and Assigned(Ctx.AllocTracker) and Ctx.AllocTracker.FEnabled then
    Ctx.AllocTracker.Untrack(RawMem);

  // NOTE: JANGAN panggil Ctx.FreeQuota di sini — TValue alloc tidak
  // pernah memanggil AllocateQuota (hanya string yang melakukannya
  // via CreateStr, dan sudah di-free di TValue.Destroy).
end;

