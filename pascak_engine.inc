    Exit(TValue.CreateBool(False));
  end;
  
  Listener := TWSListenerThread.Create(Handle, Ctx);
  Server^.ListenerThread := Listener;
  Listener.Start;
  
  Result := TValue.CreateBool(True);
end;

function Native_WS_Clients(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Handle, i: Integer;
  Arr: TValueList;
  Conn: TWSConnection;
  Server: PWSServerEntry;
  NBSIds: TStringArray;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'ws.clients(handle) butuh 1 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateArray(TValueList.Create(True)));
  end;
  Handle := Trunc(TValue(Args[0]).NumVal);
  
  // B.1.4c: event mode — query dari GWSEventLoop
  Server := GetWSServer(Handle);
  if Assigned(Server) and Assigned(Server^.NBSConfig) then
  begin
    Arr := TValueList.Create(True);
    try
      if Assigned(GWSEventLoop) then
      begin
        NBSIds := GWSEventLoop.GetConnIDsForServer(Handle);
        for i := 0 to High(NBSIds) do
          Arr.Add(TValue.CreateStr(NBSIds[i]));
      end;
      Result := TValue.CreateArray(Arr);
    except
      Arr.Free;
      raise;
    end;
    Exit;
  end;
  
  Arr := TValueList.Create(True);  
  
  try
    GWSConnectionsLock.Acquire;
    try
      for i := 0 to GWSConnections.Count - 1 do
      begin
        Conn := TWSConnection(GWSConnections.Objects[i]);
        if Assigned(Conn) and (Conn.ServerHandle = Handle)
           and (Conn.State = wscsOpen) then
          Arr.Add(TValue.CreateStr(Conn.ConnID));
      end;
    finally
      GWSConnectionsLock.Release;
    end;
    Result := TValue.CreateArray(Arr);
  except
    Arr.Free;
    raise;
  end;
end;
//WebSocket Native Bindings end

{ A.1b — Decode chunked transfer encoding (RFC 7230 §4.1)
  Input: full response buffer, Offset = posisi byte pertama setelah headers
  Output: Decoded = body yang sudah di-decode (tanpa chunk metadata)
  Return: True kalau terminator '0\r\n' ketemu (complete), False kalau incomplete/invalid }
function DecodeChunkedBody(const Data: RawByteString; Offset: Integer;
  out Decoded: RawByteString): Boolean;
var
  Pos, LineEnd, DataStart, DataEnd, i: Integer;
  SizeHex: string;
  ChunkSize: Int64;
  c: Char;
begin
  Result := False;
  Decoded := '';
  if (Offset < 1) or (Offset > Length(Data)) then Exit;

  Pos := Offset;
  while Pos <= Length(Data) do
  begin
    // Cari akhir baris chunk-size
    LineEnd := Pos;
    while (LineEnd <= Length(Data)) and (Data[LineEnd] <> #10) do
      Inc(LineEnd);
    if LineEnd > Length(Data) then Exit;   // incomplete

    // Extract hex size (skip extension setelah ';')
    SizeHex := '';
    i := Pos;
    while (i < LineEnd) and (Data[i] <> ';') and (Data[i] <> #13) do
    begin
      SizeHex := SizeHex + Data[i];
      Inc(i);
    end;

    // Parse hex
    ChunkSize := 0;
    for i := 1 to Length(SizeHex) do
    begin
      c := SizeHex[i];
      if (c >= '0') and (c <= '9') then
        ChunkSize := ChunkSize * 16 + (Ord(c) - Ord('0'))
      else if (c >= 'a') and (c <= 'f') then
        ChunkSize := ChunkSize * 16 + (Ord(c) - Ord('a') + 10)
      else if (c >= 'A') and (c <= 'F') then
        ChunkSize := ChunkSize * 16 + (Ord(c) - Ord('A') + 10)
      else
        Exit;   // invalid hex
    end;

    // Advance past CRLF
    Pos := LineEnd + 1;

    // Chunk size 0 = end
    if ChunkSize = 0 then
    begin
      Result := True;
      Exit;
    end;

    // Read chunk data
    DataStart := Pos;
    DataEnd := DataStart + ChunkSize - 1;
    if DataEnd > Length(Data) then Exit;   // incomplete

    Decoded := Decoded + Copy(Data, DataStart, ChunkSize);
    Pos := DataEnd + 1;

    // Skip CRLF after data
    if (Pos <= Length(Data)) and (Data[Pos] = #13) then Inc(Pos);
    if (Pos <= Length(Data)) and (Data[Pos] = #10) then Inc(Pos);
  end;
end;

// menghindari dependency ke fungsi internal pascak_http.pas.
function LocalFindCRLFCRLF(const S: RawByteString): Integer;
var 
  P: Integer;
begin
  Result := -1;
  P := 1;
  while P <= Length(S) - 3 do
  begin
    if (S[P] = #13) and (S[P+1] = #10) and 
       (S[P+2] = #13) and (S[P+3] = #10) then
      Exit(P);
    Inc(P);
  end;
end;

// Native: http.get(url) → {status, headers, body}
// Only HTTP (no HTTPS yet)
function Native_HTTP_Request(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Method, URL, Host, Path, BodyStr: string;
  HeadersList: TStringList;
  Port, Sock: Integer;
  ColonPos, SlashPos, SchemeEnd: Integer;
  RawReq, RespBuf, Chunk, BodySlice: RawByteString;
  R, HeaderEnd, BodyStart: Integer;
  ResultDict, HeadersDict: TDictValue;
  StatusLine, HeaderBlock: string;
  Lines: TStringArray;
  i, Space1, Space2, Colon: Integer;
  HdrName, HdrValue: string;

  Keys: TStringArray;
  HV: TValue;
  Rest: string;
  StatusText2: string;
  OldHeaderVal: TValue;
  
  UseTLS: Boolean;
  DefaultPort: Integer;
  TLSConn: TTLSConnection;
  TLSContextLocal: TTLSContext;
  
  // ✅ TLS verify + header override
  NoVerifyEnv: string;
  VerifyEnabled: Boolean;
  hIdx: Integer;
  hLine, hName, hVal: string;
        
  ErrDetail: string; 

  // A.1 — Pool
  PoolKey: string;
  PooledConn: PHTTPPooledConn;
  ContentLength: integer;
  ResContentLength: Integer;
  ResConnClose: Boolean;
  ResChunked: Boolean;
  ChunkBody: RawByteString;
  ChunkComplete: Boolean;
  Reusable: Boolean;
  HeaderParsed: Boolean;
  hdrLines: TStringArray;
  hdrIdx: Integer;
  hdrLine: string;
  
  procedure DBG_HTTP(const Msg: string);
  begin
    {$IFDEF HTTP_DEBUG}
    WriteLn(ErrOutput, '[http] ', Msg);
    Flush(ErrOutput);
    {$ENDIF}
  end;

begin
  if (Args.Count < 2) or (Args.Count > 4) or
     (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 
      'http.request(method, url, [headers], [body])', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Method := UpperCase(TValue(Args[0]).StrVal);
  URL := TValue(Args[1]).StrVal;
  HeadersList := nil;
  BodyStr := '';
  
  if Args.Count >= 3 then
    if TValue(Args[2]).DataType = dtDict then
    begin
      HeadersList := TStringList.Create;
      Keys := TValue(Args[2]).DictVal.GetKeys;              // ← assignment biasa
      for i := 0 to High(Keys) do
      begin
        HV := TValue(Args[2]).DictVal.GetValueClone(Keys[i]);  // ← assignment biasa
        if Assigned(HV) and (HV.DataType = dtString) then
          HeadersList.Add(Keys[i] + ': ' + HV.StrVal);
        HV.Free;
      end;
    end;
  
  if Args.Count >= 4 then
    if TValue(Args[3]).DataType = dtString then
      BodyStr := TValue(Args[3]).StrVal;
  
  try
    SchemeEnd := Pos('://', URL);
    if SchemeEnd = 0 then
    begin
      errMSG.callerror(139, 'http.request: URL harus http://... atau https://...',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;
    
    UseTLS := (Copy(URL, 1, 5) = 'https') or (Copy(URL, 1, 5) = 'HTTPS');
    DefaultPort := 80;
    if UseTLS then DefaultPort := 443;
    
    Rest := Copy(URL, SchemeEnd + 3, Length(URL));    
    SlashPos := Pos('/', Rest);
    if SlashPos = 0 then
    begin
      Host := Rest;
      Path := '/';
    end
    else
    begin
      Host := Copy(Rest, 1, SlashPos - 1);
      Path := Copy(Rest, SlashPos, Length(Rest));
    end;
    
    ColonPos := Pos(':', Host);
    if ColonPos > 0 then
    begin
      Port := StrToIntDef(Copy(Host, ColonPos + 1, Length(Host)), DefaultPort);
      Host := Copy(Host, 1, ColonPos - 1);
    end
    else
      Port := DefaultPort;
    
    DBG_HTTP('URL parsed: host=' + Host + ' port=' + IntToStr(Port) + ' path=' + Path);
    
    // Determine verify BEFORE pool key (affects pool identity)
    if UseTLS then
    begin
      if GDangerousEnvAllowed then
        NoVerifyEnv := GetEnvironmentVariable('PASCAK_TLS_NO_VERIFY')
      else
        NoVerifyEnv := '';
      VerifyEnabled := NoVerifyEnv <> '1';
      if VerifyEnabled and Assigned(HeadersList) then
      begin
        hIdx := 0;
        while hIdx < HeadersList.Count do
        begin
          hLine := HeadersList[hIdx];
          ColonPos := Pos(':', hLine);
          if ColonPos > 0 then
          begin
            hName := Trim(Copy(hLine, 1, ColonPos - 1));
            hVal := Trim(Copy(hLine, ColonPos + 1, Length(hLine)));
            if (LowerCase(hName) = 'x-pascak-no-verify') and (hVal = '1') then
            begin
              VerifyEnabled := False;
              Break;
            end;
          end;
          Inc(hIdx);
        end;
      end;
    end
    else
      VerifyEnabled := True;
    
    // Build pool key
    PoolKey := Host + ':' + IntToStr(Port) + ':' +
               IfThen(UseTLS, 'T', 'P') + ':' +
               IfThen(VerifyEnabled, 'V', 'N');
 
    Sock := -1;
    // Try pool first
    PooledConn := nil;
    if Assigned(GHTTPPoolLock) then
      PooledConn := HTTPPoolGet(PoolKey);

    if Assigned(PooledConn) then
    begin
      Sock := PooledConn^.Sock;
      TLSConn := PooledConn^.TLSConn;
      TLSContextLocal := PooledConn^.TLSContextRef;
      PooledConn^.TLSConn := nil;
      PooledConn^.TLSContextRef := nil;
      PooledConn^.Sock := -1;
      Dispose(PooledConn);
      Inc(GHTTPPoolHits);
      DBG_HTTP('pool HIT — reusing conn');
    end
    else
    begin
      Inc(GHTTPPoolMisses);
      DBG_HTTP('pool MISS — new connect');
      if not NetConnect(Host, Port, HTTP_CLIENT_TIMEOUT, Sock) then
      begin
        errMSG.callerror(145, 'http.request: connect gagal — ' + NetLastError,
                         errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;
    end;
    
    // ✅ E-2: wrap dengan TLS jika https://
    // A.1: skip handshake kalau pool hit (TLSConn sudah connected)
    if UseTLS and (not Assigned(TLSConn)) then
    begin
      if not TLSInit then
      begin
        NetClose(Sock);
        errMSG.callerror(144, 'http.request: TLS tidak tersedia (libssl belum di-load)',
                         errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;
    
      TLSContextLocal := GetSharedTLSContext(VerifyEnabled);
      if not Assigned(TLSContextLocal) then
      begin
        NetClose(Sock);
        errMSG.callerror(144, 'http.request: gagal buat TLS context',
                         errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;
    
      if not TLSConnect(TLSContextLocal, Sock, Host, TLSConn) then
      begin
        ErrDetail := 'http.request: TLS handshake gagal — ' + TLSConn.LastError;
    
        if Assigned(TLSConn) then
        begin
          TLSConn.Release;
          TLSConn := nil;
        end;
        if Assigned(TLSContextLocal) then
        begin
          TLSContextLocal.Release;
          TLSContextLocal := nil;
        end;
        NetClose(Sock);
    
        errMSG.callerror(144, ErrDetail, errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;
    
      DBG_HTTP('TLS handshake OK');
    end;
    
    // A.1: force keep-alive for pooling
    if not Assigned(HeadersList) then
      HeadersList := TStringList.Create;
    HeadersList.Add('Connection: keep-alive');
   
    try
      RawReq := BuildHTTPRequest(Method, Path, Host, HeadersList, StrToRaw(BodyStr));
      DBG_HTTP('sending request, len=' + IntToStr(Length(RawReq)));
      if UseTLS then
      begin
        if TLSSend(TLSConn, RawReq) < 0 then
        begin
          errMSG.callerror(144, 'http.request: TLS send gagal — ' + TLSConn.LastError,
                           errMSG.xrow, errMSG.xcol);
          Exit(TValue.CreateNull);
        end;
      end
      else
      begin
        if NetSend(Sock, RawReq) < 0 then
        begin
          errMSG.callerror(144, 'http.request: send gagal', errMSG.xrow, errMSG.xcol);
          Exit(TValue.CreateNull);
        end;
      end;
      
      RespBuf := '';
      HeaderEnd := -1;
      ContentLength := -1;
      ResContentLength := -1;
      ResConnClose := False;
      ResChunked := False;
      ChunkComplete := False;
      HeaderParsed := False; 
      
      while True do
      begin
        if UseTLS then
          R := TLSRecv(TLSConn, 4096, Chunk)
        else
          R := NetRecvTimeout(Sock, 4096, HTTP_CLIENT_TIMEOUT, Chunk);
        if R <= 0 then Break;
        RespBuf := RespBuf + Chunk;
        
        // Parse headers once we have full header block
        if not HeaderParsed then
        begin
          HeaderEnd := LocalFindCRLFCRLF(RespBuf);
          if HeaderEnd > 0 then
          begin
            HeaderParsed := True;
            HeaderBlock := Copy(RespBuf, 1, HeaderEnd - 1);
            hdrLines := HeaderBlock.Split([#13#10]);
            for hdrIdx := 1 to High(hdrLines) do
            begin
              hdrLine := hdrLines[hdrIdx];
              if (Length(hdrLine) >= 15) and
                 SameText(Copy(hdrLine, 1, 15), 'Content-Length:') then
                ResContentLength := StrToIntDef(
                  Trim(Copy(hdrLine, 16, Length(hdrLine))), -1)
              
              else if (Length(hdrLine) >= 18) and
                      SameText(Copy(hdrLine, 1, 18), 'Transfer-Encoding:') then
              begin
                if Pos('chunked', LowerCase(hdrLine)) > 0 then
                begin
                  ResContentLength := -1;
                  ResChunked := True;
                end;
              end
              
              else if (Length(hdrLine) >= 11) and
                      SameText(Copy(hdrLine, 1, 11), 'Connection:') then
              begin
                if Pos('close', LowerCase(hdrLine)) > 0 then
                  ResConnClose := True;
              end;
            end;
          end;
        end;
        
        // Stop early: Content-Length known
        if HeaderParsed and (ResContentLength >= 0) then
        begin
          if Length(RespBuf) >= HeaderEnd + 3 + ResContentLength then
            Break;
        end;
        
        // Stop early: chunked, cek terminator '0\r\n'
        if HeaderParsed and ResChunked then
        begin
          if DecodeChunkedBody(RespBuf, HeaderEnd + 4, ChunkBody) then
          begin
            ChunkComplete := True;
            Break;
          end;
        end;
        
      end;
      DBG_HTTP('read done, total=' + IntToStr(Length(RespBuf)) + ' bytes');
      
      HeaderEnd := LocalFindCRLFCRLF(RespBuf);
      DBG_HTTP('HeaderEnd=' + IntToStr(HeaderEnd) + ' BodyStart=' + IntToStr(HeaderEnd + 4));
      if HeaderEnd < 0 then
      begin
        errMSG.callerror(144, 'http.request: response malformed', 
                         errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;
      
      HeaderBlock := Copy(RespBuf, 1, HeaderEnd - 1);
      BodyStart := HeaderEnd + 4;
      
      // A.1b — De-chunk body kalau chunked
      if ResChunked then
      begin
        if not ChunkComplete then
        begin
          // Fallback: coba decode sekali lagi
          if not DecodeChunkedBody(RespBuf, BodyStart, ChunkBody) then
          begin
            // Incomplete — tutup socket, tidak reusable
            ChunkBody := '';
            ResConnClose := True;
          end
          else
            ChunkComplete := True;
        end;
      end;      
      
      Lines := HeaderBlock.Split([#13#10]);
      DBG_HTTP('header lines=' + IntToStr(Length(Lines)));
      
      StatusLine := Lines[0];
      Space1 := Pos(' ', StatusLine);
      StatusText2 := Copy(StatusLine, Space1 + 1, Length(StatusLine));  // ← assignment biasa
      Space2 := Pos(' ', StatusText2);
      
      ResultDict := TDictValue.Create;
      HeadersDict := TDictValue.Create;
      
      ResultDict.SetValue('status', 
        TValue.CreateNum(StrToIntDef(Copy(StatusText2, 1, Space2 - 1), 0)));
      
      ResultDict.SetValue('tls_verify',
        TValue.CreateBool(VerifyEnabled));
  
      for i := 1 to High(Lines) do
      begin
        if Lines[i] = '' then Continue;
        Colon := Pos(':', Lines[i]);
        if Colon <= 0 then Continue;
        DBG_HTTP('  hdr[' + IntToStr(i) + ']');
        HdrName := Trim(Copy(Lines[i], 1, Colon - 1));
        HdrValue := Trim(Copy(Lines[i], Colon + 1, Length(Lines[i])));
        
        // ✅ E-1b-2: accumulate duplicate headers (Set-Cookie, etc.)
        if HeadersDict.HasKey(HdrName) then
        begin
          OldHeaderVal := HeadersDict.GetValueClone(HdrName);
          if Assigned(OldHeaderVal) and (OldHeaderVal.DataType = dtString) then
            HeadersDict.SetValue(HdrName,
              TValue.CreateStr(OldHeaderVal.StrVal + ', ' + HdrValue))
          else
            HeadersDict.SetValue(HdrName, TValue.CreateStr(HdrValue));
          if Assigned(OldHeaderVal) then OldHeaderVal.Free;
        end
        else
          HeadersDict.SetValue(HdrName, TValue.CreateStr(HdrValue));
      end;
      
      ResultDict.SetValue('headers', TValue.CreateDict(HeadersDict));
      
      DBG_HTTP('building body from ' + IntToStr(BodyStart) + ' to ' + IntToStr(Length(RespBuf)));
      
      // A.1b — pakai de-chunked body kalau chunked
      if ResChunked then
      begin
        if ChunkComplete then
          BodySlice := ChunkBody
        else
          BodySlice := '';
      end
      else
      begin
        if (BodyStart >= 1) and (BodyStart <= Length(RespBuf)) then
        begin
          SetLength(BodySlice, Length(RespBuf) - BodyStart + 1);
          if Length(BodySlice) > 0 then
            Move(RespBuf[BodyStart], BodySlice[1], Length(BodySlice));
        end
        else
          BodySlice := '';
      end;
      
      if Length(BodySlice) > 0 then
      begin
        SetLength(BodyStr, Length(BodySlice));
        Move(BodySlice[1], BodyStr[1], Length(BodySlice));
      end
      else
        BodyStr := '';
      
      ResultDict.SetValue('body', TValue.CreateStr(BodyStr));      
      
      Result := TValue.CreateDict(ResultDict);
    finally
      // A.1 + A.1b: Decide pool vs close
      Reusable := HeaderParsed and (not ResConnClose) and (Sock >= 0) and
                  (((ResContentLength >= 0)) or
                   (ResChunked and ChunkComplete));     
                   
      if Reusable and Assigned(GHTTPPoolLock) then
      begin
        if HTTPPoolPut(PoolKey, Host, Port, Sock, TLSConn, TLSContextLocal) then
        begin
          DBG_HTTP('pool RETURN — conn back to pool');
          Sock := -1;
          TLSConn := nil;
          TLSContextLocal := nil;
        end
        else
        begin
          DBG_HTTP('pool REJECT — pool full, closing');
          if UseTLS and Assigned(TLSConn) then
          begin
            TLSClose(TLSConn);
            TLSConn.Release;
            TLSConn := nil;
          end;
          if Assigned(TLSContextLocal) then
          begin
            TLSContextLocal.Release;
            TLSContextLocal := nil;
          end;
          if Sock >= 0 then NetClose(Sock);
        end;
      end
      else
      begin
        if UseTLS and Assigned(TLSConn) then
        begin
          TLSClose(TLSConn);
          TLSConn.Release;
          TLSConn := nil;
        end;
        if Assigned(TLSContextLocal) then
        begin
          TLSContextLocal.Release;
          TLSContextLocal := nil;
        end;
        if Sock >= 0 then NetClose(Sock);
      end;
    end;
  finally
    if Assigned(HeadersList) then HeadersList.Free;
  end;
end;

// Convenience wrappers
function Native_HTTP_Get(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var 
  NewArgs: TObjectList;
  MethodVal: TValue;
begin
  if (Args.Count < 1) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'http.get(url, [headers]) butuh 1-2 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  NewArgs := TObjectList.Create(False);
  MethodVal := TValue.CreateStr('GET');
  try
    NewArgs.Add(MethodVal);
    NewArgs.Add(Args[0]);
    if Args.Count >= 2 then NewArgs.Add(Args[1]);
    Result := Native_HTTP_Request(NewArgs, CallEnv);
  finally
    MethodVal.Free;
    NewArgs.Free;
  end;
end;

function Native_HTTP_Post(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var 
  NewArgs: TObjectList;
  MethodVal: TValue;
begin
  if (Args.Count < 1) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'http.post(url, [headers], [body]) butuh 1-3 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  NewArgs := TObjectList.Create(False);
  MethodVal := TValue.CreateStr('POST');
  try
    NewArgs.Add(MethodVal);
    NewArgs.Add(Args[0]);
    if Args.Count >= 2 then NewArgs.Add(Args[1]);
    if Args.Count >= 3 then NewArgs.Add(Args[2]);
    Result := Native_HTTP_Request(NewArgs, CallEnv);
  finally
    MethodVal.Free;
    NewArgs.Free;
  end;
end;

// Worker-side: blocking HTTPS dengan error handling → dict
function Native_HTTPSync(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  InnerArgs: TObjectList;
  UrlArg: TValue;
  ErrDict: TDictValue;
begin
  if (Args.Count < 1) or (TValue(Args[0]).DataType <> dtString) then
  begin
    ErrDict := TDictValue.Create;
    ErrDict.SetValue('error', TValue.CreateStr('Native_HTTPSync: URL harus string'));
    Exit(TValue.CreateDict(ErrDict));
  end;
  
  UrlArg := TValue(Args[0]);
  InnerArgs := TObjectList.Create(False);
  try
    InnerArgs.Add(UrlArg);
    
    try
      Result := Native_HTTP_Get(InnerArgs, CallEnv);
    except
      on E: Exception do
      begin
        ErrDict := TDictValue.Create;
        ErrDict.SetValue('error', TValue.CreateStr(E.Message));
        // ✅ FASE 1.5: marker reserved
        ErrDict.SetValue('__worker_crash', TValue.CreateBool(True));
        ErrDict.SetValue('__worker_kind', TValue.CreateStr(E.ClassName));
        Result := TValue.CreateDict(ErrDict);
      end;
    end;
  finally
    InnerArgs.Free;
  end;
end;

// Main-thread: enqueue task ke worker pool
function Native_HTTP_Get2(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  URL, Host, Path, BodyStr, Rest, PoolKey: string;
  ExtraHeaders: THPACKHeaderArray;
  Port, Sock, ColonPos, SlashPos, SchemeEnd: Integer;
  Keys: TStringArray;
  i: Integer;
  HV: TValue;
  Ctx: TTLSContext;
  TLSConn: TTLSConnection;
  Negotiated: string;
  H2: TH2Connection;
  Resp: TH2Response;
  ResultDict, HeadersDict: TDictValue;
  PoolEntry: TH2PooledEntry;
  GotFromPool: Boolean;
begin
  if (Args.Count < 1) or (Args.Count > 3) or
     (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'http.get2(url, [headers], [body])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  URL := TValue(Args[0]).StrVal;
  BodyStr := '';
  SetLength(ExtraHeaders, 0);

  if Args.Count >= 2 then
    if TValue(Args[1]).DataType = dtDict then
    begin
      Keys := TValue(Args[1]).DictVal.GetKeys;
      SetLength(ExtraHeaders, Length(Keys));
      for i := 0 to High(Keys) do
      begin
        ExtraHeaders[i].Name := LowerCase(Keys[i]);
        HV := TValue(Args[1]).DictVal.GetValueClone(Keys[i]);
        if Assigned(HV) then
        begin
          try
            if HV.DataType = dtString then
              ExtraHeaders[i].Value := HV.StrVal
            else
              ExtraHeaders[i].Value := TValueToString(HV, False);
          finally
            HV.Free;
          end;
        end
        else
          ExtraHeaders[i].Value := '';
      end;
    end;

  if Args.Count >= 3 then
    if TValue(Args[2]).DataType = dtString then
      BodyStr := TValue(Args[2]).StrVal;

  if Copy(LowerCase(URL), 1, 8) <> 'https://' then
  begin
    errMSG.callerror(139, 'http.get2: hanya https:// supported untuk h2',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  SchemeEnd := Pos('://', URL);
  Rest := Copy(URL, SchemeEnd + 3, Length(URL));
  SlashPos := Pos('/', Rest);
  if SlashPos = 0 then
  begin
    Host := Rest;
    Path := '/';
  end
  else
  begin
    Host := Copy(Rest, 1, SlashPos - 1);
    Path := Copy(Rest, SlashPos, Length(Rest));
  end;

  Port := 443;
  ColonPos := Pos(':', Host);
  if ColonPos > 0 then
  begin
    Port := StrToIntDef(Copy(Host, ColonPos + 1, Length(Host)), 443);
    Host := Copy(Host, 1, ColonPos - 1);
  end;

  PoolKey := LowerCase(Host) + ':' + IntToStr(Port);
  Sock := -1;
  Ctx := nil;
  TLSConn := nil;
  H2 := nil;
  PoolEntry := nil;
  GotFromPool := False;

  if Assigned(G_H2Pool) then
  begin
    PoolEntry := G_H2Pool.Get(PoolKey);
    if Assigned(PoolEntry) then
    begin
      H2 := PoolEntry.Conn;
      TLSConn := PoolEntry.TLSConn;
      Sock := PoolEntry.Sock;
      PoolEntry.Conn := nil;
      PoolEntry.TLSConn := nil;
      PoolEntry.Sock := -1;
      PoolEntry.Free;
      PoolEntry := nil;
      GotFromPool := True;
    end;
  end;

  try
    if not GotFromPool then
    begin
      if not NetConnect(Host, Port, 10000, Sock) then
      begin
        errMSG.callerror(145, 'http.get2: connect gagal - ' + NetLastError,
                         errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;

      if not TLSInit then
      begin
        errMSG.callerror(144, 'http.get2: TLS tidak tersedia',
                         errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;

      Ctx := TTLSContext.Create(True);
      if not TLSConnectALPN(Ctx, Sock, Host, ['h2'], TLSConn, Negotiated) then
      begin
        errMSG.callerror(144,
          'http.get2: TLS handshake gagal - ' + TLSConn.LastError,
          errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;

      if Negotiated <> 'h2' then
      begin
        errMSG.callerror(144,
          'http.get2: server tidak support h2 (negotiated: ' + Negotiated + ')',
          errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;

      H2 := TH2Connection.Create(TLSConn, Host);
      if not H2.Open(10000) then
      begin
        errMSG.callerror(144, 'http.get2: H2 handshake gagal',
                         errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;
    end;

    Resp := H2.Request('GET', Path, ExtraHeaders, BodyStr, 30000);

    if Resp.HasError then
    begin
      errMSG.callerror(144, 'http.get2: request gagal - ' + Resp.Error,
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;

    if (not H2.Closed) and Assigned(G_H2Pool) then
    begin
      PoolEntry := TH2PooledEntry.Create;
      PoolEntry.Key := PoolKey;
      PoolEntry.Conn := H2;
      PoolEntry.TLSConn := TLSConn;
      PoolEntry.Sock := Sock;
      H2 := nil;
      TLSConn := nil;
      Sock := -1;
      G_H2Pool.Put(PoolEntry);
      PoolEntry := nil;
    end;

    ResultDict := TDictValue.Create;
    try
      ResultDict.SetValue('status', TValue.CreateNum(Resp.Status));
      HeadersDict := TDictValue.Create;
      try
        for i := 0 to High(Resp.Headers) do
          HeadersDict.SetValue(Resp.Headers[i].Name,
            TValue.CreateStr(Resp.Headers[i].Value));
        ResultDict.SetValue('headers', TValue.CreateDict(HeadersDict));
      except
        HeadersDict.Free;
        raise;
      end;
      ResultDict.SetValue('body', TValue.CreateStr(string(Resp.Body)));
      ResultDict.SetValue('version', TValue.CreateStr('h2'));
      Result := TValue.CreateDict(ResultDict);
    except
      ResultDict.Free;
      raise;
    end;
  finally
    if Assigned(H2) then
    begin
      try H2.Close; except end;
      H2.Free;
    end;
    if Assigned(TLSConn) then
    begin
      try TLSClose(TLSConn); except end;
      TLSConn.Free;
    end;
    if Assigned(Ctx) then Ctx.Free;
    if Sock >= 0 then NetClose(Sock);
  end;
end;


function Native_HTTP_Get2PoolStats(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  D: TDictValue;
begin
  D := TDictValue.Create;
  try
    if Assigned(G_H2Pool) then
    begin
      D.SetValue('hits', TValue.CreateNum(G_H2Pool.GetHits));
      D.SetValue('misses', TValue.CreateNum(G_H2Pool.GetMisses));
      D.SetValue('idle', TValue.CreateNum(G_H2Pool.GetIdleCount));
      D.SetValue('maxPerHost', TValue.CreateNum(G_H2Pool.MaxPerHost));
      D.SetValue('idleMs', TValue.CreateNum(G_H2Pool.IdleMs));
    end
    else
    begin
      D.SetValue('hits', TValue.CreateNum(0));
      D.SetValue('misses', TValue.CreateNum(0));
      D.SetValue('idle', TValue.CreateNum(0));
      D.SetValue('maxPerHost', TValue.CreateNum(0));
      D.SetValue('idleMs', TValue.CreateNum(0));
    end;
    Result := TValue.CreateDict(D);
  except
    D.Free;
    raise;
  end;
end;

function Native_HTTP_Get2PoolConfig(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(139, 'http.get2PoolConfig(maxPerHost, [idleMs])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;

  if Assigned(G_H2Pool) then
  begin
    G_H2Pool.MaxPerHost := Trunc(TValue(Args[0]).NumVal);
    if (Args.Count = 2) and (TValue(Args[1]).DataType = dtNumeric) then
      G_H2Pool.IdleMs := Trunc(TValue(Args[1]).NumVal);
  end;
  Result := TValue.CreateBool(True);
end;

function Native_HTTP_Get2PoolClear(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  if Assigned(G_H2Pool) then
    G_H2Pool.Clear;
  Result := TValue.CreateBool(True);
end;

function Native_HTTP_GetAsync(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Url: string;
  Callback: TValue;
  Ctx: TEngineContext;
  FuncVal, UrlVal: TValue;
begin
  if (Args.Count <> 2) or
     (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtFunction) then
  begin
    errMSG.callerror(140,
      'http.getAsync(url, callback) butuh (string, function)',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Url := TValue(Args[0]).StrVal;
  Callback := TValue(Args[1]);
  
  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) or not Assigned(Ctx.WorkerPool) then
  begin
    errMSG.callerror(144, 'http.getAsync: worker pool tidak tersedia',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  FuncVal := TValue.CreateNative(@Native_HTTPSync);
  UrlVal := TValue.CreateStr(Url);
  try
    Ctx.WorkerPool.EnqueueTask(FuncVal, UrlVal, Callback);
  finally
    FuncVal.Free;
    UrlVal.Free;
  end;
  
  Result := TValue.CreateNull;
end;

