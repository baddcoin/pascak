procedure InitFSAsyncTasks;
begin
  if Assigned(GFSAsyncTasksLock) then Exit;
  GFSAsyncTasksLock := TCriticalSection.Create;
  GFSAsyncTasks := TList.Create;
  GFSAsyncTaskCounter := 0;
end;

procedure FreeFSAsyncTasks;
var
  i: Integer;
  Task: TFSAsyncTask;
  Snapshot: TList;
begin
  if not Assigned(GFSAsyncTasksLock) then Exit;

  Snapshot := TList.Create;
  try
    GFSAsyncTasksLock.Acquire;
    try
      for i := 0 to GFSAsyncTasks.Count - 1 do
        Snapshot.Add(GFSAsyncTasks[i]);
      GFSAsyncTasks.Clear;
    finally
      GFSAsyncTasksLock.Release;
    end;

    for i := 0 to Snapshot.Count - 1 do
    begin
      Task := TFSAsyncTask(Snapshot[i]);
      InterlockedExchange(Task.State, EXEC_TASK_CANCEL);
    end;

    for i := 0 to Snapshot.Count - 1 do
    begin
      Task := TFSAsyncTask(Snapshot[i]);
      try Task.Free; except end;
    end;
  finally
    Snapshot.Free;
  end;

  GFSAsyncTasks.Free; GFSAsyncTasks := nil;
  GFSAsyncTasksLock.Free; GFSAsyncTasksLock := nil;
end;

function FindFSAsyncTask(ID: Integer): TFSAsyncTask;
var i: Integer;
begin
  Result := nil;
  if not Assigned(GFSAsyncTasks) then Exit;
  for i := 0 to GFSAsyncTasks.Count - 1 do
    if TFSAsyncTask(GFSAsyncTasks[i]).ID = ID then
      Exit(TFSAsyncTask(GFSAsyncTasks[i]));
end;

procedure RegisterFSAsyncTask(Task: TFSAsyncTask);
begin
  if not Assigned(GFSAsyncTasks) then InitFSAsyncTasks;
  GFSAsyncTasksLock.Acquire;
  try GFSAsyncTasks.Add(Task);
  finally GFSAsyncTasksLock.Release; end;
end;

procedure UnregisterFSAsyncTask(Task: TFSAsyncTask);
var i: Integer;
begin
  if not Assigned(GFSAsyncTasks) then Exit;
  GFSAsyncTasksLock.Acquire;
  try
    for i := 0 to GFSAsyncTasks.Count - 1 do
      if TFSAsyncTask(GFSAsyncTasks[i]) = Task then
      begin
        GFSAsyncTasks.Delete(i);
        Break;
      end;
  finally GFSAsyncTasksLock.Release; end;
end;

procedure ProcessFSAsyncCallbacks;
var
  i: Integer;
  Task: TFSAsyncTask;
  ToFree: TList;
  Arg: TValue;
begin
  if not Assigned(GFSAsyncTasks) then Exit;
  if GFSAsyncTasks.Count = 0 then Exit;

  ToFree := TList.Create;
  try
    GFSAsyncTasksLock.Acquire;
    try
      for i := 0 to GFSAsyncTasks.Count - 1 do
      begin
        Task := TFSAsyncTask(GFSAsyncTasks[i]);
        if (InterlockedCompareExchange(Task.State, 0, 0) = EXEC_TASK_DONE)
           and Assigned(Task.Callback)
           and (Task.Callback.DataType = dtFunction)
           and (InterlockedCompareExchange(Task.CallbackFired, 1, 0) = 0) then
          ToFree.Add(Task);
      end;
    finally
      GFSAsyncTasksLock.Release;
    end;

    for i := 0 to ToFree.Count - 1 do
    begin
      Task := TFSAsyncTask(ToFree[i]);

      if Assigned(Task.ResultVal) then
      begin
        Arg := Task.ResultVal.Clone;
        try
          try CallWSCallback(Task.Callback, [Arg]);
          except
            on E: Exception do
              PushThreadError('fsAsync callback: ' + E.Message);
          end;
        finally Arg.Free; end;
      end;

      UnregisterFSAsyncTask(Task);
      try Task.Free; except end;
    end;
  finally
    ToFree.Free;
  end;
end;

