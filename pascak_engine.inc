function GetUTF8CharLen(const S: string; StartIdx: Integer): Integer; inline;
var
  B: Byte;
begin
  if (StartIdx < 1) or (StartIdx > Length(S)) then Exit(1); // <-- PERBAIKAN: Tambahan StartIdx < 1

  B := Ord(S[StartIdx]);
  if (B and $80) = 0 then Result := 1
  else if (B and $E0) = $C0 then Result := 2
  else if (B and $F0) = $E0 then Result := 3
  else if (B and $F8) = $F0 then Result := 4
  else Result := 1; 
end;

function Helper_GetUTF8Length(const S: string): Integer; inline;
var
  i: Integer;
begin
  Result := 0;
  i := 1;
  while i <= Length(S) do
  begin
    Inc(i, GetUTF8CharLen(S, i));
    Inc(Result);
  end;
end;

procedure FlushThreadTLAB;
var 
  TailPtr: Pointer; // PERBAIKAN: Variabel CurrPtr dihapus karena tidak berguna (dead code)
begin
  if ThreadFreeValueList = nil then Exit;

  TailPtr := ThreadFreeValueList; // PERBAIKAN: Langsung oper dari asal memori lokal
  
  // Cari Tail secara aman di memori LOKAL sebelum menyentuh Global Lock
  while PPointer(TailPtr)^ <> nil do
  begin
    TailPtr := PPointer(TailPtr)^;
  end;

  if (InterlockedCompareExchange(IsShuttingDown, 0, 0) = 0) and Assigned(GlobalFreeValueLock) then
  begin
    GlobalFreeValueLock.Acquire;
    try
      // Sambungkan Tail lokal ke Head Global saat ini
      PPointer(TailPtr)^ := GlobalFreeValueList;
      // Jadikan Head lokal sebagai Head Global baru
      GlobalFreeValueList := ThreadFreeValueList;
    finally
      GlobalFreeValueLock.Release;
    end;
  end;

  ThreadFreeValueList := nil;
end;

procedure AllocateNewArena;
var
  NewBlock: PArenaBlock;
  LocalAlign: Integer;
begin
  New(NewBlock);
  
  LocalAlign := (TValue.InstanceSize + 15) and not 15;
  if AlignedValueSize = 0 then
    InterlockedCompareExchange(AlignedValueSize, LocalAlign, 0);

  GetMem(NewBlock^.Data, ARENA_BLOCK_CAPACITY * AlignedValueSize);
  
  GlobalArenaLock.Acquire;
  try
    NewBlock^.Next := GlobalArenaBlocks;
    GlobalArenaBlocks := NewBlock;
  finally
    GlobalArenaLock.Release;
  end;
  
  ThreadBumpPtr := NewBlock^.Data;
  ThreadBumpEnd := ThreadBumpPtr + (ARENA_BLOCK_CAPACITY * AlignedValueSize);
end;

procedure CleanupArena;
var
  CurrBlock, NextBlock: PArenaBlock;
begin
  GlobalArenaLock.Acquire;
  try
    CurrBlock := GlobalArenaBlocks;
    while CurrBlock <> nil do
    begin
      NextBlock := CurrBlock^.Next;
      FreeMem(CurrBlock^.Data);
      Dispose(CurrBlock);
      CurrBlock := NextBlock;
    end;
    GlobalArenaBlocks := nil;
  finally
    GlobalArenaLock.Release;
  end;
end;

function GlobalHashString(const S: string): Cardinal; inline;
var
  i: Integer;
begin
  Result := 2166136261;
  for i := 1 to Length(S) do
    Result := Cardinal((Result xor Ord(S[i])) * Cardinal(16777619)); // <-- PERBAIKAN: Cast eksplisit ke Cardinal untuk wrap-around aman tanpa memicu Overflow Exception
end;

procedure AllocateQuota(Size: Int64);
var
  CurrentMem: Int64;
begin
  if GlobalMemQuota <= 0 then Exit; 
  
  CurrentMem := InterlockedExchangeAdd64(GlobalMemUsage, Size) + Size;
  
  if CurrentMem > GlobalMemQuota then
  begin
    InterlockedExchangeAdd64(GlobalMemUsage, -Size); 
    //Proteksi jika errMSG belum dibuat di thread saat ini
    if Assigned(errMSG) then
      errMSG.callerror(114, 'AllocateQuota', errMSG.xrow, errMSG.xcol)
    else
      raise EScriptRuntimeError.Create('Interpreter Halted: kehabisan memori (OOM)!'); 
  end;
end;

procedure FreeQuota(Size: Int64);
begin
  if GlobalMemQuota <= 0 then Exit;
  InterlockedExchangeAdd64(GlobalMemUsage, -Size);
end;

{ ✅ FASE 1.1: Context-aware quota wrapper.
  Fungsi ini menggantikan AllocateQuota untuk TValue string di engine
  yang punya TEngineContext aktif. Fallback ke global saat tidak ada
  context (mode single-instance). }
procedure AllocateQuotaCtx(Size: Int64);
var
  Ctx: TEngineContext;
  NewUsage: Int64;
begin
  if Size <= 0 then Exit;

  Ctx := GCurrentContext;
  if Assigned(Ctx) and (Ctx.FEngineMagic = ENGINE_MAGIC_CONST) then
  begin
    // Per-engine path
    if Ctx.MemQuota > 0 then
    begin
      NewUsage := InterlockedExchangeAdd64(Ctx.MemUsage, Size) + Size;
      if NewUsage > Ctx.MemQuota then
      begin
        InterlockedExchangeAdd64(Ctx.MemUsage, -Size);
        if Assigned(errMSG) then
          errMSG.callerror(114, 'AllocateQuotaCtx (engine OOM)',
                           errMSG.xrow, errMSG.xcol)
        else
          raise EScriptRuntimeError.Create(
            'Interpreter Halted: engine kehabisan memori (OOM)!');
      end;
    end
    else
      // Quota = 0 → unlimited, tetap track untuk stats
      InterlockedExchangeAdd64(Ctx.MemUsage, Size);
  end
  else
  begin
    // Fallback: global (single-instance / CLI mode)
    if GlobalMemQuota <= 0 then Exit;
    NewUsage := InterlockedExchangeAdd64(GlobalMemUsage, Size) + Size;
    if NewUsage > GlobalMemQuota then
    begin
      InterlockedExchangeAdd64(GlobalMemUsage, -Size);
      if Assigned(errMSG) then
        errMSG.callerror(114, 'AllocateQuota (global OOM)',
                         errMSG.xrow, errMSG.xcol)
      else
        raise EScriptRuntimeError.Create(
          'Interpreter Halted: kehabisan memori (OOM)!');
    end;
  end;
end;

procedure FreeQuotaCtx(Size: Int64);
var
  Ctx: TEngineContext;
begin
  if Size <= 0 then Exit;

  Ctx := GCurrentContext;
  if Assigned(Ctx) and (Ctx.FEngineMagic = ENGINE_MAGIC_CONST) then
    InterlockedExchangeAdd64(Ctx.MemUsage, -Size)
  else if GlobalMemQuota > 0 then
    InterlockedExchangeAdd64(GlobalMemUsage, -Size);
end;

{ ✅ FASE 0.2: Symlink resolution, cross-platform.
  Menyelesaikan symlink/junction pada path SEBELUM boundary check.
  Tanpa ini, symlink di dalam sandbox bisa escape ke luar
  (mis. `ln -s /etc sandbox/escape` → bypass boundary check).

  Pendekatan:
    - Unix/Android/macOS: realpath(3) via libc external binding
    - Windows: GetFinalPathNameByHandleW (resolve symlink + junction)
    - Fallback: ExpandFileName (syntactic normalization) }

{$IFDEF UNIX}
{ realpath(3) — binding langsung ke libc. Pola sama dengan
  c_setrlimit di pascak_proc.pas; terbukti bekerja di Termux aarch64. }
function c_realpath(path: PAnsiChar; resolved: PAnsiChar): PAnsiChar;
  cdecl; external 'c' name 'realpath';
{$ENDIF}

function SafeRealPathLenient(const Path: string): string;
var
  Dir, Name, Fallback: string;
  {$IFDEF UNIX}
  Buf: array[0..4095] of Char;
  Res: PAnsiChar;
  {$ENDIF}
  {$IFDEF WINDOWS}
  H: THandle;
  WDir, WResult: WideString;
  WBuf: array[0..8191] of WideChar;
  Ret: DWORD;
  {$ENDIF}
begin
  Dir  := ExtractFileDir(Path);
  Name := ExtractFileName(Path);
  Fallback := ExpandFileName(Path);

  // Root atau edge case — tidak ada parent untuk di-resolve
  if (Dir = '') or (Dir = Path) then
    Exit(Fallback);

  {$IFDEF UNIX}
  try
    Res := c_realpath(PAnsiChar(AnsiString(Dir)), @Buf[0]);
    if Res = nil then
      Exit(Fallback);
    if Name = '' then
      Result := string(AnsiString(Res))
    else
      Result := IncludeTrailingPathDelimiter(string(AnsiString(Res))) + Name;
  except
    Result := Fallback;
  end;
  {$ELSE}
    {$IFDEF WINDOWS}
    // Windows: resolve symlink/junction via WinAPI.
    // Membutuhkan FILE_FLAG_BACKUP_SEMANTICS untuk membuka directory handle.
    WDir := WideString(Dir);
    H := CreateFileW(PWideChar(WDir), 0,
          FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
          nil,
          OPEN_EXISTING,
          FILE_FLAG_BACKUP_SEMANTICS,
          0);

    if H = INVALID_HANDLE_VALUE then
      Exit(Fallback);

    try
      Ret := GetFinalPathNameByHandleW(H, @WBuf[0], 8192,
                                       FILE_NAME_NORMALIZED);
      if (Ret = 0) or (Ret >= 8192) then
        Exit(Fallback);

      WResult := WideString(WBuf);

      // Strip extended-length prefix: \\?\  atau  \\?\UNC\
      if Copy(WResult, 1, 8) = '\\?\UNC\' then
        WResult := '\\' + Copy(WResult, 9, Length(WResult) - 8)
      else if Copy(WResult, 1, 4) = '\\?\' then
        WResult := Copy(WResult, 5, Length(WResult) - 4);

      if Name = '' then
        Result := string(UTF8String(WResult))
      else
        Result := IncludeTrailingPathDelimiter(string(UTF8String(WResult))) + Name;
    finally
      CloseHandle(H);
    end;
    {$ELSE}
    Result := Fallback;
    {$ENDIF}
  {$ENDIF}
end;

function GetSafeSandboxedPath(const RequestedPath: string; const CallerFile: string = ''): string;
var
  BaseDir, ExpandedPath, CleanPath: string;
  NormBase, NormExp: string;
  i, WriteIdx: Integer;
  IsInside: Boolean;
  {$IFDEF WINDOWS}
  FileNameOnly: string;
  {$ENDIF}
  
  procedure ThrowSandboxError(Msg: string);
  begin
    if Assigned(errMSG) then
      errMSG.callerror(44, Msg, errMSG.xrow, errMSG.xcol)
    else
      raise EScriptFatalError.Create('Sandbox Violation: ' + Msg);
  end;

begin
  // ─── 1. Sanitasi kontrol karakter ───
  SetLength(CleanPath, Length(RequestedPath));
  WriteIdx := 0;
  for i := 1 to Length(RequestedPath) do
  begin
    if RequestedPath[i] >= #32 then
    begin
      Inc(WriteIdx);
      CleanPath[WriteIdx] := RequestedPath[i];
    end;
  end;
  SetLength(CleanPath, WriteIdx);

  // ─── 2. Tolak path absolut ───
  {$IFDEF WINDOWS}
  if (ExtractFileDrive(CleanPath) <> '') or (Pos('\', CleanPath) = 1) or (Pos('/', CleanPath) = 1) then
    ThrowSandboxError('Akses path absolut ditolak oleh Sandbox');
  {$ELSE}
  if (Length(CleanPath) > 0) and (CleanPath[1] = '/') then
    ThrowSandboxError('Akses path absolut ditolak oleh Sandbox');
  {$ENDIF}

  // ─── 3. Tentukan BaseDir ───
  if CallerFile <> '' then
    BaseDir := IncludeTrailingPathDelimiter(ExtractFilePath(ExpandFileName(CallerFile)))
  else if FileName <> '' then
    BaseDir := IncludeTrailingPathDelimiter(ExtractFilePath(ExpandFileName(FileName)))
  else
    BaseDir := IncludeTrailingPathDelimiter(GetCurrentDir); 

  // ─── 4. Expand target ───
  ExpandedPath := ExpandFileName(BaseDir + CleanPath);

  // ─── 5. Cek sandbox (trailing-slash-agnostic) ───
  // ✅ FASE 0.2: canonicalize via realpath — cegah symlink escape.
  NormBase := ExcludeTrailingPathDelimiter(SafeRealPathLenient(BaseDir));
  NormExp  := ExcludeTrailingPathDelimiter(SafeRealPathLenient(ExpandedPath));

  IsInside := False;
  if NormExp = NormBase then
    IsInside := True
  else if (Length(NormExp) > Length(NormBase)) and (Length(NormBase) > 0) then
  begin
    {$IFDEF WINDOWS}
    if SameText(Copy(NormExp, 1, Length(NormBase)), NormBase) then
    begin
      if (NormExp[Length(NormBase) + 1] = PathDelim) or
         (NormExp[Length(NormBase) + 1] = '/') then
        IsInside := True;
    end;
    {$ELSE}
    if Copy(NormExp, 1, Length(NormBase)) = NormBase then
    begin
      if NormExp[Length(NormBase) + 1] = PathDelim then
        IsInside := True;
    end;
    {$ENDIF}
  end;

  if not IsInside then
    ThrowSandboxError('Directory Traversal Terdeteksi (Dilarang menggunakan "..")');

  // ─── 6. Tolak DOS device names (Windows) ───
  {$IFDEF WINDOWS}
  FileNameOnly := UpperCase(ExtractFileName(ExpandedPath));
  if (FileNameOnly = 'CON') or (FileNameOnly = 'PRN') or (FileNameOnly = 'AUX') or
     (FileNameOnly = 'NUL') or (Pos('COM', FileNameOnly) = 1) or (Pos('LPT', FileNameOnly) = 1) then
    ThrowSandboxError('Akses perangkat I/O DOS dilarang');
  {$ENDIF}

  Result := ExpandedPath;
end;

// ═══════════════════════════════════════════════════════════════
//  Package import resolution (Fase D — Package Manager)
// ═══════════════════════════════════════════════════════════════
// Detect "@scope/name" atau "@scope/name/subpath"
function IsPackageImport(const S: string): Boolean; inline;
begin
  Result := (Length(S) > 2) and (S[1] = '@') and (Pos('/', S) > 2);
end;

// Walk up dari StartDir mencari project root (berisi pascak.json + packages/)
function FindProjectRoot(const StartDir: string): string;
var
  Dir, Parent: string;
  Levels: Integer;
begin
  Result := '';
  if StartDir = '' then Exit;

  try
    Dir := ExpandFileName(StartDir);
  except
    Exit;
  end;

  Levels := 0;
  while (Dir <> '') and (Dir <> '/') and (Levels < 20) do
  begin
    if FileExists(IncludeTrailingPathDelimiter(Dir) + 'pascak.json') and
       DirectoryExists(IncludeTrailingPathDelimiter(Dir) + 'packages') then
      Exit(Dir);

    Parent := ExtractFileDir(Dir);
    if (Parent = '') or (Parent = Dir) then Break;
    Dir := Parent;
    Inc(Levels);
  end;
end;

// EndsWith helper (FPC StrUtils punya di versi baru, tapi aman pakai manual)
function StrEndsWith(const S, Suffix: string): Boolean; inline;
var
  L, SL: Integer;
begin
  L := Length(S);
  SL := Length(Suffix);
  if SL > L then Exit(False);
  Result := Copy(S, L - SL + 1, SL) = Suffix;
end;

// Resolve "@scope/name" atau "@scope/name/subpath" → absolute file path
// Base resolution: cari project root dari CallerFile, cari `packages/@scope/name/`.
// Return '' kalau tidak ketemu.
function ResolvePackageImport(const ImportPath, CallerFile: string): string;
var
  Parts: TStringArray;
  PkgName, SubPath: string;
  BaseDir, PkgDir, ManifestPath, MainFile, Candidate: string;
  M: TPSManifest;
  CallerDir: string;
begin
  Result := '';

  // Split "@scope/name/sub/path"
  Parts := ImportPath.Split(['/']);
  if Length(Parts) < 2 then Exit;

  PkgName := Parts[0] + '/' + Parts[1];   // "@scope/name"
  if Length(Parts) >= 3 then
    SubPath := Copy(ImportPath, Length(PkgName) + 2, Length(ImportPath))
  else
    SubPath := '';

  // Cari project root
  if CallerFile <> '' then
    CallerDir := ExtractFilePath(ExpandFileName(CallerFile))
  else
    CallerDir := GetCurrentDir;

  BaseDir := FindProjectRoot(CallerDir);
  if BaseDir = '' then
  begin
    // Fallback: cwd-based
    if DirectoryExists(IncludeTrailingPathDelimiter(GetCurrentDir) + 'packages') then
      BaseDir := GetCurrentDir
    else
      Exit;
  end;

  PkgDir := IncludeTrailingPathDelimiter(BaseDir) + 'packages' +
            PathDelim + PkgName;

  if not DirectoryExists(PkgDir) then Exit;

  // Case A: subpath given → load directly
  if SubPath <> '' then
  begin
    Candidate := IncludeTrailingPathDelimiter(PkgDir) + SubPath;
    if not StrEndsWith(Candidate, '.pas') then
      Candidate := Candidate + '.pas';
    if FileExists(Candidate) then
      Exit(ExpandFileName(Candidate));
    Exit;
  end;

  // Case B: use manifest's main field
  ManifestPath := IncludeTrailingPathDelimiter(PkgDir) + 'pascak.json';
  if not FileExists(ManifestPath) then Exit;

  M := TPSManifest.Create;
  try
    if not PSManifestLoad(ManifestPath, M) then Exit;
    MainFile := M.Main;
    if MainFile = '' then
      MainFile := 'main.pas';
    if not StrEndsWith(MainFile, '.pas') then
      MainFile := MainFile + '.pas';

    Candidate := IncludeTrailingPathDelimiter(PkgDir) + MainFile;
    if FileExists(Candidate) then
      Result := ExpandFileName(Candidate);
  finally
    M.Free;
  end;
end;
//end Package Manager

function SafeNumericMath(const OpStr: string; const A, B: Double): Double;
var
  IsBZero: Boolean;
  SafeOp: string;
begin
  IsBZero := SameValue(B, 0.0, 1E-15);
  SafeOp := LowerCase(OpStr); 

  case SafeOp of
    '+': Exit(A + B);
    '-': Exit(A - B);
    '*': Exit(A * B);
    '/', '%', 'mod':
      begin
        if IsBZero then 
        begin
          if Assigned(errMSG) then // <-- PERBAIKAN: Penahan Access Violation object threadvar
            errMSG.callerror(12, 'SafeNumericMath: Division by zero', errMSG.xrow, errMSG.xcol); 
          Exit(0.0);
        end;
        
        if SafeOp = '/' then 
          Exit(A / B)
        else 
          Exit(A - (B * math.Floor((A / B) + 1E-14))); 
      end;
  else
    begin
      if Assigned(errMSG) then
        errMSG.callerror(45, 'SafeNumericMath: Unknown operator "' + OpStr + '"', errMSG.xrow, errMSG.xcol); 
      Exit(0.0);
    end;
  end;
end;

procedure SafeClearFuncValue(var FV: TValue); inline;
begin
  FV := nil;   // HANYA nil-kan. JANGAN Free!
end;
  
function ValuesAreEqual(a, b: TValue): Boolean;
begin
  Result := False;
  if (not Assigned(a)) or (not Assigned(b)) then Exit;
  
  if a.DataType = b.DataType then 
  begin
    case a.DataType of 
      dtNumeric: Result := SameValue(a.NumVal, b.NumVal, 1E-12); 
      dtString:  Result := (a.StrVal = b.StrVal); 
      dtBoolean: Result := (a.BoolVal = b.BoolVal); 
      dtObject:  Result := (a.ObjVal = b.ObjVal);   
      dtArray:   Result := (a.ArrayVal = b.ArrayVal);
      // PERBAIKAN: Menggunakan BoundSelf, bukan ObjVal untuk identitas Bound Method
      dtFunction:Result := (a.FuncVal = b.FuncVal) and (a.ClosureEnv = b.ClosureEnv) and (a.BoundSelf = b.BoundSelf); 
      dtNative:  Result := (Pointer(a.NativeFunc) = Pointer(b.NativeFunc)); 
      dtClassDef:Result := (a.ClassDefVal = b.ClassDefVal); 
      dtDict:    Result := (a.DictVal = b.DictVal); 
      dtPointer: Result := (a.PtrVal = b.PtrVal); 
      dtNull:    Result := True; 
    else
      Result := False;
    end;
  end;
end;

function Helper_GetNativeProperty(ObjValV: TValue; const MemberName: string): TValue;
var
  IdxMethod: Integer;
begin
  if ObjValV.DataType = dtString then 
  begin
    if MemberName = 'length' then 
      Exit(TValue.CreateNum(Helper_GetUTF8Length(ObjValV.StrVal))) 
    else begin
      // [PERBAIKAN]: Verifikasi Assigned untuk errMSG (Mencegah Crash pada Thread Idle/Worker)
      if Assigned(errMSG) then
        errMSG.callerror(63, 'Helper_GetNativeProperty;'+MemberName, errMSG.xrow, errMSG.xcol);
      Exit(nil);
    end;
  end else
  if ObjValV.DataType = dtArray then 
  begin
    if MemberName = 'length' then 
    begin
      ObjValV.ArrayVal.FLock.Acquire;
      try
        Exit(TValue.CreateNum(ObjValV.ArrayVal.Count));
      finally
        ObjValV.ArrayVal.FLock.Release;
      end;
    end else 
    begin
      // [PERBAIKAN]: Proteksi eksekusi callerror
      if Assigned(errMSG) then
        errMSG.callerror(62, 'Helper_GetNativeProperty;'+MemberName, errMSG.xrow, errMSG.xcol);
      Exit(nil);
    end;
  end else 
  if ObjValV.DataType = dtDict then
  begin
    // ✅ FIX P1.5: GetValueClone — sudah aman untuk caller
    Result := ObjValV.DictVal.GetValueClone(MemberName);
    Exit;
  end else
  if (ObjValV.DataType = dtObject) and Assigned(ObjValV.ObjVal) then 
  begin
    if ObjValV.ObjVal.Members.HasVar(MemberName) then
      Exit(ObjValV.ObjVal.Members.GetVar(MemberName))
    else begin
      IdxMethod := ObjValV.ObjVal.Definition.Methods.IndexOf(MemberName);
      if IdxMethod <> -1 then
        Exit(TValue.CreateFunc(ObjValV.ObjVal.Definition.Methods.Data[IdxMethod], nil, ObjValV))
      else if Assigned(errMSG) then
        errMSG.callerror(8, 'Helper_GetNativeProperty;' + MemberName, errMSG.xrow, errMSG.xcol);
    end;
  end;
  
  if Assigned(errMSG) then
    errMSG.callerror(8, 'Helper_GetNativeProperty;' + MemberName, errMSG.xrow, errMSG.xcol);
  Result := nil;
end;

function LoadScriptFromFile(const FileName: string): string;
var
  FStream: TFileStream;
begin
  Result := '';
  
  // <-- PERBAIKAN LOGIKA: Hapus FileExists (TOCTOU) dan gunakan try..except 
  // untuk menahan Fatal OS Exception saat file dikunci (sharing violation) atau hilang
  try
    FStream := TFileStream.Create(FileName, fmOpenRead or fmShareDenyNone);
  except
    if Assigned(errMSG) then 
      errMSG.callerror(36, 'LoadScriptFromFile: Gagal membuka (akses ditolak/hilang) ' + FileName, errMSG.xrow, errMSG.xcol); 
    Exit; 
  end;

  try
    if FStream.Size > strMax then
      raise EScriptFatalError.Create('Security Halt: Ukuran file skrip (' + IntToStr(FStream.Size) + ' bytes) melampaui kapasitas maksimum memori (' + IntToStr(strMax) + ' bytes).');

    SetLength(Result, FStream.Size);
    if FStream.Size > 0 then
      FStream.ReadBuffer(Result[1], FStream.Size);
  finally
    FStream.Free; 
  end;
end;

procedure WriteBinaryString(S: TStream; const Str: string);
var 
  Len: Integer;
begin
  Len := Length(Str);
  S.WriteBuffer(Len, SizeOf(Integer)); // Tulis panjang karakter
  if Len > 0 then 
    S.WriteBuffer(Str[1], Len);        // Tulis byte karakter
end;

function ReadBinaryString(S: TStream): string;
var 
  Len: Integer;
  MaxSafeLen: Int64;
  MaxAllowed: Int64;
begin
  S.ReadBuffer(Len, SizeOf(Integer));
  
  MaxSafeLen := S.Size - S.Position;
  MaxAllowed := strMax; // <-- PERBAIKAN: Menggunakan konstanta global, bukan Hardcode (1048576)
  
  if (Len < 0) or (Len > MaxSafeLen) or (Len > MaxAllowed) then
  begin
    if Assigned(errMSG) then
      errMSG.callerror(47, 'ReadBinaryString (String OOM/Korupsi Terdeteksi)', errMSG.xrow, errMSG.xcol)
    else
      raise EScriptFatalError.Create('ReadBinaryString: String OOM/Korupsi Terdeteksi (Fatal/Halted)'); 
  end;

  SetLength(Result, Len);
  if Len > 0 then 
    S.ReadBuffer(Result[1], Len);
end;

function TValueToString(V: TValue; IsInsideCollection: Boolean = False; Visited: TList = nil): string;
var
  i: Integer;
  OwnsList, AddedToVisited: Boolean;
  TempKeys: TStringArray; 
  TempVal: TValue;
  TrackPtr: Pointer;
begin
  if not Assigned(V) then Exit('null');

  OwnsList := False;
  AddedToVisited := False;
  
  if Visited = nil then
  begin
    Visited := TList.Create;
    OwnsList := True;
  end;

  TrackPtr := nil; 

  try
    case V.DataType of
      dtArray:  TrackPtr := Pointer(V.ArrayVal);
      dtDict:   TrackPtr := Pointer(V.DictVal);
      dtObject: TrackPtr := Pointer(V.ObjVal);
    end;

    if Assigned(TrackPtr) then
    begin
      if Visited.IndexOf(TrackPtr) <> -1 then Exit('[Circular Reference]');
      
      Visited.Add(TrackPtr);
      AddedToVisited := True;
    end;

    case V.DataType of
      dtNumeric:
        begin
          if (Frac(V.NumVal) = 0) and 
             (V.NumVal >= -9007199254740991.0) and 
             (V.NumVal <= 9007199254740991.0) then 
            Result := IntToStr(Trunc(V.NumVal))
          else 
            Result := FloatToStr(V.NumVal, FS);
        end;
      dtString:
        if IsInsideCollection then Result := '"' + V.StrVal + '"'
        else Result := V.StrVal;
      dtBoolean:
        if V.BoolVal then Result := 'true' else Result := 'false';
      dtNull:
        Result := 'null';
      dtArray:
        begin
          if not Assigned(V.ArrayVal) then Exit('[]'); 
          
          V.ArrayVal.FLock.Acquire;
          try
            Result := '[';
            for i := 0 to V.ArrayVal.Count - 1 do
            begin
              Result := Result + TValueToString(V.ArrayVal[i], True, Visited);
              if i < V.ArrayVal.Count - 1 then Result := Result + ', ';
            end;
            Result := Result + ']';
          finally
            V.ArrayVal.FLock.Release;
          end;
        end;
      dtDict:
        begin
          if not Assigned(V.DictVal) then Exit('{}');
          
          V.DictVal.FLock.Acquire; 
          try
            Result := '{';
            TempKeys := V.DictVal.GetKeys;
            for i := 0 to High(TempKeys) do
            begin
              // ✅ FIX P1.5: GetValueClone — aman
              TempVal := V.DictVal.GetValueClone(TempKeys[i]);
              try
                Result := Result + '"' + TempKeys[i] + '": ' + TValueToString(TempVal, True, Visited);
              finally
                TempVal.Free;   // ✅ Bebaskan clone
              end;
              if i < High(TempKeys) then Result := Result + ', ';
            end;
            Result := Result + '}';
          finally
            V.DictVal.FLock.Release; 
          end;
        end;
      dtObject:    Result := '[Object Instance]';
      dtFunction:  Result := '[Function]';
      dtNative:    Result := '[Native Function]';
      dtClassDef:  Result := '[Class Definition]';
      else         Result := '[Unknown]';
    end;
  finally
    if AddedToVisited and (not OwnsList) and Assigned(TrackPtr) then 
    begin
      Visited.Remove(TrackPtr); 
    end;
      
    if OwnsList then Visited.Free;
  end;
end;

function Helper_StringMultiply(const BaseStr: string; RepeatCount: Integer): TValue;
var
  i, BaseLen: Integer;
  TotalLen: Int64; 
  FinalStr: string;
begin
  if RepeatCount <= 0 then Exit(TValue.CreateStr(''));
  
  BaseLen := Length(BaseStr);
  if BaseLen = 0 then Exit(TValue.CreateStr(''));

  TotalLen := Int64(BaseLen) * Int64(RepeatCount);

  if TotalLen > strMax then
  begin
    if Assigned(errMSG) then
      errMSG.callerror(40,'Helper_StringMultiply', errMSG.xrow, errMSG.xcol); 
    Exit(TValue.CreateStr('')); 
  end;

  SetLength(FinalStr, SizeInt(TotalLen));

  for i := 0 to RepeatCount - 1 do
  begin
    Move(BaseStr[1], FinalStr[(i * BaseLen) + 1], BaseLen);
  end;
  
  Result := TValue.CreateStr(FinalStr);
end;

// HELPER OPTIMASI: Konsolidasi Penggabungan String
function Helper_MergeStrings(a, b: TValue): TValue;
var
  StrA, StrB, FinalStr: string;
  LenA, LenB: Integer;
  TotalLen: Int64; 
begin
  if a.DataType = dtString then StrA := a.StrVal else StrA := TValueToString(a, False);
  if b.DataType = dtString then StrB := b.StrVal else StrB := TValueToString(b, False);

  LenA := Length(StrA);
  LenB := Length(StrB);
  
  TotalLen := Int64(LenA) + Int64(LenB);

  if TotalLen > strMax then
  begin
    if Assigned(errMSG) then // <-- PERBAIKAN: Mencegah AV
      errMSG.callerror(40, 'Helper_MergeStrings: Memory Exceeded', errMSG.xrow, errMSG.xcol); // <-- PERBAIKAN: Konsistensi pengetikan errMSG
    Exit(TValue.CreateStr('')); 
  end;

  if TotalLen = 0 then Exit(TValue.CreateStr(''));
  SetLength(FinalStr, SizeInt(TotalLen));

  if LenA > 0 then Move(StrA[1], FinalStr[1], LenA);
  if LenB > 0 then Move(StrB[1], FinalStr[LenA + 1], LenB);
  
  Result := TValue.CreateStr(FinalStr);
end;

// HELPER OPTIMASI: Konsolidasi Penggabungan Array
function Helper_MergeArrays(a, b: TValue): TValue;
var
  i, TotalCount: Integer;
  NewArr: TValueList;
  Lock1, Lock2: TCriticalSection;
begin
  TotalCount := a.ArrayVal.Count + b.ArrayVal.Count;
  if TotalCount > arrMax then
  begin
    if Assigned(errMSG) then
      errMSG.callerror(56, 'Helper_MergeArrays', errMSG.xrow, errMSG.xcol); 
    Exit(TValue.CreateArray(TValueList.Create(True))); 
  end;
  
  if PtrUInt(a.ArrayVal) < PtrUInt(b.ArrayVal) then
  begin
    Lock1 := a.ArrayVal.FLock;
    Lock2 := b.ArrayVal.FLock;
  end else 
  if PtrUInt(a.ArrayVal) > PtrUInt(b.ArrayVal) then
  begin
    Lock1 := b.ArrayVal.FLock;
    Lock2 := a.ArrayVal.FLock;
  end else
  begin
    Lock1 := a.ArrayVal.FLock;
    Lock2 := nil; 
  end;

  Lock1.Acquire;
  try
    if Assigned(Lock2) then Lock2.Acquire;
    try
      NewArr := TValueList.Create(True);
      try
        NewArr.Capacity := TotalCount;
        
        // Loop untuk Array A
        for i := 0 to a.ArrayVal.Count - 1 do 
          if Assigned(a.ArrayVal[i]) then NewArr.Add(a.ArrayVal[i].Clone)
          else NewArr.Add(TValue.CreateNull);
          
        // Loop untuk Array B (Akan memproses array A lagi secara otomatis jika IsSelfMerge)
        for i := 0 to b.ArrayVal.Count - 1 do 
          if Assigned(b.ArrayVal[i]) then NewArr.Add(b.ArrayVal[i].Clone)
          else NewArr.Add(TValue.CreateNull);
        
        Result := TValue.CreateArray(NewArr);
      except
        NewArr.Free;
        raise;
      end;
    finally
      if Assigned(Lock2) then Lock2.Release; 
    end;
  finally
    Lock1.Release;
  end;
end;

procedure SetGCIndex(Obj: TObject; Idx: Integer); inline;
begin
  // Hindari 'is' sebisa mungkin dengan asersi arsitektur yang sudah diatur ketat
  if Assigned(Obj) then TGCManagedObject(Obj).FGCIndex := Idx;
end;

function GetGCIndex(Obj: TObject): Integer; inline;
begin
  if Assigned(Obj) then Result := TGCManagedObject(Obj).FGCIndex
  else Result := -1;
end;

procedure RegisterGC(Obj: TObject);
var
  Ctx: TEngineContext;
  UseCtx: Boolean;
begin
  if not (Obj is TGCManagedObject) then Exit; 

  TGCManagedObject(Obj).FGCGeneration := 0;
  TGCManagedObject(Obj).FAge := 0;
  
  // ✨ FIX: Probe context dengan try..except
  Ctx := GCurrentContext;
  UseCtx := False;
  
  if Assigned(Ctx) then
  begin
    UseCtx := Assigned(Ctx) and 
             (Ctx.FEngineMagic = ENGINE_MAGIC_CONST) and 
             Assigned(Ctx.MemLock);

  end;
  
  if UseCtx then
  begin
    if InterlockedCompareExchange(Ctx.IsGCRunning, 0, 0) = 1 then
      TGCManagedObject(Obj).FGCState := gcBlack
    else
      TGCManagedObject(Obj).FGCState := gcWhite;
    
    Ctx.MemLock.Acquire;
    try
      SetGCIndex(Obj, Ctx.Gen0Objects.Count);
      Ctx.Gen0Objects.Add(Obj);
    finally
      Ctx.MemLock.Release;
    end;
  end
  else
  begin
    // Fallback: global (single-instance mode)
    if InterlockedCompareExchange(IsGCRunning, 0, 0) = 1 then
      TGCManagedObject(Obj).FGCState := gcBlack
    else
      TGCManagedObject(Obj).FGCState := gcWhite;

    if not Assigned(MemLock) then Exit;
    
    MemLock.Acquire;
    try
      if Gen0Objects = nil then Gen0Objects := TList.Create;
      SetGCIndex(Obj, Gen0Objects.Count);
      Gen0Objects.Add(Obj);
    finally
      MemLock.Release;
    end;
  end;
end;

procedure UnregisterGC(Obj: TObject);
var 
  idx: Integer;
  IsZombieObj: Boolean;
  Gen: Byte;
  Ctx: TEngineContext;
  UseCtx: Boolean;

  procedure FastSwapAndPop(List: TList; TargetIndex: Integer);
  var LastObj: TObject;
  begin
    if Assigned(List) and (TargetIndex < List.Count) and (TObject(List[TargetIndex]) = Obj) then 
    begin
      LastObj := TObject(List[List.Count - 1]);
      List[TargetIndex] := Pointer(LastObj); 
      SetGCIndex(LastObj, TargetIndex); 
      List.Delete(List.Count - 1);
      SetGCIndex(Obj, -1);
    end;
  end;
  
begin
  // ✅ S-1: gunakan context-local teardown flag, bukan global IsShuttingDown.
  // Global flag di-set sebelum teardown selesai → list kotor → AV.
  // Context flag di-set HANYA di TEngineContext.Destroy (setelah semua
  // UnregisterGC dari Free() selesai).
  if not (Obj is TGCManagedObject) then Exit; 
  
  // Cek flag teardown via context (bila context valid)
  Ctx := GCurrentContext;
  if Assigned(Ctx) and (Ctx.FEngineMagic = ENGINE_MAGIC_CONST)
     and Ctx.FIsTearingDown then
    Exit;  
  
  IsZombieObj := (TGCManagedObject(Obj).FGCState = gcZombie); 
  Gen := TGCManagedObject(Obj).FGCGeneration;

  idx := GetGCIndex(Obj);
  if idx < 0 then Exit;
  
  // ✨ FIX: Probe context
  Ctx := GCurrentContext;
  UseCtx := False;
  
  if Assigned(Ctx) then
  begin
    UseCtx := Assigned(Ctx) and 
             (Ctx.FEngineMagic = ENGINE_MAGIC_CONST) and 
             Assigned(Ctx.MemLock);
  end;

  if not IsZombieObj then
  begin
    if UseCtx then
    begin
      Ctx.MemLock.Acquire;
      try
        if Gen = 0 then FastSwapAndPop(Ctx.Gen0Objects, idx)
        else FastSwapAndPop(Ctx.Gen1Objects, idx);
      finally
        Ctx.MemLock.Release;
      end;
    end else if Assigned(MemLock) then
    begin
      MemLock.Acquire;
      try
        if Gen = 0 then FastSwapAndPop(Gen0Objects, idx)
        else FastSwapAndPop(Gen1Objects, idx);
      finally
        MemLock.Release;
      end;
    end;
  end else
  begin
    if UseCtx and Assigned(Ctx.ZombieLock) then
    begin
      Ctx.ZombieLock.Acquire;
      try
        FastSwapAndPop(Ctx.ZombieQueue, idx);
      finally
        Ctx.ZombieLock.Release;
      end;
    end else if Assigned(ZombieLock) then
    begin
      ZombieLock.Acquire;
      try
        FastSwapAndPop(ZombieQueue, idx);
      finally
        ZombieLock.Release;
      end;
    end;
  end;
end;

procedure RunGarbageCollection(CurrentScope: TSymbolTable; IsMajorCollection: Boolean = False);
var
  i, WriteIdx: Integer;
  Obj: TObject;
  TempZombies, SafeEventTasks: TList;
  Task: PEventTask;
  Ctx: TEngineContext;

  procedure SweepList(List: TList; var WriteIdx: Integer; Gen: Byte);
  var k: Integer;
      O: TObject;
  begin
    WriteIdx := 0;
    for k := 0 to List.Count - 1 do
    begin
      O := TObject(List[k]);
      if TGCManagedObject(O).FGCState = gcWhite then
      begin
        TGCManagedObject(O).FGCState := gcZombie;
        TempZombies.Add(O);
      end else
      begin
        if (Gen = 0) and (TGCManagedObject(O).FAge >= 3) then
        begin
          TGCManagedObject(O).FGCGeneration := 1;
          SetGCIndex(O, Ctx.Gen1Objects.Count);
          Ctx.Gen1Objects.Add(O);
        end else
        begin
          if Gen = 0 then Inc(TGCManagedObject(O).FAge);
          List[WriteIdx] := O;
          SetGCIndex(O, WriteIdx);
          Inc(WriteIdx);
        end;
      end;
    end;
    List.Count := WriteIdx;
  end;

  procedure MarkList(List: TList);
  var k: Integer;
  begin
    for k := 0 to List.Count - 1 do
      if Assigned(List[k]) then
        TGCManagedObject(List[k]).FGCState := gcWhite;
  end;

begin
  if (InterlockedCompareExchange(IsShuttingDown, 0, 0) = 1) and (not Assigned(CurrentScope)) then Exit;
  if InterlockedExchange(IsGCRunning, 1) = 1 then Exit;

  GCLock.Acquire;
  try
    TempZombies := TList.Create;
    SafeEventTasks := TList.Create;

    // Snapshot event-loop roots
    if Assigned(GlobalEventLoop) then
    begin
      GlobalEventLoop.FLock.Acquire;
      try
        for i := 0 to GlobalEventLoop.FTasks.Count - 1 do
        begin
          Task := PEventTask(GlobalEventLoop.FTasks[i]);
          if Assigned(Task) and Task^.IsActive then
          begin
            if Assigned(Task^.CallbackFunc) then SafeEventTasks.Add(Pointer(Task^.CallbackFunc));
            if Assigned(Task^.Payloads) then
              for WriteIdx := 0 to Task^.Payloads.Count - 1 do
                if Assigned(Task^.Payloads[WriteIdx]) then
                  SafeEventTasks.Add(Pointer(Task^.Payloads[WriteIdx]));
          end;
        end;
      finally
        GlobalEventLoop.FLock.Release;
      end;
    end;

    // Pilih context: pakai GCurrentContext bila valid, fallback ke global list
    Ctx := GCurrentContext;
    if not Assigned(Ctx) or (Ctx.FEngineMagic <> ENGINE_MAGIC_CONST) then
      Ctx := nil;

    if Assigned(Ctx) and Assigned(Ctx.Gen0Objects) then
    begin
      // ============ Per-engine GC ============
      Ctx.MemLock.Acquire;
      try
        // 1. Reset state semua objek
        for i := 0 to Ctx.Gen0Objects.Count - 1 do
          if Assigned(Ctx.Gen0Objects[i]) then
            TGCManagedObject(Ctx.Gen0Objects[i]).FGCState := gcWhite;
        for i := 0 to Ctx.Gen1Objects.Count - 1 do
          if Assigned(Ctx.Gen1Objects[i]) then
            TGCManagedObject(Ctx.Gen1Objects[i]).FGCState := gcWhite;
      
        // 2. Mark Gen1 sebagai root (minor) atau skip (major)
        if not IsMajorCollection then
          for i := 0 to Ctx.Gen1Objects.Count - 1 do
            if Assigned(Ctx.Gen1Objects[i]) then
              TGCManagedObject(Ctx.Gen1Objects[i]).Mark;
      
        // 3. Mark external roots
        GCRootLock.Acquire;
        try
          if Assigned(ActiveVMs) then
            for i := 0 to ActiveVMs.Count - 1 do
              if Assigned(ActiveVMs[i]) then TVM(ActiveVMs[i]).MarkStack;
        finally
          GCRootLock.Release;
        end;
      
        if Assigned(CurrentScope) then CurrentScope.Mark;
        if Assigned(GlobalEventEmitter) then GlobalEventEmitter.Mark;
        if Assigned(GlobalModuleManager) then GlobalModuleManager.MarkCacheRoots;
        
        MarkWSServers;
        
        // ⚠️ Snapshot event tasks SEBELUM memegang lock yang panjang
        for i := 0 to SafeEventTasks.Count - 1 do
          if SafeEventTasks[i] <> nil then TValue(SafeEventTasks[i]).Mark;
      
        // 4. Sweep — masih dalam MemLock
        if IsMajorCollection then
        begin
          WriteIdx := 0;
          for i := 0 to Ctx.Gen1Objects.Count - 1 do
          begin
            Obj := TObject(Ctx.Gen1Objects[i]);
            if TGCManagedObject(Obj).FGCState = gcWhite then
            begin
              TGCManagedObject(Obj).FGCState := gcZombie;
              TempZombies.Add(Obj);
            end else begin
              Ctx.Gen1Objects[WriteIdx] := Obj;
              SetGCIndex(Obj, WriteIdx);
              Inc(WriteIdx);
            end;
          end;
          Ctx.Gen1Objects.Count := WriteIdx;
        end;
      
        WriteIdx := 0;
        for i := 0 to Ctx.Gen0Objects.Count - 1 do
        begin
          Obj := TObject(Ctx.Gen0Objects[i]);
          if TGCManagedObject(Obj).FGCState = gcWhite then
          begin
            TGCManagedObject(Obj).FGCState := gcZombie;
            TempZombies.Add(Obj);
          end else begin
            if TGCManagedObject(Obj).FAge >= 3 then
            begin
              TGCManagedObject(Obj).FGCGeneration := 1;
              SetGCIndex(Obj, Ctx.Gen1Objects.Count);
              Ctx.Gen1Objects.Add(Obj);
            end else begin
              Inc(TGCManagedObject(Obj).FAge);
              Ctx.Gen0Objects[WriteIdx] := Obj;
              SetGCIndex(Obj, WriteIdx);
              Inc(WriteIdx);
            end;
          end;
        end;
        Ctx.Gen0Objects.Count := WriteIdx;
      finally
        Ctx.MemLock.Release;
      end;
    end
    else
    begin
      // ============ Global GC (fallback single-instance) ============
      if Assigned(MemLock) then
        MemLock.Acquire;
      try
        if Assigned(Gen0Objects) then
        begin
          MarkList(Gen0Objects);
          if Assigned(Gen1Objects) then MarkList(Gen1Objects);

          if not IsMajorCollection and Assigned(Gen1Objects) then
            for i := 0 to Gen1Objects.Count - 1 do
              if Assigned(Gen1Objects[i]) then
                TGCManagedObject(Gen1Objects[i]).Mark;

          GCRootLock.Acquire;
          try
            if Assigned(ActiveVMs) then
              for i := 0 to ActiveVMs.Count - 1 do
                if Assigned(ActiveVMs[i]) then TVM(ActiveVMs[i]).MarkStack;
          finally
            GCRootLock.Release;
          end;

          if Assigned(CurrentScope) then CurrentScope.Mark;
          if Assigned(GlobalEventEmitter) then GlobalEventEmitter.Mark;
          if Assigned(GlobalModuleManager) then GlobalModuleManager.MarkCacheRoots;
          
          MarkWSServers;
          
          for i := 0 to SafeEventTasks.Count - 1 do
            if SafeEventTasks[i] <> nil then TValue(SafeEventTasks[i]).Mark;

          if IsMajorCollection and Assigned(Gen1Objects) then
            SweepList(Gen1Objects, WriteIdx, 1);
          SweepList(Gen0Objects, WriteIdx, 0);
        end;
      finally
        if Assigned(MemLock) then MemLock.Release;
      end;
    end;

    // Pindahkan zombie
    if TempZombies.Count > 0 then
    begin
      ZombieLock.Acquire;
      try
        if Assigned(ZombieQueue) then
          for i := 0 to TempZombies.Count - 1 do
          begin
            Obj := TObject(TempZombies[i]);
            SetGCIndex(Obj, ZombieQueue.Count);
            ZombieQueue.Add(Obj);
          end;
      finally
        ZombieLock.Release;
      end;
    end;

  finally
    TempZombies.Free;
    SafeEventTasks.Free;
    InterlockedExchange(IsGCRunning, 0);
    GCLock.Release;
  end;
end;

// --- HELPER NATIVE VM MURNI UNTUK COMPOUND ASSIGNMENT ---
function VM_CompoundOp(const OpAssign: string; CurrVal, NewVal: TValue): TValue;
begin
  // 1. Logika String
  if (OpAssign = '+') and ((CurrVal.DataType = dtString) or (NewVal.DataType = dtString)) then
    Exit(Helper_MergeStrings(CurrVal, NewVal));

  // 2. Logika Pengulangan String
  if (OpAssign = '*') and (CurrVal.DataType = dtString) and (NewVal.DataType = dtNumeric) then
    Exit(Helper_StringMultiply(CurrVal.StrVal, Trunc(NewVal.NumVal)));

  // 3. Logika Array [: Gunakan helper yang sudah Anda buat!]
  if (OpAssign = '+') and (CurrVal.DataType = dtArray) and (NewVal.DataType = dtArray) then
    Exit(Helper_MergeArrays(CurrVal, NewVal));

  // 4. Logika Numerik Murni
  if (CurrVal.DataType = dtNumeric) and (NewVal.DataType = dtNumeric) then
    Exit(TValue.CreateNum(SafeNumericMath(OpAssign, CurrVal.NumVal, NewVal.NumVal)));
  
  if Assigned(errMSG) then
    errMSG.callerror(87,'VM_CompoundOp', errMSG.xrow, errMSG.xcol); 
  Result := nil;
end;

