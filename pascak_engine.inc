function BuildStringArray(Args: TObjectList): TStringArray;
var
  i: Integer;
begin
  Result := nil;
  SetLength(Result, Args.Count);
  for i := 0 to Args.Count - 1 do
    Result[i] := TValueToString(TValue(Args[i]), False);
end;

procedure ProcessPrintIO(Args: TObjectList; AutoNewLine: Boolean);
var
  i: Integer;
  StrArray: TStringArray;
begin
  if Args.Count = 0 then
  begin
    if AutoNewLine then 
    begin IOLock.Acquire; try Writeln; finally IOLock.Release; end; end;
    Exit;
  end;

  StrArray := BuildStringArray(Args);
  IOLock.Acquire; 
  try
    for i := 0 to High(StrArray) do
      if StrArray[i] <> '' then Write(StrArray[i]);
    if AutoNewLine then Writeln;    
  finally
    IOLock.Release;
  end;
end;

function Native_Print(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  ProcessPrintIO(Args, False);
  Result := TValue.CreateNull;
end;

function Native_Println(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  ProcessPrintIO(Args, True);
  Result := TValue.CreateNull;
end;

