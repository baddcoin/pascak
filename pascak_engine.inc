function Terror.GetPreciseSnippet(const ScriptText: string; ALine, ACol: Integer): string;
var
  Lines: TStringArray;
  TargetLine, PointerLine, NormalizedText: string;
  i: Integer;
begin
  if ScriptText = '' then Exit('  [Source tidak tersedia]');
  
  NormalizedText := StringReplace(ScriptText, #13#10, #10, [rfReplaceAll]);
  NormalizedText := StringReplace(NormalizedText, #13, #10, [rfReplaceAll]);
  Lines := NormalizedText.Split([#10]);
  
  if (ALine > 0) and (ALine <= Length(Lines)) then
  begin
    TargetLine := Lines[ALine - 1];
    
    // PERBAIKAN: Buat penunjuk tepat di kolom identifier
    PointerLine := '';
    for i := 1 to ACol - 1 do
    begin
      if i <= Length(TargetLine) then
      begin
        if TargetLine[i] = #9 then
          PointerLine := PointerLine + #9
        else
          PointerLine := PointerLine + ' ';
      end
      else
        PointerLine := PointerLine + ' ';
    end;
    PointerLine := PointerLine + '^--- [DI SINI]';
    
    Result := '  ' + TargetLine + #10 + '  ' + PointerLine;
  end else
    Result := '  [Baris tidak ditemukan di source code]';
end;

procedure Terror.callERROR(idMSG: integer; objErr: string;
  ALine: Integer = -1; ACol: Integer = -1);
var 
  msgERR, Snippet, Banner: string;
  PrintLine, PrintCol: Integer;
  E: EScriptRuntimeError;
begin
  if not Assigned(Self) then
    raise EScriptFatalError.Create('errMSG nil di callERROR: ' + objErr);

  if ALine > 0 then PrintLine := ALine else PrintLine := Self.xrow;
  if ACol > 0 then PrintCol := ACol else PrintCol := Self.xcol;

  if (idMSG >= 1) and (idMSG <= 160) then msgERR := SysErrorMsgs(idMSG) else msgERR := 'tidak dikenal';
  Snippet := GetPreciseSnippet(Script, PrintLine, PrintCol);

  // ✅ C-4b: bangun banner sebagai string, JANGAN print.
  // Top-level handler (TVM.Run / runScript) yang akan print banner ini
  // HANYA jika exception tidak tertangkap oleh script.
  Banner := #10 +
            '=== PASCAL SCRIPT FATAL ERROR ===' + #10 +
            'Baris : ' + IntToStr(PrintLine) + ' | Kolom: ' + IntToStr(PrintCol) + #10 +
            'Lokasi: ' + objErr + #10 +
            'Error : ' + msgerr + #10 +
            Snippet;

  if Assigned(ActiveCompiler) then
    Banner := Banner + #10 + ActiveCompiler.GenerateCompileTrace();

  Banner := Banner + #10 + '=================================';

  if objErr <> '' then
    E := EScriptRuntimeError.Create('Interpreter Halted: ' + objErr)
  else
    E := EScriptRuntimeError.Create('Interpreter Halted: ' + msgerr);
  
  E.FormattedBanner := Banner;
  raise E;
end;

