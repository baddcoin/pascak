function Native_FileRead(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SafePath, ResStr: string;
  FS: TFileStream;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then 
    raise EScriptRuntimeError.Create('fileRead(path) membutuhkan tepat 1 argumen string');
  
  SafePath := GetSafeSandboxedPath(TValue(Args[0]).StrVal);
  if not SysUtils.FileExists(SafePath) then Exit(TValue.CreateNull);

  try
    FS := TFileStream.Create(SafePath, fmOpenRead or fmShareDenyNone);
    try
      // PROTEKSI MEMORI MUTLAK
      if FS.Size > strMax then
        raise EScriptRuntimeError.Create('IO Error: Ukuran file (' + IntToStr(FS.Size) + ' bytes) melampaui batas maksimal string (' + IntToStr(strMax) + ' bytes)!');

      SetLength(ResStr, FS.Size);
      if FS.Size > 0 then FS.ReadBuffer(ResStr[1], FS.Size);
      Result := TValue.CreateStr(ResStr);
    finally
      FS.Free;
    end;
  except
    on E: EScriptRuntimeError do raise; // <-- PERBAIKAN: Mencegah double-wrapping 
    on E: Exception do raise EScriptRuntimeError.Create('IO Error saat membaca file: ' + E.Message);
  end;
end;

function Native_FileWrite(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SafePath, ContentStr: string;
  FS: TFileStream;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtString) then 
    raise EScriptRuntimeError.Create('fileWrite(path, content) membutuhkan tepat 2 argumen');
  
  SafePath := GetSafeSandboxedPath(TValue(Args[0]).StrVal);
  ContentStr := TValueToString(TValue(Args[1]), False);

  try
    FS := TFileStream.Create(SafePath, fmCreate or fmShareDenyWrite);
    try
      if ContentStr <> '' then 
        FS.WriteBuffer(ContentStr[1], Length(ContentStr));
      Result := TValue.CreateBool(True);
    finally
      FS.Free;
    end;
  except
    on E: EScriptRuntimeError do raise; // <-- PERBAIKAN
    on E: Exception do raise EScriptRuntimeError.Create('IO Error saat menulis file: ' + E.Message);
  end;
end;

function Native_FileAppend(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SafePath, Content: string;
  FS: TFileStream;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtString) then 
    raise EScriptRuntimeError.Create('fileAppend(path, content) membutuhkan tepat 2 argumen');
  
  SafePath := GetSafeSandboxedPath(TValue(Args[0]).StrVal);
  Content := TValueToString(TValue(Args[1]), False);

  try
    try
      FS := TFileStream.Create(SafePath, fmOpenReadWrite or fmShareDenyWrite);
      FS.Position := FS.Size;
    except
      FS := TFileStream.Create(SafePath, fmCreate or fmShareDenyWrite);
    end;

    try
      if Content <> '' then FS.WriteBuffer(Content[1], Length(Content));
    finally
      FS.Free;
    end;
    Result := TValue.CreateBool(True);
  except
    on E: EScriptRuntimeError do raise; // <-- PERBAIKAN
    on E: Exception do raise EScriptRuntimeError.Create('IO Error saat append file: ' + E.Message);
  end;
end;

