function LspArrayContains(const Arr: array of string; const S: string): Boolean;
var
  I: Integer;
begin
  for I := 0 to High(Arr) do
    if Arr[I] = S then Exit(True);
  Result := False;
end;

procedure TLspServer.HandleCompletion(ReqId: TJSONData; Params: TJSONObject);
var
  Doc, PosObj, Result, Arr: TJSONObject;
  ItemsArr: TJSONArray;
  ItemObj: TJSONObject;
  DocURI: string;
  LineVal, CharVal, I: Integer;
  Prefix, Kind: string;
  Lex: TLexer;
  Pars: TParser;
  Root: TBlockNode;
begin
  if not Assigned(Params) then
  begin
    SendResponse(ReqId, nil);
    Exit;
  end;

  Doc := TJSONObject(Params.Find('textDocument'));
  PosObj := TJSONObject(Params.Find('position'));
  DocURI := FDocumentURI;
  if Assigned(Doc) then
    DocURI := Doc.Get('uri', DocURI);
  LineVal := 0; CharVal := 0;
  if Assigned(PosObj) then
  begin
    LineVal := PosObj.Get('line', 0);
    CharVal := PosObj.Get('character', 0);
  end;

  Prefix := LspExtractWordAtPos(FDocumentText, LineVal, CharVal);

  ItemsArr := TJSONArray.Create;
  try
    // 1. Keywords
    for I := 0 to High(LSP_KEYWORDS) do
    begin
      if (Prefix <> '') and
         (Copy(LSP_KEYWORDS[I], 1, Length(Prefix)) <> Prefix) then Continue;
      ItemObj := TJSONObject.Create;
      ItemObj.Add('label', LSP_KEYWORDS[I]);
      ItemObj.Add('kind', 14); // Keyword
      ItemsArr.Add(ItemObj);
    end;

    // 2. Modules
    for I := 0 to High(LSP_MODULES) do
    begin
      if (Prefix <> '') and
         (Copy(LSP_MODULES[I], 1, Length(Prefix)) <> Prefix) then Continue;
      ItemObj := TJSONObject.Create;
      ItemObj.Add('label', LSP_MODULES[I]);
      ItemObj.Add('kind', 9); // Module
      ItemsArr.Add(ItemObj);
    end;

    // 3. Builtin functions
    for I := 0 to High(LSP_BUILTINS) do
    begin
      if (Prefix <> '') and
         (Copy(LSP_BUILTINS[I], 1, Length(Prefix)) <> Prefix) then Continue;
      ItemObj := TJSONObject.Create;
      ItemObj.Add('label', LSP_BUILTINS[I]);
      ItemObj.Add('kind', 3); // Function
      ItemsArr.Add(ItemObj);
    end;

    // 4. Local vars from current AST
    try
      Lex := TLexer.Create(FDocumentText);
      Pars := TParser.Create(Lex);
      Root := nil;
      try
        try
          Root := Pars.ParseMainProgram;
          if Assigned(Root) then
          begin
            // iterate top-level statements (var decl, function, class)
            for I := 0 to TBlockNode(Root).Statements.Count - 1 do
            begin
              if TNode(TBlockNode(Root).Statements[I]) is TVarDeclNode then
              begin
                Kind := TVarDeclNode(TNode(TBlockNode(Root).Statements[I])).VarName;
                if (Prefix = '') or (Copy(Kind, 1, Length(Prefix)) = Prefix) then
                begin
                  ItemObj := TJSONObject.Create;
                  ItemObj.Add('label', Kind);
                  ItemObj.Add('kind', 6); // Variable
                  if TVarDeclNode(TNode(TBlockNode(Root).Statements[I])).IsConst then
                    ItemObj.Add('detail', 'const')
                  else
                    ItemObj.Add('detail', 'var');
                  ItemsArr.Add(ItemObj);
                end;
              end
              else if TNode(TBlockNode(Root).Statements[I]) is TFunctionNode then
              begin
                Kind := TFunctionNode(TNode(TBlockNode(Root).Statements[I])).Name;
                if (Kind = '') then Continue;
                if (Prefix <> '') and (Copy(Kind, 1, Length(Prefix)) <> Prefix) then Continue;
                ItemObj := TJSONObject.Create;
                ItemObj.Add('label', Kind);
                ItemObj.Add('kind', 3); // Function
                ItemObj.Add('detail', 'function');
                ItemsArr.Add(ItemObj);
              end
              else if TNode(TBlockNode(Root).Statements[I]) is TClassDeclNode then
              begin
                Kind := TClassDeclNode(TNode(TBlockNode(Root).Statements[I])).sClassName;
                if (Prefix <> '') and (Copy(Kind, 1, Length(Prefix)) <> Prefix) then Continue;
                ItemObj := TJSONObject.Create;
                ItemObj.Add('label', Kind);
                ItemObj.Add('kind', 7); // Class
                ItemObj.Add('detail', 'class');
                ItemsArr.Add(ItemObj);
              end;
            end;
          end;
        except
        end;
      finally
        if Assigned(Root) then Root.Free;
        if Assigned(Pars) then Pars.Free;
        if Assigned(Lex) then Lex.Free;
      end;
    except
    end;

    Result := TJSONObject.Create;
    try
      Result.Add('isIncomplete', False);
      Result.Add('items', ItemsArr);
      SendResponse(ReqId, Result);
    except
      Result.Free;
      raise;
    end;
  except
    ItemsArr.Free;
    raise;
  end;
end;


function LspFindDeclLocation(Block: TBlockNode; const Word: string;
  out DeclLine, DeclCol: Integer): Boolean;
var
  I: Integer;
  Stmt: TNode;
  Line, Col: Integer;
begin
  Result := False;
  DeclLine := 0;
  DeclCol := 0;
  if not Assigned(Block) then Exit;

  for I := 0 to Block.Statements.Count - 1 do
  begin
    Stmt := TNode(Block.Statements[I]);
    if Stmt is TVarDeclNode then
    begin
      if TVarDeclNode(Stmt).VarName = Word then
      begin
        Line := TVarDeclNode(Stmt).Line;
        Col := TVarDeclNode(Stmt).Col;
        if Line > 0 then Dec(Line);
        if Col > 0 then Dec(Col) else Col := 0;
        DeclLine := Line;
        DeclCol := Col;
        Exit(True);
      end;
    end
    else if Stmt is TFunctionNode then
    begin
      if TFunctionNode(Stmt).Name = Word then
      begin
        Line := TFunctionNode(Stmt).Line;
        Col := TFunctionNode(Stmt).Col;
        if Line > 0 then Dec(Line);
        if Col > 0 then Dec(Col) else Col := 0;
        DeclLine := Line;
        DeclCol := Col;
        Exit(True);
      end;
    end
    else if Stmt is TClassDeclNode then
    begin
      if TClassDeclNode(Stmt).sClassName = Word then
      begin
        Line := TClassDeclNode(Stmt).Line;
        Col := TClassDeclNode(Stmt).Col;
        if Line > 0 then Dec(Line);
        if Col > 0 then Dec(Col) else Col := 0;
        DeclLine := Line;
        DeclCol := Col;
        Exit(True);
      end;
    end
    else if Stmt is TBlockNode then
    begin
      if LspFindDeclLocation(TBlockNode(Stmt), Word, DeclLine, DeclCol) then
        Exit(True);
    end;
  end;
end;

procedure TLspServer.HandleDefinition(ReqId: TJSONData; Params: TJSONObject);
var
  Doc, PosObj, Result, RangeObj, StartPos, EndPos: TJSONObject;
  DocURI: string;
  LineVal, CharVal, DeclLine, DeclCol: Integer;
  Word: string;
  Lex: TLexer;
  Pars: TParser;
  Root: TBlockNode;
  Found: Boolean;
begin
  if not Assigned(Params) then
  begin
    SendResponse(ReqId, nil);
    Exit;
  end;

  Doc := TJSONObject(Params.Find('textDocument'));
  PosObj := TJSONObject(Params.Find('position'));
  DocURI := FDocumentURI;
  if Assigned(Doc) then
    DocURI := Doc.Get('uri', DocURI);
  LineVal := 0;
  CharVal := 0;
  if Assigned(PosObj) then
  begin
    LineVal := PosObj.Get('line', 0);
    CharVal := PosObj.Get('character', 0);
  end;

  Word := LspExtractWordAtPos(FDocumentText, LineVal, CharVal);
  if Word = '' then
  begin
    SendResponse(ReqId, nil);
    Exit;
  end;

  Found := False;
  DeclLine := 0;
  DeclCol := 0;
  Lex := nil; Pars := nil; Root := nil;
  try
    try
      Lex := TLexer.Create(FDocumentText);
      Pars := TParser.Create(Lex);
      Root := Pars.ParseMainProgram;
      if Assigned(Root) and (Root is TBlockNode) then
        Found := LspFindDeclLocation(TBlockNode(Root), Word, DeclLine, DeclCol);
    except
    end;
  finally
    if Assigned(Root) then Root.Free;
    if Assigned(Pars) then Pars.Free;
    if Assigned(Lex) then Lex.Free;
  end;

  if not Found then
  begin
    SendResponse(ReqId, nil);
    Exit;
  end;

  Result := TJSONObject.Create;
  try
    Result.Add('uri', DocURI);
    RangeObj := TJSONObject.Create;
    StartPos := TJSONObject.Create;
    StartPos.Add('line', DeclLine);
    StartPos.Add('character', DeclCol);
    EndPos := TJSONObject.Create;
    EndPos.Add('line', DeclLine);
    EndPos.Add('character', DeclCol + Length(Word));
    RangeObj.Add('start', StartPos);
    RangeObj.Add('end', EndPos);
    Result.Add('range', RangeObj);
    SendResponse(ReqId, Result);
  finally
    Result.Free;
  end;
end;


procedure TLspServer.RunDiagnostics;
var
  Lex: TLexer;
  Pars: TParser;
  Root: TBlockNode;
  Linter: TLinter;
  DiagsArr: TJSONArray;
  Params, D, RangeObj, StartPos, EndPos: TJSONObject;
  I: Integer;
  Line, Col, MsgStart: Integer;
  Code, Lvl, Msg, RawLine: string;
  ColonPos, SecondColonPos: Integer;
begin
  WriteLn(ErrOutput, '[lsp-diag] uri=', FDocumentURI, ' textlen=', Length(FDocumentText));
  Flush(ErrOutput);

  if FDocumentURI = '' then Exit;

  DiagsArr := TJSONArray.Create;
  Lex := nil; Pars := nil; Root := nil; Linter := nil;
  try
    try
      Lex := TLexer.Create(FDocumentText);
      Pars := TParser.Create(Lex);
      Root := Pars.ParseMainProgram;
      WriteLn(ErrOutput, '[lsp-diag] Root assigned=', Assigned(Root));
      Flush(ErrOutput);
      
      if not Assigned(Root) then
      begin
        WriteLn(ErrOutput, '[lsp-diag] Root nil');
        Flush(ErrOutput);
      end
      else
      begin
        Linter := TLinter.Create;
        try
          Linter.Lint(Root, FDocumentURI);
          WriteLn(ErrOutput, '[lsp-diag] FIssues.Count=', Linter.FIssues.Count);
          Flush(ErrOutput);
          
          for I := 0 to Linter.FIssues.Count - 1 do
          begin
            RawLine := Linter.FIssues[I];
            WriteLn(ErrOutput, '[lsp-diag] raw[', I, ']=', RawLine);
            Flush(ErrOutput);
            
            if Trim(RawLine) = '' then Continue;

            ColonPos := Pos(':', RawLine);
            if ColonPos <= 0 then Continue;
            SecondColonPos := PosEx(':', RawLine, ColonPos + 1);
            if SecondColonPos <= 0 then Continue;

            Code := Copy(RawLine, 1, ColonPos - 1);
            Line := StrToIntDef(Copy(RawLine, ColonPos + 1, SecondColonPos - ColonPos - 1), 1) - 1;

            MsgStart := SecondColonPos + 1;
            while (MsgStart <= Length(RawLine)) and (RawLine[MsgStart] in ['0'..'9']) do
              Inc(MsgStart);
            Col := StrToIntDef(Copy(RawLine, SecondColonPos + 1, MsgStart - SecondColonPos - 1), 1) - 1;

            if Pos('warning', RawLine) > 0 then Lvl := 'warning' else Lvl := 'error';
            Msg := Trim(Copy(RawLine, MsgStart, Length(RawLine)));
            // Strip leading "warning " / "error " prefix
            if Copy(Msg, 1, 8) = 'warning ' then
              Msg := Trim(Copy(Msg, 9, Length(Msg)))
            else if Copy(Msg, 1, 6) = 'error ' then
              Msg := Trim(Copy(Msg, 7, Length(Msg)));

            D := TJSONObject.Create;
            try
              RangeObj := TJSONObject.Create;
              StartPos := TJSONObject.Create;
              StartPos.Add('line', Line);
              StartPos.Add('character', Col);
              EndPos := TJSONObject.Create;
              EndPos.Add('line', Line);
              EndPos.Add('character', Col + 1);
              RangeObj.Add('start', StartPos);
              RangeObj.Add('end', EndPos);
              D.Add('range', RangeObj);
              if Lvl = 'error' then
                D.Add('severity', 1)
              else
                D.Add('severity', 2);
              D.Add('code', Code);
              D.Add('source', 'pascak');
              D.Add('message', Msg);
              DiagsArr.Add(D);
            except
              D.Free;
              raise;
            end;
          end;
        finally
          Linter.Free;
        end;
      end;
    except
      on E: Exception do
      begin
        WriteLn(ErrOutput, '[lsp-diag] EXCEPTION: ', E.ClassName, ': ', E.Message);
        Flush(ErrOutput);
      end;
    end;
  finally
    if Assigned(Root) then Root.Free;
    if Assigned(Pars) then Pars.Free;
    if Assigned(Lex) then Lex.Free;
  end;

  WriteLn(ErrOutput, '[lsp-diag] SendNotification diags=', DiagsArr.Count);
  Flush(ErrOutput);
  
  Params := TJSONObject.Create;
  try
    Params.Add('uri', FDocumentURI);
    Params.Add('diagnostics', DiagsArr);
    SendNotification('textDocument/publishDiagnostics', Params);
  finally
    Params.Free;
  end;
end;

procedure TLspServer.Run;
var
  Msg: TJSONObject;
  Method: string;
  ReqId: TJSONData;
  Params: TJSONData;
begin
  // Ensure global state initialized (errMSG, GC lists, locks)
  EnsureGlobalsInit;
  if not Assigned(errMSG) then
    errMSG := Terror.Create;

  while (not FExitRequested) and ReadMessage(Msg) do
  begin
    try
      Method := Msg.Get('method', '');
      ReqId := Msg.Find('id');
      Params := Msg.Find('params');
      if Params is TJSONObject then
        HandleRequest(Method, ReqId, TJSONObject(Params))
      else
        HandleRequest(Method, ReqId, nil);
    finally
      Msg.Free;
    end;
    if FShutdownRequested and FExitRequested then Break;
  end;
end;
