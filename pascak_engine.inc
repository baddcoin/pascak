function Native_ToInteger(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  V: TValue;
  fs: TFormatSettings;
  TempFloat: Double;
  SafeInt: Int64;
begin
  if Args.Count <> 1 then raise EScriptRuntimeError.Create('toInteger() membutuhkan tepat 1 argumen');
  V := TValue(Args[0]);
  
  fs := DefaultFormatSettings;
  fs.DecimalSeparator := '.';

  try
    if V.DataType = dtNumeric then 
    begin
      // Gunakan Trunc untuk menghasilkan true integer value
      SafeInt := Trunc(V.NumVal);
      Result := TValue.CreateNum(SafeInt);
    end
    else if V.DataType = dtString then 
    begin
      TempFloat := StrToFloatDef(V.StrVal, 0.0, fs);
      SafeInt := Trunc(TempFloat);
      Result := TValue.CreateNum(SafeInt);
    end
    else if V.DataType = dtBoolean then 
    begin
      if V.BoolVal then Result := TValue.CreateNum(1) else Result := TValue.CreateNum(0);
    end
    else 
      Result := TValue.CreateNum(0);
  except
    on E: EMathError do 
      Result := TValue.CreateNum(0); // Fallback aman jika terjadi Integer Overflow FPU
  end;
end;

