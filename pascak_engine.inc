procedure PushThreadError(const Msg: string);
begin
  if not Assigned(GThreadErrors) then Exit;
  GThreadErrorsLock.Acquire;
  try
    if GThreadErrors.Count < 10000 then
      GThreadErrors.Add(Msg);
  finally
    GThreadErrorsLock.Release;
  end;
end;

procedure InitThreadErrors;
begin
  if not Assigned(GThreadErrors) then
  begin
    GThreadErrors := TStringList.Create;
    GThreadErrorsLock := TCriticalSection.Create;
  end;
end;

procedure FreeThreadErrors;
begin
  if Assigned(GThreadErrors) then
  begin
    GThreadErrors.Free;
    GThreadErrors := nil;
  end;
  if Assigned(GThreadErrorsLock) then
  begin
    GThreadErrorsLock.Free;
    GThreadErrorsLock := nil;
  end;
end;

