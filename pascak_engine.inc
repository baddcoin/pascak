{ ====================================================================
  WORKER SYSTEM (SHARED-NOTHING ARCHITECTURE)
  ==================================================================== }
constructor TWorkerMessageQueue.Create;
begin
  FMessages := TStringList.Create;
  FLock := TCriticalSection.Create;
  FEvent := RTLEventCreate;
  FReadIndex := 0;
end;

destructor TWorkerMessageQueue.Destroy;
begin
  FLock.Free;
  FMessages.Free;
  RTLEventDestroy(FEvent);
  inherited;
end;

function TWorkerMessageQueue.StrictlySerializeJSON(const RawData: string): string;
var
  Parser: TJSONParser;
  JData: TJSONData;
begin
  try
    Parser := TJSONParser.Create(RawData, []);
    try
      JData := nil;
      try
        JData := Parser.Parse;
        if Assigned(JData) then
          Result := JData.AsJSON
        else
          Result := '{}';
      finally
        // PERBAIKAN LOGIKA: FPC TJSONParser.Parse memindahkan ownership ke caller jika berhasil,
        // pastikan hanya membebaskan jika JData benar-benar di-instansiasi
        if Assigned(JData) then JData.Free;
      end;
    finally
      Parser.Free;
    end;
  except
    on E: Exception do
    begin
      Result := '{"_worker_sys_error": "Strict Serialization Failed", "details": "' + StringReplace(E.Message, '"', '\"', [rfReplaceAll]) + '"}';
    end;
  end;
end;

procedure TWorkerMessageQueue.PushMessage(const MsgJSON: string);
var
  SafeJSON: string;
begin
  SafeJSON := StrictlySerializeJSON(MsgJSON);
  
  FLock.Acquire;
  try
    // PROTEKSI OOM: Tolak pesan jika antrean belum sempat dikonsumsi oleh Thread Utama
    if FMessages.Count >= antrianMSG then
      raise EScriptRuntimeError.Create('Worker Flood Protection: Antrean pesan melampaui batas (10.000). Host terlalu sibuk!');
      
    FMessages.Add(SafeJSON);
  finally
    FLock.Release;
  end;
  RTLEventSetEvent(FEvent); 
end;

function TWorkerMessageQueue.PopMessage(out MsgJSON: string): Boolean;
var
  i, ShiftCount: Integer;
begin
  Result := False;
  FLock.Acquire;
  try
    if FReadIndex < FMessages.Count then
    begin
      MsgJSON := FMessages[FReadIndex];
      
      // 1. OPTIMASI RAM: Kosongkan string di memori list segera setelah dibaca
      // Ini melepas memori tanpa harus menunggu compacting atau list di-clear.
      FMessages[FReadIndex] := ''; 
      Inc(FReadIndex);
      Result := True;
      
      // 2. OPTIMASI KECEPATAN: Jika seluruh antrean sudah terbaca, Clear sekaligus O(1)
      if FReadIndex >= FMessages.Count then
      begin
        FMessages.Clear;
        FReadIndex := 0;
        RTLEventResetEvent(FEvent);
      end
      // 3. COMPACTING DINAMIS: Hanya geser data JIKA antrean sangat panjang 
      // dan setengahnya sudah menjadi indeks kosong (mencegah memory bloat).
      else if (FReadIndex >= 1024) and (FReadIndex > (FMessages.Count div 2)) then
      begin
        ShiftCount := FMessages.Count - FReadIndex;
        
        // Geser nilai yang tersisa ke depan (in-place shift, super cepat)
        for i := 0 to ShiftCount - 1 do
        begin
          FMessages[i] := FMessages[FReadIndex + i];
        end;
        
        // Potong sisa indeks di belakang (delete dari belakang tidak menggeser memori, O(1))
        while FMessages.Count > ShiftCount do
        begin
          FMessages.Delete(FMessages.Count - 1);
        end;
          
        FReadIndex := 0;
      end;
    end else
    begin
      // Pengaman absolut jika kondisi indeks melampaui batas
      if FMessages.Count > 0 then FMessages.Clear;
      FReadIndex := 0;
      RTLEventResetEvent(FEvent); 
    end;
  finally
    FLock.Release;
  end;
end;

procedure TWorkerMessageQueue.WaitForMessage(TimeoutMs: Integer);
begin
  RTLEventWaitFor(FEvent, TimeoutMs);
end;

constructor TWorkerThread.Create(const AScriptSource: string; AContext: TEngineContext);
var
  GuidStr: TGUID;
begin
  inherited Create(True);
  FreeOnTerminate := True;
  
  FScriptSource := AScriptSource;
  FInbox := TWorkerMessageQueue.Create;
  FOutbox := TWorkerMessageQueue.Create;
  FOwnerContext := AContext;   // ✨ PHASE 7
  
  CreateGUID(GuidStr);
  FWorkerID := GUIDToString(GuidStr);

  if Assigned(AContext) then
  begin
    WorkerRegistryLock.Acquire;
    try
      if AContext.Workers = nil then 
        AContext.Workers := TWorkerMap.Create;
      AContext.Workers.Add(FWorkerID, Self);
    finally
      WorkerRegistryLock.Release;
    end;
  end;
  
  InterlockedIncrement(ActiveThreads);
end;

destructor TWorkerThread.Destroy;
begin
  // inregister dari context yang benar
  if Assigned(FOwnerContext) then
  begin
    WorkerRegistryLock.Acquire;
    try
      if Assigned(FOwnerContext.Workers) then
        FOwnerContext.Workers.Remove(FWorkerID);
    finally
      WorkerRegistryLock.Release;
    end;
  end;

  FInbox.Free;
  FOutbox.Free;
  
  if InterlockedDecrement(ActiveThreads) = 0 then
  begin
    if Assigned(ThreadEvent) then 
      RTLEventSetEvent(ThreadEvent);
  end;
    
  inherited;
end;

procedure TWorkerThread.PostToWorker(const JSONPayload: string);
begin
  FInbox.PushMessage(JSONPayload); // Validasi ketat akan terjadi di dalam method ini
end;

function TWorkerThread.ReceiveFromWorker(out JSONPayload: string): Boolean;
begin
  Result := FOutbox.PopMessage(JSONPayload);
end;

procedure TWorkerThread.Execute;
var
  WEnv: TSymbolTable;
  WLex: TLexer;
  WPars: TParser;
  WRoot: TBlockNode;
  WComp: TCompiler;
  WVM: TVM;
  ResVal: TValue;
  SavedContext: TEngineContext;
  LocalContext: TEngineContext;   // ✅ FIX P1.4
begin
  if not Assigned(errMSG) then
    errMSG := Terror.Create;
    
  try
    //if FFuncVal = nil then Exit; 
    SavedContext := GCurrentContext;
    
    // ✅ FIX P1.4: Snapshot context di variabel lokal
    LocalContext := FOwnerContext;
    
    if Assigned(LocalContext) then
      GCurrentContext := LocalContext;
    
    WEnv := TSymbolTable.Create(nil);
    WEnv.Retain;
    
    if Assigned(LocalContext) then
      WEnv.Context := LocalContext;
    
    initNativeCode(WEnv); 
    WEnv.DefineVar('postToMain', TValue.CreateNative(@WorkerNative_PostToMain), true);
    WEnv.DefineVar('getMessage', TValue.CreateNative(@WorkerNative_GetMessage), true);
  
    WLex := nil;
    WPars := nil;
    errMSG := nil;
  
    WLex := TLexer.Create(FScriptSource);
    WPars := TParser.Create(WLex);
    
    try
      WRoot := WPars.ParseMainProgram;
      if WRoot <> nil then
      begin
        WComp := TCompiler.Create;
        WVM := TVM.Create(WEnv);
        try
          WComp.Compile(WRoot, True);
          WComp.Chunk.OptimizeBytecode;
          
          WRoot.Free; 
          WRoot := nil;

          ResVal := WVM.Run(WComp.Chunk);
          if Assigned(ResVal) then ResVal.Free;
        finally
          WVM.Free;
          WComp.Free;
        end;
      end;
    except
      on E: EScriptRuntimeError do
        FOutbox.PushMessage('{"_worker_sys_error": "Runtime Halt", "details": "' + 
                            StringReplace(E.Message, '"', '\"', [rfReplaceAll]) + '"}');
      on E: Exception do
        FOutbox.PushMessage('{"_worker_sys_error": "System Exception", "details": "' + 
                            StringReplace(E.Message, '"', '\"', [rfReplaceAll]) + '"}');
    end;
  finally
    if Assigned(WPars) then WPars.Free;
    if Assigned(WLex) then WLex.Free;
    WEnv.Release; 
    
    if Assigned(errMSG) then
    begin
      errMSG.Free; 
      errMSG := nil; 
    end;
    
    FlushThreadTLAB; 
    GCurrentContext := SavedContext;
  end;
end;

constructor TWorkerPoolThread.Create(APool: TWorkerPool);
begin
  inherited Create(True); // Create suspended
  FreeOnTerminate := False;
  FPool := APool;
  Start; // Start the thread safely after initialization
end;

procedure TWorkerPoolThread.Execute;
var
  SavedContext: TEngineContext;
  LocalContext: TEngineContext;   // ✅ FIX P1.4
begin
  if not Assigned(errMSG) then
    errMSG := Terror.Create;
  
  try
    //if FFuncVal = nil then Exit; 
    SavedContext := GCurrentContext;
    
    // ✅ FIX P1.4: Snapshot context
    if Assigned(FPool) then
      LocalContext := FPool.OwnerContext
    else
      LocalContext := nil;
    
    if Assigned(LocalContext) then
      GCurrentContext := LocalContext;
    
    if Assigned(FPool) then
      FPool.ExecuteWorkerCycle;
  finally
    if Assigned(errMSG) then 
    begin 
      errMSG.Free; 
      errMSG := nil; 
    end;
    
    GCurrentContext := SavedContext;
  end;
end;

constructor TWorkerPool.Create(PoolSize: Integer; AContext: TEngineContext = nil);
var 
  i: Integer;
begin
  FTasks := TList.Create;
  FLock := TCriticalSection.Create;
  FQueueEvent := RTLEventCreate;
  FIsStopping := False;
  FInFlight := 0;
  FOwnerContext := AContext;   // ✨ PHASE 7.5
  SetLength(FWorkers, PoolSize);
  
  // Initialize Thread Pool using the dedicated class
  for i := 0 to PoolSize - 1 do
  begin
    FWorkers[i] := TWorkerPoolThread.Create(Self);
  end;
end;

procedure TWorkerPool.EnqueueTask(AFunc, AArgs, ACallback: TValue);
var
  //Task: PWorkerTask;
  LocalTask: PWorkerTask;
begin
  LocalTask := nil;
  
  FLock.Acquire;
  try
    // ✅ TAHAP A — BUG-4: Cek FIsStopping DI DALAM lock, sebelum alokasi
    //    apa pun. Ini mencegah worker thread yang sudah shutdown menerima
    //    task baru → dangling pointer / AV.
    if FIsStopping then
      raise EScriptRuntimeError.Create(
        'WorkerPool Error: Pool sudah dalam proses shutdown, tidak bisa menerima task baru.');
    
    // Alokasi task hanya jika pool masih hidup
    New(LocalTask);
    LocalTask^.FuncVal := AFunc.Clone;
    
    if Assigned(AArgs) and (AArgs.DataType <> dtNull) then 
      LocalTask^.ArgsVal := AArgs.DeepClone 
    else 
      LocalTask^.ArgsVal := TValue.CreateNull;
      
    if Assigned(ACallback) then 
      LocalTask^.Callback := ACallback.Clone 
    else 
      LocalTask^.Callback := nil;
    
    FTasks.Add(LocalTask);
    LocalTask := nil;   // Ownership transfer ke pool
  finally
    FLock.Release;
  end;
  
  RTLEventSetEvent(FQueueEvent);
  
  // Safety net: jika exception terjadi setelah New() tapi sebelum Add,
  // LocalTask masih terisi. Bersihkan di luar lock.
  if Assigned(LocalTask) then
  begin
    if Assigned(LocalTask^.FuncVal) then LocalTask^.FuncVal.Free;
    if Assigned(LocalTask^.ArgsVal) then LocalTask^.ArgsVal.Free;
    if Assigned(LocalTask^.Callback) then LocalTask^.Callback.Free;
    Dispose(LocalTask);
  end;
end;

function TWorkerPool.HasActiveTasks: Boolean;
begin
  Result := False;
  if FIsStopping then Exit;
  FLock.Acquire;
  try
    if FTasks.Count > 0 then Exit(True);
  finally
    FLock.Release;
  end;
  Result := InterlockedCompareExchange(FInFlight, 0, 0) > 0;
end;

procedure TWorkerPool.ExecuteWorkerCycle;
var 
  Task: PWorkerTask;
  TempVM: TVM;
  TempChunk: TChunk;
  TempEnv: TSymbolTable;
  ResVal: TValue;
  ErrDict: TDictValue; 
begin
  while not FIsStopping do
  begin
    Task := nil;
    FLock.Acquire;
    try
      if FTasks.Count > 0 then
      begin
        Task := PWorkerTask(FTasks[0]);
        FTasks.Delete(0); 
        InterlockedIncrement(FInFlight);   // ✅ T-2b: tandai in-flight
      end;
    finally
      FLock.Release;
    end;
    
    if Task = nil then
    begin
      RTLEventWaitFor(FQueueEvent, 100); 
      RTLEventResetEvent(FQueueEvent);
      Continue;
    end;

    if Assigned(Task^.FuncVal.ClosureEnv) then
      TempEnv := TSymbolTable.Create(Task^.FuncVal.ClosureEnv)
    else
      TempEnv := TSymbolTable.Create(nil); 

    TempVM := TVM.Create(TempEnv); 
    TempChunk := TChunk.Create;
    try
      try
        TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(Task^.FuncVal.Clone));
        TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(Task^.ArgsVal.Clone));
        TempChunk.AddInstruction(opcCall, 1);
        TempChunk.AddInstruction(opcHalt);
        
        ResVal := TempVM.Run(TempChunk);

        try 
          // ✅ T-2b: pakai EventLoop via context, bukan global
          if Assigned(Task^.Callback) and Assigned(FOwnerContext) 
             and Assigned(FOwnerContext.EventLoop) then
          begin
            if Assigned(ResVal) then
              FOwnerContext.EventLoop.PushIOPayload(Task^.Callback.Clone, ResVal.DeepClone)
            else
              FOwnerContext.EventLoop.PushIOPayload(Task^.Callback.Clone, TValue.CreateNull); 
          end;
        finally
          if Assigned(ResVal) then ResVal.Free;
        end;

      except
        on E: Exception do
        begin
          PushThreadError(Format('WorkerPool %s: %s', [E.ClassName, E.Message]));
        
          if Assigned(Task^.Callback) and Assigned(FOwnerContext) 
             and Assigned(FOwnerContext.EventLoop) then
          begin
            // ✅ FASE 1.5: crash-safe error dispatch
            try
              ErrDict := TDictValue.Create;
              try
                ErrDict.SetValue('error', 
                  TValue.CreateStr('Worker Crash: ' + E.Message));
                ErrDict.SetValue('__worker_crash', TValue.CreateBool(True));
                ErrDict.SetValue('__worker_kind', 
                  TValue.CreateStr(E.ClassName));
                ResVal := TValue.CreateDict(ErrDict);
              except
                ErrDict.Free;
                raise;
              end;
              
              try
                FOwnerContext.EventLoop.PushIOPayload(
                  Task^.Callback.Clone, ResVal.Clone);
              finally
                ResVal.Free; 
              end;
            except
              // best-effort — PushThreadError sudah catat
            end;
          end;
        end;
      end;
      
    finally
      // ✅ T-2b-fix-2: decrement DULU, sebelum cleanup apapun.
      // Kalau cleanup crash (SIGSEGV di .Free/.Release), counter
      // sudah benar dan main loop bisa exit normal.
      InterlockedDecrement(FInFlight);
      
      // Cleanup best-effort — kalau ada yang crash, itu bukan
      // masalah kita lagi (proses mau exit).
      try TempChunk.Free; except end;
      try TempVM.Free; except end;
      try TempEnv.Release; except end;
      
      if Assigned(Task) then
      begin
        if Assigned(Task^.FuncVal) then try Task^.FuncVal.Free; except end;
        if Assigned(Task^.ArgsVal) then try Task^.ArgsVal.Free; except end;
        if Assigned(Task^.Callback) then try Task^.Callback.Free; except end;
        try Dispose(Task); except end;
      end;
      
      try FlushThreadTLAB; except end;
    end;
    
  end;
end;

destructor TWorkerPool.Destroy;
var 
  i: Integer;
  Task: PWorkerTask;
begin
  FIsStopping := True;
  
  // ✅ B.2.5 FIX: broadcast + tidur singkat untuk beri worker waktu exit loop
  // sebelum WaitFor join. Tanpa ini, race di heap finalization.
  for i := 0 to High(FWorkers) do
    RTLEventSetEvent(FQueueEvent);
  
  Sleep(200);  // kasih worker ≤200ms untuk lihat FIsStopping dan exit loop
    
  for i := 0 to High(FWorkers) do
  begin
    FWorkers[i].WaitFor;
    FWorkers[i].Free;
  end;

  // PERBAIKAN: Bersihkan sisa antrean yang tidak tereksekusi!
  FLock.Acquire;
  try
    for i := 0 to FTasks.Count - 1 do
    begin
      Task := PWorkerTask(FTasks[i]);
      if Assigned(Task) then
      begin
        if Assigned(Task^.FuncVal) then Task^.FuncVal.Free;
        if Assigned(Task^.ArgsVal) then Task^.ArgsVal.Free;
        if Assigned(Task^.Callback) then Task^.Callback.Free;
        Dispose(Task);
      end;
    end;
    FTasks.Clear;
  finally
    FLock.Release;
  end;

  FLock.Free;
  FTasks.Free;
  RTLEventDestroy(FQueueEvent);
  inherited;
end;

constructor TAllocationTracker.Create;
begin
  inherited Create;
  FCount := 0;
  FLock := TCriticalSection.Create;
  FEnabled := False;
end;

destructor TAllocationTracker.Destroy;
begin
  FLock.Free;
  inherited;
end;

procedure TAllocationTracker.Enable;
begin
  FEnabled := True;
end;

procedure TAllocationTracker.Disable;
begin
  FEnabled := False;
end;

procedure TAllocationTracker.Track(Ptr: Pointer; Size: Int64; 
                                    const TypeName: string; Line: Integer);
var
  Idx: Integer;
begin
  if not FEnabled then Exit;
  
  FLock.Acquire;
  try
    Idx := FCount;
    if Idx >= Length(FRecords) then
      SetLength(FRecords, Idx + 1024);
    
    FRecords[Idx].Ptr := Ptr;
    FRecords[Idx].Size := Size;
    FRecords[Idx].TypeName := TypeName;
    FRecords[Idx].SourceLine := Line;
    FRecords[Idx].Timestamp := GetTickCount64;
    Inc(FCount);
  finally
    FLock.Release;
  end;
end;

procedure TAllocationTracker.Untrack(Ptr: Pointer);
var
  i, WriteIdx: Integer;
begin
  if not FEnabled then Exit;
  
  FLock.Acquire;
  try
    WriteIdx := 0;
    for i := 0 to FCount - 1 do
    begin
      if FRecords[i].Ptr <> Ptr then
      begin
        FRecords[WriteIdx] := FRecords[i];
        Inc(WriteIdx);
      end;
    end;
    FCount := WriteIdx;
  finally
    FLock.Release;
  end;
end;

function TAllocationTracker.GetReport: string;
var
  i: Integer;
  TotalBytes: Int64;
  SL: TStringList;
begin
  Result := '';
  TotalBytes := 0;
  
  SL := TStringList.Create;
  try
    FLock.Acquire;
    try
      for i := 0 to FCount - 1 do
      begin
        TotalBytes := TotalBytes + FRecords[i].Size;
        SL.Add(Format('[%d] %s @ %p (%d bytes) line %d',
          [i, FRecords[i].TypeName, FRecords[i].Ptr, 
           FRecords[i].Size, FRecords[i].SourceLine]));
      end;
    finally
      FLock.Release;
    end;
    
    Result := Format('=== ALLOCATION TRACKER ==='#10 +
      'Live allocations: %d'#10 +
      'Total bytes: %d'#10 +
      '---'#10, [FCount, TotalBytes]);
    Result := Result + SL.Text;
  finally
    SL.Free;
  end;
end;

//TWSConnection====================
//=================================
constructor TWSConnection.Create;
begin
  inherited Create;
  ConnID := '';
  Sock := -1;
  TLSConn := nil;
  ServerHandle := -1;
  Path := '';
  Query := '';
  Protocol := '';
  HeaderNames := TStringList.Create;
  HeaderValues := TStringList.Create;
  PeerIP := '';
  PeerPort := 0;
  State := wscsHandshake;
  FRefCount := 1;   // worker owns initial ref
  SendLock := TCriticalSection.Create;
  LastActivity := GetTickCount64;
  PendingPingSentAt := 0;
  PendingPingPending := False;
  PingIntervalMs := 30000;
  PongTimeoutMs := 10000;
  PingEnabled := True;
  CompressionNegotiated := False;
  CompressionThreshold := 128;
end;

destructor TWSConnection.Destroy;
begin
  // Order matters: TLS shutdown dulu (butuh fd), baru close fd.
  if Assigned(TLSConn) then
  begin
    try TLSClose(TLSConn); except end;
    try TLSConn.Release; except end;
    TLSConn := nil;
  end;
  if Sock >= 0 then
  begin
    try NetClose(Sock); except end;
    Sock := -1;
  end;
  if Assigned(HeaderNames) then HeaderNames.Free;
  if Assigned(HeaderValues) then HeaderValues.Free;
  if Assigned(SendLock) then SendLock.Free;
  inherited;
end;

procedure TWSConnection.Retain;
begin
  InterlockedIncrement(FRefCount);
end;

procedure TWSConnection.Release;
begin
  if InterlockedDecrement(FRefCount) = 0 then
    Self.Free;
end;

//Server entry management
procedure InitWSServers;
begin
  if Assigned(GWSServersLock) then Exit;
  GWSServersLock := TCriticalSection.Create;
  GWSServers := TList.Create;
  GWSConnectionsLock := TCriticalSection.Create;
  GWSConnections := TStringList.Create;
  GWSConnections.Sorted := True;
  GWSConnections.Duplicates := dupIgnore;
  GWSConnCounter := 0;
  
  // B.1.4: init event loop + sink bridge
  GWSSinkBridge := TWSSinkBridge.Create;
  GWSEventLoop := TWSEventLoop.Create;
  GWSEventLoop.SetSink(
    @GWSSinkBridge.HandleOnOpen,
    @GWSSinkBridge.HandleOnMessage,
    @GWSSinkBridge.HandleOnClose);
end;

procedure FreeWSServers;
var
  i: Integer;
  E: PWSServerEntry;
  ConnList: TList;
begin
  if not Assigned(GWSServersLock) then Exit;
  
  // ── 1. Stop & free semua server ──
  GWSServersLock.Acquire;
  try
    for i := 0 to GWSServers.Count - 1 do
    begin
      E := PWSServerEntry(GWSServers[i]);
      if Assigned(E) then
      begin
        if E^.ListenSock >= 0 then
        begin
          try NetClose(E^.ListenSock); except end;
          E^.ListenSock := -1;
        end;
        
        if Assigned(E^.ListenerThread) then
        begin
          try E^.ListenerThread.WaitFor; except end;
          try E^.ListenerThread.Free;    except end;
          E^.ListenerThread := nil;
        end;        
        
        if Assigned(E^.Subprotocols) then
        begin
          E^.Subprotocols.Free;
          E^.Subprotocols := nil;
        end;      
        
        // B.1.4: dispose NBSConfig (dibuat di Native_WS_ListenAsync)
        if Assigned(E^.NBSConfig) then
        begin
          Dispose(PNBServerConfig(E^.NBSConfig));
          E^.NBSConfig := nil;
        end;        
        
        if Assigned(E^.OnOpen)    then begin E^.OnOpen.Free;    E^.OnOpen := nil; end;
        if Assigned(E^.OnMessage) then begin E^.OnMessage.Free; E^.OnMessage := nil; end;
        if Assigned(E^.OnClose)   then begin E^.OnClose.Free;   E^.OnClose := nil; end;
        if Assigned(E^.OnError)   then begin E^.OnError.Free;   E^.OnError := nil; end;
        if Assigned(E^.TLSContext) then
        begin
          try TLSServerContext(E^.TLSContext).Release; except end;
          E^.TLSContext := nil;
        end;
        Dispose(E);
      end;
    end;
    GWSServers.Clear;
  finally
    GWSServersLock.Release;
  end;
  
  // ── 2. Kumpulkan semua koneksi yang masih hidup ──
  //    Worker thread mungkin masih blocked di recv. Kita Release
  //    referensi registry; worker akan Release miliknya sendiri
  //    saat frame loop-nya exit.
  if Assigned(GWSConnectionsLock) then
  begin
    ConnList := TList.Create;
    try
      GWSConnectionsLock.Acquire;
      try
        for i := 0 to GWSConnections.Count - 1 do
          if Assigned(GWSConnections.Objects[i]) then
            ConnList.Add(GWSConnections.Objects[i]);
        GWSConnections.Clear;
      finally
        GWSConnectionsLock.Release;
      end;
      
      // Drop registry ref di luar lock. Koneksi akan tetap hidup
      // kalau worker thread masih pegang ref — akan free sendiri
      // setelah frame loop exit.
      for i := 0 to ConnList.Count - 1 do
        try TWSConnection(ConnList[i]).Release; except end;
    finally
      ConnList.Free;
    end;
  end;
  
  // ── 3. Free lock & list ──
  GWSServers.Free;      GWSServers := nil;
  GWSServersLock.Free;  GWSServersLock := nil;
  GWSConnections.Free;  GWSConnections := nil;
  GWSConnectionsLock.Free; GWSConnectionsLock := nil;
  
  // B.1.4: free event loop + sink bridge
  if Assigned(GWSEventLoop) then
  begin
    try GWSEventLoop.Free; except end;
    GWSEventLoop := nil;
  end;
  if Assigned(GWSSinkBridge) then
  begin
    try GWSSinkBridge.Free; except end;
    GWSSinkBridge := nil;
  end;
end;

function AllocWSServer: Integer;
var
  E: PWSServerEntry;
begin
  InitWSServers;
  New(E);
  FillChar(E^, SizeOf(E^), 0);
  E^.Used := True;
  E^.ListenSock := -1;
  E^.Port := 0;
  E^.IsTLS := False;
  E^.TLSContext := nil;
  E^.StopRequested := False;
  E^.PingIntervalMs := 30000;         // default 30s
  E^.MaxPayloadBytes := 16 * 1024 * 1024;
  E^.ListenerThread := nil;
  E^.OnOpen := nil;
  E^.OnMessage := nil;
  E^.OnClose := nil;
  E^.OnError := nil;
  E^.Subprotocols := TStringList.Create;
  E^.PongTimeoutMs := 10000;
  E^.PingEnabled := True;  
  E^.CompressionEnabled := False;
  E^.CompressionThreshold := 128;  
  GWSServersLock.Acquire;
  try
    Result := GWSServers.Add(E);
  finally
    GWSServersLock.Release;
  end;
end;

function GetWSServer(Handle: Integer): PWSServerEntry;
begin
  Result := nil;
  if not Assigned(GWSServers) then Exit;
  if (Handle < 0) or (Handle >= GWSServers.Count) then Exit;
  Result := PWSServerEntry(GWSServers[Handle]);
  if Assigned(Result) and (not Result^.Used) then
    Result := nil;
end;

//Connection registry
function GenerateWSConnID: string;
var
  N: LongInt;
begin
  N := InterlockedIncrement(GWSConnCounter);
  Result := 'ws-' + IntToHex(N, 8);
end;

procedure RegisterWSConn(Conn: TWSConnection);
begin
  if (not Assigned(GWSConnections)) or (not Assigned(Conn)) then Exit;
  GWSConnectionsLock.Acquire;
  try
    Conn.Retain;   // registry holds one ref
    GWSConnections.AddObject(Conn.ConnID, Conn);
  finally
    GWSConnectionsLock.Release;
  end;
end;

procedure UnregisterWSConn(Conn: TWSConnection);
var
  Idx: Integer;
begin
  if (not Assigned(GWSConnections)) or (not Assigned(Conn)) then Exit;
  GWSConnectionsLock.Acquire;
  try
    Idx := GWSConnections.IndexOf(Conn.ConnID);
    if Idx >= 0 then
      GWSConnections.Delete(Idx);
  finally
    GWSConnectionsLock.Release;
  end;
  Conn.Release;   // drop registry ref
end;

function FindWSConn(const ConnID: string): TWSConnection;
var
  Idx: Integer;
begin
  Result := nil;
  if not Assigned(GWSConnections) then Exit;
  GWSConnectionsLock.Acquire;
  try
    Idx := GWSConnections.IndexOf(ConnID);
    if Idx >= 0 then
      Result := TWSConnection(GWSConnections.Objects[Idx]);
    if Assigned(Result) then
      Result.Retain;   // caller owns ref, must Release
  finally
    GWSConnectionsLock.Release;
  end;
end;

{ --------------------------------------------------------------------
  B.1.4: Sink bridge implementation.
  Callback dari event loop thread → dispatch ke script callback.
  -------------------------------------------------------------------- }

{ Build conn handle dict untuk script — versi event mode.
  Field __nbs_id dipakai untuk dispatch di ExecuteNativeTypeMethod. }
function BuildNBSConnHandle(ConnID: Int64; Conn: TWSNBConn): TValue;
var
  D, HeadersDict: TDictValue;
  I: Integer;
begin
  D := TDictValue.Create;
  try
    D.SetValue('id', TValue.CreateStr('nbs-' + IntToStr(ConnID)));
    D.SetValue('__nbs_id', TValue.CreateNum(ConnID));
    
    if Assigned(Conn) then
    begin
      D.SetValue('path',     TValue.CreateStr(Conn.Path));
      D.SetValue('query',    TValue.CreateStr(Conn.Query));
      D.SetValue('protocol', TValue.CreateStr(Conn.Protocol));
      D.SetValue('peerIP',   TValue.CreateStr(Conn.PeerIP));
      D.SetValue('peerPort', TValue.CreateNum(Conn.PeerPort));
      
      HeadersDict := TDictValue.Create;
      try
        for I := 0 to Conn.HeaderNames.Count - 1 do
          HeadersDict.SetValue(Conn.HeaderNames[I],
            TValue.CreateStr(Conn.HeaderValues[I]));
        D.SetValue('headers', TValue.CreateDict(HeadersDict));
      except
        HeadersDict.Free;
        raise;
      end;
    end
    else
    begin
      D.SetValue('path',     TValue.CreateStr(''));
      D.SetValue('query',    TValue.CreateStr(''));
      D.SetValue('protocol', TValue.CreateStr(''));
      D.SetValue('peerIP',   TValue.CreateStr(''));
      D.SetValue('peerPort', TValue.CreateNum(0));
    end;
    
    Result := TValue.CreateDict(D);
  except
    D.Free;
    raise;
  end;
end;

procedure TWSSinkBridge.HandleOnOpen(Ctx: Pointer;
  ConnID: Int64; ConnHandle: Pointer);
var
  Server: PWSServerEntry;
  ConnVal: TValue;
  NBS: TWSNBConn;
begin
  Server := PWSServerEntry(Ctx);
  if not Assigned(Server) then Exit;
  if not Assigned(Server^.OnOpen) then Exit;
  
  NBS := TWSNBConn(ConnHandle);
  ConnVal := BuildNBSConnHandle(ConnID, NBS);
  try
    CallWSCallback(Server^.OnOpen, [ConnVal]);
  finally
    ConnVal.Free;
  end;
end;

procedure TWSSinkBridge.HandleOnMessage(Ctx: Pointer;
  ConnID: Int64; const Payload: RawByteString);
var
  Server: PWSServerEntry;
  ConnVal, MsgVal: TValue;
  NBS: TWSNBConn;
begin
  Server := PWSServerEntry(Ctx);
  if not Assigned(Server) then Exit;
  if not Assigned(Server^.OnMessage) then Exit;
  
  NBS := nil;
  if Assigned(GWSEventLoop) then
    NBS := GWSEventLoop.FindConn(ConnID);
  
  ConnVal := BuildNBSConnHandle(ConnID, NBS);
  MsgVal := TValue.CreateStr(string(Payload));
  try
    CallWSCallback(Server^.OnMessage, [ConnVal, MsgVal]);
  finally
    MsgVal.Free;
    ConnVal.Free;
  end;
end;

procedure TWSSinkBridge.HandleOnClose(Ctx: Pointer;
  ConnID: Int64; Code: Word);
var
  Server: PWSServerEntry;
  ConnVal, CodeVal: TValue;
begin
  Server := PWSServerEntry(Ctx);
  if not Assigned(Server) then Exit;
  if not Assigned(Server^.OnClose) then Exit;
  
  ConnVal := BuildNBSConnHandle(ConnID, nil);
  CodeVal := TValue.CreateNum(Code);
  try
    CallWSCallback(Server^.OnClose, [ConnVal, CodeVal]);
  finally
    CodeVal.Free;
    ConnVal.Free;
  end;
end;

// Apply dict config ke TExecPolicy (existing instance, cleared first)
procedure ApplyExecPolicyDict(Policy: TExecPolicy; Config: TValue);
var
  V, Item: TValue;
  Keys: TStringArray;
  I: Integer;
  ModeStr: string;
  N: Int64;
begin
  if (not Assigned(Policy)) or (not Assigned(Config))
     or (Config.DataType <> dtDict) then Exit;

  // Mode
  V := Config.DictVal.GetValueClone('mode');
  if Assigned(V) then
  begin
    if V.DataType = dtString then
    begin
      ModeStr := LowerCase(Trim(V.StrVal));
      if ModeStr = 'none' then Policy.Mode := epmDenyAll
      else if ModeStr = 'whitelist' then Policy.Mode := epmWhitelist
      else if ModeStr = 'allow-all' then Policy.Mode := epmAllowAll;
    end;
    V.Free;
  end;

  // binaries: array of string
  V := Config.DictVal.GetValueClone('binaries');
  if Assigned(V) and (V.DataType = dtArray) then
  begin
    Policy.Binaries.Clear;
    V.ArrayVal.FLock.Acquire;
    try
      for I := 0 to V.ArrayVal.Count - 1 do
      begin
        Item := V.ArrayVal[I];
        if Assigned(Item) and (Item.DataType = dtString) and
           (Trim(Item.StrVal) <> '') then
          Policy.Binaries.Add(Trim(Item.StrVal));
      end;
    finally
      V.ArrayVal.FLock.Release;
    end;
    V.Free;
  end
  else if Assigned(V) then V.Free;

  // envAllow
  V := Config.DictVal.GetValueClone('envAllow');
  if Assigned(V) and (V.DataType = dtArray) then
  begin
    Policy.EnvAllow.Clear;
    V.ArrayVal.FLock.Acquire;
    try
      for I := 0 to V.ArrayVal.Count - 1 do
      begin
        Item := V.ArrayVal[I];
        if Assigned(Item) and (Item.DataType = dtString) then
          Policy.EnvAllow.Add(Item.StrVal);
      end;
    finally
      V.ArrayVal.FLock.Release;
    end;
    V.Free;
  end
  else if Assigned(V) then V.Free;

  // envDeny
  V := Config.DictVal.GetValueClone('envDeny');
  if Assigned(V) and (V.DataType = dtArray) then
  begin
    Policy.EnvDeny.Clear;
    V.ArrayVal.FLock.Acquire;
    try
      for I := 0 to V.ArrayVal.Count - 1 do
      begin
        Item := V.ArrayVal[I];
        if Assigned(Item) and (Item.DataType = dtString) then
          Policy.EnvDeny.Add(Item.StrVal);
      end;
    finally
      V.ArrayVal.FLock.Release;
    end;
    V.Free;
  end
  else if Assigned(V) then V.Free;

  // envSet: dict "KEY": "VALUE"
  V := Config.DictVal.GetValueClone('envSet');
  if Assigned(V) and (V.DataType = dtDict) then
  begin
    Policy.EnvSet.Clear;
    Keys := V.DictVal.GetKeys;
    for I := 0 to High(Keys) do
    begin
      Item := V.DictVal.GetValueClone(Keys[I]);
      if Assigned(Item) and (Item.DataType = dtString) then
        Policy.EnvSet.Add(Keys[I] + '=' + Item.StrVal);
      if Assigned(Item) then Item.Free;
    end;
    V.Free;
  end
  else if Assigned(V) then V.Free;

  // cwd
  V := Config.DictVal.GetValueClone('cwd');
  if Assigned(V) then
  begin
    if V.DataType = dtString then
      Policy.DefaultCwd := V.StrVal;
    V.Free;
  end;

  // maxConcurrent
  V := Config.DictVal.GetValueClone('maxConcurrent');
  if Assigned(V) then
  begin
    if V.DataType = dtNumeric then
      Policy.MaxConcurrent := Trunc(V.NumVal);
    V.Free;
  end;

  // maxOutputBytes
  V := Config.DictVal.GetValueClone('maxOutputBytes');
  if Assigned(V) then
  begin
    if V.DataType = dtNumeric then
    begin
      N := Trunc(V.NumVal);
      Policy.MaxOutputBytes := N;
    end;
    V.Free;
  end;

  // auditLog
  V := Config.DictVal.GetValueClone('auditLog');
  if Assigned(V) then
  begin
    if V.DataType = dtString then
      Policy.AuditLogPath := V.StrVal;
    V.Free;
  end;

  // resolvePath
  V := Config.DictVal.GetValueClone('resolvePath');
  if Assigned(V) then
  begin
    Policy.ResolvePath := V.IsTrue;
    V.Free;
  end;

  // limits sub-dict
  V := Config.DictVal.GetValueClone('limits');
  if Assigned(V) and (V.DataType = dtDict) then
  begin
    Item := V.DictVal.GetValueClone('enabled');
    if Assigned(Item) then
    begin
      Policy.Limits.Enabled := Item.IsTrue;
      Item.Free;
    end;

    Item := V.DictVal.GetValueClone('cpuSec');
    if Assigned(Item) then
    begin
      if Item.DataType = dtNumeric then
        Policy.Limits.CpuSec := Trunc(Item.NumVal);
      Item.Free;
    end;

    Item := V.DictVal.GetValueClone('memoryBytes');
    if Assigned(Item) then
    begin
      if Item.DataType = dtNumeric then
        Policy.Limits.MemoryBytes := Trunc(Item.NumVal);
      Item.Free;
    end;

    Item := V.DictVal.GetValueClone('fileSizeBytes');
    if Assigned(Item) then
    begin
      if Item.DataType = dtNumeric then
        Policy.Limits.FileSizeBytes := Trunc(Item.NumVal);
      Item.Free;
    end;

    Item := V.DictVal.GetValueClone('openFiles');
    if Assigned(Item) then
    begin
      if Item.DataType = dtNumeric then
        Policy.Limits.OpenFiles := Trunc(Item.NumVal);
      Item.Free;
    end;

    Item := V.DictVal.GetValueClone('subprocesses');
    if Assigned(Item) then
    begin
      if Item.DataType = dtNumeric then
        Policy.Limits.Subprocesses := Trunc(Item.NumVal);
      Item.Free;
    end;

    V.Free;
  end
  else if Assigned(V) then V.Free;
end;

//Raw I/O over (plain socket | TLS)
function WSSendRaw(Conn: TWSConnection; const Data: RawByteString): Boolean;
var
  Sent: Integer;
begin
  Result := False;
  if (not Assigned(Conn)) or (Length(Data) = 0) then Exit;
  
  // Serialize: cegah frame interleave kalau broadcast bertemu worker send.
  Conn.SendLock.Acquire;
  try
    if Assigned(Conn.TLSConn) then
      Sent := TLSSend(Conn.TLSConn, Data)
    else if Conn.Sock >= 0 then
      Sent := NetSend(Conn.Sock, Data)
    else
      Sent := -1;
    Result := Sent > 0;
  finally
    Conn.SendLock.Release;
  end;
end;

function WSRecvRaw(Conn: TWSConnection; MaxBytes, TimeoutMs: Integer;
  out Data: RawByteString): Integer;
begin
  Data := '';
  if not Assigned(Conn) then Exit(-1);
  
  if Assigned(Conn.TLSConn) then
    Result := TLSRecvTimeout(Conn.TLSConn, MaxBytes, TimeoutMs, Data)
  else if Conn.Sock >= 0 then
    Result := NetRecvTimeout(Conn.Sock, MaxBytes, TimeoutMs, Data)
  else
    Result := -1;
end;

//Handshake emission
function WSEmitHandshake(Conn: TWSConnection;
    const ClientKey, Protocol: string): Boolean;
var
  Response: RawByteString;
begin
  Response := BuildWSHandshakeResponse(ClientKey, Protocol);
  Result := WSSendRaw(Conn, Response);
end;

// A.2.4: handshake dengan extensions header
function WSEmitHandshakeEx(Conn: TWSConnection;
    const ClientKey, Protocol: string;
    Compression: Boolean): Boolean;
var
  Response: RawByteString;
begin
  Response := BuildWSHandshakeResponse(ClientKey, Protocol);
  
  // Sisipkan extensions header sebelum baris kosong terakhir
  if Compression then
  begin
    // Response format: "...header\r\n\r\n"
    // Kita sisipkan "Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover; client_no_context_takeover\r\n"
    // sebelum "\r\n\r\n"
    if Length(Response) >= 2 then
    begin
      // Hapus hanya blank-line terminator (\r\n terakhir, 2 byte).
      // Pertahankan \r\n setelah header Sec-WebSocket-Accept.
      Delete(Response, Length(Response) - 1, 2);
      Response := Response +
        'Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover; client_no_context_takeover' + #13#10 +
        #13#10;
    end;
    
  end;
  
  Result := WSSendRaw(Conn, Response);
end;

// ────────────────────────────────────────────────────────────────
//  GC root marking
//
//  Server entry menyimpan TValue callback (OnOpen/OnMessage/OnClose).
//  GC tidak menelusuri GWSServers secara otomatis — harus dipanggil
//  eksplisit dari RunGarbageCollection. Hook dipasang di Chunk 3c.
// ────────────────────────────────────────────────────────────────

procedure MarkWSServers;
var
  i: Integer;
  E: PWSServerEntry;
  Snapshot: array of TValue;
  SnapCount: Integer;
begin
  if not Assigned(GWSServers) then Exit;
  
  SetLength(Snapshot, 0);
  SnapCount := 0;
  
  GWSServersLock.Acquire;
  try
    if GWSServers.Count = 0 then Exit;
    SetLength(Snapshot, GWSServers.Count * 4);
    for i := 0 to GWSServers.Count - 1 do
    begin
      E := PWSServerEntry(GWSServers[i]);
      if (not Assigned(E)) or (not E^.Used) then Continue;
      if Assigned(E^.OnOpen)    then begin Snapshot[SnapCount] := E^.OnOpen;    Inc(SnapCount); end;
      if Assigned(E^.OnMessage) then begin Snapshot[SnapCount] := E^.OnMessage; Inc(SnapCount); end;
      if Assigned(E^.OnClose)   then begin Snapshot[SnapCount] := E^.OnClose;   Inc(SnapCount); end;
      if Assigned(E^.OnError)   then begin Snapshot[SnapCount] := E^.OnError;   Inc(SnapCount); end;
    end;
  finally
    GWSServersLock.Release;
  end;
  
  SetLength(Snapshot, SnapCount);
  for i := 0 to SnapCount - 1 do
    Snapshot[i].Mark;
  SetLength(Snapshot, 0);
end;

procedure WSSweepFinishedWorkers;
var
  i: Integer;
  W: TWSWorkerThread;
  Snapshot: TList;
begin
  if not Assigned(GWSWorkers) or not Assigned(GWSWorkersLock) then Exit;
  if GWSWorkers.Count = 0 then Exit;
  
  Snapshot := TList.Create;
  try
    GWSWorkersLock.Acquire;
    try
      for i := GWSWorkers.Count - 1 downto 0 do
      begin
        W := TWSWorkerThread(GWSWorkers[i]);
        if Assigned(W) and W.Finished then
          Snapshot.Add(W);
      end;
    finally
      GWSWorkersLock.Release;
    end;
    
    for i := 0 to Snapshot.Count - 1 do
    begin
      W := TWSWorkerThread(Snapshot[i]);
      if not Assigned(W) then Continue;
      try W.WaitFor; except end;
      try W.Free;    except end;
    end;
  finally
    Snapshot.Free;
  end;
end;
//TWSConnection end
//=============================


//TWSWorkerThread=============================
//============================================
procedure WSRegisterWorker(W: TWSWorkerThread);
begin
  if not Assigned(GWSWorkers) then Exit;
  GWSWorkersLock.Acquire;
  try GWSWorkers.Add(W);
  finally GWSWorkersLock.Release;
  end;
end;

procedure WSUnregisterWorker(W: TWSWorkerThread);
var Idx: Integer;
begin
  if not Assigned(GWSWorkers) then Exit;
  GWSWorkersLock.Acquire;
  try
    Idx := GWSWorkers.IndexOf(W);
    if Idx >= 0 then GWSWorkers.Delete(Idx);
  finally GWSWorkersLock.Release;
  end;
end;

// Bangun handle script untuk koneksi ───
function BuildConnHandle(Conn: TWSConnection): TValue;
var
  D, HeadersDict: TDictValue;
  i: Integer;
begin
  D := TDictValue.Create;
  try
    D.SetValue('id',       TValue.CreateStr(Conn.ConnID));
    D.SetValue('path',     TValue.CreateStr(Conn.Path));
    D.SetValue('query',    TValue.CreateStr(Conn.Query));
    D.SetValue('peerIP',   TValue.CreateStr(Conn.PeerIP));
    D.SetValue('peerPort', TValue.CreateNum(Conn.PeerPort));
    D.SetValue('protocol', TValue.CreateStr(Conn.Protocol));
    D.SetValue('__ws_id',  TValue.CreateStr(Conn.ConnID));
    
    HeadersDict := TDictValue.Create;
    try
      for i := 0 to Conn.HeaderNames.Count - 1 do
        HeadersDict.SetValue(Conn.HeaderNames[i],
          TValue.CreateStr(Conn.HeaderValues[i]));
      D.SetValue('headers', TValue.CreateDict(HeadersDict));
    except
      HeadersDict.Free;
      raise;
    end;
    
    Result := TValue.CreateDict(D);
  except
    D.Free;
    raise;
  end;
end;

// Panggil script callback via mini VM ───
procedure CallWSCallback(Cb: TValue; const Args: array of TValue);
var
  MiniVM: TVM;
  TmpChunk: TChunk;
  Env: TSymbolTable;
  i: Integer;
  ResVal: TValue;
begin
  if (not Assigned(Cb)) or (Cb.DataType <> dtFunction) then Exit;
  
  Env := Cb.ClosureEnv;
  if not Assigned(Env) then
  begin
    if Assigned(GCurrentContext) then Env := GCurrentContext.GlobalEnv
    else Exit;
  end;
  
  MiniVM := nil;
  TmpChunk := nil;
  ResVal := nil;
  try
    MiniVM := TVM.Create(Env);
    TmpChunk := TChunk.Create;
    TmpChunk.AddInstruction(opcConstant, TmpChunk.AddConstant(Cb.Clone));
    for i := 0 to High(Args) do
      TmpChunk.AddInstruction(opcConstant, TmpChunk.AddConstant(Args[i].Clone));
    TmpChunk.AddInstruction(opcCall, Length(Args));
    TmpChunk.AddInstruction(opcReturn);
    ResVal := MiniVM.Run(TmpChunk);
    if Assigned(ResVal) then ResVal.Free;
  except
    on E: Exception do
      PushThreadError('WS callback: ' + E.ClassName + ': ' + E.Message);
  end;
  if Assigned(TmpChunk) then TmpChunk.Free;
  if Assigned(MiniVM) then MiniVM.Free;
end;

// Kirim HTTP 400 lalu tutup ───
procedure WSSendBadRequest(Conn: TWSConnection; const Msg: string);
var
  Names, Values: TStringList;
  Resp: RawByteString;
begin
  Names := TStringList.Create;
  Values := TStringList.Create;
  try
    Names.Add('Content-Type');   Values.Add('text/plain');
    Resp := BuildHTTPResponseRaw(400, 'Bad Request', Names, Values,
                                 RawByteString(Msg));
    WSSendRaw(Conn, Resp);
  finally
    Names.Free;
    Values.Free;
  end;
end;

// Kirim close frame ───
procedure WSSendClose(Conn: TWSConnection; Code: Word; const Reason: string);
begin
  if not Assigned(Conn) then Exit;
  if Conn.State = wscsClosed then Exit;
  WSSendRaw(Conn, BuildWSClose(Code, Reason));
  if Conn.State <> wscsClosing then
    Conn.State := wscsClosing;
end;

// Dispatch pesan ke onMessage ───
procedure WSDispatchMessage(Server: PWSServerEntry; Conn: TWSConnection;
                            const Payload: RawByteString);
var
  ConnHandle, MsgVal: TValue;
begin
  if (not Assigned(Server)) or (not Assigned(Server^.OnMessage)) then Exit;
  ConnHandle := BuildConnHandle(Conn);
  MsgVal := TValue.CreateStr(string(Payload));
  try
    CallWSCallback(Server^.OnMessage, [ConnHandle, MsgVal]);
  finally
    MsgVal.Free;
    ConnHandle.Free;
  end;
end;

function SelectSubprotocol(const ClientList: string;
  ServerList: TStringList): string;
var
  ClientParts: TStringArray;
  i, j: Integer;
  C: string;
begin
  Result := '';
  if (ClientList = '') or (not Assigned(ServerList)) or
     (ServerList.Count = 0) then Exit;
  
  ClientParts := ClientList.Split([',']);
  for i := 0 to High(ClientParts) do
  begin
    C := Trim(ClientParts[i]);
    if C = '' then Continue;
    for j := 0 to ServerList.Count - 1 do
      if ServerList[j] = C then
        Exit(C);
  end;
end;

constructor TWSWorkerThread.Create(AClientSock, AServerHandle: Integer;
  AIsTLS: Boolean; ATLSContext: Pointer; AContext: TEngineContext);
begin
  inherited Create(True);
  FreeOnTerminate := False;
  FClientSock := AClientSock;
  FServerHandle := AServerHandle;
  FIsTLS := AIsTLS;
  FTLSContext := ATLSContext;
  FOwnerContext := AContext;
  FConn := nil;
  FRefCount := 1;
  WSRegisterWorker(Self);
end;

destructor TWSWorkerThread.Destroy;
begin
  WSUnregisterWorker(Self);
  inherited;
end;

procedure TWSWorkerThread.Execute;
var
  Server: PWSServerEntry;
  Conn: TWSConnection;
  Parser: TWSFrameParser;
  Frame: TWSFrame;
  Buf, HandshakeBuf: RawByteString;
  R, HdrEnd, i: Integer;
  NowTick: QWord;
  Names, Values: TStringList;
  Method, Path, Query, Version: string;
  ClientKey, WSVer, WSProto: string;
  WSExtensions: string;
  Parsed: Integer;
  ParseErr: string;
  BodyDiscard: RawByteString;
  FragActive: Boolean;
  FragBuf: RawByteString;
  CloseCode: Word;
  CloseReason: string;
  SavedContext: TEngineContext;
  ShouldExit: Boolean;
  ConnHandle, CloseCodeVal: TValue;
begin
  SavedContext := GCurrentContext;
  if Assigned(FOwnerContext) then
    GCurrentContext := FOwnerContext;
  
  if not Assigned(errMSG) then
    errMSG := Terror.Create;
  
  Conn := nil;
  Names := nil;
  Values := nil;
  
  try
    Server := GetWSServer(FServerHandle);
    if not Assigned(Server) then Exit;
    
    // ─── Buat koneksi ───
    Conn := TWSConnection.Create;
    Conn.Sock := FClientSock;
    Conn.ServerHandle := FServerHandle;
    Conn.ConnID := GenerateWSConnID;
    Conn.PeerIP := NetPeerIP(FClientSock);
    Conn.PeerPort := NetPeerPort(FClientSock);
    
    // ─── TLS handshake (jika wss) ───
    if FIsTLS and Assigned(FTLSContext) then
    begin
      if not TLSAccept(TLSServerContext(FTLSContext), FClientSock, Conn.TLSConn) then
      begin
        Conn.Free;
        Exit;
      end;
    end;
    
    // ─── Baca HTTP upgrade request ───
    Names := TStringList.Create;
    Values := TStringList.Create;
    HandshakeBuf := '';
    HdrEnd := 0;
    
    while Length(HandshakeBuf) < HTTP_MAX_HEADER_BYTES do
    begin
      if Assigned(Conn.TLSConn) then
        R := TLSRecvTimeout(Conn.TLSConn, 4096, 5000, Buf)
      else
        R := NetRecvTimeout(FClientSock, 4096, 5000, Buf);
      
      if R <= 0 then Break;
      HandshakeBuf := HandshakeBuf + Buf;
      // Cek \r\n\r\n
      for i := 1 to Length(HandshakeBuf) - 3 do
        if (HandshakeBuf[i] = #13) and (HandshakeBuf[i+1] = #10) and
           (HandshakeBuf[i+2] = #13) and (HandshakeBuf[i+3] = #10) then
        begin
          HdrEnd := i + 3;
          Break;
        end;
      if HdrEnd > 0 then Break;
    end;
    
    if HdrEnd = 0 then
    begin
      WSSendBadRequest(Conn, 'Incomplete handshake');
      UnregisterWSConn(Conn);
      Conn.Free;
      Exit;
    end;
    
    if not ParseRawHTTPRequest(HandshakeBuf,
        Method, Path, Query, Version,
        Names, Values, BodyDiscard,
        Parsed, ParseErr) then    
    begin
      WSSendBadRequest(Conn, 'Malformed request: ' + ParseErr);
      UnregisterWSConn(Conn);
      Conn.Free;
      Exit;
    end;
    
    // Verifikasi upgrade
    if not IsWebSocketUpgrade(Names, Values, ClientKey, WSVer, WSProto) then
    begin
      WSSendBadRequest(Conn, 'Not a WebSocket upgrade request');
      UnregisterWSConn(Conn);
      Conn.Free;
      Exit;
    end;
    
    // ✅ A.2.4: parse Sec-WebSocket-Extensions
    WSExtensions := '';
    for i := 0 to Names.Count - 1 do
      if SameText(Names[i], 'Sec-WebSocket-Extensions') then
      begin
        WSExtensions := LowerCase(Values[i]);
        Break;
      end;
    
    // Negotiate permessage-deflate
    if Server^.CompressionEnabled and
       (Pos('permessage-deflate', WSExtensions) > 0) then
    begin
      Conn.CompressionNegotiated := True;
      Conn.CompressionThreshold := Server^.CompressionThreshold;
    end;
    
    // Populate metadata
    Conn.Path := Path;
    Conn.Query := Query;
    Conn.Protocol := SelectSubprotocol(WSProto, Server^.Subprotocols);    
        
    for i := 0 to Names.Count - 1 do
    begin
      Conn.HeaderNames.Add(Names[i]);
      Conn.HeaderValues.Add(Values[i]);
    end;
    
    // ─── Register + handshake response ───
    RegisterWSConn(Conn);
    
    if not WSEmitHandshakeEx(Conn, ClientKey, Conn.Protocol, Conn.CompressionNegotiated) then
    begin
      UnregisterWSConn(Conn);
      Conn.Free;
      Exit;
    end;
    
    Conn.State := wscsOpen;
    
    // ✅ A.2.3: apply ping/pong config dari server
    Conn.PingIntervalMs := Server^.PingIntervalMs;
    Conn.PongTimeoutMs   := Server^.PongTimeoutMs;
    Conn.PingEnabled     := Server^.PingEnabled;
    Conn.LastActivity    := GetTickCount64;

    // ─── onOpen ───
    if Assigned(Server^.OnOpen) then
    begin
      ConnHandle := BuildConnHandle(Conn);
      try CallWSCallback(Server^.OnOpen, [ConnHandle]);
      finally ConnHandle.Free; end;
    end;
    
    Parser := TWSFrameParser.Create(True);
    // A.2.4: enable RSV1 kalau compression negotiated
    Parser.AllowRSV1 := Conn.CompressionNegotiated;    
    
    try
      FragActive := False;
      FragBuf := '';
      ShouldExit := False;
      
      while not ShouldExit do
      begin
        if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 1 then Break;
        if Server^.StopRequested then
        begin
          WSSendClose(Conn, WS_CLOSE_GOING_AWAY, '');
          Break;
        end;
        if Conn.State = wscsClosing then
        begin
          ShouldExit := True;
          Break;
        end;
    
        // Recv dengan timeout pendek supaya responsif ke stop flag
        if Assigned(Conn.TLSConn) then
          R := TLSRecvTimeout(Conn.TLSConn, 8192, 1000, Buf)
        else
          R := NetRecvTimeout(Conn.Sock, 8192, 1000, Buf);
        
        if R = 0 then Break;       // peer closed
        if R < 0 then
        begin
          // ✅ A.2.3: timeout tick — cek ping/pong state
          if Conn.PingEnabled then
          begin
            NowTick := GetTickCount64;
            
            // Pong timeout?
            if Conn.PendingPingPending and
               ((NowTick - Conn.PendingPingSentAt) > QWord(Conn.PongTimeoutMs)) then
            begin
              WSSendClose(Conn, WS_CLOSE_GOING_AWAY, 'pong timeout');
              ShouldExit := True;
              Break;
            end;
            
            // Kirim ping kalau idle
            if (not Conn.PendingPingPending) and
               ((NowTick - Conn.LastActivity) > QWord(Conn.PingIntervalMs)) then
            begin
              WSSendRaw(Conn, BuildWSFrame(wsPing, '', True));
              Conn.PendingPingSentAt := NowTick;
              Conn.PendingPingPending := True;
            end;
          end;
          Continue;
        end;
        
        // Update activity: client mengirim data → hidup
        Conn.LastActivity := GetTickCount64;
        Conn.PendingPingPending := False;
        
        Parser.Append(Buf);
        
        // Parse all frames
        while True do
        begin
          try
            if not Parser.TryParse(Frame) then Break;
          except
            on E: EWSProtocolError do
            begin
              WSSendClose(Conn, WS_CLOSE_PROTOCOL_ERR, E.Message);
              ShouldExit := True;
              Break;
            end;
          end;
          
          // Update activity tiap frame valid → reset pong pending
          Conn.LastActivity := GetTickCount64;
          Conn.PendingPingPending := False;
          
          case Frame.Opcode of
            wsText, wsBinary:
              begin
                if FragActive then
                begin
                  WSSendClose(Conn, WS_CLOSE_PROTOCOL_ERR, 'unexpected data frame');
                  ShouldExit := True;
                  Break;
                end;
                if Frame.Fin then
                begin
                  // A.2.4: decompress kalau RSV1 set
                  if Frame.RSV1 and Conn.CompressionNegotiated then
                  begin
                    try
                      WSDispatchMessage(Server, Conn, WSInflatePayload(Frame.Payload));
                    except
                      on E: Exception do
                      begin
                        WSSendClose(Conn, WS_CLOSE_PROTOCOL_ERR, 'inflate failed');
                        ShouldExit := True;
                        Break;
                      end;
                    end;
                  end
                  else
                    WSDispatchMessage(Server, Conn, Frame.Payload);
                end
                else
                begin
                  FragActive := True;
                  // Simpan flag RSV1 dari frame pertama untuk fragmentasi
                  FragBuf := Frame.Payload;
                  // Note: v1 tidak dukung compress + fragmentasi bersamaan
                end;
              end;
            wsContinuation:
              begin
                if not FragActive then
                begin
                  WSSendClose(Conn, WS_CLOSE_PROTOCOL_ERR, 'unexpected continuation');
                  ShouldExit := True;
                  Break;
                end;
                FragBuf := FragBuf + Frame.Payload;
                if Length(FragBuf) > Server^.MaxPayloadBytes then
                begin
                  WSSendClose(Conn, WS_CLOSE_TOO_LARGE, '');
                  ShouldExit := True;
                  Break;
                end;
                if Frame.Fin then
                begin
                  WSDispatchMessage(Server, Conn, FragBuf);
                  FragActive := False;
                  FragBuf := '';
                end;
              end;
            wsPing:
              WSSendRaw(Conn, BuildWSFrame(wsPong, Frame.Payload, True));
            wsPong:
              ;   // update last-activity (v1: noop)
            wsClose:
              begin
                if ParseClosePayload(Frame.Payload, CloseCode, CloseReason) then
                  WSSendRaw(Conn, BuildWSClose(CloseCode, ''))
                else
                  WSSendRaw(Conn, BuildWSClose(WS_CLOSE_PROTOCOL_ERR, ''));
                ShouldExit := True;
                Break;
              end;
          end;
        end;
      end;
    finally
      Parser.Free;
      Parser := nil;
    end;

    // ─── onClose ───
    if Assigned(Server^.OnClose) then
    begin
      ConnHandle := BuildConnHandle(Conn);
      CloseCodeVal := TValue.CreateNum(WS_CLOSE_NORMAL);
      try CallWSCallback(Server^.OnClose, [ConnHandle, CloseCodeVal]);
      finally
        CloseCodeVal.Free;
        ConnHandle.Free;
      end;
    end;
    
    Conn.State := wscsClosed;
    UnregisterWSConn(Conn);
    Conn.Release;   // drop worker's initial ref
    
  except
    on E: Exception do
    begin
      PushThreadError('WSWorker ' + E.ClassName + ': ' + E.Message);
      if Assigned(Conn) then
      begin
        try UnregisterWSConn(Conn); except end;
        try Conn.Release; except end;
      end;
    end;
  end;
  
  if Assigned(Names) then Names.Free;
  if Assigned(Values) then Values.Free;
  
  // Reset thread-local freelist
  FlushThreadTLAB;
  GCurrentContext := SavedContext;
end;

procedure TWSWorkerThread.Retain;
begin
  InterlockedIncrement(FRefCount);
end;

procedure TWSWorkerThread.Release;
begin
  if InterlockedDecrement(FRefCount) = 0 then
    Self.Free;
end;//end TWSWorkerThread 

constructor TWSClientConn.Create(const AID: string);
begin
  inherited Create;
  ID := AID;
  URL := '';
  Host := '';
  Port := 0;
  Path := '/';
  IsTLS := False;
  Verify := True;
  Sock := -1;
  TLSConn := nil;
  TLSContext := nil;
  Parser := TWSFrameParser.Create(False);
  State := wscsConnecting;
  SendLock := TCriticalSection.Create;
  FRefCount := 1;
  LastError := '';
  OnOpen := nil;
  OnMessage := nil;
  OnClose := nil;
  OnError := nil;

  // C.2
  AutoReconnect := False;
  ReconnectMinMs := 1000;
  ReconnectMaxMs := 30000;
  ReconnectAttempts := 0;
  
  Subprotocols := TStringList.Create;
  NegotiatedProtocol := '';
  
  CompressionEnabled := False;
  CompressionThreshold := 128;
  CompressionNegotiated := False;
end;  

destructor TWSClientConn.Destroy;
begin
  if Assigned(TLSConn) then
  begin
    try TLSClose(TLSConn); except end;
    try TLSConn.Release; except end;
    TLSConn := nil;
  end;
  if Assigned(TLSContext) then
  begin
    try TLSContext.Release; except end;
    TLSContext := nil;
  end;
  if Sock >= 0 then
  begin
    try NetClose(Sock); except end;
    Sock := -1;
  end;
  if Assigned(Parser) then Parser.Free;
  if Assigned(SendLock) then SendLock.Free;
  if Assigned(Subprotocols) then Subprotocols.Free;
  if Assigned(OnOpen) then OnOpen.Free;
  if Assigned(OnMessage) then OnMessage.Free;
  if Assigned(OnClose) then OnClose.Free;
  if Assigned(OnError) then OnError.Free;
  inherited;
end;

procedure TWSClientConn.Retain;
begin
  InterlockedIncrement(FRefCount);
end;

procedure TWSClientConn.Release;
begin
  if InterlockedDecrement(FRefCount) = 0 then
    Self.Free;
end;

constructor TWSClientThread.Create(AConn: TWSClientConn);
begin
  inherited Create(True);
  FreeOnTerminate := False;
  FConn := AConn;
  FConn.Retain;
end;

destructor TWSClientThread.Destroy;
begin
  inherited;
end;

procedure TWSClientThread.Execute;
var
  ClientKey, ExpectedAccept, AcceptVal: string;
  Handshake, Buf, BufAccum: RawByteString;
  R, HdrEnd, i: Integer;
  StatusLine, HeaderBlock: string;
  HdrLines: TStringArray;
  HdrLine: string;
  Frame: TWSFrame;
  FragActive: Boolean;
  FragBuf: RawByteString;
  FragOpcode: TWSOpcode;
  CloseCode: Word;
  CloseReason: string;
  ConnHandle, MsgVal, CodeVal: TValue;
  SavedContext: TEngineContext;
  ShouldExit: Boolean;
  Attempts, BackoffMs: Integer;
  ShouldRetry: Boolean;

  procedure CleanupForRetry;
  begin
    if Assigned(FConn.TLSConn) then
    begin
      try TLSClose(FConn.TLSConn); except end;
      try FConn.TLSConn.Release; except end;
      FConn.TLSConn := nil;
    end;
    if Assigned(FConn.TLSContext) then
    begin
      try FConn.TLSContext.Release; except end;
      FConn.TLSContext := nil;
    end;
    if FConn.Sock >= 0 then
    begin
      try NetClose(FConn.Sock); except end;
      FConn.Sock := -1;
    end;
    if Assigned(FConn.Parser) then
      FConn.Parser.Free;
    FConn.Parser := TWSFrameParser.Create(False);
  end;
begin
  SavedContext := GCurrentContext;
  if not Assigned(errMSG) then errMSG := Terror.Create;

  Attempts := 0;
  BackoffMs := FConn.ReconnectMinMs;
  if BackoffMs < 100 then BackoffMs := 100;

  try
    repeat
      ShouldRetry := False;
      ShouldExit := False;
      FragActive := False;
      FragBuf := '';

      // ═══════════════════════════════════════════════════════
      //  Attempt body
      // ═══════════════════════════════════════════════════════
      try
        // ─── 1. TCP connect ───
        if not NetConnect(FConn.Host, FConn.Port, 10000, FConn.Sock) then
        begin
          FConn.LastError := 'connect gagal: ' + NetLastError;
          FConn.State := wscsClosed;
          if Assigned(FConn.OnError) then
          begin
            MsgVal := TValue.CreateStr(FConn.LastError);
            try CallWSCallback(FConn.OnError, [TValue.CreateNull, MsgVal]);
            finally MsgVal.Free; end;
          end;
        end
        else
        begin
          // ─── 2. TLS handshake ───
          if FConn.IsTLS then
          begin
            if not TLSInit then
            begin
              FConn.LastError := 'libssl tidak tersedia';
              FConn.State := wscsClosed;
            end
            else
            begin
              FConn.TLSContext := GetSharedTLSContext(FConn.Verify);
              if not Assigned(FConn.TLSContext) then
              begin
                FConn.LastError := 'TLS context gagal dibuat';
                FConn.State := wscsClosed;
              end
              else if not TLSConnect(FConn.TLSContext, FConn.Sock,
                                     FConn.Host, FConn.TLSConn) then
              begin
                FConn.LastError := 'TLS handshake gagal: ' +
                                   FConn.TLSConn.LastError;
                FConn.State := wscsClosed;
              end;
            end;
          end;

          // ─── 3. Send handshake + read response ───
          if FConn.State <> wscsClosed then
          begin
            Handshake := BuildWSClientHandshake(FConn.Host, FConn.Path,
                          FConn.Port, FConn.IsTLS, FConn.Subprotocols,
                          FConn.CompressionEnabled, ClientKey);            
            
            if not WSClientSendRaw(FConn, Handshake) then
            begin
              FConn.LastError := 'send handshake gagal';
              FConn.State := wscsClosed;
            end
            else
            begin
              FConn.State := wscsHandshake;

              BufAccum := '';
              HdrEnd := 0;
              while Length(BufAccum) < HTTP_MAX_HEADER_BYTES do
              begin
                if Assigned(FConn.TLSConn) then
                  R := TLSRecvTimeout(FConn.TLSConn, 4096, 10000, Buf)
                else
                  R := NetRecvTimeout(FConn.Sock, 4096, 10000, Buf);
                if R <= 0 then Break;
                BufAccum := BufAccum + Buf;
                for i := 1 to Length(BufAccum) - 3 do
                  if (BufAccum[i] = #13) and (BufAccum[i+1] = #10) and
                     (BufAccum[i+2] = #13) and (BufAccum[i+3] = #10) then
                  begin
                    HdrEnd := i + 3;
                    Break;
                  end;
                if HdrEnd > 0 then Break;
              end;

              if HdrEnd = 0 then
              begin
                FConn.LastError := 'handshake response tidak lengkap';
                FConn.State := wscsClosed;
              end
              else
              begin
                HeaderBlock := Copy(BufAccum, 1, HdrEnd - 3);
                HdrLines := HeaderBlock.Split([#13#10]);
                if Length(HdrLines) = 0 then
                begin
                  FConn.LastError := 'handshake response kosong';
                  FConn.State := wscsClosed;
                end
                else
                begin
                  StatusLine := HdrLines[0];
                  if Pos(' 101 ', StatusLine) = 0 then
                  begin
                    FConn.LastError := 'handshake gagal: ' + StatusLine;
                    FConn.State := wscsClosed;
                  end
                  else
                  begin
                    ExpectedAccept := ComputeWSAccept(ClientKey);
                    AcceptVal := '';
                    FConn.NegotiatedProtocol := '';
                    FConn.CompressionNegotiated := False;
                    for i := 1 to High(HdrLines) do
                    begin
                      HdrLine := HdrLines[i];
                      if (Length(HdrLine) >= 21) and
                         SameText(Copy(HdrLine, 1, 21), 'Sec-WebSocket-Accept:') then
                        AcceptVal := Trim(Copy(HdrLine, 22, Length(HdrLine)))
                      else if (Length(HdrLine) >= 23) and
                              SameText(Copy(HdrLine, 1, 23), 'Sec-WebSocket-Protocol:') then
                        FConn.NegotiatedProtocol := Trim(Copy(HdrLine, 24, Length(HdrLine)))
                      else if (Length(HdrLine) >= 25) and
                              SameText(Copy(HdrLine, 1, 25), 'Sec-WebSocket-Extensions:') then
                      begin
                        if Pos('permessage-deflate', LowerCase(HdrLine)) > 0 then
                          FConn.CompressionNegotiated := True;
                      end;
                    end;
                    
                    // C.3 — Verify negotiated protocol is one of offered
                    if FConn.NegotiatedProtocol <> '' then
                    begin
                      if FConn.Subprotocols.IndexOf(FConn.NegotiatedProtocol) < 0 then
                      begin
                        FConn.LastError := 'server pilih subprotocol yang tidak di-offer: ' +
                                           FConn.NegotiatedProtocol;
                        FConn.State := wscsClosed;
                        Break;
                      end;
                    end;
                    
                    if AcceptVal <> ExpectedAccept then
                    begin
                      FConn.LastError := 'handshake accept mismatch';
                      FConn.State := wscsClosed;
                    end
                    else
                    begin
                      // C.4 — Enable RSV1 if compression negotiated
                      if FConn.CompressionNegotiated then
                        FConn.Parser.AllowRSV1 := True;
                      
                      if Length(BufAccum) > HdrEnd then
                        FConn.Parser.Append(Copy(BufAccum, HdrEnd + 1,
                          Length(BufAccum) - HdrEnd));
                      
                      FConn.State := wscsOpen;

                      // ─── onOpen ───
                      if Assigned(FConn.OnOpen) then
                      begin
                        ConnHandle := BuildWSClientHandle(FConn);
                        try CallWSCallback(FConn.OnOpen, [ConnHandle]);
                        finally ConnHandle.Free; end;
                      end;

                      // ─── 4. Frame loop ───
                      while not ShouldExit do
                      begin
                        if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 1 then Break;
                        if FConn.State in [wscsClosing, wscsClosed] then Break;

                        while FConn.Parser.TryParse(Frame) do
                        begin
                          case Frame.Opcode of
                            wsText, wsBinary:
                              begin
                                if FragActive then
                                begin
                                  ShouldExit := True;
                                  Break;
                                end;
                                if Frame.Fin then
                                begin
                                  if Assigned(FConn.OnMessage) then
                                  begin
                                    // C.4 — Decompress if RSV1 + negotiated
                                    if Frame.RSV1 and FConn.CompressionNegotiated then
                                    begin
                                      try
                                        MsgVal := TValue.CreateStr(string(
                                          InflateRaw(Frame.Payload + #0#0#$FF#$FF)));
                                      except
                                        // Fail: treat as raw
                                        MsgVal := TValue.CreateStr(string(Frame.Payload));
                                      end;
                                    end
                                    else
                                      MsgVal := TValue.CreateStr(string(Frame.Payload));
                            
                                    ConnHandle := BuildWSClientHandle(FConn);
                                    try
                                      CallWSCallback(FConn.OnMessage, [ConnHandle, MsgVal]);
                                    finally
                                      MsgVal.Free;
                                      ConnHandle.Free;
                                    end;
                                  end;
                                end
                                else
                                begin
                                  FragActive := True;
                                  FragOpcode := Frame.Opcode;
                                  FragBuf := Frame.Payload;
                                end;
                              end;
                                                            
                            wsContinuation:
                              begin
                                if not FragActive then
                                begin
                                  ShouldExit := True;
                                  Break;
                                end;
                                FragBuf := FragBuf + Frame.Payload;
                                if Frame.Fin then
                                begin
                                  if Assigned(FConn.OnMessage) then
                                  begin
                                    ConnHandle := BuildWSClientHandle(FConn);
                                    MsgVal := TValue.CreateStr(string(FragBuf));
                                    try
                                      CallWSCallback(FConn.OnMessage, [ConnHandle, MsgVal]);
                                    finally
                                      MsgVal.Free;
                                      ConnHandle.Free;
                                    end;
                                  end;
                                  FragActive := False;
                                  FragBuf := '';
                                end;
                              end;
                            wsPing:
                              WSClientSendRaw(FConn, BuildWSClientFrame(wsPong,
                                Frame.Payload, True));
                            wsPong: ;
                            wsClose:
                              begin
                                ParseClosePayload(Frame.Payload, CloseCode, CloseReason);
                                WSClientSendRaw(FConn, BuildWSClientFrame(wsClose,
                                  Copy(BuildWSClose(WS_CLOSE_NORMAL, ''),
                                       3, 2), True));
                                ShouldExit := True;
                                Break;
                              end;
                          end;
                        end;

                        if ShouldExit then Break;

                        if Assigned(FConn.TLSConn) then
                          R := TLSRecvTimeout(FConn.TLSConn, 8192, 1000, Buf)
                        else
                          R := NetRecvTimeout(FConn.Sock, 8192, 1000, Buf);

                        if R > 0 then
                          FConn.Parser.Append(Buf)
                        else if R = 0 then
                          Break;
                      end;

                      // ─── onClose ───
                      FConn.State := wscsClosed;
                      if Assigned(FConn.OnClose) then
                      begin
                        ConnHandle := BuildWSClientHandle(FConn);
                        CodeVal := TValue.CreateNum(WS_CLOSE_NORMAL);
                        try CallWSCallback(FConn.OnClose, [ConnHandle, CodeVal]);
                        finally
                          CodeVal.Free;
                          ConnHandle.Free;
                        end;
                      end;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
      except
        on E: Exception do
        begin
          FConn.LastError := E.Message;
          FConn.State := wscsClosed;
          PushThreadError('WSClient ' + E.ClassName + ': ' + E.Message);
        end;
      end;

      // ═══════════════════════════════════════════════════════
      //  Retry decision
      // ═══════════════════════════════════════════════════════
      if FConn.AutoReconnect and
         (InterlockedCompareExchange(IsShuttingDown, 0, 0) = 0) and
         (not Terminated) then
        ShouldRetry := True;

      if ShouldRetry then
      begin
        CleanupForRetry;
        Inc(Attempts);
        FConn.ReconnectAttempts := Attempts;

        if Assigned(IOLock) then
        begin
          IOLock.Acquire;
          try
            Writeln(ErrOutput, '[ws-client] ', FConn.ID,
                    ' reconnecting in ', BackoffMs, 'ms (attempt ', Attempts, ')');
            Flush(ErrOutput);
          finally IOLock.Release; end;
        end;

        Sleep(BackoffMs);
        BackoffMs := BackoffMs * 2;
        if BackoffMs > FConn.ReconnectMaxMs then
          BackoffMs := FConn.ReconnectMaxMs;

        FConn.State := wscsConnecting;
      end;
    until not ShouldRetry;
  finally
    UnregisterWSClientConn(FConn);
    FConn.Release;
    FlushThreadTLAB;
    if Assigned(errMSG) then begin errMSG.Free; errMSG := nil; end;
    GCurrentContext := SavedContext;
  end;
end;

constructor TWSListenerThread.Create(AServerHandle: Integer;
  AContext: TEngineContext);
begin
  inherited Create(True);
  FreeOnTerminate := False;
  FServerHandle := AServerHandle;
  FOwnerContext := AContext;
end;

procedure TWSListenerThread.Execute;
var
  Server: PWSServerEntry;
  ClientSock: Integer;
  Worker: TWSWorkerThread;
  SavedContext: TEngineContext;
  AcceptCount: Int64;
begin
  SavedContext := GCurrentContext;
  if Assigned(FOwnerContext) then
    GCurrentContext := FOwnerContext;
  
  if not Assigned(errMSG) then
    errMSG := Terror.Create;
  
  AcceptCount := 0;
  try
    Server := GetWSServer(FServerHandle);
    if not Assigned(Server) then Exit;
    
    while True do
    begin
      if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 1 then Break;
      if Server^.StopRequested then Break;
      if Server^.ListenSock < 0 then Break;
      
      if not NetAcceptTimeout(Server^.ListenSock, 500, ClientSock) then
      begin
        // Periodik sweep — tiap 500ms idle, cek finished workers
        WSSweepFinishedWorkers;
        Continue;
      end;
      
      Inc(AcceptCount);
      Worker := TWSWorkerThread.Create(
        ClientSock, FServerHandle, Server^.IsTLS, Server^.TLSContext,
        FOwnerContext);
      Worker.Start;
      
      // Sweep setiap 64 accept untuk batasi memory accumulation
      if (AcceptCount mod 64) = 0 then
        WSSweepFinishedWorkers;
    end;
  except
    on E: Exception do
      PushThreadError('WSListener ' + E.ClassName + ': ' + E.Message);
  end;
  
  FlushThreadTLAB;
  if Assigned(errMSG) then
  begin
    errMSG.Free;
    errMSG := nil;
  end;
  GCurrentContext := SavedContext;
end;

{$WARN SYMBOL_DEPRECATED OFF}
procedure ConfigureSQLiteLibrary;
var
  Prefix: string;
  Candidates: array[0..6] of string;
  i: Integer;
begin
  // Prioritas 1: Termux $PREFIX
  Prefix := GetEnvironmentVariable('PREFIX');
  if (Prefix <> '') and FileExists(Prefix + '/lib/libsqlite3.so') then
  begin
    SQLiteLibraryName := Prefix + '/lib/libsqlite3.so';
    Exit;
  end;
  
  // Prioritas 2: path kandidat platform
  Candidates[0] := '/data/data/com.termux/files/usr/lib/libsqlite3.so';
  Candidates[1] := '/usr/lib/x86_64-linux-gnu/libsqlite3.so.0';
  Candidates[2] := '/usr/lib/aarch64-linux-gnu/libsqlite3.so.0';
  Candidates[3] := '/usr/lib/arm-linux-gnueabihf/libsqlite3.so.0';
  Candidates[4] := '/usr/lib/libsqlite3.so';
  Candidates[5] := '/usr/local/lib/libsqlite3.so';
  Candidates[6] := '/system/lib64/libsqlite3.so';
  
  for i := Low(Candidates) to High(Candidates) do
  begin
    if FileExists(Candidates[i]) then
    begin
      SQLiteLibraryName := Candidates[i];
      Exit;
    end;
  end;
  
  // Tidak ketemu — biarkan default 'sqlite3', mungkin ada di system path
end;
