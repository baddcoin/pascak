function Native_DateTimeFormat(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ts: Int64;
  Fmt: string;
  OffsetSec: Integer;
begin
  if (Args.Count < 2) or (Args.Count > 3) or
     (TValue(Args[0]).DataType <> dtNumeric) or
     (TValue(Args[1]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 'time.format(ts, fmt, [offsetSec])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateStr(''));
  end;

  Ts := Trunc(TValue(Args[0]).NumVal);
  Fmt := TValue(Args[1]).StrVal;
  OffsetSec := 0;
  if Args.Count = 3 then
  begin
    if TValue(Args[2]).DataType = dtNumeric then
      OffsetSec := Trunc(TValue(Args[2]).NumVal);
  end;

  // ✅ Delegate ke TimeFormat (literal separator, tidak locale-aware).
  // FPC FormatDateTime mengganti '/' dengan date separator locale → '-' di Termux.
  Result := TValue.CreateStr(TimeFormat(Ts, Fmt, OffsetSec));
end;

function Native_DateTimeGetPart(Args: TObjectList; CallEnv: TSymbolTable; PartType: Integer): TValue;
var
  DT: TDateTime;
  Y, M, D, H, Min, S, MS: Word;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
    raise EScriptRuntimeError.Create('Fungsi ekstraksi waktu membutuhkan 1 argumen timestamp numerik.');
    
  try
    DT := UnixToDateTime(Trunc(TValue(Args[0]).NumVal));
    DecodeDateTime(DT, Y, M, D, H, Min, S, MS);
  except
    on E: Exception do
      raise EScriptRuntimeError.Create('Date/Time Error: Nilai timestamp tidak valid.');
  end;
  
  case PartType of
    1: Result := TValue.CreateNum(Y);
    2: Result := TValue.CreateNum(M);
    3: Result := TValue.CreateNum(D);
    4: Result := TValue.CreateNum(H);
    5: Result := TValue.CreateNum(Min);
    6: Result := TValue.CreateNum(S);
    else Result := TValue.CreateNum(0);
  end;
end;

function Native_DTYear(Args: TObjectList; CallEnv: TSymbolTable): TValue; begin Result := Native_DateTimeGetPart(Args, CallEnv, 1); end;
function Native_DTMonth(Args: TObjectList; CallEnv: TSymbolTable): TValue; begin Result := Native_DateTimeGetPart(Args, CallEnv, 2); end;
function Native_DTDay(Args: TObjectList; CallEnv: TSymbolTable): TValue; begin Result := Native_DateTimeGetPart(Args, CallEnv, 3); end;
function Native_DTHour(Args: TObjectList; CallEnv: TSymbolTable): TValue; begin Result := Native_DateTimeGetPart(Args, CallEnv, 4); end;
function Native_DTMinute(Args: TObjectList; CallEnv: TSymbolTable): TValue; begin Result := Native_DateTimeGetPart(Args, CallEnv, 5); end;
function Native_DTSecond(Args: TObjectList; CallEnv: TSymbolTable): TValue; begin Result := Native_DateTimeGetPart(Args, CallEnv, 6); end;

