function Native_Lib_CallbackCount(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Count: Integer;
begin
  Count := 0;
  if Assigned(GCallbackRegistry) and Assigned(GCallbackLock) then
  begin
    GCallbackLock.Acquire;
    try
      Count := GCallbackRegistry.Count;
    finally
      GCallbackLock.Release;
    end;
  end;
  Result := TValue.CreateNum(Count);
end;

function Native_Lib_Callback(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Sig: string;
  FnVal: TValue;
  ArgTypes: TFFIArgTypeArray;
  RetType: TFFIRetType;
  ArgCount: Integer;
  Ctx: TCallbackContext;
  i: Integer;
  ClosureCode: Pointer;
  Res: Integer;
  CifSize: NativeUInt;

  procedure DBG(const Msg: string);
  begin
    {$IFDEF CALLBACK_DEBUG}
    WriteLn(ErrOutput, '[lib.callback] ', Msg);
    Flush(ErrOutput);
    {$ENDIF}
  end;

begin
  Result := nil;
  DBG('enter');
  
  if Args.Count <> 2 then
  begin
    errMSG.callerror(140, 'lib.callback(sig, fn) butuh 2 argumen (string, function)',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  DBG('args count ok');
  
  if (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtFunction) then
  begin
    errMSG.callerror(140, 'lib.callback(sig, fn): sig string, fn function',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  DBG('arg types ok');
  
  if not InitLibFFI or not GFFIAvailable then
  begin
    errMSG.callerror(153, 'lib.callback: libffi tidak tersedia di sistem ini',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  DBG('libffi available');
  
  Sig := TValue(Args[0]).StrVal;
  FnVal := TValue(Args[1]);
  DBG('sig = ' + Sig);
  
  SetLength(ArgTypes, 0);
  RetType := frtVoid;
  ArgCount := 0;
  
  if not ParseFFISignature(Sig, ArgTypes, RetType, ArgCount) then
  begin
    errMSG.callerror(152, 'lib.callback: signature tidak valid — "' + Sig + '"',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  DBG('sig parsed, ArgCount=' + IntToStr(ArgCount));
  
  // ─── Alokasi context ───
  Ctx := TCallbackContext.Create;
  try
    Ctx.Sig := Sig;
    Ctx.VMFunc := FnVal.Clone;
    Ctx.ArgCount := ArgCount;
    Ctx.RetType := FFIRetTypeToPffiType(RetType);
    DBG('ctx created, RetType ptr = ' + IntToHex(PtrUInt(Ctx.RetType), 16));
    
    Ctx.RetKind := RetType;    // enum untuk dispatcher
    
    SetLength(Ctx.ArgKinds, ArgCount);
    for i := 0 to ArgCount - 1 do
      Ctx.ArgKinds[i] := ArgTypes[i];
    
    // Snapshot context dari CallEnv
    Ctx.OwnerContext := GetContextFromEnv(CallEnv);
    if Assigned(Ctx.OwnerContext) then
      Ctx.OwnerContext.Retain;    
    
    SetLength(Ctx.ArgTypes, ArgCount);
    for i := 0 to ArgCount - 1 do
      Ctx.ArgTypes[i] := FFIArgTypeToPffiType(ArgTypes[i]);
    DBG('arg types set, len=' + IntToStr(Length(Ctx.ArgTypes)));
    
    // ─── ffi_cif ───
    if GFFIDetectedABI < 0 then
    begin
      errMSG.callerror(159, 'lib.callback: ABI libffi belum terdeteksi',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;

    CifSize := 256;
    GetMem(Ctx.CifPtr, CifSize);
    FillChar(Ctx.CifPtr^, CifSize, 0);
    DBG('cif buffer allocated at ' + IntToHex(PtrUInt(Ctx.CifPtr), 16));
    
    if ArgCount > 0 then
    begin
      DBG('calling ffi_prep_cif (ArgCount>0) — ABI=' + IntToStr(GFFIDetectedABI));
      Res := fp_ffi_prep_cif(Ctx.CifPtr, GFFIDetectedABI, ArgCount,
                Ctx.RetType, @Ctx.ArgTypes[0]);
    end
    else
    begin
      DBG('calling ffi_prep_cif (ArgCount=0) — ABI=' + IntToStr(GFFIDetectedABI));
      Res := fp_ffi_prep_cif(Ctx.CifPtr, GFFIDetectedABI, 0,
                Ctx.RetType, nil);
    end;
    DBG('ffi_prep_cif returned ' + IntToStr(Res));
    
    if Res <> 0 then
    begin
      SetLength(ArgTypes, 0);
      Ctx.Free;
      errMSG.callerror(159, 'lib.callback: ffi_prep_cif gagal (ret=' +
                IntToStr(Res) + ')',
                errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;
    
    // ─── ffi_closure ───
    ClosureCode := nil;
    DBG('calling ffi_closure_alloc(256)');
    Ctx.ClosurePtr := fp_ffi_closure_alloc(256, @ClosureCode);
    DBG('ffi_closure_alloc returned, closure=' + IntToHex(PtrUInt(Ctx.ClosurePtr), 16) +
        ' code=' + IntToHex(PtrUInt(ClosureCode), 16));
    
    if (Ctx.ClosurePtr = nil) or (ClosureCode = nil) then
    begin
      SetLength(ArgTypes, 0);
      Ctx.Free;
      errMSG.callerror(159, 'lib.callback: ffi_closure_alloc gagal',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;
    Ctx.CodePtr := ClosureCode;
    
    // ─── Attach dispatcher ───
    DBG('calling ffi_prep_closure_loc, dispatcher=' +
        IntToHex(PtrUInt(@CallbackDispatcher), 16));
    Res := fp_ffi_prep_closure_loc(Ctx.ClosurePtr, Ctx.CifPtr,
                                   @CallbackDispatcher, Pointer(Ctx),
                                   ClosureCode);
    DBG('ffi_prep_closure_loc returned ' + IntToStr(Res));
    
    if Res <> 0 then
    begin
      SetLength(ArgTypes, 0);
      Ctx.Free;
      errMSG.callerror(159, 'lib.callback: ffi_prep_closure_loc gagal (ret=' +
                            IntToStr(Res) + ')',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;
    
    // ─── Register ───
    if not Assigned(GCallbackRegistry) or not Assigned(GCallbackLock) then
    begin
      SetLength(ArgTypes, 0);
      Ctx.Free;
      errMSG.callerror(144, 'lib.callback: registry belum diinisialisasi',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;
    DBG('registering to map');
    
    GCallbackLock.Acquire;
    try
      GCallbackRegistry.Add(PtrUInt(Ctx.CodePtr), Ctx);
    finally
      GCallbackLock.Release;
    end;
    DBG('registered, done');
    
    Result := TValue.CreatePtr(Ctx.CodePtr);
    Ctx := nil;
  finally
    if Assigned(Ctx) then Ctx.Free;
    SetLength(ArgTypes, 0);
  end;
end;

function Native_Lib_FreeCallback(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  PtrVal: Pointer;
  Ctx: TCallbackContext;
  Idx: Integer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then
  begin
    errMSG.callerror(139, 'lib.freeCallback(ptr) butuh 1 argumen pointer',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  PtrVal := TValue(Args[0]).PtrVal;
  if PtrVal = nil then Exit(TValue.CreateBool(False));
  
  if not Assigned(GCallbackRegistry) or not Assigned(GCallbackLock) then
    Exit(TValue.CreateBool(False));
  
  Ctx := nil;
  GCallbackLock.Acquire;
  try
    Idx := GCallbackRegistry.IndexOf(PtrUInt(PtrVal));
    if Idx >= 0 then
    begin
      Ctx := GCallbackRegistry.Data[Idx];
      GCallbackRegistry.Delete(Idx);
    end;
  finally
    GCallbackLock.Release;
  end;
  
  if Assigned(Ctx) then
  begin
    Ctx.Free;
    Result := TValue.CreateBool(True);
  end
  else
    Result := TValue.CreateBool(False);
end;

function InitLibFFI: Boolean;
const
  LIBS: array[0..7] of string = (
    'libffi.so.8',    // Termux modern / Ubuntu 22+
    'libffi.so.7',    // Ubuntu 20
    'libffi.so.6',    // Ubuntu 18
    'libffi.so',      // dev symlink
    '/data/data/com.termux/files/usr/lib/libffi.so',
    '/usr/lib/x86_64-linux-gnu/libffi.so.8',
    '/usr/lib/aarch64-linux-gnu/libffi.so.8',
    '/usr/lib/libffi.so.8'
  );
var
  i: Integer;
  H: TLibHandle;
begin
  if not Assigned(GFFILock) then
  begin
    GFFILock := TCriticalSection.Create;
  end;
  
  GFFILock.Acquire;
  try
    if GFFIAvailable then Exit(True);
    if GLibFFI <> NilHandle then Exit(False);   // sudah dicoba, gagal
    
    H := NilHandle;
    for i := Low(LIBS) to High(LIBS) do
    begin
      H := LoadLibrary(LIBS[i]);
      if H <> NilHandle then Break;
    end;
    
    if H = NilHandle then
    begin
      GLibFFI := NilHandle;
      GFFIAvailable := False;
      Exit(False);
    end;
    
    // Bind function pointers
    Pointer(fp_ffi_prep_cif) := GetProcAddress(H, 'ffi_prep_cif');
    Pointer(fp_ffi_call) := GetProcAddress(H, 'ffi_call');
    Pointer(fp_ffi_prep_closure_loc) := GetProcAddress(H, 'ffi_prep_closure_loc');
    Pointer(fp_ffi_closure_alloc) := GetProcAddress(H, 'ffi_closure_alloc');
    Pointer(fp_ffi_closure_free) := GetProcAddress(H, 'ffi_closure_free');
    
    // Bind data symbols (ffi_type_* — address of descriptor)
    GFFITypeVoid    := GetProcAddress(H, 'ffi_type_void');
    GFFITypeUint8   := GetProcAddress(H, 'ffi_type_uint8');
    GFFITypeSint8   := GetProcAddress(H, 'ffi_type_sint8');
    GFFITypeUint16  := GetProcAddress(H, 'ffi_type_uint16');
    GFFITypeSint16  := GetProcAddress(H, 'ffi_type_sint16');
    GFFITypeUint32  := GetProcAddress(H, 'ffi_type_uint32');
    GFFITypeSint32  := GetProcAddress(H, 'ffi_type_sint32');
    GFFITypeUint64  := GetProcAddress(H, 'ffi_type_uint64');
    GFFITypeSint64  := GetProcAddress(H, 'ffi_type_sint64');
    GFFITypeFloat   := GetProcAddress(H, 'ffi_type_float');
    GFFITypeDouble  := GetProcAddress(H, 'ffi_type_double');
    GFFITypePointer := GetProcAddress(H, 'ffi_type_pointer');
    
    // Validasi: yang paling penting adalah pointer, sint64, double
    if (not Assigned(fp_ffi_prep_cif)) or
       (not Assigned(fp_ffi_call)) or
       (not Assigned(fp_ffi_prep_closure_loc)) or
       (not Assigned(fp_ffi_closure_alloc)) or
       (not Assigned(fp_ffi_closure_free)) or
       (GFFITypeVoid = nil) or
       (GFFITypeSint8 = nil) or
       (GFFITypeSint16 = nil) or
       (GFFITypeSint32 = nil) or
       (GFFITypeSint64 = nil) or
       (GFFITypeUint8 = nil) or
       (GFFITypeUint16 = nil) or
       (GFFITypeUint32 = nil) or
       (GFFITypeUint64 = nil) or
       (GFFITypeFloat = nil) or
       (GFFITypeDouble = nil) or
       (GFFITypePointer = nil) then    
    begin
      UnloadLibrary(H);
      GLibFFI := NilHandle;
      GFFIAvailable := False;
      Exit(False);
    end;
    
    GFFIDetectedABI := DetectFFIABI;
    GLibFFI := H;
    GFFIAvailable := True;
    Result := True;
  finally
    GFFILock.Release;
  end;
end;

function FFIArgTypeToPffiType(AT: TFFIArgType): Pffi_type;
begin
  case AT of
    fatInt:     Result := GFFITypeSint64;
    fatFloat:   Result := GFFITypeDouble;
    fatString:  Result := GFFITypePointer;
    fatPointer: Result := GFFITypePointer;
  else
    Result := GFFITypeSint64;
  end;
end;

function FFIRetTypeToPffiType(RT: TFFIRetType): Pffi_type;
begin
  case RT of
    frtInt:     Result := GFFITypeSint64;
    frtFloat:   Result := GFFITypeDouble;
    frtString:  Result := GFFITypePointer;
    frtPointer: Result := GFFITypePointer;
    frtVoid:    Result := GFFITypeVoid;
  else
    Result := GFFITypeVoid;
  end;
end;

function CtxEnsureStringBuf(Ctx: TCallbackContext; const S: string): Pointer;
var
  Needed: Integer;
begin
  Needed := Length(S) + 1;   // + null terminator
  if Needed < 16 then Needed := 16;   // minimum alloc
  
  if (Ctx.StringBuf = nil) or (Ctx.StringBufSize < Needed) then
  begin
    if Assigned(Ctx.StringBuf) then
      FreeMem(Ctx.StringBuf);
    GetMem(Ctx.StringBuf, Needed);
    Ctx.StringBufSize := Needed;
  end;
  
  if Length(S) > 0 then
    Move(S[1], Ctx.StringBuf^, Length(S));
  PByte(PByte(Ctx.StringBuf) + Length(S))^ := 0;
  
  Result := Ctx.StringBuf;
end;

function PAnsiCharToVMStr(P: PAnsiChar): string; inline;
var
  Len: Integer;
  RBS: RawByteString;
begin
  if P = nil then Exit('');
  Len := StrLen(P);
  if Len = 0 then Exit('');
  SetLength(RBS, Len);
  Move(P^, RBS[1], Len);
  Result := string(RBS);
end;

function DetectFFIABI: Integer;
var
  TestCif: array[0..255] of Byte;
  Abi, Res, Best: Integer;
begin
  Best := 0;
  for Abi := 1 to 10 do
  begin
    FillChar(TestCif, SizeOf(TestCif), 0);
    Res := fp_ffi_prep_cif(@TestCif[0], Abi, 0, GFFITypeVoid, nil);
    if Res = 0 then
      Best := Abi
    else
      Break;   // lebih tinggi pasti juga gagal (abi > default)
  end;
  if Best = 0 then
    Best := 1;   // ultimate fallback (FFI_SYSV)
  Result := Best;
end;

function ResolveFFILibraryPath(const RawPath: string): string;
const
  SYSTEM_LIB_DIRS: array[0..12] of string = (
    // Android
    '/system/lib64/',
    '/system/lib/',
    '/vendor/lib64/',
    '/vendor/lib/',
    '/apex/com.android.runtime/lib64/',
    '/apex/com.android.runtime/lib/',
    // Termux
    '/data/data/com.termux/files/usr/lib/',
    // Linux distro umum
    '/usr/lib/',
    '/usr/local/lib/',
    '/lib/',
    '/lib64/',
    '/usr/lib/x86_64-linux-gnu/',
    '/usr/lib/aarch64-linux-gnu/'
  );
var
  Expanded, Dir, SandboxPath: string;
  i: Integer;
  HasSep: Boolean;
begin
  HasSep := (Pos('/', RawPath) > 0) or (Pos('\', RawPath) > 0);

  // ────────────────────────────────────────────────────────────
  // Case 1: Absolute path
  // ────────────────────────────────────────────────────────────
  if (Length(RawPath) > 0) and (RawPath[1] = '/') then
  begin
    Expanded := ExpandFileName(RawPath);
    for i := Low(SYSTEM_LIB_DIRS) to High(SYSTEM_LIB_DIRS) do
    begin
      Dir := SYSTEM_LIB_DIRS[i];
      if (Length(Expanded) >= Length(Dir)) and
         (Copy(Expanded, 1, Length(Dir)) = Dir) then
      begin
        // Double-check: ExpandFileName sudah normalisasi '..',
        // jadi cek kedua kali memastikan tidak ada symlink escape
        if Copy(ExpandFileName(Expanded), 1, Length(Dir)) = Dir then
          Exit(Expanded);
      end;
    end;
    // Bukan whitelist — lempar ke sandbox (akan tolak dengan pesan jelas)
    Exit(GetSafeSandboxedPath(RawPath));
  end;

  // ────────────────────────────────────────────────────────────
  // Case 2: Relative path dengan separator (mis. "libs/foo.so")
  //         Selalu lewat sandbox, tidak boleh keluar dari script dir
  // ────────────────────────────────────────────────────────────
  if HasSep then
    Exit(GetSafeSandboxedPath(RawPath));

  // ────────────────────────────────────────────────────────────
  // Case 3: Bare name (mis. "libpascak_test.so", "libc.so.6")
  //         Prioritas 1: sandbox-relative (script bawa .so sendiri)
  //         Prioritas 2: linker passthrough (system library)
  // ────────────────────────────────────────────────────────────
  try
    SandboxPath := GetSafeSandboxedPath(RawPath);
    if (SandboxPath <> '') and FileExists(SandboxPath) then
      Exit(SandboxPath);
  except
    // Sandbox menolak (mis. FileName kosong) — fall through ke linker
  end;

  // System library — biarkan linker yang resolve
  Result := RawPath;
end;

// dll.load(path) → dllHandle atau null
function Native_DLL_Load(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  RawPath, SafePath, CanonicalPath, LoadPath, TempCopyPath: string;
  LibHandle: TLibHandle;
  Ctx: TDLLContext;
  Idx: Integer;
  Entry: TDLLRegistryEntry;
  IsNewLoad: Boolean;
  TempDir: string;
  SrcF, DstF: TFileStream;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'dll.load(path) butuh 1 argumen string',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  RawPath := ResolveLibraryPath(TValue(Args[0]).StrVal);
  SafePath := ResolveFFILibraryPath(RawPath);
  
  // Bare name — linker yang resolve, tidak ada file untuk dicek.
  if (Pos('/', SafePath) = 0) and (Pos('\', SafePath) = 0) then
  begin
    CanonicalPath := SafePath;   // pakai apa adanya sebagai registry key
  end
  else
  begin
    if not FileExists(SafePath) then
    begin
      errMSG.callerror(149,
        'dll.load: file library tidak ditemukan — ' + SafePath,
        errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;
    CanonicalPath := ExpandFileName(SafePath);
  end;

  CanonicalPath := ExpandFileName(SafePath);

  // ─── Dedup: cek registry ───
  if not Assigned(GDLLRegistryLock) then
  begin
    errMSG.callerror(144, 'dll.load: registry belum diinisialisasi', 
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  GDLLRegistryLock.Acquire;
  try
    Idx := GDLLRegistry.IndexOf(CanonicalPath);
    if Idx >= 0 then
    begin
      Entry := TDLLRegistryEntry(GDLLRegistry.Objects[Idx]);
      Inc(Entry.RefCount);
      
      // Buat context baru yang menunjuk ke handle yang sudah ada
      Ctx := TDLLContext.Create(Entry.Handle, CanonicalPath);
      Ctx.TempPath := '';   // registry yang punya temp copy
      Result := TValue.CreateDLL(Ctx);
      Ctx.Release;
      Exit;
    end;
  finally
    GDLLRegistryLock.Release;
  end;

  // ─── Load baru ───

  // FFI quota (sekarang benar-benar merepresentasikan handle aktif)
  if InterlockedIncrement(GlobalFFIActiveCount) > GlobalFFIQuotaLimit then
  begin
    InterlockedDecrement(GlobalFFIActiveCount);
    errMSG.callerror(156,
      'dll.load: quota FFI tercapai (' + IntToStr(GlobalFFIQuotaLimit) + ' handle max)',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  LoadPath := CanonicalPath;
  TempCopyPath := '';

  // ─── Android private dir workaround ───
  {$IFDEF ANDROID}
  if (Pos('/storage/', CanonicalPath) > 0) or
     (Pos('/mnt/', CanonicalPath) > 0) or
     (Pos('/sdcard/', CanonicalPath) > 0) then
  begin
    TempDir := GetTempDir;
    if (TempDir = '') or (not DirectoryExists(TempDir)) then
      TempDir := '/data/data/com.termux/files/usr/tmp';
    if (TempDir = '') or (not DirectoryExists(TempDir)) then
      TempDir := '/tmp';
    if (TempDir = '') or (not DirectoryExists(TempDir)) then
      TempDir := GetCurrentDir;

    TempCopyPath := IncludeTrailingPathDelimiter(TempDir) +
                    'pascak_dll_' + IntToHex(GetTickCount64, 12) + '_' +
                    ExtractFileName(CanonicalPath);

    try
      SrcF := TFileStream.Create(CanonicalPath, fmOpenRead or fmShareDenyNone);
      try
        DstF := TFileStream.Create(TempCopyPath, fmCreate);
        try
          DstF.CopyFrom(SrcF, 0);
        finally DstF.Free; end;
      finally SrcF.Free; end;

      LoadPath := TempCopyPath;
      // Set 0755 — beberapa Android linker refuse non-exec file
      {$IFDEF UNIX}
      try FSChmod(TempCopyPath, $1ED); except end;
      {$ENDIF}
    except
      on E: Exception do
      begin
        InterlockedDecrement(GlobalFFIActiveCount);
        if FileExists(TempCopyPath) then
          try DeleteFile(TempCopyPath); except end;
        errMSG.callerror(150, 'dll.load: gagal copy ke private dir — ' +
                              E.Message, errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;
    end;
  end;
  {$ENDIF}

  LibHandle := LoadLibrary(LoadPath);
  if LibHandle = NilHandle then
  begin
    InterlockedDecrement(GlobalFFIActiveCount);
    if (TempCopyPath <> '') and FileExists(TempCopyPath) then
      try DeleteFile(TempCopyPath); except end;
    errMSG.callerror(150,
      'dll.load: gagal memuat — ' + GetLoadErrorStr + ' — [' + LoadPath + ']',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  // Daftarkan ke context untuk diagnostics
  if Assigned(GCurrentContext) and Assigned(GCurrentContext.LoadedDLLs) then
  begin
    IsNewLoad := GCurrentContext.LoadedDLLs.IndexOf(Pointer(LibHandle)) = -1;
    if IsNewLoad then
      GCurrentContext.LoadedDLLs.Add(Pointer(LibHandle));
  end;

  // Daftarkan ke GDLLRegistry
  GDLLRegistryLock.Acquire;
  try
    Entry := TDLLRegistryEntry.Create(LibHandle, CanonicalPath, TempCopyPath);
    GDLLRegistry.AddObject(CanonicalPath, Entry);
  finally
    GDLLRegistryLock.Release;
  end;

  Ctx := TDLLContext.Create(LibHandle, CanonicalPath);
  Ctx.TempPath := '';   // registry yang punya
  Result := TValue.CreateDLL(Ctx);
  Ctx.Release;
end;

// dll.func(lib, name, sig) → callable atau null
function Native_DLL_Func(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  LibVal: TValue;
  RawPtr: Pointer;
  FuncName, Sig: string;
  ArgTypes: TFFIArgTypeArray;
  RetType: TFFIRetType;
  ArgCount: Integer;
  WrapperDict: TDictValue;
  i: Integer;
  ArgTypesArr: TValueList;
begin
  if (Args.Count < 3) or (Args.Count > 4) or
     (TValue(Args[0]).DataType <> dtDLLHandle) or
     (TValue(Args[1]).DataType <> dtString) or
     (TValue(Args[2]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 
      'lib.func(name, sig [, structTypes]) butuh (dllHandle, string, string [, array])',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  LibVal := TValue(Args[0]);
  FuncName := TValue(Args[1]).StrVal;
  Sig := TValue(Args[2]).StrVal;

  if not Assigned(LibVal.DLLVal) then
  begin
    errMSG.callerror(155, 'lib.func: DLL handle tidak valid atau sudah ditutup',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  // F-3a-5c: kalau signature berisi 'S', delegate ke struct path
  if Pos('S', Sig) > 0 then
  begin
    Result := Native_DLL_FuncStruct(Args, CallEnv);
    Exit;
  end;

  RawPtr := GetProcAddress(LibVal.DLLVal.Handle, PChar(FuncName));
  if RawPtr = nil then
  begin
    errMSG.callerror(151,
      'lib.func: fungsi tidak ditemukan — "' + FuncName + '" di ' +
      ExtractFileName(LibVal.DLLVal.Path),
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  // Parse signature (reuse existing)
  SetLength(ArgTypes, 0);
  RetType := frtVoid;
  ArgCount := 0;
  if not ParseFFISignature(Sig, ArgTypes, RetType, ArgCount) then
  begin
    errMSG.callerror(152, 'lib.func: signature tidak valid — "' + Sig + '"',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  // Build wrapper dict (reuse existing pattern)
  WrapperDict := TDictValue.Create;
  try
    WrapperDict.SetValue('__ffi_raw', TValue.CreatePtr(RawPtr));
    WrapperDict.SetValue('__ffi_name', TValue.CreateStr(FuncName));
    WrapperDict.SetValue('__ffi_argc', TValue.CreateNum(ArgCount));
    WrapperDict.SetValue('__ffi_sig', TValue.CreateStr(Sig));

    ArgTypesArr := TValueList.Create(True);
    try
      for i := 0 to ArgCount - 1 do
      begin
        case ArgTypes[i] of
          fatInt: ArgTypesArr.Add(TValue.CreateStr('i'));
          fatFloat: ArgTypesArr.Add(TValue.CreateStr('f'));
          fatString: ArgTypesArr.Add(TValue.CreateStr('s'));
          fatPointer: ArgTypesArr.Add(TValue.CreateStr('p'));
        end;
      end;
      WrapperDict.SetValue('__ffi_args', TValue.CreateArray(ArgTypesArr));
    except
      ArgTypesArr.Free;
      raise;
    end;

    case RetType of
      frtInt: WrapperDict.SetValue('__ffi_ret', TValue.CreateStr('i'));
      frtFloat: WrapperDict.SetValue('__ffi_ret', TValue.CreateStr('f'));
      frtString: WrapperDict.SetValue('__ffi_ret', TValue.CreateStr('s'));
      frtPointer: WrapperDict.SetValue('__ffi_ret', TValue.CreateStr('p'));
      frtVoid: WrapperDict.SetValue('__ffi_ret', TValue.CreateStr('v'));
    end;

    Result := TValue.CreateDict(WrapperDict);
  except
    WrapperDict.Free;
    SetLength(ArgTypes, 0);
    raise;
  end;
  SetLength(ArgTypes, 0);
end;

function Native_DLL_FuncStruct(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  LibVal: TValue;
  RawPtr: Pointer;
  FuncName, Sig: string;
  ArgTypes: TFFIArgTypeArray;
  RetType: TFFIRetType;
  ArgCount: Integer;
  StructTypesArg: TValue;
  StructTypesArr: array of PNativeStructType;
  ReturnStructType: PNativeStructType;
  i, StructIdx: Integer;
  Ctx: TStructCallContext;
  WrapperDict: TDictValue;
  STypeVal: TValue;
begin
  LibVal := TValue(Args[0]);
  FuncName := TValue(Args[1]).StrVal;
  Sig := TValue(Args[2]).StrVal;
  
  SetLength(ArgTypes, 0);
  RetType := frtVoid;
  ArgCount := 0;
  if not ParseFFISignature(Sig, ArgTypes, RetType, ArgCount) then
  begin
    errMSG.callerror(152, 'lib.func: signature tidak valid — "' + Sig + '"',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  if not InitLibFFI or not Assigned(fp_ffi_call) then
  begin
    errMSG.callerror(153, 'lib.func: libffi tidak tersedia untuk struct call',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  StructTypesArg := nil;
  if Args.Count >= 4 then StructTypesArg := TValue(Args[3]);
  if (not Assigned(StructTypesArg)) or (StructTypesArg.DataType <> dtArray) then
  begin
    errMSG.callerror(144, 'lib.func: signature berisi S — perlu array structType sebagai arg ke-4',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  // Extract struct types: satu per S di signature
  SetLength(StructTypesArr, ArgCount);
  ReturnStructType := nil;
  StructIdx := 0;
  
  StructTypesArg.ArrayVal.FLock.Acquire;
  try
    for i := 0 to ArgCount - 1 do
    begin
      if ArgTypes[i] = fatStruct then
      begin
        if StructIdx >= StructTypesArg.ArrayVal.Count then
        begin
          errMSG.callerror(144, 'lib.func: structTypes kurang untuk argumen ke-' + IntToStr(i),
                           errMSG.xrow, errMSG.xcol);
        end;
        STypeVal := StructTypesArg.ArrayVal[StructIdx];
        StructTypesArr[i] := GetStructTypeFromTValue(STypeVal);
        if StructTypesArr[i] = nil then
          errMSG.callerror(155, 'lib.func: structTypes[' + IntToStr(StructIdx) + '] tidak valid',
                           errMSG.xrow, errMSG.xcol);
        Inc(StructIdx);
      end
      else
        StructTypesArr[i] := nil;
    end;
    
    if RetType = frtStruct then
    begin
      if StructIdx >= StructTypesArg.ArrayVal.Count then
        errMSG.callerror(144, 'lib.func: structTypes kurang untuk return struct',
                         errMSG.xrow, errMSG.xcol);
      STypeVal := StructTypesArg.ArrayVal[StructIdx];
      ReturnStructType := GetStructTypeFromTValue(STypeVal);
      if ReturnStructType = nil then
        errMSG.callerror(155, 'lib.func: return structType tidak valid',
                         errMSG.xrow, errMSG.xcol);
    end;
  finally
    StructTypesArg.ArrayVal.FLock.Release;
  end;
  
  RawPtr := GetProcAddress(LibVal.DLLVal.Handle, PChar(FuncName));
  if RawPtr = nil then
  begin
    errMSG.callerror(151, 'lib.func: fungsi tidak ditemukan — "' + FuncName + '"',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Ctx := TStructCallContext.Create;
  try
    Ctx.RawFunc := RawPtr;
    Ctx.ArgKinds := ArgTypes;
    Ctx.RetKind := RetType;
    Ctx.StructTypes := StructTypesArr;
    Ctx.ReturnStructType := ReturnStructType;
    
    GetMem(Ctx.CifPtr, 128);
    FillChar(Ctx.CifPtr^, 128, 0);
    
    SetLength(Ctx.ArgTypesFFI, ArgCount);
    for i := 0 to ArgCount - 1 do
    begin
      case ArgTypes[i] of
        fatInt, fatFloat: 
          if ArgTypes[i] = fatInt then Ctx.ArgTypesFFI[i] := GFFITypeSint64
                                  else Ctx.ArgTypesFFI[i] := GFFITypeDouble;
        fatString, fatPointer: Ctx.ArgTypesFFI[i] := GFFITypePointer;
        fatStruct:
          begin
            if StructTypesArr[i] = nil then
              errMSG.callerror(155, 'lib.func: struct type null', errMSG.xrow, errMSG.xcol);
            Ctx.ArgTypesFFI[i] := StructTypesArr[i]^.FFIType;
          end;
      end;
    end;
    
    case RetType of
      frtInt: Ctx.RetTypeFFI := GFFITypeSint64;
      frtFloat: Ctx.RetTypeFFI := GFFITypeDouble;
      frtString, frtPointer: Ctx.RetTypeFFI := GFFITypePointer;
      frtVoid: Ctx.RetTypeFFI := GFFITypeVoid;
      frtStruct:
        begin
          if ReturnStructType = nil then
            errMSG.callerror(155, 'lib.func: return struct null', errMSG.xrow, errMSG.xcol);
          Ctx.RetTypeFFI := ReturnStructType^.FFIType;
        end;
    end;
    
    if ArgCount > 0 then
    begin
      if fp_ffi_prep_cif(Ctx.CifPtr, GFFIDetectedABI, ArgCount,
                         Ctx.RetTypeFFI, @Ctx.ArgTypesFFI[0]) <> 0 then
        errMSG.callerror(159, 'lib.func: ffi_prep_cif gagal', errMSG.xrow, errMSG.xcol);
    end
    else
    begin
      if fp_ffi_prep_cif(Ctx.CifPtr, GFFIDetectedABI, 0, 
                         Ctx.RetTypeFFI, nil) <> 0 then
        errMSG.callerror(159, 'lib.func: ffi_prep_cif gagal', errMSG.xrow, errMSG.xcol);
    end;
    
    GStructCallLock.Acquire;
    try
      GStructCallRegistry.Add(PtrUInt(Ctx), Ctx);
    finally
      GStructCallLock.Release;
    end;
    
    WrapperDict := TDictValue.Create;
    WrapperDict.SetValue('__ffi_raw', TValue.CreatePtr(RawPtr));
    WrapperDict.SetValue('__ffi_name', TValue.CreateStr(FuncName));
    WrapperDict.SetValue('__ffi_argc', TValue.CreateNum(ArgCount));
    WrapperDict.SetValue('__ffi_sig', TValue.CreateStr(Sig));
    WrapperDict.SetValue('__ffi_struct_ctx', TValue.CreatePtr(Ctx));
    
    Result := TValue.CreateDict(WrapperDict);
  except
    Ctx.Free;
    raise;
  end;
end;

// lib.symbol(lib, name) → pointer atau null
function Native_DLL_Symbol(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  LibVal: TValue;
  SymName: string;
  RawPtr: Pointer;
begin
  if (Args.Count <> 2) or
     (TValue(Args[0]).DataType <> dtDLLHandle) or
     (TValue(Args[1]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 'lib.symbol(name) butuh (dllHandle, string)',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  LibVal := TValue(Args[0]);
  SymName := TValue(Args[1]).StrVal;

  if not Assigned(LibVal.DLLVal) then
  begin
    errMSG.callerror(155, 'lib.func: DLL handle tidak valid atau sudah ditutup',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  RawPtr := GetProcAddress(LibVal.DLLVal.Handle, PChar(SymName));
  if RawPtr = nil then
    Exit(TValue.CreateNull);

  Result := TValue.CreatePtr(RawPtr);
end;

//B.1.4c: Event-mode conn method dispatch
function DispatchNBSConnMethod(ConnID: Int64;
  const MethodName: string; const Args: array of TValue): TValue;
var
  Payload, Frame, Compressed: RawByteString;
  Code: Word;
  Conn: TWSNBConn;
  UseComp: Boolean;
begin
  Result := nil;
  if not Assigned(GWSEventLoop) then
  begin
    Result := TValue.CreateBool(False);
    Exit;
  end;
  
  Conn := GWSEventLoop.FindConn(ConnID);
  if not Assigned(Conn) then
  begin
    Result := TValue.CreateBool(False);
    Exit;
  end;
  
  if MethodName = 'send' then
  begin
    if Length(Args) <> 1 then Exit(TValue.CreateBool(False));
    if Args[0].DataType = dtString then
      Payload := RawByteString(Args[0].StrVal)
    else
      Payload := RawByteString(TValueToString(Args[0], False));
    
    UseComp := False;
    Frame := '';
    if Conn.CompressionNegotiated and
       (Length(Payload) >= Conn.CompressionThreshold) then
    begin
      try
        Compressed := DeflateRaw(Payload);
        if Length(Compressed) < Length(Payload) then
        begin
          Frame := BuildWSFrame(wsText, Compressed, True);
          if Length(Frame) > 0 then
            Frame[1] := Char(Byte(Frame[1]) or $40);
          UseComp := True;
        end;
      except
      end;
    end;
    if not UseComp then
      Frame := BuildWSFrame(wsText, Payload, True);
    
    Result := TValue.CreateBool(GWSEventLoop.SendToConn(ConnID, Frame));
  end
  else if MethodName = 'sendBytes' then
  begin
    if (Length(Args) <> 1) or (Args[0].DataType <> dtString) then
      Exit(TValue.CreateBool(False));
    Payload := RawByteString(Args[0].StrVal);
    Frame := BuildWSFrame(wsBinary, Payload, True);
    Result := TValue.CreateBool(GWSEventLoop.SendToConn(ConnID, Frame));
  end
  else if MethodName = 'close' then
  begin
    Code := WS_CLOSE_NORMAL;
    if (Length(Args) >= 1) and (Args[0].DataType = dtNumeric) then
      Code := Word(Trunc(Args[0].NumVal));
    Result := TValue.CreateBool(GWSEventLoop.SendCloseToConn(ConnID, Code));
  end
  else
    Result := TValue.CreateBool(False);
end;

function DispatchWSConnMethod(const ConnID, MethodName: string;
  const Args: array of TValue): TValue;
var
  ServerConn: TWSConnection;
  ClientConn: TWSClientConn;
  Payload: RawByteString;
  ClosePayload: RawByteString;
  Code: Word;
begin
  Result := nil;

  // Client path — prefix 'wscl-'
  if Copy(ConnID, 1, 5) = 'wscl-' then
  begin
    ClientConn := FindWSClientConn(ConnID);
    if not Assigned(ClientConn) then
    begin
      Result := TValue.CreateBool(False);
      Exit;
    end;
    try
      if MethodName = 'send' then
      begin
        if Length(Args) <> 1 then Exit(TValue.CreateBool(False));
        if Args[0].DataType = dtString then
          Payload := RawByteString(Args[0].StrVal)
        else
          Payload := RawByteString(TValueToString(Args[0], False));
        Result := TValue.CreateBool(
          WSClientSendRaw(ClientConn,
            BuildWSClientFrameCompressed(wsText, Payload, True,
              ClientConn.CompressionNegotiated,
              ClientConn.CompressionThreshold)));
      end
      else if MethodName = 'sendBytes' then
      begin
        if (Length(Args) <> 1) or (Args[0].DataType <> dtString) then
          Exit(TValue.CreateBool(False));
        Payload := RawByteString(Args[0].StrVal);
        Result := TValue.CreateBool(
          WSClientSendRaw(ClientConn,
            BuildWSClientFrameCompressed(wsBinary, Payload, True,
              ClientConn.CompressionNegotiated,
              ClientConn.CompressionThreshold)));
      end
      
      else if MethodName = 'close' then
      begin
        ClientConn.AutoReconnect := False;   // ← disable first
        Code := WS_CLOSE_NORMAL;
        if (Length(Args) >= 1) and (Args[0].DataType = dtNumeric) then
          Code := Word(Trunc(Args[0].NumVal));
        // Build close payload: 2 bytes big-endian code
        SetLength(ClosePayload, 2);
        ClosePayload[1] := Char((Code shr 8) and $FF);
        ClosePayload[2] := Char(Code and $FF);
        WSClientSendRaw(ClientConn, BuildWSClientFrame(wsClose,
          ClosePayload, True));
        ClientConn.State := wscsClosing;
        Result := TValue.CreateBool(True);
      end
      else if MethodName = 'isOpen' then
        Result := TValue.CreateBool(ClientConn.State = wscsOpen)
      else if MethodName = 'attempts' then
        Result := TValue.CreateNum(ClientConn.ReconnectAttempts)
      else if MethodName = 'protocol' then
        Result := TValue.CreateStr(ClientConn.NegotiatedProtocol)
      else if MethodName = 'id' then
        Result := TValue.CreateStr(ClientConn.ID)      
      else if MethodName = 'state' then
      begin
        case ClientConn.State of
          wscsConnecting: Result := TValue.CreateStr('connecting');
          wscsHandshake:  Result := TValue.CreateStr('handshake');
          wscsOpen:       Result := TValue.CreateStr('open');
          wscsClosing:    Result := TValue.CreateStr('closing');
          wscsClosed:     Result := TValue.CreateStr('closed');
        else
          Result := TValue.CreateStr('unknown');
        end;
      end
      else
        Result := TValue.CreateBool(False);
    finally
      ClientConn.Release;
    end;
    Exit;
  end;

  // Server path (existing)
  ServerConn := FindWSConn(ConnID);
  if not Assigned(ServerConn) then
  begin
    Result := TValue.CreateBool(False);
    Exit;
  end;
  
  try
    if MethodName = 'send' then
    begin
      if Length(Args) <> 1 then
        Exit(TValue.CreateBool(False));
      if Args[0].DataType = dtString then
        Payload := RawByteString(Args[0].StrVal)
      else
        Payload := RawByteString(TValueToString(Args[0], False));
      Result := TValue.CreateBool(WSSendTextFrame(ServerConn, Payload));
    end
    else if MethodName = 'sendBytes' then
    begin
      if (Length(Args) <> 1) or (Args[0].DataType <> dtString) then
        Exit(TValue.CreateBool(False));
      Payload := RawByteString(Args[0].StrVal);
      Result := TValue.CreateBool(WSSendBinaryFrame(ServerConn, Payload));
    end
    
    
    
    
    else if MethodName = 'close' then
    begin
      Code := WS_CLOSE_NORMAL;
      if (Length(Args) >= 1) and (Args[0].DataType = dtNumeric) then
        Code := Word(Trunc(Args[0].NumVal));
      WSSendClose(ServerConn, Code, '');
      Result := TValue.CreateBool(True);
    end
    else
      Result := TValue.CreateBool(False);
  finally
    ServerConn.Release;
  end;
end;

function ExecuteNativeTypeMethod(TargetObj: TValue; const MethodName: string; 
  const Args: array of TValue): TValue;
var
  Idx: Integer;
  // ✅ F-1: locals untuk DLL dispatch
  FakeArgs: TObjectList;
  LibTmp: TValue;
  // B.1.4c: event-mode dispatch
  WSIdStr, NBSIdVal: TValue;
begin
  Result := nil;

  case TargetObj.DataType of
    dtArray:
      begin
        Idx := ArrayMethodsRegistry.IndexOf(MethodName);
        if Idx >= 0 then Exit(ArrayMethodsRegistry.Data[Idx](TargetObj, Args))
        else errMSG.callerror(62, 'ExecuteNativeTypeMethod;' + MethodName, errMSG.xrow, errMSG.xcol);
      end;
    dtString:
      begin
        Idx := StringMethodsRegistry.IndexOf(MethodName);
        if Idx >= 0 then Exit(StringMethodsRegistry.Data[Idx](TargetObj, Args))
        else errMSG.callerror(63, 'ExecuteNativeTypeMethod;' + MethodName, errMSG.xrow, errMSG.xcol);
      end;
    dtDict:
      begin
        // B.1.4c: event-mode connection (Int64 ID)
        if TargetObj.DictVal.HasKey('__nbs_id') then
        begin
          NBSIdVal := TargetObj.DictVal.GetValueClone('__nbs_id');
          try
            if Assigned(NBSIdVal) and (NBSIdVal.DataType = dtNumeric) then
            begin
              Result := DispatchNBSConnMethod(
                Int64(Trunc(NBSIdVal.NumVal)), MethodName, Args);
              Exit;
            end;
          finally
            if Assigned(NBSIdVal) then NBSIdVal.Free;
          end;
        end;
        
        // ✅ Phase A: dispatch WebSocket connection method (thread mode)
        if TargetObj.DictVal.HasKey('__ws_id') then
        begin
          // Only route WS-specific methods; fall through for dict methods
          if (MethodName = 'send') or (MethodName = 'sendBytes') or
             (MethodName = 'close') or (MethodName = 'isOpen') or
             (MethodName = 'attempts') or (MethodName = 'protocol') or
             (MethodName = 'state') then          
          begin
            WSIdStr := TargetObj.DictVal.GetValueClone('__ws_id');
            try
              if Assigned(WSIdStr) and (WSIdStr.DataType = dtString) then
              begin
                Result := DispatchWSConnMethod(WSIdStr.StrVal, MethodName, Args);
                Exit;
              end;
            finally
              if Assigned(WSIdStr) then WSIdStr.Free;
            end;
          end;
          // Fall through to DictMethodsRegistry (hasKey, keys, get, etc.)
        end;
        
        // existing:
        Idx := DictMethodsRegistry.IndexOf(MethodName);
        if Idx >= 0 then Exit(DictMethodsRegistry.Data[Idx](TargetObj, Args))
        else errMSG.callerror(66, 'ExecuteNativeTypeMethod;' + MethodName, errMSG.xrow, errMSG.xcol);
      end;

    // ✅ F-1: DLL handle methods
    dtDLLHandle:
      begin
        // ─── isValid() ───
        if MethodName = 'isValid' then
        begin
          if Length(Args) <> 0 then
            errMSG.callerror(144, 'lib.isValid() tidak menerima argumen',
                             errMSG.xrow, errMSG.xcol);
          Exit(TValue.CreateBool(Assigned(TargetObj.DLLVal) and 
                                 (TargetObj.DLLVal.Handle <> NilHandle)));
        end;

        // ─── path() ───
        if MethodName = 'path' then
        begin
          if Length(Args) <> 0 then
            errMSG.callerror(144, 'lib.path() tidak menerima argumen',
                             errMSG.xrow, errMSG.xcol);
          if Assigned(TargetObj.DLLVal) then
            Exit(TValue.CreateStr(TargetObj.DLLVal.Path))
          else
            Exit(TValue.CreateStr(''));
        end;

        // ─── close() — delegate ke fungsi bebas supaya satu jalur ───
        if MethodName = 'close' then
        begin
          if Length(Args) <> 0 then
            errMSG.callerror(144, 'lib.close() tidak menerima argumen',
                             errMSG.xrow, errMSG.xcol);
        
          FakeArgs := TObjectList.Create(False);
          LibTmp := TargetObj.Clone;
          try
            FakeArgs.Add(LibTmp);
            Result := Native_DLL_Close(FakeArgs, nil);
          finally
            LibTmp.Free;
            FakeArgs.Free;
          end;
          Exit;
        end;

        // ─── func(name, sig) — delegate ke Native_DLL_Func ───
        if MethodName = 'func' then
        begin
          if (Length(Args) < 2) or (Length(Args) > 3) then
            errMSG.callerror(140, 'lib.func(name, sig [, structTypes]) butuh 2 atau 3 argumen',
                             errMSG.xrow, errMSG.xcol);
        
          FakeArgs := TObjectList.Create(False);
          LibTmp := TargetObj.Clone;
          try
            FakeArgs.Add(LibTmp);
            FakeArgs.Add(Args[0]);
            FakeArgs.Add(Args[1]);
            if Length(Args) = 3 then
              FakeArgs.Add(Args[2]);    // structTypes
            Result := Native_DLL_Func(FakeArgs, nil);
          finally
            LibTmp.Free;
            FakeArgs.Free;
          end;
          Exit;
        end;

        // ─── symbol(name) — delegate ke Native_DLL_Symbol ───
        if MethodName = 'symbol' then
        begin
          if Length(Args) <> 1 then
            errMSG.callerror(140, 'lib.symbol(name) butuh 1 argumen',
                             errMSG.xrow, errMSG.xcol);

          FakeArgs := TObjectList.Create(False);
          LibTmp := TargetObj.Clone;
          try
            FakeArgs.Add(LibTmp);
            FakeArgs.Add(Args[0]);
            Result := Native_DLL_Symbol(FakeArgs, nil);
          finally
            LibTmp.Free;
            FakeArgs.Free;
          end;
          Exit;
        end;

        errMSG.callerror(144, 'DLL: method tidak dikenal — ' + MethodName,
                         errMSG.xrow, errMSG.xcol);
      end;
  end;

  if Result = nil then 
    Result := TValue.CreateNull; 
end;

// lib.close(lib) → bool
function Native_DLL_Close(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  LibVal: TValue;
  Ctx: TDLLContext;
  CanonicalPath: string;
  Idx: Integer;
  Entry: TDLLRegistryEntry;
  ShouldRelease: Boolean;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtDLLHandle) then
  begin
    errMSG.callerror(139, 'lib.close() butuh 1 argumen dllHandle',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;

  LibVal := TValue(Args[0]);
  Ctx := LibVal.DLLVal;
  if not Assigned(Ctx) then
    Exit(TValue.CreateBool(False));

  if Ctx.Handle = NilHandle then
    Exit(TValue.CreateBool(True));   // sudah closed — idempotent

  CanonicalPath := Ctx.Path;
  Entry := nil;
  ShouldRelease := False;

  if Assigned(GDLLRegistryLock) then
  begin
    GDLLRegistryLock.Acquire;
    try
      Idx := GDLLRegistry.IndexOf(CanonicalPath);
      if Idx >= 0 then
      begin
        Entry := TDLLRegistryEntry(GDLLRegistry.Objects[Idx]);
        Dec(Entry.RefCount);

        if Entry.RefCount <= 0 then
        begin
          // Refcount habis — kita own entry
          GDLLRegistry.Delete(Idx);
          ShouldRelease := True;
        end
        else
          Entry := nil;   // masih dipakai instance lain, jangan free
      end
      else
        ShouldRelease := True;   // tidak di registry (edge case)
    finally
      GDLLRegistryLock.Release;
    end;
  end;

  // ─── Platform-specific release ───
  {$IFDEF WINDOWS}
  if ShouldRelease then
  begin
    try UnloadLibrary(Ctx.Handle); except end;
    InterlockedDecrement(GlobalFFIActiveCount);
  end;
  {$ENDIF}
  {$IFDEF UNIX}
  // ⚠️ Termux/Linux/macOS: JANGAN dlclose.
  // Lihat komentar di TDLLRegistryEntry.Destroy.
  if ShouldRelease then
  begin
    // Hapus dari context registry supaya tidak double-free saat teardown
    if Assigned(GCurrentContext) and Assigned(GCurrentContext.LoadedDLLs) then
      GCurrentContext.LoadedDLLs.Remove(Pointer(Ctx.Handle));
    InterlockedDecrement(GlobalFFIActiveCount);
  end;
  {$ENDIF}

  Ctx.Handle := NilHandle;

  // Free entry (yang akan hapus temp copy)
  if Assigned(Entry) then
    Entry.Free;

  Result := TValue.CreateBool(True);
end;

