    inherited Create;
    IsReferenced := True;
end;

destructor TFunctionNode.Destroy; 
var 
  i: Integer;
begin 
  for i := 0 to High(Params) do
  begin
    if Assigned(Params[i].DefaultExpr) then 
      Params[i].DefaultExpr.Free;
  end;

  if Assigned(Body) then Body.Free; 
  inherited; 
end;

