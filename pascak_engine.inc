{ TConstSet — Hybrid const set O(1)/O(log n) }
constructor TConstSet.Create;
begin
  FList := TStringList.Create;
  FList.Sorted := False;   // Mulai linear
  FUseBinary := False;
end;

destructor TConstSet.Destroy;
begin
  FList.Free;
  inherited;
end;

procedure TConstSet.PromoteToSorted;
begin
  if FUseBinary then Exit;
  FList.Sorted := True;
  FList.Duplicates := dupIgnore;
  FUseBinary := True;
end;

procedure TConstSet.Add(const S: string);
begin
  if FUseBinary then
  begin
    FList.Add(S);   // Otomatis sorted + dup ignore
  end
  else
  begin
    FList.Add(S);
    // Promote ketika sudah > 16 elemen — binary search jadi lebih cepat
    if FList.Count > 16 then
      PromoteToSorted;
  end;
end;

function TConstSet.Contains(const S: string): Boolean;
var
  Idx: Integer;
begin
  if FUseBinary then
    Result := FList.Find(S, Idx)
  else
    Result := FList.IndexOf(S) <> -1;
end;

procedure TConstSet.Clear;
begin
  FList.Clear;
end;

function TConstSet.Count: Integer;
begin
  Result := FList.Count;
end;

constructor TSymbolTable.Create(AParent: TSymbolTable = nil); 
begin 
  FCapacity := 16; 
  SetLength(FBuckets, FCapacity);
  FCount := 0;
  FGeneration := 1;              // ✅ C-3: start di 1, 0 = "belum pernah diisi"
  
  FConsts := TConstSet.Create;
  
  FParent := AParent; 
  if Assigned(FParent) then 
    FParent.Retain; 
    
  FRefCount := 1; 
  FLock := TCriticalSection.Create; 
  FGCState := gcBlack;
  RegisterGC(Self);
end;

destructor TSymbolTable.Destroy; 
begin 
  UnregisterGC(Self);
  
  // ✅ FIX P0.2: Cek dulu apakah sudah di-clear oleh ClearReferences
  //    (GC Zombie mungkin memanggil ClearReferences sebelum Destroy)
  if (FCount > 0) or (Length(FBuckets) > 0) then
    ClearMap;
  
  SetLength(FBuckets, 0);
  FConsts.Free; 
  FLock.Free;
  
  if Assigned(FParent) then 
    FParent.Release; 
    
  inherited; 
end;

procedure TSymbolTable.Resize;
var
  OldBuckets,NewBuckets: array of PHashItem;
  i: Integer;
  Item, NextItem: PHashItem;
  Idx: Cardinal;
  NewCap: Integer; // <-- PERBAIKAN: Gunakan variabel sementara
begin
  OldBuckets := FBuckets;
  NewCap := FCapacity * 2;
  
  // SetLength yang gagal tidak akan mengganggu FCapacity asli
  SetLength(NewBuckets, NewCap);
  
  for i := 0 to High(OldBuckets) do
  begin
    Item := OldBuckets[i];
    while Item <> nil do
    begin
      NextItem := Item^.Next;
      Idx := GlobalHashString(Item^.Key) and (NewCap - 1);
      
      Item^.Next := NewBuckets[Idx];
      NewBuckets[Idx] := Item;
      
      Item := NextItem;
    end;
  end;
  
  FBuckets := NewBuckets; 
  FCapacity := NewCap; // <-- PERBAIKAN: Kapasitas diupdate HANYA setelah alokasi array mutlak berhasil
end;

procedure TSymbolTable.ClearMap;
var
  i: Integer;
  Item, NextItem: PHashItem;
begin
  // ✅ FIX P0.2: Guard jika sudah di-clear
  if (FCount = 0) and (Length(FBuckets) = 0) then Exit;
  
  FLock.Acquire;   // ← Tambahan lock untuk thread safety
  try
    for i := 0 to High(FBuckets) do
    begin
      Item := FBuckets[i];
      FBuckets[i] := nil; 
      
      while Item <> nil do
      begin
        NextItem := Item^.Next;
        if Assigned(Item^.Value) then
        begin
          if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 0 then
          begin
            Item^.Value.Free;
          end else
          begin
            // KOREKSI: Kosongkan string secara manual agar OS Heap tidak bocor
            if Item^.Value.DataType = dtString then
              Item^.Value.FStrVal := '';
          end;
          Item^.Value := nil;
        end;
        Dispose(Item); 
        Item := NextItem;
      end;
    end;
    FCount := 0;
    InterlockedIncrement(FGeneration);
  finally
    FLock.Release;
  end;
end;

procedure TSymbolTable.Mark;
var 
  i: Integer;
  Item: PHashItem;
  Snapshot: array of TValue;
  SnapCount: Integer;
begin
  if FGCState = gcBlack then Exit;
  FGCState := gcBlack;
  
  FLock.Acquire; 
  try
    SetLength(Snapshot, FCount);
    SnapCount := 0;
    for i := 0 to High(FBuckets) do
    begin
      Item := FBuckets[i];
      while Item <> nil do
      begin
        if Assigned(Item^.Value) then
        begin
          Snapshot[SnapCount] := Item^.Value;
          Inc(SnapCount);
        end;
        Item := Item^.Next;
      end;
    end;
  finally
    FLock.Release;
  end;
  
  for i := 0 to SnapCount - 1 do Snapshot[i].Mark;
  SetLength(Snapshot, 0);
  
  if Assigned(FParent) then FParent.Mark;
end;

procedure TSymbolTable.Retain; 
begin 
  InterlockedIncrement(FRefCount);
end;

procedure TSymbolTable.Release;
begin
  if InterlockedDecrement(FRefCount) = 0 then 
    Self.Free;
end;

procedure TSymbolTable.DefineVar(Name: string; Val: TValue; IsConst: Boolean = False);
var 
  Idx: Cardinal;
  Item: PHashItem;
begin
  if not Assigned(Val) then
  begin
    if Assigned(errMSG) then
      errMSG.callerror(4, 'TSymbolTable.DefineVar; Nil value for '+Name, errMSG.xrow, errMSG.xcol);
    Exit;
  end;
  
  FLock.Acquire;
  try 
    Idx := GlobalHashString(Name) and (FCapacity - 1);
    
    Item := FBuckets[Idx];
    while Item <> nil do
    begin
      if Item^.Key = Name then
      begin
        // ✅ FIX P0.6: Free Val DULU, baru throw
        //    Ini mencegah double-free jika caller juga Free Val di except handler
        Val.Free;
        
        if Assigned(errMSG) then
          errMSG.callerror(9, 'TSymbolTable.DefineVar;' + Name, 
                           errMSG.xrow, errMSG.xcol); 
        // callerror akan raise — tidak akan sampai sini
        Exit;
      end;
      Item := Item^.Next;
    end;
    
    New(Item);
    Item^.Key := Name;
    Item^.Value := Val;
    Item^.Next := FBuckets[Idx];
    FBuckets[Idx] := Item;
    Inc(FCount);
    
    if IsConst then FConsts.Add(Name);
    
    if FCount > (FCapacity * 3) div 4 then Resize;
  finally
    FLock.Release; 
  end;
end;

procedure TSymbolTable.DefineOrReplaceVar(Name: string; Val: TValue; IsConst: Boolean = False);
var
  Idx: Cardinal;
  Item: PHashItem;
  OldVal: TValue;
begin
  if not Assigned(Val) then
  begin
    if Assigned(errMSG) then
      errMSG.callerror(4, 'TSymbolTable.DefineOrReplaceVar; Nil for ' + Name,
                       errMSG.xrow, errMSG.xcol);
    Exit;
  end;

  OldVal := nil;

  FLock.Acquire;
  try
    Idx := GlobalHashString(Name) and (FCapacity - 1);
    Item := FBuckets[Idx];

    while Item <> nil do
    begin
      if Item^.Key = Name then
      begin
        // Overwrite existing binding
        OldVal := Item^.Value;
        Item^.Value := Val;
        Break;
      end;
      Item := Item^.Next;
    end;

    if Item = nil then
    begin
      // Fresh entry — sama seperti DefineVar
      New(Item);
      Item^.Key := Name;
      Item^.Value := Val;
      Item^.Next := FBuckets[Idx];
      FBuckets[Idx] := Item;
      Inc(FCount);

      if IsConst then FConsts.Add(Name);

      if FCount > (FCapacity * 3) div 4 then Resize;
    end;
  finally
    FLock.Release;
  end;

  // ✅ S-2 pattern: deferred free di luar lock
  if Assigned(OldVal) then
  begin
    OldVal.Free;
    OldVal := nil;
  end;
end;

procedure TSymbolTable.AssignVar(Name: string; Val: TValue);
var
  Idx: Cardinal;
  Item: PHashItem;
  OldVal: TValue;
  FoundLocal: Boolean;
  ParentRef: TSymbolTable;
begin
  OldVal := nil;
  FoundLocal := False;
  ParentRef := nil;

  FLock.Acquire;
  try
    if FConsts.Contains(Name) then
    begin
      if Assigned(errMSG) then
        errMSG.callerror(10, 'TSymbolTable.AssignVar;'+Name, errMSG.xrow, errMSG.xcol);
      Exit;
    end;

    Idx := GlobalHashString(Name) and (FCapacity - 1);
    Item := FBuckets[Idx];

    while Item <> nil do
    begin
      if Item^.Key = Name then
      begin
        FoundLocal := True;
        if Item^.Value <> Val then
        begin
          OldVal := Item^.Value;
          Item^.Value := Val;   // ← swap atomik di dalam lock
          if FGCState = gcBlack then Val.Mark;
        end;
        Break;
      end;
      Item := Item^.Next;
    end;

    ParentRef := FParent;
    if Assigned(ParentRef) then
      ParentRef.Retain;
  finally
    FLock.Release;
  end;

  // ✅ S-2: Deferred free — di LUAR lock.
  // Race window sudah ditutup karena Item^.Value sudah di-swap
  // ke Val baru DI DALAM lock. Thread lain yang baca akan mendapat
  // Val baru (fresh), bukan OldVal (stale).
  if Assigned(OldVal) then
  begin
    OldVal.Free;
    OldVal := nil;
  end;

  if not FoundLocal then
  begin
    if Assigned(ParentRef) then
    begin
      try
        ParentRef.AssignVar(Name, Val);
      finally
        ParentRef.Release;
      end;
    end
    else
    begin
      Val.Free;
      if Assigned(errMSG) then
        errMSG.callerror(11, 'TSymbolTable.AssignVar;'+Name, errMSG.xrow, errMSG.xcol);
    end;
  end
  else
  begin
    if Assigned(ParentRef) then
      ParentRef.Release;
  end;
end;

function TSymbolTable.GetVar(Name: string): TValue;
var 
  Idx: Cardinal;
  Item: PHashItem;
  FoundVal: TValue;
  ParentRef: TSymbolTable;
begin
  FoundVal := nil;
  ParentRef := nil;
  
  FLock.Acquire;
  try
    Idx := GlobalHashString(Name) and (FCapacity - 1);
    Item := FBuckets[Idx];
    
    while Item <> nil do
    begin
      if (Item^.Key = Name) then
      begin
        if Assigned(Item^.Value) then
          FoundVal := Item^.Value.Clone
        else
          FoundVal := TValue.CreateNull;
        Break;
      end;
      Item := Item^.Next;
    end;
    
    // ✅ FIX P1.7: Snapshot + retain parent di dalam lock
    ParentRef := FParent;
    if Assigned(ParentRef) then
      ParentRef.Retain;
  finally
    FLock.Release; 
  end;
  
  if Assigned(FoundVal) then 
  begin
    if Assigned(ParentRef) then ParentRef.Release;
    Exit(FoundVal);
  end;
  
  if Assigned(ParentRef) then 
  begin
    try
      Result := ParentRef.GetVar(Name);
    finally
      ParentRef.Release;
    end;
  end
  else 
  begin
    if Assigned(errMSG) then
      errMSG.callerror(11, 'TSymbolTable.GetVar;'+ Name, errMSG.xrow, errMSG.xcol);
    Result := nil;
  end;
end;

function TSymbolTable.GetGlobal: TSymbolTable;
var
  P: TSymbolTable;
begin
  P := Self;
  while (P <> nil) and (P.FParent <> nil) do
    P := P.FParent;
  Result := P;
end;

function TSymbolTable.HasVar(Name: string): Boolean;
var
  Idx: Cardinal;
  Item: PHashItem;
  ParentRef: TSymbolTable;
begin
  Result := False;
  ParentRef := nil;
  
  FLock.Acquire; 
  try
    Idx := GlobalHashString(Name) and (FCapacity - 1);
    Item := FBuckets[Idx];
    
    while Item <> nil do
    begin
      if Item^.Key = Name then 
      begin
        Result := True;
        Exit;   // FLock akan di-release oleh finally
      end;
      Item := Item^.Next;
    end;
    
    ParentRef := FParent;
    if Assigned(ParentRef) then ParentRef.Retain;
  finally
    FLock.Release;
  end;
  
  if Assigned(ParentRef) then 
  begin
    try
      Result := ParentRef.HasVar(Name);
    finally
      ParentRef.Release;
    end;
  end;
end;

function TSymbolTable.GetExportedDict: TDictValue;
var
  i: Integer;
  Item: PHashItem;
  ResultDict: TDictValue;
begin
  ResultDict := TDictValue.Create;
  
  FLock.Acquire;
  try
    try
      for i := 0 to High(FBuckets) do
      begin
        Item := FBuckets[i];
        while Item <> nil do
        begin
          // Salin semua variabel dan fungsi, KECUALI variabel built-in VM
          if (Length(Item^.Key) > 0) and (Item^.Key[1] <> '#') then
          begin
            if Assigned(Item^.Value) then
              ResultDict.SetValue(Item^.Key, Item^.Value.Clone);
          end;
          Item := Item^.Next;
        end;
      end;
    except
      // PROTEKSI MEMORI MUTLAK: Bersihkan instance dan seluruh hashmap internalnya jika gagal!
      ResultDict.Free; 
      raise;
    end;
  finally
    FLock.Release;
  end;
  
  Result := ResultDict;
end;

procedure TSymbolTable.ClearReferences;
begin
  FLock.Acquire;
  try ClearMap; finally FLock.Release; end;
end;

function TSymbolTable.AtomicAddNumeric(const Name: string; Delta: Double): Boolean;
var
  Idx: Cardinal;
  Item: PHashItem;
  ParentRef: TSymbolTable;
  NewVal: TValue;
begin
  Result := False;
  ParentRef := nil;
  
  FLock.Acquire;
  try
    if FConsts.Contains(Name) then Exit; // const — bail
    
    Idx := GlobalHashString(Name) and (FCapacity - 1);
    Item := FBuckets[Idx];
    
    while Item <> nil do
    begin
      if Item^.Key = Name then
      begin
        if Assigned(Item^.Value) and (Item^.Value.DataType = dtNumeric) then
        begin
          // ✅ FAST PATH: mutasi FNumVal langsung. Karena kita di dalam FLock,
          // ini serialized terhadap AtomicAddNumeric lain → benar-benar atomic.
          Item^.Value.FNumVal := Item^.Value.FNumVal + Delta;
          Result := True;
          Exit;
        end
        else if (not Assigned(Item^.Value)) or (Item^.Value.DataType = dtNull) then
        begin
          // Null → coerce to numeric
          NewVal := TValue.CreateNum(Delta);
          if Assigned(Item^.Value) then Item^.Value.Free;
          Item^.Value := NewVal;
          Result := True;
          Exit;
        end
        else
        begin
          // Non-numeric — bail, caller falls back ke Helper_MergeStrings dll.
          Exit;
        end;
      end;
      Item := Item^.Next;
    end;
    
    // Not found locally — walk to parent
    ParentRef := FParent;
    if Assigned(ParentRef) then ParentRef.Retain;
  finally
    FLock.Release;
  end;
  
  if Assigned(ParentRef) then
  begin
    try
      Result := ParentRef.AtomicAddNumeric(Name, Delta);
    finally
      ParentRef.Release;
    end;
  end;
end;

function TSymbolTable.GetVariableNames(IncludeInternal: Boolean = False): TStringArray;
var
  i, Count: Integer;
  Item: PHashItem;
begin
  Result := nil;
  FLock.Acquire;
  try
    SetLength(Result, FCount);
    Count := 0;
    for i := 0 to High(FBuckets) do
    begin
      Item := FBuckets[i];
      while Item <> nil do
      begin
        if IncludeInternal or 
           (Length(Item^.Key) = 0) or (Item^.Key[1] <> '#') then
        begin
          Result[Count] := Item^.Key;
          Inc(Count);
        end;
        Item := Item^.Next;
      end;
    end;
    SetLength(Result, Count);
  finally
    FLock.Release;
  end;
end;

function TSymbolTable.FindLocalEntry(const Name: string; ForWrite: Boolean = False): PHashItem;
var
  Idx: Cardinal;
  Item: PHashItem;
begin
  Result := nil;
  FLock.Acquire;
  try
    // PERBAIKAN: jika ForWrite dan entry adalah const, return nil
    if ForWrite and FConsts.Contains(Name) then Exit;
    
    Idx := GlobalHashString(Name) and (FCapacity - 1);
    Item := FBuckets[Idx];
    
    while Item <> nil do
    begin
      if Item^.Key = Name then
      begin
        Result := Item;
        Exit;
      end;
      Item := Item^.Next;
    end;
  finally
    FLock.Release;
  end;
end;

constructor TBlockNode.Create(AIsScope: Boolean = True); 
begin 
    Statements := TObjectList.Create(True); 
    IsScope := AIsScope; // <-- SEKARANG COMPILER AKAN MENGENALI INI
end;

destructor TBlockNode.Destroy; 
begin 
    Statements.Free; inherited; 
end;

constructor TCSEOptimizer.Create;
begin
  FExprCache := TCSECacheMap.Create;
  FVarDeps := TVarDependencyMap.Create;
  FTempCount := 0;
end;

destructor TCSEOptimizer.Destroy;
var
  i: Integer;
begin
  FExprCache.Free;
  for i := 0 to FVarDeps.Count - 1 do
    FVarDeps.Data[i].Free; // Bersihkan TStringList internal
  FVarDeps.Free;
  inherited;
end;

function TCSEOptimizer.HashPureExpression(Node: TNode; DepVars: TStringList): string;
var
  HashL, HashR: string;
begin
  Result := '';
  if Node = nil then Exit;
  
  if Node is TVariableNode then 
  begin
    Result := 'VAR:' + TVariableNode(Node).VarName;
    if DepVars.IndexOf(TVariableNode(Node).VarName) = -1 then
      DepVars.Add(TVariableNode(Node).VarName);
  end else 
  if Node is TLiteralNode then
  begin
    case TLiteralNode(Node).Val.DataType of
      dtNumeric: Result := 'NUM:' + FloatToStr(TLiteralNode(Node).Val.NumVal, FS); 
      dtString:  Result := 'STR:' + TLiteralNode(Node).Val.StrVal;
      dtBoolean: if TLiteralNode(Node).Val.BoolVal then Result := 'BOOL:T' else Result := 'BOOL:F';
      dtNull:    Result := 'NULL:0';
      else       Result := 'UNK:?';
    end;
  end else 
  if Node is TUnaryOpNode then
  begin
    Result := 'UNARY:' + TUnaryOpNode(Node).Op + '(' + HashPureExpression(TUnaryOpNode(Node).Expr, DepVars) + ')';
  end else 
  if Node is TBinaryOpNode then
  begin
    HashL := HashPureExpression(TBinaryOpNode(Node).Left, DepVars);
    HashR := HashPureExpression(TBinaryOpNode(Node).Right, DepVars);
    
    // Pertahankan opAdd di luar blok komutatif demi mengamankan konkatenasi String.
    if TBinaryOpNode(Node).Op in [opMul, opEq, opNotEq] then
    begin
      // Pengurutan komutatif untuk ekspresi murni O(1)
      if CompareStr(HashL, HashR) > 0 then
        Result := '(' + HashR + '|' + IntToStr(Integer(TBinaryOpNode(Node).Op)) + '|' + HashL + ')'
      else
        Result := '(' + HashL + '|' + IntToStr(Integer(TBinaryOpNode(Node).Op)) + '|' + HashR + ')';
    end else
    begin
      // Mode Kaku (Kiri ke Kanan mutlak)
      Result := '(' + HashL + '|' + IntToStr(Integer(TBinaryOpNode(Node).Op)) + '|' + HashR + ')';
    end;
  end;
end;

procedure TCSEOptimizer.RegisterDependencies(const HashStr: string; DepVars: TStringList);
var
  i, Idx: Integer;
  List: TStringList;
begin
  for i := 0 to DepVars.Count - 1 do
  begin
    Idx := FVarDeps.IndexOf(DepVars[i]);
    if Idx = -1 then
    begin
      List := TStringList.Create;
      FVarDeps.Add(DepVars[i], List);
    end
    else
      List := FVarDeps.Data[Idx];
      
    if List.IndexOf(HashStr) = -1 then
      List.Add(HashStr);
  end;
end;

procedure TCSEOptimizer.InvalidateCache(const VarName: string);
var
  Idx, CacheIdx, i: Integer;
  List: TStringList;
begin
  Idx := FVarDeps.IndexOf(VarName);
  if Idx <> -1 then
  begin
    List := FVarDeps.Data[Idx];
    for i := 0 to List.Count - 1 do
    begin
      // PERBAIKAN LOGIKA: Gunakan IndexOf dan Delete untuk menjamin kompatibilitas FGL
      CacheIdx := FExprCache.IndexOf(List[i]);
      if CacheIdx <> -1 then 
        FExprCache.Delete(CacheIdx);
    end;
    List.Clear; 
  end;
end;

function TCSEOptimizer.IsPure(Node: TNode): Boolean;
begin
  if (Node is TVariableNode) or (Node is TLiteralNode) then Result := True
  else if Node is TUnaryOpNode then 
    Result := IsPure(TUnaryOpNode(Node).Expr)
  else if Node is TBinaryOpNode then
    Result := IsPure(TBinaryOpNode(Node).Left) and IsPure(TBinaryOpNode(Node).Right)
  else
    Result := False; 
end;

function TCSEOptimizer.HasSideEffect(Node: TNode): Boolean;
var i: Integer;
begin
  Result := False;
  if Node = nil then Exit;

  // PERBAIKAN: Penambahan (Node is TReturnNode) untuk mencegah optimasi ilegal setelah Return
  if (Node is TArrayAssignNode)  or (Node is TMemberAssignNode) or 
     (Node is TLockNode)         or (Node is TYieldNode) or 
     (Node is TNewNode)          or (Node is TListComprehensionNode) or 
     (Node is TWhileNode)        or (Node is TForNode) or
     (Node is TForEachNode)      or (Node is TRepeatNode) or
     (Node is TMethodCallNode)   or (Node is TIfNode) or 
     (Node is TTryCatchNode)     or (Node is TCaseNode) or 
     (Node is TDeferNode)        or (Node is TReturnNode) then Exit(True); 
     
  // Evaluasi side-effect berdasarkan ekspresi (RHS)
  if Node is TAssignmentNode then Exit(HasSideEffect(TAssignmentNode(Node).Expr));
  if Node is TMultiAssignNode then Exit(HasSideEffect(TMultiAssignNode(Node).Expr));
  if Node is TVarDeclNode then Exit(HasSideEffect(TVarDeclNode(Node).Expr));

  if Node is TBinaryOpNode then 
    Result := HasSideEffect(TBinaryOpNode(Node).Left) or HasSideEffect(TBinaryOpNode(Node).Right)
  else if Node is TUnaryOpNode then 
    Result := HasSideEffect(TUnaryOpNode(Node).Expr)
  else if Node is TFunctionCallNode then
  begin
    for i := 0 to TFunctionCallNode(Node).Args.Count - 1 do
      if HasSideEffect(TNode(TFunctionCallNode(Node).Args[i])) then Exit(True);
    Result := True; 
  end
  else if Node is TBlockNode then
  begin
    for i := 0 to TBlockNode(Node).Statements.Count - 1 do
      if HasSideEffect(TNode(TBlockNode(Node).Statements[i])) then Exit(True);
  end;
end;

procedure TCSEOptimizer.CountExpressions(Block: TBlockNode; var Counts: TStringList);
var
  i: Integer;
  Node: TNode;
  HashStr: string;
  DepVars: TStringList;
begin
  if Block = nil then Exit;
  for i := 0 to Block.Statements.Count - 1 do
  begin
    Node := TNode(Block.Statements[i]);
    if (Node is TAssignmentNode) 
       and IsPure(TAssignmentNode(Node).Expr)
       and (TAssignmentNode(Node).Expr is TBinaryOpNode) then
    begin
      DepVars := TStringList.Create;
      try
        HashStr := HashPureExpression(TAssignmentNode(Node).Expr, DepVars);
        Counts.Values[HashStr] := 
          IntToStr(StrToIntDef(Counts.Values[HashStr], 0) + 1);
      finally
        DepVars.Free;
      end;
    end;
  end;
end;

procedure TCSEOptimizer.OptimizeBlock(Block: TBlockNode);
var
  i, CacheIdx: Integer;
  Node, RHS: TNode;
  HashStr, TempName: string;
  DeclNode: TVarDeclNode;
  DepVars: TStringList;
  HashCounts: TStringList;   // ✅ TAHAP B — B-1
  HashFreq: Integer;         // ✅ TAHAP B — B-1
begin
  if Block = nil then Exit;

  // ✅ TAHAP B — B-1: Pre-count frekuensi ekspresi di block ini
  HashCounts := TStringList.Create;
  try
    CountExpressions(Block, HashCounts);

    i := 0;
    while i < Block.Statements.Count do
    begin
      Node := TNode(Block.Statements[i]);
      
      if HasSideEffect(Node) then
      begin
        FExprCache.Clear; 
        for CacheIdx := 0 to FVarDeps.Count - 1 do
          FVarDeps.Data[CacheIdx].Free;
        FVarDeps.Clear;
      end;

      // --- 2. INVALIDASI TARGET LOKAL (LHS) ---
      // (Aman dipanggil meski Cache baru saja di-clear, karena InvalidateCache tidak akan menemukan apa-apa)
      if Node is TAssignmentNode then
        InvalidateCache(TAssignmentNode(Node).TargetName)
      else if Node is TVarDeclNode then
        InvalidateCache(TVarDeclNode(Node).VarName)
      else if Node is TMultiAssignNode then
      begin
        for CacheIdx := 0 to TMultiAssignNode(Node).Targets.Count - 1 do
          InvalidateCache(TMultiAssignNode(Node).Targets[CacheIdx]);
      end;

      // --- 3. SUBSTITUSI EKSPRESI (Mencegah Eksekusi Ulang Kode) ---
      if Node is TAssignmentNode then
      begin
        RHS := TAssignmentNode(Node).Expr;
        if IsPure(RHS) and (RHS is TBinaryOpNode) then
        begin
          DepVars := TStringList.Create;
          try
            HashStr := HashPureExpression(RHS, DepVars);
            
            // ✅ TAHAP B — B-1: Hanya promote jika ekspresi muncul ≥ 2×
            HashFreq := StrToIntDef(HashCounts.Values[HashStr], 0);
            
            if HashFreq >= 2 then
            begin
              CacheIdx := FExprCache.IndexOf(HashStr);
              
              if CacheIdx <> -1 then
              begin
                // CACHE HIT
                TempName := FExprCache.Data[CacheIdx];
                TAssignmentNode(Node).Expr := TVariableNode.Create(TempName);
                RHS.Free;
              end
              else
              begin
                // CACHE MISS
                Inc(FTempCount);
                TempName := '#cse_' + IntToStr(FTempCount);
                
                DeclNode := TVarDeclNode.Create(TempName, RHS, True);
                Block.Statements.Insert(i, DeclNode); 
                
                Inc(i); 
                Node := TNode(Block.Statements[i]);
                
                TAssignmentNode(Node).Expr := TVariableNode.Create(TempName);
                
                FExprCache.Add(HashStr, TempName);
                RegisterDependencies(HashStr, DepVars);
              end;
            end;
            // else: skip — biarkan ekspresi apa adanya
          finally
            DepVars.Free;
          end;
        end;
      end;
      
      // 4. TRAVERSAL REKURSIF MENDALAM
      if Node is TBlockNode then OptimizeBlock(TBlockNode(Node));
      if Node is TIfNode then
      begin
        if TIfNode(Node).ThenBranch is TBlockNode then OptimizeBlock(TBlockNode(TIfNode(Node).ThenBranch));
        if TIfNode(Node).ElseBranch is TBlockNode then OptimizeBlock(TBlockNode(TIfNode(Node).ElseBranch));
      end;
      
      if Node is TWhileNode then
        if TWhileNode(Node).Body is TBlockNode then OptimizeBlock(TBlockNode(TWhileNode(Node).Body));
      if Node is TForNode then
        if TForNode(Node).Body is TBlockNode then OptimizeBlock(TBlockNode(TForNode(Node).Body));
      if Node is TForEachNode then
        if TForEachNode(Node).Body is TBlockNode then OptimizeBlock(TBlockNode(TForEachNode(Node).Body));
      if Node is TRepeatNode then
        if TRepeatNode(Node).Body is TBlockNode then OptimizeBlock(TBlockNode(TRepeatNode(Node).Body));
      if Node is TCaseNode then
      begin
        for CacheIdx := 0 to High(TCaseNode(Node).Branches) do
          if TCaseNode(Node).Branches[CacheIdx].Body is TBlockNode then 
            OptimizeBlock(TBlockNode(TCaseNode(Node).Branches[CacheIdx].Body));
        if TCaseNode(Node).ElseBranch is TBlockNode then 
          OptimizeBlock(TBlockNode(TCaseNode(Node).ElseBranch));
      end;
      if Node is TTryCatchNode then
      begin
        if TTryCatchNode(Node).TryBlock is TBlockNode then OptimizeBlock(TBlockNode(TTryCatchNode(Node).TryBlock));
        if TTryCatchNode(Node).CatchBlock is TBlockNode then OptimizeBlock(TBlockNode(TTryCatchNode(Node).CatchBlock));
        if TTryCatchNode(Node).FinallyBlock is TBlockNode then OptimizeBlock(TBlockNode(TTryCatchNode(Node).FinallyBlock));
      end;
      if Node is TLockNode then
        if TLockNode(Node).Body is TBlockNode then OptimizeBlock(TBlockNode(TLockNode(Node).Body));
  
      Inc(i);
    end;
  finally
    HashCounts.free;
  end;
end;

constructor TLiteralNode.Create(AVal: TValue); 
begin 
    Val := AVal; 
end;

destructor TLiteralNode.Destroy; 
begin 
    Val.Free; inherited; 
end;

constructor TVariableNode.Create(AName: string); 
