function Native_FS_ReadAsync(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SafePath: string;
  Callback: TValue;
  Task: TFSAsyncTask;
  Ctx: TEngineContext;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtString) then
    raise EScriptRuntimeError.Create(
      'fs.readAsync(path, [callback]) butuh 1-2 argumen');

  try
    SafePath := GetSafeSandboxedPath(TValue(Args[0]).StrVal);
  except
    on E: Exception do
      raise EScriptRuntimeError.Create('fs.readAsync: ' + E.Message);
  end;

  Callback := nil;
  if Args.Count >= 2 then
    if TValue(Args[1]).DataType = dtFunction then
      Callback := TValue(Args[1]);

  Ctx := GetContextFromEnv(CallEnv);
  InitFSAsyncTasks;

  Task := TFSAsyncTask.Create;
  Task.ID := InterlockedIncrement(GFSAsyncTaskCounter);
  Task.Kind := FSASYNC_READ;
  Task.SafePath := SafePath;
  Task.Data := '';
  Task.State := EXEC_TASK_PENDING;
  Task.CallbackFired := 0;
  Task.ResultVal := nil;
  Task.Worker := nil;
  if Assigned(Callback) then Task.Callback := Callback.Clone
  else Task.Callback := nil;
  if Assigned(Ctx) then
  begin Ctx.Retain; Task.OwnerContext := Ctx; end
  else Task.OwnerContext := nil;

  Task.Worker := TFSAsyncWorkerThread.Create(Task);
  RegisterFSAsyncTask(Task);
  Task.Worker.Start;

  Result := TValue.CreateNum(Task.ID);
end;

