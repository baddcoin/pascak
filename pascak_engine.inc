constructor TTypeDefinition.Create(AName: string; AKind: TTypeKind); 
begin 
    Name := AName; 
    Kind := AKind; 
    Methods := TMethodMap.Create; 
    Fields := TStringList.Create; 
end;

destructor TTypeDefinition.Destroy; 
var
  i: Integer;
begin 
  if Assigned(Methods) then
  begin
    for i := 0 to Methods.Count - 1 do
    begin
      if Assigned(Methods.Data[i]) then
        Methods.Data[i].Release;
    end;
    Methods.Clear; // WAJIB clear sebelum Free untuk memutus dangling pointer internal fgl
    Methods.Free; 
  end;
  
  if Assigned(Fields) then Fields.Free; 
  inherited; 
end;

procedure TTypeDefinition.Retain; 
begin 
  InterlockedIncrement(FRefCount); // BENAR: Atomik dan Thread-Safe
end;

procedure TTypeDefinition.Release;
begin
  if InterlockedDecrement(FRefCount) = 0 then 
    Self.Free;
end;

constructor TDLLContext.Create(AHandle: TLibHandle; const APath: string);
begin
  inherited Create;
  FRefCount := 1;
  Handle := AHandle;
  Path := APath;
  LoadedAt := GetTickCount64;
end;

destructor TDLLContext.Destroy;
begin
  // ✅ F-2a: TempPath cleanup DIPINDAH ke TDLLRegistryEntry.
  // TDLLContext sekarang hanya memegang referensi.
  // Menghapus di sini akan menyebabkan double-delete kalau
  // library di-share antar instance TValue.
  inherited;
end;

procedure TDLLContext.Retain;
begin
  InterlockedIncrement(FRefCount);
end;

procedure TDLLContext.Release;
begin
  if InterlockedDecrement(FRefCount) = 0 then
    Self.Free;
end;

constructor TDLLRegistryEntry.Create(AHandle: TLibHandle;
  const APath, ATempPath: string);
begin
  inherited Create;
  Handle := AHandle;
  CanonicalPath := APath;
  TempCopyPath := ATempPath;
  RefCount := 1;
  LoadedAt := GetTickCount64;
end;

destructor TDLLRegistryEntry.Destroy;
begin
  // Hapus temp copy — ini satu-satunya tempat cleanup temp copy terjadi
  if (TempCopyPath <> '') and FileExists(TempCopyPath) then
  begin
    try DeleteFile(TempCopyPath); except end;
  end;
  // ⚠️ JANGAN UnloadLibrary di sini.
  // Di Termux/Android dlclose tidak reliable (linker namespace issue),
  // dan di Linux/macOS pun race-prone kalau ada TTLSConnection / callback
  // yang masih mereferensi symbol. Biarkan OS reclaim saat proses exit.
  // Konsisten dengan Node.js, Python ctypes, Go c-shared.
  inherited;
end;

destructor TCallbackContext.Destroy;
begin
  if Assigned(ClosurePtr) and Assigned(fp_ffi_closure_free) then
  begin
    try fp_ffi_closure_free(ClosurePtr); except end;
    ClosurePtr := nil;
    CodePtr := nil;
  end;
  
  if Assigned(CifPtr) then
  begin
    FreeMem(CifPtr);
    CifPtr := nil;
  end;
  
  // ✅ F-3a-4: free string buffer
  if Assigned(StringBuf) then
  begin
    FreeMem(StringBuf);
    StringBuf := nil;
    StringBufSize := 0;
  end;
  
  SetLength(ArgTypes, 0);
  SetLength(ArgKinds, 0);
  
  if Assigned(VMFunc) then
  begin
    VMFunc.Free;
    VMFunc := nil;
  end;
  
  if Assigned(OwnerContext) then
  begin
    OwnerContext.Release;
    OwnerContext := nil;
  end;
  
  inherited;
end;

