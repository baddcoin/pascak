    raise EScriptRuntimeError.Create('fs.pollAsync(taskID) butuh 1 argumen numerik');

  Task := FindFSAsyncTask(Trunc(TValue(Args[0]).NumVal));
  if not Assigned(Task) then Exit(TValue.CreateNull);
  if InterlockedCompareExchange(Task.State, 0, 0) <> EXEC_TASK_DONE then
