function ObfuscateString(const S: string; const Key: string = ''): string;
var
  EffectiveKey: string;
  KeyHash, IV: Cardinal;
  i, KeyLen: Integer;
  B, KeyByte: Byte;
begin
  if S = '' then
  begin
    Result := '';
    Exit;
  end;
  
  // Pilih key
  if Key <> '' then
    EffectiveKey := Key
  else
    EffectiveKey := BytecodeObfuscationKey;
  
  KeyLen := Length(EffectiveKey);
  if KeyLen = 0 then
    EffectiveKey := 'default';
    KeyLen := Length(EffectiveKey);
  
  // Derive key hash (FNV-1a) + IV unik per string
  KeyHash := 2166136261;
  for i := 1 to KeyLen do
    KeyHash := (KeyHash xor Cardinal(Ord(EffectiveKey[i]))) * Cardinal(16777619);
  
  IV := KeyHash;
  // IV berdasarkan panjang string + counter, agar string yang sama tidak
  // menghasilkan cipher yang sama (untuk pattern analysis resistance)
  IV := IV xor Cardinal(Length(S) * 2654435761);
  IV := IV xor Cardinal(AES_IVCounter);
  Inc(AES_IVCounter);
  
  // Encrypt dengan XOR stream cipher sederhana
  SetLength(Result, Length(S) + 8);   // 8 bytes untuk IV header
  
  // Tulis IV di 4 bytes pertama (little-endian)
  Result[1] := Char(IV and $FF);
  Result[2] := Char((IV shr 8) and $FF);
  Result[3] := Char((IV shr 16) and $FF);
  Result[4] := Char((IV shr 24) and $FF);
  
  // Counter initialization untuk stream
  KeyHash := IV;
  
  // Encrypt body
  for i := 1 to Length(S) do
  begin
    // Update stream key (LCG-based)
    KeyHash := KeyHash * 1664525 + 1013904223;
    
    // Mix dengan key material
    B := Ord(S[i]);
    KeyByte := Byte((KeyHash shr 16) xor 
                    (KeyHash shr 8) xor 
                    KeyHash xor
                    Ord(EffectiveKey[((i - 1) mod KeyLen) + 1]));
    B := B xor KeyByte;
    
    Result[i + 4] := Char(B);
  end;
  
  // Checksum 4 bytes terakhir (anti-tamper sederhana)
  KeyHash := 2166136261;
  for i := 1 to Length(Result) - 4 do
    KeyHash := (KeyHash xor Cardinal(Ord(Result[i]))) * Cardinal(16777619);
    
  Result[Length(Result) - 3] := Char(KeyHash and $FF);
  Result[Length(Result) - 2] := Char((KeyHash shr 8) and $FF);
  Result[Length(Result) - 1] := Char((KeyHash shr 16) and $FF);
  Result[Length(Result)]     := Char((KeyHash shr 24) and $FF);
end;

function DeobfuscateString(const S: string; const Key: string = ''): string;
var
  EffectiveKey: string;
  KeyHash, IV, StoredChecksum, ComputedChecksum: Cardinal;
  i, KeyLen, BodyLen: Integer;
  B, KeyByte: Byte;
begin
  Result := '';
  
  // Minimal 8 bytes (4 IV + 4 checksum)
  if Length(S) < 8 then Exit;
  
  // Pilih key
  if Key <> '' then
    EffectiveKey := Key
  else
    EffectiveKey := BytecodeObfuscationKey;
  
  KeyLen := Length(EffectiveKey);
  if KeyLen = 0 then
  begin
    EffectiveKey := 'default';
    KeyLen := Length(EffectiveKey);
  end;
  
  // Baca IV dari 4 byte pertama
  IV := Cardinal(Ord(S[1])) or
        (Cardinal(Ord(S[2])) shl 8) or
        (Cardinal(Ord(S[3])) shl 16) or
        (Cardinal(Ord(S[4])) shl 24);
  
  // Baca stored checksum dari 4 byte terakhir
  StoredChecksum := Cardinal(Ord(S[Length(S) - 3])) or
                    (Cardinal(Ord(S[Length(S) - 2])) shl 8) or
                    (Cardinal(Ord(S[Length(S) - 1])) shl 16) or
                    (Cardinal(Ord(S[Length(S)])) shl 24);
  
  // Verify checksum sebelum decrypt
  ComputedChecksum := 2166136261;
  for i := 1 to Length(S) - 4 do
    ComputedChecksum := (ComputedChecksum xor Cardinal(Ord(S[i]))) * Cardinal(16777619);
  
  if StoredChecksum <> ComputedChecksum then
  begin
    // Checksum mismatch — return empty (tampered atau corrupt)
    Exit;
  end;
  
  // Body length = total - 4 (IV) - 4 (checksum)
  BodyLen := Length(S) - 8;
  if BodyLen <= 0 then Exit;
  
  SetLength(Result, BodyLen);
  
  // Init stream counter
  KeyHash := IV;
  
  // Decrypt body
  for i := 1 to BodyLen do
  begin
    // Update stream key
    KeyHash := KeyHash * 1664525 + 1013904223;
    
    // Mix dengan key material
    KeyByte := Byte((KeyHash shr 16) xor 
                    (KeyHash shr 8) xor 
                    KeyHash xor
                    Ord(EffectiveKey[((i - 1) mod KeyLen) + 1]));
    
    B := Ord(S[i + 4]) xor KeyByte;
    Result[i] := Char(B);
  end;
end;

function GetContextFromEnv(Env: TSymbolTable): TEngineContext;
var
  Root: TSymbolTable;
begin
  Result := nil;
  if not Assigned(Env) then Exit;
  
  Root := Env.GetGlobal;
  if Assigned(Root) then
    Result := Root.Context;
  
  // Fallback ke threadvar jika root tidak punya context
  if Result = nil then
    Result := GCurrentContext;
end;

