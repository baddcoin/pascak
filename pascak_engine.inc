procedure InitBuiltInRegistries;
begin
  ArrayMethodsRegistry  := TBuiltInMethodMap.Create;
  StringMethodsRegistry := TBuiltInMethodMap.Create;
  DictMethodsRegistry   := TBuiltInMethodMap.Create;

  // Set agar case-sensitive (pencarian hash map lebih cepat logaritmis)
  ArrayMethodsRegistry.Sorted := True;
  StringMethodsRegistry.Sorted := True;
  DictMethodsRegistry.Sorted := True;

  // Daftarkan Array Methods
  ArrayMethodsRegistry.Add('push', @BuiltIn_Array_Push);
  ArrayMethodsRegistry.Add('pop', @BuiltIn_Array_Pop);
  ArrayMethodsRegistry.Add('sort', @BuiltIn_Array_Sort);
  ArrayMethodsRegistry.Add('clear', @BuiltIn_Array_Clear);
  ArrayMethodsRegistry.Add('reverse', @BuiltIn_Array_Reverse);
  ArrayMethodsRegistry.Add('join', @BuiltIn_Array_Join);
  ArrayMethodsRegistry.Add('indexOf', @BuiltIn_Array_IndexOf);
  ArrayMethodsRegistry.Add('map', @BuiltIn_Array_Map);
  ArrayMethodsRegistry.Add('filter', @BuiltIn_Array_Filter);
  ArrayMethodsRegistry.Add('reduce', @BuiltIn_Array_Reduce);

  // Daftarkan String Methods
  StringMethodsRegistry.Add('upper', @BuiltIn_String_Upper);
  StringMethodsRegistry.Add('lower', @BuiltIn_String_Lower);
  StringMethodsRegistry.Add('trim', @BuiltIn_String_Trim);
  StringMethodsRegistry.Add('replace', @BuiltIn_String_Replace);
  StringMethodsRegistry.Add('indexOf', @BuiltIn_String_IndexOf);
  StringMethodsRegistry.Add('split', @BuiltIn_String_Split);
  StringMethodsRegistry.Add('startsWith', @BuiltIn_String_StartsWith);
  StringMethodsRegistry.Add('endsWith', @BuiltIn_String_EndsWith);

  // Daftarkan Dictionary Methods
  DictMethodsRegistry.Add('keys', @BuiltIn_Dict_Keys);
  DictMethodsRegistry.Add('values', @BuiltIn_Dict_Values);
  DictMethodsRegistry.Add('clear', @BuiltIn_Dict_Clear);
  DictMethodsRegistry.Add('hasKey', @BuiltIn_Dict_HasKey);
  DictMethodsRegistry.Add('remove', @BuiltIn_Dict_Remove);
  DictMethodsRegistry.Add('update', @BuiltIn_Dict_Update);

end;
