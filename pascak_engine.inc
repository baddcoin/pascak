//========================
function Native_FileWriteRecord(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SafePath: string;
  JData: TJSONData;
  SL: TStringList;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtString) then 
    raise EScriptRuntimeError.Create('fileWriteRecord(path, dataObject) membutuhkan 2 argumen');
    
  SafePath := GetSafeSandboxedPath(TValue(Args[0]).StrVal);
  JData := ConvertTValueToJSON(TValue(Args[1]));
  SL := TStringList.Create;
  
  try
    try
      if Assigned(JData) then
        SL.Text := JData.FormatJSON
      else
        SL.Text := 'null'; 
        
      SL.SaveToFile(SafePath);
      Result := TValue.CreateBool(True);
    except
      on E: EScriptRuntimeError do raise; // <-- PERBAIKAN
      on E: Exception do raise EScriptRuntimeError.Create('IO Error saat menulis data record: ' + E.Message);
    end;
  finally
    if Assigned(JData) then JData.Free; 
    SL.Free;
  end;
end;

function Native_FileReadRecord(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SafePath, JsonText: string;
  SL: TStringList;
  JData: TJSONData;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then 
    raise EScriptRuntimeError.Create('fileReadRecord(path) membutuhkan 1 argumen');
    
  SafePath := GetSafeSandboxedPath(TValue(Args[0]).StrVal);
  if not SysUtils.FileExists(SafePath) then Exit(TValue.CreateNull);

  SL := TStringList.Create;
  try
    try
      SL.LoadFromFile(SafePath);
      JsonText := SL.Text;
    except
      on E: EScriptRuntimeError do raise; // <-- PERBAIKAN
      on E: Exception do raise EScriptRuntimeError.Create('IO Error saat membaca data record: ' + E.Message);
    end;
  finally
    SL.Free;
  end;

  try
    JData := GetJSON(JsonText);
    if not Assigned(JData) then Exit(TValue.CreateNull); 
    
    try
      Result := ConvertJSONToTValue(JData, 0);
    finally
      JData.Free;
    end;
  except
    on E: EScriptRuntimeError do raise; // <-- PERBAIKAN
    on E: Exception do
      raise EScriptRuntimeError.Create('Format Record Corrupt (Bukan struktur data valid): ' + E.Message);
  end;
end;

//thread==================
//========================
constructor TScriptThread.Create(AFunc: TValue; AArgs: TValue;
  ABaseEnv: TSymbolTable; AContext: TEngineContext = nil;
  const AScriptFileName: string = '');  
begin
  FFuncVal := nil;
  FArgsVal := nil;
  FThreadEnv := nil;
  FOwnerContext := nil;

  inherited Create(True);
  FreeOnTerminate := False;

  // Registrasi thread ke global list untuk join di akhir program
  if not Assigned(ScriptThreadList) then
  begin
    if not Assigned(ScriptThreadLock) then
      ScriptThreadLock := TCriticalSection.Create;
    ScriptThreadLock.Acquire;
    try
      if not Assigned(ScriptThreadList) then
        ScriptThreadList := TList.Create;
    finally
      ScriptThreadLock.Release;
    end;
  end;
  
  ScriptThreadLock.Acquire;
  try
    ScriptThreadList.Add(Self);
  finally
    ScriptThreadLock.Release;
  end;

  try
    InterlockedIncrement(ActiveThreads);

    if Assigned(AContext) then
    begin
      AContext.Retain;
      FOwnerContext := AContext;
    end;

    if not Assigned(AFunc) or
       (AFunc.DataType <> dtFunction) or
       not Assigned(AFunc.FuncVal) then
      raise EScriptRuntimeError.Create(
        'thread(): argumen pertama harus berupa function'
      );

    FFuncVal := AFunc.Clone;

    if Assigned(AArgs) and
       (AArgs.DataType <> dtNull) then
      FArgsVal := AArgs.DeepClone
    else
      FArgsVal := TValue.CreateNull;
 
    {
      Thread environment menjadi child dari closure environment.
      Create() sudah memiliki reference pertama.
      Jangan Retain tambahan.
    }
    if Assigned(FFuncVal.ClosureEnv) then
      FThreadEnv := TSymbolTable.Create(FFuncVal.ClosureEnv)
    else if Assigned(ABaseEnv) then
      FThreadEnv := TSymbolTable.Create(ABaseEnv.GetGlobal)
    else
      raise EScriptRuntimeError.Create(
        'Gagal membuat environment untuk thread'
      );

    if Assigned(FOwnerContext) then
      FThreadEnv.Context := FOwnerContext;

    FScriptFileName := AScriptFileName;
    Start;
  except
    on E: Exception do
    begin
      if Assigned(FFuncVal) then
      begin
        FFuncVal.Free;
        FFuncVal := nil;
      end;

      if Assigned(FArgsVal) then
      begin
        FArgsVal.Free;
        FArgsVal := nil;
      end;

      if Assigned(FThreadEnv) then
      begin
        FThreadEnv.Release;
        FThreadEnv := nil;
      end;

      if Assigned(FOwnerContext) then
      begin
        FOwnerContext.Release;
        FOwnerContext := nil;
      end;

      InterlockedDecrement(ActiveThreads);
      raise;
    end;
  end;
end;

destructor TScriptThread.Destroy;
begin
  // ═══════════════════════════════════════════════════════════════
  // ✅ TAHAP A FIX: VM di-free SEBELUM Chunk.
  //
  // VM.Destroy memanggil FActiveChunks[i].ReleaseUse. Jika Chunk
  // sudah dibebaskan terlebih dahulu, ReleaseUse menulis ke memori
  // yang sudah milik heap allocator → corrupt → AV di thread lain.
  // ═══════════════════════════════════════════════════════════════
  
  if Assigned(FThreadVM) then
  begin
    try
      FThreadVM.Free;
    except
      on E: Exception do
      begin
        if Assigned(IOLock) then
        begin
          IOLock.Acquire;
          try Writeln('Thread cleanup error (VM): ', E.Message);
          finally IOLock.Release; end;
        end;
      end;
    end;
    FThreadVM := nil;
  end;

  if Assigned(FThreadChunk) then
  begin
    try
      FThreadChunk.Free;
    except
      on E: Exception do
      begin
        if Assigned(IOLock) then
        begin
          IOLock.Acquire;
          try Writeln('Thread cleanup error (Chunk): ', E.Message);
          finally IOLock.Release; end;
        end;
      end;
    end;
    FThreadChunk := nil;
  end;

  // ─── Setelah VM & Chunk di-free, baru release sumber daya lain ───

  if Assigned(FFuncVal) then
  begin
    FFuncVal.Free;
    FFuncVal := nil;
  end;

  if Assigned(FArgsVal) then
  begin
    FArgsVal.Free;
    FArgsVal := nil;
  end;

  if Assigned(FThreadEnv) then
  begin
    FThreadEnv.Release;
    FThreadEnv := nil;
  end;

  if Assigned(FOwnerContext) then
  begin
    FOwnerContext.Release;
    FOwnerContext := nil;
  end;

  if InterlockedDecrement(ActiveThreads) <= 0 then
  begin
    if Assigned(ThreadEvent) and
       (InterlockedCompareExchange(IsShuttingDown, 0, 0) = 0) then
    begin
      try
        RTLEventSetEvent(ThreadEvent);
      except
      end;
    end;
  end;

  inherited Destroy;
end;

procedure TScriptThread.Execute;
var
  LocalVM: TVM;
  TempChunk: TChunk;
  TempResult: TValue;
  ThreadFunc: TValue;

  SavedContext: TEngineContext;
  LocalContext: TEngineContext;
begin
  LocalVM := nil;
  TempChunk := nil;
  TempResult := nil;
  ThreadFunc := nil;

  if not Assigned(errMSG) then
    errMSG := Terror.Create;

  SavedContext := GCurrentContext;
  LocalContext := FOwnerContext;
  if not Assigned(LocalContext) and Assigned(FThreadEnv) then
    LocalContext := FThreadEnv.Context;
  if Assigned(LocalContext) then
    GCurrentContext := LocalContext;
  if FScriptFileName <> '' then
    FileName := FScriptFileName;

  try
    if not Assigned(FFuncVal) then Exit;
    if FFuncVal.DataType <> dtFunction then Exit;

    RandSeed := GetTickCount64 xor GetThreadID;
    ThreadFunc := FFuncVal.Clone;

    LocalVM := TVM.Create(FThreadEnv);

    TempChunk := TChunk.Create;

    TempChunk.AddInstruction(opcConstant,
      TempChunk.AddConstant(ThreadFunc));

    ThreadFunc := nil;

    TempChunk.AddInstruction(opcCall, 0);
    TempChunk.AddInstruction(opcHalt);

    TempResult := LocalVM.Run(TempChunk);

    if Assigned(TempResult) then
    begin
      TempResult.Free;
      TempResult := nil;
    end;

  except
    on E: Exception do
    begin
      PushThreadError(Format('Thread[%x] %s: %s',
        [GetThreadID, E.ClassName, E.Message]));
  
      // Cetak ke console hanya jika verbose mode diaktifkan
      if GVerboseThreadErrors and Assigned(IOLock) then
      begin
        IOLock.Acquire;
        try
          Writeln;
          Writeln('=== THREAD ERROR ===');
          Writeln('Pesan: ', E.Message);
        finally
          IOLock.Release;
        end;
      end;
    end;
  end;
  
  if Assigned(ThreadFunc) then
  begin
    ThreadFunc.Free;
    ThreadFunc := nil;
  end;

  FThreadVM := LocalVM;
  FThreadChunk := TempChunk;
  LocalVM := nil;
  TempChunk := nil;
  
  GCurrentContext := SavedContext;
end;

//jembatan native thread untuk script
function Native_RunThread(Args: TObjectList; CallEnv: TSymbolTable): TValue;
const
  MAX_SCRIPT_THREADS = 64;
var
  TargetFunc: TValue;
  TargetArgs: TValue;
  Ctx: TEngineContext;
begin
  // ─── Validasi argumen ───
  if Args.Count < 1 then
    raise EScriptRuntimeError.Create(
      'thread() membutuhkan minimal 1 argumen (fungsi)');

  // ─── Batas maksimal thread aktif ───
  if InterlockedCompareExchange(ActiveThreads, 0, 0) >= MAX_SCRIPT_THREADS then
    raise EScriptRuntimeError.Create(
      'Fatal: Batas maksimal thread aktif tercapai.');

  // ─── Ambil fungsi target ───
  TargetFunc := TValue(Args[0]);

  if not Assigned(TargetFunc) or
     (TargetFunc.DataType <> dtFunction) or
     not Assigned(TargetFunc.FuncVal) then
    raise EScriptRuntimeError.Create(
      'Argumen pertama thread() harus berupa fungsi');

  // ─── Ambil argumen opsional ───
  // ══════════════════════════════════════════════════════════════════
  // FIX KRITIS: hanya ambil Args[1] jika fungsi target MEMILIKI parameter.
  //
  // Alasan: pada iterasi loop kedua dan seterusnya, Args.Count bisa
  // lebih besar dari yang diharapkan karena stack VM tidak sepenuhnya
  // bersih. Kalau kita ambil Args[1] tanpa cek, argumen hantu ini akan
  // diteruskan ke fungsi yang tidak punya parameter → nyangkut sebagai
  // slot lokal → menggeser operand opcForLoopCond.
  // ══════════════════════════════════════════════════════════════════
  TargetArgs := nil;
  if (Args.Count > 1) and
     (Length(TargetFunc.FuncVal.Params) > 0) then
    TargetArgs := TValue(Args[1]);

  // ─── Resolve engine context dari environment caller ───
  Ctx := GetContextFromEnv(CallEnv);

  // ─── Buat dan jalankan thread ───
  // TScriptThread.Create akan otomatis:
  //   1. Register ke ScriptThreadList (untuk join di runScript)
  //   2. Start thread dengan FreeOnTerminate := False
  //   3. Retain AContext (cleanup di TScriptThread.Destroy)
  TScriptThread.Create(TargetFunc, TargetArgs, CallEnv, Ctx, FileName);

  Result := TValue.CreateBool(True);
end;

function Native_PoolRun(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TargetFunc, TargetArgs, TargetCallback: TValue;
  Ctx: TEngineContext;   // ✨ FIX: deklarasi Ctx
begin
  if Args.Count < 1 then 
    raise EScriptRuntimeError.Create('pool.run() membutuhkan minimal 1 argumen fungsi!');
    
  TargetFunc := TValue(Args[0]);
  if TargetFunc.DataType <> dtFunction then
    raise EScriptRuntimeError.Create('Argumen pertama pool.run() harus fungsi!');

  TargetArgs := nil;
  TargetCallback := nil;

  if Args.Count >= 2 then TargetArgs := TValue(Args[1]);
  if Args.Count >= 3 then
  begin
    if TValue(Args[2]).DataType = dtFunction then
      TargetCallback := TValue(Args[2])
    else
      raise EScriptRuntimeError.Create('Argumen ketiga pool.run() harus fungsi callback!');
  end;

  // ✨ PHASE 7: Akses WorkerPool via context
  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) or not Assigned(Ctx.WorkerPool) then
    raise EScriptRuntimeError.Create('Worker pool tidak tersedia di engine context');
  
  Ctx.WorkerPool.EnqueueTask(TargetFunc, TargetArgs, TargetCallback);

  Result := TValue.CreateBool(True);
end;

