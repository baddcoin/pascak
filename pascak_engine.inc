constructor TValueList.Create(zFreeObjects: Boolean);
begin
  FList := TValueListBase.Create(zFreeObjects);
  FGCState := gcBlack;
  RegisterGC(Self);
  FLock := TCriticalSection.Create; 
end;

destructor TValueList.Destroy;
begin
  UnregisterGC(Self);
  FLock.Free;
  FList.Free; // Bersihkan list internal
  inherited;
end;

procedure TValueList.Mark;
var 
  i, SnapCount: Integer;
  Snapshot: array of TValue;
begin
  Snapshot := nil;
  SnapCount := 0;
  
  FLock.Acquire; 
  try
    if FGCState = gcBlack then Exit; 
    FGCState := gcBlack;
  
    // ✅ FIX P1.3: Snapshot ATOMIC di dalam lock
    SnapCount := FList.Count; 
    if SnapCount > 0 then
    begin
      SetLength(Snapshot, SnapCount);
      for i := 0 to SnapCount - 1 do
        Snapshot[i] := FList[i];   // Direct assign — count sudah di-lock
    end;
  finally
    FLock.Release;
  end;
  
  // Traverse di luar lock
  for i := 0 to SnapCount - 1 do
    if Assigned(Snapshot[i]) then Snapshot[i].Mark;
    
  SetLength(Snapshot, 0);
end;

procedure TValueList.Retain; 
begin 
  InterlockedIncrement(FRefCount); // BENAR: Atomik dan Thread-Safe
end;

procedure TValueList.Release;
begin
  if InterlockedDecrement(FRefCount) = 0 then 
