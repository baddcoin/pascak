// fs.tempFile([prefix]) → string path
function Native_FS_TempFile(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Prefix, TmpPath, BaseDir: string;
begin
  Prefix := '';
  if (Args.Count >= 1) and (TValue(Args[0]).DataType = dtString) then
    Prefix := TValue(Args[0]).StrVal;

  // ✅ Base dir = script dir (threadvar FileName), fallback cwd
  if FileName <> '' then
    BaseDir := IncludeTrailingPathDelimiter(ExtractFilePath(ExpandFileName(FileName)))
  else
    BaseDir := IncludeTrailingPathDelimiter(GetCurrentDir);

  if FSTempFile(BaseDir, Prefix, TmpPath) then
    Result := TValue.CreateStr(TmpPath)
  else
  begin
    errMSG.callerror(144, 'fs.tempFile: gagal membuat file', errMSG.xrow, errMSG.xcol);
    Result := TValue.CreateStr('');
  end;
end;

