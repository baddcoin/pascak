function Native_ToBin(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Num: Int64;
  UNum: UInt64;
  Res: string;
  IsNeg: Boolean;
  Len: Integer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
    raise EScriptRuntimeError.Create('Math Error: toBin(number) membutuhkan tepat 1 argumen numerik.');

  if (TValue(Args[0]).NumVal < MIN_INT64_DBL) or (TValue(Args[0]).NumVal > MAX_INT64_DBL) then
    raise EScriptRuntimeError.Create('Math Error: Nilai melampaui batas konversi biner.');

  Num := System.Trunc(TValue(Args[0]).NumVal);
  if Num = 0 then Exit(TValue.CreateStr('0'));

  IsNeg := Num < 0;
  
  if IsNeg then 
  begin
    if Num = Low(Int64) then
      UNum := UInt64(High(Int64)) + 1 
    else
      UNum := UInt64(-Num);
  end else
    UNum := UInt64(Num);

  // Optimasi string pre-allocation mencegah re-alokasi linear O(N^2)
  SetLength(Res, 64);
  Len := 64;
  
  while UNum > 0 do
  begin
    if (UNum and 1) = 1 then Res[Len] := '1' else Res[Len] := '0';
    UNum := UNum shr 1;
    Dec(Len);
  end;
  
  Res := Copy(Res, Len + 1, 64 - Len);
  if IsNeg then Res := '-' + Res; 

  Result := TValue.CreateStr(Res);
end;

