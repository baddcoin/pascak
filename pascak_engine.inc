function BuiltIn_Dict_Keys(TargetObj: TValue; const Args: array of TValue): TValue;
var
  TempKeys: TStringArray;
  NewArr: TValueList;
  i: Integer;
begin
  if Length(Args) <> 0 then 
  begin
    errMSG.callerror(144, 'Dict.keys() tidak menerima argumen', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull); // DIPERBAIKI: Wajib Exit agar VM tidak crash
  end;
  
  NewArr := TValueList.Create(True);
  try
    // Pengambilan Keys dikunci sesaat jika perlu, walau GetKeys mungkin thread-safe
    TargetObj.DictVal.FLock.Acquire;
    try
      TempKeys := TargetObj.DictVal.GetKeys; 
    finally
      TargetObj.DictVal.FLock.Release;
    end;

    for i := 0 to High(TempKeys) do
      NewArr.Add(TValue.CreateStr(TempKeys[i]));
  except
    NewArr.Free;
    raise EScriptRuntimeError.Create('VM Memory Error: Gagal mengalokasikan array untuk Dict.keys()');
  end;
  Result := TValue.CreateArray(NewArr);
end;

