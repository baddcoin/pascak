// Helper: TStringList → TValue array of strings
function StringListToArray(const L: TStringList): TValue;
var
  Arr: TValueList;
  i: Integer;
begin
  Arr := TValueList.Create(True);
  try
    for i := 0 to L.Count - 1 do
      Arr.Add(TValue.CreateStr(L[i]));
    Result := TValue.CreateArray(Arr);
  except
    Arr.Free;
    raise;
  end;
end;

// fs.glob(baseDir, pattern) → array of relative paths
function Native_FS_Glob(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  BaseDir, Pattern, SafePath: string;
  Results: TStringList;
begin
  if (Args.Count <> 2) or 
     (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 'fs.glob(baseDir, pattern) butuh 2 argumen string',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateArray(TValueList.Create(True)));
  end;
  
  BaseDir := TValue(Args[0]).StrVal;
  Pattern := TValue(Args[1]).StrVal;
  
  SafePath := GetSafeSandboxedPath(BaseDir);
  
  Results := TStringList.Create;
  try
    if not FSGlob(SafePath, Pattern, Results) then
    begin
      errMSG.callerror(144, 'fs.glob: direktori tidak valid atau tidak ada — ' + SafePath,
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateArray(TValueList.Create(True)));
    end;
    Result := StringListToArray(Results);
  finally
    Results.Free;
  end;
end;

// fs.walkDir(path, [maxDepth]) → array of relative paths
function Native_FS_WalkDir(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Path, SafePath: string;
  MaxDepth: Integer;
  Results: TStringList;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 'fs.walkDir(path, [maxDepth])', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateArray(TValueList.Create(True)));
  end;
  
  Path := TValue(Args[0]).StrVal;
  MaxDepth := 0;
  if Args.Count = 2 then
  begin
    if TValue(Args[1]).DataType = dtNumeric then
      MaxDepth := Trunc(TValue(Args[1]).NumVal);
  end;
  
  SafePath := GetSafeSandboxedPath(Path);
  
  Results := TStringList.Create;
  try
    if not FSWalkDir(SafePath, MaxDepth, Results) then
    begin
      errMSG.callerror(144, 'fs.walkDir: direktori tidak valid — ' + SafePath,
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateArray(TValueList.Create(True)));
    end;
    Result := StringListToArray(Results);
  finally
    Results.Free;
  end;
end;

