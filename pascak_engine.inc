//========================
function Native_Copy(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  S, ResStr: string;
  Idx, Cnt: Integer;
begin
  if (Args.Count <> 3) or (TValue(Args[0]).DataType <> dtString) or 
     (TValue(Args[1]).DataType <> dtNumeric) or (TValue(Args[2]).DataType <> dtNumeric) then
    raise Exception.Create('Error: "copy" membutuhkan argumen (String, Angka, Angka).');
    
  S := TValue(Args[0]).StrVal;
  Idx := Trunc(TValue(Args[1]).NumVal) + 1; 
  Cnt := Trunc(TValue(Args[2]).NumVal);
  
  if Cnt > strMax then
    raise EScriptRuntimeError.Create('VM Security Error: Jumlah karakter pada "copy" melampaui batas!');
  
  if Cnt < 0 then Cnt := 0;
  if Idx < 1 then Idx := 1;
  
