{$IFDEF UNIX}
function StdinHasData(TimeoutMs: Integer): Boolean;
var
  FDS: TFDSet;
  TV: TTimeVal;
begin
  fpFD_ZERO(FDS);
  fpFD_SET(0, FDS);
  TV.tv_sec := TimeoutMs div 1000;
  TV.tv_usec := (TimeoutMs mod 1000) * 1000;
  Result := fpSelect(1, @FDS, nil, nil, @TV) > 0;
end;
{$ENDIF}

{ Baca satu baris dengan cara non-blocking: selama menunggu input user,
  tick event loop supaya timer/callback tetap fire di main thread. }
function ReadLineWithTick(AEngine: TPascakEngine; out ALine: string): Boolean;
begin
  ALine := '';
  while True do
  begin
    {$IFDEF UNIX}
    if StdinHasData(50) then
    {$ENDIF}
    begin
      if EOF(Input) then Exit(False);
      Readln(ALine);
      Exit(True);
    end;

    {$IFDEF UNIX}
    if Assigned(AEngine) and Assigned(AEngine.Context) and
       Assigned(AEngine.Context.EventLoop) then
    begin
      try
        AEngine.Context.EventLoop.TickOnce(AEngine.GlobalEnv);
      except
        // fail-silent — callback error tidak boleh bunuh REPL
      end;
    end;
    {$ENDIF}
  end;
end;

procedure RunREPL;
var
  Engine: TPascakEngine;
  Line: string;
  Res: TValue;
  Lower: string;
  i: Integer;
  IsStatement: Boolean;
  FirstWord: string;
  Code: string;

  function IsStatementInput(const S: string): Boolean;
  var
    L, FW: string;
    j: Integer;
  begin
    L := LowerCase(S);
    if (Length(L) > 0) and (L[Length(L)] = ';') then
      Exit(True);

    j := 1;
    while (j <= Length(L)) and (L[j] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
      Inc(j);
    FW := Copy(L, 1, j - 1);

    Result := (FW = 'var') or (FW = 'const') or (FW = 'function') or
              (FW = 'class') or (FW = 'record') or (FW = 'if') or
              (FW = 'while') or (FW = 'for') or (FW = 'repeat') or
              (FW = 'try') or (FW = 'lock') or (FW = 'case') or
              (FW = 'begin') or (FW = 'print') or (FW = 'println') or
              (FW = 'return') or (FW = 'throw') or (FW = 'import');
  end;

begin
  Writeln('Pascak REPL v1.0 — .help for commands, .exit to quit');
  Writeln;

  EnsureGlobalsInit;
  
  Engine := TPascakEngine.Create;
  try
    while True do
    begin
      Write('pascak> ');
      Flush(Output);
      
      if not ReadLineWithTick(Engine, Line) then
      begin
        Writeln;
        Break;
      end;
      
      Line := Trim(Line);

      if Line = '' then Continue;

      // Special commands
      if (Line = '.exit') or (Line = '.quit') then Break;

      if Line = '.help' then
      begin
        Writeln('Commands:');
        Writeln('  .exit, .quit   — exit REPL');
        Writeln('  .help          — this message');
        Writeln('  .clear         — clear screen');
        Writeln;
        Writeln('Everything else is evaluated as Pascak code.');
        Writeln('Multi-line: put entire script on one line (use ; separator).');
        Continue;
      end;

      if Line = '.clear' then
      begin
        Write(#27'[2J'#27'[H');
        Flush(Output);
        Continue;
      end;

      // Detect statement vs expression
      IsStatement := IsStatementInput(Line);

      // Build code
      if IsStatement then
        Code := 'begin ' + Line + #10'end.'
      else
        Code := 'begin return ' + Line + '; end.';

      // Execute
      Res := nil;
      try
        try
          Res := Engine.ExecuteString(Code, '<repl>');
          if Assigned(Res) and (Res.DataType <> dtNull) then
            Writeln('=> ', TValueToString(Res, False));
        except
          on E: EScriptRuntimeError do
            Writeln('Error: ', E.Message);
          on E: EScriptFatalError do
            Writeln('Fatal: ', E.Message);
          on E: Exception do
            Writeln('Error: ', E.ClassName, ': ', E.Message);
        end;
      finally
        if Assigned(Res) then Res.Free;
      end;

      Writeln;
    end;
  finally
    Engine.Free;
  end;

  Writeln('Bye.');
end;

