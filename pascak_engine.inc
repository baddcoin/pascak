    Target.Free;       // Pembersihan
    Args.Free; 
    inherited; 
end;

function CompareTValue(Item1, Item2: TValue): Integer;
begin
  // Cegah pelanggaran transivitas QuickSort
  if (not Assigned(Item1)) and (not Assigned(Item2)) then Exit(0);
  if not Assigned(Item1) then Exit(-1); // Dorong nilai nil ke sisi terkiri
  if not Assigned(Item2) then Exit(1);  // Dorong nilai nil ke sisi terkiri
  
  if Item1.DataType = Item2.DataType then
  begin
    case Item1.DataType of
      dtNumeric: 
        if Item1.NumVal < Item2.NumVal then Result := -1
        else if Item1.NumVal > Item2.NumVal then Result := 1
        else Result := 0;
      dtString:  
        if Item1.StrVal < Item2.StrVal then Result := -1
        else if Item1.StrVal > Item2.StrVal then Result := 1
        else Result := 0;
      dtBoolean: 
        if Item1.BoolVal = Item2.BoolVal then Result := 0
        else if Item1.BoolVal then Result := 1
        else Result := -1;
      else Result := 0;
    end;
  end else
  begin
    if Ord(Item1.DataType) < Ord(Item2.DataType) then Result := -1
    else if Ord(Item1.DataType) > Ord(Item2.DataType) then Result := 1
    else Result := 0;
  end;
end;

procedure QuickSortTValueList(List: TValueList; iLo, iHi: Integer);
var
  Lo, Hi: Integer;
  Pivot: TValue;
begin
  if (List = nil) or (List.Count = 0) then Exit;
  Lo := iLo;
  Hi := iHi;
  Pivot := List[(Lo + Hi) div 2];
  repeat
    while CompareTValue(List[Lo], Pivot) < 0 do Inc(Lo);
    while CompareTValue(List[Hi], Pivot) > 0 do Dec(Hi);
    if Lo <= Hi then
    begin
      // : Gunakan Exchange agar TFPGObjectList HANYA menukar pointer
      // tanpa menghancurkan (Free) instance TValue lama secara sepihak.
      List.Exchange(Lo, Hi);
      Inc(Lo); Dec(Hi);
    end;
  until Lo > Hi;
  if Hi > iLo then QuickSortTValueList(List, iLo, Hi);
  if Lo < iHi then QuickSortTValueList(List, Lo, iHi);
end;

function Helper_GetArraySnapshot(ArrVal: TValueList; out SnapCount: Integer): TValueArray;
var
  i, j: Integer;
begin
  Result := nil;
  ArrVal.FLock.Acquire;
  try
    SnapCount := ArrVal.Count;
    SetLength(Result, SnapCount);
    try
      for i := 0 to SnapCount - 1 do
      begin
        if Assigned(ArrVal[i]) then Result[i] := ArrVal[i].Clone 
        else Result[i] := TValue.CreateNull;
      end;
    except
      for j := 0 to i - 1 do
        if Assigned(Result[j]) then Result[j].Free;
      SetLength(Result, 0);
      SnapCount := 0;
      raise;
    end;
  finally 
    ArrVal.FLock.Release; 
  end;
end;

//shortcut array
function BuiltIn_Array_Push(TargetObj: TValue; const Args: array of TValue): TValue;
var
  i: Integer;
  ClonedVal: TValue;
begin
  if Length(Args) < 1 then errMSG.callerror(60, 'Array.push', errMSG.xrow, errMSG.xcol);
  
  TargetObj.ArrayVal.FLock.Acquire;
  try
    if TargetObj.ArrayVal.Count + Length(Args) > arrMax then 
      errMSG.callerror(7, 'Array.push', errMSG.xrow, errMSG.xcol);
      
    for i := 0 to High(Args) do
    begin
      // PERBAIKAN: Proteksi ketat untuk mencegah Access Violation
      if Assigned(Args[i]) then
        ClonedVal := Args[i].Clone
      else
        ClonedVal := TValue.CreateNull;
        
      try
        TargetObj.ArrayVal.Add(ClonedVal);
      except
        ClonedVal.Free; // Mencegah memory leak jika Add gagal
        raise;
      end;
    end;
    
    Result := TValue.CreateNum(TargetObj.ArrayVal.Count);
  finally 
    TargetObj.ArrayVal.FLock.Release; 
  end;
end;

function BuiltIn_Array_Pop(TargetObj: TValue; const Args: array of TValue): TValue;
begin
  if Length(Args) <> 0 then errMSG.callerror(61, 'Array.pop', errMSG.xrow, errMSG.xcol);
  TargetObj.ArrayVal.FLock.Acquire;
  try
    if TargetObj.ArrayVal.Count > 0 then 
    begin
      Result := TargetObj.ArrayVal[TargetObj.ArrayVal.Count - 1].Clone;
      TargetObj.ArrayVal.Delete(TargetObj.ArrayVal.Count - 1);
    end 
    else Result := TValue.CreateNull;
  finally 
    TargetObj.ArrayVal.FLock.Release; 
  end;
end;

function BuiltIn_Array_Sort(TargetObj: TValue; const Args: array of TValue): TValue;
var
  MiniVM: TVM;
  SortChunk: TChunk;
  i, j, ArrCount: Integer;
  CmpRes, Temp: TValue;
  TempSnapshot: TValueArray;
begin
  if (Length(Args) > 1) or ((Length(Args) = 1) and (Args[0].DataType <> dtFunction)) then 
    errMSG.callerror(62, 'Array.sort([callback]) hanya menerima maksimal 1 argumen fungsi', errMSG.xrow, errMSG.xcol);
  
  if Length(Args) = 1 then
  begin
    // PERBAIKAN FATAL: Gunakan Snapshot untuk mengisolasi mutasi array dari dalam callback user
    // saat proses sort berjalan (mencegah Access Violation & Out-of-bounds crash).
    TempSnapshot := Helper_GetArraySnapshot(TargetObj.ArrayVal, ArrCount);
    try
      if ArrCount > 1 then
      begin
        if Assigned(Args[0].ClosureEnv) then MiniVM := TVM.Create(Args[0].ClosureEnv)
        else MiniVM := TVM.Create(nil);
        
        SortChunk := TChunk.Create;
        try
          SortChunk.AddInstruction(opcCall, 2); 
          SortChunk.AddInstruction(opcReturn);
          
          for i := 0 to ArrCount - 2 do
            for j := 0 to ArrCount - i - 2 do
            begin
              MiniVM.Push(Args[0].Clone);
              MiniVM.Push(TempSnapshot[j].Clone);
              MiniVM.Push(TempSnapshot[j+1].Clone);
              CmpRes := MiniVM.Run(SortChunk);
              try
                // Jika callback mengembalikan > 0, swap pointer langsung di dalam snapshot
                if (CmpRes.DataType = dtNumeric) and (CmpRes.NumVal > 0) then
                begin
                  Temp := TempSnapshot[j];
                  TempSnapshot[j] := TempSnapshot[j+1];
                  TempSnapshot[j+1] := Temp;
                end;
              finally
                CmpRes.Free;
              end;
            end;
        finally
          if Assigned(SortChunk) then SortChunk.Free;
          if Assigned(MiniVM) then MiniVM.Free;
        end;
      end;

      // Kunci objek dan terapkan kembali Snapshot yang sudah terurut
      TargetObj.ArrayVal.FLock.Acquire;
      try
        TargetObj.ArrayVal.Clear;
        for i := 0 to ArrCount - 1 do
        begin
          if Assigned(TempSnapshot[i]) then 
            TargetObj.ArrayVal.Add(TempSnapshot[i].Clone);
        end;
      finally
        TargetObj.ArrayVal.FLock.Release;
      end;
      
    finally
      Helper_FreeArraySnapshot(TempSnapshot);
    end;
  end
  else
  begin
    // Native sort (tanpa callback VM) aman dilakukan secara in-place
    TargetObj.ArrayVal.FLock.Acquire;
    try
      if TargetObj.ArrayVal.Count > 1 then
        QuickSortTValueList(TargetObj.ArrayVal, 0, TargetObj.ArrayVal.Count - 1);
    finally 
      TargetObj.ArrayVal.FLock.Release; 
    end;
  end;
  
  Result := TargetObj.Clone; 
end;

