begin
  if Length(Args) <> 0 then errMSG.callerror(144, 'Array.clear() tidak menerima argumen', errMSG.xrow, errMSG.xcol);
  TargetObj.ArrayVal.FLock.Acquire;
  try
    TargetObj.ArrayVal.Clear;
  finally
