//==================================================================== 
procedure WSExtractHandlers(Server: PWSServerEntry; Config: TValue);
var
  V, Item: TValue;
  i: Integer;
begin
  V := Config.DictVal.GetValueClone('onOpen');
  if Assigned(V) and (V.DataType = dtFunction) then Server^.OnOpen := V
  else if Assigned(V) then V.Free;
  
  V := Config.DictVal.GetValueClone('onMessage');
  if Assigned(V) and (V.DataType = dtFunction) then Server^.OnMessage := V
  else if Assigned(V) then V.Free;
  
  V := Config.DictVal.GetValueClone('onClose');
  if Assigned(V) and (V.DataType = dtFunction) then Server^.OnClose := V
  else if Assigned(V) then V.Free;
  
  V := Config.DictVal.GetValueClone('onError');
  if Assigned(V) and (V.DataType = dtFunction) then Server^.OnError := V
  else if Assigned(V) then V.Free;
  
  V := Config.DictVal.GetValueClone('pingInterval');
  if Assigned(V) then
  begin
    if V.DataType = dtNumeric then
      Server^.PingIntervalMs := Trunc(V.NumVal);
    V.Free;
  end;
  
  V := Config.DictVal.GetValueClone('maxPayload');
  if Assigned(V) then
  begin
    if V.DataType = dtNumeric then
      Server^.MaxPayloadBytes := Trunc(V.NumVal);
    V.Free;
  end;
  
  // ✅ A.2.2: parse subprotocols array
  V := Config.DictVal.GetValueClone('subprotocols');
  if Assigned(V) and (V.DataType = dtArray) then
  begin
    V.ArrayVal.FLock.Acquire;
    try
      for i := 0 to V.ArrayVal.Count - 1 do
      begin
        Item := V.ArrayVal[i];
        if Assigned(Item) and (Item.DataType = dtString) and
           (Trim(Item.StrVal) <> '') then
          Server^.Subprotocols.Add(Trim(Item.StrVal));
      end;
    finally
      V.ArrayVal.FLock.Release;
    end;
    V.Free;
  end
  else if Assigned(V) then
    V.Free;
  
  // ✅ A.2.3: ping/pong config
  V := Config.DictVal.GetValueClone('pongTimeout');
  if Assigned(V) then
  begin
    if V.DataType = dtNumeric then
      Server^.PongTimeoutMs := Trunc(V.NumVal);
    V.Free;
  end;
  
  V := Config.DictVal.GetValueClone('pingEnabled');
  if Assigned(V) then
  begin
    Server^.PingEnabled := V.IsTrue;
    V.Free;
  end;
  
  // ✅ A.2.4: compression config
  V := Config.DictVal.GetValueClone('compression');
  if Assigned(V) then
  begin
    if V.DataType = dtString then
      Server^.CompressionEnabled := LowerCase(V.StrVal) = 'on';
    V.Free;
  end;
  
  V := Config.DictVal.GetValueClone('compressionThreshold');
  if Assigned(V) then
  begin
    if V.DataType = dtNumeric then
      Server^.CompressionThreshold := Trunc(V.NumVal);
    V.Free;
  end;
end;

