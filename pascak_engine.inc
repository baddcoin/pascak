function Native_Lib_ClosureInfo(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  D: TDictValue;
  Info: string;
begin
  D := TDictValue.Create;
  try
    if InitLibFFI and GFFIAvailable then
      Info := 'libffi loaded'
    else if GLibFFI = NilHandle then
      Info := 'libffi not found'
    else
      Info := 'libffi incomplete';
    
    D.SetValue('available', TValue.CreateBool(GFFIAvailable));
    D.SetValue('status', TValue.CreateStr(Info));
    D.SetValue('libHandle', TValue.CreateNum(PtrUInt(GLibFFI)));
    Result := TValue.CreateDict(D);
  except
    D.Free;
    raise;
  end;
end;

procedure CallbackDispatcher(cif: Pffi_cif; ret: Pointer;
  args: Pointer; user_data: Pointer); cdecl;
var
  Ctx: TCallbackContext;
  ArgPtrs: PPointer;
  ArgValues: array of TValue;
  i, N: Integer;
  RawArgSlot: Pointer;
  RawPtr: Pointer;
  MiniVM: TVM;
  TempChunk: TChunk;
  ResultVal: TValue;
  SavedContext: TEngineContext;
  CallEnv: TSymbolTable;
  IntResult: Int64;
  DblResult: Double;
  PtrResult: Pointer;
begin
  // ═══════════════════════════════════════════════════════════════
  // F-3a-3: Full dispatcher. All exceptions MUST be caught —
  // any exception escaping cdecl boundary = UB (crash C caller).
  // ═══════════════════════════════════════════════════════════════
  ResultVal := nil;
  MiniVM := nil;
  TempChunk := nil;
  Ctx := nil;
  SavedContext := nil;
  SetLength(ArgValues, 0);

  try
    Ctx := TCallbackContext(user_data);
    if not Assigned(Ctx) then
    begin
      if Assigned(ret) then PInt64(ret)^ := 0;
      Exit;
    end;
    
    InterlockedIncrement64(Ctx.InvokeCount);
    
    // ─── Context affinity ───
    SavedContext := GCurrentContext;
    if Assigned(Ctx.OwnerContext) then
      GCurrentContext := Ctx.OwnerContext;
    
    // ─── Marshal args ───
    N := Ctx.ArgCount;
    SetLength(ArgValues, N);
    ArgPtrs := PPointer(args);
    
    for i := 0 to N - 1 do
    begin
      RawArgSlot := ArgPtrs[i];   // void* ke slot arg
      
      // ArgKinds[i] sesuai parser: 'i'→fatInt, 'f'→fatFloat,
      // 's'→fatString, 'p'→fatPointer
      // 'p' diterima dari TValue.CreatePtr → PtrVal bukan alamat slot,
      // tapi nilai pointer yang di-pass. Jadi kita dereference.

      case Ctx.ArgKinds[i] of
        fatInt:
          ArgValues[i] := TValue.CreateNum(PInt64(RawArgSlot)^);
        fatFloat:
          ArgValues[i] := TValue.CreateNum(PDouble(RawArgSlot)^);
        fatPointer:
          begin
            RawPtr := PPointer(RawArgSlot)^;
            ArgValues[i] := TValue.CreatePtr(RawPtr);
          end;
        fatString:
          begin
            RawPtr := PPointer(RawArgSlot)^;
            ArgValues[i] := TValue.CreateStr(
              PAnsiCharToVMStr(PAnsiChar(RawPtr)));
          end;
      else
        ArgValues[i] := TValue.CreateNull;
      end;
      
    end;
    
    // ─── Prepare call env ───
    if Assigned(Ctx.VMFunc.ClosureEnv) then
      CallEnv := Ctx.VMFunc.ClosureEnv
    else if Assigned(Ctx.OwnerContext) then
      CallEnv := Ctx.OwnerContext.GlobalEnv
    else
      CallEnv := nil;
    
    // ─── Execute VM function ───
    MiniVM := TVM.Create(CallEnv);
    TempChunk := TChunk.Create;
    
    // fn + args, lalu call, lalu return
    TempChunk.AddInstruction(opcConstant,
      TempChunk.AddConstant(Ctx.VMFunc.Clone));
    
    for i := 0 to N - 1 do
      TempChunk.AddInstruction(opcConstant,
        TempChunk.AddConstant(ArgValues[i].Clone));
    
    TempChunk.AddInstruction(opcCall, N);
    TempChunk.AddInstruction(opcReturn);
    
    ResultVal := MiniVM.Run(TempChunk);
    
    // ─── Marshal return value ───
    if Assigned(ret) then
    begin
      case Ctx.RetKind of
        frtInt:
          begin
            if Assigned(ResultVal) and (ResultVal.DataType = dtNumeric) then
              IntResult := Trunc(ResultVal.NumVal)
            else
              IntResult := 0;
            PInt64(ret)^ := IntResult;
          end;
        frtFloat:
          begin
            if Assigned(ResultVal) and (ResultVal.DataType = dtNumeric) then
              DblResult := ResultVal.NumVal
            else
              DblResult := 0.0;
            PDouble(ret)^ := DblResult;
          end;
        frtPointer:
          begin
            if Assigned(ResultVal) and (ResultVal.DataType = dtPointer) then
              PtrResult := ResultVal.PtrVal
            else
              PtrResult := nil;
            PPointer(ret)^ := PtrResult;
          end;
        // ✅ F-3a-4: string return — alokasi reusable buffer
        frtString:
          begin
            if Assigned(ResultVal) and (ResultVal.DataType = dtString) then
              PtrResult := CtxEnsureStringBuf(Ctx, ResultVal.StrVal)
            else
              PtrResult := CtxEnsureStringBuf(Ctx, '');
            PPointer(ret)^ := PtrResult;
          end;
        frtVoid: ;
      else
        PInt64(ret)^ := 0;
      end;
    end;
    
  except
    on E: Exception do
    begin
      // ⚠️ Exception di dalam cdecl boundary = UB. Catat & return zero.
      try
        WriteLn(ErrOutput, '[callback] dispatcher exception: ',
                E.ClassName, ': ', E.Message);
        Flush(ErrOutput);
      except
        // fail-silent — kalau stderr sendiri bermasalah
      end;
      
      if Assigned(ret) then
        PInt64(ret)^ := 0;
    end;
  end;
  
  // ─── Cleanup ───
  try
    if Assigned(ResultVal) then ResultVal.Free;
    if Assigned(TempChunk) then TempChunk.Free;
    if Assigned(MiniVM) then MiniVM.Free;
    for i := 0 to High(ArgValues) do
      if Assigned(ArgValues[i]) then ArgValues[i].Free;
    SetLength(ArgValues, 0);
    
    // Restore context
    if Assigned(SavedContext) or (SavedContext = nil) then
      GCurrentContext := SavedContext;
  except
    // fail-silent — pastikan tidak bubble ke C
  end;
end;

// TLS Native Wrappers=================================================
// ====================================================================

procedure EnsureTLSInit;
begin
  // ✅ Fast path
  if Assigned(GTLSContextLock) then Exit;
  
  if not Assigned(GTLSInitLockGuard) then
    GTLSInitLockGuard := TCriticalSection.Create;
  
  GTLSInitLockGuard.Acquire;
  try
    if not Assigned(GTLSContextLock) then
      GTLSContextLock := TCriticalSection.Create;
  finally
    GTLSInitLockGuard.Release;
  end;
end;

// Ambil atau buat shared TLS context (trust sistem CA).
function GetSharedTLSContext(VerifyPeer: Boolean): TTLSContext;
begin
  EnsureTLSInit;
  GTLSContextLock.Acquire;
  try
    if VerifyPeer then
    begin
      if (not Assigned(GSharedTLSContextVerify))
         or (GSharedTLSContextVerify.CtxPtr = nil) then
      begin
        if Assigned(GSharedTLSContextVerify) then
        begin
          GSharedTLSContextVerify.Release;
          GSharedTLSContextVerify := nil;
        end;
        GSharedTLSContextVerify := TTLSContext.Create(True);
      end;
      Result := GSharedTLSContextVerify;
    end
    else
    begin
      if (not Assigned(GSharedTLSContextNoVerify))
         or (GSharedTLSContextNoVerify.CtxPtr = nil) then
      begin
        if Assigned(GSharedTLSContextNoVerify) then
        begin
          GSharedTLSContextNoVerify.Release;
          GSharedTLSContextNoVerify := nil;
        end;
        GSharedTLSContextNoVerify := TTLSContext.Create(False);
      end;
      Result := GSharedTLSContextNoVerify;
    end;
    if Assigned(Result) then Result.Retain;
  finally
    GTLSContextLock.Release;
  end;
end;

procedure ReleaseSharedTLSContext;
begin
  if not Assigned(GTLSContextLock) then Exit;
  GTLSContextLock.Acquire;
  try
    if Assigned(GSharedTLSContextVerify) then
    begin
      GSharedTLSContextVerify.Release;
      GSharedTLSContextVerify := nil;
    end;
    if Assigned(GSharedTLSContextNoVerify) then
    begin
      GSharedTLSContextNoVerify.Release;
      GSharedTLSContextNoVerify := nil;
    end;
  finally
    GTLSContextLock.Release;
  end;
end;

