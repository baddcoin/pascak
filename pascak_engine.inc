  function AtomicExchangePointer(var Target: Pointer; Value: Pointer): Pointer; inline;
  {$IFDEF WINDOWS}
  var
    OldValue: Pointer;
  begin
    {$IFDEF WIN64}
    // Gunakan InterlockedExchangePointer — API native Windows 64-bit
    OldValue := InterlockedExchangePointer(@Target, Value);
    {$ELSE}
    OldValue := Pointer(InterlockedExchange(PLongInt(@Target), LongInt(Value)));
    {$ENDIF}
    Result := OldValue;
  end;
  {$ELSE}
  begin
    // Linux/macOS: FPC menyediakan overload Pointer native
    Result := InterlockedExchange(Target, Value);
  end;
  {$ENDIF}
  
