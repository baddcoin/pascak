// Semua fungsi menerima integer handle dari script, dan menggunakan
// pascak_net.pas untuk I/O. Error di-translasi ke errMSG.callerror.
// ====================================================================

function Native_NetListen(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Host: string;
  Port, Sock: Integer;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(139, 'net.listen(host: string, port: int)', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Host := TValue(Args[0]).StrVal;
  Port := Trunc(TValue(Args[1]).NumVal);
  
  if not NetListen(Host, Port, Sock) then
  begin
    errMSG.callerror(145, 'net.listen gagal: ' + NetLastError, errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Result := TValue.CreateNum(Sock);
end;

function Native_NetAccept(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  ServerSock, ClientSock: Integer;
begin
  if (Args.Count < 1) or (Args.Count > 2) or 
     (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'net.accept(serverHandle: int, [timeoutMs: int])', 
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  ServerSock := Trunc(TValue(Args[0]).NumVal);
  
  if Args.Count = 2 then
  begin
    if TValue(Args[1]).DataType <> dtNumeric then
    begin
      errMSG.callerror(138, 'net.accept: timeout harus numerik', errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNum(-1));
    end;
    
    if not NetAcceptTimeout(ServerSock, Trunc(TValue(Args[1]).NumVal), ClientSock) then
    begin
      // Timeout bukan error fatal — return -1 dengan last error
      Exit(TValue.CreateNum(-1));
    end;
  end
  else
  begin
    // Blocking accept
    if not NetAcceptTimeout(ServerSock, 0, ClientSock) then
    begin
      errMSG.callerror(148, 'net.accept gagal: ' + NetLastError, 
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNum(-1));
    end;
  end;
  
  Result := TValue.CreateNum(ClientSock);
end;

function Native_NetConnect(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Host: string;
  Port, TimeoutMs, Sock: Integer;
begin
  if (Args.Count < 2) or (Args.Count > 3) or
     (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(139, 'net.connect(host: string, port: int, [timeoutMs: int])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Host := TValue(Args[0]).StrVal;
  Port := Trunc(TValue(Args[1]).NumVal);
  
  TimeoutMs := NET_CONNECT_TIMEOUT;
  if Args.Count = 3 then
  begin
    if TValue(Args[2]).DataType <> dtNumeric then
    begin
      errMSG.callerror(138, 'net.connect: timeout harus numerik', errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNum(-1));
    end;
    TimeoutMs := Trunc(TValue(Args[2]).NumVal);
  end;
  
  if not NetConnect(Host, Port, TimeoutMs, Sock) then
  begin
    errMSG.callerror(145, 'net.connect gagal: ' + NetLastError, errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Result := TValue.CreateNum(Sock);
end;

