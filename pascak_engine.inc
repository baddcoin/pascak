// Membaca 1 Byte dari alamat memori fisik mentah
function Native_MemPeek(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var TargetAddress: PByte;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then 
    raise EScriptRuntimeError.Create('Hardware.peek(address_pointer) membutuhkan tepat 1 argumen bertipe Pointer.');
    
  TargetAddress := PByte(TValue(Args[0]).PtrVal);
  try 
    Result := TValue.CreateNum(TargetAddress^);
  except 
    on E: Exception do raise EScriptRuntimeError.Create('Hardware Error: SegFault saat membaca memori (Alamat tidak valid)!'); 
  end;
end;

// Menulis 1 Byte ke alamat memori fisik mentah (Berbahaya tapi sangat kuat)
function Native_MemPoke(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var TargetAddress: PByte; DataByte: Byte;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtPointer) or (TValue(Args[1]).DataType <> dtNumeric) then 
    raise EScriptRuntimeError.Create('Hardware.poke(address_pointer, value_num) membutuhkan Argumen (Pointer, Numeric).');
    
  TargetAddress := PByte(TValue(Args[0]).PtrVal);
  DataByte := Byte(Trunc(TValue(Args[1]).NumVal));
  
  try 
    TargetAddress^ := DataByte; 
    Result := TValue.CreateBool(True);
  except 
    on E: Exception do raise EScriptRuntimeError.Create('Hardware Error: SegFault saat menulis memori!'); 
  end;
end;

// Mengalokasikan blok memori mentah baru yang bisa digunakan sebagai buffer DMA
function Native_MemAlloc(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var BufferSize: Integer; RawBuffer: Pointer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then 
    raise EScriptRuntimeError.Create('Hardware.alloc(size) membutuhkan 1 argumen numerik.');
    
  BufferSize := Trunc(TValue(Args[0]).NumVal);
  if BufferSize <= 0 then raise EScriptRuntimeError.Create('Ukuran alokasi memori tidak valid.');
  
  GetMem(RawBuffer, BufferSize);
  
  // PERBAIKAN: Trek memori DMA agar tidak bocor
  MemLock.Acquire;
  try
    if GlobalDMAPointers = nil then GlobalDMAPointers := TList.Create;
    GlobalDMAPointers.Add(RawBuffer);
  finally
    MemLock.Release;
  end;
  
  Result := TValue.CreatePtr(RawBuffer);
end;

// Membebaskan buffer DMA/Memori (Wajib dilakukan secara manual oleh script!)
function Native_MemFree(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var 
  RawBuffer: Pointer;
  IsValidPointer: Boolean;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then 
    raise EScriptRuntimeError.Create('Hardware.free(address_pointer) membutuhkan 1 argumen Pointer.');
    
  RawBuffer := TValue(Args[0]).PtrVal;
  IsValidPointer := False;

  if Assigned(RawBuffer) then 
  begin 
    MemLock.Acquire;
    try
      // VALIDASI MUTLAK: Pastikan pointer benar-benar milik alokator DMA VM kita
      if Assigned(GlobalDMAPointers) and (GlobalDMAPointers.IndexOf(RawBuffer) <> -1) then 
      begin
        GlobalDMAPointers.Remove(RawBuffer);
        IsValidPointer := True; 
      end;
    finally
      MemLock.Release;
    end;

    // HANYA lepaskan memori jika validasi sukses
    if IsValidPointer then
    begin
      try
        FreeMem(RawBuffer); 
        Result := TValue.CreateBool(True);
      except
        on E: Exception do 
          raise EScriptRuntimeError.Create('Hardware Error: Access Violation saat FreeMem! ' + E.Message);
      end;
    end
    else
    begin
      // MENCEGAH HOST CRASH AKIBAT EXPLOIT DOUBLE-FREE / INVALID POINTER
      raise EScriptRuntimeError.Create('Hardware Security Halt: Pointer memori tidak valid atau sudah dibebaskan!');
    end;
  end else Result := TValue.CreateBool(False);
end;

