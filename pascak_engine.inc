// 1. Sentralisasi Resolusi Ekstensi OS
function ResolveLibraryPath(const RawPath: string): string;
begin
  Result := RawPath;
  {$IFDEF WINDOWS}
  if ExtractFileExt(Result) = '' then Result := Result + '.dll';
  {$ENDIF}
  {$IFDEF UNIX}
  if ExtractFileExt(Result) = '' then
  begin
    {$IFDEF DARWIN}
    Result := Result + '.dylib';
    {$ELSE}
    Result := Result + '.so';
    {$ENDIF}
  end;
  {$ENDIF}
end;

// 2. Layer 1: Modul Whitelist Verifier (MD5 Signature)
function ValidateFFIWhitelist(const AbsolutePath: string): Boolean;
var
  FileSignature: string;
begin
  // Jika whitelist kosong/belum di-setup oleh Host App, demi keamanan tolak semua FFI
  if (FFIModuleWhitelist = nil) or (FFIModuleWhitelist.Count = 0) then Exit(False);
  
  try
    // Kalkulasi hash MD5 dari file fisik
    FileSignature := LowerCase(MD5Print(MD5File(AbsolutePath)));
    Result := FFIModuleWhitelist.IndexOf(FileSignature) <> -1;
  except
    Result := False; // Tolak jika file gagal dibaca/di-hash
  end;
end;

function Helper_LoadFFILibrary(const ArgPath: string; out LibHandle: TLibHandle): Boolean;
var
  RawPath, SafePath: string;
  IsNewLoad: Boolean;
begin
  Result := False;
  RawPath := ResolveLibraryPath(ArgPath);
  SafePath := GetSafeSandboxedPath(RawPath);

  if not SysUtils.FileExists(SafePath) then
    raise EScriptRuntimeError.Create('FFI Error: File tidak ditemukan di jalur -> ' + SafePath);

  if not ValidateFFIWhitelist(SafePath) then
    raise EScriptRuntimeError.Create('FFI Security Halt: Modul "' + ExtractFileName(SafePath) + '" ditolak (MD5 Signature Mismatch).');

  if InterlockedIncrement(GlobalFFIActiveCount) > GlobalFFIQuotaLimit then
  begin
    InterlockedDecrement(GlobalFFIActiveCount); // Rollback seketika
    raise EScriptRuntimeError.Create('FFI Security Halt: Batas maksimal load library (' + IntToStr(GlobalFFIQuotaLimit) + ') tercapai!');
  end;

  try
    LibHandle := LoadLibrary(SafePath);
    if LibHandle = NilHandle then
      raise EScriptRuntimeError.Create('FFI Error: Gagal memuat library. Pastikan arsitektur OS (32/64-bit) kompatibel.');

    // coba pakai context dulu
    if Assigned(GCurrentContext) and Assigned(GCurrentContext.LoadedDLLs) then
    begin
      IsNewLoad := GCurrentContext.LoadedDLLs.IndexOf(Pointer(LibHandle)) = -1;
      if IsNewLoad then
        GCurrentContext.LoadedDLLs.Add(Pointer(LibHandle));
    end
    else
    begin
      // Fallback ke global
      MemLock.Acquire;
      try
        if GlobalLoadedDLLs = nil then GlobalLoadedDLLs := TList.Create;
        IsNewLoad := GlobalLoadedDLLs.IndexOf(Pointer(LibHandle)) = -1;
        if IsNewLoad then
          GlobalLoadedDLLs.Add(Pointer(LibHandle));
      finally
        MemLock.Release;
      end;
    end;

    // Jika DLL sudah pernah di-load sebelumnya (OS melakukan re-use handle),
    // kembalikan kuota agar tidak bocor!
    if not IsNewLoad then
      InterlockedDecrement(GlobalFFIActiveCount);

    Result := True;
  except
    // PROTEKSI MUTLAK: Jika terjadi kegagalan apapun setelah kuota dipotong, kembalikan!
    InterlockedDecrement(GlobalFFIActiveCount);
    raise;
  end;
end;

function Native_LoadPlugin(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  LibHandle: TLibHandle;
  RegFunc: TPluginRegisterFunc;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then
    raise EScriptRuntimeError.Create('loadPlugin(library_path) membutuhkan tepat 1 argumen string.');

  // Panggil Helper Sentral: Menangani Quota, Sandbox, Lock, dan Whitelist secara atomik
  Helper_LoadFFILibrary(TValue(Args[0]).StrVal, LibHandle);

  Pointer(RegFunc) := GetProcAddress(LibHandle, 'PascakPluginInit');
  if not Assigned(RegFunc) then
    raise EScriptRuntimeError.Create('Plugin Error: Entry point "PascakPluginInit" tidak ditemukan. Ini bukan plugin Pascak yang valid.');

  try
    if not RegFunc(Pointer(CallEnv)) then
      raise EScriptRuntimeError.Create('Plugin Error: Plugin menolak inisialisasi (PascakPluginInit mengembalikan false).');
  except
    on E: Exception do
      raise EScriptRuntimeError.Create('Plugin Memory Boundary Exception: Terjadi Crash parah di dalam Native Module -> ' + E.Message);
  end;

  Result := TValue.CreateBool(True);
end;

function Native_LoadFileDLL(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  FuncName: string;
  LibHandle: TLibHandle;
  FuncPtr: Pointer;
begin 
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtString) or (TValue(Args[1]).DataType <> dtString) then
    raise EScriptRuntimeError.Create('loadFileDLL(dllPath, funcName) membutuhkan tepat 2 argumen string.');

  FuncName := TValue(Args[1]).StrVal;

  // Panggil Helper Sentral!
  Helper_LoadFFILibrary(TValue(Args[0]).StrVal, LibHandle);

  FuncPtr := GetProcAddress(LibHandle, PChar(FuncName));
  if FuncPtr = nil then
    raise EScriptRuntimeError.Create('DLL Error: Fungsi "' + FuncName + '" tidak ditemukan di dalam struktur export table library.');

  Result := TValue.CreateNative(TNativeRoutine(FuncPtr));
end;

function ParseFFISignature(const Sig: string; 
                            out ArgTypes: TFFIArgTypeArray;
                            out RetType: TFFIRetType; 
                            out ArgCount: Integer): Boolean;
var
  i, ArrowPos: Integer;
  Left, Right: string;
  C: Char;
begin
  Result := False;
  ArgCount := 0;
  SetLength(ArgTypes, 0);   // ✨ Pastikan clean state
  
  ArrowPos := Pos('->', Sig);
  if ArrowPos = 0 then Exit;
  
  Left := Trim(Copy(Sig, 1, ArrowPos - 1));
  Right := Trim(Copy(Sig, ArrowPos + 2, Length(Sig)));
  
  // Parse arg types (left side)
  SetLength(ArgTypes, Length(Left));
  for i := 1 to Length(Left) do
  begin
    C := Left[i];
    case C of
      'i': ArgTypes[ArgCount] := fatInt;
      'f': ArgTypes[ArgCount] := fatFloat;
      's': ArgTypes[ArgCount] := fatString;
      'S': ArgTypes[ArgCount] := fatStruct;
      'p': ArgTypes[ArgCount] := fatPointer;
      'I': ArgTypes[ArgCount] := fatInt;
      'C': ArgTypes[ArgCount] := fatPointer;   // ✅ F-3a-4: callback alias
    else   
      SetLength(ArgTypes, 0);
      Exit;
    end;
    Inc(ArgCount);
  end;
  SetLength(ArgTypes, ArgCount);
  
  // Parse return type (right side)
  if Length(Right) <> 1 then 
  begin
    SetLength(ArgTypes, 0);
    Exit;
  end;
  
  case Right[1] of
    'i': RetType := frtInt;
    'f': RetType := frtFloat;
    's': RetType := frtString;
    'S': RetType := frtStruct;
    'p': RetType := frtPointer;
    'v': RetType := frtVoid;
    'I': RetType := frtInt;   // ✅ F-2b-fix: size_t return → Int64
  else
    SetLength(ArgTypes, 0);
    Exit;
  end;
  
  Result := True;
end;

function Native_LoadFFITyped(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  LibPath, FuncName, Sig: string;
  LibHandle: TLibHandle;
  RawFunc: Pointer;
  WrapperDict: TDictValue;
  ArgTypes: TFFIArgTypeArray;
  RetType: TFFIRetType;
  ArgCount: Integer;
  i: Integer;
  ArgTypesArr: TValueList;
begin
  if (Args.Count <> 3) or (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtString) or (TValue(Args[2]).DataType <> dtString) then
    raise EScriptRuntimeError.Create('loadFFITyped(libPath, funcName, signature) butuh 3 argumen string');
  
  LibPath := TValue(Args[0]).StrVal;
  FuncName := TValue(Args[1]).StrVal;
  Sig := TValue(Args[2]).StrVal;
  
  // ✨ FIX: Inisialisasi eksplisit (hilangkan warning managed type)
  SetLength(ArgTypes, 0);
  RetType := frtVoid;
  ArgCount := 0;
  
  if not ParseFFISignature(Sig, ArgTypes, RetType, ArgCount) then
    raise EScriptRuntimeError.Create('Signature tidak valid: ' + Sig);
  
  // Load library
  Helper_LoadFFILibrary(LibPath, LibHandle);
  RawFunc := GetProcAddress(LibHandle, PChar(FuncName));
  if RawFunc = nil then
  begin
    SetLength(ArgTypes, 0);
    raise EScriptRuntimeError.Create('Fungsi tidak ditemukan: ' + FuncName);
  end;
  
  // Build wrapper dictionary
  WrapperDict := TDictValue.Create;
  try
    WrapperDict.SetValue('__ffi_raw', TValue.CreatePtr(RawFunc));
    WrapperDict.SetValue('__ffi_name', TValue.CreateStr(FuncName));
    WrapperDict.SetValue('__ffi_argc', TValue.CreateNum(ArgCount));
    WrapperDict.SetValue('__ffi_sig', TValue.CreateStr(Sig));   // ✨ PHASE 5
    
    // Store arg types as string array
    ArgTypesArr := TValueList.Create(True);
    try
      for i := 0 to ArgCount - 1 do
      begin
        case ArgTypes[i] of
          fatInt: ArgTypesArr.Add(TValue.CreateStr('i'));
          fatFloat: ArgTypesArr.Add(TValue.CreateStr('f'));
          fatString: ArgTypesArr.Add(TValue.CreateStr('s'));
          fatPointer: ArgTypesArr.Add(TValue.CreateStr('p'));
        end;
      end;
      WrapperDict.SetValue('__ffi_args', TValue.CreateArray(ArgTypesArr));
    except
      ArgTypesArr.Free;
      raise;
    end;
    
    // Store return type
    case RetType of
      frtInt: WrapperDict.SetValue('__ffi_ret', TValue.CreateStr('i'));
      frtFloat: WrapperDict.SetValue('__ffi_ret', TValue.CreateStr('f'));
      frtString: WrapperDict.SetValue('__ffi_ret', TValue.CreateStr('s'));
      frtPointer: WrapperDict.SetValue('__ffi_ret', TValue.CreateStr('p'));
      frtVoid: WrapperDict.SetValue('__ffi_ret', TValue.CreateStr('v'));
    end;
    
    Result := TValue.CreateDict(WrapperDict);
  except
    WrapperDict.Free;
    SetLength(ArgTypes, 0);
    raise;
  end;
  
  // Cleanup
  SetLength(ArgTypes, 0);
end;

//yield====================
//=========================
function IsValidVM(Ptr: Pointer): Boolean;
var 
  i: Integer;
begin
  Result := False;
  if not Assigned(GCRootLock) then Exit;
  GCRootLock.Acquire;
  try
    if Assigned(ActiveVMs) then
      for i := 0 to ActiveVMs.Count - 1 do
        if ActiveVMs[i] = Ptr then Exit(True);
  finally 
    GCRootLock.Release; 
  end;
end;

function Native_CoroutineFree(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  CoVM: TVM;
  PtrVal: Pointer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then
    raise EScriptRuntimeError.Create('coroutine_free() membutuhkan tepat 1 argumen berupa objek coroutine (pointer)!');
  
  PtrVal := TValue(Args[0]).PtrVal; 
  
  if IsValidVM(PtrVal) then
  begin
    CoVM := TVM(PtrVal); 
    
    // Matikan state agar Host Application tahu ini sudah tidak valid
    CoVM.FState := vmDead;
    
    // Panggil Free murni. TObject.Free akan memanggil TVM.Destroy 
    // yang SECARA OTOMATIS membersihkan seluruh Stack dan Closure Environment.
    CoVM.Free; 
    
    Result := TValue.CreateBool(True);
  end
  else
    Result := TValue.CreateBool(False);
end;

function Native_CoroutineCreate(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TargetFunc: TValue;
  CoVM: TVM;
begin Result := nil;
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtFunction) then
  begin
    Result := nil;
    raise EScriptRuntimeError.Create('coroutine.create() membutuhkan tepat 1 argumen fungsi!');
  end;

  TargetFunc := TValue(Args[0]);
  
  // Instansiasi Mesin VM Terpisah Khusus untuk Coroutine ini
  CoVM := TVM.Create(CallEnv.GetGlobal);
  
  // SETUP FRAME MANUAL (Tanpa memanggil CoVM.Run)
  // Ini memposisikan Instruction Pointer (IP) di angka 0, siap dieksekusi saat resume() pertama kali dipanggil
  CoVM.FTop := 0;
  CoVM.FFrameCount := 1;
  
  // PERBAIKAN LOGIKA (DANGLING POINTER): Gunakan Clone() untuk mempertahankan ownership
  // dari Argumen, mencegah memory corrupt jika object Args dihapus oleh Caller
  CoVM.FFrames[0].FuncValue := TargetFunc.Clone;
  
  // : Gunakan .Chunk, bukan .CompiledChunk
  CoVM.FFrames[0].Chunk := TargetFunc.FuncVal.Chunk;
  CoVM.FFrames[0].IP := 0;
  CoVM.FFrames[0].BaseSlot := 0;
  
  // <-- PERBAIKAN LOGIKA: Prioritaskan ClosureEnv agar lexical scoping dari outer function tetap hidup
  if Assigned(TargetFunc.ClosureEnv) then
    CoVM.FFrames[0].Env := TargetFunc.ClosureEnv
  else
    CoVM.FFrames[0].Env := CallEnv.GetGlobal;
    
  CoVM.FFrames[0].Env.Retain;
  
  // Set state awal bahwa coroutine ini siap dijalankan
  CoVM.FState := vmReady; 
  
  // Bungkus pointer memory ke dalam TValue agar bisa dikontrol oleh script
  Result := TValue.CreatePtr(Pointer(CoVM)); 
end;

function Native_CoroutineResume(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  CoVM: TVM;
  PtrVal: Pointer;
  ArgToYield: TValue;
begin
  Result := nil;
  if (Args.Count < 1) or (TValue(Args[0]).DataType <> dtPointer) then
    raise EScriptRuntimeError.Create('resume() membutuhkan argumen pertama berupa objek coroutine!');
  
  PtrVal := TValue(Args[0]).PtrVal; 
  if not IsValidVM(PtrVal) then
    raise EScriptRuntimeError.Create('Coroutine Error: Coroutine sudah mati atau dihapus dari memori.');
    
  CoVM := TVM(PtrVal); 

  ArgToYield := nil;
  if (Args.Count > 1) and Assigned(Args[1]) then
    ArgToYield := TValue(Args[1]).Clone
  else
    ArgToYield := TValue.CreateNull; 

  // PERBAIKAN LOGIKA: Bungkus Resume dalam try..finally agar ArgToYield pasti di-Free oleh pemanggil
  try
    Result := CoVM.Resume(ArgToYield);
  finally
    ArgToYield.Free;
  end;
end;

function Native_Eval(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  CodeStr: string;
  SubLex: TLexer; SubPars: TParser; SubRoot: TBlockNode;
  SubComp: TCompiler; SubVM: TVM; RawRes: TValue;
begin 
  Result := nil; // KOREKSI: Jangan alokasikan obyek dulu. Cukup nil.
  
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then
    raise EScriptRuntimeError.Create('Fatal Error: fungsi eval() membutuhkan tepat 1 argumen bertipe string.');

  CodeStr := TValue(Args[0]).StrVal;

  // [PERBAIKAN]: Inisialisasi nil sebelum try agar aman dibersihkan
  SubLex  := nil;
  SubPars := nil;
  SubRoot := nil;
  SubComp := nil;
  SubVM := nil;
  try
    SubLex  := TLexer.Create(CodeStr);
    SubPars := TParser.Create(SubLex);
    SubRoot := SubPars.ParseMainProgram; 
    if SubRoot <> nil then
    begin
      try 
        SubComp := TCompiler.Create;
        SubVM := TVM.Create(CallEnv.GetGlobal);
        try
          SubComp.Compile(SubRoot, True);
          SubComp.Chunk.OptimizeBytecode;
          
          RawRes := SubVM.Run(SubComp.Chunk);
          
          if Assigned(RawRes) then
            Result := RawRes; // Transfer ownership secara langsung (tanpa alokasi ganda)
            
        finally
          SubVM.Free;
          SubComp.Free;
        end;
      finally
        SubRoot.Free;
      end;
    end;
  finally
    // TObject.Free pada FPC otomatis mengabaikan pemanggilan jika object bernilai nil
    if Assigned(SubPars) then SubPars.Free;
    if Assigned(SubLex) then SubLex.Free;
  end;
  
  // Fallback pengaman absolut jika eksekusi gagal/kosong
  if Result = nil then Result := TValue.CreateNull;
end;

function EnsureTestContext: TTestContext;
begin
  if not Assigned(GTestContext) then
    GTestContext := TTestContext.Create;
  Result := GTestContext;
end;

procedure FormatAssertionError(const ATestName, AMessage: string);
begin
  IOLock.Acquire;
  try
    Writeln('  ✗ FAIL: ', ATestName);
    if AMessage <> '' then
      Writeln('    ', AMessage);
  finally
    IOLock.Release;
  end;
end;

procedure FormatAssertionPass(const ATestName: string);
begin
  // Silent pass untuk menghindari noise. Bisa diaktifkan dengan flag.
  {$IFDEF VERBOSE_TESTS}
  IOLock.Acquire;
  try
    Writeln('  ✓ PASS: ', ATestName);
  finally
    IOLock.Release;
  end;
  {$ENDIF}
end;

function Native_AssertEqual(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Expected, Actual: TValue;
  Msg, Name: string;
  Ctx: TTestContext;
  IsEqual: Boolean;
begin
  if (Args.Count < 2) or (Args.Count > 3) then
    raise EScriptRuntimeError.Create('assertEqual(expected, actual, [msg]) butuh 2-3 argumen');
  
  Ctx := EnsureTestContext;
  Inc(Ctx.TotalTests);
  
  Expected := TValue(Args[0]);
  Actual := TValue(Args[1]);
  if Args.Count = 3 then
    Msg := TValueToString(TValue(Args[2]), False)
  else
    Msg := '';
  
  IsEqual := ValuesAreEqual(Expected, Actual);
  
  if IsEqual then
  begin
    Inc(Ctx.PassedTests);
    FormatAssertionPass('assertEqual');
  end
  else
  begin
    Inc(Ctx.FailedTests);
    Name := Format('assertEqual: expected %s, got %s',
      [TValueToString(Expected, False), TValueToString(Actual, False)]);
    if Msg <> '' then Name := Msg + ' — ' + Name;
    Ctx.LastFailure := Name;
    FormatAssertionError('assertEqual', Name);
  end;
  
  Result := TValue.CreateBool(IsEqual);
end;

function Native_AssertTrue(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  V: TValue;
  Msg: string;
  Ctx: TTestContext;
  IsTruthy: Boolean;
begin
  if (Args.Count < 1) or (Args.Count > 2) then
    raise EScriptRuntimeError.Create('assertTrue(value, [msg]) butuh 1-2 argumen');
  
  Ctx := EnsureTestContext;
  Inc(Ctx.TotalTests);
  
  V := TValue(Args[0]);
  IsTruthy := V.IsTrue;
  if Args.Count = 2 then
    Msg := TValueToString(TValue(Args[1]), False)
  else
    Msg := '';
  
  if IsTruthy then
  begin
    Inc(Ctx.PassedTests);
    FormatAssertionPass('assertTrue');
  end
  else
  begin
    Inc(Ctx.FailedTests);
    if Msg = '' then Msg := 'assertTrue: nilai bukan truthy';
    Ctx.LastFailure := Msg;
    FormatAssertionError('assertTrue', Msg);
  end;
  
  Result := TValue.CreateBool(IsTruthy);
end;

