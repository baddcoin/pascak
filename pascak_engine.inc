// QuickSort Ekstrim Cepat untuk kalkulasi Statistik
procedure QuickSortDouble(var A: array of Double; iLo, iHi: Integer);
var
  Lo, Hi: Integer;
  Pivot, T: Double;
begin
  Lo := iLo;
  Hi := iHi;
  Pivot := A[(Lo + Hi) div 2];
  repeat
    while A[Lo] < Pivot do Inc(Lo);
    while A[Hi] > Pivot do Dec(Hi);
    if Lo <= Hi then
    begin
      T := A[Lo]; A[Lo] := A[Hi]; A[Hi] := T;
      Inc(Lo); Dec(Hi);
    end;
  until Lo > Hi;
  if Hi > iLo then QuickSortDouble(A, iLo, Hi);
  if Lo < iHi then QuickSortDouble(A, Lo, iHi);
end;

function GetDoubleArray(Args: TObjectList; FuncName: string; out Arr: TDoubleArray): Boolean;
var
  V, Item: TValue;
  i: Integer;
begin
  Result := False;
  if Args.Count <> 1 then raise EScriptRuntimeError.Create(FuncName + ' butuh tepat 1 argumen array!');
  
  V := TValue(Args[0]);
  if V.DataType <> dtArray then 
  raise EScriptRuntimeError.Create(FuncName + ' mendeteksi argumen non-array!');
  
  V.ArrayVal.FLock.Acquire; // <-- KUNCI ARRAY SEBELUM LOOPING!
  try
      if V.ArrayVal.Count = 0 then Exit(True);
      SetLength(Arr, V.ArrayVal.Count); 
      for i := 0 to V.ArrayVal.Count - 1 do
      begin
        Item := V.ArrayVal[i];
        if Item.DataType <> dtNumeric then 
          raise EScriptRuntimeError.Create(FuncName + ' gagal: Elemen bukan angka!');
        Arr[i] := Item.NumVal;
      end;
  finally
      V.ArrayVal.FLock.Release;
  end;
  Result := True;
end;

function Native_StatSum(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var Arr: array of Double; i: Integer; Sum: Double;
begin
  if not GetDoubleArray(Args, 'statSum()', Arr) or (Length(Arr) = 0) then Exit(TValue.CreateNum(0));
  Sum := 0;
  for i := Low(Arr) to High(Arr) do Sum := Sum + Arr[i];
  Result := TValue.CreateNum(Sum);
end;

// MEAN (Rata-rata)
function Native_StatMean(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var Arr: array of Double; i: Integer; Sum: Double;
begin
  if not GetDoubleArray(Args, 'statMean()', Arr) or (Length(Arr) = 0) then Exit(TValue.CreateNull);
  Sum := 0;
  for i := Low(Arr) to High(Arr) do Sum := Sum + Arr[i];
  Result := TValue.CreateNum(Sum / Length(Arr));
end;

// MEDIAN (Nilai Tengah)
function Native_StatMedian(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Arr: array of Double;
  Len, Mid: Integer;
begin
  if not GetDoubleArray(Args, 'statMedian()', Arr) or (Length(Arr) = 0) then Exit(TValue.CreateNull);
  Len := Length(Arr);
  
  // Gunakan QuickSort, jauh lebih cepat daripada Bubble Sort!
  QuickSortDouble(Arr, 0, Len - 1);

  Mid := Len div 2;
  if (Len mod 2) = 0 then Result := TValue.CreateNum((Arr[Mid - 1] + Arr[Mid]) / 2)
  else Result := TValue.CreateNum(Arr[Mid]);
end;

function Native_StatMode(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Arr: array of Double;
  i, Len, MaxCount, CurrCount: Integer;
  CurrentVal, ModeVal: Double;
begin
  if not GetDoubleArray(Args, 'statMode()', Arr) or (Length(Arr) = 0) then Exit(TValue.CreateNull);
  Len := Length(Arr);
  
  QuickSortDouble(Arr, 0, Len - 1);
  
  MaxCount := 1; CurrCount := 1;
  ModeVal := Arr[0]; CurrentVal := Arr[0];
  
  for i := 1 to Len - 1 do
  begin
    if SameValue(Arr[i], CurrentVal, 1E-12) then
      Inc(CurrCount)
    else
    begin
      if CurrCount > MaxCount then
      begin
        MaxCount := CurrCount;
        ModeVal := CurrentVal;
      end;
      CurrentVal := Arr[i];
      CurrCount := 1;
    end;
  end;
  
  // Pengecekan elemen terakhir
  if CurrCount > MaxCount then ModeVal := CurrentVal;
  
  Result := TValue.CreateNum(ModeVal);
end;

// VARIANCE (Varian Sampel)
function Native_StatVariance(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Arr: array of Double;
  Mean, SumSq: Double;
  i, Len: Integer;
begin
  if not GetDoubleArray(Args, 'statVariance()', Arr) then Exit(TValue.CreateNull);
  Len := Length(Arr);
  if Len <= 1 then Exit(TValue.CreateNum(0)); // Standar deviasi butuh >= 2 sampel
  
  Mean := 0;
  for i := 0 to Len - 1 do Mean := Mean + Arr[i];
  Mean := Mean / Len;

  SumSq := 0;
  for i := 0 to Len - 1 do SumSq := SumSq + Sqr(Arr[i] - Mean);

  Result := TValue.CreateNum(SumSq / (Len - 1));
end;

// STDDEV (Standar Deviasi)
function Native_StatStdDev(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var VarVal: TValue;
begin
  // Manfaatkan fungsi variance yang sudah ada untuk mencari akar kuadrat
  VarVal := Native_StatVariance(Args, CallEnv);
  try
    if VarVal.DataType = dtNull then Result := TValue.CreateNull
    else Result := TValue.CreateNum(Sqrt(VarVal.NumVal));
  finally
    VarVal.Free; // Cegah leak instance internal fungsi
  end;
end;

// EMA (Exponential Moving Average)
// Argumen: [Array_Harga: Numeric], [Periode: Numeric]
function Native_StatEMA(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Arr: array of Double;
  Period, i, Len: Integer;
  Multiplier, PrevEMA: Double;
  ResArr: TValueList;
begin
  if (Args.Count <> 2) or (TValue(Args[1]).DataType <> dtNumeric) then 
    raise EScriptRuntimeError.Create('statEMA(dataArray, period) membutuhkan 2 argumen.');

  if not GetDoubleArray(Args, 'statEMA()', Arr) then Exit(TValue.CreateNull);
  
  Len := Length(Arr);
  Period := Trunc(TValue(Args[1]).NumVal);
  if (Period <= 0) or (Len = 0) then Exit(TValue.CreateNull);
  if Period > Len then Period := Len;

  ResArr := TValueList.Create(True);
  try
    Multiplier := 2.0 / (Period + 1);
    
    // SMA awal sebagai EMA pertama
    PrevEMA := 0;
    for i := 0 to Period - 1 do PrevEMA := PrevEMA + Arr[i];
    PrevEMA := PrevEMA / Period;
    
    // Pad elemen awal dengan Null hingga periode tercapai (standar chart)
    for i := 0 to Period - 2 do ResArr.Add(TValue.CreateNull);
    ResArr.Add(TValue.CreateNum(PrevEMA));

    // Kalkulasi EMA selanjutnya
    for i := Period to Len - 1 do
    begin
      PrevEMA := ((Arr[i] - PrevEMA) * Multiplier) + PrevEMA;
      ResArr.Add(TValue.CreateNum(PrevEMA));
    end;
    
    Result := TValue.CreateArray(ResArr);
  except
    ResArr.Free;
    raise;
  end;
end;

// RSI (Relative Strength Index)
// Argumen: [Array_Harga: Numeric], [Periode: Numeric (default 14)]
function Native_StatRSI(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Arr: array of Double;
  Period, i, Len: Integer;
  Change, Gain, Loss, AvgGain, AvgLoss, RS: Double;
  ResArr: TValueList;
begin
  if (Args.Count <> 2) or (TValue(Args[1]).DataType <> dtNumeric) then 
    raise EScriptRuntimeError.Create('statRSI(dataArray, period) membutuhkan 2 argumen.');

  if not GetDoubleArray(Args, 'statRSI()', Arr) then Exit(TValue.CreateNull);
  
  Len := Length(Arr);
  Period := Trunc(TValue(Args[1]).NumVal);
  if (Period <= 0) or (Len <= Period) then Exit(TValue.CreateNull);

  ResArr := TValueList.Create(True);
  try
    AvgGain := 0; AvgLoss := 0;

    // Pad elemen awal dengan Null
    for i := 0 to Period - 1 do ResArr.Add(TValue.CreateNull);

    // Initial Average Gain/Loss
    for i := 1 to Period do
    begin
      Change := Arr[i] - Arr[i - 1];
      if Change > 0 then AvgGain := AvgGain + Change
      else AvgLoss := AvgLoss + Abs(Change);
    end;
    AvgGain := AvgGain / Period;
    AvgLoss := AvgLoss / Period;

    if AvgLoss = 0 then ResArr.Add(TValue.CreateNum(100.0))
    else
    begin
      RS := AvgGain / AvgLoss;
      ResArr.Add(TValue.CreateNum(100.0 - (100.0 / (1.0 + RS))));
    end;

    // Smoothed RSI Calculation (Wilder's Smoothing)
    for i := Period + 1 to Len - 1 do
    begin
      Change := Arr[i] - Arr[i - 1];
      Gain := 0; Loss := 0;
      if Change > 0 then Gain := Change else Loss := Abs(Change);

      AvgGain := ((AvgGain * (Period - 1)) + Gain) / Period;
      AvgLoss := ((AvgLoss * (Period - 1)) + Loss) / Period;

      if AvgLoss = 0 then ResArr.Add(TValue.CreateNum(100.0))
      else
      begin
        RS := AvgGain / AvgLoss;
        ResArr.Add(TValue.CreateNum(100.0 - (100.0 / (1.0 + RS))));
      end;
    end;

    Result := TValue.CreateArray(ResArr);
  except
    ResArr.Free;
    raise;
  end;
end;

//enumerate===============
//========================
function Native_Enumerate(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Target: TValue;
  OuterArr, InnerArr: TValueList;
  i, j, CharLen: Integer; 
  TempKeys: TStringArray;
  TempArrayRefs: array of TValue;
begin
  if Args.Count <> 1 then 
    raise EScriptRuntimeError.Create('enumerate() membutuhkan tepat 1 argumen koleksi');
    
  Target := TValue(Args[0]);
  OuterArr := TValueList.Create(True);
  SetLength(TempArrayRefs, 0); // Inisialisasi awal
  
  try
    if Target.DataType = dtArray then
    begin
      Target.ArrayVal.FLock.Acquire;
      try
        SetLength(TempArrayRefs, Target.ArrayVal.Count);
        for i := 0 to Target.ArrayVal.Count - 1 do
          TempArrayRefs[i] := Target.ArrayVal[i].Clone;
      finally
        Target.ArrayVal.FLock.Release;
      end;

      // [PERBAIKAN LOGIKA]: Memindahkan try..except ke dalam loop agar presisi
      for i := 0 to High(TempArrayRefs) do
      begin
        InnerArr := TValueList.Create(True);
        try
          InnerArr.Add(TValue.CreateNum(i));               
          InnerArr.Add(TempArrayRefs[i]);          
          
          TempArrayRefs[i] := nil; 
          
          OuterArr.Add(TValue.CreateArray(InnerArr));
        except
          InnerArr.Free;
          raise;
        end;
      end;
    end else 
    
    if Target.DataType = dtString then
    begin
      i := 1;
      while i <= Length(Target.StrVal) do
      begin
        InnerArr := TValueList.Create(True);
        try
          InnerArr.Add(TValue.CreateNum(OuterArr.Count)); 
          CharLen := GetUTF8CharLen(Target.StrVal, i);
          InnerArr.Add(TValue.CreateStr(Copy(Target.StrVal, i, CharLen)));
          Inc(i, CharLen);
          OuterArr.Add(TValue.CreateArray(InnerArr));
        except
          InnerArr.Free;
          raise;
        end;
      end;
    end else 
    
    if Target.DataType = dtDict then
    begin
      Target.DictVal.FLock.Acquire;
      try
        TempKeys := Target.DictVal.GetKeys;
        SetLength(TempArrayRefs, Length(TempKeys));
        for i := 0 to High(TempKeys) do
        begin
          if Assigned(Target.DictVal.GetValue(TempKeys[i])) then
            TempArrayRefs[i] := Target.DictVal.GetValue(TempKeys[i]).Clone
          else
            TempArrayRefs[i] := TValue.CreateNull;
        end;
      finally
        Target.DictVal.FLock.Release;
      end;

      // [PERBAIKAN LOGIKA]: Sama seperti array, memindahkan try..except ke dalam loop
      for i := 0 to High(TempKeys) do
      begin
        InnerArr := TValueList.Create(True);
        try
          InnerArr.Add(TValue.CreateStr(TempKeys[i]));      
          InnerArr.Add(TempArrayRefs[i]);                 
          
          TempArrayRefs[i] := nil; 
          
          OuterArr.Add(TValue.CreateArray(InnerArr));
        except
          InnerArr.Free;
          raise;
        end;
      end;
      SetLength(TempKeys, 0);
    end
    else
      raise EScriptRuntimeError.Create('Argumen enumerate() harus berupa Array, String, atau Dictionary');
      
  except
    OuterArr.Free;
    // Bersihkan elemen yatim-piatu jika iterasi utama gagal
    for j := 0 to High(TempArrayRefs) do
      if Assigned(TempArrayRefs[j]) then TempArrayRefs[j].Free;
    raise;
  end;

  SetLength(TempArrayRefs, 0);
  Result := TValue.CreateArray(OuterArr);
end;

