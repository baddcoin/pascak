function Native_RegExMatch(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Regex: TRegExpr;
  Pattern, TextTarget: string;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtString) or (TValue(Args[1]).DataType <> dtString) then
    raise EScriptRuntimeError.Create('Fungsi regExMatch(pattern, text) membutuhkan 2 argumen string.');
    
  Pattern := TValue(Args[0]).StrVal;
  TextTarget := TValue(Args[1]).StrVal;
  
  Regex := TRegExpr.Create;
  try
    // Amankan proses kompilasi Regex Pattern
    try
      Regex.Expression := Pattern; 
      Result := TValue.CreateBool(Regex.Exec(TextTarget));
    except
      on E: Exception do raise EScriptRuntimeError.Create('RegEx Syntax Error: ' + E.Message);
    end;
  finally
    Regex.Free;
  end;
end;

function Native_RegExReplace(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Regex: TRegExpr;
  Pattern, TextTarget, ReplaceWith, ResStr: string;
begin
  if (Args.Count <> 3) or (TValue(Args[0]).DataType <> dtString) or 
     (TValue(Args[1]).DataType <> dtString) or (TValue(Args[2]).DataType <> dtString) then
    raise EScriptRuntimeError.Create('Fungsi regExReplace(pattern, target, replaceWith) membutuhkan 3 argumen string.');
    
  Pattern := TValue(Args[0]).StrVal;
  TextTarget := TValue(Args[1]).StrVal;
  ReplaceWith := TValue(Args[2]).StrVal;
  
  Regex := TRegExpr.Create;
  try
    // Amankan penugasan Expression
    try
      Regex.Expression := Pattern;
      ResStr := Regex.Replace(TextTarget, ReplaceWith, True);
    except
      on E: Exception do raise EScriptRuntimeError.Create('RegEx Execution Error: ' + E.Message);
    end;
    
    if Length(ResStr) > strMax then
      raise EScriptRuntimeError.Create('Security Error: Hasil regExReplace melampaui batas string memori maksimal!');
      
    Result := TValue.CreateStr(ResStr);
  finally
    Regex.Free;
  end;
end;

