function BuiltIn_String_Split(TargetObj: TValue; const Args: array of TValue): TValue;
var
  Sep: string; TempList: TStringArray; NewArr: TValueList;
  i, CharLen: Integer;
begin
  if (Length(Args) <> 1) or (Args[0].DataType <> dtString) then
  begin
    errMSG.callerror(144, 'String.split(sep) butuh 1 argumen string', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull); // DIPERBAIKI
  end;

  Sep := Args[0].StrVal;
  NewArr := TValueList.Create(True);
  
  try
    if Sep = '' then
    begin
      // KEMBANGKAN: Kapasitas array diatur di awal agar mencegah realokasi RAM saat loop (Sangat Cepat)
      NewArr.Capacity := Length(TargetObj.StrVal);
      i := 1;
      while i <= Length(TargetObj.StrVal) do
      begin
        CharLen := GetUTF8CharLen(TargetObj.StrVal, i);
        NewArr.Add(TValue.CreateStr(Copy(TargetObj.StrVal, i, CharLen)));
        Inc(i, CharLen);
      end;
    end else
    begin
      TempList := TargetObj.StrVal.Split([Sep]);
      NewArr.Capacity := Length(TempList); // Pre-alokasi RAM
      for i := 0 to High(TempList) do NewArr.Add(TValue.CreateStr(TempList[i]));
    end;
  except
    NewArr.Free;
    raise EScriptRuntimeError.Create('VM Memory Error: Gagal mengalokasikan hasil split()');
  end;
  Result := TValue.CreateArray(NewArr);
end;

function BuiltIn_String_StartsWith(TargetObj: TValue; const Args: array of TValue): TValue;
var SearchStr: string;
begin
  if (Length(Args) <> 1) or (Args[0].DataType <> dtString) then
    errMSG.callerror(144, 'String.startsWith(str) butuh 1 argumen string', errMSG.xrow, errMSG.xcol);
    
  SearchStr := Args[0].StrVal;
  // Pos() = 1 berarti string ditemukan tepat di karakter pertama
  Result := TValue.CreateBool(Pos(SearchStr, TargetObj.StrVal) = 1);
end;

function BuiltIn_String_EndsWith(TargetObj: TValue; const Args: array of TValue): TValue;
var TargetStr, SearchStr: string; L1, L2: Integer;
begin
  if (Length(Args) <> 1) or (Args[0].DataType <> dtString) then
    errMSG.callerror(144, 'String.endsWith(str) butuh 1 argumen string', errMSG.xrow, errMSG.xcol);
    
  TargetStr := TargetObj.StrVal; 
  SearchStr := Args[0].StrVal;
  L1 := Length(TargetStr); 
  L2 := Length(SearchStr);
  
  if L2 > L1 then Result := TValue.CreateBool(False)
  else Result := TValue.CreateBool(Copy(TargetStr, L1 - L2 + 1, L2) = SearchStr);
end;

