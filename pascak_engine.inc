function Native_StructFree(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  StructVal: PNativeStructValue;
  i: Integer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then
  begin
    errMSG.callerror(139, 'native.structFree(value) butuh 1 argumen pointer',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  StructVal := PNativeStructValue(TValue(Args[0]).PtrVal);
  if (StructVal = nil) or (StructVal^.Magic <> STRUCT_VALUE_MAGIC) then
    Exit(TValue.CreateBool(False));   // idempotent
  
  // Mark as freed dulu
  StructVal^.Magic := 0;
  
  // Remove dari registry
  if Assigned(GStructLock) then
  begin
    GStructLock.Acquire;
    try
      if Assigned(GStructValueRegistry) then
      begin
        i := GStructValueRegistry.IndexOf(StructVal);
        if i >= 0 then
          GStructValueRegistry.Delete(i);
      end;
    finally
      GStructLock.Release;
    end;
  end;
  
  if Assigned(StructVal^.Data) then
  begin
    FreeMem(StructVal^.Data);
    StructVal^.Data := nil;
  end;
  
  Dispose(StructVal);
  Result := TValue.CreateBool(True);
end;

function Native_StructTypeFree(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TypePtr: PNativeStructType;
  i: Integer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then
  begin
    errMSG.callerror(139, 'native.structTypeFree(type) butuh 1 argumen pointer',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  TypePtr := PNativeStructType(TValue(Args[0]).PtrVal);
  if (TypePtr = nil) or (TypePtr^.Magic <> STRUCT_TYPE_MAGIC) then
    Exit(TValue.CreateBool(False));
  
  TypePtr^.Magic := 0;
  FreeFFITypeForStruct(TypePtr);
  
  if Assigned(GStructLock) then
  begin
    GStructLock.Acquire;
    try
      if Assigned(GStructTypeRegistry) then
      begin
        i := GStructTypeRegistry.IndexOf(TypePtr);
        if i >= 0 then
          GStructTypeRegistry.Delete(i);
      end;
    finally
      GStructLock.Release;
    end;
  end;
  
  SetLength(TypePtr^.Fields, 0);
  Dispose(TypePtr);
  Result := TValue.CreateBool(True);
end;

//introspection====================================================================
//F-3a-5b: introspection — baca ukuran dan layout ffi_type yang dibangun.
//Berguna untuk verifikasi bahwa construction benar sebelum interop C.
//=================================================================================
function Native_StructFFITypeInfo(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TypePtr: PNativeStructType;
  Dict: TDictValue;
  ElemArray: PPointer;
  ElemCount: Integer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then
  begin
    errMSG.callerror(139, 
      'native.structFFITypeInfo(type) butuh 1 argumen pointer',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  TypePtr := PNativeStructType(TValue(Args[0]).PtrVal);
  if (TypePtr = nil) or (TypePtr^.Magic <> STRUCT_TYPE_MAGIC) then
  begin
    errMSG.callerror(155, 'native.structFFITypeInfo: struct type tidak valid',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Dict := TDictValue.Create;
  try
    Dict.SetValue('name', TValue.CreateStr(TypePtr^.Name));
    Dict.SetValue('totalSize', TValue.CreateNum(TypePtr^.TotalSize));
    Dict.SetValue('maxAlignment', TValue.CreateNum(TypePtr^.MaxAlignment));
    Dict.SetValue('ffiTypePtr', TValue.CreatePtr(TypePtr^.FFIType));
    Dict.SetValue('ffiTypeNonNull', 
      TValue.CreateBool(TypePtr^.FFIType <> nil));
    
    // Baca header ffi_type yang sudah dibangun untuk verifikasi
    if TypePtr^.FFIType <> nil then
    begin
      Dict.SetValue('ffiSize', 
        TValue.CreateNum(PNativeUInt(PByte(TypePtr^.FFIType) + 0)^));
      Dict.SetValue('ffiAlignment',
        TValue.CreateNum(PWord(PByte(TypePtr^.FFIType) + 8)^));
      Dict.SetValue('ffiTypeTag',
        TValue.CreateNum(PWord(PByte(TypePtr^.FFIType) + 10)^));
    end;
    
    // Count elements sampai NULL terminator
    if TypePtr^.FFITypeElements <> nil then
    begin
      ElemArray := PPointer(TypePtr^.FFITypeElements);
      ElemCount := 0;
      while ElemArray[ElemCount] <> nil do
        Inc(ElemCount);
      Dict.SetValue('elementCount', TValue.CreateNum(ElemCount));
    end;
    
    Result := TValue.CreateDict(Dict);
  except
    Dict.Free;
    raise;
  end;
end;

