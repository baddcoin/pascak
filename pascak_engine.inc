// Build TValue array dari TStringList
function StringListToTValueArray(const L: TStringList): TValue;
var
  Arr: TValueList;
  I: Integer;
begin
  Arr := TValueList.Create(True);
  try
    for I := 0 to L.Count - 1 do
      Arr.Add(TValue.CreateStr(L[I]));
    Result := TValue.CreateArray(Arr);
  except
    Arr.Free;
    raise;
  end;
end;

// pkg.install(registryDir, [projectDir]) → dict
//   {ok: bool, installed: [str], error: str}
function Native_PkgInstall(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  RegistryDir, ProjectDir: string;
  List: TStringList;
  Err: string;
  Dict: TDictValue;
  Ok: Boolean;
begin
  if (Args.Count < 1) or (Args.Count > 2) then
  begin
    errMSG.callerror(144, 'pkg.install(registryDir, [projectDir]) butuh 1-2 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  if TValue(Args[0]).DataType <> dtString then
  begin
    errMSG.callerror(139, 'pkg.install: registryDir harus string',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  RegistryDir := TValue(Args[0]).StrVal;
  ProjectDir := '';

  if Args.Count >= 2 then
  begin
    if TValue(Args[1]).DataType <> dtString then
    begin
      errMSG.callerror(139, 'pkg.install: projectDir harus string',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;
    ProjectDir := TValue(Args[1]).StrVal;
  end;

  // Default: current directory
  if ProjectDir = '' then
    ProjectDir := GetCurrentDir;

  // Registry dir: resolve relative ke cwd kalau bukan absolut
  if not ((Length(RegistryDir) > 0) and (RegistryDir[1] = '/')) then
    RegistryDir := GetCurrentDir + PathDelim + RegistryDir;

  List := TStringList.Create;
  try
    Ok := PSInstallProject(RegistryDir, ProjectDir, List, Err);

    Dict := TDictValue.Create;
    try
      Dict.SetValue('ok', TValue.CreateBool(Ok));
      if Ok then
      begin
        Dict.SetValue('installed', StringListToTValueArray(List));
        Dict.SetValue('projectDir', TValue.CreateStr(ProjectDir));
      end
      else
        Dict.SetValue('error', TValue.CreateStr(Err));
    except
      Dict.Free;
      raise;
    end;

    Result := TValue.CreateDict(Dict);
  finally
    List.Free;
  end;
end;

// pkg.list([projectDir]) → dict
//   {ok: bool, packages: [str], error: str}
function Native_PkgList(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  ProjectDir: string;
  List: TStringList;
  Err: string;
  Dict: TDictValue;
  Ok: Boolean;
begin
  if Args.Count > 1 then
  begin
    errMSG.callerror(144, 'pkg.list([projectDir]) maksimal 1 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  ProjectDir := '';
  if Args.Count = 1 then
  begin
    if TValue(Args[0]).DataType <> dtString then
    begin
      errMSG.callerror(139, 'pkg.list: projectDir harus string',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;
    ProjectDir := TValue(Args[0]).StrVal;
  end;

  if ProjectDir = '' then
    ProjectDir := GetCurrentDir;

  List := TStringList.Create;
  try
    Ok := PSListInstalled(ProjectDir, List, Err);

    Dict := TDictValue.Create;
    try
      Dict.SetValue('ok', TValue.CreateBool(Ok));
      if Ok then
      begin
        Dict.SetValue('packages', StringListToTValueArray(List));
        Dict.SetValue('projectDir', TValue.CreateStr(ProjectDir));
      end
      else
        Dict.SetValue('error', TValue.CreateStr(Err));
    except
      Dict.Free;
      raise;
    end;

    Result := TValue.CreateDict(Dict);
  finally
    List.Free;
  end;
end;

// pkg.resolve(registryDir, manifestPath) → dict
//   {ok: bool, resolved: dict, error: str}
//   resolved = {name: {version, url, integrity}}
function Native_PkgResolve(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  RegistryDir, ManifestPath: string;
  M: TPSManifest;
  Reg: TPSLocalRegistry;
  Resolver: TPSResolver;
  L: TPSLockfile;
  Err: string;
  Dict, ResolvedDict, EntryDict: TDictValue;
  I: Integer;
  R: TPSResolved;
begin
  if Args.Count <> 2 then
  begin
    errMSG.callerror(144, 'pkg.resolve(registryDir, manifestPath) butuh 2 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  if (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'pkg.resolve: kedua argumen harus string',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  RegistryDir := TValue(Args[0]).StrVal;
  ManifestPath := TValue(Args[1]).StrVal;

  if not ((Length(RegistryDir) > 0) and (RegistryDir[1] = '/')) then
    RegistryDir := GetCurrentDir + PathDelim + RegistryDir;
  if not ((Length(ManifestPath) > 0) and (ManifestPath[1] = '/')) then
    ManifestPath := GetCurrentDir + PathDelim + ManifestPath;

  Dict := TDictValue.Create;
  try
    M := TPSManifest.Create;
    try
      if not PSManifestLoad(ManifestPath, M) then
      begin
        Dict.SetValue('ok', TValue.CreateBool(False));
        Dict.SetValue('error', TValue.CreateStr('gagal parse manifest'));
        Exit(TValue.CreateDict(Dict));
      end;

      if not PSManifestValidate(M, Err) then
      begin
        Dict.SetValue('ok', TValue.CreateBool(False));
        Dict.SetValue('error', TValue.CreateStr('manifest tidak valid: ' + Err));
        Exit(TValue.CreateDict(Dict));
      end;

      Reg := TPSLocalRegistry.Create(RegistryDir);
      try
        Resolver := TPSResolver.Create(Reg);
        L := TPSLockfile.Create;
        try
          if not Resolver.Resolve(M, L, Err) then
          begin
            Dict.SetValue('ok', TValue.CreateBool(False));
            Dict.SetValue('error', TValue.CreateStr('resolve gagal: ' + Err));
            Exit(TValue.CreateDict(Dict));
          end;

          ResolvedDict := TDictValue.Create;
          for I := 0 to L.Resolved.Count - 1 do
          begin
            R := L.Resolved[I];
            EntryDict := TDictValue.Create;
            EntryDict.SetValue('version', TValue.CreateStr(R.Version));
            EntryDict.SetValue('url', TValue.CreateStr(R.URL));
            EntryDict.SetValue('integrity', TValue.CreateStr(R.Integrity));
            ResolvedDict.SetValue(R.Name, TValue.CreateDict(EntryDict));
          end;

          Dict.SetValue('ok', TValue.CreateBool(True));
          Dict.SetValue('resolved', TValue.CreateDict(ResolvedDict));
        finally
          L.Free;
          Resolver.Free;
        end;
      finally
        Reg.Free;
      end;
    finally
      M.Free;
    end;

    Result := TValue.CreateDict(Dict);
  except
    Dict.Free;
    raise;
  end;
end;

//sqlite==================
//========================
function Native_SQLiteConnect(Args: TObjectList; CallEnv: TSymbolTable): TValue;
const
  MAX_SQLITE_CONNECTIONS = 32; 
var 
  Conn: TSQLite3Connection; 
  Trans: TSQLTransaction;
  i, InsertIdx: Integer;
  SafeDbName, RawPath, HomeDir: string;
begin
  if Args.Count <> 1 then raise EScriptRuntimeError.Create('sqliteConnect() butuh 1 argumen string (nama db)');
  
  RawPath := TValue(Args[0]).StrVal;
  HomeDir := GetEnvironmentVariable('HOME');
  
  if (Length(RawPath) > 0) and (RawPath[1] = '/') then
  begin
    if (HomeDir <> '') and (Copy(RawPath, 1, Length(HomeDir)) = HomeDir) then
      SafeDbName := RawPath
    else
      SafeDbName := GetSafeSandboxedPath(RawPath);
  end
  else
    SafeDbName := GetSafeSandboxedPath(RawPath);

  if SQLiteConnections = nil then 
  begin
    SQLiteLock.Acquire;
    try
      if SQLiteConnections = nil then SQLiteConnections := TObjectList.Create(True);
    finally
      SQLiteLock.Release;
    end;
  end;

  SQLiteLock.Acquire;
  try
    InsertIdx := -1;
    for i := 0 to SQLiteConnections.Count - 1 do
    begin
      if SQLiteConnections[i] = nil then
      begin
        InsertIdx := i;
        Break;
      end;
    end;

    // CEK SLOT TERLEBIH DAHULU SEBELUM MENGAKSES DISK/FILE
    if (InsertIdx = -1) and (SQLiteConnections.Count >= MAX_SQLITE_CONNECTIONS) then
      raise EScriptRuntimeError.Create('SQLite Fatal Error: Batas maksimal koneksi aktif (' + IntToStr(MAX_SQLITE_CONNECTIONS) + ') telah tercapai!');

    // Aman, mulai alokasi dan buka koneksi
    Conn := TSQLite3Connection.Create(nil);
    Trans := TSQLTransaction.Create(Conn);
    Conn.Transaction := Trans;
    Conn.DatabaseName := SafeDbName;
    
    try
      Conn.Open; 
    except
      on E: Exception do
      begin
        Conn.Free;
        raise EScriptRuntimeError.Create('Gagal membuka DB: ' + E.Message);
      end;
    end;

    if InsertIdx = -1 then
      Result := TValue.CreateNum(SQLiteConnections.Add(Conn))
    else
    begin
      SQLiteConnections[InsertIdx] := Conn;
      Result := TValue.CreateNum(InsertIdx);
    end;
  finally
    SQLiteLock.Release;
  end;
end;

procedure BindScriptParamsToSQL(Qry: TSQLQuery; ParamArray: TValue);
var
  i: Integer;
  Val: TValue;
begin
  if not Assigned(ParamArray) or (ParamArray.DataType <> dtArray) then 
    raise EScriptRuntimeError.Create('SQL Binding Error: Parameter harus berupa Array!');

  ParamArray.ArrayVal.FLock.Acquire;
  try
    if ParamArray.ArrayVal.Count <> Qry.Params.Count then
      raise EScriptRuntimeError.Create('SQL Parameter mismatch: Query mengharapkan ' + 
        IntToStr(Qry.Params.Count) + ' parameter, tetapi diberikan ' + 
        IntToStr(ParamArray.ArrayVal.Count));

    for i := 0 to Qry.Params.Count - 1 do
    begin
      Val := ParamArray.ArrayVal[i];
      if not Assigned(Val) then Continue; // Proteksi pointer liar
      
      case Val.DataType of
        dtNull: 
          begin
            Qry.Params[i].Clear;
            Qry.Params[i].Bound := True;
          end;
        dtNumeric: 
          begin
            if Frac(Val.NumVal) = 0 then
              Qry.Params[i].AsLargeInt := Trunc(Val.NumVal)
            else
              Qry.Params[i].AsFloat := Val.NumVal;
          end;
        dtString:  
          Qry.Params[i].AsString := Val.StrVal;
        dtBoolean: 
          Qry.Params[i].AsBoolean := Val.BoolVal;
        else
          raise EScriptRuntimeError.Create('SQL Binding Error: Tipe data parameter ke-' + 
            IntToStr(i+1) + ' tidak didukung database.');
      end;
    end;
  finally
    ParamArray.ArrayVal.FLock.Release;
  end;
end;

procedure EnsurePositionalParams(Qry: TSQLQuery; const SQLStr: string);
var
  ExpectedCount, i: Integer;
  ScanIdx: Integer;
begin
  // Hitung `?` di SQL string (naive — tidak handle `?` di dalam string
  // literal, tapi cukup untuk SQL sederhana)
  ExpectedCount := 0;
  ScanIdx := 1;
  while ScanIdx <= Length(SQLStr) do
  begin
    if SQLStr[ScanIdx] = '?' then
      Inc(ExpectedCount);
    Inc(ScanIdx);
  end;
  
  if ExpectedCount = 0 then Exit;
  
  // Kalau FPC sudah create param dengan count benar, tidak perlu intervensi
  if Qry.Params.Count = ExpectedCount then Exit;
  
  // Recreate dengan nama unik
  Qry.Params.Clear;
  for i := 1 to ExpectedCount do
    Qry.Params.CreateParam(ftUnknown, 'p' + IntToStr(i), ptInput);
end;

// 2. Mengeksekusi Perintah (INSERT, UPDATE, DELETE)
function Native_SQLiteExec(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Conn: TSQLite3Connection;
  Idx: Integer;
  Qry: TSQLQuery;
begin
  if (Args.Count < 2) or (Args.Count > 3) then 
    raise EScriptRuntimeError.Create('sqliteExec(connID, sqlQuery, [paramsArray]) butuh 2 atau 3 argumen');
  
  if TValue(Args[0]).DataType <> dtNumeric then
    raise EScriptRuntimeError.Create('SQLite Error: Argumen ID Koneksi harus berupa angka numerik!');
  
  Idx := Trunc(TValue(Args[0]).NumVal);
  
  SQLiteLock.Acquire; // <-- KUNCI DITAHAN SELAMA PROSES EKSEKUSI
  try
    if (Idx < 0) or (Idx >= SQLiteConnections.Count) or (SQLiteConnections[Idx] = nil) then
      raise EScriptRuntimeError.Create('SQLiteExec: Koneksi Database tidak valid (Invalid ID)!');

    Conn := TSQLite3Connection(SQLiteConnections[Idx]);
    Qry := TSQLQuery.Create(nil);
    try 
      Qry.DataBase := Conn;
      Qry.Transaction := Conn.Transaction;
      Qry.SQL.Text := TValue(Args[1]).StrVal;
      // ✅ Fix FPC dedup bug untuk `?` positional params
      EnsurePositionalParams(Qry, Qry.SQL.Text);
      
      try 
        if Args.Count = 3 then
          BindScriptParamsToSQL(Qry, TValue(Args[2]));          
        Qry.ExecSQL; 
        Conn.Transaction.Commit; 
      except
        on E: Exception do
        begin
          if Conn.Transaction.Active then Conn.Transaction.Rollback;
          raise EScriptRuntimeError.Create('SQLite Execution Error: ' + E.Message);
        end;
      end;
    finally
      Qry.Free; 
    end;
  finally
    SQLiteLock.Release; // <-- LEPASKAN SETELAH SELESAI AMAN
  end;
  
  Result := TValue.CreateBool(True);
end;

// 3. Menarik Data (SELECT) - Mengembalikan format Array of Object (JSON Based)
function Native_SQLiteQuery(Args: TObjectList; CallEnv: TSymbolTable): TValue;
const
  MAX_QUERY_ROWS = 10000; 
var
  Conn: TSQLite3Connection;
  Qry: TSQLQuery;
  JArr: TValueList;
  JObj: TDictValue;
  EvalItem: TValue;
  i, Idx, RowCount: Integer;
  IntVal: Int64;
  StrVal: string;
  FieldLower: string;
  
begin
  if (Args.Count < 2) or (Args.Count > 3) then 
    raise EScriptRuntimeError.Create('sqliteQuery(connID, sqlQuery, [paramsArray]) butuh 2 atau 3 argumen');
    
  if TValue(Args[0]).DataType <> dtNumeric then
    raise EScriptRuntimeError.Create('SQLite Error: Argumen ID Koneksi harus berupa angka numerik!');
    
  Idx := Trunc(TValue(Args[0]).NumVal);
  
  SQLiteLock.Acquire; // <-- KUNCI DITAHAN SELAMA QUERY
  try
    if (Idx < 0) or (Idx >= SQLiteConnections.Count) or (SQLiteConnections[Idx] = nil) then
      raise EScriptRuntimeError.Create('SQLiteQuery: Koneksi Database tidak valid!');
    
    Conn := TSQLite3Connection(SQLiteConnections[Idx]);
  
    Qry := TSQLQuery.Create(nil);
    JArr := TValueList.Create(True); 
    RowCount := 0; 
    
    try // Try Utama (Proteksi Pointer JArr)
      try // Try Eksekusi SQL
        Qry.DataBase := Conn;
        Qry.Transaction := Conn.Transaction;
        Qry.SQL.Text := TValue(Args[1]).StrVal;
        // ✅ Fix FPC dedup bug untuk `?` positional params
        EnsurePositionalParams(Qry, Qry.SQL.Text);
        
        if Args.Count = 3 then
          BindScriptParamsToSQL(Qry, TValue(Args[2]));     
          
        Qry.Open;
        while not Qry.EOF do
        begin
          if RowCount >= MAX_QUERY_ROWS then
            raise EScriptRuntimeError.Create('SQLite Security: Query dihentikan paksa melebihi batas ' + IntToStr(MAX_QUERY_ROWS) + ' baris.');

          JObj := TDictValue.Create;
          try 
          
            for i := 0 to Qry.FieldCount - 1 do
            begin
              if Qry.Fields[i].IsNull then
                EvalItem := TValue.CreateNull
              else if Qry.Fields[i].DataType in [ftInteger, ftLargeint] then
                EvalItem := TValue.CreateNum(Qry.Fields[i].AsLargeInt)
              else if Qry.Fields[i].DataType in [ftFloat, ftCurrency] then
                EvalItem := TValue.CreateNum(Qry.Fields[i].AsFloat)
              else if Qry.Fields[i].DataType in [ftDate, ftTime, ftDateTime] then
                EvalItem := TValue.CreateStr(FormatDateTime('yyyy-mm-dd hh:nn:ss', Qry.Fields[i].AsDateTime))
              else
              begin
                StrVal := Qry.Fields[i].AsString;
                FieldLower := LowerCase(Qry.Fields[i].FieldName);
                // ✅ E-1: Heuristic — field name 'id' / 'rowid' / '*_id' di-coerce
                //    ke number kalau isinya integer. Ini menangani quirk FPC
                //    SQLite3 connector yang kadang melaporkan INTEGER PRIMARY KEY
                //    sebagai ftString, bukan ftInteger/ftAutoInc.
                if (FieldLower = 'id') or (FieldLower = 'rowid') or
                   ((Length(FieldLower) > 3) and
                    (RightStr(FieldLower, 3) = '_id')) then
                begin
                  if TryStrToInt64(StrVal, IntVal) then
                    EvalItem := TValue.CreateNum(IntVal)
                  else
                    EvalItem := TValue.CreateStr(StrVal);
                end
                else
                  EvalItem := TValue.CreateStr(StrVal);
              end;            
            
              JObj.SetValue(Qry.Fields[i].FieldName, EvalItem);
            end;
            
          except
            JObj.Free; 
            raise;
          end;

          EvalItem := TValue.CreateDict(JObj);
          try
            JArr.Add(EvalItem);
          except
            EvalItem.Free; 
            raise;
          end;

          Qry.Next;
          Inc(RowCount);
        end;      
        
        if Conn.Transaction.Active then Conn.Transaction.Commit;
        
        // Ownership transfer berhasil, TValue yang mengatur umur JArr
        Result := TValue.CreateArray(JArr); 
        JArr := nil; // Putuskan pointer lokal agar tidak terkena Finally

      except
        on E: Exception do
        begin
          if Conn.Transaction.Active then Conn.Transaction.Rollback;
          raise EScriptRuntimeError.Create('SQLite Query Error: ' + E.Message);
        end;
      end;
    finally
      // Jika Result gagal di-assign (akibat Exception SQL), JArr akan dibebaskan
      if Assigned(JArr) then JArr.Free; 
      Qry.Free;
    end;

  finally
    SQLiteLock.Release; // <-- LEPASKAN SETELAH HASIL DIAMBIL
  end;    
end;

function Native_SQLiteClose(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Idx: Integer;
  ConnToFree: TSQLite3Connection;
begin
  if Args.Count <> 1 then raise EScriptRuntimeError.Create('sqliteClose(connID) butuh 1 argumen');
  
  if TValue(Args[0]).DataType <> dtNumeric then
    raise EScriptRuntimeError.Create('SQLite Error: Argumen ID Koneksi (Parameter ke-1) harus berupa angka numerik!');
  
  Idx := Trunc(TValue(Args[0]).NumVal);
  
  SQLiteLock.Acquire;
  try
    if (Idx >= 0) and (Idx < SQLiteConnections.Count) and Assigned(SQLiteConnections[Idx]) then
    begin
        ConnToFree := TSQLite3Connection(SQLiteConnections[Idx]);
        
        try
          if Assigned(ConnToFree) then
          begin
             if ConnToFree.Transaction.Active then
                ConnToFree.Transaction.Rollback;
                
             if ConnToFree.Connected then
                ConnToFree.Close;
          end;
        finally
          // --- : Timpa langsung indeks dengan nil. ---
          // Ini secara otomatis memanggil ConnToFree.Free karena OwnsObjects = True
          // dan TIDAK AKAN menggeser (shift) indeks koneksi lain.
          SQLiteConnections[Idx] := nil; 
        end;
        
        Result := TValue.CreateBool(True);
    end else
        Result := TValue.CreateBool(False);
  finally
    SQLiteLock.Release;
  end;
end;

