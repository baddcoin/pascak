function Native_FS_WaitAsync(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Task: TFSAsyncTask;
  TaskID, TimeoutMs: Integer;
  StartTime: QWord;
begin
  if (Args.Count < 1) or (Args.Count > 2) then
    raise EScriptRuntimeError.Create('fs.waitAsync(taskID, [timeoutMs]) butuh 1-2 argumen');

  TaskID := Trunc(TValue(Args[0]).NumVal);
  TimeoutMs := 0;
  if Args.Count = 2 then
    TimeoutMs := Trunc(TValue(Args[1]).NumVal);

  Task := FindFSAsyncTask(TaskID);
  if not Assigned(Task) then Exit(TValue.CreateNull);

  StartTime := GetTickCount64;
  while InterlockedCompareExchange(Task.State, 0, 0) <> EXEC_TASK_DONE do
  begin
    if (TimeoutMs > 0) and ((GetTickCount64 - StartTime) > QWord(TimeoutMs)) then
      Break;
    Sleep(10);
    ProcessFSAsyncCallbacks;
  end;

  if InterlockedCompareExchange(Task.State, 0, 0) = EXEC_TASK_DONE then
  begin
    if Assigned(Task.ResultVal) then
      Result := Task.ResultVal.Clone
    else
      Result := TValue.CreateNull;
  end
  else
    Result := TValue.CreateNull;
end;

