// Mengembalikan tipe data dalam bentuk String (huruf kecil)
function Native_TypeOf(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  V: TValue;
  Res: string;
begin
  if (Args = nil) or (Args.Count <> 1) then 
    raise EScriptRuntimeError.Create('typeOf() membutuhkan tepat 1 argumen');
    
  V := TValue(Args[0]);
  
  // <-- PERBAIKAN LOGIKA: Cegah Access Violation jika pointer V ternyata murni nil
  if not Assigned(V) then
  begin
    Result := TValue.CreateStr('null');
    Exit;
  end;
  
  case V.DataType of
    dtNumeric:  Res := 'numeric';
    dtString:   Res := 'string';
    dtBoolean:  Res := 'boolean';
    dtArray:    Res := 'array';
    dtObject:   Res := 'object';
    dtDict:     Res := 'dictionary';
    dtFunction: Res := 'function';
    dtNative:   Res := 'native_function';
    dtClassDef: Res := 'class_definition';
    dtNull:     Res := 'null';
    dtPointer:  Res := 'pointer'; 
    dtDLLHandle: Res := 'dll';  
    else        Res := 'unknown';
  end;
  
  Result := TValue.CreateStr(Res);
end;

function Native_IsInstance(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var 
  Target, PropVal: TValue;
  ClassNameStr, DefName: string; 
begin
  if (Args.Count <> 2) or (TValue(Args[1]).DataType <> dtString) then
    raise EScriptRuntimeError.Create('isInstance(obj, "ClassName") membutuhkan tepat 2 argumen.');

  Target := TValue(Args[0]);
  ClassNameStr := TValue(Args[1]).StrVal;

  if Target.DataType <> dtObject then Exit(TValue.CreateBool(False));

  DefName := Target.ObjVal.Definition.Name;
  if DefName = ClassNameStr then 
    Exit(TValue.CreateBool(True));

  if Target.ObjVal.Members.HasVar('__is_' + ClassNameStr) then
  begin
    PropVal := Target.ObjVal.Members.GetVar('__is_' + ClassNameStr);
    
    // PERBAIKAN LOGIKA: Hapus blok try..finally PropVal.Free;
    // GetVar mengembalikan referensi, men-Free disini akan menghancurkan data di SymbolTable!
    if Assigned(PropVal) then
      Result := TValue.CreateBool(PropVal.IsTrue)
    else
      Result := TValue.CreateBool(False);
  end
  else
    Result := TValue.CreateBool(False);
end;

