// delete(array, index) -> Menghapus elemen pada index tertentu
function Native_Delete(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var 
  Target : TValue;
  //TargetObj: TValue; 
  Idx: Integer;
  StrKey: string;
begin
  if (Args.Count <> 2) then raise Exception.Create('Error: "delete" membutuhkan 2 argumen (Koleksi, Index/Key).');
  Target := TValue(Args[0]);
  
  if Target.DataType = dtArray then 
  begin
    if TValue(Args[1]).DataType <> dtNumeric then raise Exception.Create('Error: Index array harus numerik.');
    Idx := Trunc(TValue(Args[1]).NumVal);

    Target.ArrayVal.FLock.Acquire; 
    try
      if Idx < 0 then Idx := Target.ArrayVal.Count + Idx;
      
      if (Idx >= 0) and (Idx < Target.ArrayVal.Count) then
      begin
        if Assigned(Target.ArrayVal[Idx]) then Result := Target.ArrayVal[Idx].Clone 
        else Result := TValue.CreateNull;
          
        Target.ArrayVal.Delete(Idx);
      end
      else raise Exception.Create('Error: Index array out of bounds pada "delete".');
    finally
      Target.ArrayVal.FLock.Release;
    end;
  end else 
  if Target.DataType = dtDict then
  begin
    if TValue(Args[1]).DataType <> dtString then raise Exception.Create('Error: Key dictionary harus string.');
    StrKey := TValue(Args[1]).StrVal;

    Target.DictVal.FLock.Acquire; 
    try
      // ✅ FIX P1.5: GetValueClone — aman
      Result := Target.DictVal.GetValueClone(StrKey); 
      if not (Result.DataType = dtNull) then
      begin
        Target.DictVal.Remove(StrKey); 
      end else
      begin
        Result.Free;
        raise Exception.Create('Error: Key tidak ditemukan dalam dictionary pada "delete".');
      end;
    finally
      Target.DictVal.FLock.Release;
    end;
  end
  
  else 
    raise Exception.Create('Error: Argumen pertama "delete" harus Array atau Dictionary.');
end;

