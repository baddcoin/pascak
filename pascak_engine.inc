end;

destructor TMultiAssignNode.Destroy;
begin
  Targets.Free;
  if Assigned(Expr) then Expr.Free;
  inherited;
end;

constructor TBinaryOpNode.Create(L: TNode; AOp: TOpKind; R: TNode); 
begin 
