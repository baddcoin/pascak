function Native_MathClamp(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var V, MinV, MaxV, Temp: Double;
begin
  if (Args.Count <> 3) or (TValue(Args[0]).DataType <> dtNumeric) or 
     (TValue(Args[1]).DataType <> dtNumeric) or (TValue(Args[2]).DataType <> dtNumeric) then 
    raise EScriptRuntimeError.Create('Math Error: clamp(val, min, max) butuh 3 argumen numerik');
  
  V := TValue(Args[0]).NumVal;
  MinV := TValue(Args[1]).NumVal;
  MaxV := TValue(Args[2]).NumVal;
  
  if MinV > MaxV then 
  begin 
    Temp := MinV; MinV := MaxV; MaxV := Temp; 
  end;

  // Digantikan dengan Math library native FPC yang lebih optimal di eksekusi mesin
  Result := TValue.CreateNum(math.EnsureRange(V, MinV, MaxV));
end;

