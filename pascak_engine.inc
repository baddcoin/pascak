function LookupFFIStub(const Sig: string): TFFIStub;
var
  NSig: string;
begin
  NSig := StringReplace(Sig, 'C', 'p', [rfReplaceAll]);

  Result := nil;
  
  // ─── Existing (F-1) ───
  if      NSig = 'ii->i'     then Result := @FFIStub_ii_i
  else if NSig = 'ff->f'     then Result := @FFIStub_ff_f
  else if NSig = 'iii->i'    then Result := @FFIStub_iii_i
  else if NSig = 'if->f'     then Result := @FFIStub_if_f
  else if NSig = 'fi->f'     then Result := @FFIStub_fi_f
  else if NSig = 'i->i'      then Result := @FFIStub_i_i
  else if NSig = 'f->f'      then Result := @FFIStub_f_f
  else if NSig = 's->i'      then Result := @FFIStub_s_i
  else if NSig = 'ss->i'     then Result := @FFIStub_ss_i
  else if NSig = '->i'       then Result := @FFIStub_v_i
  else if NSig = 'i->v'      then Result := @FFIStub_i_v
  
  // ─── F-2b: Memory ───
  else if NSig = 'I->p'      then Result := @FFIStub_I_p
  else if NSig = 'p->v'      then Result := @FFIStub_p_v
  else if NSig = 'pI->p'     then Result := @FFIStub_pI_p
  else if NSig = 'pIp->p'    then Result := @FFIStub_pIp_p
  else if NSig = 'pIp->v'    then Result := @FFIStub_pIp_v
  
  // ─── F-2b: String ───
  else if NSig = 'p->i'      then Result := @FFIStub_p_i
  else if NSig = 'sss->i'    then Result := @FFIStub_sss_i
  else if NSig = 'ss->s'     then Result := @FFIStub_ss_s
  else if NSig = 'sc->i'     then Result := @FFIStub_sc_i
  
  // ─── F-2b: File I/O ───
  else if NSig = 'si->i'     then Result := @FFIStub_si_i
  else if NSig = 'siI->i'    then Result := @FFIStub_siI_i
  else if NSig = 'iIp->i'    then Result := @FFIStub_iIp_i
  else if NSig = 'ipI->i'    then Result := @FFIStub_ipI_i
  
  // ─── F-2b: Pointers ───
  else if NSig = 'p->p'      then Result := @FFIStub_p_p
  else if NSig = 'i->p'      then Result := @FFIStub_i_p
  else if NSig = 'ip->i'     then Result := @FFIStub_ip_i
  else if NSig = 'pp->i'     then Result := @FFIStub_pp_i
  else if NSig = 'p->s'      then Result := @FFIStub_p_s
  
  // ─── F-2b: Multi-float ───
  else if NSig = 'fff->f'    then Result := @FFIStub_fff_f
  else if NSig = 'ffff->f'   then Result := @FFIStub_ffff_f
  
  // ─── F-2b: Multi-int ───
  else if NSig = 'iiii->i'   then Result := @FFIStub_iiii_i
  else if NSig = 'iiiii->i'  then Result := @FFIStub_iiiii_i
  else if NSig = 'iiiiii->i' then Result := @FFIStub_iiiiii_i
  
  // ─── F-2b: Misc ───
  else if NSig = 'i->f'      then Result := @FFIStub_i_f
  else if NSig = 'f->i'      then Result := @FFIStub_f_i
  else if NSig = '->v'       then Result := @FFIStub_v_v
  
  // ─── F-2b: Variadic prefix ───
  else if NSig = 'sp->i'     then Result := @FFIStub_sp_i
  else if NSig = 'spp->i'    then Result := @FFIStub_spp_i
  
  // B-2: qsort-style signatures
  else if NSig = 'pip->v'    then Result := @FFIStub_pip_v
  else if NSig = 'pIp->i'    then Result := @FFIStub_pIp_i 

  // ✅ F-3a-3: callback dispatch (pointer di posisi terakhir = cb)
  else if NSig = 'iip->i'    then Result := @FFIStub_iip_i
  else if NSig = 'ffp->f'    then Result := @FFIStub_ffp_f;  
end;

function CallFFIWrapped(WrapperDict: TDictValue; 
    RawArgs: array of TValue): TValue;
var
  RawPtrVal, FuncNameVal, SigVal, StructCtxVal: TValue;
  RawPtr: Pointer;
  FuncName, Sig: string;
  Stub: TFFIStub;
  ArgArray: TValueArray;
  ArgCountVal: TValue;
  ArgCount, i: Integer;
begin
  // F-3a-5c: cek apakah ini struct call
  StructCtxVal := WrapperDict.GetValueClone('__ffi_struct_ctx');
  if Assigned(StructCtxVal) and (StructCtxVal.DataType = dtPointer)
     and (StructCtxVal.PtrVal <> nil) then
  begin
    try
      Result := CallFFIStruct(TStructCallContext(StructCtxVal.PtrVal), RawArgs);
    finally
      StructCtxVal.Free;
    end;
    Exit;
  end;
  if Assigned(StructCtxVal) then StructCtxVal.Free;
  
  Result := nil;
  
  // ✅ F-1d FIX: Semua GetValue → GetValueClone.
  // GetValue returns BORROWED reference ke TValue internal dict.
  // Free pada borrowed ref → dangling di dict → double-free saat dict destructor.
  RawPtrVal := WrapperDict.GetValueClone('__ffi_raw');
  if not Assigned(RawPtrVal) or (RawPtrVal.DataType <> dtPointer) then
  begin
    if Assigned(RawPtrVal) then RawPtrVal.Free;
    errMSG.callerror(155, 'FFI: handle wrapper tidak valid', errMSG.xrow, errMSG.xcol);
  end;
  
  try
    RawPtr := RawPtrVal.PtrVal;
    
    FuncNameVal := WrapperDict.GetValueClone('__ffi_name');
    if Assigned(FuncNameVal) then
      FuncName := FuncNameVal.StrVal
    else
      FuncName := '<unknown>';
    
    SigVal := WrapperDict.GetValueClone('__ffi_sig');
    if not Assigned(SigVal) then
    begin
      errMSG.callerror(152, 'FFI: signature tidak tersimpan di wrapper',
                       errMSG.xrow, errMSG.xcol);
    end;
    Sig := SigVal.StrVal;
    
    ArgCountVal := WrapperDict.GetValueClone('__ffi_argc');
    if Assigned(ArgCountVal) then
      ArgCount := Trunc(ArgCountVal.NumVal)
    else
      ArgCount := Length(RawArgs);
    
    // Validate arg count
    if Length(RawArgs) <> ArgCount then
    begin
      errMSG.callerror(154, Format('FFI: "%s" butuh %d argumen, diberikan %d',
                       [FuncName, ArgCount, Length(RawArgs)]),
                       errMSG.xrow, errMSG.xcol);
    end;    
    
    // Lookup stub
    Stub := LookupFFIStub(Sig);
    if Stub = nil then
    begin
      errMSG.callerror(153,
        'FFI: signature "' + Sig + '" belum di-implementasikan. ' +
        'Huruf: i=Int64 f=Double s=PAnsiChar p=Pointer I=size_t v=void',
        errMSG.xrow, errMSG.xcol);
    end;
    
    // Build arg array
    SetLength(ArgArray, Length(RawArgs));
    for i := 0 to High(RawArgs) do
      ArgArray[i] := RawArgs[i];
    
    // Call stub
    Result := Stub(RawPtr, ArgArray);
  finally
    if Assigned(RawPtrVal) then RawPtrVal.Free;
    if Assigned(FuncNameVal) then FuncNameVal.Free;
    if Assigned(SigVal) then SigVal.Free;
    if Assigned(ArgCountVal) then ArgCountVal.Free;
  end;
end;

function CallFFIStruct(Ctx: TStructCallContext; 
            RawArgs: array of TValue): TValue;
var
  ArgBuffers: array of Pointer;
  ArgPtrs: array of Pointer;
  i, N: Integer;
  RetBuffer: Pointer;
  RetSize: NativeUInt;
  SVal: PNativeStructValue;
begin
  N := Length(Ctx.ArgKinds);
  SetLength(ArgBuffers, N);
  SetLength(ArgPtrs, N);
  RetBuffer := nil;
  RetSize := 0;
  
  try
    for i := 0 to N - 1 do
    begin
      case Ctx.ArgKinds[i] of
        fatInt:
          begin
            GetMem(ArgBuffers[i], 8);
            PInt64(ArgBuffers[i])^ := Trunc(RawArgs[i].NumVal);
            ArgPtrs[i] := ArgBuffers[i];
          end;
        fatFloat:
          begin
            GetMem(ArgBuffers[i], 8);
            PDouble(ArgBuffers[i])^ := RawArgs[i].NumVal;
            ArgPtrs[i] := ArgBuffers[i];
          end;
        fatPointer:
          begin
            ArgBuffers[i] := nil;
            ArgPtrs[i] := RawArgs[i].PtrVal;
          end;
        fatStruct:
          begin
            SVal := GetStructValueFromTValue(RawArgs[i]);
            if SVal = nil then
              raise EScriptRuntimeError.Create(
                'FFI struct call: argumen ke-' + IntToStr(i) + ' bukan struct value valid');
            if SVal^.StructType <> Ctx.StructTypes[i] then
              raise EScriptRuntimeError.Create(
                'FFI struct call: argumen ke-' + IntToStr(i) + 
                ' tipe struct tidak cocok');
            GetMem(ArgBuffers[i], SVal^.StructType^.TotalSize);
            Move(SVal^.Data^, ArgBuffers[i]^, SVal^.StructType^.TotalSize);
            ArgPtrs[i] := ArgBuffers[i];
          end;
      end;
    end;
    
    case Ctx.RetKind of
      frtInt, frtFloat, frtString, frtPointer: RetSize := 8;
      frtVoid: RetSize := 0;
      frtStruct: RetSize := Ctx.ReturnStructType^.TotalSize;
    end;
    
    if RetSize > 0 then
    begin
      GetMem(RetBuffer, RetSize);
      FillChar(RetBuffer^, RetSize, 0);
    end;
    
    if N > 0 then
      fp_ffi_call(Ctx.CifPtr, Ctx.RawFunc, RetBuffer, @ArgPtrs[0])
    else
      fp_ffi_call(Ctx.CifPtr, Ctx.RawFunc, RetBuffer, nil);
    
    case Ctx.RetKind of
      frtInt:     Result := TValue.CreateNum(PInt64(RetBuffer)^);
      frtFloat:   Result := TValue.CreateNum(PDouble(RetBuffer)^);
      frtPointer: Result := TValue.CreatePtr(PPointer(RetBuffer)^);
      frtString:  Result := TValue.CreateStr(
                    PAnsiCharToVMStr(PAnsiChar(PPointer(RetBuffer)^)));
      frtVoid:    Result := TValue.CreateNull;
      frtStruct:
        begin
          New(SVal);
          SVal^.Magic := STRUCT_VALUE_MAGIC;
          SVal^.StructType := Ctx.ReturnStructType;
          GetMem(SVal^.Data, Ctx.ReturnStructType^.TotalSize);
          Move(RetBuffer^, SVal^.Data^, Ctx.ReturnStructType^.TotalSize);
          
          if Assigned(GStructLock) and Assigned(GStructValueRegistry) then
          begin
            GStructLock.Acquire;
            try
              GStructValueRegistry.Add(SVal);
            finally
              GStructLock.Release;
            end;
          end;
          
          Result := TValue.CreatePtr(SVal);
        end;
    else
      Result := TValue.CreateNull;
    end;
  finally
    for i := 0 to N - 1 do
      if ArgBuffers[i] <> nil then FreeMem(ArgBuffers[i]);
    if RetBuffer <> nil then FreeMem(RetBuffer);
  end;
end;

