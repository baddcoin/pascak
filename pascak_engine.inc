procedure runScript(scr: string; DebugMode: Boolean = False);
var
  Engine: TPascakEngine;
  Res: TValue;
  i: Integer; 
  HasRunawayThreads: Boolean;
  GlobalInit: Boolean;
  Op : TVMOpCode;
  HSE: PHTTPServerEntry; 
  EnvPolicy: string;
  EnvPolicyCfg: TDictValue;
  EnvPolicyBins: string;
  EnvPolicyArr: TValueList;
  EnvPolicyParts: TStringArray;
  EnvPolicyIdx: Integer;
  EnvPolicyVal: TValue;
  ExitCode: integer;
  EnvPolicyTmpPolicy: TExecPolicy;   // ← TAMBAH  
  
begin 
  FS := DefaultFormatSettings;
  FS.DecimalSeparator := '.';
  ExitCode := 0; 
  
  // ✅ FASE 1.4: env override hanya di-honor bila --dev dipass.
  // Production embedding harus pakai Engine.SetExecPolicy + LockExecPolicy.
  if GDangerousEnvAllowed then
    EnvPolicy := GetEnvironmentVariable('PASCAK_EXEC_POLICY')
  else
    EnvPolicy := '';    
    
  GDebugEnabled := (GetEnvironmentVariable('PASCAK_DEBUG') = '1');
  FillChar(GDebugOpcodeCounts, SizeOf(GDebugOpcodeCounts), 0);  
  
  HasRunawayThreads := False;
  GlobalInit := False;
  GCurrentContext := nil;

  EnsureGlobalsInit;
  GlobalInit := True;

  Engine := nil;
  NetInit; 
  ProcInit;
  try
    try
      Engine := TPascakEngine.Create;
      Engine.SetMemoryQuota(256 * 1024 * 1024);
      
      if EnvPolicy <> '' then
      begin
        EnvPolicyCfg := TDictValue.Create;
        try
          if EnvPolicy = 'allow-all' then
            EnvPolicyCfg.SetValue('mode', TValue.CreateStr('allow-all'))
          else if EnvPolicy = 'none' then
            EnvPolicyCfg.SetValue('mode', TValue.CreateStr('none'))
          else if Copy(EnvPolicy, 1, 10) = 'whitelist:' then
          begin
            EnvPolicyCfg.SetValue('mode', TValue.CreateStr('whitelist'));
            EnvPolicyBins := Copy(EnvPolicy, 11, Length(EnvPolicy));
            EnvPolicyArr := TValueList.Create(True);
            try
              EnvPolicyParts := EnvPolicyBins.Split([',']);
              for EnvPolicyIdx := 0 to High(EnvPolicyParts) do
                EnvPolicyArr.Add(TValue.CreateStr(Trim(EnvPolicyParts[EnvPolicyIdx])));
              EnvPolicyCfg.SetValue('binaries', TValue.CreateArray(EnvPolicyArr));
            except
              EnvPolicyArr.Free;
              raise;
            end;
          end;
      
          EnvPolicyVal := TValue.CreateDict(EnvPolicyCfg);
          try
            EnvPolicyTmpPolicy := TExecPolicy.Create;
            try
              ApplyExecPolicyDict(EnvPolicyTmpPolicy, EnvPolicyVal);
              ProcSetExecPolicy(EnvPolicyTmpPolicy);
            finally
              EnvPolicyTmpPolicy.Free;
            end;
          finally
            EnvPolicyVal.Free;
          end;
          
        except
          EnvPolicyCfg.Free;
          raise;
        end;
      
        IOLock.Acquire;
        try
          Writeln('[boot] exec policy = ', EnvPolicy);
        finally
          IOLock.Release;
        end;
      end;
      
      // ✅ TAHAP D-1: aktifkan debug jika flag diset
      if DebugMode then
        Engine.SetDebugEnabled(True);
      
      Res := Engine.ExecuteString(scr, 'test.pas');      
      if Assigned(Res) then Res.Free;
      
      Engine.RunEventLoop;
      
      // ✅ FIX: set shutdown flag SEBELUM join thread.
      // Tanpa ini, server threads yang blocked di NetAcceptTimeout
      // tidak akan pernah lihat flag (chicken-and-egg deadlock).
      InterlockedExchange(IsShuttingDown, 1);
      
    except
      on E: EScriptFatalError do
      begin
        IOLock.Acquire;
        try Writeln(#10'=== SCRIPT HALTED ==='#10 + E.Message); 
        finally IOLock.Release; end;
        if E.ExitCode >= 0 then
          ExitCode := E.ExitCode
        else
          ExitCode := 1;
      end;
      
      on E: EScriptRuntimeError do
      begin
        IOLock.Acquire;
        try
          if E.FormattedBanner <> '' then
            Writeln(E.FormattedBanner)
          else if Pos('Interpreter Halted:', E.Message) = 0 then
            Writeln(#10'=== RUNTIME EXCEPTION ==='#10 + E.Message);
        finally 
          IOLock.Release; 
        end;
        ExitCode := 1;
      end;
      on E: Exception do
      begin
        IOLock.Acquire;
        try Writeln(#10'=== RUNTIME EXCEPTION ==='#10 + E.Message); 
        finally IOLock.Release; end;
        ExitCode := 1;
      end;
    end;
    
  finally
    InterlockedExchange(IsShuttingDown, 1);
  
    // Beri waktu server thread lihat flag setelah accept timeout (1000ms).
    // 1500ms cukup — NetAcceptTimeout max 1000ms + margin.
     Sleep(1500);
    
    if Assigned(ScriptThreadList) then
    begin
      // 1. Tunggu semua thread selesai Execute (chunk & env masih valid)
      for i := 0 to ScriptThreadList.Count - 1 do
        if Assigned(ScriptThreadList[i]) then
          try TThread(ScriptThreadList[i]).WaitFor; except end;
        
      // ✅ FIX: cleanup HTTP server SEBELUM Free thread.
      // Saat ini, chunk & env script masih di-hold oleh thread objects.
      // Jika cleanup dijalankan setelah Free thread, HSE^.Handler.Free
      // akan menyentuh dangling pointer (ClosureEnv sudah di-release).
      if Assigned(GHTTPServers) then
      begin
        for i := 0 to GHTTPServers.Count - 1 do
        begin
          HSE := PHTTPServerEntry(GHTTPServers[i]);
          if Assigned(HSE) then
          begin
            if HSE^.ListenSock >= 0 then NetClose(HSE^.ListenSock);
            if Assigned(HSE^.Handler) then HSE^.Handler.Free;
            Dispose(HSE);
          end;
        end;
        GHTTPServers.Free;
        GHTTPServers := nil;
      end;
      if Assigned(GHTTPServersLock) then
      begin
        GHTTPServersLock.Free;
        GHTTPServersLock := nil;
      end;
      
      // 2. Free threads (FThreadVM.Free + FThreadChunk.Free di sini)
      for i := 0 to ScriptThreadList.Count - 1 do
        if Assigned(ScriptThreadList[i]) then
          try TThread(ScriptThreadList[i]).Free; except end;
      ScriptThreadList.Clear;
      ScriptThreadList.Free;
      ScriptThreadList := nil;
    end;    
  
    // ── WS cleanup ──
    if Assigned(GWSWorkersLock) then
    begin
      // Set stop flag dulu
      if Assigned(GWSServers) then
      begin
        GWSServersLock.Acquire;
        try
          for i := 0 to GWSServers.Count - 1 do
            if Assigned(GWSServers[i]) then
              PWSServerEntry(GWSServers[i])^.StopRequested := True;
        finally
          GWSServersLock.Release;
        end;
      end;
      
      // Wait for workers
      GWSWorkersLock.Acquire;
      try
        for i := 0 to GWSWorkers.Count - 1 do
        begin
          if Assigned(GWSWorkers[i]) then
            try TThread(GWSWorkers[i]).WaitFor; except end;
        end;
      finally
        GWSWorkersLock.Release;
      end;
      
      GWSWorkers.Free;     GWSWorkers := nil;
      GWSWorkersLock.Free; GWSWorkersLock := nil;
    
      // Bundle C — WS client cleanup
      if Assigned(GWSClientWorkersLock) then
      begin
        GWSClientWorkersLock.Acquire;
        try
          for i := 0 to GWSClientWorkers.Count - 1 do
          begin
            if Assigned(GWSClientWorkers[i]) then
              try TThread(GWSClientWorkers[i]).WaitFor; except end;
          end;
        finally
          GWSClientWorkersLock.Release;
        end;
        for i := 0 to GWSClientWorkers.Count - 1 do
          if Assigned(GWSClientWorkers[i]) then
            try TThread(GWSClientWorkers[i]).Free; except end;
        GWSClientWorkers.Free;      GWSClientWorkers := nil;
        GWSClientWorkersLock.Free;  GWSClientWorkersLock := nil;
      end;
      if Assigned(GWSClientConnsLock) then
      begin
        GWSClientConnsLock.Acquire;
        try
          if Assigned(GWSClientConns) then
          begin
            for i := 0 to GWSClientConns.Count - 1 do
              if Assigned(GWSClientConns.Objects[i]) then
                try TWSClientConn(GWSClientConns.Objects[i]).Release; except end;
            GWSClientConns.Clear;
          end;
        finally
          GWSClientConnsLock.Release;
        end;
        if Assigned(GWSClientConns) then
        begin
          GWSClientConns.Free;
          GWSClientConns := nil;
        end;
        GWSClientConnsLock.Free;    GWSClientConnsLock := nil;
      end;    
    end;
    
    FreeWSServers;
    try FreeExecTasks; except end;
    try FreeFSAsyncTasks; except end;   // ✅ FASE 1.3
    
    // F-3a-2 (relocated): free callback context SEBELUM Engine.Free.
    //TCallbackContext menyimpan VMFunc: TValue yang di-alloc dari arena.
    //Engine.Free -> arena freed -> VMFunc dangling -> AV saat .Free.
    if Assigned(GCallbackLock) then
    begin
      GCallbackLock.Acquire;
      try
        if Assigned(GCallbackRegistry) then
        begin
          for i := 0 to GCallbackRegistry.Count - 1 do
            if Assigned(GCallbackRegistry.Data[i]) then
              GCallbackRegistry.Data[i].Free;
          GCallbackRegistry.Clear;
        end;
      finally
        GCallbackLock.Release;
      end;
    end;
    if Assigned(GCallbackRegistry) then
    begin
      GCallbackRegistry.Free;
      GCallbackRegistry := nil;
    end;
    
    if Assigned(Engine) then
    begin
      try
        RunShutdownHooks(Engine.GlobalEnv);
      except
      end;    
      
      try
        if Assigned(G_H2Pool) then
    begin
      G_H2Pool.Clear;
      G_H2Pool.Free;
      G_H2Pool := nil;
    end;
    HTTPPoolClearAll;
      except
      end;

      Engine.Shutdown;
      
      // ✅ FIX: Process zombies SEBELUM Engine.Free.
      // Zombie objects (TValueList, TDictValue, TSymbolTable) mereferensikan
      // TValue yang di-alloc dari arena context. Kalau arena di-free duluan
      // (via Engine.Free → TEngineContext.Destroy), ClearReferences akan
      // dereference dangling pointer → AV di ClearMap.
      while (Assigned(ZombieQueue)) and (ZombieQueue.Count > 0) do 
        ProcessGCZombies;
      
      Engine.Free;
      Engine := nil;
    end;
  
    ReleaseSharedTLSContext;
    TLSShutdown;
    if Assigned(GTLSContextLock) then
    begin
      GTLSContextLock.Free;
      GTLSContextLock := nil;
    end;
    
    ProcShutdown; 
    NetShutdown; 
    if InterlockedCompareExchange(ActiveThreads, 0, 0) > 0 then
      HasRunawayThreads := True;
  
    // Cleanup GC & global resources
    if GlobalInit then
    begin
      RunGarbageCollection(nil); 
      
      // Sisa zombie dari global scope (bukan per-context)
      while (Assigned(ZombieQueue)) and (ZombieQueue.Count > 0) do 
        ProcessGCZombies;
        
      // Freeze dan destroy GC lists
      if Assigned(Gen0Objects) then
      begin
        for i := 0 to Gen0Objects.Count - 1 do
          if Assigned(Gen0Objects[i]) then
            TGCManagedObject(Gen0Objects[i]).FRefCount := 9999999;
        for i := Gen0Objects.Count - 1 downto 0 do
        begin
          try TObject(Gen0Objects[i]).Free; except end;
        end;
        Gen0Objects.Free;
      end;
      
      if Assigned(Gen1Objects) then
      begin
        for i := 0 to Gen1Objects.Count - 1 do
          if Assigned(Gen1Objects[i]) then
            TGCManagedObject(Gen1Objects[i]).FRefCount := 9999999;
        for i := Gen1Objects.Count - 1 downto 0 do
        begin
          try TObject(Gen1Objects[i]).Free; except end;
        end;
        Gen1Objects.Free;
      end;
      
      if Assigned(GlobalDMAPointers) then 
      begin
        for i := 0 to GlobalDMAPointers.Count - 1 do
          FreeMem(GlobalDMAPointers[i]);
        GlobalDMAPointers.Free;
      end;
      
      if Assigned(GlobalArenaLock) then
      begin
        CleanupArena;
        GlobalArenaLock.Free;
      end;
      
      FreeThreadErrors;  
      if Assigned(ThreadEvent) then 
        RTLEventDestroy(ThreadEvent);
      
      FreeBuiltInRegistries;
      
      if GDebugEnabled then
      begin
        if Assigned(IOLock) then
          IOLock.Acquire;
        try
          Writeln;
          Writeln('=== OPCODE COUNTS ===');
          for Op := Low(TVMOpCode) to High(TVMOpCode) do
          begin
            if GDebugOpcodeCounts[Op] > 0 then
              Writeln(Format('%-25s : %d', 
                [GetEnumName(TypeInfo(TVMOpCode), Ord(Op)), 
                 GDebugOpcodeCounts[Op]]));
          end;
          Writeln('=====================');
        finally
          if Assigned(IOLock) then
            IOLock.Release;
        end;
      end;

      if not HasRunawayThreads then
      begin
        if Assigned(WorkerRegistryLock) then WorkerRegistryLock.Free;
        if Assigned(ZombieLock) then ZombieLock.Free;
        if Assigned(MemLock) then MemLock.Free;
        if Assigned(ScriptLock) then ScriptLock.Free;
        if Assigned(SQLiteLock) then SQLiteLock.Free;
        if Assigned(GCLock) then GCLock.Free;
        if Assigned(GCRootLock) then GCRootLock.Free;
        if Assigned(GlobalFreeValueLock) then GlobalFreeValueLock.Free;
        
        // ✅ F-2a: cleanup DLL registry
        if Assigned(GDLLRegistryLock) then
        begin
          GDLLRegistryLock.Acquire;
          try
            if Assigned(GDLLRegistry) then
            begin
              for i := 0 to GDLLRegistry.Count - 1 do
                if Assigned(GDLLRegistry.Objects[i]) then
                  GDLLRegistry.Objects[i].Free;
              GDLLRegistry.Clear;
            end;
          finally
            GDLLRegistryLock.Release;
          end;
        end;
        if Assigned(GDLLRegistry) then
        begin
          GDLLRegistry.Free;
          GDLLRegistry := nil;
        end;
        if Assigned(GDLLRegistryLock) then
        begin
          GDLLRegistryLock.Free;
          GDLLRegistryLock := nil;
        end;      
        
        // B-1: free semua native buffer yang belum di-free
        if Assigned(GBufferLock) then
        begin
          GBufferLock.Acquire;
          try
            if Assigned(GBufferRegistry) then
            begin
              for i := 0 to GBufferRegistry.Count - 1 do
              begin
                if Assigned(GBufferRegistry[i]) then
                begin
                  PNativeBuffer(GBufferRegistry[i])^.Magic := 0;
                  if Assigned(PNativeBuffer(GBufferRegistry[i])^.Data) then
                    FreeMem(PNativeBuffer(GBufferRegistry[i])^.Data);
                  Dispose(PNativeBuffer(GBufferRegistry[i]));
                end;
              end;
              GBufferRegistry.Clear;
            end;
          finally
            GBufferLock.Release;
          end;
        end;
        if Assigned(GBufferRegistry) then
        begin
          GBufferRegistry.Free;
          GBufferRegistry := nil;
        end;
        if Assigned(GBufferLock) then
        begin
          GBufferLock.Free;
          GBufferLock := nil;
        end;        
        
        if Assigned(GCallbackLock) then
        begin
          GCallbackLock.Free;
          GCallbackLock := nil;
        end;     
        
        // F-3a-5a: free struct types & values
        if Assigned(GStructLock) then
        begin
          GStructLock.Acquire;
          try
            // Free semua struct value dulu (mereka refer ke type)
            if Assigned(GStructValueRegistry) then
            begin
              for i := 0 to GStructValueRegistry.Count - 1 do
              begin
                if Assigned(GStructValueRegistry[i]) then
                begin
                  PNativeStructValue(GStructValueRegistry[i])^.Magic := 0;
                  if Assigned(PNativeStructValue(GStructValueRegistry[i])^.Data) then
                    FreeMem(PNativeStructValue(GStructValueRegistry[i])^.Data);
                  Dispose(PNativeStructValue(GStructValueRegistry[i]));
                end;
              end;
              GStructValueRegistry.Clear;
            end;
            
            // Free struct types
            if Assigned(GStructTypeRegistry) then
            begin
              for i := 0 to GStructTypeRegistry.Count - 1 do
              begin
              
                if Assigned(GStructTypeRegistry[i]) then
                begin
                  PNativeStructType(GStructTypeRegistry[i])^.Magic := 0;
                  FreeFFITypeForStruct(PNativeStructType(GStructTypeRegistry[i]));
                  SetLength(PNativeStructType(GStructTypeRegistry[i])^.Fields, 0);
                  Dispose(PNativeStructType(GStructTypeRegistry[i]));
                end;
                
              end;
              GStructTypeRegistry.Clear;
            end;
          finally
            GStructLock.Release;
          end;
        end;
        if Assigned(GStructValueRegistry) then
        begin
          GStructValueRegistry.Free;
          GStructValueRegistry := nil;
        end;
        if Assigned(GStructTypeRegistry) then
        begin
          GStructTypeRegistry.Free;
          GStructTypeRegistry := nil;
        end;
        if Assigned(GStructLock) then
        begin
          GStructLock.Free;
          GStructLock := nil;
        end;
        
        // F-3a-5c: free struct call contexts
        if Assigned(GStructCallLock) then
        begin
          GStructCallLock.Acquire;
          try
            if Assigned(GStructCallRegistry) then
            begin
              for i := 0 to GStructCallRegistry.Count - 1 do
                if Assigned(GStructCallRegistry.Data[i]) then
                  GStructCallRegistry.Data[i].Free;
              GStructCallRegistry.Clear;
            end;
          finally
            GStructCallLock.Release;
          end;
        end;
        if Assigned(GStructCallRegistry) then
        begin
          GStructCallRegistry.Free;
          GStructCallRegistry := nil;
        end;
        if Assigned(GStructCallLock) then
        begin
          GStructCallLock.Free;
          GStructCallLock := nil;
        end;

        if Assigned(GFFILock) then
        begin
          GFFILock.Acquire;
          try
            if GLibFFI <> NilHandle then
            begin
              // ⚠️ Sama seperti libssl: JANGAN UnloadLibrary.
              // Kalau ada closure yang masih hidup saat shutdown, unload
              // akan menyebabkan dangling pointer saat dispatcher dipanggil.
              // Biarkan OS reclaim saat exit.
              GLibFFI := NilHandle;
            end;
            GFFIAvailable := False;
          finally
            GFFILock.Release;
          end;
          GFFILock.Free;
          GFFILock := nil;
        end;        
        
        if Assigned(IOLock) then 
        begin 
          IOLock.Acquire;
          try 
            if GetEnvironmentVariable('PASCAK_DEBUG') = '1' then
              Writeln('--- Eksekusi Selesai ---'); 
          finally 
            if Assigned(ScriptThreadLock) then 
            begin
              ScriptThreadLock.Free; 
              ScriptThreadLock := nil; 
            end;          
            IOLock.Release; 
          end;
          IOLock.Free; 
          IOLock := nil; 
        end;
      end
      else
      begin
        if Assigned(IOLock) then 
        begin 
          IOLock.Acquire;
          try 
            if GetEnvironmentVariable('PASCAK_DEBUG') = '1' then
              Writeln('--- Eksekusi Selesai (mode terbatas) ---');             
            
          finally IOLock.Release; end;
        end;
      end;
    end;
  end;
  
  {$IFDEF UNIX}
  Flush(Output);
  Flush(ErrOutput);
  libc__exit(ExitCode);
  {$ELSE}
  Halt(ExitCode);
  {$ENDIF}
end;


// MAIN APP
{ E.4 Phase 2a: LSP Server implementation }

constructor TLspServer.Create;
{$IFDEF WINDOWS}
var
  InHandle, OutHandle: THandle;
{$ENDIF}
begin
  inherited Create;
  {$IFDEF WINDOWS}
  InHandle := GetStdHandle(STD_INPUT_HANDLE);
  OutHandle := GetStdHandle(STD_OUTPUT_HANDLE);
  if (InHandle <> INVALID_HANDLE_VALUE) and (InHandle <> 0) then
    FInput := THandleStream.Create(InHandle);
  if (OutHandle <> INVALID_HANDLE_VALUE) and (OutHandle <> 0) then
    FOutput := THandleStream.Create(OutHandle);
  {$ELSE}
  FInput := THandleStream.Create(0);
  FOutput := THandleStream.Create(1);
  {$ENDIF}
  FSequence := 0;
  FShutdownRequested := False;
  FExitRequested := False;
  FDocumentURI := '';
  FDocumentText := '';
  FLock := TCriticalSection.Create;
end;

destructor TLspServer.Destroy;
begin
  if Assigned(FInput) then FInput.Free;
  if Assigned(FOutput) then FOutput.Free;
  if Assigned(FLock) then FLock.Free;
  inherited;
end;

function TLspServer.ReadMessage(out Msg: TJSONObject): Boolean;
var
  Header, Content: string;
  B: Byte;
  ContentLen, P, LineEnd: Integer;
  JSONData: TJSONData;
begin
  Result := False;
  Msg := nil;
  if not Assigned(FInput) then Exit;

  Header := '';
  ContentLen := 0;

  try
    while FInput.Read(B, 1) = 1 do
    begin
      Header := Header + Char(B);
      if (Length(Header) >= 4) and
         (Copy(Header, Length(Header) - 3, 4) = #13#10#13#10) then
        Break;
      if Length(Header) > 8192 then Exit;
    end;
  except
    Exit;
  end;

  if Header = '' then Exit;

  P := Pos('Content-Length:', Header);
  if P = 0 then Exit;
  Inc(P, Length('Content-Length:'));
  LineEnd := P;
  while (LineEnd <= Length(Header)) and
        (Header[LineEnd] <> #13) and
        (Header[LineEnd] <> #10) do
    Inc(LineEnd);
  ContentLen := StrToIntDef(Trim(Copy(Header, P, LineEnd - P)), 0);
  if ContentLen <= 0 then Exit;

  SetLength(Content, ContentLen);
  try
    if FInput.Read(Content[1], ContentLen) <> ContentLen then Exit;
  except
    Exit;
  end;

  JSONData := nil;
  try
    JSONData := GetJSON(Content);
  except
    Exit;
  end;

  if Assigned(JSONData) and (JSONData.JSONType = jtObject) then
  begin
    Msg := TJSONObject(JSONData);
    Result := True;
  end
  else if Assigned(JSONData) then
    JSONData.Free;
end;

procedure TLspServer.WriteMessage(const JSONStr: string);
var
  Header: string;
begin
  if not Assigned(FOutput) then Exit;
  Header := Format('Content-Length: %d'#13#10#13#10, [Length(JSONStr)]);
  FLock.Acquire;
  try
    try
      FOutput.WriteBuffer(Header[1], Length(Header));
      if JSONStr <> '' then
        FOutput.WriteBuffer(JSONStr[1], Length(JSONStr));
    except
    end;
  finally
    FLock.Release;
  end;
end;

procedure TLspServer.SendResponse(ReqId: TJSONData; Result: TJSONData);
var
  Root: TJSONObject;
  J: string;
begin
  Inc(FSequence);
  Root := TJSONObject.Create;
  try
    Root.Add('jsonrpc', '2.0');
    if Assigned(ReqId) then
      Root.Add('id', ReqId.Clone)
    else
      Root.Add('id', TJSONNull.Create);
    if Assigned(Result) then
      Root.Add('result', Result.Clone)
    else
      Root.Add('result', TJSONNull.Create);
    J := Root.AsJSON;
  finally
    Root.Free;
  end;
  WriteMessage(J);
end;

procedure TLspServer.SendError(ReqId: TJSONData; ErrCode: Integer; const Msg: string);
var
  Root, ErrObj: TJSONObject;
  J: string;
begin
  Inc(FSequence);
  Root := TJSONObject.Create;
  try
    Root.Add('jsonrpc', '2.0');
    if Assigned(ReqId) then
      Root.Add('id', ReqId.Clone)
    else
      Root.Add('id', TJSONNull.Create);
    ErrObj := TJSONObject.Create;
    ErrObj.Add('code', ErrCode);
    ErrObj.Add('message', Msg);
    Root.Add('error', ErrObj);
    J := Root.AsJSON;
  finally
    Root.Free;
  end;
  WriteMessage(J);
end;

procedure TLspServer.SendNotification(const Method: string; Params: TJSONObject);
var
  Root: TJSONObject;
  J: string;
begin
  Inc(FSequence);
  Root := TJSONObject.Create;
  try
    Root.Add('jsonrpc', '2.0');
    Root.Add('method', Method);
    if Assigned(Params) then
      Root.Add('params', Params.Clone)
    else
      Root.Add('params', TJSONNull.Create);
    J := Root.AsJSON;
  finally
    Root.Free;
  end;
  WriteMessage(J);
end;

procedure TLspServer.HandleRequest(const Method: string; ReqId: TJSONData; Params: TJSONObject);
begin
  if Method = 'initialize' then
    HandleInitialize(ReqId)
  else if Method = 'shutdown' then
    HandleShutdown(ReqId)
  else if Method = 'textDocument/hover' then
    HandleHover(ReqId, Params)
  else if Method = 'textDocument/completion' then
    HandleCompletion(ReqId, Params)
  else if Method = 'textDocument/definition' then
    HandleDefinition(ReqId, Params)
  else if Method = 'textDocument/didOpen' then
    HandleDidOpen(Params)
  else if Method = 'textDocument/didChange' then
    HandleDidChange(Params)
  else if Method = 'textDocument/didClose' then
    HandleDidClose(Params)
  else if Method = 'exit' then
    FExitRequested := True
  else if (Pos('$/cancelRequest', Method) <> 1) and Assigned(ReqId) then
    SendError(ReqId, -32601, 'Method not found: ' + Method);
  // notifications (ReqId=nil) — ignore if unknown
end;

procedure TLspServer.HandleInitialize(ReqId: TJSONData);
var
  Result, Caps, ServerInfo, SyncOpts: TJSONObject;
  OffsetEnc: TJSONArray;
begin
  Result := TJSONObject.Create;
  try
    Caps := TJSONObject.Create;
    try
      // textDocumentSync = 2 (Incremental)
      Caps.Add('textDocumentSync', 2);
      Caps.Add('hoverProvider', True);
      Caps.Add('completionProvider', TJSONObject.Create(['triggerCharacters', TJSONArray.Create(['.', ':'])]));
      Caps.Add('definitionProvider', True);
      ServerInfo := TJSONObject.Create;
      ServerInfo.Add('name', 'pascak-lsp');
      ServerInfo.Add('version', '0.1.0');
      Caps.Add('serverInfo', ServerInfo);
    except
      Caps.Free;
      raise;
    end;
    Result.Add('capabilities', Caps);

    SyncOpts := TJSONObject.Create;
    SyncOpts.Add('openClose', True);
    SyncOpts.Add('change', 2);
    Result.Add('textDocumentSyncOptions', SyncOpts);

    OffsetEnc := TJSONArray.Create;
    OffsetEnc.Add('utf-16');
    Result.Add('positionEncoding', OffsetEnc);

    SendResponse(ReqId, Result);
  finally
    Result.Free;
  end;
end;

procedure TLspServer.HandleShutdown(ReqId: TJSONData);
begin
  FShutdownRequested := True;
  SendResponse(ReqId, nil);
end;

procedure TLspServer.HandleDidOpen(Params: TJSONObject);
var
  Doc: TJSONData;
  URI, Text: string;
begin
  if not Assigned(Params) then Exit;
  Doc := Params.Find('textDocument');
  if not Assigned(Doc) or (Doc.JSONType <> jtObject) then Exit;

  URI := TJSONObject(Doc).Get('uri', '');
  Text := TJSONObject(Doc).Get('text', '');
  FDocumentURI := URI;
  FDocumentText := Text;
  WriteLn(ErrOutput, '[lsp-open] URI=', URI, ' textlen=', Length(Text)); Flush(ErrOutput);
  RunDiagnostics;
end;

procedure TLspServer.HandleDidChange(Params: TJSONObject);
var
  Doc, Changes: TJSONData;
  ChangesArr: TJSONArray;
  ChangeObj: TJSONObject;
  I: Integer;
begin
  if not Assigned(Params) then Exit;
  Doc := Params.Find('textDocument');
  if Assigned(Doc) and (Doc.JSONType = jtObject) then
    FDocumentURI := TJSONObject(Doc).Get('uri', FDocumentURI);

  Changes := Params.Find('contentChanges');
  if not Assigned(Changes) or (Changes.JSONType <> jtArray) then Exit;

  ChangesArr := TJSONArray(Changes);
  for I := 0 to ChangesArr.Count - 1 do
  begin
    if ChangesArr.Items[I].JSONType = jtObject then
    begin
      ChangeObj := TJSONObject(ChangesArr.Items[I]);
      FDocumentText := ChangeObj.Get('text', FDocumentText);
    end;
  end;
  RunDiagnostics;
end;

procedure TLspServer.HandleDidClose(Params: TJSONObject);
var
  URI: string;
  N, P, DiagsArr: TJSONObject;
begin
  URI := FDocumentURI;
  N := TJSONObject.Create;
  try
    N.Add('uri', URI);
    DiagsArr := TJSONObject.Create;
    DiagsArr.Add('diagnostics', TJSONArray.Create);
    N.Add('diagnostics', TJSONArray.Create);
  except
    N.Free;
    raise;
  end;
  // Build proper notification params: {uri, diagnostics: []}
  P := TJSONObject.Create;
  try
    P.Add('uri', URI);
    P.Add('diagnostics', TJSONArray.Create);
    SendNotification('textDocument/publishDiagnostics', P);
  finally
    P.Free;
    N.Free;
  end;
  FDocumentURI := '';
  FDocumentText := '';
end;

function LspExtractWordAtPos(const Text: string; Line, Character: Integer): string;
var
  Lines: TStringArray;
  TargetLine: string;
  I, LineLen, StartIdx, EndIdx: Integer;
begin
  Result := '';
  Lines := Text.Split([#10]);
  if (Line < 0) or (Line >= Length(Lines)) then Exit;
  TargetLine := Lines[Line];
  // strip \r
  if (Length(TargetLine) > 0) and (TargetLine[Length(TargetLine)] = #13) then
    SetLength(TargetLine, Length(TargetLine) - 1);
  LineLen := Length(TargetLine);
  if LineLen = 0 then Exit;
  if Character < 0 then Character := 0;
  if Character >= LineLen then Character := LineLen - 1;

  // expand from character pos to word boundary
  StartIdx := Character;
  while (StartIdx > 0) and
        (TargetLine[StartIdx] in ['a'..'z','A'..'Z','0'..'9','_']) do
    Dec(StartIdx);
  if not (TargetLine[StartIdx + 1] in ['a'..'z','A'..'Z','0'..'9','_']) then
    if StartIdx + 1 <= LineLen then StartIdx := StartIdx + 1;
  EndIdx := Character;
  while (EndIdx + 1 <= LineLen) and
        (TargetLine[EndIdx + 1] in ['a'..'z','A'..'Z','0'..'9','_']) do
    Inc(EndIdx);
  if EndIdx >= StartIdx then
    Result := Copy(TargetLine, StartIdx + 1, EndIdx - StartIdx);
end;

function LspFindVarInBlock(Block: TBlockNode; const Word: string): string;
var
  I: Integer;
  Stmt: TNode;
begin
  Result := '';
  if not Assigned(Block) then Exit;
  for I := 0 to Block.Statements.Count - 1 do
  begin
    Stmt := TNode(Block.Statements[I]);
    if Stmt is TVarDeclNode then
    begin
      if TVarDeclNode(Stmt).VarName = Word then
      begin
        if TVarDeclNode(Stmt).IsConst then Exit('const')
        else Exit('variable');
      end;
    end
    else if Stmt is TFunctionNode then
    begin
      if TFunctionNode(Stmt).Name = Word then Exit('function');
    end
    else if Stmt is TClassDeclNode then
    begin
      if TClassDeclNode(Stmt).sClassName = Word then Exit('class');
    end
    else if Stmt is TBlockNode then
    begin
      Result := LspFindVarInBlock(TBlockNode(Stmt), Word);
      if Result <> '' then Exit;
    end;
  end;
end;

procedure TLspServer.HandleHover(ReqId: TJSONData; Params: TJSONObject);
var
  Doc, PosObj, Result, Contents: TJSONObject;
  RangeObj, StartPos, EndPos: TJSONObject;
  LineVal, CharVal: Integer;
  Word, TypeHint, Markdown: string;
  Lex: TLexer;
  Pars: TParser;
  Root: TBlockNode;
  I: Integer;
begin
  if not Assigned(Params) then
  begin
    SendResponse(ReqId, nil);
    Exit;
  end;

  Doc := TJSONObject(Params.Find('textDocument'));
  if not Assigned(Doc) then
  begin
    SendResponse(ReqId, nil);
    Exit;
  end;

  PosObj := TJSONObject(Params.Find('position'));
  if not Assigned(PosObj) then
  begin
    SendResponse(ReqId, nil);
    Exit;
  end;

  LineVal := PosObj.Get('line', 0);
  CharVal := PosObj.Get('character', 0);
  Word := LspExtractWordAtPos(FDocumentText, LineVal, CharVal);

  if Word = '' then
  begin
    SendResponse(ReqId, nil);
    Exit;
  end;

  TypeHint := 'identifier';
  try
    Lex := TLexer.Create(FDocumentText);
    Pars := TParser.Create(Lex);
    Root := nil;
    try
      try
        Root := Pars.ParseMainProgram;
        if Assigned(Root) and (Root is TBlockNode) then
        begin
          Word := LspFindVarInBlock(TBlockNode(Root), Word);
          if Word <> '' then
            TypeHint := Word
          else
            TypeHint := 'identifier';
          Word := LspExtractWordAtPos(FDocumentText, LineVal, CharVal);
        end;
      except
      end;
    finally
      if Assigned(Root) then Root.Free;
      if Assigned(Pars) then Pars.Free;
      if Assigned(Lex) then Lex.Free;
    end;
  except
  end;

  Markdown := '`' + Word + '` — *' + TypeHint + '*';
  Contents := TJSONObject.Create;
  try
    Contents.Add('kind', 'markdown');
    Contents.Add('value', Markdown);
  except
    Contents.Free;
    raise;
  end;

  Result := TJSONObject.Create;
  try
    Result.Add('contents', Contents);

    RangeObj := TJSONObject.Create;
    StartPos := TJSONObject.Create;
    StartPos.Add('line', LineVal);
    StartPos.Add('character', CharVal);
    EndPos := TJSONObject.Create;
    EndPos.Add('line', LineVal);
    EndPos.Add('character', CharVal + Length(Word));
    RangeObj.Add('start', StartPos);
    RangeObj.Add('end', EndPos);
    Result.Add('range', RangeObj);

    SendResponse(ReqId, Result);
  finally
    Result.Free;
  end;
end;

