function LogArgsToString(Args: TObjectList): string;
var i: Integer;
begin
  Result := '';
  for i := 0 to Args.Count - 1 do
    Result := Result + TValueToString(TValue(Args[i]), False);
end;

function LogJsonEscape(const S: string): string;
var i: Integer; c: Char;
begin
  Result := '';
  for i := 1 to Length(S) do
  begin
    c := S[i];
    case c of
      '"': Result := Result + '\"';
      '\': Result := Result + '\\';
      #10: Result := Result + '\n';
      #13: Result := Result + '\r';
      #9:  Result := Result + '\t';
    else
      if c < #32 then
        Result := Result + '\u' + IntToHex(Ord(c), 4)
      else
        Result := Result + c;
    end;
  end;
end;

procedure LogWriteInternal(ALevel: Integer; const AMsg: string);
var
  LevelStr, TimeStr, Line: string;
  FS: TFileStream;
  IsValidTime: Boolean;
begin
  if ALevel < GLogLevel then Exit;

  case ALevel of
    0: LevelStr := 'DEBUG';
    1: LevelStr := 'INFO';
    2: LevelStr := 'WARN';
    3: LevelStr := 'ERROR';
  else
    LevelStr := 'INFO';
  end;

  IsValidTime := True;
  try
    TimeStr := FormatDateTime('yyyy-mm-dd hh:nn:ss', Now);
  except
    TimeStr := '0000-00-00 00:00:00';
    IsValidTime := False;
  end;

  if GLogFormat = 0 then
    Line := TimeStr + ' [' + LevelStr + '] ' + AMsg
  else
    Line := '{"ts":"' + TimeStr + '","level":"' +
            LowerCase(LevelStr) + '","msg":"' + LogJsonEscape(AMsg) + '"}';

  if not Assigned(GLogLock) then
  begin
    try Writeln(Line); except end;
    Exit;
  end;

  GLogLock.Acquire;
  try
    try
      case GLogOutput of
        0: begin Writeln(Line); Flush(Output); end;
        1: begin Writeln(ErrOutput, Line); Flush(ErrOutput); end;
        2:
          begin
            if GLogFilePath <> '' then
            begin
              try
                if FileExists(GLogFilePath) then
                  FS := TFileStream.Create(GLogFilePath,
                        fmOpenWrite or fmShareDenyNone)
                else
                  FS := TFileStream.Create(GLogFilePath, fmCreate);
                try
                  FS.Position := FS.Size;
                  Line := Line + #10;
                  FS.WriteBuffer(Line[1], Length(Line));
                finally
                  FS.Free;
                end;
              except
                // fail-silent
              end;
            end;
          end;
      end;
    except
      // fail-silent — log error tidak boleh crash engine
    end;
  finally
    GLogLock.Release;
  end;
end;

function Native_LogDebug(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  LogWriteInternal(0, LogArgsToString(Args));
  Result := TValue.CreateNull;
end;

function Native_LogInfo(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  LogWriteInternal(1, LogArgsToString(Args));
  Result := TValue.CreateNull;
end;

function Native_LogWarn(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  LogWriteInternal(2, LogArgsToString(Args));
  Result := TValue.CreateNull;
end;

function Native_LogError(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  LogWriteInternal(3, LogArgsToString(Args));
  Result := TValue.CreateNull;
end;

function Native_LogSetLevel(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  S: string;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 'log.setLevel("debug|info|warn|error")',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  S := LowerCase(Trim(TValue(Args[0]).StrVal));
  if      S = 'debug' then GLogLevel := 0
  else if S = 'info'  then GLogLevel := 1
  else if S = 'warn'  then GLogLevel := 2
  else if S = 'error' then GLogLevel := 3;
  Result := TValue.CreateNull;
end;

function Native_LogSetFormat(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var S: string;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 'log.setFormat("plain|json")', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  S := LowerCase(Trim(TValue(Args[0]).StrVal));
  if      S = 'plain' then GLogFormat := 0
  else if S = 'json'  then GLogFormat := 1;
  Result := TValue.CreateNull;
end;

function Native_LogSetOutput(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var S, P: string;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 'log.setOutput("stdout|stderr|file", [path])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  S := LowerCase(Trim(TValue(Args[0]).StrVal));
  if S = 'stdout' then
  begin
    GLogOutput := 0;
    GLogFilePath := '';
  end
  else if S = 'stderr' then
  begin
    GLogOutput := 1;
    GLogFilePath := '';
  end
  else if S = 'file' then
  begin
    if (Args.Count < 2) or (TValue(Args[1]).DataType <> dtString) then
    begin
      errMSG.callerror(140, 'log.setOutput("file", path)', errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateNull);
    end;
    P := TValue(Args[1]).StrVal;
    try
      P := GetSafeSandboxedPath(P);
    except
      on E: Exception do
      begin
        errMSG.callerror(144, 'log.setOutput: ' + E.Message, errMSG.xrow, errMSG.xcol);
        Exit(TValue.CreateNull);
      end;
    end;
    GLogOutput := 2;
    GLogFilePath := P;
  end;
  Result := TValue.CreateNull;
end;//end Structured Logging

//native Signal Handling════════════════════════════════════════════════════
//═══════════════════════════════════════════════════════════════ }
function Native_OnShutdown(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var Cb: TValue;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtFunction) then
  begin
    errMSG.callerror(139, 'onShutdown(fn) butuh 1 argumen fungsi',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  Cb := TValue(Args[0]);
  if not Assigned(GShutdownLock) then Exit(TValue.CreateBool(False));
  GShutdownLock.Acquire;
  try
    GShutdownHooks.Add(Cb.Clone);
  finally
    GShutdownLock.Release;
  end;
  Result := TValue.CreateBool(True);
end;

procedure RunShutdownHooks(CallEnv: TSymbolTable);
var
  i, HookCount: Integer;
  Cb: TValue;
  MiniVM: TVM;
  TmpChunk: TChunk;
  Res: TValue;
  StartTime: QWord;
  TimedOut: Boolean;
begin
  if not Assigned(GShutdownHooks) or not Assigned(GShutdownLock) then Exit;
  if InterlockedCompareExchange(GShutdownRunning, 1, 0) <> 0 then Exit;

  GShutdownLock.Acquire;
  try HookCount := GShutdownHooks.Count;
  finally GShutdownLock.Release; end;
  if HookCount = 0 then Exit;

  if Assigned(IOLock) then
  begin
    IOLock.Acquire;
    try Writeln('[shutdown] running ', HookCount, ' hook(s)');
    finally IOLock.Release; end;
  end;

  for i := HookCount - 1 downto 0 do
  begin
    Cb := nil;
    GShutdownLock.Acquire;
    try
      if i < GShutdownHooks.Count then Cb := GShutdownHooks[i];
    finally GShutdownLock.Release; end;
    if not Assigned(Cb) then Continue;

    MiniVM := nil; TmpChunk := nil; Res := nil;
    TimedOut := False;
    StartTime := GetTickCount64;
    try
      if Assigned(Cb.ClosureEnv) then MiniVM := TVM.Create(Cb.ClosureEnv)
      else if Assigned(CallEnv) then MiniVM := TVM.Create(CallEnv.GetGlobal)
      else MiniVM := TVM.Create(nil);
      MiniVM.MaxExecutionTimeMs := 5000;

      TmpChunk := TChunk.Create;
      TmpChunk.AddInstruction(opcConstant, TmpChunk.AddConstant(Cb.Clone));
      TmpChunk.AddInstruction(opcCall, 0);
      TmpChunk.AddInstruction(opcReturn);
      Res := MiniVM.Run(TmpChunk);
      if Assigned(Res) then Res.Free;
    except
      on E: Exception do
      begin
        if (GetTickCount64 - StartTime) >= 5000 then TimedOut := True;
        if Assigned(IOLock) then
        begin
          IOLock.Acquire;
          try
            if TimedOut then
              Writeln(ErrOutput, '[shutdown] hook timeout (5s)')
            else
              Writeln(ErrOutput, '[shutdown] hook error: ', E.Message);
          finally IOLock.Release; end;
        end;
      end;
    end;
    if Assigned(TmpChunk) then TmpChunk.Free;
    if Assigned(MiniVM) then MiniVM.Free;
  end;

  InterlockedExchange(GShutdownRunning, 0);
end;

function Native_SignalOn(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SigName: string;
  Cb: TValue;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtFunction) then
  begin
    errMSG.callerror(140, 'signal.on("SIGINT"|"SIGTERM", fn)',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;

  SigName := UpperCase(Trim(TValue(Args[0]).StrVal));
  Cb := TValue(Args[1]);

  InstallSignalHandlers;

  GSignalLock.Acquire;
  try
    if SigName = 'SIGINT' then
      GSignalCallbackINT.Add(Cb.Clone)
    else if SigName = 'SIGTERM' then
      GSignalCallbackTERM.Add(Cb.Clone)
    else
    begin
      errMSG.callerror(144, 'signal.on: signal tidak didukung — ' + SigName,
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateBool(False));
    end;
  finally
    GSignalLock.Release;
  end;
  Result := TValue.CreateBool(True);
end;

function Native_SignalOff(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var SigName: string;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'signal.off("SIGINT"|"SIGTERM")', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  SigName := UpperCase(Trim(TValue(Args[0]).StrVal));
  GSignalLock.Acquire;
  try
    if SigName = 'SIGINT' then
      GSignalCallbackINT.Clear
    else if SigName = 'SIGTERM' then
      GSignalCallbackTERM.Clear
    else
      Exit(TValue.CreateBool(False));
  finally
    GSignalLock.Release;
  end;
  Result := TValue.CreateBool(True);
end;

function Native_SignalRaise(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var SigName: string; Sig: cint;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'signal.raise("SIGINT"|"SIGTERM")', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  SigName := UpperCase(Trim(TValue(Args[0]).StrVal));
  {$IFDEF UNIX}
  if SigName = 'SIGINT' then Sig := SIGINT
  else if SigName = 'SIGTERM' then Sig := SIGTERM
  else begin
    errMSG.callerror(144, 'signal.raise: signal tidak didukung — ' + SigName,
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  fpKill(fpGetPid, Sig);
  {$ENDIF}
  Result := TValue.CreateBool(True);
end;//end native Signal Handling


