function Native_Range(Args: TObjectList; CallEnv: TSymbolTable): TValue;
const 
  MAX_RANGE_MEM = 5000000; 
var
  StartIdx, EndIdx, StepVal, i, Count: Int64;
  Arr: TValueList;
begin
  StartIdx := 0; StepVal := 1; EndIdx := 0;

  // Mencegah parameter > 3 terabaikan
  if (Args.Count = 0) or (Args.Count > 3) then
    raise EScriptRuntimeError.Create('Math Error: range() membutuhkan 1 hingga maksimal 3 argumen.');

  // Konsolidasi pengecekan tipe argumen agar kode lebih DRY
  if (Args.Count >= 1) and (TValue(Args[0]).DataType <> dtNumeric) then 
    raise EScriptRuntimeError.Create('Math Error: Argumen range() pertama harus numerik.');
  if (Args.Count >= 2) and (TValue(Args[1]).DataType <> dtNumeric) then 
    raise EScriptRuntimeError.Create('Math Error: Argumen range() kedua harus numerik.');
  if (Args.Count = 3) and (TValue(Args[2]).DataType <> dtNumeric) then 
    raise EScriptRuntimeError.Create('Math Error: Argumen range() ketiga harus numerik.');

  if Args.Count = 1 then
    EndIdx := System.Trunc(TValue(Args[0]).NumVal)
  else if Args.Count >= 2 then
  begin
    StartIdx := System.Trunc(TValue(Args[0]).NumVal);
    EndIdx := System.Trunc(TValue(Args[1]).NumVal);
    
    if Args.Count = 3 then
    begin
      StepVal := System.Trunc(TValue(Args[2]).NumVal);
      if StepVal = 0 then 
        raise EScriptRuntimeError.Create('Math Error: Step pada range() tidak boleh 0.');
    end;
  end;
  
  // ✨ PATCH B: Pre-calculate jumlah elemen untuk pre-allocation
  Count := 0;
  if StepVal > 0 then
  begin
    if StartIdx < EndIdx then
      Count := (EndIdx - StartIdx + StepVal - 1) div StepVal;
  end
  else
  begin
    if StartIdx > EndIdx then
      Count := (StartIdx - EndIdx + (-StepVal) - 1) div (-StepVal);
  end;
  
  if Count > MAX_RANGE_MEM then 
    raise EScriptRuntimeError.Create('Memory Error: range() melampaui batas memori aman.');
  
  Arr := TValueList.Create(True);
  try
    // ✨ PATCH B: Pre-allocate kapasitas sekali saja (1 Acquire Lock)
    if Count > 0 then
      Arr.SetCapacity(Count);
    
    // ✨ PATCH B: Bulk fill TANPA lock per-elemen (AddUnlocked)
    i := StartIdx;
    if StepVal > 0 then
    begin
      while i < EndIdx do
      begin
        Arr.AddUnlocked(TValue.CreateNum(i));
        Inc(i, StepVal);
      end;
    end 
    else
    begin
      while i > EndIdx do
      begin
        Arr.AddUnlocked(TValue.CreateNum(i));
        Inc(i, StepVal);
      end;
    end;
    
    Result := TValue.CreateArray(Arr);
  except
    Arr.Free;
    raise;
  end;
end;

function Native_MathFsum(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  ArrVal: TValue;
  i: Integer;
  sum, c, y, t, val: Double;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtArray) then
    raise EScriptRuntimeError.Create('Math Error: fsum(array) membutuhkan 1 argumen Array numerik.');

  ArrVal := TValue(Args[0]);
  sum := 0.0;
  c := 0.0; 

  ArrVal.ArrayVal.FLock.Acquire;
  try
    for i := 0 to ArrVal.ArrayVal.Count - 1 do
    begin
      if TValue(ArrVal.ArrayVal[i]).DataType <> dtNumeric then
        raise EScriptRuntimeError.Create('Math Error: Semua elemen pada fsum harus numerik.');
      
      val := TValue(ArrVal.ArrayVal[i]).NumVal;
      y := val - c;
      t := sum + y;
      c := (t - sum) - y;
      sum := t;
    end;
  finally
    ArrVal.ArrayVal.FLock.Release;
  end;

  CheckFPUValid(sum, 'fsum');
  Result := TValue.CreateNum(sum);
end;

function Native_MathProd(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  ArrVal: TValue;
  i: Integer;
  prodVal: Double;
begin
  if (Args.Count < 1) or (TValue(Args[0]).DataType <> dtArray) then
    raise EScriptRuntimeError.Create('Math Error: prod(array) membutuhkan 1 argumen Array.');

  ArrVal := TValue(Args[0]);
  prodVal := 1.0;

  ArrVal.ArrayVal.FLock.Acquire;
  try
    if ArrVal.ArrayVal.Count = 0 then Exit(TValue.CreateNum(1.0)); 
    
    for i := 0 to ArrVal.ArrayVal.Count - 1 do
    begin
      if TValue(ArrVal.ArrayVal[i]).DataType <> dtNumeric then
        raise EScriptRuntimeError.Create('Math Error: Elemen pada prod harus numerik.');
      prodVal := prodVal * TValue(ArrVal.ArrayVal[i]).NumVal;
    end;
  finally
    ArrVal.ArrayVal.FLock.Release;
  end;

  CheckFPUValid(prodVal, 'prod');
  Result := TValue.CreateNum(prodVal);
end;

function Native_MathDist(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  ArrP, ArrQ: TValue;
  i: Integer;
  sumSq, diff: Double;
  AddrP, AddrQ: NativeUInt;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtArray) or (TValue(Args[1]).DataType <> dtArray) then
    raise EScriptRuntimeError.Create('Math Error: dist(p, q) membutuhkan 2 argumen Array vektor.');

  ArrP := TValue(Args[0]);
  ArrQ := TValue(Args[1]);
  
  AddrP := NativeUInt(Pointer(ArrP.ArrayVal));
  AddrQ := NativeUInt(Pointer(ArrQ.ArrayVal));

  // Mencegah Thread-Deadlock: Mengunci (Acquire) berurutan berdasarkan alamat memori terkecil
  if AddrP < AddrQ then
  begin
    ArrP.ArrayVal.FLock.Acquire;
    ArrQ.ArrayVal.FLock.Acquire;
  end
  else if AddrP > AddrQ then
  begin
    ArrQ.ArrayVal.FLock.Acquire;
    ArrP.ArrayVal.FLock.Acquire;
  end
  else
    ArrP.ArrayVal.FLock.Acquire; // Menghindari Double Lock jika object p dan q merujuk ke memori yang sama

  try
    if ArrP.ArrayVal.Count <> ArrQ.ArrayVal.Count then
      raise EScriptRuntimeError.Create('Math Error: Vektor pada dist() harus memiliki dimensi (panjang) yang sama.');

    sumSq := 0.0;
    for i := 0 to ArrP.ArrayVal.Count - 1 do
    begin
      if (TValue(ArrP.ArrayVal[i]).DataType <> dtNumeric) or (TValue(ArrQ.ArrayVal[i]).DataType <> dtNumeric) then
        raise EScriptRuntimeError.Create('Math Error: Kordinat vektor harus numerik.');
        
      diff := TValue(ArrP.ArrayVal[i]).NumVal - TValue(ArrQ.ArrayVal[i]).NumVal;
      sumSq := sumSq + (diff * diff);
    end;
  finally
    // Melepas kunci (Release) secara aman
    if AddrP <> AddrQ then
    begin
      ArrQ.ArrayVal.FLock.Release;
      ArrP.ArrayVal.FLock.Release;
    end
    else
      ArrP.ArrayVal.FLock.Release;
  end;

  Result := TValue.CreateNum(Sqrt(sumSq));
end;

