function ExtractStringArgs(Arr: TValue): TStringArray;
var
  i: Integer;
begin
  Result := nil;
  SetLength(Result, 0);
  if not Assigned(Arr) then Exit;
  if Arr.DataType <> dtArray then Exit;
  
  Arr.ArrayVal.FLock.Acquire;
  try
    SetLength(Result, Arr.ArrayVal.Count);
    for i := 0 to Arr.ArrayVal.Count - 1 do
    begin
      if Assigned(Arr.ArrayVal[i]) and (Arr.ArrayVal[i].DataType = dtString) then
        Result[i] := Arr.ArrayVal[i].StrVal
      else
        Result[i] := '';
    end;
  finally
    Arr.ArrayVal.FLock.Release;
  end;
end;

function Native_SysExec(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Cmd: string;
  CmdArgs: TStringArray;
  OutStr, ErrStr: RawByteString;
  ExitCode: Integer;
  TimeoutMs: Integer;
  ResDict: TDictValue;
  ResVal: TValue;
  ErrDict: TDictValue;
begin
  if (Args.Count < 1) or (Args.Count > 3) or 
     (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 
      'sys.exec(cmd: string, [argsArray: array], [timeoutMs: int])',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Cmd := TValue(Args[0]).StrVal;
  CmdArgs := nil;
  TimeoutMs := 0;
  
  if Args.Count >= 2 then
  begin
    if TValue(Args[1]).DataType = dtArray then
      CmdArgs := ExtractStringArgs(TValue(Args[1]));
  end;
  
  if Args.Count >= 3 then
  begin
    if TValue(Args[2]).DataType = dtNumeric then
      TimeoutMs := Trunc(TValue(Args[2]).NumVal);
  end;
  
  if not ProcExec(Cmd, CmdArgs, OutStr, ErrStr, ExitCode, TimeoutMs) then
  begin
    // B.SEC: policy denial = graceful (return error dict).
    // Real failure (binary not found, fork fail) = raise (existing behavior).
    if Pos('exec denied', ProcLastError) > 0 then
    begin
      ErrDict := TDictValue.Create;
      try
        ErrDict.SetValue('error', TValue.CreateStr(ProcLastError));
        ErrDict.SetValue('exitCode', TValue.CreateNum(-1));
        ErrDict.SetValue('denied', TValue.CreateBool(True));
        ErrDict.SetValue('stdout', TValue.CreateStr(''));
        ErrDict.SetValue('stderr', TValue.CreateStr(''));
        Result := TValue.CreateDict(ErrDict);
      except
        ErrDict.Free;
        raise;
      end;
      Exit;
    end;
  
    errMSG.callerror(144, 
      'sys.exec gagal spawn: ' + ProcLastError,
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  // Build result dict
  ResDict := TDictValue.Create;
  try
    ResDict.SetValue('stdout', TValue.CreateStr(string(OutStr)));
    ResDict.SetValue('stderr', TValue.CreateStr(string(ErrStr)));
    ResDict.SetValue('exitCode', TValue.CreateNum(ExitCode));
    ResVal := TValue.CreateDict(ResDict);
  except
    ResDict.Free;
    raise;
  end;
  
  Result := ResVal;
end;

// sys.execPolicy(config: dict) → bool
//  Set exec policy dari script. Hanya untuk dev/test.
//  Attacker yang kontrol script TIDAK boleh bisa panggil ini di production.
function Native_SysExecPolicy(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TEngineContext; 
  Policy: TExecPolicy;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtDict) then
  begin
    errMSG.callerror(140, 'sys.execPolicy(config) butuh 1 argumen dict',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;

  // Cek apakah host mengizinkan script override
  Ctx := GetContextFromEnv(CallEnv);
  if Assigned(Ctx) and (Ctx.ExecScriptPolicyLocked) then
  begin
    errMSG.callerror(144,
      'sys.execPolicy: host telah mengunci policy — script tidak boleh override',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;

  Policy := TExecPolicy.Create;
  try
    ApplyExecPolicyDict(Policy, TValue(Args[0]));
    ProcSetExecPolicy(Policy);
  finally
    Policy.Free;
  end;

  Result := TValue.CreateBool(True);
end;

