function BuiltIn_Array_Reverse(TargetObj: TValue; const Args: array of TValue): TValue;
var
  i, j: Integer;
begin
  if Length(Args) <> 0 then errMSG.callerror(144, 'Array.reverse() tidak menerima argumen', errMSG.xrow, errMSG.xcol);
  TargetObj.ArrayVal.FLock.Acquire;
  try
    i := 0;
    j := TargetObj.ArrayVal.Count - 1;
    while i < j do
    begin
      TargetObj.ArrayVal.Exchange(i, j); 
      Inc(i);
      Dec(j);
    end;
  finally
    TargetObj.ArrayVal.FLock.Release;
  end;
  Result := TargetObj.Clone; 
end;

function BuiltIn_Array_Join(TargetObj: TValue; const Args: array of TValue): TValue;
var
  i, WritePos, SepLen: Integer;
  TotalLen: Int64; 
  Sep, ResStr: string;
  StrArr: array of string;
begin
  if Length(Args) > 1 then errMSG.callerror(144, 'Array.join([separator]) menerima maksimal 1 argumen', errMSG.xrow, errMSG.xcol);

  Sep := ',';
  // PERBAIKAN: Jika argumen ada namun bukan string (misal: numerik), konversi argumen tersebut,
  // BUKAN mengabaikannya lalu menggunakan default separator koma.
  if Length(Args) = 1 then
  begin
    if Args[0].DataType = dtString then Sep := Args[0].StrVal
    else Sep := TValueToString(Args[0], False); 
  end;
  SepLen := Length(Sep);

  TargetObj.ArrayVal.FLock.Acquire;
  try
    SetLength(StrArr, TargetObj.ArrayVal.Count);
    TotalLen := 0;
    
    for i := 0 to TargetObj.ArrayVal.Count - 1 do
    begin
      StrArr[i] := TValueToString(TargetObj.ArrayVal[i], False);
      TotalLen := TotalLen + Int64(Length(StrArr[i]));
    end;

    if TargetObj.ArrayVal.Count > 1 then
      TotalLen := TotalLen + (Int64(SepLen) * Int64(TargetObj.ArrayVal.Count - 1));

    if TotalLen > strMax then
      errMSG.callerror(40, 'BuiltIn_Array_Join: Ukuran string melampaui batas!', errMSG.xrow, errMSG.xcol);

    SetLength(ResStr, Integer(TotalLen)); 
    WritePos := 1;

    for i := 0 to High(StrArr) do
    begin
      if Length(StrArr[i]) > 0 then
      begin
        Move(StrArr[i][1], ResStr[WritePos], Length(StrArr[i]));
        Inc(WritePos, Length(StrArr[i]));
      end;
      if (i < High(StrArr)) and (SepLen > 0) then
      begin
        Move(Sep[1], ResStr[WritePos], SepLen);
        Inc(WritePos, SepLen);
      end;
    end;
  finally
    TargetObj.ArrayVal.FLock.Release;
    SetLength(StrArr, 0); 
  end;
  Result := TValue.CreateStr(ResStr);
end;

function BuiltIn_Array_IndexOf(TargetObj: TValue; const Args: array of TValue): TValue;
var
  i: Integer;
begin
  if Length(Args) <> 1 then errMSG.callerror(144, 'Array.indexOf(value) butuh tepat 1 argumen', errMSG.xrow, errMSG.xcol);
  
  TargetObj.ArrayVal.FLock.Acquire;
  try
    for i := 0 to TargetObj.ArrayVal.Count - 1 do
    begin
      if ValuesAreEqual(TargetObj.ArrayVal[i], Args[0]) then
        Exit(TValue.CreateNum(i)); 
    end;
  finally
    TargetObj.ArrayVal.FLock.Release;
  end;
  
  Result := TValue.CreateNum(-1); 
end;

function BuiltIn_Array_Map(TargetObj: TValue; const Args: array of TValue): TValue;
var
  i, ArrCount: Integer;
  CallbackFunc, MappedVal, ValIndex: TValue;
  NewArr: TValueList;
  TempSnapshot: TValueArray;
  MiniVM: TVM;
  LoopChunk: TChunk;
begin
  if (Length(Args) <> 1) or (Args[0].DataType <> dtFunction) then 
    errMSG.callerror(137, 'Array.map(callback)', errMSG.xrow, errMSG.xcol);
    
  CallbackFunc := Args[0];
  NewArr := TValueList.Create(True);
  NewArr.Retain;
  TempSnapshot := Helper_GetArraySnapshot(TargetObj.ArrayVal, ArrCount);
  
  if Assigned(CallbackFunc.ClosureEnv) then MiniVM := TVM.Create(CallbackFunc.ClosureEnv)
  else MiniVM := TVM.Create(nil); 
  
  LoopChunk := TChunk.Create;
  LoopChunk.AddInstruction(opcCall, 3); 
  LoopChunk.AddInstruction(opcReturn);  
  
  try
    for i := 0 to ArrCount - 1 do
    begin
      ValIndex := TValue.CreateNum(i); 
      try
        MiniVM.Push(CallbackFunc.Clone);
        MiniVM.Push(TempSnapshot[i].Clone);  
        MiniVM.Push(ValIndex.Clone);         
        MiniVM.Push(TargetObj.Clone);        
        MappedVal := MiniVM.Run(LoopChunk);  
      finally
        ValIndex.Free; 
      end;
      
      try NewArr.Add(MappedVal);
      except MappedVal.Free; raise; end;
    end;
    Result := TValue.CreateArray(NewArr); 
  finally
    LoopChunk.Free;
    MiniVM.Free;
    Helper_FreeArraySnapshot(TempSnapshot); 
    NewArr.Release;
  end;
end;

function BuiltIn_Array_Filter(TargetObj: TValue; const Args: array of TValue): TValue;
var
  i, ArrCount: Integer;
  CallbackFunc, BoolRes, ValIndex, ClonedVal: TValue;
  NewArr: TValueList; 
  TempSnapshot: TValueArray;
  MiniVM: TVM;
  LoopChunk: TChunk;
begin
  if (Length(Args) <> 1) or (Args[0].DataType <> dtFunction) then 
    errMSG.callerror(137, 'Array.filter(callback)', errMSG.xrow, errMSG.xcol);
    
  CallbackFunc := Args[0]; 
  NewArr := TValueList.Create(True); 
  NewArr.Retain;
  TempSnapshot := Helper_GetArraySnapshot(TargetObj.ArrayVal, ArrCount);

  if Assigned(CallbackFunc.ClosureEnv) then MiniVM := TVM.Create(CallbackFunc.ClosureEnv)
  else MiniVM := TVM.Create(nil);
  
  LoopChunk := TChunk.Create;
  LoopChunk.AddInstruction(opcCall, 3); 
  LoopChunk.AddInstruction(opcReturn);

  try
    for i := 0 to ArrCount - 1 do
    begin
      ValIndex := TValue.CreateNum(i); 
      try 
        MiniVM.Push(CallbackFunc.Clone);
        MiniVM.Push(TempSnapshot[i].Clone);
        MiniVM.Push(ValIndex.Clone);
        MiniVM.Push(TargetObj.Clone);
        BoolRes := MiniVM.Run(LoopChunk);
      finally 
        ValIndex.Free; 
      end;
      
      try
        if BoolRes.IsTrue then 
        begin
          ClonedVal := TempSnapshot[i].Clone;
          try NewArr.Add(ClonedVal); 
          except ClonedVal.Free; raise; end;
        end;      
      finally 
        BoolRes.Free; 
      end;
    end;
    Result := TValue.CreateArray(NewArr); 
  finally
    LoopChunk.Free;
    MiniVM.Free;
    Helper_FreeArraySnapshot(TempSnapshot); 
    NewArr.Release;
  end;
end;

function BuiltIn_Array_Reduce(TargetObj: TValue; const Args: array of TValue): TValue;
var
  i, ArrCount: Integer; 
  CallbackFunc, Accumulator, IterVal, ValIndex: TValue;
  TempSnapshot: TValueArray;
  MiniVM: TVM;
  LoopChunk: TChunk;
begin
  if (Length(Args) < 1) or (Length(Args) > 2) or (Args[0].DataType <> dtFunction) then 
    errMSG.callerror(137, 'Array.reduce', errMSG.xrow, errMSG.xcol);
    
  CallbackFunc := Args[0];
  TempSnapshot := Helper_GetArraySnapshot(TargetObj.ArrayVal, ArrCount);

  if ArrCount = 0 then 
  begin 
    SetLength(TempSnapshot, 0); 
    if Length(Args) = 2 then Exit(Args[1].Clone) else Exit(TValue.CreateNull); 
  end;

  i := 0;
  if Length(Args) = 2 then Accumulator := Args[1].Clone 
  else 
  begin 
    if Assigned(TempSnapshot[0]) then Accumulator := TempSnapshot[0].Clone
    else Accumulator := TValue.CreateNull; 
    i := 1; 
  end;

  if Assigned(CallbackFunc.ClosureEnv) then MiniVM := TVM.Create(CallbackFunc.ClosureEnv)
  else MiniVM := TVM.Create(nil);
  
  LoopChunk := TChunk.Create;
  LoopChunk.AddInstruction(opcCall, 4); 
  LoopChunk.AddInstruction(opcReturn);

  try
    try
      while i < ArrCount do
      begin
        ValIndex := TValue.CreateNum(i); 
        try
          MiniVM.Push(CallbackFunc.Clone);
          MiniVM.Push(Accumulator.Clone);     
          MiniVM.Push(TempSnapshot[i].Clone); 
          MiniVM.Push(ValIndex.Clone);        
          MiniVM.Push(TargetObj.Clone);       
          IterVal := MiniVM.Run(LoopChunk);
        finally
          ValIndex.Free; 
        end;

        Accumulator.Free; 
        Accumulator := IterVal; 
        Inc(i);
      end;
    except
      Accumulator.Free; 
      raise;
    end;
  finally
    LoopChunk.Free;
    MiniVM.Free;
    Helper_FreeArraySnapshot(TempSnapshot); 
  end;
  Result := Accumulator;
end;

