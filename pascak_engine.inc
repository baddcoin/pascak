function Native_SysExecAsync(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Cmd: string;
  CmdArgs: TStringArray;
  Callback: TValue;
  TimeoutMs: Integer;
  Task: TExecTask;
  Ctx: TEngineContext;
begin
  if (Args.Count < 2) or (Args.Count > 4) then
    raise EScriptRuntimeError.Create(
      'sys.execAsync(cmd, args, [callback], [timeoutMs]) butuh 2-4 argumen');
  if TValue(Args[0]).DataType <> dtString then
    raise EScriptRuntimeError.Create('sys.execAsync: cmd harus string');

  Cmd := TValue(Args[0]).StrVal;
  CmdArgs := nil;
  if TValue(Args[1]).DataType = dtArray then
    CmdArgs := ExtractStringArgs(TValue(Args[1]));

  Callback := nil;
  if Args.Count >= 3 then
    if TValue(Args[2]).DataType = dtFunction then
      Callback := TValue(Args[2]);

  TimeoutMs := 0;
  if Args.Count >= 4 then
    if TValue(Args[3]).DataType = dtNumeric then
      TimeoutMs := Trunc(TValue(Args[3]).NumVal);

  Ctx := GetContextFromEnv(CallEnv);

  InitExecTasks;

  Task := TExecTask.Create;
  Task.ID := InterlockedIncrement(GExecTaskCounter);
  Task.Cmd := Cmd;
  Task.Args := CmdArgs;
  Task.TimeoutMs := TimeoutMs;
  Task.State := EXEC_TASK_PENDING;
  Task.CallbackFired := 0;
  Task.ResultVal := nil;
  Task.Worker := nil;
  if Assigned(Callback) then
    Task.Callback := Callback.Clone
  else
    Task.Callback := nil;
  if Assigned(Ctx) then
  begin
    Ctx.Retain;
    Task.OwnerContext := Ctx;
  end
  else
    Task.OwnerContext := nil;

  Task.Worker := TExecWorkerThread.Create(Task);
  RegisterExecTask(Task);
  Task.Worker.Start;

  Result := TValue.CreateNum(Task.ID);
end;

function Native_SysExecPoll(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Task: TExecTask;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
    raise EScriptRuntimeError.Create('sys.execPoll(taskID) butuh 1 argumen numerik');

