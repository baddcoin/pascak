end;

function Native_SysExecWait(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Task: TExecTask;
  TaskID, TimeoutMs: Integer;
  StartTime: QWord;
begin
  if (Args.Count < 1) or (Args.Count > 2) then
    raise EScriptRuntimeError.Create('sys.execWait(taskID, [timeoutMs]) butuh 1-2 argumen');

  TaskID := Trunc(TValue(Args[0]).NumVal);
  TimeoutMs := 0;
  if Args.Count = 2 then
    TimeoutMs := Trunc(TValue(Args[1]).NumVal);

  Task := FindExecTask(TaskID);
  if not Assigned(Task) then Exit(TValue.CreateNull);

  StartTime := GetTickCount64;
  while InterlockedCompareExchange(Task.State, 0, 0) <> EXEC_TASK_DONE do
  begin
    if (TimeoutMs > 0) and ((GetTickCount64 - StartTime) > QWord(TimeoutMs)) then
      Break;
    // Tick event loop agar callback lain tetap proses
    if Assigned(GWSEventLoop) then
      try GWSEventLoop.Tick(10); except end
    else
      Sleep(10);
    ProcessExecCallbacks;
  end;

  if InterlockedCompareExchange(Task.State, 0, 0) = EXEC_TASK_DONE then
  begin
    if Assigned(Task.ResultVal) then
      Result := Task.ResultVal.Clone
    else
      Result := TValue.CreateNull;
  end
  else
    Result := TValue.CreateNull;
end;

function Native_SysExecCancel(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Task: TExecTask;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
    raise EScriptRuntimeError.Create('sys.execCancel(taskID) butuh 1 argumen numerik');

  Task := FindExecTask(Trunc(TValue(Args[0]).NumVal));
  if not Assigned(Task) then Exit(TValue.CreateBool(False));

  // Hanya bisa cancel kalau masih pending
  if InterlockedCompareExchange(Task.State, EXEC_TASK_CANCEL,
                                 EXEC_TASK_PENDING) = EXEC_TASK_PENDING then
    Result := TValue.CreateBool(True)
  else
    Result := TValue.CreateBool(False);
end;

function Native_SysExecFree(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Task: TExecTask;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
    raise EScriptRuntimeError.Create('sys.execFree(taskID) butuh 1 argumen numerik');

  Task := FindExecTask(Trunc(TValue(Args[0]).NumVal));
  if not Assigned(Task) then Exit(TValue.CreateBool(False));

  UnregisterExecTask(Task);
  try Task.Free; except end;
  Result := TValue.CreateBool(True);
end;

function Native_SysExecPending(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  i, Count: Integer;
begin
  Count := 0;
  if Assigned(GExecTasks) then
  begin
    GExecTasksLock.Acquire;
    try
      for i := 0 to GExecTasks.Count - 1 do
        if InterlockedCompareExchange(TExecTask(GExecTasks[i]).State, 0, 0)
           <> EXEC_TASK_DONE then
          Inc(Count);
    finally GExecTasksLock.Release; end;
  end;
  Result := TValue.CreateNum(Count);
end;


//pascak_http===============
// Semua fungsi menerima integer handle dari script, dan menggunakan
// pascak_net.pas untuk I/O. Error di-translasi ke errMSG.callerror.
// ====================================================================
procedure InitHTTPServers;
begin
  if not Assigned(GHTTPServers) then
  begin
    GHTTPServersLock := TCriticalSection.Create;
    GHTTPServers := TList.Create;
  end;
end;

function AllocHTTPServer: Integer;
var
  E: PHTTPServerEntry;
begin
  InitHTTPServers;
  New(E);
  FillChar(E^, SizeOf(E^), 0);
  E^.Used := True;
  E^.ListenSock := -1;
  
  GHTTPServersLock.Acquire;
  try
    Result := GHTTPServers.Add(E);
  finally
    GHTTPServersLock.Release;
  end;
end;

function GetHTTPServer(Handle: Integer): PHTTPServerEntry;
begin
  Result := nil;
  if not Assigned(GHTTPServers) then Exit;
  if (Handle < 0) or (Handle >= GHTTPServers.Count) then Exit;
  Result := PHTTPServerEntry(GHTTPServers[Handle]);
  if Assigned(Result) and (not Result^.Used) then
    Result := nil;
end;

procedure FreeHTTPServer(Handle: Integer);
var E: PHTTPServerEntry;
begin
  E := GetHTTPServer(Handle);
  if E = nil then Exit;
  
  if E^.ListenSock >= 0 then
  begin
    NetClose(E^.ListenSock);
    E^.ListenSock := -1;
  end;
  
  if Assigned(E^.Handler) then
  begin
    E^.Handler.Free;
    E^.Handler := nil;
  end;
  
  // ✅ C-2: release TLS context
  if Assigned(E^.TLSContext) then
  begin
    TLSServerContext(E^.TLSContext).Release;
    E^.TLSContext := nil;
  end;
  
  E^.Used := False;
end;

// Helper: string → RawByteString tanpa codepage conversion
function StrToRaw(const S: string): RawByteString; inline;
begin
  SetLength(Result, Length(S));
  if Length(S) > 0 then Move(S[1], Result[1], Length(S));
end;

function RawToStr(const B: RawByteString): string; inline;
begin
  SetLength(Result, Length(B));
  if Length(B) > 0 then Move(B[1], Result[1], Length(B));
end;

// Native: http.serve(port, handler) → serverHandle
// Handler = lambda(req) → res dict
function Native_HTTP_Serve(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Port, Handle, Sock: Integer;
  Handler: TValue;
  E: PHTTPServerEntry;
begin
  if (Args.Count <> 2) or 
     (TValue(Args[0]).DataType <> dtNumeric) or
     (TValue(Args[1]).DataType <> dtFunction) then
  begin
    errMSG.callerror(140, 'http.serve(port, handler) butuh (int, function)',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Port := Trunc(TValue(Args[0]).NumVal);
  Handler := TValue(Args[1]);
  
  if (Port < 1) or (Port > 65535) then
  begin
    errMSG.callerror(138, 'http.serve: port harus 1..65535',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  // Listen on 0.0.0.0:Port
  if not NetListen('0.0.0.0', Port, Sock) then
  begin
    errMSG.callerror(145, 'http.serve: listen gagal — ' + NetLastError,
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Handle := AllocHTTPServer;
  E := GetHTTPServer(Handle);
  E^.ListenSock := Sock;
  E^.Port := Port;
  E^.Handler := Handler.Clone;
  
  Result := TValue.CreateNum(Handle);
end;

function Native_HTTP_ServeTLS(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Port, Handle, Sock: Integer;
  CertPath, KeyPath, SafeCert, SafeKey, HomeDir: string;
  Handler: TValue;
  E: PHTTPServerEntry;
  Ctx: TLSServerContext;
  Msg:string;
begin
  if (Args.Count <> 4) or 
     (TValue(Args[0]).DataType <> dtNumeric) or
     (TValue(Args[1]).DataType <> dtString) or
     (TValue(Args[2]).DataType <> dtString) or
     (TValue(Args[3]).DataType <> dtFunction) then
  begin
    errMSG.callerror(140, 'http.serveTLS(port, cert, key, handler) butuh (int, str, str, fn)',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Port := Trunc(TValue(Args[0]).NumVal);
  CertPath := TValue(Args[1]).StrVal;
  KeyPath := TValue(Args[2]).StrVal;
  Handler := TValue(Args[3]);
  
  if (Port < 1) or (Port > 65535) then
  begin
    errMSG.callerror(138, 'http.serveTLS: port harus 1..65535',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  // Sandbox: absolute path di $HOME diizinkan (untuk cert dev)
  HomeDir := GetEnvironmentVariable('HOME');
  
  if (Length(CertPath) > 0) and (CertPath[1] = '/') and
     (HomeDir <> '') and (Copy(CertPath, 1, Length(HomeDir)) = HomeDir) then
    SafeCert := CertPath
  else
    SafeCert := GetSafeSandboxedPath(CertPath);
  
  if (Length(KeyPath) > 0) and (KeyPath[1] = '/') and
     (HomeDir <> '') and (Copy(KeyPath, 1, Length(HomeDir)) = HomeDir) then
    SafeKey := KeyPath
  else
    SafeKey := GetSafeSandboxedPath(KeyPath);
  
  if not TLSInit then
  begin
    errMSG.callerror(144, 'http.serveTLS: libssl tidak tersedia',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  Ctx := TLSServerContext.Create(SafeCert, SafeKey);
  if not Ctx.IsValid then
  begin
    Msg := Ctx.LastError;
    Ctx.Release;
    errMSG.callerror(144, 'http.serveTLS: ' + Msg, errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  if not NetListen('0.0.0.0', Port, Sock) then
  begin
    Ctx.Release;
    errMSG.callerror(145, 'http.serveTLS: listen gagal — ' + NetLastError,
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Handle := AllocHTTPServer;
  E := GetHTTPServer(Handle);
  E^.ListenSock := Sock;
  E^.Port := Port;
  E^.Handler := Handler.Clone;
  E^.IsTLS := True;
  E^.TLSContext := Pointer(Ctx);   // refcount = 1 (kami hold)
  E^.TLSCert := SafeCert;
  E^.TLSKey := SafeKey;
  
  Result := TValue.CreateNum(Handle);
end;

// Build req dict dari parsed THTTPRequest
function BuildRequestDict(const Req: THTTPRequest): TValue;
var
  D: TDictValue;
  H: TDictValue;
  i: Integer;
begin
  D := TDictValue.Create;
  H := TDictValue.Create;
  
  for i := 0 to Req.HeaderNames.Count - 1 do
    H.SetValue(Req.HeaderNames[i], TValue.CreateStr(Req.HeaderValues[i]));
  
  D.SetValue('method', TValue.CreateStr(Req.Method));
  D.SetValue('path', TValue.CreateStr(Req.Path));
  D.SetValue('query', TValue.CreateStr(Req.QueryString));
  D.SetValue('version', TValue.CreateStr(Req.Version));
  D.SetValue('headers', TValue.CreateDict(H));
  D.SetValue('body', TValue.CreateStr(RawToStr(Req.Body)));
  
  Result := TValue.CreateDict(D);
end;

// Terapkan res dict ke THTTPResponse
procedure ApplyResponseDict(var Resp: THTTPResponse; ResDict: TValue);
var
  Status, HeadersDict, Body: TValue;
  Keys: TStringArray;
  HV: TValue;
  i: Integer;
begin
  if (not Assigned(ResDict)) or (ResDict.DataType <> dtDict) then Exit;
  
  // ✅ FIX: GetValueClone — hindari double-free
  Status := ResDict.DictVal.GetValueClone('status');
  if Assigned(Status) then
  begin
    if Status.DataType = dtNumeric then
    begin
      Resp.Status := Trunc(Status.NumVal);
      Resp.StatusText := HTTPStatusText(Resp.Status);
    end;
    Status.Free;
  end;
  
  HeadersDict := ResDict.DictVal.GetValueClone('headers');
  if Assigned(HeadersDict) and (HeadersDict.DataType = dtDict) then
  begin
    Keys := HeadersDict.DictVal.GetKeys;
    for i := 0 to High(Keys) do
    begin
      HV := HeadersDict.DictVal.GetValueClone(Keys[i]);
      if Assigned(HV) and (HV.DataType = dtString) then
        Resp.SetHeader(Keys[i], HV.StrVal);
      HV.Free;
    end;
  end;
  if Assigned(HeadersDict) then HeadersDict.Free;
  
  Body := ResDict.DictVal.GetValueClone('body');
  if Assigned(Body) then
  begin
    if Body.DataType = dtString then
      Resp.Body := StrToRaw(Body.StrVal);
    Body.Free;
  end;
  
  if Resp.GetHeader('Content-Type') = '' then
    Resp.SetHeader('Content-Type', 'text/plain; charset=utf-8');
end;

function Worker_HandleClient(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  RealArgs: TValue;
  ClientSock: Integer;
  HandlerVal: TValue;
  MiniVM: TVM;
  TempChunk: TChunk;
  Buffer, Chunk, ReqBody, RespBody, ResponseBytes: RawByteString;
  ReqMethod, ReqPath, ReqQuery, ReqVersion, ParseErr: string;
  ReqNames, ReqValues, RespNames, RespValues: TStringList;
  CKNames, CKValues: TStringList;
  Parsed, R, i: Integer;
  ReqDict, HeadersDict, CookiesDict: TDictValue;
  ReqVal, ResVal: TValue;
  StatusVal, HeadersVal, BodyVal, HeaderItemVal: TValue;
  Keys: TStringArray;
  StatusCode: Integer;
  StatusText: string;
  CookieHeader: string;
  IsTLS: Boolean;
  TLSContextPtr: Pointer;
  TLSConn: TTLSConnection;
  ConnectionClose: Boolean;
  KeepAliveReqCount: Integer;
  IdleTimeoutReached: Boolean;

  // A.6 — Request logging
  HandlerStart: QWord;
  LogElapsed: QWord;
  LogStatus: Integer;
  LogBodyLen: Integer;
  LogSV, LogBV: TValue;
  LogLine: string;
  HandlerCallStart: QWord;
  ReqRidValue: string;
  
  procedure DBG(const Msg: string);
  begin
    {$IFDEF HTTP_DEBUG}
    WriteLn(ErrOutput, '[worker] ', Msg);
    Flush(ErrOutput);
    {$ENDIF}
  end;

  function DoRead(MaxBytes, TimeoutMs: Integer; out Data: RawByteString): Integer;
  begin
    if IsTLS and Assigned(TLSConn) then
      Result := TLSRecvTimeout(TLSConn, MaxBytes, TimeoutMs, Data)
    else
      Result := NetRecvTimeout(ClientSock, MaxBytes, TimeoutMs, Data);
  end;

  procedure DoSend(const Data: RawByteString);
  begin
    if IsTLS and Assigned(TLSConn) then
      TLSSend(TLSConn, Data)
    else
      NetSend(ClientSock, Data);
  end;

  procedure DoClose;
  begin
    if Assigned(TLSConn) then
    begin
      try TLSClose(TLSConn); except end;
      try TLSConn.Release; except end;
      TLSConn := nil;
    end;
    NetClose(ClientSock);
  end;

begin
  Result := TValue.CreateBool(True);

  if Args.Count < 1 then Exit;
  RealArgs := TValue(Args[0]);
  if not Assigned(RealArgs) or (RealArgs.DataType <> dtArray) then Exit;
  if RealArgs.ArrayVal.Count < 2 then Exit;

  ClientSock := Trunc(RealArgs.ArrayVal[0].NumVal);
  HandlerVal := RealArgs.ArrayVal[1];
  if (HandlerVal = nil) or (HandlerVal.DataType <> dtFunction) then Exit;
  if ClientSock < 0 then Exit;

  IsTLS := False;
  TLSContextPtr := nil;
  TLSConn := nil;

  if RealArgs.ArrayVal.Count >= 4 then
  begin
    IsTLS := RealArgs.ArrayVal[2].IsTrue;
    TLSContextPtr := RealArgs.ArrayVal[3].PtrVal;
  end;

  DBG('start, sock=' + IntToStr(ClientSock) + ' isTLS=' + BoolToStr(IsTLS, 'true', 'false'));

  // TLS handshake (satu kali per connection — ini yang dihemat oleh keep-alive)
  if IsTLS and (TLSContextPtr <> nil) then
  begin
    if not TLSAccept(TLSServerContext(TLSContextPtr), ClientSock, TLSConn) then
    begin
      DBG('TLSAccept FAILED');
      NetClose(ClientSock);
      Exit;
    end;
    DBG('TLS handshake OK');
  end;

  ReqNames := TStringList.Create;
  ReqValues := TStringList.Create;
  RespNames := TStringList.Create;
  RespValues := TStringList.Create;
  CKNames := TStringList.Create;
  CKValues := TStringList.Create;

  MiniVM := nil;
  TempChunk := nil;
  ReqVal := nil;
  ResVal := nil;
  KeepAliveReqCount := 0;
  ConnectionClose := False;

  try
    while (KeepAliveReqCount < KEEPALIVE_MAX_REQUESTS) and (not ConnectionClose) do
    begin
      // ─── Reset per-request state ───
      Buffer := '';
      ParseErr := '';
      Parsed := 0;
      ReqMethod := '';
      ReqPath := '';
      ReqQuery := '';
      ReqVersion := '';
      ReqBody := '';
      ReqNames.Clear;
      ReqValues.Clear;
      RespNames.Clear;
      RespValues.Clear;
      CKNames.Clear;
      CKValues.Clear;
      if Assigned(ReqVal) then begin ReqVal.Free; ReqVal := nil; end;
      if Assigned(ResVal) then begin ResVal.Free; ResVal := nil; end;
      if Assigned(TempChunk) then begin TempChunk.Free; TempChunk := nil; end;
      if Assigned(MiniVM) then begin MiniVM.Free; MiniVM := nil; end;

      try
        // ─── Read request (dengan idle timeout) ───
        DBG('reading request #' + IntToStr(KeepAliveReqCount + 1));
        IdleTimeoutReached := False;
        while Length(Buffer) < HTTP_MAX_HEADER_BYTES do
        begin
          R := DoRead(4096, KEEPALIVE_TIMEOUT_MS, Chunk);
          if R <= 0 then
          begin
            IdleTimeoutReached := True;
            Break;
          end;
          Buffer := Buffer + Chunk;
          if ParseRawHTTPRequest(Buffer,
              ReqMethod, ReqPath, ReqQuery, ReqVersion,
              ReqNames, ReqValues, ReqBody,
              Parsed, ParseErr) then
            Break;
          if ParseErr <> 'incomplete headers' then
            Break;
        end;

        if IdleTimeoutReached then
        begin
          DBG('idle timeout — closing connection');
          Break;
        end;

        if Parsed <= 0 then
        begin
          DBG('bad request, sending 400 and closing');
          RespNames.Add('Content-Type');
          RespValues.Add('text/plain');
          RespNames.Add('Connection');
          RespValues.Add('close');
          RespBody := RawByteString('400 Bad Request: ' + ParseErr);
          ResponseBytes := BuildHTTPResponseRaw(400, 'Bad Request',
            RespNames, RespValues, RespBody);
          DoSend(ResponseBytes);
          Break;
        end;

        DBG('parsed: ' + ReqMethod + ' ' + ReqPath);

        // ─── Tentukan apakah connection harus ditutup ───
        ConnectionClose := False;
        if ReqVersion = 'HTTP/1.0' then
        begin
          ConnectionClose := True;
          for i := 0 to ReqNames.Count - 1 do
            if SameText(ReqNames[i], 'Connection') and
               SameText(ReqValues[i], 'keep-alive') then
            begin
              ConnectionClose := False;
              Break;
            end;
        end
        else
        begin
          for i := 0 to ReqNames.Count - 1 do
            if SameText(ReqNames[i], 'Connection') and
               SameText(ReqValues[i], 'close') then
            begin
              ConnectionClose := True;
              Break;
            end;
        end;

        // ─── Build request dict ───
        ReqDict := TDictValue.Create;
        HeadersDict := TDictValue.Create;
        CookiesDict := TDictValue.Create;

        try
          for i := 0 to ReqNames.Count - 1 do
            HeadersDict.SetValue(ReqNames[i], TValue.CreateStr(ReqValues[i]));

          CookieHeader := '';
          for i := 0 to ReqNames.Count - 1 do
            if SameText(ReqNames[i], 'Cookie') then
            begin
              CookieHeader := ReqValues[i];
              Break;
            end;

          if CookieHeader <> '' then
          begin
            ParseCookieHeader(CookieHeader, CKNames, CKValues);
            for i := 0 to CKNames.Count - 1 do
              CookiesDict.SetValue(CKNames[i], TValue.CreateStr(CKValues[i]));
          end;

          ReqDict.SetValue('method', TValue.CreateStr(ReqMethod));
          ReqDict.SetValue('path', TValue.CreateStr(ReqPath));
          ReqDict.SetValue('query', TValue.CreateStr(ReqQuery));
          ReqDict.SetValue('version', TValue.CreateStr(ReqVersion));
          ReqDict.SetValue('headers', TValue.CreateDict(HeadersDict));
          ReqDict.SetValue('cookies', TValue.CreateDict(CookiesDict));
          ReqDict.SetValue('body', TValue.CreateStr(RawToStr(ReqBody)));

          ReqVal := TValue.CreateDict(ReqDict);
        except
          ReqDict.Free;
          raise;
        end;

        // A.8 — Request ID tracking
        if GHTTPTraceEnabled then
        begin
          ReqRidValue := '';
          for i := 0 to ReqNames.Count - 1 do
            if SameText(ReqNames[i], GHTTPTraceHeader) then
            begin
              ReqRidValue := ReqValues[i];
              Break;
            end;
          if ReqRidValue = '' then
            ReqRidValue := GenerateRequestID;
          ReqDict.SetValue('requestId', TValue.CreateStr(ReqRidValue));
        end;

        // ─── Panggil handler ───
        HandlerStart := GetTickCount64;
        
        if Assigned(HandlerVal.ClosureEnv) then
          MiniVM := TVM.Create(HandlerVal.ClosureEnv)
        else if Assigned(CallEnv) then
          MiniVM := TVM.Create(CallEnv.GetGlobal)
        else
          MiniVM := TVM.Create(nil);
          
        TempChunk := TChunk.Create;
        TempChunk.AddInstruction(opcConstant,
          TempChunk.AddConstant(HandlerVal.Clone));
        TempChunk.AddInstruction(opcConstant,
          TempChunk.AddConstant(ReqVal.Clone));
        TempChunk.AddInstruction(opcCall, 1);
        TempChunk.AddInstruction(opcReturn);

        DBG('calling handler');
        ResVal := MiniVM.Run(TempChunk);
        DBG('handler returned');

        // A.8 — Echo request ID in response header
        if GHTTPTraceEnabled and GHTTPTraceResponseHeader and
           (ReqRidValue <> '') then
        begin
          RespNames.Add(GHTTPTraceHeader);
          RespValues.Add(ReqRidValue);
        end;

        // A.6 — Request logging
        if GHTTPLogEnabled and (GHTTPLogExclude.IndexOf(ReqPath) < 0) then
        begin
          LogElapsed := GetTickCount64 - HandlerStart;
          LogStatus := 200;
          LogBodyLen := 0;
          if Assigned(ResVal) and (ResVal.DataType = dtDict) then
          begin
            LogSV := ResVal.DictVal.GetValueClone('status');
            if Assigned(LogSV) then
            begin
              if LogSV.DataType = dtNumeric then LogStatus := Trunc(LogSV.NumVal);
              LogSV.Free;
              LogSV := nil;
            end;
            LogBV := ResVal.DictVal.GetValueClone('body');
            if Assigned(LogBV) then
            begin
              if LogBV.DataType = dtString then LogBodyLen := Length(LogBV.StrVal);
              LogBV.Free;
              LogBV := nil;
            end;
          end;
          
          LogLine := '';
          if GHTTPTraceEnabled and (ReqRidValue <> '') then
            LogLine := '[' + ReqRidValue + '] ';
          LogLine := LogLine + ReqMethod + ' ' + ReqPath + ' ' +
                     IntToStr(LogStatus) + ' ' +
                     IntToStr(LogElapsed) + 'ms ' +
                     IntToStr(LogBodyLen) + 'b';          
          
          if (GHTTPLogSlowMs > 0) and (LogElapsed >= QWord(GHTTPLogSlowMs)) then
            LogWriteInternal(2, LogLine + ' (SLOW)')
          else
            LogWriteInternal(1, LogLine);
        end;
        
        // ─── Build response ───
        StatusCode := 200;
        RespBody := '';

        if Assigned(ResVal) and (ResVal.DataType = dtDict) then
        begin
          StatusVal := ResVal.DictVal.GetValueClone('status');
          if Assigned(StatusVal) then
          begin
            if StatusVal.DataType = dtNumeric then
              StatusCode := Trunc(StatusVal.NumVal);
            StatusVal.Free;
          end;

          HeadersVal := ResVal.DictVal.GetValueClone('headers');
          if Assigned(HeadersVal) and (HeadersVal.DataType = dtDict) then
          begin
            Keys := HeadersVal.DictVal.GetKeys;
            for i := 0 to High(Keys) do
            begin
              HeaderItemVal := HeadersVal.DictVal.GetValueClone(Keys[i]);
              if Assigned(HeaderItemVal) and (HeaderItemVal.DataType = dtString) then
              begin
                RespNames.Add(Keys[i]);
                RespValues.Add(HeaderItemVal.StrVal);
              end;
              HeaderItemVal.Free;
            end;
          end;
          if Assigned(HeadersVal) then HeadersVal.Free;

          BodyVal := ResVal.DictVal.GetValueClone('body');
          if Assigned(BodyVal) and (BodyVal.DataType = dtString) then
            RespBody := StrToRaw(BodyVal.StrVal);
          if Assigned(BodyVal) then BodyVal.Free;
        end;

        if StatusCode = 0 then StatusCode := 200;
        StatusText := HTTPStatusText(StatusCode);

        if RespNames.IndexOf('Content-Type') < 0 then
        begin
          RespNames.Add('Content-Type');
          RespValues.Add('text/plain; charset=utf-8');
        end;

        // ─── Keep-Alive header (kalau tidak close) ───
        if ConnectionClose then
        begin
          RespNames.Add('Connection');
          RespValues.Add('close');
        end
        else
        begin
          RespNames.Add('Connection');
          RespValues.Add('keep-alive');
          RespNames.Add('Keep-Alive');
          RespValues.Add('timeout=' + IntToStr(KEEPALIVE_TIMEOUT_MS div 1000) +
                         ', max=' + IntToStr(KEEPALIVE_MAX_REQUESTS));
        end;

        ResponseBytes := BuildHTTPResponseRaw(StatusCode, StatusText,
          RespNames, RespValues, RespBody);
        DBG('sending response len=' + IntToStr(Length(ResponseBytes)) +
            ' keepAlive=' + BoolToStr(not ConnectionClose, 'true', 'false'));
        DoSend(ResponseBytes);

        Inc(KeepAliveReqCount);

        if ConnectionClose then
        begin
          DBG('client requested close');
          Break;
        end;

      except
        on Ex: Exception do
        begin
          DBG('EXCEPTION: ' + Ex.ClassName + ': ' + Ex.Message);
          try
            RespNames.Clear;
            RespValues.Clear;
            RespNames.Add('Content-Type');
            RespValues.Add('text/plain');
            RespNames.Add('Connection');
            RespValues.Add('close');
            RespBody := RawByteString('500 Internal Server Error: ' + Ex.Message);
            ResponseBytes := BuildHTTPResponseRaw(500, 'Internal Server Error',
              RespNames, RespValues, RespBody);
            DoSend(ResponseBytes);
          except
            // fail-silent
          end;
          Break;
        end;
      end;
    end;
  finally
    DBG('closing (served ' + IntToStr(KeepAliveReqCount) + ' requests)');
    if Assigned(ResVal) then ResVal.Free;
    if Assigned(ReqVal) then ReqVal.Free;
    if Assigned(TempChunk) then TempChunk.Free;
    if Assigned(MiniVM) then MiniVM.Free;

    ReqNames.Free;
    ReqValues.Free;
    RespNames.Free;
    RespValues.Free;
    CKNames.Free;
    CKValues.Free;

    DoClose;
  end;
end;

function Native_HTTP_Listen(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Handle, Sock, ClientSock: Integer;
  LocalHandler: TValue;
  E: PHTTPServerEntry;
  Buffer, Chunk: RawByteString;
  ReqMethod, ReqPath, ReqQuery, ReqVersion: string;
  ReqBody: RawByteString;
  ReqNames, ReqValues: TStringList;
  RespStatus: Integer;
  RespStatusText: string;
  RespBody: RawByteString;
  RespNames, RespValues: TStringList;
  Parsed: Integer;
  ParseErr: string;
  RawRes, ReqVal: TValue;
  ResponseBytes: RawByteString;
  MiniVM: TVM;
  TempChunk: TChunk;
  RequestCount, ConnRequestCount: Int64;
  R, i: Integer;
  Keys: TStringArray;
  StatusVal, HeadersVal, BodyVal, HeaderItemVal: TValue;
  FileVal, CookiesVal, CKItemVal: TValue;
  CKKeys: TStringArray;
  CKNames, CKValues: TStringList;
  CookieHeader: string;
  SafePath: string;
  FileStream: TFileStream;
  CookiesDict, ReqDict, HeadersDict: TDictValue;
  ConnectionClose: Boolean;
  ConnIdleTimeout: Boolean;
  HandlerStart, RequestTick: QWord;
  Elapsed: QWord;
  RidValue: string;
  LogLine: string;
  j: Integer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'http.listen(serverHandle) butuh 1 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  Handle := Trunc(TValue(Args[0]).NumVal);
  E := GetHTTPServer(Handle);
  if E = nil then
  begin
    errMSG.callerror(144, 'http.listen: server handle tidak valid',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  Sock := E^.ListenSock;
  LocalHandler := E^.Handler;
  RequestCount := 0;

  ReqNames := TStringList.Create;
  ReqValues := TStringList.Create;
  RespNames := TStringList.Create;
  RespValues := TStringList.Create;
  CKNames := TStringList.Create;
  CKValues := TStringList.Create;

  try
    while True do
    begin
      if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 1 then Break;
      if E^.StopRequested then Break;

      if not NetAcceptTimeout(Sock, 1000, ClientSock) then
        Continue;

      ConnRequestCount := 0;
      ConnectionClose := False;

      // ─── A.1c: keep-alive loop ───
      while (not ConnectionClose) and
            (ConnRequestCount < KEEPALIVE_MAX_REQUESTS) and
            (InterlockedCompareExchange(IsShuttingDown, 0, 0) = 0) do
      begin
        Buffer := '';
        ParseErr := '';
        Parsed := 0;
        ReqMethod := '';
        ReqPath := '';
        ReqQuery := '';
        ReqVersion := '';
        ReqBody := '';
        ReqNames.Clear;
        ReqValues.Clear;
        RespStatus := 200;
        RespStatusText := 'OK';
        RespBody := '';
        RespNames.Clear;
        RespValues.Clear;
        CKNames.Clear;
        CKValues.Clear;
        RidValue := '';

        ConnIdleTimeout := False;
        RequestTick := GetTickCount64;

        // ─── Read request with idle timeout ───
        while Length(Buffer) < HTTP_MAX_HEADER_BYTES do
        begin
          R := NetRecvTimeout(ClientSock, 4096,
                              KEEPALIVE_TIMEOUT_MS, Chunk);
          if R = 0 then
          begin
            ConnIdleTimeout := True;
            Break;
          end;
          if R < 0 then
          begin
            ConnIdleTimeout := True;
            Break;
          end;
          Buffer := Buffer + Chunk;
          if ParseRawHTTPRequest(Buffer,
              ReqMethod, ReqPath, ReqQuery, ReqVersion,
              ReqNames, ReqValues, ReqBody,
              Parsed, ParseErr) then
            Break;
          if ParseErr <> 'incomplete headers' then
            Break;
        end;

        if ConnIdleTimeout then
          Break;   // back to accept

        if Parsed <= 0 then
        begin
          RespStatus := 400;
          RespStatusText := 'Bad Request';
          RespNames.Add('Content-Type');
          RespValues.Add('text/plain');
          RespBody := RawByteString('400 Bad Request: ' + ParseErr);
          ConnectionClose := True;
        end
        else
        begin
          // ─── Determine keep-alive vs close ───
          ConnectionClose := False;
          if ReqVersion = 'HTTP/1.0' then
          begin
            ConnectionClose := True;
            for i := 0 to ReqNames.Count - 1 do
              if SameText(ReqNames[i], 'Connection') and
                 SameText(ReqValues[i], 'keep-alive') then
              begin
                ConnectionClose := False;
                Break;
              end;
          end
          else
          begin
            for i := 0 to ReqNames.Count - 1 do
              if SameText(ReqNames[i], 'Connection') and
                 SameText(ReqValues[i], 'close') then
              begin
                ConnectionClose := True;
                Break;
              end;
          end;

          // ─── Build req dict ───
          ReqDict := TDictValue.Create;
          HeadersDict := TDictValue.Create;
          CookiesDict := TDictValue.Create;
          try
            for i := 0 to ReqNames.Count - 1 do
              HeadersDict.SetValue(ReqNames[i], TValue.CreateStr(ReqValues[i]));

            CookieHeader := '';
            for i := 0 to ReqNames.Count - 1 do
              if SameText(ReqNames[i], 'Cookie') then
              begin
                CookieHeader := ReqValues[i];
                Break;
              end;

            if CookieHeader <> '' then
            begin
              ParseCookieHeader(CookieHeader, CKNames, CKValues);
              for i := 0 to CKNames.Count - 1 do
                CookiesDict.SetValue(CKNames[i], TValue.CreateStr(CKValues[i]));
            end;

            // A.8 — Request ID
            if GHTTPTraceEnabled then
            begin
              RidValue := '';
              for i := 0 to ReqNames.Count - 1 do
                if SameText(ReqNames[i], GHTTPTraceHeader) then
                begin
                  RidValue := ReqValues[i];
                  Break;
                end;
              if RidValue = '' then
                RidValue := GenerateRequestID;
              ReqDict.SetValue('requestId', TValue.CreateStr(RidValue));
            end;

            ReqDict.SetValue('method', TValue.CreateStr(ReqMethod));
            ReqDict.SetValue('path', TValue.CreateStr(ReqPath));
            ReqDict.SetValue('query', TValue.CreateStr(ReqQuery));
            ReqDict.SetValue('version', TValue.CreateStr(ReqVersion));
            ReqDict.SetValue('headers', TValue.CreateDict(HeadersDict));
            ReqDict.SetValue('cookies', TValue.CreateDict(CookiesDict));
            ReqDict.SetValue('body', TValue.CreateStr(RawToStr(ReqBody)));
            ReqVal := TValue.CreateDict(ReqDict);
          except
            ReqDict.Free;
            raise;
          end;

          // ─── Invoke handler ───
          HandlerStart := GetTickCount64;
          RawRes := nil;
          MiniVM := TVM.Create(CallEnv);
          TempChunk := TChunk.Create;
          try
            TempChunk.AddInstruction(opcConstant,
              TempChunk.AddConstant(LocalHandler.Clone));
            TempChunk.AddInstruction(opcConstant,
              TempChunk.AddConstant(ReqVal.Clone));
            TempChunk.AddInstruction(opcCall, 1);
            TempChunk.AddInstruction(opcReturn);
            RawRes := MiniVM.Run(TempChunk);
          finally
            TempChunk.Free;
            MiniVM.Free;
            ReqVal.Free;
          end;

          Elapsed := GetTickCount64 - HandlerStart;

          // ─── Apply response ───
          if Assigned(RawRes) and (RawRes.DataType = dtDict) then
          begin
            StatusVal := RawRes.DictVal.GetValueClone('status');
            if Assigned(StatusVal) then
            begin
              if StatusVal.DataType = dtNumeric then
                RespStatus := Trunc(StatusVal.NumVal);
              StatusVal.Free;
            end;

            HeadersVal := RawRes.DictVal.GetValueClone('headers');
            if Assigned(HeadersVal) and (HeadersVal.DataType = dtDict) then
            begin
              Keys := HeadersVal.DictVal.GetKeys;
              for i := 0 to High(Keys) do
              begin
                HeaderItemVal := HeadersVal.DictVal.GetValueClone(Keys[i]);
                if Assigned(HeaderItemVal) and (HeaderItemVal.DataType = dtString) then
                begin
                  RespNames.Add(Keys[i]);
                  RespValues.Add(HeaderItemVal.StrVal);
                end;
                HeaderItemVal.Free;
              end;
            end;
            if Assigned(HeadersVal) then HeadersVal.Free;

            BodyVal := RawRes.DictVal.GetValueClone('body');
            if Assigned(BodyVal) then
            begin
              if BodyVal.DataType = dtString then
                RespBody := StrToRaw(BodyVal.StrVal);
              BodyVal.Free;
            end;

            FileVal := RawRes.DictVal.GetValueClone('file');
            if Assigned(FileVal) and (FileVal.DataType = dtString) then
            begin
              try
                SafePath := GetSafeSandboxedPath(FileVal.StrVal);
              except
                SafePath := '';
              end;

              if (SafePath <> '') and FileExists(SafePath) then
              begin
                try
                  FileStream := TFileStream.Create(SafePath,
                    fmOpenRead or fmShareDenyNone);
                  try
                    SetLength(RespBody, FileStream.Size);
                    if FileStream.Size > 0 then
                      FileStream.ReadBuffer(RespBody[1], FileStream.Size);
                  finally
                    FileStream.Free;
                  end;
                  if RespNames.IndexOf('Content-Type') < 0 then
                  begin
                    RespNames.Add('Content-Type');
                    RespValues.Add(MimeTypeFromExt(SafePath));
                  end;
                except
                  RespStatus := 500;
                  RespStatusText := 'Internal Server Error';
                  RespBody := RawByteString('500 File read error');
                end;
              end
              else
              begin
                RespStatus := 404;
                RespStatusText := 'Not Found';
                RespBody := RawByteString('404 File not found');
              end;
            end;
            if Assigned(FileVal) then FileVal.Free;

            CookiesVal := RawRes.DictVal.GetValueClone('cookies');
            if Assigned(CookiesVal) and (CookiesVal.DataType = dtDict) then
            begin
              CKKeys := CookiesVal.DictVal.GetKeys;
              for i := 0 to High(CKKeys) do
              begin
                CKItemVal := CookiesVal.DictVal.GetValueClone(CKKeys[i]);
                if Assigned(CKItemVal) and (CKItemVal.DataType = dtString) then
                begin
                  RespNames.Add('Set-Cookie');
                  RespValues.Add(CKKeys[i] + '=' + CKItemVal.StrVal + '; Path=/');
                end;
                if Assigned(CKItemVal) then CKItemVal.Free;
              end;
            end;
            if Assigned(CookiesVal) then CookiesVal.Free;
          end;
          if Assigned(RawRes) then RawRes.Free;

          // A.8 — Echo request ID
          if GHTTPTraceEnabled and GHTTPTraceResponseHeader and
             (RidValue <> '') then
          begin
            RespNames.Add(GHTTPTraceHeader);
            RespValues.Add(RidValue);
          end;

          // A.6 — Request logging
          if GHTTPLogEnabled and (GHTTPLogExclude.IndexOf(ReqPath) < 0) then
          begin
            LogLine := '';
            if GHTTPTraceEnabled and (RidValue <> '') then
              LogLine := '[' + RidValue + '] ';
            LogLine := LogLine + ReqMethod + ' ' + ReqPath + ' ' +
                       IntToStr(RespStatus) + ' ' +
                       IntToStr(Elapsed) + 'ms ' +
                       IntToStr(Length(RespBody)) + 'b';
            if (GHTTPLogSlowMs > 0) and (Elapsed >= QWord(GHTTPLogSlowMs)) then
              LogWriteInternal(2, LogLine + ' (SLOW)')
            else
              LogWriteInternal(1, LogLine);
          end;
        end;

        // ─── A.1c: Connection header ───
        // Strip any existing Connection header from handler
        j := 0;
        while j < RespNames.Count do
        begin
          if SameText(RespNames[j], 'Connection') or
             SameText(RespNames[j], 'Keep-Alive') then
          begin
            RespNames.Delete(j);
            RespValues.Delete(j);
          end
          else
            Inc(j);
        end;

        if ConnectionClose then
        begin
          RespNames.Add('Connection');
          RespValues.Add('close');
        end
        else
        begin
          RespNames.Add('Connection');
          RespValues.Add('keep-alive');
          RespNames.Add('Keep-Alive');
          RespValues.Add('timeout=' +
            IntToStr(KEEPALIVE_TIMEOUT_MS div 1000) +
            ', max=' + IntToStr(KEEPALIVE_MAX_REQUESTS));
        end;

        ResponseBytes := BuildHTTPResponseRaw(RespStatus, RespStatusText,
          RespNames, RespValues, RespBody);
        NetSend(ClientSock, ResponseBytes);

        Inc(ConnRequestCount);
        Inc(RequestCount);
      end;

      NetClose(ClientSock);
    end;
  finally
    ReqNames.Free;
    ReqValues.Free;
    RespNames.Free;
    RespValues.Free;
    CKNames.Free;
    CKValues.Free;
  end;

  Result := TValue.CreateNum(RequestCount);
end;

function Native_HTTP_ListenAsync(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Handle, Sock, ClientSock: Integer;
  LocalHandler: TValue;
  E: PHTTPServerEntry;
  Ctx: TEngineContext;
  FuncVal, ArgsArr: TValue;
  ClientList: TValueList;
  RequestCount: Int64;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138,
      'http.listenAsync(serverHandle) butuh 1 argumen numeric',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  Handle := Trunc(TValue(Args[0]).NumVal);
  E := GetHTTPServer(Handle);
  if E = nil then
  begin
    errMSG.callerror(144,
      'http.listenAsync: server handle tidak valid',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  Sock := E^.ListenSock;
  LocalHandler := E^.Handler;
  RequestCount := 0;

  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) or not Assigned(Ctx.WorkerPool) then
  begin
    errMSG.callerror(144,
      'http.listenAsync: worker pool tidak tersedia',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  while True do
  begin
    if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 1 then Break;
    if E^.StopRequested then Break;

    // Accept dengan timeout 500ms agar responsif ke stop flag
    if not NetAcceptTimeout(Sock, 500, ClientSock) then
      Continue;

    // Enqueue ke worker pool
    ClientList := TValueList.Create(True);
    try
      ClientList.Add(TValue.CreateNum(ClientSock));
      ClientList.Add(LocalHandler.Clone);
      ClientList.Add(TValue.CreateBool(E^.IsTLS));
      if E^.IsTLS and Assigned(E^.TLSContext) then
        ClientList.Add(TValue.CreatePtr(E^.TLSContext))
      else
        ClientList.Add(TValue.CreatePtr(nil));
      ArgsArr := TValue.CreateArray(ClientList);    
    except
      ClientList.Free;
      raise;
    end;

    FuncVal := TValue.CreateNative(@Worker_HandleClient);
    try
      try
        Ctx.WorkerPool.EnqueueTask(FuncVal, ArgsArr, nil);
        Inc(RequestCount);
      except
        // Kalau enqueue gagal (mis. pool shutdown), tutup socket
        NetClose(ClientSock);
        raise;
      end;
    finally
      FuncVal.Free;
      ArgsArr.Free;
    end;
  end;

  Result := TValue.CreateNum(RequestCount);
end;

// Native: http.closeServer(handle) → bool
function Native_HTTP_CloseServer(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var Handle: Integer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'http.closeServer(handle) butuh 1 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  Handle := Trunc(TValue(Args[0]).NumVal);
  FreeHTTPServer(Handle);
  Result := TValue.CreateBool(True);
end;

// http.stop(handle) — graceful shutdown: selesaikan request aktif,
// lalu keluar dari listen loop
function Native_HTTP_Stop(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Handle: Integer;
  E: PHTTPServerEntry;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'http.stop(handle) butuh 1 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;

  Handle := Trunc(TValue(Args[0]).NumVal);
  E := GetHTTPServer(Handle);
  if E = nil then
    Exit(TValue.CreateBool(False));

  // ✅ S-4: hanya set flag. Listen loop akan cek dan exit
  // setelah request aktif selesai.
  E^.StopRequested := True;
  Result := TValue.CreateBool(True);
end;

