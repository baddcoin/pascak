function Native_AssertThrows(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Func: TValue;
  Msg: string;
  Ctx: TTestContext;
  Threw: Boolean;
  MiniVM: TVM;
  TempChunk: TChunk;
  Res: TValue;
begin
  if (Args.Count < 1) or (Args.Count > 2) then
    raise EScriptRuntimeError.Create('assertThrows(func, [msg]) butuh 1-2 argumen');
  
  Ctx := EnsureTestContext;
  Inc(Ctx.TotalTests);
  
  Func := TValue(Args[0]);
  if Func.DataType <> dtFunction then
    raise EScriptRuntimeError.Create('assertThrows: argumen pertama harus fungsi');
  
  if Args.Count = 2 then
    Msg := TValueToString(TValue(Args[1]), False)
  else
    Msg := '';
  
  Threw := False;
  Res := nil;
  
  MiniVM := TVM.Create(CallEnv.GetGlobal);
  TempChunk := TChunk.Create;
  try
    TempChunk.AddInstruction(opcConstant, TempChunk.AddConstant(Func.Clone));
    TempChunk.AddInstruction(opcCall, 0);
    TempChunk.AddInstruction(opcHalt);
    
    try
      Res := MiniVM.Run(TempChunk);
    except
      on E: Exception do
      begin
        Threw := True;
      end;
    end;
  finally
    if Assigned(Res) then Res.Free;
    TempChunk.Free;
    MiniVM.Free;
  end;
  
  if Threw then
  begin
    Inc(Ctx.PassedTests);
    FormatAssertionPass('assertThrows');
  end
  else
  begin
    Inc(Ctx.FailedTests);
    if Msg = '' then Msg := 'assertThrows: fungsi tidak throw exception';
    Ctx.LastFailure := Msg;
    FormatAssertionError('assertThrows', Msg);
  end;
  
  Result := TValue.CreateBool(Threw);
end;

function Native_TestBegin(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TTestContext;
  SuiteName: string;
begin
  Ctx := EnsureTestContext;
  
  if (Args.Count >= 1) and (TValue(Args[0]).DataType = dtString) then
    SuiteName := TValue(Args[0]).StrVal
  else
    SuiteName := '<unnamed>';
  
  Ctx.CurrentSuite := SuiteName;
  IOLock.Acquire;
  try
    Writeln;
    Writeln('>>> Test Suite: ', SuiteName);
  finally
    IOLock.Release;
  end;
  
  Result := TValue.CreateNull;
end;

function Native_TestEnd(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TTestContext;
  Summary: string;
begin
  Ctx := EnsureTestContext;
  
  Summary := Format('<<< Suite [%s] — %d/%d passed, %d failed',
    [Ctx.CurrentSuite, Ctx.PassedTests, Ctx.TotalTests, Ctx.FailedTests]);
  
  IOLock.Acquire;
  try
    Writeln(Summary);
  finally
    IOLock.Release;
  end;
  
  Result := TValue.CreateNum(Ctx.FailedTests);
end;

function Native_TestSummary(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TTestContext;
begin
  Ctx := EnsureTestContext;
  Result := TValue.CreateNum(Ctx.FailedTests);
end;

// Jembatan untuk mengirim pesan DARI Worker KE Main Thread
function WorkerNative_PostToMain(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  MsgJSON: string;
  CurrentWorker: TWorkerThread;
  JData: TJSONData; // <-- TAMBAHAN
begin
  if Args.Count <> 1 then raise EScriptRuntimeError.Create('postToMain() butuh 1 argumen string/json.');
  
  if TValue(Args[0]).DataType = dtString then
    MsgJSON := TValue(Args[0]).StrVal
  else
  begin
    JData := ConvertTValueToJSON(TValue(Args[0]));
    try
      // PERBAIKAN LOGIKA (RAWAN ACCESS VIOLATION): JData bisa bernilai nil 
      // jika konversi tipe tidak didukung. Harus divalidasi dengan Assigned.
      if Assigned(JData) then
        MsgJSON := JData.AsJSON
      else
        MsgJSON := '{}'; // Fallback JSON kosong jika gagal
    finally
      // PERBAIKAN LOGIKA: Aman dilepas hanya jika JData berhasil diinstansiasi
      if Assigned(JData) then JData.Free; 
    end;
  end;

  CurrentWorker := TWorkerThread(TThread.CurrentThread);
  CurrentWorker.FOutbox.PushMessage(MsgJSON);
  
  Result := TValue.CreateBool(True);
end;

// Jembatan untuk mengambil pesan dari Inbox Worker (Non-blocking)
function WorkerNative_GetMessage(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  MsgJSON: string;
  CurrentWorker: TWorkerThread;
  JData: TJSONData;
begin
  CurrentWorker := TWorkerThread(TThread.CurrentThread);
  
  if CurrentWorker.FInbox.PopMessage(MsgJSON) then
  begin
    JData := nil;
    try
      JData := GetJSON(MsgJSON); // Hanya tangkap error parsing JSON Text
    except
      JData := nil;
    end;
    
    if Assigned(JData) then
    begin
      // Exception akibat over-limit memori TValue sekarang bebas menembus keluar 
      try 
        Result := ConvertJSONToTValue(JData, 0); 
      finally 
        JData.Free; 
      end;
    end
    else
      Result := TValue.CreateStr(MsgJSON); // Fallback ke teks murni
  end
  else
    Result := TValue.CreateNull;
end;

function Native_WorkerCreate(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  ScriptPath, ScriptText: string;
  Worker: TWorkerThread;
  Ctx: TEngineContext;   // ✨ FIX: deklarasi Ctx
begin
  if Args.Count <> 1 then 
    raise EScriptRuntimeError.Create('Worker(scriptPath) butuh 1 argumen path string.');
  
  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) then
    raise EScriptRuntimeError.Create('Engine context tidak tersedia');
  
  ScriptPath := GetSafeSandboxedPath(TValue(Args[0]).StrVal);
  ScriptText := LoadScriptFromFile(ScriptPath);
  
  if ScriptText = '' then 
    raise EScriptRuntimeError.Create('Gagal memuat script untuk Worker: ' + ScriptPath);

  // ✨ PHASE 7: Pass context ke worker
  Worker := TWorkerThread.Create(ScriptText, Ctx);
  try
    Result := TValue.CreateStr(Worker.WorkerID);
    Worker.Start; 
  except
    Worker.Free;
    raise;
  end;
end;

function Native_WorkerPostMessage(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  WorkerID, Payload: string;
  Worker: TWorkerThread;
  JData: TJSONData;
  Idx: Integer;
  Ctx: TEngineContext;   // ✨ FIX: deklarasi Ctx
begin
  if Args.Count <> 2 then 
    raise EScriptRuntimeError.Create('workerPost(workerID, payload) butuh 2 argumen.');
  
  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) then
    raise EScriptRuntimeError.Create('Engine context tidak tersedia');
  
  WorkerID := TValue(Args[0]).StrVal;
  
  // Build payload JSON
  if TValue(Args[1]).DataType = dtString then
  begin
    Payload := TValue(Args[1]).StrVal;
  end else
  begin
    JData := ConvertTValueToJSON(TValue(Args[1]));
    try
      if Assigned(JData) then
        Payload := JData.AsJSON
      else
        Payload := '{}';
    finally
      if Assigned(JData) then JData.Free;
    end;
  end;

  WorkerRegistryLock.Acquire;
  try
    if Assigned(Ctx.Workers) then   // ✨ PHASE 7
    begin
      Idx := Ctx.Workers.IndexOf(WorkerID);
      if Idx <> -1 then
      begin
        Worker := Ctx.Workers.Data[Idx]; 
        Worker.PostToWorker(Payload);
        Exit(TValue.CreateBool(True));
      end;
    end;
    Result := TValue.CreateBool(False);
  finally
    WorkerRegistryLock.Release;
  end;
end;

function Native_WorkerGetMessage(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  WorkerID, MsgStr: string;
  Worker: TWorkerThread;
  JData: TJSONData;
  HasMessage: Boolean;
  Idx: Integer;
  Ctx: TEngineContext;   // ✨ FIX: deklarasi Ctx
begin
  if Args.Count <> 1 then 
    raise EScriptRuntimeError.Create('workerGet(workerID) butuh 1 argumen.');
  
  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) then
    raise EScriptRuntimeError.Create('Engine context tidak tersedia');
  
  WorkerID := TValue(Args[0]).StrVal;
  HasMessage := False;
  Worker := nil;
  
  WorkerRegistryLock.Acquire;
  try
    if Assigned(Ctx.Workers) then
    begin
      Idx := Ctx.Workers.IndexOf(WorkerID);
      if Idx <> -1 then
      begin
        Worker := Ctx.Workers.Data[Idx];
        HasMessage := Worker.ReceiveFromWorker(MsgStr);
      end;
    end;
  finally
    WorkerRegistryLock.Release;
  end;

  if HasMessage then
  begin
    JData := nil;
    try
      try
        JData := GetJSON(MsgStr);
      except
        JData := nil;
      end;
      
      if Assigned(JData) then
      begin
        try 
          Result := ConvertJSONToTValue(JData, 0); 
        finally 
          JData.Free; 
        end;
      end
      else
        Result := TValue.CreateStr(MsgStr);
    except
      // Fallback jika ConvertJSONToTValue throw
      Result := TValue.CreateStr(MsgStr);
    end;
  end
  else
    Result := TValue.CreateNull;
end;

