function XOREncryptString(const S: string; KeyOffset: Integer): string;
var
  i: Integer;
  B: Byte;
begin
  SetLength(Result, Length(S));
  for i := 1 to Length(S) do
  begin
    B := Ord(S[i]) xor OBFS_KEY[(i + KeyOffset) mod 16];
    Result[i] := Char(B);
  end;
end;

// Decrypt = encrypt (XOR is symmetric)
function XORDecryptString(const S: string; KeyOffset: Integer): string; inline;
begin
  Result := XOREncryptString(S, KeyOffset);
end;

//optimasi while, for, repeat
procedure OptimizeLoopBytecode(Chunk: TChunk);
const
  MAX_JUMP_THREAD_ITER = 1024;   // Batas absolut iterasi
var
  i, Idx, IterCount: Integer;
  AbsJump, TargetAbsJump: Integer;
  OpCode: TVMOpCode;
  VisitedJumps: array of Integer;
begin
  if (Chunk = nil) or (Chunk.CodeCount = 0) then Exit;

  i := 0;
  while i < Chunk.CodeCount do
  begin
    OpCode := Chunk.Code[i].OpCode;
    
    if OpCode in [opcJump, opcJumpIfFalse] then
    begin
      AbsJump := i + 1 + Chunk.Code[i].Operand;
      
      if (AbsJump >= 0) and (AbsJump < Chunk.CodeCount) then
      begin
        // ✅ Reset visited set setiap instruksi jump
        SetLength(VisitedJumps, 0);
        IterCount := 0;
        
        while (AbsJump < Chunk.CodeCount) and 
              (Chunk.Code[AbsJump].OpCode = opcJump) and 
              (IterCount < MAX_JUMP_THREAD_ITER) do
        begin
          // Cek apakah AbsJump sudah dikunjungi (cycle)
          Idx := 0;
          while (Idx < Length(VisitedJumps)) and (VisitedJumps[Idx] <> AbsJump) do
            Inc(Idx);
            
          if Idx < Length(VisitedJumps) then
            Break;   // Cycle terdeteksi
          
          // Tandai sudah dikunjungi
          SetLength(VisitedJumps, Length(VisitedJumps) + 1);
          VisitedJumps[High(VisitedJumps)] := AbsJump;
          
          TargetAbsJump := AbsJump + 1 + Chunk.Code[AbsJump].Operand;
          
          // Self-jump
          if TargetAbsJump = AbsJump then Break;
          
          AbsJump := TargetAbsJump;
          Inc(IterCount);
        end;
        
        Chunk.Code[i].Operand := AbsJump - (i + 1);
      end;
    end;
    Inc(i);
  end;
end;

