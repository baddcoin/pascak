function Helper_SliceData(Target, VStart, VEnd, VStep: TValue): TValue;
var
  IdxStart, IdxEnd, IdxStep, Len, i, WriteIdx: Integer; 
  EstCount: Int64; 
  IterArr: TValueList;
  WideStrVal, WideStrKey: UnicodeString; 
begin
  if not (Target.DataType in [dtArray, dtString]) then
  begin
    if Assigned(errMSG) then
      errMSG.callerror(48, 'Helper_SliceData: Hanya mendukung Array dan String', errMSG.xrow, errMSG.xcol); 
    Exit(nil);
  end;

  if Target.DataType = dtArray then 
    Target.ArrayVal.FLock.Acquire;
    
  try
    if Target.DataType = dtArray then 
      Len := Target.ArrayVal.Count
    else 
    begin
      WideStrVal := UnicodeString(Target.StrVal); 
      Len := Length(WideStrVal);
    end;

    if Len = 0 then
    begin
      if Target.DataType = dtArray then Exit(TValue.CreateArray(TValueList.Create(True)))
      else Exit(TValue.CreateStr(''));
    end;
    
    IdxStep := 1;
    if Assigned(VStep) and (VStep.DataType = dtNumeric) then IdxStep := Trunc(VStep.NumVal);
    
    // PERBAIKAN: Mencegah CPU Crash akibat Division By Zero
    if IdxStep = 0 then
    begin
      if Assigned(errMSG) then
        errMSG.callerror(12, 'Helper_SliceData: Nilai Step (loncatan) tidak boleh 0', errMSG.xrow, errMSG.xcol);
      if Target.DataType = dtArray then Exit(TValue.CreateArray(TValueList.Create(True)))
      else Exit(TValue.CreateStr(''));
    end;

    if IdxStep > 0 then IdxStart := 0 else IdxStart := Len - 1;
    if Assigned(VStart) and (VStart.DataType = dtNumeric) then IdxStart := Trunc(VStart.NumVal);
    if IdxStep > 0 then IdxEnd := Len else IdxEnd := -1;
    if Assigned(VEnd) and (VEnd.DataType = dtNumeric) then IdxEnd := Trunc(VEnd.NumVal);
    
    if IdxStart < -1 then IdxStart := -1; if IdxStart > Len then IdxStart := Len;
    if IdxEnd < -1 then IdxEnd := -1; if IdxEnd > Len then IdxEnd := Len;
    
    if (IdxStep > 0) and (IdxEnd > IdxStart) then EstCount := (Int64(IdxEnd) - Int64(IdxStart) - 1) div IdxStep + 1
    else if (IdxStep < 0) and (IdxEnd < IdxStart) then EstCount := (Int64(IdxStart) - Int64(IdxEnd) - 1) div (-IdxStep) + 1
    else EstCount := 0;
      
    if Target.DataType = dtArray then
    begin
      if EstCount > arrMax then 
      begin
        if Assigned(errMSG) then
          errMSG.callerror(86, 'Helper_SliceData: Melebihi array max', errMSG.xrow, errMSG.xcol); 
        Exit(TValue.CreateArray(TValueList.Create(True))); 
      end;
        
      IterArr := TValueList.Create(True);
      try
        if EstCount > 0 then
        begin
          IterArr.Capacity := Integer(EstCount); 
          i := IdxStart;
          while ((IdxStep > 0) and (i < IdxEnd)) or ((IdxStep < 0) and (i > IdxEnd)) do
          begin
            if (i >= 0) and (i < Target.ArrayVal.Count) then
            begin
              if Assigned(Target.ArrayVal[i]) then
                IterArr.Add(Target.ArrayVal[i].Clone)
              else
                IterArr.Add(TValue.CreateNull); 
            end;
            Inc(i, IdxStep);
          end;
        end;
        Result := TValue.CreateArray(IterArr);
      except
        IterArr.Free;
        raise;
      end;      
    end else
    begin
      if EstCount > strMax then 
      begin
        if Assigned(errMSG) then
          errMSG.callerror(85, 'Helper_SliceData: Melebihi string max', errMSG.xrow, errMSG.xcol); 
        Exit(TValue.CreateStr('')); 
      end;

      if EstCount <= 0 then Exit(TValue.CreateStr(''));

      SetLength(WideStrKey, Integer(EstCount));
      WriteIdx := 1;
      i := IdxStart;
      
      while (WriteIdx <= Integer(EstCount)) and (i >= 0) and (i < Len) do
      begin
        WideStrKey[WriteIdx] := WideStrVal[i + 1]; 
        Inc(WriteIdx);
        Inc(i, IdxStep);
      end;
      
      SetLength(WideStrKey, WriteIdx - 1); 
      Result := TValue.CreateStr(UTF8Encode(WideStrKey));
    end;
  finally
    if Target.DataType = dtArray then Target.ArrayVal.FLock.Release;
  end;
end;

