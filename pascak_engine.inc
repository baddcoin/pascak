//A.4 — Metrics (Prometheus-compatible)═══════════════════════════
//═══════════════════════════════════════════════════════════════ }
function MetricLabelsToKey(Labels: TValue): string;
var
  Keys: TStringArray;
  i, j: Integer;
  Tmp: string;
  V: TValue;
begin
  Result := '';
  if not Assigned(Labels) or (Labels.DataType <> dtDict) then Exit;
  if Labels.DictVal.Count = 0 then Exit;

  Keys := Labels.DictVal.GetKeys;
  for i := 0 to High(Keys) - 1 do
    for j := i + 1 to High(Keys) do
      if Keys[i] > Keys[j] then
      begin
        Tmp := Keys[i]; Keys[i] := Keys[j]; Keys[j] := Tmp;
      end;

  for i := 0 to High(Keys) do
  begin
    if i > 0 then Result := Result + ',';
    V := Labels.DictVal.GetValueClone(Keys[i]);
    try
      if Assigned(V) and (V.DataType = dtString) then
        Result := Result + Keys[i] + '="' + V.StrVal + '"'
      else if Assigned(V) and (V.DataType = dtNumeric) then
        Result := Result + Keys[i] + '="' + FloatToStr(V.NumVal, FS) + '"'
      else
        Result := Result + Keys[i] + '=""';
    finally
      if Assigned(V) then V.Free;
    end;
  end;
end;

function MetricFindOrNil(const Name: string): PMetricEntry;
var Idx: Integer;
begin
  Result := nil;
  if not Assigned(GMetrics) then Exit;
  Idx := GMetrics.IndexOf(Name);
  if Idx >= 0 then Result := PMetricEntry(GMetrics.Objects[Idx]);
end;

function MetricGetValue(E: PMetricEntry; const Key: string; DefVal: Double): Double;
var V: TValue;
begin
  Result := DefVal;
  if not Assigned(E) or not Assigned(E^.Values) then Exit;
  V := E^.Values.GetValueClone(Key);
  try
    if Assigned(V) and (V.DataType = dtNumeric) then Result := V.NumVal;
  finally
    if Assigned(V) then V.Free;
  end;
end;

procedure MetricSetValue(E: PMetricEntry; const Key: string; Value: Double);
begin
  if not Assigned(E) then Exit;
  E^.Values.SetValue(Key, TValue.CreateNum(Value));
end;

function Native_MetricsDefine(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var E: PMetricEntry; Idx: Integer; TS: string;
begin
  if (Args.Count < 2) or (Args.Count > 3) or
     (TValue(Args[0]).DataType <> dtString) or (TValue(Args[1]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 'metrics.define(name, type, [help])', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  if not Assigned(GMetricsLock) then Exit(TValue.CreateBool(False));

  GMetricsLock.Acquire;
  try
    Idx := GMetrics.IndexOf(TValue(Args[0]).StrVal);
    if Idx >= 0 then Exit(TValue.CreateBool(True));

    New(E);
    E^.Name := TValue(Args[0]).StrVal;
    TS := LowerCase(TValue(Args[1]).StrVal);
    if TS = 'counter' then E^.MType := 0
    else if TS = 'gauge' then E^.MType := 1
    else if TS = 'histogram' then E^.MType := 2
    else begin
      Dispose(E);
      errMSG.callerror(144, 'metrics.define: type harus counter|gauge|histogram',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateBool(False));
    end;
    if Args.Count >= 3 then E^.Help := TValueToString(TValue(Args[2]), False)
    else E^.Help := E^.Name;
    E^.Values := TDictValue.Create;
    GMetrics.AddObject(E^.Name, TObject(E));
  finally
    GMetricsLock.Release;
  end;
  Result := TValue.CreateBool(True);
end;

function Native_MetricsIncrement(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var E: PMetricEntry; Key: string; Labels: TValue; Cur: Double;
begin
  if (Args.Count < 1) or (Args.Count > 2) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'metrics.increment(name, [labels])', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  if not Assigned(GMetricsLock) then Exit(TValue.CreateBool(False));

  Labels := nil;
  if Args.Count = 2 then Labels := TValue(Args[1]);

  GMetricsLock.Acquire;
  try
    E := MetricFindOrNil(TValue(Args[0]).StrVal);
    if not Assigned(E) or (E^.MType <> 0) then
    begin
      errMSG.callerror(144, 'metrics.increment: metric counter belum didefinisikan',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateBool(False));
    end;
    Key := MetricLabelsToKey(Labels);
    Cur := MetricGetValue(E, Key, 0);
    MetricSetValue(E, Key, Cur + 1);
  finally
    GMetricsLock.Release;
  end;
  Result := TValue.CreateBool(True);
end;

function Native_MetricsAdd(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var E: PMetricEntry; Key: string; Labels: TValue; Cur, Delta: Double;
begin
  if (Args.Count < 2) or (Args.Count > 3) or
     (TValue(Args[0]).DataType <> dtString) or (TValue(Args[1]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(140, 'metrics.add(name, value, [labels])', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  if not Assigned(GMetricsLock) then Exit(TValue.CreateBool(False));

  Delta := TValue(Args[1]).NumVal;
  Labels := nil;
  if Args.Count = 3 then Labels := TValue(Args[2]);

  GMetricsLock.Acquire;
  try
    E := MetricFindOrNil(TValue(Args[0]).StrVal);
    if not Assigned(E) or (E^.MType <> 0) then
    begin
      errMSG.callerror(144, 'metrics.add: metric counter belum didefinisikan',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateBool(False));
    end;
    Key := MetricLabelsToKey(Labels);
    Cur := MetricGetValue(E, Key, 0);
    MetricSetValue(E, Key, Cur + Delta);
  finally
    GMetricsLock.Release;
  end;
  Result := TValue.CreateBool(True);
end;

function Native_MetricsSet(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var E: PMetricEntry; Key: string; Labels: TValue;
begin
  if (Args.Count < 2) or (Args.Count > 3) or
     (TValue(Args[0]).DataType <> dtString) or (TValue(Args[1]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(140, 'metrics.set(name, value, [labels])', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  if not Assigned(GMetricsLock) then Exit(TValue.CreateBool(False));

  Labels := nil;
  if Args.Count = 3 then Labels := TValue(Args[2]);

  GMetricsLock.Acquire;
  try
    E := MetricFindOrNil(TValue(Args[0]).StrVal);
    if not Assigned(E) or (E^.MType <> 1) then
    begin
      errMSG.callerror(144, 'metrics.set: metric gauge belum didefinisikan',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateBool(False));
    end;
    Key := MetricLabelsToKey(Labels);
    MetricSetValue(E, Key, TValue(Args[1]).NumVal);
  finally
    GMetricsLock.Release;
  end;
  Result := TValue.CreateBool(True);
end;

function Native_MetricsObserve(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  E: PMetricEntry;
  Key, BKey: string;
  Labels: TValue;
  Value: Double;
  i: Integer;
  BVal: Double;
begin
  if (Args.Count < 2) or (Args.Count > 3) or
     (TValue(Args[0]).DataType <> dtString) or (TValue(Args[1]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(140, 'metrics.observe(name, value, [labels])', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  if not Assigned(GMetricsLock) then Exit(TValue.CreateBool(False));

  Value := TValue(Args[1]).NumVal;
  Labels := nil;
  if Args.Count = 3 then Labels := TValue(Args[2]);

  GMetricsLock.Acquire;
  try
    E := MetricFindOrNil(TValue(Args[0]).StrVal);
    if not Assigned(E) or (E^.MType <> 2) then
    begin
      errMSG.callerror(144, 'metrics.observe: metric histogram belum didefinisikan',
                       errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateBool(False));
    end;
    Key := MetricLabelsToKey(Labels);

    // Increment count + sum
    BVal := MetricGetValue(E, Key + '|c', 0);
    MetricSetValue(E, Key + '|c', BVal + 1);
    BVal := MetricGetValue(E, Key + '|s', 0);
    MetricSetValue(E, Key + '|s', BVal + Value);

    // Update buckets (cumulative: count all buckets >= value)
    for i := 0 to High(METRIC_BUCKETS) do
    begin
      if Value <= METRIC_BUCKETS[i] then
      begin
        BKey := Key + '|b' + IntToStr(i);
        BVal := MetricGetValue(E, BKey, 0);
        MetricSetValue(E, BKey, BVal + 1);
      end;
    end;
  finally
    GMetricsLock.Release;
  end;
  Result := TValue.CreateBool(True);
end;

function Native_MetricsExpose(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SL: TStringList;
  i, j,kk: Integer;
  E: PMetricEntry;
  Keys: TStringArray;
  K, SeriesKey, TypeStr, LabelPart, Suffix: string;
  V: Double;
  AllCount: Double;
begin
  SL := TStringList.Create;
  try
    if not Assigned(GMetricsLock) then Exit(TValue.CreateStr(''));
    GMetricsLock.Acquire;
    try
      for i := 0 to GMetrics.Count - 1 do
      begin
        E := PMetricEntry(GMetrics.Objects[i]);
        if not Assigned(E) then Continue;

        SL.Add('# HELP ' + E^.Name + ' ' + E^.Help);
        if E^.MType = 0 then TypeStr := 'counter'
        else if E^.MType = 1 then TypeStr := 'gauge'
        else TypeStr := 'histogram';
        SL.Add('# TYPE ' + E^.Name + ' ' + TypeStr);

        Keys := E^.Values.GetKeys;

        if E^.MType in [0, 1] then
        begin
          for j := 0 to High(Keys) do
          begin
            V := MetricGetValue(E, Keys[j], 0);
            if Keys[j] = '' then
              SL.Add(E^.Name + ' ' + FloatToStr(V, FS))
            else
              SL.Add(E^.Name + '{' + Keys[j] + '} ' + FloatToStr(V, FS));
          end;
        end
        else
        begin
          // Histogram: group by base label key
          for j := 0 to High(Keys) do
          begin
            K := Keys[j];
            if Length(K) < 2 then Continue;
            if Copy(K, Length(K) - 1, 2) <> '|c' then Continue;
        
            LabelPart := Copy(K, 1, Length(K) - 2);
            AllCount := MetricGetValue(E, K, 0);
            
            // Buckets
            for kk := 0 to High(METRIC_BUCKETS) do
            begin
              SeriesKey := LabelPart + '|b' + IntToStr(kk);
              V := MetricGetValue(E, SeriesKey, 0);
              Suffix := 'le="' + FloatToStr(METRIC_BUCKETS[kk], FS) + '"';
              if LabelPart = '' then
                SL.Add(E^.Name + '_bucket{' + Suffix + '} ' + FloatToStr(V, FS))
              else
                SL.Add(E^.Name + '_bucket{' + LabelPart + ',' + Suffix + '} ' + FloatToStr(V, FS));
            end;

            // +Inf bucket = total count
            Suffix := 'le="+Inf"';
            if LabelPart = '' then
              SL.Add(E^.Name + '_bucket{' + Suffix + '} ' + FloatToStr(AllCount, FS))
            else
              SL.Add(E^.Name + '_bucket{' + LabelPart + ',' + Suffix + '} ' + FloatToStr(AllCount, FS));

            // Sum
            V := MetricGetValue(E, LabelPart + '|s', 0);
            if LabelPart = '' then
              SL.Add(E^.Name + '_sum ' + FloatToStr(V, FS))
            else
              SL.Add(E^.Name + '_sum{' + LabelPart + '} ' + FloatToStr(V, FS));

            // Count
            if LabelPart = '' then
              SL.Add(E^.Name + '_count ' + FloatToStr(AllCount, FS))
            else
              SL.Add(E^.Name + '_count{' + LabelPart + '} ' + FloatToStr(AllCount, FS));
          end;
        end;
        SL.Add('');
      end;
    finally
      GMetricsLock.Release;
    end;
    Result := TValue.CreateStr(SL.Text);
  finally
    SL.Free;
  end;
end;

function Native_MetricsReset(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var i: Integer; E: PMetricEntry;
begin
  if not Assigned(GMetricsLock) then Exit(TValue.CreateBool(False));
  GMetricsLock.Acquire;
  try
    for i := 0 to GMetrics.Count - 1 do
    begin
      E := PMetricEntry(GMetrics.Objects[i]);
      if Assigned(E) and Assigned(E^.Values) then E^.Values.Clear;
    end;
  finally
    GMetricsLock.Release;
  end;
  Result := TValue.CreateBool(True);
end;

function Native_MetricsList(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var Arr: TValueList; i: Integer; E: PMetricEntry;
begin
  Arr := TValueList.Create(True);
  try
    if Assigned(GMetricsLock) then
    begin
      GMetricsLock.Acquire;
      try
        for i := 0 to GMetrics.Count - 1 do
        begin
          E := PMetricEntry(GMetrics.Objects[i]);
          if Assigned(E) then Arr.Add(TValue.CreateStr(E^.Name));
        end;
      finally
        GMetricsLock.Release;
      end;
    end;
    Result := TValue.CreateArray(Arr);
  except
    Arr.Free;
    raise;
  end;
end;//end Metrics (Prometheus-compatible)

//linter=================================
//=======================================
constructor TLinter.Create;
begin
  inherited Create;
  FIssues := TStringList.Create;
  FScopes := TList.Create;
  FFileName := '';
  FWarningCount := 0;
  FErrorCount := 0;
end;

destructor TLinter.Destroy;
var i: Integer;
begin
  for i := 0 to FScopes.Count - 1 do
  begin
    if Assigned(FScopes[i]) then
      TList(FScopes[i]).Free;
  end;
  FScopes.Free;
  FIssues.Free;
  inherited;
end;

procedure TLinter.AddWarn(Line, Col: Integer; const Code, Msg: string);
begin
  FIssues.Add(Code + ':' + IntToStr(Line) + ':' + IntToStr(Col) +
              ' warning ' + Msg);
  Inc(FWarningCount);
end;

procedure TLinter.AddErr(Line, Col: Integer; const Code, Msg: string);
begin
  FIssues.Add(Code + ':' + IntToStr(Line) + ':' + IntToStr(Col) +
              ' error   ' + Msg);
  Inc(FErrorCount);
end;

procedure TLinter.PushScope;
begin
  FScopes.Add(TList.Create);
end;

procedure TLinter.PopScope;
var
  i: Integer;
  Scope: TList;
  V: TLintVar;
begin
  if FScopes.Count = 0 then Exit;
  Scope := TList(FScopes[FScopes.Count - 1]);
  for i := 0 to Scope.Count - 1 do
  begin
    V := TLintVar(Scope[i]);
    if (not V.Used) and (not V.IsParam) and (not V.IsConst) then
      if V.IsFunction then
        AddWarn(V.Line, V.Col, 'W003', 'unused function ''' + V.Name + '''')
      else
        AddWarn(V.Line, V.Col, 'W001', 'unused variable ''' + V.Name + '''');
    V.Free;
  end;
  Scope.Free;
  FScopes.Delete(FScopes.Count - 1);
end;

procedure TLinter.DeclareVar(const Name: string; Line, Col: Integer;
  IsParam, IsConst: Boolean; AIsFunction: Boolean = False);
var
  Scope: TList;
  V, Existing: TLintVar;
  i: Integer;
begin
  if (Name = '') or (FScopes.Count = 0) then Exit;
  Scope := TList(FScopes[FScopes.Count - 1]);

  for i := 0 to Scope.Count - 1 do
  begin
    Existing := TLintVar(Scope[i]);
    if Existing.Name = Name then
    begin
      AddErr(Line, Col, 'E001',
        'duplicate declaration of ''' + Name + ''' ' +
        '(first at line ' + IntToStr(Existing.Line) + ')');
      Exit;
    end;
  end;

  V := TLintVar.Create;
  V.Name := Name;
  V.Line := Line;
  V.Col := Col;
  V.Used := False;
  V.IsParam := IsParam;
  V.IsConst := IsConst;
  V.IsFunction := AIsFunction;
  Scope.Add(V);
end;

function TLinter.FindVar(const Name: string): TLintVar;
var
  i, j: Integer;
  Scope: TList;
  V: TLintVar;
begin
  for i := FScopes.Count - 1 downto 0 do
  begin
    Scope := TList(FScopes[i]);
    for j := 0 to Scope.Count - 1 do
    begin
      V := TLintVar(Scope[j]);
      if V.Name = Name then Exit(V);
    end;
  end;
  Result := nil;
end;

procedure TLinter.MarkUsed(const Name: string);
var V: TLintVar;
begin
  V := FindVar(Name);
  if Assigned(V) then V.Used := True;
end;

procedure TLinter.WalkExprList(List: TNodeList);
var i: Integer;
begin
  if not Assigned(List) then Exit;
  for i := 0 to List.Count - 1 do
    WalkStmt(TNode(List[i]));
end;

procedure TLinter.WalkExprList(List: TObjectList);
var i: Integer;
begin
  if not Assigned(List) then Exit;
  for i := 0 to List.Count - 1 do
    WalkStmt(TNode(List[i]));
end;

procedure TLinter.WalkBlock(B: TBlockNode; IsScope: Boolean);
var
  i: Integer;
  Stmt: TNode;
  Reachable: Boolean;
begin
  if not Assigned(B) then Exit;
  if IsScope then PushScope;
  try
    Reachable := True;
    for i := 0 to B.Statements.Count - 1 do
    begin
      Stmt := TNode(B.Statements[i]);

      if (not Reachable) and (not (Stmt is TNoOpNode)) and
         (not (Stmt is TFunctionNode)) and (not (Stmt is TClassDeclNode)) then
        AddWarn(Stmt.Line, Stmt.Col, 'W002',
          'unreachable code after terminator');

      WalkStmt(Stmt);

      if (Stmt is TReturnNode) or (Stmt is TThrowNode) or
         (Stmt is TBreakNode) or (Stmt is TContinueNode) then
        Reachable := False;
    end;
  finally
    if IsScope then PopScope;
  end;
end;

procedure TLinter.WalkStmt(Node: TNode);
var
  i: Integer;
  Fn: TFunctionNode;
  CD: TClassDeclNode;
begin
  if Node = nil then Exit;

  // ─── Declarations ───
  if Node is TVarDeclNode then
  begin
    if Assigned(TVarDeclNode(Node).Expr) then
      WalkStmt(TVarDeclNode(Node).Expr);
    DeclareVar(TVarDeclNode(Node).VarName, Node.Line, Node.Col,
      False, TVarDeclNode(Node).IsConst);
  end
  else if Node is TFunctionNode then
  begin
    Fn := TFunctionNode(Node);
    PushScope;
    try
      for i := 0 to High(Fn.Params) do
      begin
        DeclareVar(Fn.Params[i].Name, Fn.Line, Fn.Col, True, False);
        if Assigned(Fn.Params[i].DefaultExpr) then
          WalkStmt(Fn.Params[i].DefaultExpr);
      end;
      if Assigned(Fn.Body) then
        WalkStmt(Fn.Body);
    finally
      PopScope;
    end;
    if Fn.Name <> '' then
      DeclareVar(Fn.Name, Node.Line, Node.Col, False, False, True);
  end
  else if Node is TClassDeclNode then
  begin
    CD := TClassDeclNode(Node);
    DeclareVar(CD.sClassName, Node.Line, Node.Col, False, False);
    PushScope;
    try
      DeclareVar('self', Node.Line, Node.Col, True, False);
      for i := 0 to CD.Methods.Count - 1 do
        WalkStmt(TNode(CD.Methods[i]));
    finally
      PopScope;
    end;
  end

  // ─── Block ───
  else if Node is TBlockNode then
    WalkBlock(TBlockNode(Node), TBlockNode(Node).IsScope)

  // ─── Statement types ───
  else if Node is TVariableNode then
    MarkUsed(TVariableNode(Node).VarName)

  else if Node is TAssignmentNode then
  begin
    MarkUsed(TAssignmentNode(Node).TargetName);
    WalkStmt(TAssignmentNode(Node).Expr);
  end

  else if Node is TMultiAssignNode then
  begin
    for i := 0 to TMultiAssignNode(Node).Targets.Count - 1 do
      MarkUsed(TMultiAssignNode(Node).Targets[i]);
    WalkStmt(TMultiAssignNode(Node).Expr);
  end

  else if Node is TReturnNode then
  begin
    if Assigned(TReturnNode(Node).Expr) then
      WalkStmt(TReturnNode(Node).Expr);
  end

  else if Node is TThrowNode then
  begin
    if Assigned(TThrowNode(Node).Expr) then
      WalkStmt(TThrowNode(Node).Expr);
  end

  else if Node is TIfNode then
  begin
    WalkStmt(TIfNode(Node).Condition);
    if Assigned(TIfNode(Node).ThenBranch) then
      WalkStmt(TIfNode(Node).ThenBranch);
    if Assigned(TIfNode(Node).ElseBranch) then
      WalkStmt(TIfNode(Node).ElseBranch);
  end

  else if Node is TWhileNode then
  begin
    WalkStmt(TWhileNode(Node).Condition);
    if Assigned(TWhileNode(Node).Body) then
      WalkStmt(TWhileNode(Node).Body);
  end

  else if Node is TRepeatNode then
  begin
    if Assigned(TRepeatNode(Node).Body) then
      WalkStmt(TRepeatNode(Node).Body);
    WalkStmt(TRepeatNode(Node).Condition);
  end

  else if Node is TForNode then
  begin
    WalkStmt(TForNode(Node).StartExpr);
    WalkStmt(TForNode(Node).EndExpr);
    if Assigned(TForNode(Node).StepExpr) then
      WalkStmt(TForNode(Node).StepExpr);
    PushScope;
    try
      DeclareVar(TForNode(Node).VarName, Node.Line, Node.Col, False, False);
      if Assigned(TForNode(Node).Body) then
        WalkStmt(TForNode(Node).Body);
    finally
      PopScope;
    end;
  end

  else if Node is TForEachNode then
  begin
    WalkStmt(TForEachNode(Node).CollectionExpr);
    PushScope;
    try
      DeclareVar(TForEachNode(Node).VarName, Node.Line, Node.Col, False, False);
      if Assigned(TForEachNode(Node).Body) then
        WalkStmt(TForEachNode(Node).Body);
    finally
      PopScope;
    end;
  end

  else if Node is TTryCatchNode then
  begin
    if Assigned(TTryCatchNode(Node).TryBlock) then
      WalkStmt(TTryCatchNode(Node).TryBlock);
    if Assigned(TTryCatchNode(Node).CatchBlock) then
    begin
      PushScope;
      try
        if TTryCatchNode(Node).CatchVar <> '' then
          DeclareVar(TTryCatchNode(Node).CatchVar, Node.Line, Node.Col,
            False, False);
        WalkStmt(TTryCatchNode(Node).CatchBlock);
      finally
        PopScope;
      end;
    end;
    if Assigned(TTryCatchNode(Node).FinallyBlock) then
      WalkStmt(TTryCatchNode(Node).FinallyBlock);
  end

  else if Node is TCaseNode then
  begin
    WalkStmt(TCaseNode(Node).TargetExpr);
    for i := 0 to High(TCaseNode(Node).Branches) do
    begin
      if Assigned(TCaseNode(Node).Branches[i].MatchExpr) then
        WalkStmt(TCaseNode(Node).Branches[i].MatchExpr);
      if Assigned(TCaseNode(Node).Branches[i].Body) then
        WalkStmt(TCaseNode(Node).Branches[i].Body);
    end;
    if Assigned(TCaseNode(Node).ElseBranch) then
      WalkStmt(TCaseNode(Node).ElseBranch);
  end

  else if Node is TLockNode then
  begin
    if Assigned(TLockNode(Node).Body) then
      WalkStmt(TLockNode(Node).Body);
  end

  else if Node is TDeferNode then
  begin
    if Assigned(TDeferNode(Node).Body) then
      WalkStmt(TDeferNode(Node).Body);
  end

  else if Node is TYieldNode then
  begin
    if Assigned(TYieldNode(Node).Expr) then
      WalkStmt(TYieldNode(Node).Expr);
  end

  // ─── Expressions ───
  else if Node is TBinaryOpNode then
  begin
    WalkStmt(TBinaryOpNode(Node).Left);
    WalkStmt(TBinaryOpNode(Node).Right);
  end

  else if Node is TUnaryOpNode then
  begin
    if Assigned(TUnaryOpNode(Node).Expr) then
      WalkStmt(TUnaryOpNode(Node).Expr);
  end

  else if Node is TTernaryNode then
  begin
    WalkStmt(TTernaryNode(Node).Condition);
    WalkStmt(TTernaryNode(Node).TrueBranch);
    WalkStmt(TTernaryNode(Node).FalseBranch);
  end

  else if Node is TFunctionCallNode then
  begin
    WalkStmt(TFunctionCallNode(Node).FuncExpr);
    WalkExprList(TFunctionCallNode(Node).Args);
  end

  else if Node is TMethodCallNode then
  begin
    WalkStmt(TMethodCallNode(Node).Target);
    WalkExprList(TMethodCallNode(Node).Args);
  end

  else if Node is TNewNode then
  begin
    MarkUsed(TNewNode(Node).sClassName);
    WalkExprList(TNewNode(Node).Args);
  end

  else if Node is TMemberAccessNode then
    WalkStmt(TMemberAccessNode(Node).Target)

  else if Node is TMemberAssignNode then
  begin
    WalkStmt(TMemberAssignNode(Node).Target);
    WalkStmt(TMemberAssignNode(Node).Expr);
  end

  else if Node is TArrayAccessNode then
  begin
    WalkStmt(TArrayAccessNode(Node).FTarget);
    WalkStmt(TArrayAccessNode(Node).FIndexExpr);
  end

  else if Node is TArrayAssignNode then
  begin
    WalkStmt(TArrayAssignNode(Node).FTarget);
    WalkStmt(TArrayAssignNode(Node).FIndexExpr);
    WalkStmt(TArrayAssignNode(Node).FValueExpr);
  end

  else if Node is TArrayLiteralNode then
    WalkExprList(TArrayLiteralNode(Node).FElements)

  else if Node is TArraySliceNode then
  begin
    WalkStmt(TArraySliceNode(Node).Target);
    WalkStmt(TArraySliceNode(Node).StartExpr);
    WalkStmt(TArraySliceNode(Node).EndExpr);
    WalkStmt(TArraySliceNode(Node).StepExpr);
  end

  else if Node is TDictLiteralNode then
    WalkExprList(TDictLiteralNode(Node).FValues)

  else if Node is TListComprehensionNode then
  begin
    PushScope;
    try
      DeclareVar(TListComprehensionNode(Node).VarName, Node.Line, Node.Col,
        False, False);
      WalkStmt(TListComprehensionNode(Node).CollectionExpr);
      if Assigned(TListComprehensionNode(Node).ConditionExpr) then
        WalkStmt(TListComprehensionNode(Node).ConditionExpr);
      WalkStmt(TListComprehensionNode(Node).OutputExpr);
    finally
      PopScope;
    end;
  end

  else if Node is TImportExprNode then
    WalkStmt(TImportExprNode(Node).PathExpr)

  else if Node is TLiteralNode then
  begin
    // no-op
  end
  else if Node is TNoOpNode then
  begin
    // no-op
  end;
end;

procedure TLinter.Lint(Node: TNode; const AFileName: string);
begin
  FFileName := AFileName;
  if not Assigned(Node) then Exit;
  PushScope;
  try
    WalkStmt(Node);
  finally
    PopScope;
  end;
end;

function TLinter.HasIssues: Boolean;
begin
  Result := FIssues.Count > 0;
end;

function TLinter.HasErrors: Boolean;
begin
  Result := FErrorCount > 0;
end;

function TLinter.FormatReport: string;
begin
  Result := FIssues.Text;
end;//end linter

//E.1 — Formatter════════════════════════════════════════════════
//═══════════════════════════════════════════════════════════════ }
function FmtExtractFirstWord(const S: string): string;
var i, j: Integer;
begin
  Result := '';
  i := 1;
  while (i <= Length(S)) and not (S[i] in ['a'..'z', 'A'..'Z', '_']) do Inc(i);
  j := i;
  while (j <= Length(S)) and (S[j] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do Inc(j);
  if j > i then Result := LowerCase(Copy(S, i, j - i));
end;

function FmtExtractLastWord(const S: string): string;
var i, j: Integer;
begin
  Result := '';
  i := Length(S);
  while (i > 0) and not (S[i] in ['a'..'z', 'A'..'Z', '_']) do Dec(i);
  j := i;
  while (j > 0) and (S[j] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do Dec(j);
  if i > j then Result := LowerCase(Copy(S, j + 1, i - j));
end;

function FmtIsLineComplete(const L: string): Boolean;
var
  LastCh: Char;
  LastW: string;
begin
  // Comment lines are "complete" — no continuation on next line
  if (Length(L) >= 2) and (L[1] = '/') and (L[2] = '/') then
    Exit(True);

  if L = '' then Exit(True);
  LastCh := L[Length(L)];
  if LastCh = ';' then Exit(True);
  if LastCh = '{' then Exit(True);   // dict literal opener — indentation handled by push rule
  LastW := FmtExtractLastWord(L);  
  if (LastW = 'begin') or (LastW = 'end') or (LastW = 'try') or
     (LastW = 'repeat') or (LastW = 'record') or (LastW = 'else') or
     (LastW = 'then') or (LastW = 'do') or (LastW = 'of') or
     (LastW = 'except') or (LastW = 'finally') then
    Exit(True);
  Result := False;
end;

function NormalizeOperatorSpacing(const L: string): string;
var
  i, Len: Integer;
  C, PrevC: Char;
  InStr: Boolean;
  Quote: Char;
  InLine, InBlk: Boolean;
  OpSet: set of Char;

  function LastNonSpace(FromPos: Integer): Char;
  var k: Integer;
  begin
    k := FromPos - 1;
    while (k >= 1) and (L[k] = ' ') do Dec(k);
    if k >= 1 then Result := L[k] else Result := #0;
  end;

  function IsCompoundAt(Idx: Integer): Boolean;
  var a, b: Char;
  begin
    Result := False;
    if (Idx < 1) or (Idx >= Len) then Exit;
    a := L[Idx]; b := L[Idx + 1];
    Result := ((a = ':') and (b = '=')) or
              ((a = '<') and ((b = '=') or (b = '>'))) or
              ((a = '>') and (b = '=')) or
              ((a = '=') and (b = '=')) or
              ((a = '!') and (b = '=')) or
              ((a = '+') and (b = '=')) or
              ((a = '-') and (b = '=')) or
              ((a = '*') and (b = '=')) or
              ((a = '/') and (b = '=')) or
              ((a = '%') and (b = '='));
  end;

  procedure StripTrailingSpaces;
  begin
    while (Length(Result) > 0) and (Result[Length(Result)] = ' ') do
      SetLength(Result, Length(Result) - 1);
  end;

begin
  Result := '';
  Len := Length(L);
  if Len = 0 then Exit;
  OpSet := ['+', '-', '*', '/', '%', '<', '>', '=', '!'];
  InStr := False; Quote := #0;
  InLine := False; InBlk := False;

  i := 1;
  while i <= Len do
  begin
    C := L[i];

    if InStr then
    begin
      Result := Result + C;
      if (C = Quote) and ((i = 1) or (L[i - 1] <> '\')) then
        InStr := False;
      Inc(i); Continue;
    end;

    if InLine then
    begin
      Result := Result + C;
      Inc(i); Continue;
    end;

    if InBlk then
    begin
      Result := Result + C;
      if (C = '*') and (i < Len) and (L[i + 1] = '/') then
      begin
        Result := Result + '/'; Inc(i, 2); InBlk := False; Continue;
      end;
      Inc(i); Continue;
    end;

    if (C = '"') or (C = #39) then
    begin
      InStr := True; Quote := C;
      Result := Result + C; Inc(i); Continue;
    end;

    if (C = '/') and (i < Len) and (L[i + 1] = '/') then
    begin
      InLine := True;
      Result := Result + '//'; Inc(i, 2); Continue;
    end;

    if (C = '/') and (i < Len) and (L[i + 1] = '*') then
    begin
      InBlk := True;
      Result := Result + '/*'; Inc(i, 2); Continue;
    end;

    if IsCompoundAt(i) then
    begin
      StripTrailingSpaces;
      if Length(Result) > 0 then Result := Result + ' ';
      Result := Result + C + L[i + 1];
      Inc(i, 2);
      while (i <= Len) and (L[i] = ' ') do Inc(i);
      if i <= Len then Result := Result + ' ';
      Continue;
    end;

    if C in OpSet then
    begin
      if C in ['+', '-'] then
      begin
        PrevC := LastNonSpace(i);
        if (PrevC = #0) or (PrevC in ['(', '[', '{', ',', ';', ':',
             '=', '<', '>', '!', '+', '-', '*', '/', '%']) then
        begin
          Result := Result + C; Inc(i); Continue;
        end;
      end;

      StripTrailingSpaces;
      if Length(Result) > 0 then Result := Result + ' ';
      Result := Result + C;
      Inc(i);
      while (i <= Len) and (L[i] = ' ') do Inc(i);
      if i <= Len then Result := Result + ' ';
      Continue;
    end;

    Result := Result + C;
    Inc(i);
  end;
end;

function FormatPascakSource(const Source: string): string;
var
  Lines: TStringArray;
  OutLines: TStringList;
  Stack: array of TFormatBlockKind;
  StackTop, i, Indent, EffectiveIndent: Integer;
  Line, Trimmed, LowerTrimmed, FirstWord, LastWord: string;
  PrevComplete: Boolean;
  PrevBlank: Boolean;
  IsCloser: Boolean;
  
  procedure Push(K: TFormatBlockKind);
  begin
    if StackTop >= Length(Stack) then
      SetLength(Stack, Length(Stack) + 32);
    Stack[StackTop] := K;
    Inc(StackTop);
  end;

  function Pop: TFormatBlockKind;
  begin
    if StackTop <= 0 then Exit(fbkNone);
    Dec(StackTop);
    Result := Stack[StackTop];
  end;

  function Peek: TFormatBlockKind;
  begin
    if StackTop <= 0 then Exit(fbkNone);
    Result := Stack[StackTop - 1];
  end;

  function StripCR(const L: string): string;
  begin
    Result := L;
    if (Length(Result) > 0) and (Result[Length(Result)] = #13) then
      SetLength(Result, Length(Result) - 1);
  end;

begin
  Lines := Source.Split([#10]);
  OutLines := TStringList.Create;
  SetLength(Stack, 32);
  StackTop := 0;
  Indent := 0;
  PrevComplete := True;
  PrevBlank := False;

  try
    for i := 0 to High(Lines) do
    begin
      Line := StripCR(Lines[i]);
      Trimmed := Trim(Line);

      if Trimmed = '' then
      begin
        if (OutLines.Count > 0) and (not PrevBlank) then
        begin
          OutLines.Add('');
          PrevBlank := True;
        end;
        Continue;
      end;
      PrevBlank := False;

      Trimmed := NormalizeOperatorSpacing(Trimmed);
      LowerTrimmed := LowerCase(Trimmed);
      FirstWord := FmtExtractFirstWord(Trimmed);
      LastWord := FmtExtractLastWord(Trimmed);

      // Dedent for closers (pop stack + indent)
      IsCloser := (FirstWord = 'end') or (FirstWord = 'until') or
                  ((Length(Trimmed) > 0) and (Trimmed[1] = '}'));
      if IsCloser then
      begin
        Pop;
        if Indent > 0 then Dec(Indent);
      end;

      EffectiveIndent := Indent;

      // Middle keywords
      if (FirstWord = 'except') or (FirstWord = 'finally') then
      begin
        if EffectiveIndent > 0 then Dec(EffectiveIndent);
      end
      else if FirstWord = 'else' then
      begin
        if Peek = fbkCase then
          if EffectiveIndent > 0 then Dec(EffectiveIndent);
      end
      // Continuation line
      else if (not PrevComplete) and (Peek <> fbkBrace) and (not IsCloser) then
        Inc(EffectiveIndent);        
        
      if EffectiveIndent < 0 then EffectiveIndent := 0;

      OutLines.Add(StringOfChar(' ', EffectiveIndent * 2) + Trimmed);

      // Openers (post-emit)
      if LastWord = 'begin' then
      begin Push(fbkBegin); Inc(Indent); end
      else if LastWord = 'try' then
      begin Push(fbkTry); Inc(Indent); end
      else if LastWord = 'repeat' then
      begin Push(fbkRepeat); Inc(Indent); end
      else if LastWord = 'record' then
      begin Push(fbkRecord); Inc(Indent); end
      else if (FirstWord = 'case') and (Pos(' of', LowerTrimmed) > 0) then
      begin Push(fbkCase); Inc(Indent); end
      else if (Length(Trimmed) > 0) and (Trimmed[Length(Trimmed)] = '{') and
              (Pos('//', Trimmed) = 0) then
      begin Push(fbkBrace); Inc(Indent); end;

      PrevComplete := FmtIsLineComplete(Trimmed);
    end;

    Result := OutLines.Text;
  finally
    OutLines.Free;
  end;
end;

//D.1 — Coroutine Scheduler══════════════════════════════════════
//═══════════════════════════════════════════════════════════════ }
function CoTaskFind(TID: Int64): PCoTask;
var
  Idx: Integer;
begin
  Result := nil;
  if not Assigned(GCoTasks) then Exit;
  Idx := GCoTasks.IndexOf(TID);
  if Idx >= 0 then Result := GCoTasks.Data[Idx];
end;

procedure CoTaskFree(T: PCoTask);
begin
  if not Assigned(T) then Exit;
  if Assigned(T^.VM) then
  begin
    try TVM(T^.VM).Free; except end;
    T^.VM := nil;
  end;
  if Assigned(T^.FinalValue) then
  begin
    T^.FinalValue.Free;
    T^.FinalValue := nil;
  end;
  if Assigned(T^.Callback) then
  begin
    T^.Callback.Free;
    T^.Callback := nil;
  end;
  Dispose(T);
end;

procedure CoTaskUnregister(TID: Int64);
var
  Idx: Integer;
begin
  if not Assigned(GCoTasks) then Exit;
  Idx := GCoTasks.IndexOf(TID);
  if Idx >= 0 then GCoTasks.Delete(Idx);
end;

procedure TickCoTasks;
var
  ReadyIDs: array of Int64;
  ReadyPriorities: array of Integer;
  TmpID: Int64;
  TmpP: Integer;
  i, j: Integer;
  T: PCoTask;
  VM: TVM;
  Res, SleepVal: TValue;
  NowTick: QWord;
  SleepMs: Integer;
  SavedCallback, SavedFinal, CbArg: TValue;
begin
  if not Assigned(GCoTasks) then Exit;

  // ═══════════════════════════════════════════════════════════════
  //  Phase 1: Collect ready tasks (state=0 pending / state=2 sleeping
  //           dengan WakeAt <= now)
  // ═══════════════════════════════════════════════════════════════
  NowTick := GetTickCount64;
  SetLength(ReadyIDs, 0);
  SetLength(ReadyPriorities, 0);

  GCoTaskLock.Acquire;
  try
    for i := 0 to GCoTasks.Count - 1 do
    begin
      T := GCoTasks.Data[i];
      if not Assigned(T) then Continue;
      if (T^.State = 0) or (T^.State = 2) then
      begin
        if NowTick >= T^.WakeAt then
        begin
          T^.State := 1;   // transition → running
          SetLength(ReadyIDs, Length(ReadyIDs) + 1);
          SetLength(ReadyPriorities, Length(ReadyPriorities) + 1);
          ReadyIDs[High(ReadyIDs)] := T^.TaskID;
          ReadyPriorities[High(ReadyPriorities)] := T^.Priority;
        end;
      end;
    end;
  finally
    GCoTaskLock.Release;
  end;

  if Length(ReadyIDs) = 0 then Exit;

  // ═══════════════════════════════════════════════════════════════
  //  Phase 2: Sort by priority descending (higher priority first)
  // ═══════════════════════════════════════════════════════════════
  for i := 0 to High(ReadyIDs) - 1 do
  begin
    for j := i + 1 to High(ReadyIDs) do
    begin
      if ReadyPriorities[j] > ReadyPriorities[i] then
      begin
        TmpID := ReadyIDs[i];
        ReadyIDs[i] := ReadyIDs[j];
        ReadyIDs[j] := TmpID;

        TmpP := ReadyPriorities[i];
        ReadyPriorities[i] := ReadyPriorities[j];
        ReadyPriorities[j] := TmpP;
      end;
    end;
  end;

  // ═══════════════════════════════════════════════════════════════
  //  Phase 3: Process each ready task (di priority order)
  // ═══════════════════════════════════════════════════════════════
  for i := 0 to High(ReadyIDs) do
  begin
    T := CoTaskFind(ReadyIDs[i]);
    if not Assigned(T) then Continue;   // mungkin sudah di-cancel

    VM := TVM(T^.VM);
    if not Assigned(VM) then
    begin
      T^.State := 4;
      T^.ErrorMsg := 'VM hilang';
      Continue;
    end;

    Res := nil;
    try
      if VM.FState = vmReady then
        Res := VM.Run(nil, True)
      else if VM.FState = vmYielded then
        Res := VM.Resume(nil)
      else
      begin
        T^.State := 3;
        Continue;
      end;
    except
      on E: Exception do
      begin
        T^.State := 4;
        T^.ErrorMsg := E.Message;
        Continue;
      end;
    end;

    // ─── Case A: task SELESAI (VM dead) ───
    if VM.FState = vmDead then
    begin
      T^.State := 3;
      if Assigned(Res) then
        T^.FinalValue := Res
      else
        T^.FinalValue := TValue.CreateNull;

      // Fire callback (jika ada). Auto-free task setelah callback.
      if Assigned(T^.Callback) and (T^.Callback.DataType = dtFunction) then
      begin
        // ✅ FIX #2: Snapshot + unregister + free task SEBELUM fire
        // callback. Ini mencegah UAF kalau callback memanggil coCancel().
        SavedCallback := T^.Callback;  T^.Callback := nil;
        SavedFinal := T^.FinalValue;   T^.FinalValue := nil;

        CoTaskUnregister(ReadyIDs[i]);
        CoTaskFree(T);
        T := nil;

        // ✅ FIX #3: free CbArg setelah CallWSCallback (pola konsisten
        // dengan WSDispatchMessage / TNativeEventEmitter).
        try
          CbArg := SavedFinal.Clone;
          try
            CallWSCallback(SavedCallback, [CbArg]);
          finally
            CbArg.Free;
          end;
        except
          on E: Exception do
            PushThreadError('coThen callback: ' + E.Message);
        end;

        SavedCallback.Free;
        SavedFinal.Free;
      end;
      // else: no callback — task stays in registry; caller must
      // coWait/coResult untuk cleanup (perilaku D.1b).
      Continue;
    end;

    // ─── Case B: coSleep yield ───
    if Assigned(Res) and (Res.DataType = dtDict) and
       Res.DictVal.HasKey('__co_sleep') then
    begin
      SleepVal := Res.DictVal.GetValueClone('__co_sleep');
      SleepMs := 0;
      if Assigned(SleepVal) and (SleepVal.DataType = dtNumeric) then
        SleepMs := Trunc(SleepVal.NumVal);
      if Assigned(SleepVal) then SleepVal.Free;
      Res.Free;

      // ✅ FIX #3: guard negatif — QWord(-1) = ~49 hari
      if SleepMs < 0 then SleepMs := 0;

      T^.State := 2;
      T^.WakeAt := GetTickCount64 + QWord(SleepMs);
    end
    else
    begin
      // ─── Case C: generic yield — resume next tick ───
      if Assigned(Res) then Res.Free;
      T^.State := 0;
      T^.WakeAt := GetTickCount64 + 10;
    end;
  end;
end;

function Native_CoSpawn(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TargetFunc: TValue;
  CoVM: TVM;
  T: PCoTask;
  TID: Int64;
  Priority: Integer;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtFunction) then
  begin
    errMSG.callerror(140, 'coSpawn(fn, [priority])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  Priority := 0;
  if Args.Count = 2 then
    if TValue(Args[1]).DataType = dtNumeric then
      Priority := Trunc(TValue(Args[1]).NumVal);

  TargetFunc := TValue(Args[0]);
  if not Assigned(TargetFunc.FuncVal) then
  begin
    errMSG.callerror(144, 'coSpawn: fungsi tidak valid', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  CoVM := TVM.Create(CallEnv.GetGlobal);
  CoVM.FTop := 0;
  CoVM.FFrameCount := 1;
  CoVM.FFrames[0].FuncValue := TargetFunc.Clone;
  CoVM.FFrames[0].Chunk := TargetFunc.FuncVal.Chunk;
  CoVM.FFrames[0].IP := 0;
  CoVM.FFrames[0].BaseSlot := 0;
  if Assigned(TargetFunc.ClosureEnv) then
    CoVM.FFrames[0].Env := TargetFunc.ClosureEnv
  else
    CoVM.FFrames[0].Env := CallEnv.GetGlobal;
  
  CoVM.FFrames[0].Env.Retain;
  CoVM.FState := vmReady;
  
  // D.1 fix: init state yang biasanya di-set oleh Run(IsResume=False)
  // — tanpa ini, FGlobalCache kosong -> AV saat opcGetGlobal
  CoVM.FStartTime := GetTickCount64;
  CoVM.FInstructionCount := 0;
  CoVM.EnsureInlineCache(TargetFunc.FuncVal.Chunk.CodeCount);
  
  TID := InterlockedIncrement64(GCoTaskCounter);

  New(T);
  T^.TaskID := TID;
  T^.VM := Pointer(CoVM);
  T^.State := 0;
  T^.WakeAt := GetTickCount64;
  T^.FinalValue := nil;
  T^.ErrorMsg := '';
  T^.Callback := nil;
  T^.Priority := Priority;

  GCoTaskLock.Acquire;
  try
    GCoTasks.Add(TID, T);
  finally
    GCoTaskLock.Release;
  end;

  Result := TValue.CreateNum(TID);
end;

function Native_CoWait(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TID: Int64;
  TimeoutMs: Integer;
  StartTick: QWord;
  T: PCoTask;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(139, 'coWait(taskID, [timeoutMs])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  TID := Trunc(TValue(Args[0]).NumVal);
  TimeoutMs := 0;
  if Args.Count = 2 then
    if TValue(Args[1]).DataType = dtNumeric then
      TimeoutMs := Trunc(TValue(Args[1]).NumVal);

  StartTick := GetTickCount64;

  repeat
    TickCoTasks;
    T := CoTaskFind(TID);
    if not Assigned(T) then
      Exit(TValue.CreateNull);
    if T^.State = 3 then
    begin
      // Done — return final value (clone) + unregister + free
      if Assigned(T^.FinalValue) then
        Result := T^.FinalValue.Clone
      else
        Result := TValue.CreateNull;
      CoTaskUnregister(TID);
      CoTaskFree(T);
      Exit;
    end;
    if T^.State = 4 then
    begin
      CoTaskUnregister(TID);
      CoTaskFree(T);
      Exit(TValue.CreateNull);
    end;
    if (TimeoutMs > 0) and
       ((GetTickCount64 - StartTick) > QWord(TimeoutMs)) then
      Exit(TValue.CreateNull);
    Sleep(10);
  until False;
end;

function Native_CoWaitAll(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  i: Integer;
  StartTick: QWord;
  TimeoutMs: Integer;
  AnyPending: Boolean;
  T: PCoTask;
begin
  TimeoutMs := 0;
  if (Args.Count = 1) and (TValue(Args[0]).DataType = dtNumeric) then
    TimeoutMs := Trunc(TValue(Args[0]).NumVal);

  StartTick := GetTickCount64;

  repeat
    TickCoTasks;
    AnyPending := False;

    // Cleanup done + check pending
    GCoTaskLock.Acquire;
    try
      i := 0;
      while i < GCoTasks.Count do
      begin
        T := GCoTasks.Data[i];
        if not Assigned(T) then
        begin
          GCoTasks.Delete(i);
          Continue;
        end;
        if (T^.State = 3) or (T^.State = 4) then
        begin
          CoTaskFree(T);
          GCoTasks.Delete(i);
          Continue;
        end;
        AnyPending := True;
        Inc(i);
      end;
    finally
      GCoTaskLock.Release;
    end;

    if not AnyPending then Break;
    if (TimeoutMs > 0) and
       ((GetTickCount64 - StartTick) > QWord(TimeoutMs)) then
      Break;
    Sleep(10);
  until False;

  Result := TValue.CreateNull;
end;

function Native_CoCount(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  i, Count: Integer;
  T: PCoTask;
begin
  Count := 0;
  if Assigned(GCoTasks) then
  begin
    GCoTaskLock.Acquire;
    try
      for i := 0 to GCoTasks.Count - 1 do
      begin
        T := GCoTasks.Data[i];
        if Assigned(T) and ((T^.State = 0) or (T^.State = 1) or (T^.State = 2)) then
          Inc(Count);
      end;
    finally
      GCoTaskLock.Release;
    end;
  end;
  Result := TValue.CreateNum(Count);
end;

function Native_CoThen(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TID: Int64;
  T: PCoTask;
  Cb: TValue;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtNumeric) or
     (TValue(Args[1]).DataType <> dtFunction) then
  begin
    errMSG.callerror(140, 'coThen(taskID, fn)', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;

  TID := Trunc(TValue(Args[0]).NumVal);
  Cb := TValue(Args[1]);

  T := CoTaskFind(TID);
  if not Assigned(T) then Exit(TValue.CreateBool(False));

  // Task sudah done — fire callback immediately
  if T^.State = 3 then
  begin
    try
      if Assigned(T^.FinalValue) then
        CallWSCallback(Cb, [T^.FinalValue.Clone])
      else
        CallWSCallback(Cb, [TValue.CreateNull]);
    except
      on E: Exception do
        PushThreadError('coThen immediate: ' + E.Message);
    end;
    CoTaskUnregister(TID);
    CoTaskFree(T);
    Exit(TValue.CreateBool(True));
  end;

  // Error — cleanup, return false
  if T^.State = 4 then
  begin
    CoTaskUnregister(TID);
    CoTaskFree(T);
    Exit(TValue.CreateBool(False));
  end;

  // Replace existing callback if any
  if Assigned(T^.Callback) then
    T^.Callback.Free;
  T^.Callback := Cb.Clone;

  Result := TValue.CreateBool(True);
end;

function Native_CoJoin(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TIDsArr: TValue;
  ResultsArr: TValueList;
  TimeoutMs: Integer;
  i: Integer;
  TID: Int64;
  StartTick: QWord;
  AllDone: Boolean;
  T: PCoTask;
  Snapshot: array of Int64;
  SnapshotCount: Integer;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtArray) then
  begin
    errMSG.callerror(139, 'coJoin([taskIDs], [timeoutMs])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  TIDsArr := TValue(Args[0]);
  TimeoutMs := 0;
  if Args.Count = 2 then
    if TValue(Args[1]).DataType = dtNumeric then
      TimeoutMs := Trunc(TValue(Args[1]).NumVal);

  // Snapshot TIDs once
  TIDsArr.ArrayVal.FLock.Acquire;
  try
    SnapshotCount := TIDsArr.ArrayVal.Count;
    SetLength(Snapshot, SnapshotCount);
    for i := 0 to SnapshotCount - 1 do
      if Assigned(TIDsArr.ArrayVal[i]) and
         (TIDsArr.ArrayVal[i].DataType = dtNumeric) then
        Snapshot[i] := Trunc(TIDsArr.ArrayVal[i].NumVal)
      else
        Snapshot[i] := -1;
  finally
    TIDsArr.ArrayVal.FLock.Release;
  end;

  StartTick := GetTickCount64;

  repeat
    TickCoTasks;

    AllDone := True;
    for i := 0 to SnapshotCount - 1 do
    begin
      if Snapshot[i] < 0 then Continue;
      T := CoTaskFind(Snapshot[i]);
      if Assigned(T) and ((T^.State = 0) or (T^.State = 1) or (T^.State = 2)) then
      begin
        AllDone := False;
        Break;
      end;
    end;

    if AllDone then Break;
    if (TimeoutMs > 0) and
       ((GetTickCount64 - StartTick) > QWord(TimeoutMs)) then
      Break;
    Sleep(10);
  until False;

  ResultsArr := TValueList.Create(True);
  try
    for i := 0 to SnapshotCount - 1 do
    begin
      if Snapshot[i] < 0 then
      begin
        ResultsArr.Add(TValue.CreateNull);
        Continue;
      end;
      T := CoTaskFind(Snapshot[i]);
      if Assigned(T) and (T^.State = 3) then
      begin
        if Assigned(T^.FinalValue) then
          ResultsArr.Add(T^.FinalValue.Clone)
        else
          ResultsArr.Add(TValue.CreateNull);
        CoTaskUnregister(Snapshot[i]);
        CoTaskFree(T);
      end
      else
        ResultsArr.Add(TValue.CreateNull);
    end;
    Result := TValue.CreateArray(ResultsArr);
  except
    ResultsArr.Free;
    raise;
  end;
end;

function Native_CoStatus(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TID: Int64;
  T: PCoTask;
  S: string;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(139, 'coStatus(taskID)', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateStr('unknown'));
  end;
  TID := Trunc(TValue(Args[0]).NumVal);
  T := CoTaskFind(TID);
  if not Assigned(T) then Exit(TValue.CreateStr('unknown'));
  case T^.State of
    0: S := 'pending';
    1: S := 'running';
    2: S := 'sleeping';
    3: S := 'done';
    4: S := 'error';
  else
    S := 'unknown';
  end;
  Result := TValue.CreateStr(S);
end;

function Native_CoResult(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TID: Int64;
  T: PCoTask;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(139, 'coResult(taskID)', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  TID := Trunc(TValue(Args[0]).NumVal);
  T := CoTaskFind(TID);
  if not Assigned(T) then Exit(TValue.CreateNull);

  // Not done yet — return null, keep task
  if (T^.State = 0) or (T^.State = 1) or (T^.State = 2) then
    Exit(TValue.CreateNull);

  // Error — clean up, return null
  if T^.State = 4 then
  begin
    CoTaskUnregister(TID);
    CoTaskFree(T);
    Exit(TValue.CreateNull);
  end;

  // Done — clone result + auto-free
  if Assigned(T^.FinalValue) then
    Result := T^.FinalValue.Clone
  else
    Result := TValue.CreateNull;
  CoTaskUnregister(TID);
  CoTaskFree(T);
end;

function Native_CoCancel(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TID: Int64;
  T: PCoTask;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(139, 'coCancel(taskID)', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  TID := Trunc(TValue(Args[0]).NumVal);
  T := CoTaskFind(TID);
  if not Assigned(T) then Exit(TValue.CreateBool(False));

  CoTaskUnregister(TID);
  CoTaskFree(T);
  Result := TValue.CreateBool(True);
end;//end D.1 — Coroutine Scheduler

