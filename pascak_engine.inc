function Native_GetTick(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  Result := TValue.CreateNum(GetTickCount64);
end;

function Native_Sleep(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ms, Chunk, Elapsed: Integer;
  Ctx: TEngineContext;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
    errMSG.callerror(138, 'Native_Sleep', errMSG.xrow, errMSG.xcol); 
    
  Ms := Trunc(TValue(Args[0]).NumVal);
  if Ms <= 0 then
    Exit(TValue.CreateNull);

  Ctx := GetContextFromEnv(CallEnv);

  Elapsed := 0;
  while Elapsed < Ms do
  begin
    Chunk := 10;
    if Ms - Elapsed < Chunk then
      Chunk := Ms - Elapsed;
    
    // Tick WS event loop (blocking sampai Chunk ms)
    if Assigned(GWSEventLoop) then
      try GWSEventLoop.Tick(Chunk); except end;
    
    // ✅ Tick per-engine event loop (worker pool, http.getAsync, timer)
    // agar callback fire selama script masih running.
    if Assigned(Ctx) and Assigned(Ctx.EventLoop) then
      try Ctx.EventLoop.TickOnce(CallEnv); except end;
    
    // Process done exec tasks (execAsync callback)
    try ProcessExecCallbacks; except end;
    // ✅ FASE 1.3: process done fs tasks
    try ProcessFSAsyncCallbacks; except end;    
    
    // Hindari busy loop kalau GWSEventLoop tidak ada
    if not Assigned(GWSEventLoop) then
      Sleep(Chunk);
    
    Inc(Elapsed, Chunk);
  end;
    
  Result := TValue.CreateNull;
end;

function Native_SetTimeout(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TEngineContext;
  FnVal: TValue;
  DelayMs: Integer;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtFunction) or
     (TValue(Args[1]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(140, 'setTimeout(fn, ms)', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  FnVal := TValue(Args[0]);
  DelayMs := Trunc(TValue(Args[1]).NumVal);
  if DelayMs < 0 then DelayMs := 0;

  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) or not Assigned(Ctx.EventLoop) then
  begin
    errMSG.callerror(144, 'setTimeout: event loop tidak tersedia', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  Result := TValue.CreateNum(Ctx.EventLoop.SetTimer(FnVal, QWord(DelayMs), False));
end;

function Native_SetInterval(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TEngineContext;
  FnVal: TValue;
  DelayMs: Integer;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtFunction) or
     (TValue(Args[1]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(140, 'setInterval(fn, ms)', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  FnVal := TValue(Args[0]);
  DelayMs := Trunc(TValue(Args[1]).NumVal);
  if DelayMs < 1 then DelayMs := 1;

  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) or not Assigned(Ctx.EventLoop) then
  begin
    errMSG.callerror(144, 'setInterval: event loop tidak tersedia', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;

  Result := TValue.CreateNum(Ctx.EventLoop.SetTimer(FnVal, QWord(DelayMs), True));
end;

function Native_ClearTimer(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TEngineContext;
  TimerID: Int64;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'clearTimeout(id)', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;

  TimerID := Trunc(TValue(Args[0]).NumVal);

  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) or not Assigned(Ctx.EventLoop) then
    Exit(TValue.CreateBool(False));

  Result := TValue.CreateBool(Ctx.EventLoop.ClearTimer(TimerID));
end;

function Native_SysArgs(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Arr: TValueList;
  i: Integer;
begin
  Arr := TValueList.Create(True);
  try 
    // : Mulai dari 0 agar Path OS ter-capture
    for i := 0 to ParamCount do
      Arr.Add(TValue.CreateStr(ParamStr(i)));
      
    Result := TValue.CreateArray(Arr);
  except
    Arr.Free; 
    raise;
  end;
end;

function Native_SysEnv(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var 
  Key, Val: string;
begin
  if Args.Count <> 1 then 
    errMSG.callerror(139, 'Native_SysEnv', errMSG.xrow, errMSG.xcol); 
  
  Key := TValue(Args[0]).StrVal;
  Val := GetEnvironmentVariable(Key);
  
  if Val = '' then Result := TValue.CreateNull else Result := TValue.CreateStr(Val);
end;

function Native_SysExit(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var 
  Code: Integer;
  E: EScriptFatalError;
begin
  Result := nil;
  Code := 0;
  if (Args.Count = 1) and (TValue(Args[0]).DataType = dtNumeric) then 
    Code := Trunc(TValue(Args[0]).NumVal);
    
  InterlockedExchange(IsShuttingDown, 1);
  
  E := EScriptFatalError.Create(
    'Script dihentikan paksa melalui sys.exit(' + IntToStr(Code) + ')');
  E.ExitCode := Code;
  raise E;
end;

function Native_On(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TEngineContext;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtString) then
    raise EScriptRuntimeError.Create('on(event, callback) membutuhkan 2 argumen (string, function)');
  
  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) or not Assigned(Ctx.EventEmitter) then
    raise EScriptRuntimeError.Create('EventEmitter tidak tersedia di engine context');
  
  Ctx.EventEmitter.Subscribe(TValue(Args[0]).StrVal, TValue(Args[1]));
  Result := TValue.CreateBool(True);
end;

function Native_Emit(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TEngineContext;
begin
  if (Args.Count < 1) or (TValue(Args[0]).DataType <> dtString) then
    raise EScriptRuntimeError.Create('emit(event, [args]) membutuhkan minimal 1 argumen string');
  
  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) or not Assigned(Ctx.EventEmitter) then
    raise EScriptRuntimeError.Create('EventEmitter tidak tersedia di engine context');
  
  Ctx.EventEmitter.EmitEvent(TValue(Args[0]).StrVal, Args, CallEnv);
  Result := TValue.CreateBool(True);
end;

function Native_SysMemoryUsage(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  MemDict: TDictValue;
  Ctx: TEngineContext;
  UsedBytes, QuotaBytes: Int64;
begin
  // ✅ FASE 1.1: context-aware
  Ctx := GetContextFromEnv(CallEnv);
  if Assigned(Ctx) and (Ctx.FEngineMagic = ENGINE_MAGIC_CONST) then
  begin
    UsedBytes := InterlockedCompareExchange64(Ctx.MemUsage, 0, 0);
    QuotaBytes := Ctx.MemQuota;
  end
  else
  begin
    UsedBytes := InterlockedCompareExchange64(GlobalMemUsage, 0, 0);
    QuotaBytes := GlobalMemQuota;
  end;

  MemDict := TDictValue.Create;
  try
    MemDict.SetValue('used_bytes', TValue.CreateNum(UsedBytes));    
    MemDict.SetValue('quota_bytes', TValue.CreateNum(QuotaBytes));    
    
    // Kunci memori untuk menghindari Race Condition pembacaan Count
    MemLock.Acquire;
    try
      if Assigned(Gen0Objects) then MemDict.SetValue('gen0_objects', TValue.CreateNum(Gen0Objects.Count))
      else MemDict.SetValue('gen0_objects', TValue.CreateNum(0));
        
      if Assigned(Gen1Objects) then MemDict.SetValue('gen1_objects', TValue.CreateNum(Gen1Objects.Count))
      else MemDict.SetValue('gen1_objects', TValue.CreateNum(0));
    finally
      MemLock.Release;
    end;
      
    Result := TValue.CreateDict(MemDict);
  except
    MemDict.Free;
    raise;
  end;
end;

{ ====================================================================
  RUNTIME METRICS
  ==================================================================== }
function Native_RuntimeStats(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Stats: TDictValue;
  Gen0Count, Gen1Count, ZombieCount, VmCount: Integer;
  
  CtxStats: TEngineContext;
  MemUsed: Int64;
  MemQuota: Int64;  
begin
  Stats := TDictValue.Create;
  try
    // GC stats
    MemLock.Acquire;
    try
      if Assigned(Gen0Objects) then Gen0Count := Gen0Objects.Count else Gen0Count := 0;
      if Assigned(Gen1Objects) then Gen1Count := Gen1Objects.Count else Gen1Count := 0;
    finally
      MemLock.Release;
    end;
    
    ZombieLock.Acquire;
    try
      if Assigned(ZombieQueue) then ZombieCount := ZombieQueue.Count else ZombieCount := 0;
    finally
      ZombieLock.Release;
    end;
    
    VmCount := 0;
    if Assigned(ActiveVMs) then
    begin
      GCRootLock.Acquire;
      try
        VmCount := ActiveVMs.Count;
      finally
        GCRootLock.Release;
      end;
    end;
    
    CtxStats := GetContextFromEnv(CallEnv);
    if Assigned(CtxStats) and (CtxStats.FEngineMagic = ENGINE_MAGIC_CONST) then
    begin
      MemUsed := InterlockedCompareExchange64(CtxStats.MemUsage, 0, 0);
      MemQuota := CtxStats.MemQuota;
    end
    else
    begin
      MemUsed := GlobalMemUsage;
      MemQuota := GlobalMemQuota;
    end;
    
    Stats.SetValue('memory_used', TValue.CreateNum(MemUsed));
    Stats.SetValue('memory_quota', TValue.CreateNum(MemQuota));
    Stats.SetValue('memory_percent', TValue.CreateNum(
      Math.IfThen(MemQuota > 0, 100.0 * MemUsed / MemQuota, 0)));    
    
    Stats.SetValue('gc_gen0', TValue.CreateNum(Gen0Count));
    Stats.SetValue('gc_gen1', TValue.CreateNum(Gen1Count));
    Stats.SetValue('gc_zombie', TValue.CreateNum(ZombieCount));
    Stats.SetValue('active_vms', TValue.CreateNum(VmCount));
    Stats.SetValue('active_threads', TValue.CreateNum(ActiveThreads));
    Stats.SetValue('gc_running', TValue.CreateNum(IsGCRunning));
    
    Result := TValue.CreateDict(Stats);
  except
    Stats.Free;
    raise;
  end;
end;

function Native_ProfilerEnable(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TEngineContext;
begin
  Ctx := GetContextFromEnv(CallEnv);   // ✨ PHASE 7
  if Assigned(Ctx) and Assigned(Ctx.Profiler) then
    Ctx.Profiler.Enable;
  Result := TValue.CreateNull;
end;

function Native_ProfilerDisable(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TEngineContext;
begin
  // ✨ PHASE 7.5: Ambil context dari CallEnv (bukan global)
  Ctx := GetContextFromEnv(CallEnv);
  
  if Assigned(Ctx) and Assigned(Ctx.Profiler) then
    Ctx.Profiler.Disable;
  // Fail-silent: disable saat context nil bukan error kritis
  
  Result := TValue.CreateNull;
end;

function Native_ProfilerReport(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ctx: TEngineContext;
  FileName: string;
begin
  FileName := '';
  if (Args.Count >= 1) and (Args[0] <> nil) and (TValue(Args[0]).DataType = dtString) then
    FileName := TValue(Args[0]).StrVal;
  
  // ✨ PHASE 7.5: Ambil context dari CallEnv (bukan global)
  Ctx := GetContextFromEnv(CallEnv);
  
  if not Assigned(Ctx) or not Assigned(Ctx.Profiler) then
  begin
    // Tidak ada profiler — return nilai netral
    if FileName = '' then
      Result := TValue.CreateStr('Profiler tidak tersedia di engine context')
    else
      Result := TValue.CreateNull;
    Exit;
  end;
  
  // Akses via context
  if FileName = '' then
    Result := TValue.CreateStr(Ctx.Profiler.GetReport)
  else
  begin
    Ctx.Profiler.DumpReport(FileName);
    Result := TValue.CreateNull;
  end;
end;

//json====================
//========================
function ConvertJSONToTValue(JData: TJSONData; Depth: Integer = 0): TValue;
var
  i: Integer;
  Arr: TValueList;
  DictObj: TDictValue;
  JObj: TJSONObject;
  JArr: TJSONArray;
  EvalItem: TValue;
begin
  // Gunakan Native Exception daripada Thread-Var internal interpreter
  if Depth > 100 then 
    raise EScriptRuntimeError.Create('JSON Parsing Error: Batas maksimal kedalaman (100) terlampaui!');

  if not Assigned(JData) then Exit(TValue.CreateNull); 

  case JData.JSONType of
    jtNumber:  Result := TValue.CreateNum(JData.AsFloat);
    jtString:  Result := TValue.CreateStr(JData.AsString);
    jtBoolean: Result := TValue.CreateBool(JData.AsBoolean);
    jtNull:    Result := TValue.CreateNull;
    jtArray:
      begin
        JArr := TJSONArray(JData);
        Arr := TValueList.Create(True);
        Arr.Retain; // Proteksi GC
        try
          for i := 0 to JArr.Count - 1 do
          begin
            EvalItem := ConvertJSONToTValue(JArr.Items[i], Depth + 1);
            try
              Arr.Add(EvalItem); 
            except
              EvalItem.Free; // CEGAH MEMORY LEAK JIKA ADD GAGAL AKIBAT OOM!
              raise;
            end;
          end;
          Result := TValue.CreateArray(Arr);
        finally
          Arr.Release; 
        end;
      end;

    jtObject:
      begin
        JObj := TJSONObject(JData);
        DictObj := TDictValue.Create;
        try
          for i := 0 to JObj.Count - 1 do
          begin
            EvalItem := ConvertJSONToTValue(JObj.Items[i], Depth + 1);
            //  FATAL: SetValue mengambil alih memori (take ownership), BUKAN clone.
            // Jangan memanggil EvalItem.Free di sini, atau akan memicu Use-After-Free Crash!
            DictObj.SetValue(JObj.Names[i], EvalItem);
          end;
          Result := TValue.CreateDict(DictObj);
        except
          DictObj.Free; 
          raise;
        end;
      end;
    else Result := TValue.CreateNull;
  end;
end;

// Konversi Engine TValue kembali ke fpjson (String)
function ConvertTValueToJSON(Val: TValue; Visited: TList = nil; Depth: Integer = 0): TJSONData;
var
  i: Integer;
  JArr: TJSONArray;
  JObj: TJSONObject;
  OwnsList: Boolean;
  TempKeys: TStringArray; TempVal: TValue;
  TrackPtr: Pointer; // Pelacak alamat inti
begin
  if Depth > 100 then 
    raise EScriptRuntimeError.Create('JSON Stringify Error: Kedalaman objek melampaui batas maksimal!');

  if not Assigned(Val) then Exit(TJSONNull.Create);

  OwnsList := False;
  if Visited = nil then
  begin
    Visited := TList.Create;
    OwnsList := True;
  end;

  TrackPtr := nil;

  try
    // PROTEKSI CIRCULAR REFERENCE MUTLAK
    if Val.DataType in [dtArray, dtDict, dtObject] then
    begin
      if Val.DataType = dtArray then TrackPtr := Pointer(Val.ArrayVal)
      else if Val.DataType = dtDict then TrackPtr := Pointer(Val.DictVal)
      else if Val.DataType = dtObject then TrackPtr := Pointer(Val.ObjVal);

      if Assigned(TrackPtr) then
      begin
        if Visited.IndexOf(TrackPtr) <> -1 then Exit(TJSONNull.Create);
        Visited.Add(TrackPtr);
      end;
    end;

    case Val.DataType of
      dtNumeric:
        begin
          // ✅ FIX: integer-valued → render sebagai integer, bukan float.
          // Kalau tidak, 1791032282 muncul sebagai 1.79E+009 di JSON.
          if (Frac(Val.NumVal) = 0) and
             (Val.NumVal >= -9007199254740992.0) and    // 2^53, batas presisi double
             (Val.NumVal <= 9007199254740992.0) then
            Result := TJSONInt64Number.Create(Trunc(Val.NumVal))
          else
            Result := TJSONFloatNumber.Create(Val.NumVal);
        end;
      dtString:  Result := TJSONString.Create(Val.StrVal);      
      dtBoolean: Result := TJSONBoolean.Create(Val.BoolVal);
      dtNull:    Result := TJSONNull.Create;
      dtArray:
        begin
          JArr := TJSONArray.Create;
          Val.ArrayVal.FLock.Acquire; 
          try
            try
              for i := 0 to Val.ArrayVal.Count - 1 do
                JArr.Add(ConvertTValueToJSON(Val.ArrayVal[i], Visited, Depth + 1));
              Result := JArr;
            except
              JArr.Free;
              raise;
            end;
          finally
            Val.ArrayVal.FLock.Release;
          end;
        end;
      dtDict: 
        begin
          JObj := TJSONObject.Create;
          TempKeys := Val.DictVal.GetKeys;
          try
            for i := 0 to High(TempKeys) do
            begin
            
              TempVal := Val.DictVal.GetValueClone(TempKeys[i]);
              try
                JObj.Add(TempKeys[i], ConvertTValueToJSON(TempVal, Visited, Depth + 1));
              finally
                TempVal.Free;   // ✅ aman — ini clone milik kita
              end;
              
            end;
            Result := JObj;
          except
            JObj.Free;
            raise;
          end;
        end;
      else Result := TJSONNull.Create;
    end;
  finally
    if (not OwnsList) and Assigned(TrackPtr) then Visited.Remove(TrackPtr);
    if OwnsList then Visited.Free;
  end;
end;

// Jembatan (Bridge) Native Function untuk dipanggil dari dalam Script Anda
function Native_JSONParse(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  JData: TJSONData;
begin
  if Args.Count <> 1 then 
    errMSG.callerror(143, 'Native_JSONParse;-', errMSG.xrow, errMSG.xcol); 
  
  if TValue(Args[0]).DataType <> dtString then 
    errMSG.callerror(143, 'Native_JSONParse;-', errMSG.xrow, errMSG.xcol); 
  
  try
    JData := GetJSON(TValue(Args[0]).StrVal);
    if not Assigned(JData) then Exit(TValue.CreateNull);
    try
      Result := ConvertJSONToTValue(JData, 0);
    finally
      JData.Free;
    end;
  except
    on E: Exception do Result := TValue.CreateNull;
  end;
end;

function Native_JsonPath(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Current: TValue;
  Segments: TStringArray;
  i: Integer;
  Seg: string;
  Item: TValue;
begin
  if (Args.Count <> 2) or
     (TValue(Args[0]).DataType <> dtDict) or
     (TValue(Args[1]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 'jsonPath(dict, "a.b.c")', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  Current := TValue(Args[0]).Clone;
  Segments := TValue(Args[1]).StrVal.Split(['.']);

  try
    for i := 0 to High(Segments) do
    begin
      Seg := Segments[i];
      if Seg = '' then Continue;

      if Current.DataType <> dtDict then
      begin
        Result := TValue.CreateNull;
        Exit;
      end;

      Item := Current.DictVal.GetValueClone(Seg);
      if not Assigned(Item) then
      begin
        Result := TValue.CreateNull;
        Exit;
      end;

      Current.Free;
      Current := Item;
    end;

    Result := Current.Clone;
  finally
    Current.Free;
  end;
end;

function Native_JSONStringify(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  JData: TJSONData;
begin
  if Args.Count <> 1 then 
    errMSG.callerror(143, 'Native_JSONStringify;-', errMSG.xrow, errMSG.xcol); 
  
  JData := ConvertTValueToJSON(TValue(Args[0]));
  try
    Result := TValue.CreateStr(JData.AsJSON);
  finally
    JData.Free;
  end;
end;

