// sys.execInfo() → dict
function Native_SysExecInfo(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  D: TDictValue;
  Policy: TExecPolicy;
  ModeStr: string;
  Arr: TValueList;
  I: Integer;
begin
  Policy := ProcGetExecPolicy;
  if not Assigned(Policy) then
    Exit(TValue.CreateNull);

  D := TDictValue.Create;
  try
    case Policy.Mode of
      epmDenyAll: ModeStr := 'none';
      epmWhitelist: ModeStr := 'whitelist';
      epmAllowAll: ModeStr := 'allow-all';
    else
      ModeStr := 'unknown';
    end;

    D.SetValue('mode', TValue.CreateStr(ModeStr));
    D.SetValue('maxConcurrent', TValue.CreateNum(Policy.MaxConcurrent));
    D.SetValue('maxOutputBytes', TValue.CreateNum(Policy.MaxOutputBytes));
    D.SetValue('activeProcesses', TValue.CreateNum(GetActiveProcessCount)); 
    D.SetValue('auditLog', TValue.CreateStr(Policy.AuditLogPath));

    Arr := TValueList.Create(True);
    try
      for I := 0 to Policy.Binaries.Count - 1 do
        Arr.Add(TValue.CreateStr(Policy.Binaries[I]));
      D.SetValue('binaries', TValue.CreateArray(Arr));
    except
      Arr.Free;
      raise;
    end;

    Result := TValue.CreateDict(D);
  except
    D.Free;
    raise;
  end;
end;

