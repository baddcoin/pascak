function Native_NetRecv(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Sock, MaxBytes, ReadCount: Integer;
  Raw: RawByteString;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'net.recv(handle: int, [maxBytes: int])', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateStr(''));
  end;
  
  Sock := Trunc(TValue(Args[0]).NumVal);
  MaxBytes := 4096;
  if Args.Count = 2 then
  begin
    if TValue(Args[1]).DataType <> dtNumeric then
    begin
      errMSG.callerror(138, 'net.recv: maxBytes harus numerik', errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateStr(''));
    end;
    MaxBytes := Trunc(TValue(Args[1]).NumVal);
  end;
  
  ReadCount := NetRecv(Sock, MaxBytes, Raw);
  if ReadCount <= 0 then
    Exit(TValue.CreateStr(''));   // closed atau error — return empty
  
  Result := TValue.CreateStr(string(Raw));
end;

function Native_NetRecvTimeout(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Sock, MaxBytes, TimeoutMs, ReadCount: Integer;
  Raw: RawByteString;
begin
  if (Args.Count < 2) or (Args.Count > 3) or
     (TValue(Args[0]).DataType <> dtNumeric) or
     (TValue(Args[1]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(139, 'net.recvTimeout(handle: int, maxBytes: int, [timeoutMs: int])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateStr(''));
  end;
  
  Sock := Trunc(TValue(Args[0]).NumVal);
  MaxBytes := Trunc(TValue(Args[1]).NumVal);
  TimeoutMs := 1000;
  if Args.Count = 3 then
  begin
    if TValue(Args[2]).DataType <> dtNumeric then
    begin
      errMSG.callerror(138, 'net.recvTimeout: timeout harus numerik', errMSG.xrow, errMSG.xcol);
      Exit(TValue.CreateStr(''));
    end;
    TimeoutMs := Trunc(TValue(Args[2]).NumVal);
  end;
  
  ReadCount := NetRecvTimeout(Sock, MaxBytes, TimeoutMs, Raw);
  if ReadCount <= 0 then
    Exit(TValue.CreateStr(''));
  
  Result := TValue.CreateStr(string(Raw));
end;

