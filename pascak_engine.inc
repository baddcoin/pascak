function GenerateWSClientID: string;
begin
  Result := 'wscl-' + IntToHex(InterlockedIncrement(GWSClientCounter), 8);
end;

procedure RegisterWSClientConn(C: TWSClientConn);
begin
  if (not Assigned(GWSClientConns)) or (not Assigned(C)) then Exit;
  GWSClientConnsLock.Acquire;
  try
    C.Retain;
    GWSClientConns.AddObject(C.ID, C);
  finally
    GWSClientConnsLock.Release;
  end;
end;

procedure UnregisterWSClientConn(C: TWSClientConn);
var Idx: Integer;
begin
  if (not Assigned(GWSClientConns)) or (not Assigned(C)) then Exit;
  GWSClientConnsLock.Acquire;
  try
    Idx := GWSClientConns.IndexOf(C.ID);
    if Idx >= 0 then GWSClientConns.Delete(Idx);
  finally
    GWSClientConnsLock.Release;
  end;
  C.Release;
end;

function FindWSClientConn(const ID: string): TWSClientConn;
var Idx: Integer;
begin
  Result := nil;
  if not Assigned(GWSClientConns) then Exit;
  GWSClientConnsLock.Acquire;
  try
    Idx := GWSClientConns.IndexOf(ID);
    if Idx >= 0 then
      Result := TWSClientConn(GWSClientConns.Objects[Idx]);
    if Assigned(Result) then Result.Retain;
  finally
    GWSClientConnsLock.Release;
  end;
end;

function BuildWSClientFrame(Opcode: TWSOpcode;
  const Payload: RawByteString; Fin: Boolean = True): RawByteString;
var
  Header: RawByteString;
  B0: Byte;
  Len: Int64;
  MaskKey: array[0..3] of Byte;
  RandBytes: RawByteString;
  i: Integer;
begin
  RandBytes := SecureRandomBytes(4);
  for i := 0 to 3 do
    MaskKey[i] := Byte(RandBytes[i + 1]);

  Len := Length(Payload);
  B0 := Byte(Opcode);
  if Fin then B0 := B0 or $80;

  if Len < 126 then
  begin
    SetLength(Header, 6);
    Header[1] := Char(B0);
    Header[2] := Char($80 or Byte(Len));
    Header[3] := Char(MaskKey[0]);
    Header[4] := Char(MaskKey[1]);
    Header[5] := Char(MaskKey[2]);
    Header[6] := Char(MaskKey[3]);
  end
  else if Len <= 65535 then
  begin
    SetLength(Header, 8);
    Header[1] := Char(B0);
    Header[2] := Char($80 or 126);
    Header[3] := Char((Len shr 8) and $FF);
    Header[4] := Char(Len and $FF);
    Header[5] := Char(MaskKey[0]);
    Header[6] := Char(MaskKey[1]);
    Header[7] := Char(MaskKey[2]);
    Header[8] := Char(MaskKey[3]);
  end
  else
  begin
    SetLength(Header, 14);
    Header[1]  := Char(B0);
    Header[2]  := Char($80 or 127);
    Header[3]  := Char((Len shr 56) and $FF);
    Header[4]  := Char((Len shr 48) and $FF);
    Header[5]  := Char((Len shr 40) and $FF);
    Header[6]  := Char((Len shr 32) and $FF);
    Header[7]  := Char((Len shr 24) and $FF);
    Header[8]  := Char((Len shr 16) and $FF);
    Header[9]  := Char((Len shr 8)  and $FF);
    Header[10] := Char(Len and $FF);
    Header[11] := Char(MaskKey[0]);
    Header[12] := Char(MaskKey[1]);
    Header[13] := Char(MaskKey[2]);
    Header[14] := Char(MaskKey[3]);
  end;

  SetLength(Result, Length(Header) + Length(Payload));
  Move(Header[1], Result[1], Length(Header));
  for i := 1 to Length(Payload) do
    Result[Length(Header) + i] := Char(
      Byte(Payload[i]) xor MaskKey[(i - 1) mod 4]);
end;

function BuildWSClientFrameCompressed(Opcode: TWSOpcode;
  const Payload: RawByteString; Fin: Boolean;
  Compress: Boolean; Threshold: Integer): RawByteString;
var
  WirePayload: RawByteString;
  UseRSV1: Boolean;
  Compressed: RawByteString;
  Base: RawByteString;
begin
  UseRSV1 := False;
  WirePayload := Payload;

  if Compress and (Length(Payload) >= Threshold) and (Length(Payload) > 0) then
  begin
    try
      Compressed := DeflateRaw(Payload);
      if Length(Compressed) < Length(Payload) then
      begin
        WirePayload := Compressed;
        UseRSV1 := True;
      end;
    except
      UseRSV1 := False;
      WirePayload := Payload;
    end;
  end;

  Base := BuildWSClientFrame(Opcode, WirePayload, Fin);

  // Set RSV1 bit if compressed
  if UseRSV1 and (Length(Base) > 0) then
    Base[1] := Char(Byte(Base[1]) or $40);

  Result := Base;
end;

function BuildWSClientHandle(C: TWSClientConn): TValue;
var D: TDictValue;
begin
  D := TDictValue.Create;
  try
    D.SetValue('id', TValue.CreateStr(C.ID));
    D.SetValue('url', TValue.CreateStr(C.URL));
    D.SetValue('host', TValue.CreateStr(C.Host));
    D.SetValue('port', TValue.CreateNum(C.Port));
    D.SetValue('path', TValue.CreateStr(C.Path));
    D.SetValue('tls', TValue.CreateBool(C.IsTLS));
    D.SetValue('__ws_id', TValue.CreateStr(C.ID));
    Result := TValue.CreateDict(D);
  except
    D.Free;
    raise;
  end;
end;

function WSClientSendRaw(C: TWSClientConn; const Data: RawByteString): Boolean;
var Sent: Integer;
begin
  Result := False;
  if (not Assigned(C)) or (Length(Data) = 0) then Exit;
  C.SendLock.Acquire;
  try
    if Assigned(C.TLSConn) then
      Sent := TLSSend(C.TLSConn, Data)
    else if C.Sock >= 0 then
      Sent := NetSend(C.Sock, Data)
    else
      Sent := -1;
    Result := Sent > 0;
  finally
    C.SendLock.Release;
  end;
end;

function BuildWSClientHandshake(const Host, Path: string;
  Port: Integer; IsTLS: Boolean;
  OfferedProtocols: TStringList;
  CompressionEnabled: Boolean;
  out ClientKey: string): RawByteString;
var
  RandBytes: RawByteString;
  KeyB64: string;
  HostHdr, ProtoHdr, ExtHdr: string;
  i: Integer;
begin
  RandBytes := SecureRandomBytes(16);
  KeyB64 := Base64Encode(RandBytes);
  ClientKey := KeyB64;

  if ((not IsTLS) and (Port = 80)) or (IsTLS and (Port = 443)) then
    HostHdr := Host
  else
    HostHdr := Host + ':' + IntToStr(Port);

  // C.3 — Build subprotocols header
  ProtoHdr := '';
  if Assigned(OfferedProtocols) and (OfferedProtocols.Count > 0) then
  begin
    ProtoHdr := 'Sec-WebSocket-Protocol: ';
    for i := 0 to OfferedProtocols.Count - 1 do
    begin
      if i > 0 then ProtoHdr := ProtoHdr + ', ';
      ProtoHdr := ProtoHdr + OfferedProtocols[i];
    end;
    ProtoHdr := ProtoHdr + #13#10;
  end;

  // C.4 — permessage-deflate offer
  ExtHdr := '';
  if CompressionEnabled then
    ExtHdr := 'Sec-WebSocket-Extensions: permessage-deflate; client_max_window_bits' + #13#10;

  Result := RawByteString(
    'GET ' + Path + ' HTTP/1.1' + #13#10 +
    'Host: ' + HostHdr + #13#10 +
    'Upgrade: websocket' + #13#10 +
    'Connection: Upgrade' + #13#10 +
    'Sec-WebSocket-Key: ' + KeyB64 + #13#10 +
    'Sec-WebSocket-Version: 13' + #13#10 +
    ProtoHdr +
    ExtHdr +
    #13#10);
end;//end Bundle C — WebSocket Client helpers

function Native_WS_Serve(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Port, Handle, Sock: Integer;
  Config: TValue;
  Server: PWSServerEntry;
begin
  if (Args.Count <> 2) or
     (TValue(Args[0]).DataType <> dtNumeric) or
     (TValue(Args[1]).DataType <> dtDict) then
  begin
    errMSG.callerror(140, 'ws.serve(port, config) butuh (int, dict)',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Port := Trunc(TValue(Args[0]).NumVal);
  Config := TValue(Args[1]);
  
  if (Port < 1) or (Port > 65535) then
  begin
    errMSG.callerror(138, 'ws.serve: port harus 1..65535',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  if not NetListen('0.0.0.0', Port, Sock) then
  begin
    errMSG.callerror(145, 'ws.serve: listen gagal — ' + NetLastError,
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Handle := AllocWSServer;
  Server := GetWSServer(Handle);
  Server^.ListenSock := Sock;
  Server^.Port := Port;
  Server^.IsTLS := False;
  Server^.TLSContext := nil;
  
  WSExtractHandlers(Server, Config);
  
  Result := TValue.CreateNum(Handle);
end;

function Native_WS_ServeTLS(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Port, Handle, Sock: Integer;
  CertPath, KeyPath, SafeCert, SafeKey, HomeDir, Msg: string;
  Config: TValue;
  Server: PWSServerEntry;
  Ctx: TLSServerContext;
begin
  if (Args.Count <> 4) or
     (TValue(Args[0]).DataType <> dtNumeric) or
     (TValue(Args[1]).DataType <> dtString) or
     (TValue(Args[2]).DataType <> dtString) or
     (TValue(Args[3]).DataType <> dtDict) then
  begin
    errMSG.callerror(140, 'ws.serveTLS(port, cert, key, config) butuh (int, str, str, dict)',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Port := Trunc(TValue(Args[0]).NumVal);
  CertPath := TValue(Args[1]).StrVal;
  KeyPath := TValue(Args[2]).StrVal;
  Config := TValue(Args[3]);
  
  if (Port < 1) or (Port > 65535) then
  begin
    errMSG.callerror(138, 'ws.serveTLS: port harus 1..65535',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  HomeDir := GetEnvironmentVariable('HOME');
  
  if (Length(CertPath) > 0) and (CertPath[1] = '/') and
     (HomeDir <> '') and (Copy(CertPath, 1, Length(HomeDir)) = HomeDir) then
    SafeCert := CertPath
  else
    SafeCert := GetSafeSandboxedPath(CertPath);
  
  if (Length(KeyPath) > 0) and (KeyPath[1] = '/') and
     (HomeDir <> '') and (Copy(KeyPath, 1, Length(HomeDir)) = HomeDir) then
    SafeKey := KeyPath
  else
    SafeKey := GetSafeSandboxedPath(KeyPath);
  
  if not TLSInit then
  begin
    errMSG.callerror(144, 'ws.serveTLS: libssl tidak tersedia',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Ctx := TLSServerContext.Create(SafeCert, SafeKey);
  if not Ctx.IsValid then
  begin
    Msg := Ctx.LastError;
    Ctx.Release;
    errMSG.callerror(144, 'ws.serveTLS: ' + Msg, errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  if not NetListen('0.0.0.0', Port, Sock) then
  begin
    Ctx.Release;
    errMSG.callerror(145, 'ws.serveTLS: listen gagal — ' + NetLastError,
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Handle := AllocWSServer;
  Server := GetWSServer(Handle);
  Server^.ListenSock := Sock;
  Server^.Port := Port;
  Server^.IsTLS := True;
  Server^.TLSContext := Pointer(Ctx);
  Server^.TLSCert := SafeCert;
  Server^.TLSKey := SafeKey;
  
  WSExtractHandlers(Server, Config);
  
  Result := TValue.CreateNum(Handle);
end;

function Native_WS_Listen(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Handle, ClientSock: Integer;
  Server: PWSServerEntry;
  Ctx: TEngineContext;
  Worker: TWSWorkerThread;
  ConnCount: Int64;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'ws.listen(serverHandle) butuh 1 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Handle := Trunc(TValue(Args[0]).NumVal);
  Server := GetWSServer(Handle);
  if not Assigned(Server) then
  begin
    errMSG.callerror(144, 'ws.listen: server handle tidak valid',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(-1));
  end;
  
  Ctx := GetContextFromEnv(CallEnv);
  
  ConnCount := 0;
  while True do
  begin
    if InterlockedCompareExchange(IsShuttingDown, 0, 0) = 1 then Break;
    if Server^.StopRequested then Break;
    
    if not NetAcceptTimeout(Server^.ListenSock, 500, ClientSock) then
      Continue;
    
    Inc(ConnCount);
    Worker := TWSWorkerThread.Create(
      ClientSock, Handle, Server^.IsTLS, Server^.TLSContext, Ctx);
    Worker.Start;
  end;
  
  Result := TValue.CreateNum(ConnCount);
end;

function Native_WS_Connect(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  URL, Scheme, Rest, Host, Path, PortStr: string;
  Port, ColonPos, SlashPos, SchemeEnd: Integer;
  Config: TValue;
  Conn: TWSClientConn;
  Thread: TWSClientThread;
  IsTLS: Boolean;
  V: TValue;i: integer;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(140, 'ws.connect(url, [config])',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateStr(''));
  end;

  URL := TValue(Args[0]).StrVal;
  SchemeEnd := Pos('://', URL);
  if SchemeEnd = 0 then
  begin
    errMSG.callerror(144, 'ws.connect: URL harus ws:// atau wss://',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateStr(''));
  end;

  Scheme := LowerCase(Copy(URL, 1, SchemeEnd - 1));
  if Scheme = 'wss' then
  begin
    IsTLS := True;
    Port := 443;
  end
  else if Scheme = 'ws' then
  begin
    IsTLS := False;
    Port := 80;
  end
  else
  begin
    errMSG.callerror(144, 'ws.connect: scheme harus ws:// atau wss://',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateStr(''));
  end;

  Rest := Copy(URL, SchemeEnd + 3, Length(URL));
  SlashPos := Pos('/', Rest);
  if SlashPos = 0 then
  begin
    Host := Rest;
    Path := '/';
  end
  else
  begin
    Host := Copy(Rest, 1, SlashPos - 1);
    Path := Copy(Rest, SlashPos, Length(Rest));
  end;

  ColonPos := Pos(':', Host);
  if ColonPos > 0 then
  begin
    PortStr := Copy(Host, ColonPos + 1, Length(Host));
    Port := StrToIntDef(PortStr, Port);
    Host := Copy(Host, 1, ColonPos - 1);
  end;

  if (Host = '') or (Port < 1) or (Port > 65535) then
  begin
    errMSG.callerror(144, 'ws.connect: host/port tidak valid',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateStr(''));
  end;

  Conn := TWSClientConn.Create(GenerateWSClientID);
  Conn.URL := URL;
  Conn.Host := Host;
  Conn.Port := Port;
  Conn.Path := Path;
  Conn.IsTLS := IsTLS;
  Conn.Verify := True;

  if Args.Count >= 2 then
  begin
    if TValue(Args[1]).DataType = dtDict then
    begin
      Config := TValue(Args[1]);
      V := Config.DictVal.GetValueClone('onOpen');
      if Assigned(V) and (V.DataType = dtFunction) then Conn.OnOpen := V
      else if Assigned(V) then V.Free;

      V := Config.DictVal.GetValueClone('onMessage');
      if Assigned(V) and (V.DataType = dtFunction) then Conn.OnMessage := V
      else if Assigned(V) then V.Free;

      V := Config.DictVal.GetValueClone('onClose');
      if Assigned(V) and (V.DataType = dtFunction) then Conn.OnClose := V
      else if Assigned(V) then V.Free;

      V := Config.DictVal.GetValueClone('onError');
      if Assigned(V) and (V.DataType = dtFunction) then Conn.OnError := V
      else if Assigned(V) then V.Free;

      V := Config.DictVal.GetValueClone('verify');
      if Assigned(V) then
      begin
        Conn.Verify := V.IsTrue;
        V.Free;
      end;
  
      // C.3 — Subprotocols
      V := Config.DictVal.GetValueClone('subprotocols');
      if Assigned(V) and (V.DataType = dtArray) then
      begin
        V.ArrayVal.FLock.Acquire;
        try
          for i := 0 to V.ArrayVal.Count - 1 do
          begin
            if Assigned(V.ArrayVal[i]) and
               (V.ArrayVal[i].DataType = dtString) and
               (Trim(V.ArrayVal[i].StrVal) <> '') then
              Conn.Subprotocols.Add(Trim(V.ArrayVal[i].StrVal));
          end;
        finally
          V.ArrayVal.FLock.Release;
        end;
      end;
      if Assigned(V) then V.Free;
      
      // C.4 — Compression
      V := Config.DictVal.GetValueClone('compression');
      if Assigned(V) then
      begin
        if V.DataType = dtString then
          Conn.CompressionEnabled := LowerCase(V.StrVal) = 'on';
        V.Free;
      end;
      
      V := Config.DictVal.GetValueClone('compressionThreshold');
      if Assigned(V) then
      begin
        if V.DataType = dtNumeric then
          Conn.CompressionThreshold := Trunc(V.NumVal);
        V.Free;
      end;

      // C.2 — Auto-reconnect
      V := Config.DictVal.GetValueClone('autoReconnect');
      if Assigned(V) then
      begin
        Conn.AutoReconnect := V.IsTrue;
        V.Free;
      end;
  
      V := Config.DictVal.GetValueClone('reconnectMinMs');
      if Assigned(V) then
      begin
        if V.DataType = dtNumeric then
          Conn.ReconnectMinMs := Trunc(V.NumVal);
        V.Free;
      end;
  
      V := Config.DictVal.GetValueClone('reconnectMaxMs');
      if Assigned(V) then
      begin
        if V.DataType = dtNumeric then
          Conn.ReconnectMaxMs := Trunc(V.NumVal);
        V.Free;
      end;
    end;
  end;

  RegisterWSClientConn(Conn);
  Thread := TWSClientThread.Create(Conn);

  if Assigned(GWSClientWorkersLock) then
  begin
    GWSClientWorkersLock.Acquire;
    try GWSClientWorkers.Add(Thread);
    finally GWSClientWorkersLock.Release; end;
  end;

  Thread.Start;
  Result := BuildWSClientHandle(Conn);
end;

function Native_WS_Broadcast(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  ServerHandle, i, Count: Integer;
  Msg: TValue;
  Server: PWSServerEntry;
  Payload, Frame: RawByteString;
  Snapshot: TList;
  Conn: TWSConnection;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(140, 'ws.broadcast(handle, msg) butuh (int, any)',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(0));
  end;
  
  ServerHandle := Trunc(TValue(Args[0]).NumVal);
  Server := GetWSServer(ServerHandle);
  if not Assigned(Server) then Exit(TValue.CreateNum(0));
  
  Msg := TValue(Args[1]);
  if Msg.DataType = dtString then
    Payload := RawByteString(Msg.StrVal)
  else
    Payload := RawByteString(TValueToString(Msg, False));
  
  // B.1.4c: event mode — delegate ke GWSEventLoop
  if Assigned(Server^.NBSConfig) then
  begin
    if Assigned(GWSEventLoop) then
      Exit(TValue.CreateNum(GWSEventLoop.BroadcastToServer(ServerHandle, Payload)))
    else
      Exit(TValue.CreateNum(0));
  end;
  
  Frame := BuildWSFrame(wsText, Payload, True);  
  
  Snapshot := TList.Create;
  try
    // Retain semua conn yang relevan
    GWSConnectionsLock.Acquire;
    try
      for i := 0 to GWSConnections.Count - 1 do
      begin
        Conn := TWSConnection(GWSConnections.Objects[i]);
        if Assigned(Conn) and (Conn.ServerHandle = ServerHandle)
           and (Conn.State = wscsOpen) then
        begin
          Conn.Retain;
          Snapshot.Add(Conn);
        end;
      end;
    finally
      GWSConnectionsLock.Release;
    end;
    
    Count := 0;
    for i := 0 to Snapshot.Count - 1 do
    begin
      Conn := TWSConnection(Snapshot[i]);
      try
        if WSSendRaw(Conn, Frame) then Inc(Count);
      finally
        Conn.Release;
      end;
    end;
    
    Result := TValue.CreateNum(Count);
  finally
    Snapshot.Free;
  end;
end;

function Native_WS_Stop(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Handle: Integer;
  Server: PWSServerEntry;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'ws.stop(handle) butuh 1 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  Handle := Trunc(TValue(Args[0]).NumVal);
  Server := GetWSServer(Handle);
  if not Assigned(Server) then
    Exit(TValue.CreateBool(False));
  
  // Thread mode: signal flag
  Server^.StopRequested := True;
  
  // Event mode: hapus dari event loop (closes listening socket)
  if Assigned(Server^.NBSConfig) and Assigned(GWSEventLoop) then
    GWSEventLoop.RemoveServer(Handle);
  
  Result := TValue.CreateBool(True);
end;

// Build frame dengan opsi RSV1
function BuildWSFrameEx(Opcode: TWSOpcode; const Payload: RawByteString;
  RSV1: Boolean): RawByteString;
begin
  Result := BuildWSFrame(Opcode, Payload, True);
  if RSV1 and (Length(Result) > 0) then
    Result[1] := Char(Byte(Result[1]) or $40);
end;

// Kirim text frame — compress kalau negotiated + threshold terpenuhi
function WSSendTextFrame(Conn: TWSConnection;
  const Payload: RawByteString): Boolean;
var
  Compressed, WirePayload: RawByteString;
  UseRSV1: Boolean;
begin
  UseRSV1 := False;
  WirePayload := Payload;

  if Conn.CompressionNegotiated and
     (Length(Payload) >= Conn.CompressionThreshold) then
  begin
    try
      // Python websockets append 00 00 FF FF lalu decompress.
      // DeflateRaw (BFINAL=1) sudah valid — tidak perlu manipulasi.
      Compressed := DeflateRaw(Payload);
      
      if Length(Compressed) < Length(Payload) then      
      begin
        WirePayload := Compressed;
        UseRSV1 := True;
      end;
    except
      // Fallback ke uncompressed kalau error
      UseRSV1 := False;
      WirePayload := Payload;
    end;
  end;

  Result := WSSendRaw(Conn, BuildWSFrameEx(wsText, WirePayload, UseRSV1));
end;

function WSSendBinaryFrame(Conn: TWSConnection;
  const Payload: RawByteString): Boolean;
var
  Compressed, WirePayload: RawByteString;
  UseRSV1: Boolean;
begin
  UseRSV1 := False;
  WirePayload := Payload;

  if Conn.CompressionNegotiated and
     (Length(Payload) >= Conn.CompressionThreshold) then
  begin
    try
      Compressed := DeflateRaw(Payload);
      
      if Length(Compressed) < Length(Payload) then
      begin
        WirePayload := Compressed;
        UseRSV1 := True;
      end;
    except
      UseRSV1 := False;
      WirePayload := Payload;
    end;
  end;

  Result := WSSendRaw(Conn, BuildWSFrameEx(wsBinary, WirePayload, UseRSV1));
end;

function WSInflatePayload(const Payload: RawByteString): RawByteString;
begin
  // RFC 7692 §7.2.2: append trailing 4 octets 0x00 0x00 0xFF 0xFF
  // before decompressing. Client (Python websockets) strips them on send.
  Result := InflateRaw(Payload + #0#0#$FF#$FF);
end;

function Native_WS_ListenAsync(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Handle: Integer;
  Server: PWSServerEntry;
  Cfg: PNBServerConfig;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'ws.listenAsync(serverHandle) butuh 1 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  Handle := Trunc(TValue(Args[0]).NumVal);
  Server := GetWSServer(Handle);
  if not Assigned(Server) then
  begin
    errMSG.callerror(144, 'ws.listenAsync: server handle tidak valid',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  if Assigned(Server^.ListenerThread) then
  begin
    errMSG.callerror(144, 'ws.listenAsync: server sudah dalam mode listening',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  if Assigned(Server^.NBSConfig) then
  begin
    errMSG.callerror(144, 'ws.listenAsync: server sudah listenAsync',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  // B.2: TLS sekarang didukung di event mode
  if Server^.IsTLS and (not Assigned(Server^.TLSContext)) then
  begin
    errMSG.callerror(144,
      'ws.listenAsync: TLS server context tidak valid',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  if not Assigned(GWSEventLoop) then
  begin
    errMSG.callerror(144, 'ws.listenAsync: event loop belum di-init',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  // Bangun PNBServerConfig (borrow Subprotocols dari Server)
  New(Cfg);
  Cfg^.Handle := Handle;
  Cfg^.ListenSock := Server^.ListenSock;
  Cfg^.Subprotocols := Server^.Subprotocols;
  Cfg^.MaxPayloadBytes := Server^.MaxPayloadBytes;
  Cfg^.PingIntervalMs := Server^.PingIntervalMs;
  Cfg^.PongTimeoutMs := Server^.PongTimeoutMs;
  Cfg^.PingEnabled := Server^.PingEnabled;
  Cfg^.CompressionEnabled := Server^.CompressionEnabled;
  Cfg^.CompressionThreshold := Server^.CompressionThreshold;
  Cfg^.SinkCtx := Pointer(Server);
  Cfg^.IsTLS := Server^.IsTLS;
  Cfg^.TLSContext := Server^.TLSContext;
  
  // Transfer listen socket ownership: Server tidak close, event loop yang close
  Server^.ListenSock := -1;
  Server^.NBSConfig := Cfg;
  
  if not GWSEventLoop.AddServer(Cfg) then
  begin
    Server^.ListenSock := Cfg^.ListenSock;   // rollback
    Server^.NBSConfig := nil;
    Dispose(Cfg);
    errMSG.callerror(144, 'ws.listenAsync: AddServer gagal',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  Result := TValue.CreateBool(True);
end;

function Native_WS_ListenThreads(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Handle: Integer;
  Server: PWSServerEntry;
  Ctx: TEngineContext;
