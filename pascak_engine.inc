// Helper: TValue string → RawByteString tanpa codepage conversion
function StrToRawBytes(const S: string): RawByteString; inline;
begin
  SetLength(Result, Length(S));
  if Length(S) > 0 then
    Move(S[1], Result[1], Length(S));
end;

// Helper: RawByteString → string tanpa codepage conversion
function RawBytesToStr(const B: RawByteString): string; inline;
begin
  SetLength(Result, Length(B));
  if Length(B) > 0 then
    Move(B[1], Result[1], Length(B));
end;

