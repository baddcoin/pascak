begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'ws.listenThreads(serverHandle) butuh 1 argumen',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  Handle := Trunc(TValue(Args[0]).NumVal);
  Server := GetWSServer(Handle);
  if not Assigned(Server) then
  begin
    errMSG.callerror(144, 'ws.listenThreads: server handle tidak valid',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  if Assigned(Server^.ListenerThread) then
  begin
    errMSG.callerror(144, 'ws.listenThreads: server sudah listening',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  if Assigned(Server^.NBSConfig) then
  begin
    errMSG.callerror(144,
      'ws.listenThreads: server sudah dalam mode event (listenAsync)',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  Ctx := GetContextFromEnv(CallEnv);
  if not Assigned(Ctx) then
