{ ====================================================================
  F-3a-5a: Struct helpers
  ==================================================================== }

function StructAlignUp(Value, Alignment: Integer): Integer; inline;
begin
  // Alignment selalu power of 2 (1, 2, 4, 8)
  Result := (Value + Alignment - 1) and not (Alignment - 1);
end;

function StructParseFieldKind(const S: string; 
    out Kind: TStructFieldKind;
    out Size: Integer; 
    out Align: Integer): Boolean;
begin
  Result := True;
  if S = 'i8' then       begin Kind := fkInt8;    Size := 1; Align := 1; end
  else if S = 'i16' then begin Kind := fkInt16;   Size := 2; Align := 2; end
  else if S = 'i32' then begin Kind := fkInt32;   Size := 4; Align := 4; end
  else if S = 'i64' then begin Kind := fkInt64;   Size := 8; Align := 8; end
  else if S = 'f32' then begin Kind := fkFloat32; Size := 4; Align := 4; end
  else if S = 'f64' then begin Kind := fkFloat64; Size := 8; Align := 8; end
  else if S = 'ptr' then begin Kind := fkPointer; Size := 8; Align := 8; end
  else if S = 'bool' then begin Kind := fkBool;   Size := 1; Align := 1; end
  else
    Result := False;
end;

function StructReadField(Data: Pointer; const Field: TStructField): TValue;
var
  P: PByte;
begin
  P := PByte(Data) + Field.Offset;
  case Field.Kind of
    fkInt8:     Result := TValue.CreateNum(PShortInt(P)^);
    fkInt16:    Result := TValue.CreateNum(PSmallInt(P)^);
    fkInt32:    Result := TValue.CreateNum(PInteger(P)^);
    fkInt64:    Result := TValue.CreateNum(PInt64(P)^);
    fkFloat32:  Result := TValue.CreateNum(PSingle(P)^);
    fkFloat64:  Result := TValue.CreateNum(PDouble(P)^);
    fkPointer:  Result := TValue.CreatePtr(PPointer(P)^);
    fkBool:     Result := TValue.CreateBool(PBoolean(P)^);
  else
    Result := TValue.CreateNull;
  end;
end;

procedure StructWriteField(Data: Pointer; const Field: TStructField;
  const Value: TValue);
var
  P: PByte;
begin
  P := PByte(Data) + Field.Offset;
  case Field.Kind of
    fkInt8:     PShortInt(P)^ := ShortInt(Trunc(Value.NumVal));
    fkInt16:    PSmallInt(P)^ := SmallInt(Trunc(Value.NumVal));
    fkInt32:    PInteger(P)^  := Integer(Trunc(Value.NumVal));
    fkInt64:    PInt64(P)^    := Trunc(Value.NumVal);
    fkFloat32:  PSingle(P)^   := Single(Value.NumVal);
    fkFloat64:  PDouble(P)^   := Value.NumVal;
    fkPointer:  PPointer(P)^  := Value.PtrVal;
    fkBool:     PBoolean(P)^  := Value.IsTrue;
  end;
end;

function StructFindField(StructType: PNativeStructType; 
  const FieldName: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(StructType^.Fields) do
    if StructType^.Fields[i].Name = FieldName then
      Exit(i);
end;

function GetStructTypeFromTValue(V: TValue): PNativeStructType;
begin
  Result := nil;
  if not Assigned(V) or (V.DataType <> dtPointer) then Exit;
  Result := PNativeStructType(V.PtrVal);
  if (Result <> nil) and (Result^.Magic <> STRUCT_TYPE_MAGIC) then Result := nil;
end;

function GetStructValueFromTValue(V: TValue): PNativeStructValue;
begin
  Result := nil;
  if not Assigned(V) or (V.DataType <> dtPointer) then Exit;
  Result := PNativeStructValue(V.PtrVal);
  if (Result <> nil) and (Result^.Magic <> STRUCT_VALUE_MAGIC) then Result := nil;
end;

function GetFFITypeForKind(Kind: TStructFieldKind): Pointer;
begin
  case Kind of
    fkInt8: Result := GFFITypeSint8;    // fkInt8
    fkInt16: Result := GFFITypeSint16;   // fkInt16
    fkInt32: Result := GFFITypeSint32;   // fkInt32
    fkInt64: Result := GFFITypeSint64;   // fkInt64
    fkFloat32: Result := GFFITypeFloat;    // fkFloat32
    fkFloat64: Result := GFFITypeDouble;   // fkFloat64
    fkPointer: Result := GFFITypePointer;  // fkPointer
    fkBool: Result := GFFITypeUint8;    // fkBool (uint8)
  else
    Result := GFFITypeSint64;
  end;
end;

procedure BuildFFITypeForStruct(StructType: PNativeStructType);
const
  FFI_TYPE_STRUCT_ID = 13;
var
  ElemArray: PPointer;
  i: Integer;
  FfiTypeBytes: PByte;
begin
  // Allocate ffi_type header (24 byte, bisa lebih — kita over-allocate ke 32 untuk aman)
  GetMem(StructType^.FFIType, 32);
  FillChar(StructType^.FFIType^, 32, 0);
  
  // Allocate elements array: FieldCount + 1 (NULL terminator)
  GetMem(StructType^.FFITypeElements, (Length(StructType^.Fields) + 1) * SizeOf(Pointer));
  FillChar(StructType^.FFITypeElements^, 
           (Length(StructType^.Fields) + 1) * SizeOf(Pointer), 0);
  
  // Fill elements: satu pointer per field + NULL terminator
  ElemArray := PPointer(StructType^.FFITypeElements);
  for i := 0 to High(StructType^.Fields) do
  begin
    ElemArray[i] := GetFFITypeForKind(StructType^.Fields[i].Kind);
    if ElemArray[i] = nil then
      raise EScriptRuntimeError.Create(
        'BuildFFITypeForStruct: ffi_type_* untuk field "' +
        StructType^.Fields[i].Name + '" tidak ter-bind di libffi');
  end;
  ElemArray[High(StructType^.Fields) + 1] := nil;  
  
  // Fill ffi_type header dengan layout POSIX 64-bit
  FfiTypeBytes := PByte(StructType^.FFIType);
  PNativeUInt(FfiTypeBytes + 0)^  := NativeUInt(StructType^.TotalSize);   // size
  PWord(FfiTypeBytes + 8)^        := Word(StructType^.MaxAlignment);      // alignment
  PWord(FfiTypeBytes + 10)^       := Word(FFI_TYPE_STRUCT_ID);            // type
  PPointer(FfiTypeBytes + 16)^    := StructType^.FFITypeElements;         // elements
end;

procedure FreeFFITypeForStruct(StructType: PNativeStructType);
begin
  if Assigned(StructType^.FFIType) then
  begin
    FreeMem(StructType^.FFIType);
    StructType^.FFIType := nil;
  end;
  if Assigned(StructType^.FFITypeElements) then
  begin
    FreeMem(StructType^.FFITypeElements);
    StructType^.FFITypeElements := nil;
  end;
end;

//B-1: Native Buffer Operations=======================================
//==================================================================== 
function Native_BufferFromArray(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Src: TValue;
  Buf: PNativeBuffer;
  i, Count: Integer;
  Item: TValue;
  AllocSize: NativeUInt;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtArray) then
  begin
    errMSG.callerror(139, 'native.fromArray(arr) butuh 1 argumen array',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Src := TValue(Args[0]);
  Count := Src.ArrayVal.Count;
  
  // Allocate struct
  New(Buf);
  Buf^.Magic := NATIVE_BUFFER_MAGIC;
  Buf^.Count := Count;
  Buf^.Capacity := Count;
  Buf^.Data := nil;
  
  if Count > 0 then
  begin
    AllocSize := NativeUInt(Count) * SizeOf(Int64);
    GetMem(Buf^.Data, AllocSize);
    
    Src.ArrayVal.FLock.Acquire;
    try
      for i := 0 to Count - 1 do
      begin
        Item := Src.ArrayVal[i];
        if Assigned(Item) and (Item.DataType = dtNumeric) then
          Buf^.Data[i] := Trunc(Item.NumVal)
        else
          Buf^.Data[i] := 0;
      end;
    finally
      Src.ArrayVal.FLock.Release;
    end;
  end;
  
  // Register ke global registry untuk auto-cleanup
  if Assigned(GBufferLock) then
  begin
    GBufferLock.Acquire;
    try
      if Assigned(GBufferRegistry) then
        GBufferRegistry.Add(Buf);
    finally
      GBufferLock.Release;
    end;
  end;
  
  Result := TValue.CreatePtr(Buf);
end;

function Native_BufferPtr(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Buf: PNativeBuffer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then
  begin
    errMSG.callerror(139, 'native.bufferPtr(buf) butuh 1 argumen pointer',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Buf := PNativeBuffer(TValue(Args[0]).PtrVal);
  if (Buf = nil) or (Buf^.Magic <> NATIVE_BUFFER_MAGIC) then
  begin
    errMSG.callerror(155, 'native.bufferPtr: buffer tidak valid atau sudah dibebaskan',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Result := TValue.CreatePtr(Buf^.Data);
end;

function Native_BufferSize(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Buf: PNativeBuffer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then
  begin
    errMSG.callerror(139, 'native.bufferSize(buf) butuh 1 argumen pointer',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(0));
  end;
  
  Buf := PNativeBuffer(TValue(Args[0]).PtrVal);
  if (Buf = nil) or (Buf^.Magic <> NATIVE_BUFFER_MAGIC) then
  begin
    errMSG.callerror(155, 'native.bufferSize: buffer tidak valid',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNum(0));
  end;
  
  Result := TValue.CreateNum(Buf^.Count);
end;

function Native_BufferToArray(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Buf: PNativeBuffer;
  Arr: TValueList;
  i: Integer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then
  begin
    errMSG.callerror(139, 'native.bufferToArray(buf) butuh 1 argumen pointer',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Buf := PNativeBuffer(TValue(Args[0]).PtrVal);
  if (Buf = nil) or (Buf^.Magic <> NATIVE_BUFFER_MAGIC) then
  begin
    errMSG.callerror(155, 'native.bufferToArray: buffer tidak valid',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Arr := TValueList.Create(True);
  try
    if Buf^.Count > 0 then
      Arr.Capacity := Buf^.Count;
    for i := 0 to Buf^.Count - 1 do
      Arr.Add(TValue.CreateNum(Buf^.Data[i]));
    Result := TValue.CreateArray(Arr);
  except
    Arr.Free;
    raise;
  end;
end;

function Native_BufferFree(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Buf: PNativeBuffer;
  i: Integer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then
  begin
    errMSG.callerror(139, 'native.bufferFree(buf) butuh 1 argumen pointer',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateBool(False));
  end;
  
  Buf := PNativeBuffer(TValue(Args[0]).PtrVal);
  if (Buf = nil) or (Buf^.Magic <> NATIVE_BUFFER_MAGIC) then
    Exit(TValue.CreateBool(False));   // sudah freed atau invalid — idempotent
  
  // Mark sebagai freed DULU agar double-call tidak crash
  Buf^.Magic := 0;
  
  // Remove dari registry
  if Assigned(GBufferLock) then
  begin
    GBufferLock.Acquire;
    try
      if Assigned(GBufferRegistry) then
      begin
        i := GBufferRegistry.IndexOf(Buf);
        if i >= 0 then
          GBufferRegistry.Delete(i);
      end;
    finally
      GBufferLock.Release;
    end;
  end;
  
  // Free backing data
  if Assigned(Buf^.Data) then
  begin
    FreeMem(Buf^.Data);
    Buf^.Data := nil;
  end;
  
  Dispose(Buf);
  
  Result := TValue.CreateBool(True);
end;

//F-3a-5a: Native Struct Operations===================================
//==================================================================== 
function Native_StructType(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TypeName: string;
  FieldList: TValue;
  NewType: PNativeStructType;
  i, CurrentOffset, FieldCount: Integer;
  FieldDef, FieldNameVal, FieldKindVal: TValue;
  FieldName, FieldKindStr: string;
  Kind: TStructFieldKind;
  FieldSize, FieldAlign: Integer;
begin
  if (Args.Count <> 2) or
     (TValue(Args[0]).DataType <> dtString) or
     (TValue(Args[1]).DataType <> dtArray) then
  begin
    errMSG.callerror(139, 
      'native.structType(name, [[field, kind], ...]) butuh (string, array)',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  TypeName := TValue(Args[0]).StrVal;
  FieldList := TValue(Args[1]);
  FieldCount := FieldList.ArrayVal.Count;
  
  if FieldCount = 0 then
  begin
    errMSG.callerror(144, 'native.structType: minimal 1 field',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  if not InitLibFFI then
  begin
    errMSG.callerror(153, 
      'native.structType: libffi tidak tersedia — struct tidak bisa dipakai untuk FFI',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;  
  
  New(NewType);
  NewType^.Magic := STRUCT_TYPE_MAGIC;
  NewType^.Name := TypeName;
  NewType^.TotalSize := 0;
  NewType^.MaxAlignment := 1;
  SetLength(NewType^.Fields, FieldCount);
  
  CurrentOffset := 0;
  
  try
    FieldList.ArrayVal.FLock.Acquire;
    try
      for i := 0 to FieldCount - 1 do
      begin
        FieldDef := FieldList.ArrayVal[i];
        if (not Assigned(FieldDef)) or 
           (FieldDef.DataType <> dtArray) or
           (FieldDef.ArrayVal.Count <> 2) then
        begin
          errMSG.callerror(144, 
            'native.structType: field ke-' + IntToStr(i) + 
            ' harus [name, kind]',
            errMSG.xrow, errMSG.xcol);
        end;
        
        FieldNameVal := FieldDef.ArrayVal[0];
        FieldKindVal := FieldDef.ArrayVal[1];
        
        if (not Assigned(FieldNameVal)) or 
           (FieldNameVal.DataType <> dtString) or
           (not Assigned(FieldKindVal)) or
           (FieldKindVal.DataType <> dtString) then
        begin
          errMSG.callerror(144, 
            'native.structType: field ke-' + IntToStr(i) + 
            ' name/kind harus string',
            errMSG.xrow, errMSG.xcol);
        end;
        
        FieldName := FieldNameVal.StrVal;
        FieldKindStr := FieldKindVal.StrVal;
        
        if not StructParseFieldKind(FieldKindStr, Kind, FieldSize, FieldAlign) then
        begin
          errMSG.callerror(144, 
            'native.structType: tipe "' + FieldKindStr + 
            '" tidak dikenal. Gunakan: i8 i16 i32 i64 f32 f64 ptr bool',
            errMSG.xrow, errMSG.xcol);
        end;
        
        // Cek duplikat nama field
        if StructFindField(NewType, FieldName) <> -1 then
        begin
          errMSG.callerror(9, 
            'native.structType: field "' + FieldName + 
            '" duplikat di struct ' + TypeName,
            errMSG.xrow, errMSG.xcol);
        end;
        
        // Align offset ke ukuran field
        CurrentOffset := StructAlignUp(CurrentOffset, FieldAlign);
        
        NewType^.Fields[i].Name := FieldName;
        NewType^.Fields[i].Kind := Kind;
        NewType^.Fields[i].Offset := CurrentOffset;
        NewType^.Fields[i].Size := FieldSize;
        NewType^.Fields[i].Alignment := FieldAlign;
        
        Inc(CurrentOffset, FieldSize);
        
        if FieldAlign > NewType^.MaxAlignment then
          NewType^.MaxAlignment := FieldAlign;
      end;
    finally
      FieldList.ArrayVal.FLock.Release;
    end;
    
    // Pad total size ke max alignment
    NewType^.TotalSize := StructAlignUp(CurrentOffset, NewType^.MaxAlignment);
    
    NewType^.TotalSize := StructAlignUp(CurrentOffset, NewType^.MaxAlignment);
    BuildFFITypeForStruct(NewType);

    // Register
    if Assigned(GStructLock) then
    begin
      GStructLock.Acquire;
      try
        if Assigned(GStructTypeRegistry) then
          GStructTypeRegistry.Add(NewType);
      finally
        GStructLock.Release;
      end;
    end;
    
    Result := TValue.CreatePtr(NewType);
  except
    // Cleanup jika error
    SetLength(NewType^.Fields, 0);
    Dispose(NewType);
    raise;
  end;
end;

function Native_NewStruct(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  TypePtr: PNativeStructType;
  StructVal: PNativeStructValue;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtPointer) then
  begin
    errMSG.callerror(139, 'native.newStruct(type) butuh 1 argumen pointer',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  TypePtr := PNativeStructType(TValue(Args[0]).PtrVal);
  if (TypePtr = nil) or (TypePtr^.Magic <> STRUCT_TYPE_MAGIC) then
  begin
    errMSG.callerror(155, 'native.newStruct: struct type tidak valid',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  New(StructVal);
  StructVal^.Magic := STRUCT_VALUE_MAGIC;
  StructVal^.StructType := TypePtr;
  
  // Allocate zero-initialized data
  GetMem(StructVal^.Data, TypePtr^.TotalSize);
  FillChar(StructVal^.Data^, TypePtr^.TotalSize, 0);
  
  // Register
  if Assigned(GStructLock) then
  begin
    GStructLock.Acquire;
    try
      if Assigned(GStructValueRegistry) then
        GStructValueRegistry.Add(StructVal);
    finally
      GStructLock.Release;
    end;
  end;
  
  Result := TValue.CreatePtr(StructVal);
end;

function Native_StructGet(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  StructVal: PNativeStructValue;
  FieldName: string;
  FieldIdx: Integer;
begin
  if (Args.Count <> 2) or
     (TValue(Args[0]).DataType <> dtPointer) or
     (TValue(Args[1]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 
      'native.structGet(value, fieldName) butuh (pointer, string)',
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  StructVal := PNativeStructValue(TValue(Args[0]).PtrVal);
  if (StructVal = nil) or (StructVal^.Magic <> STRUCT_VALUE_MAGIC) then
  begin
    errMSG.callerror(155, 'native.structGet: struct value tidak valid',
                     errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  FieldName := TValue(Args[1]).StrVal;
  FieldIdx := StructFindField(StructVal^.StructType, FieldName);
  if FieldIdx = -1 then
  begin
    errMSG.callerror(144, 
      'native.structGet: field "' + FieldName + 
      '" tidak ada di struct ' + StructVal^.StructType^.Name,
      errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;
  
  Result := StructReadField(StructVal^.Data, StructVal^.StructType^.Fields[FieldIdx]);
end;

