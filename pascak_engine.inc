// time.iso8601(ts, [offsetSec]) → string
function Native_Time_ISO8601(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ts: Int64;
  OffsetSec: Integer;
begin
  if (Args.Count < 1) or (Args.Count > 2) or
     (TValue(Args[0]).DataType <> dtNumeric) then
  begin
    errMSG.callerror(138, 'time.iso8601(ts, [offsetSec])', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateStr(''));
  end;

  Ts := Trunc(TValue(Args[0]).NumVal);
  OffsetSec := 0;
  if Args.Count = 2 then
  begin
    if TValue(Args[1]).DataType = dtNumeric then
      OffsetSec := Trunc(TValue(Args[1]).NumVal);
  end;

  Result := TValue.CreateStr(TimeToISO8601(Ts, OffsetSec));
end;

// time.parseISO(s) → timestamp atau null
function Native_Time_ParseISO(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  Ts: Int64;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtString) then
  begin
    errMSG.callerror(139, 'time.parseISO(s)', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull);
  end;

  if TimeFromISO8601(TValue(Args[0]).StrVal, Ts) then
    Result := TValue.CreateNum(Ts)
  else
    Result := TValue.CreateNull;
