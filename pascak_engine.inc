    Expr := AExpr;
    IsConst := AIsConst;
    IsReferenced := True;
    IsCaptured := False;
end;

destructor TVarDeclNode.Destroy; 
begin 
    Expr.Free; inherited; 
end;

constructor TAssignmentNode.Create(AName: string; AExpr: TNode); 
begin 
    TargetName := AName; 
    Expr := AExpr; 
end;

destructor TAssignmentNode.Destroy; 
begin 
    Expr.Free; inherited; 
end;

constructor TMultiAssignNode.Create(AExpr: TNode);
