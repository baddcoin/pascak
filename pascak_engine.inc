procedure TFSAsyncWorkerThread.Execute;
var
  FS: TFileStream;
  RawData: RawByteString;
  Dict: TDictValue;
  ResVal: TValue;
  SavedCtx: TEngineContext;
  BytesCount: Int64;
begin
  SavedCtx := GCurrentContext;
  if Assigned(FTask.OwnerContext) then
    GCurrentContext := FTask.OwnerContext;

  if not Assigned(errMSG) then
    errMSG := Terror.Create;

  ResVal := nil;

  try
    // Cek cancel sebelum kerja
    if InterlockedCompareExchange(FTask.State, EXEC_TASK_RUNNING,
                                   EXEC_TASK_PENDING) = EXEC_TASK_CANCEL then
    begin
      InterlockedExchange(FTask.State, EXEC_TASK_DONE);
      Exit;
    end;

    try
      case FTask.Kind of
        FSASYNC_READ:
          begin
            if not FileExists(FTask.SafePath) then
            begin
              Dict := TDictValue.Create;
              try
                Dict.SetValue('ok', TValue.CreateBool(False));
                Dict.SetValue('error',
                  TValue.CreateStr('file not found: ' + FTask.SafePath));
                ResVal := TValue.CreateDict(Dict);
              except Dict.Free; raise; end;
            end else begin
              FS := TFileStream.Create(FTask.SafePath,
                    fmOpenRead or fmShareDenyNone);
              try
                if FS.Size > FSASYNC_MAX_READ_BYTES then
                  raise Exception.CreateFmt(
                    'file too large for async read: %d bytes (max %d)',
                    [FS.Size, FSASYNC_MAX_READ_BYTES]);
                SetLength(RawData, FS.Size);
                if FS.Size > 0 then
                  FS.ReadBuffer(RawData[1], FS.Size);
              finally
                FS.Free;
              end;

              Dict := TDictValue.Create;
              try
                Dict.SetValue('ok', TValue.CreateBool(True));
                Dict.SetValue('data', TValue.CreateStr(string(RawData)));
                Dict.SetValue('bytesRead', TValue.CreateNum(Length(RawData)));
                Dict.SetValue('path', TValue.CreateStr(FTask.SafePath));
                ResVal := TValue.CreateDict(Dict);
              except Dict.Free; raise; end;
            end;
          end;

        FSASYNC_WRITE, FSASYNC_APPEND:
          begin
            if FTask.Kind = FSASYNC_WRITE then
              FS := TFileStream.Create(FTask.SafePath,
                    fmCreate or fmShareDenyWrite)
            else
            begin
              // Append: coba open existing, fallback create
              try
                FS := TFileStream.Create(FTask.SafePath,
                      fmOpenReadWrite or fmShareDenyWrite);
                FS.Position := FS.Size;
              except
                FS := TFileStream.Create(FTask.SafePath,
                      fmCreate or fmShareDenyWrite);
              end;
            end;

            try
              BytesCount := Length(FTask.Data);
              if BytesCount > 0 then
                FS.WriteBuffer(FTask.Data[1], BytesCount);
            finally
              FS.Free;
            end;

            Dict := TDictValue.Create;
            try
              Dict.SetValue('ok', TValue.CreateBool(True));
              Dict.SetValue('bytesWritten', TValue.CreateNum(BytesCount));
              Dict.SetValue('path', TValue.CreateStr(FTask.SafePath));
              ResVal := TValue.CreateDict(Dict);
            except Dict.Free; raise; end;
          end;
      end;
    except
      on E: Exception do
      begin
        Dict := TDictValue.Create;
        try
          Dict.SetValue('ok', TValue.CreateBool(False));
          Dict.SetValue('error', TValue.CreateStr(E.Message));
          Dict.SetValue('__worker_crash', TValue.CreateBool(True));
          Dict.SetValue('__worker_kind', TValue.CreateStr(E.ClassName));
          ResVal := TValue.CreateDict(Dict);
        except Dict.Free; raise; end;
      end;
    end;

    FTask.ResultVal := ResVal;
    ResVal := nil;
  finally
    if Assigned(ResVal) then ResVal.Free;
    InterlockedExchange(FTask.State, EXEC_TASK_DONE);
    FlushThreadTLAB;
    if Assigned(errMSG) then begin errMSG.Free; errMSG := nil; end;
    GCurrentContext := SavedCtx;
  end;
end;

