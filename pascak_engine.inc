procedure CheckFPUValid(V: Double; const FuncName: string); inline;
begin
  if IsNan(V) or IsInfinite(V) then
    raise EScriptRuntimeError.Create('Math Error: Nilai argumen pada ' + FuncName + ' tidak valid (NaN/Inf).');
end;

function GetSingleMathArg(Args: TObjectList; const FuncName: string): Double; inline;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtNumeric) then 
    raise EScriptRuntimeError.Create('Math Error: "' + FuncName + '" membutuhkan tepat 1 argumen numerik.');
  
  Result := TValue(Args[0]).NumVal;
  CheckFPUValid(Result, FuncName);
end;

procedure GetTwoMathArgs(Args: TObjectList; const FuncName: string; out Val1, Val2: Double); inline;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtNumeric) or (TValue(Args[1]).DataType <> dtNumeric) then
    raise EScriptRuntimeError.Create('Math Error: "' + FuncName + '" membutuhkan tepat 2 argumen numerik.');
  
  Val1 := TValue(Args[0]).NumVal;
  Val2 := TValue(Args[1]).NumVal;
  CheckFPUValid(Val1, FuncName);
  CheckFPUValid(Val2, FuncName);
end;

// HELPER: Single Source of Truth untuk perhitungan FPB (Mencegah Duplikasi)
function InternalGCD(a, b: Int64): Int64; inline;
var
  ua, ub, temp: QWord;
begin
  // Mencegah overflow absolut jika nilai berada di ambang bawah Int64 (-9.22e18)
  if a = Low(Int64) then ua := QWord(High(Int64)) + 1 else ua := Abs(a);
  if b = Low(Int64) then ub := QWord(High(Int64)) + 1 else ub := Abs(b);
  
  while ub <> 0 do
  begin
    temp := ub;
    ub := ua mod ub;
    ua := temp;
  end;
  Result := Int64(ua);
end;

procedure GetTwoBitwiseArgs(Args: TObjectList; const FuncName: string; out Val1, Val2: Int64); inline;
var
  d1, d2: Double;
begin
  if (Args.Count <> 2) or (TValue(Args[0]).DataType <> dtNumeric) or (TValue(Args[1]).DataType <> dtNumeric) then
    raise EScriptRuntimeError.Create('Bitwise Error: "' + FuncName + '" membutuhkan tepat 2 argumen numerik.');
  
  d1 := TValue(Args[0]).NumVal;
  d2 := TValue(Args[1]).NumVal;

  if (d1 < MIN_INT64_DBL) or (d1 > MAX_INT64_DBL) or (d2 < MIN_INT64_DBL) or (d2 > MAX_INT64_DBL) then
    raise EScriptRuntimeError.Create('Math Error: Nilai numerik melampaui batas aman konversi bitwise (Int64).');

  Val1 := System.Trunc(d1);
  Val2 := System.Trunc(d2);
end;

function Native_MathIsClose(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  a, b, rel_tol, abs_tol, diff: Double;
begin
  if (Args.Count < 2) or (Args.Count > 4) then
    raise EScriptRuntimeError.Create('Math Error: isclose(a, b, [rel_tol], [abs_tol]) membutuhkan 2-4 argumen.');
    
  a := TValue(Args[0]).NumVal;
  b := TValue(Args[1]).NumVal;
  
  rel_tol := 1e-09; 
  abs_tol := 0.0;
  
  if Args.Count >= 3 then rel_tol := TValue(Args[2]).NumVal;
  if Args.Count = 4 then abs_tol := TValue(Args[3]).NumVal;
  
  if (rel_tol < 0) or (abs_tol < 0) then
    raise EScriptRuntimeError.Create('Math Error: Toleransi pada isclose tidak boleh negatif.');

  if a = b then Exit(TValue.CreateBool(True));
  if IsInfinite(a) or IsInfinite(b) then Exit(TValue.CreateBool(False));
  
  diff := Abs(a - b);
  Result := TValue.CreateBool(diff <= math.Max(rel_tol * math.Max(Abs(a), Abs(b)), abs_tol));
end;

function Native_MathGcd(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  a, b: Int64;
begin
  GetTwoBitwiseArgs(Args, 'gcd(a, b)', a, b);
  Result := TValue.CreateNum(InternalGCD(a, b));
end;

function Native_MathLcm(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  a, b, gcd_val: Int64;
  ua, ub: Double;
begin
  GetTwoBitwiseArgs(Args, 'lcm(a, b)', a, b);
  if (a = 0) or (b = 0) then Exit(TValue.CreateNum(0));
  
  gcd_val := InternalGCD(a, b);
  
  // Mengkonversi ke ranah float (Double) saat perkalian untuk mencegah runtime error (Int64 Overflow)
  if a = Low(Int64) then ua := Double(High(Int64)) + 1.0 else ua := Abs(a);
  if b = Low(Int64) then ub := Double(High(Int64)) + 1.0 else ub := Abs(b);

  Result := TValue.CreateNum((ua / gcd_val) * ub); 
end;

function Native_MathFmod(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var x, y: Double;
begin
  GetTwoMathArgs(Args, 'fmod(x, y)', x, y);
  if y = 0 then raise EScriptRuntimeError.Create('Math Error: Pembagian oleh nol pada fmod.');
  Result := TValue.CreateNum(x - (y * math.Floor((x / y) + 1E-14))); //math.fmod tidak didukung
end;

function Native_MathCopysign(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var 
  x, y: Double;
begin
  GetTwoMathArgs(Args, 'copysign(x, y)', x, y);
  
  // ✅ Portable: cek sign lewat perbandingan
  if (y < 0) or ((y = 0) and (1.0 / y < 0)) then  // Menangkap -0.0
    Result := TValue.CreateNum(-Abs(x))
  else
    Result := TValue.CreateNum(Abs(x));
end;

function Native_MathRandom(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var 
  MinVal, MaxVal: Integer;
  ResInt, Range: Int64;
begin
  if Args.Count = 0 then
    Exit(TValue.CreateNum(Random)); 

  if Args.Count = 1 then 
  begin
    if TValue(Args[0]).DataType <> dtNumeric then
      raise EScriptRuntimeError.Create('Math Error: random() membutuhkan argumen numerik.');
      
    MaxVal := Trunc(TValue(Args[0]).NumVal);
    if MaxVal <= 0 then MaxVal := 1;
    Result := TValue.CreateNum(Random(MaxVal));
  end else 
  if Args.Count = 2 then
  begin
    if (TValue(Args[0]).DataType <> dtNumeric) or (TValue(Args[1]).DataType <> dtNumeric) then
      raise EScriptRuntimeError.Create('Math Error: random() membutuhkan argumen numerik.');
      
    MinVal := Trunc(TValue(Args[0]).NumVal);
    MaxVal := Trunc(TValue(Args[1]).NumVal);
    
    if MinVal > MaxVal then 
      raise EScriptRuntimeError.Create('Math Error: MinVal melebihi MaxVal pada random().');
    
    Range := Int64(MaxVal) - Int64(MinVal) + 1;
    ResInt := Int64(MinVal) + Random(Range); 
    
    Result := TValue.CreateNum(ResInt);
  end
  else 
    raise EScriptRuntimeError.Create('Math Error: Argumen pada random() tidak valid.');
end;

// RANDOM CHOICE (Mengambil elemen acak dari Array)
function Native_MathRandomChoice(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  ArrVal: TValue;
  Idx: Integer;
begin
  if (Args.Count <> 1) or (TValue(Args[0]).DataType <> dtArray) then
    raise EScriptRuntimeError.Create('Math Error: randomChoice(array) membutuhkan 1 argumen Array.');
    
  ArrVal := TValue(Args[0]);
  ArrVal.ArrayVal.FLock.Acquire;
  try
    if ArrVal.ArrayVal.Count = 0 then Exit(TValue.CreateNull);
    Idx := Random(ArrVal.ArrayVal.Count);
    
    if Assigned(ArrVal.ArrayVal[Idx]) then
      Result := ArrVal.ArrayVal[Idx].Clone 
    else
      Result := TValue.CreateNull;
  finally
    ArrVal.ArrayVal.FLock.Release;
  end;
end;

// FAKTORIAL (n!)
function Native_MathFactorial(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  n, i: Int64;
  res: Double;
begin
  n := Trunc(GetSingleMathArg(Args, 'factorial(n)'));
  if n < 0 then raise EScriptRuntimeError.Create('Math Error: Faktorial tidak menerima angka negatif.');
  if n > 170 then raise EScriptRuntimeError.Create('Math Error: Batas maksimum faktorial tercapai.');
  
  res := 1.0;
  for i := 2 to n do res := res * i;
  Result := TValue.CreateNum(res);
end;

// PERMUTASI P(n, r)
function Native_MathPermutation(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  n_val, r_val: Double;
  n, r, i: Int64;
  res: Double;
begin
  GetTwoMathArgs(Args, 'permutation(n, r)', n_val, r_val);
  n := Trunc(n_val);
  r := Trunc(r_val);
  
  if (n < 0) or (r < 0) or (r > n) then 
    raise EScriptRuntimeError.Create('Math Error: Kombinasi n dan r tidak valid untuk permutasi.');
    
  res := 1.0;
  for i := (n - r) + 1 to n do res := res * i;
  Result := TValue.CreateNum(res);
end;

// KOMBINASI C(n, r)
function Native_MathCombination(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  n_val, r_val: Double;
  n, r, i: Int64;
  res: Double; // PERBAIKAN: Transisi dari Extended ke Double untuk kompatibilitas memori
begin
  GetTwoMathArgs(Args, 'combination(n, r)', n_val, r_val);
  n := Trunc(n_val);
  r := Trunc(r_val);
  
  if (n < 0) or (r < 0) or (r > n) then 
    raise EScriptRuntimeError.Create('Math Error: Kombinasi n dan r tidak valid untuk kombinasi.');
    
  if r > (n - r) then r := n - r; 
  
  res := 1.0;
  for i := 1 to r do
  begin
    res := res * (n - i + 1);
    res := res / i;
  end;
  
  // PERBAIKAN LOGIKA: Hapus System.Round(). Pertahankan nilai presisi Double
  // agar mencegah crash saat perhitungan melewati High(Int64)
  Result := TValue.CreateNum(res);
end;

