function BuiltIn_Dict_Update(TargetObj: TValue; const Args: array of TValue): TValue;
var 
  SourceDict: TDictValue; 
  Keys: TStringArray; 
  Vals: array of TValue;
  i: Integer; 
  //Val: TValue;
begin
  if (Length(Args) <> 1) or (Args[0].DataType <> dtDict) then
  begin
    errMSG.callerror(144, 'Dict.update(dictionary) butuh 1 argumen dictionary', errMSG.xrow, errMSG.xcol);
    Exit(TValue.CreateNull); 
  end;

  SourceDict := Args[0].DictVal;
  
  // PERBAIKAN: Ekstrak key beserta value-nya SECARA BERSAMAAN selama Source dikunci
  SourceDict.FLock.Acquire;
  try 
    Keys := SourceDict.GetKeys;
    SetLength(Vals, Length(Keys));
    for i := 0 to High(Keys) do
    begin
      // ✅ FIX P1.5: GetValueClone — aman
      Vals[i] := SourceDict.GetValueClone(Keys[i]);
    end;
  finally 
    SourceDict.FLock.Release; 
  end;

  // Lakukan penyuntikan nilai batch dengan aman (mengurangi durasi penahanan Lock Target)
  TargetObj.DictVal.FLock.Acquire;
  try
    for i := 0 to High(Keys) do
    begin
      if Assigned(Vals[i]) then 
        TargetObj.DictVal.SetValue(Keys[i], Vals[i]); 
    end;
  finally
    TargetObj.DictVal.FLock.Release;
  end;
  
  SetLength(Keys, 0);
  SetLength(Vals, 0);
  Result := TValue.CreateNull; 
end;
//shortcut end

