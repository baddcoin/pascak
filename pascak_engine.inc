function Native_GetFiles(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SR: TSearchRec;
  Arr: TValueList;
  SafePath, Filter: string;
begin
  if (Args.Count < 1) or (Args.Count > 2) then 
    raise EScriptRuntimeError.Create('getFiles(path, [filter]) membutuhkan 1 atau 2 argumen.');
    
  SafePath := GetSafeSandboxedPath(TValue(Args[0]).StrVal);
  SafePath := IncludeTrailingPathDelimiter(SafePath);
  
  if Args.Count = 2 then
  begin
    Filter := TValue(Args[1]).StrVal;
    // PROTEKSI PATH TRAVERSAL PADA FILTER
    if (Pos('/', Filter) > 0) or (Pos('\', Filter) > 0) or (Pos('..', Filter) > 0) then
      raise EScriptRuntimeError.Create('Security Error: Filter pencarian tidak boleh mengandung navigasi path direktori!');
  end
  else
    Filter := '*.*'; 

  Arr := TValueList.Create(True);
  try
    if FindFirst(SafePath + Filter, faAnyFile - faDirectory, SR) = 0 then
    begin
      try
        repeat
          // PERBAIKAN: Validasi manual Bitwise Attribute untuk menendang direktori siluman
          if (SR.Attr and faDirectory) = 0 then
            Arr.Add(TValue.CreateStr(SR.Name));
        until FindNext(SR) <> 0;
      finally
        FindClose(SR);
      end;
    end;
    Result := TValue.CreateArray(Arr);
  except
    Arr.Free;
    raise;
  end;
end;

function Native_GetDirs(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SR: TSearchRec;
  Arr: TValueList;
  SafePath: string;
begin
  if Args.Count <> 1 then 
    raise EScriptRuntimeError.Create('getDirs(path) membutuhkan tepat 1 argumen string.');
    
  SafePath := IncludeTrailingPathDelimiter(GetSafeSandboxedPath(TValue(Args[0]).StrVal));
  Arr := TValueList.Create(True);
  
  try
    if FindFirst(SafePath + '*.*', faDirectory, SR) = 0 then
    begin
      try
        repeat
          if (SR.Name <> '.') and (SR.Name <> '..') and ((SR.Attr and faDirectory) <> 0) then
            Arr.Add(TValue.CreateStr(SR.Name));
        until FindNext(SR) <> 0;
      finally
        FindClose(SR);
      end;
    end;
    Result := TValue.CreateArray(Arr);
  except
    Arr.Free;
    raise;
  end;
end;

function Native_MakeDir(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  SafePath: string;
begin
  if Args.Count <> 1 then 
    raise EScriptRuntimeError.Create('makeDir(path) membutuhkan tepat 1 argumen string.');
    
  SafePath := GetSafeSandboxedPath(TValue(Args[0]).StrVal);
  
  if SysUtils.ForceDirectories(SafePath) then
    Result := TValue.CreateBool(True)
  else
    Result := TValue.CreateBool(False);
end;

function Native_SysGCStep(Args: TObjectList; CallEnv: TSymbolTable): TValue;
begin
  // 1. Jalankan pembersihan cicilan memori Zombie
  ProcessGCZombies();
  
  // 2. Eksekusi Major GC secara PAKSA tanpa peduli jumlah objek, 
  // karena fungsi ini memang dipanggil secara eksplisit oleh programmer skrip.
  RunGarbageCollection(CallEnv, True); 
  
  Result := TValue.CreateNull;
end;

