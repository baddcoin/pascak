function Native_Input(Args: TObjectList; CallEnv: TSymbolTable): TValue;
var
  S: string;
begin
  // Jika ada argumen string, cetak sebagai Prompt terlebih dahulu
  if (Args.Count > 0) and (TValue(Args[0]).DataType = dtString) then
  begin
    IOLock.Acquire;
    try
      Write(TValue(Args[0]).StrVal);
    finally
      IOLock.Release;
    end;
  end else 
  if Args.Count > 0 then
    raise EScriptRuntimeError.Create('Fungsi input() hanya menerima argumen berupa string prompt opsional.');

  // Baca input dari Standard Input (Terminal)
  Readln(S);
  
  Result := TValue.CreateStr(S);
end;

