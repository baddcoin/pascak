//B.1.7: Non-blocking execAsync infrastructure═══════════════════
//══════════════════════════════════════════════════════════
procedure InitExecTasks;
begin
  if Assigned(GExecTasksLock) then Exit;
  GExecTasksLock := TCriticalSection.Create;
  GExecTasks := TList.Create;
  GExecTaskCounter := 0;
end;

procedure FreeExecTasks;
var
  i: Integer;
  Task: TExecTask;
  Snapshot: TList;
begin
  if not Assigned(GExecTasksLock) then Exit;

  Snapshot := TList.Create;
  try
    GExecTasksLock.Acquire;
    try
      for i := 0 to GExecTasks.Count - 1 do
        Snapshot.Add(GExecTasks[i]);
      GExecTasks.Clear;
    finally
      GExecTasksLock.Release;
    end;

    // Cancel semua
    for i := 0 to Snapshot.Count - 1 do
    begin
      Task := TExecTask(Snapshot[i]);
      InterlockedExchange(Task.State, EXEC_TASK_CANCEL);
    end;

    // Free (menunggu worker via WaitFor)
    for i := 0 to Snapshot.Count - 1 do
    begin
      Task := TExecTask(Snapshot[i]);
      try Task.Free; except end;
    end;
  finally
    Snapshot.Free;
  end;

  GExecTasks.Free; GExecTasks := nil;
  GExecTasksLock.Free; GExecTasksLock := nil;
end;

function FindExecTask(ID: Integer): TExecTask;
var i: Integer;
begin
  Result := nil;
  if not Assigned(GExecTasks) then Exit;
  for i := 0 to GExecTasks.Count - 1 do
    if TExecTask(GExecTasks[i]).ID = ID then
      Exit(TExecTask(GExecTasks[i]));
end;

procedure RegisterExecTask(Task: TExecTask);
begin
  if not Assigned(GExecTasks) then InitExecTasks;
  GExecTasksLock.Acquire;
  try GExecTasks.Add(Task);
  finally GExecTasksLock.Release; end;
end;

procedure UnregisterExecTask(Task: TExecTask);
var i: Integer;
begin
  if not Assigned(GExecTasks) then Exit;
  GExecTasksLock.Acquire;
  try
    for i := 0 to GExecTasks.Count - 1 do
      if TExecTask(GExecTasks[i]) = Task then
      begin
        GExecTasks.Delete(i);
        Break;
      end;
  finally GExecTasksLock.Release; end;
end;

// Dipanggil dari event loop tick: iterate done tasks, invoke callback,
// then auto-free (kalau callback diset).
procedure ProcessExecCallbacks;
var
  i: Integer;
  Task: TExecTask;
  ToFree: TList; arg:TValue;
begin
  if not Assigned(GExecTasks) then Exit;
  if GExecTasks.Count = 0 then Exit;

  ToFree := TList.Create;
  try
    GExecTasksLock.Acquire;
    try
      for i := 0 to GExecTasks.Count - 1 do
      begin
        Task := TExecTask(GExecTasks[i]);
        if (InterlockedCompareExchange(Task.State, 0, 0) = EXEC_TASK_DONE)
           and Assigned(Task.Callback)
           and (Task.Callback.DataType = dtFunction)
           and (InterlockedCompareExchange(Task.CallbackFired, 1, 0) = 0) then
          ToFree.Add(Task);
      end;
    finally
      GExecTasksLock.Release;
    end;

    for i := 0 to ToFree.Count - 1 do
    begin
      Task := TExecTask(ToFree[i]);

      // Invoke callback dengan clone (ownership caller)
      if Assigned(Task.ResultVal) then
      begin
        Arg := Task.ResultVal.Clone;
        try
          try CallWSCallback(Task.Callback, [Arg]);
          except
            on E: Exception do
              PushThreadError('execAsync callback: ' + E.Message);
          end;
        finally Arg.Free; end;
      end;

      // Auto-free kalau callback diset
      UnregisterExecTask(Task);
      try Task.Free; except end;
    end;
  finally
    ToFree.Free;
  end;
end;

{ ─── TExecTask + TExecWorkerThread ─── }

destructor TExecTask.Destroy;
begin
  if Assigned(ResultVal) then ResultVal.Free;
  if Assigned(Callback) then Callback.Free;
  if Assigned(Worker) then
  begin
    try Worker.WaitFor; except end;
    try Worker.Free; except end;
  end;
  if Assigned(OwnerContext) then
  begin
    OwnerContext.Release;
    OwnerContext := nil;
  end;
  inherited;
end;

constructor TExecWorkerThread.Create(ATask: TExecTask);
begin
  inherited Create(True);
  FreeOnTerminate := False;
  FTask := ATask;
end;

procedure TExecWorkerThread.Execute;
var
  OutStr, ErrStr: RawByteString;
  ExitCode: Integer;
  Dict: TDictValue;
  ResVal: TValue;
  SavedCtx: TEngineContext;
begin
  SavedCtx := GCurrentContext;
  if Assigned(FTask.OwnerContext) then
    GCurrentContext := FTask.OwnerContext;

  if not Assigned(errMSG) then
    errMSG := Terror.Create;

  ResVal := nil;

  try
    // Cek cancel sebelum jalan
    if InterlockedCompareExchange(FTask.State, EXEC_TASK_RUNNING,
                                   EXEC_TASK_PENDING) = EXEC_TASK_CANCEL then
    begin
      InterlockedExchange(FTask.State, EXEC_TASK_DONE);
      Exit;
    end;

    try
      if ProcExec(FTask.Cmd, FTask.Args, OutStr, ErrStr, ExitCode, FTask.TimeoutMs) then
      begin
        Dict := TDictValue.Create;
        try
          Dict.SetValue('exitCode', TValue.CreateNum(ExitCode));
          Dict.SetValue('stdout', TValue.CreateStr(string(OutStr)));
          Dict.SetValue('stderr', TValue.CreateStr(string(ErrStr)));
          Dict.SetValue('denied', TValue.CreateBool(False));
          ResVal := TValue.CreateDict(Dict);
        except Dict.Free; raise; end;
      end
      else
      begin
        Dict := TDictValue.Create;
        try
          Dict.SetValue('exitCode', TValue.CreateNum(-1));
          Dict.SetValue('stdout', TValue.CreateStr(''));
          Dict.SetValue('stderr', TValue.CreateStr(''));
          Dict.SetValue('denied', TValue.CreateBool(
            Pos('exec denied', ProcLastError) > 0));
          Dict.SetValue('error', TValue.CreateStr(ProcLastError));
          ResVal := TValue.CreateDict(Dict);
        except Dict.Free; raise; end;
      end;
    except
      on E: Exception do
      begin
        Dict := TDictValue.Create;
        try
          Dict.SetValue('exitCode', TValue.CreateNum(-1));
          Dict.SetValue('stdout', TValue.CreateStr(''));
          Dict.SetValue('stderr', TValue.CreateStr(''));
          Dict.SetValue('denied', TValue.CreateBool(False));
          Dict.SetValue('error', TValue.CreateStr('worker exception: ' + E.Message));
          // ✅ FASE 1.5: marker reserved
          Dict.SetValue('__worker_crash', TValue.CreateBool(True));
          Dict.SetValue('__worker_kind', TValue.CreateStr(E.ClassName));
          ResVal := TValue.CreateDict(Dict);
        except Dict.Free; raise; end;
      end;
    end;

    FTask.ResultVal := ResVal;
    ResVal := nil;
  finally
    if Assigned(ResVal) then ResVal.Free;
    InterlockedExchange(FTask.State, EXEC_TASK_DONE);
    FlushThreadTLAB;
    if Assigned(errMSG) then begin errMSG.Free; errMSG := nil; end;
    GCurrentContext := SavedCtx;
  end;
end;

